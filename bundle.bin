th:calc(100% - 72px); }\n}\n\n/* Incident closure stays beside the order-detail action.  The modal keeps\n   the platform reason code in the submitted value while showing only a\n   readable Chinese label to the operator. */\nbody[data-ui-version=\"23\"] .incident-close-modal {\n  width:min(520px,calc(100vw - 32px));\n  max-width:none;\n  padding:0;\n  overflow:hidden;\n}\nbody[data-ui-version=\"23\"] .incident-close-head {\n  display:flex;\n  align-items:flex-start;\n  justify-content:space-between;\n  gap:18px;\n  padding:24px 26px 18px;\n  border-bottom:1px solid var(--line);\n  background:linear-gradient(135deg,var(--surface),var(--surface-soft));\n}\nbody[data-ui-version=\"23\"] .incident-close-eyebrow { color:var(--danger); font-size:10px; font-weight:800; letter-spacing:.16em; }\nbody[data-ui-version=\"23\"] .incident-close-head h2 { margin:5px 0 5px; color:var(--text); font-size:21px; letter-spacing:-.035em; }\nbody[data-ui-version=\"23\"] .incident-close-context { color:var(--text-3); font-size:12px; line-height:1.5; }\nbody[data-ui-version=\"23\"] .incident-close-x {\n  width:34px;\n  height:34px;\n  flex:0 0 auto;\n  border:1px solid var(--line);\n  border-radius:10px;\n  color:var(--text-3);\n  background:var(--surface);\n  font-size:24px;\n  line-height:1;\n  cursor:pointer;\n}\nbody[data-ui-version=\"23\"] .incident-close-x:hover { color:var(--text); border-color:var(--line-strong); background:var(--surface-soft); }\nbody[data-ui-version=\"23\"] .incident-close-body { padding:20px 26px 8px; }\nbody[data-ui-version=\"23\"] .incident-close-body label { display:block; margin:0 0 7px; color:var(--text-2); font-size:12px; font-weight:700; }\nbody[data-ui-version=\"23\"] .incident-close-body label + select { margin-bottom:16px; }\nbody[data-ui-version=\"23\"] .incident-close-body .r-input { width:100%; min-height:40px; }\n/* 关闭事件时「通知平台管理员」的勾选项（v26.83）。\n   文字一律走 --text-2 / --text（≥7.6:1）—— 12px 属于 WCAG 正文级，\n   浅色主题的 --text-3 在白底只有 3.63:1，不够。 */\nbody[data-ui-version=\"23\"] .incident-close-body .incident-close-notice { display:flex; align-items:flex-start; gap:8px; margin:0 0 14px; color:var(--text-2); font-size:12px; font-weight:600; line-height:1.55; cursor:pointer; }\nbody[data-ui-version=\"23\"] .incident-close-body .incident-close-notice input { flex:none; width:15px; height:15px; margin:2px 0 0; accent-color:var(--accent); }\nbody[data-ui-version=\"23\"] .incident-close-notice-lang { margin-left:4px; color:var(--text); font-weight:800; }\nbody[data-ui-version=\"23\"] .incident-close-notice-lang:not(:empty)::before { content:\"· \"; color:var(--text-2); font-weight:600; }\nbody[data-ui-version=\"23\"] .incident-close-status { min-height:22px; margin-top:2px; color:var(--text-3); font-size:12px; line-height:1.5; }\nbody[data-ui-version=\"23\"] .incident-close-status.ok { color:var(--success); }\nbody[data-ui-version=\"23\"] .incident-close-status.err { color:var(--danger); }\nbody[data-ui-version=\"23\"] .incident-close-actions { margin:0; padding:14px 26px 22px; border-top:1px solid var(--line); background:var(--surface); }\nbody[data-ui-version=\"23\"] .incident-close-actions .btn-filled { min-width:112px; color:#fff; background:linear-gradient(135deg,#dd716a,#c84f58); border-color:transparent; }\nbody[data-ui-version=\"23\"] .incident-close-actions .btn-filled:disabled { color:rgba(255,255,255,.72); }\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .incident-close-actions .btn-filled { color:#fff; }\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .incident-close-head { background:linear-gradient(135deg,var(--surface),var(--surface-soft)); }\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .incident-close-x { background:var(--surface-soft); }\n\n/* ---- v26.80：退货登记确认弹窗 ----\n   把原生 confirm() 换成自定义弹窗，只为一件事：**原生 confirm 不能输入备注**（也没法控制按钮顺序）。\n   按钮区沿用 .m-actions 的 flex-end ⇒ DOM 顺序「取消 → 确定」即渲染成「取消在左、确定在右」。 */\nbody[data-ui-version=\"23\"] .return-reg-modal {\n  width:min(540px,calc(100vw - 32px));\n  max-width:none;\n  padding:0;\n  overflow:hidden;\n}\nbody[data-ui-version=\"23\"] .return-reg-head {\n  display:flex;\n  align-items:flex-start;\n  justify-content:space-between;\n  gap:18px;\n  padding:24px 26px 18px;\n  border-bottom:1px solid var(--line);\n  background:linear-gradient(135deg,var(--surface),var(--surface-soft));\n}\nbody[data-ui-version=\"23\"] .return-reg-eyebrow { color:var(--success); font-size:10px; font-weight:800; letter-spacing:.16em; }\nbody[data-ui-version=\"23\"] .return-reg-head h2 { margin:5px 0 5px; color:var(--text); font-size:21px; letter-spacing:-.035em; }\nbody[data-ui-version=\"23\"] .return-reg-context { color:var(--text-3); font-size:12px; line-height:1.5; }\nbody[data-ui-version=\"23\"] .return-reg-x {\n  width:34px;\n  height:34px;\n  flex:0 0 auto;\n  border:1px solid var(--line);\n  border-radius:10px;\n  color:var(--text-3);\n  background:var(--surface);\n  font-size:24px;\n  line-height:1;\n  cursor:pointer;\n}\nbody[data-ui-version=\"23\"] .return-reg-x:hover { color:var(--text); border-color:var(--line-strong); background:var(--surface-soft); }\nbody[data-ui-version=\"23\"] .return-reg-body { padding:18px 26px 6px; }\nbody[data-ui-version=\"23\"] .return-reg-facts { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin:0 0 16px; }\nbody[data-ui-version=\"23\"] .return-reg-facts > div { min-width:0; padding:9px 11px; border:1px solid var(--line); border-radius:10px; background:var(--surface-soft); }\nbody[data-ui-version=\"23\"] .return-reg-facts dt { margin-bottom:4px; color:var(--text-3); font-size:11px; font-weight:700; }\nbody[data-ui-version=\"23\"] .return-reg-facts dd { margin:0; color:var(--text); font-size:12.5px; font-family:Consolas,monospace; overflow-wrap:anywhere; }\nbody[data-ui-version=\"23\"] .return-reg-warn { margin:-4px 0 14px; padding:8px 11px; border:1px solid var(--line); border-radius:10px; background:var(--surface-soft); color:var(--text-3); font-size:12px; line-height:1.5; }\nbody[data-ui-version=\"23\"] .return-reg-body label { display:block; margin:0 0 7px; color:var(--text-2); font-size:12px; font-weight:700; }\nbody[data-ui-version=\"23\"] .return-reg-opt { color:var(--text-3); font-weight:500; }\nbody[data-ui-version=\"23\"] .return-reg-meta { margin:-4px 0 14px; padding:8px 11px; border:1px dashed var(--line); border-radius:10px; color:var(--text-3); font-size:12px; line-height:1.5; }\nbody[data-ui-version=\"23\"] .return-reg-body input[type=\"text\"] { width:100%; min-height:40px; margin-bottom:16px; }\nbody[data-ui-version=\"23\"] .return-reg-body textarea { width:100%; min-height:76px; resize:vertical; line-height:1.6; }\nbody[data-ui-version=\"23\"] .return-reg-hint { margin-top:8px; color:var(--text-3); font-size:12px; line-height:1.5; }\nbody[data-ui-version=\"23\"] .return-reg-actions { margin:0; padding:14px 26px 22px; border-top:1px solid var(--line); background:var(--surface); }\nbody[data-ui-version=\"23\"] .return-reg-actions .btn-filled { min-width:112px; color:#fff; background:var(--success); border-color:var(--success); }\nbody[data-ui-version=\"23\"] .return-reg-actions .btn-filled:hover { filter:brightness(1.06); }\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .return-reg-actions .btn-filled { color:#fff; }\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .return-reg-x { background:var(--surface-soft); }\n\n@media (max-width:760px) {\n  body[data-ui-version=\"23\"] .incident-close-head,\n  body[data-ui-version=\"23\"] .incident-close-body,\n  body[data-ui-version=\"23\"] .incident-close-actions { padding-left:18px; padding-right:18px; }\n  body[data-ui-version=\"23\"] .return-reg-head,\n  body[data-ui-version=\"23\"] .return-reg-body,\n  body[data-ui-version=\"23\"] .return-reg-actions { padding-left:18px; padding-right:18px; }\n  body[data-ui-version=\"23\"] .return-reg-facts { grid-template-columns:1fr; }\n}\n\n/* Inbox order snapshot: a right-side drawer that reuses the preloaded OR11\n   response, so opening it never starts a second order request. */\nbody[data-ui-version=\"23\"] .inbox-v20 { position:relative; }\n/* v26.61：订单详情抽屉已上移为 .main 的直接子级（发货超时页也要能打开它），定位参照随之改为 .main。.inbox-v20 的 relative 必须保留 —— 站内信内的 .tpl-menu / .carrier-drop 仍以最近的 positioned 祖先为参照。 */\nbody[data-ui-version=\"23\"] .main { position:relative; }\nbody[data-ui-version=\"23\"] .order-detail-drawer {\n  position:absolute;\n  z-index:30;\n  top:0;\n  right:0;\n  bottom:0;\n  display:flex;\n  flex-direction:column;\n  width:min(520px,calc(100% - 24px));\n  min-width:360px;\n  background:var(--surface);\n  border-left:1px solid var(--line);\n  box-shadow:-18px 0 42px rgba(30,40,78,.14);\n}\n/* 抽屉是 flex 竖列：head(固定) + status(固定) + body(唯一滚动区)。\n   head / status 都必须 flex-shrink:0，只让 body 吸收收缩。 */\nbody[data-ui-version=\"23\"] .order-detail-head {\n  flex:0 0 auto;\n  display:flex;\n  align-items:flex-start;\n  justify-content:space-between;\n  gap:16px;\n  padding:22px 24px 18px;\n  border-bottom:1px solid var(--line);\n  background:linear-gradient(135deg,var(--surface),var(--surface-soft));\n}\nbody[data-ui-version=\"23\"] .order-detail-eyebrow {\n  color:var(--accent);\n  font-size:10px;\n  font-weight:800;\n  letter-spacing:.16em;\n  text-transform:uppercase;\n}\nbody[data-ui-version=\"23\"] .order-detail-head h2 {\n  margin:5px 0 5px;\n  color:var(--text);\n  font-size:21px;\n  letter-spacing:-.035em;\n}\nbody[data-ui-version=\"23\"] .order-detail-context { color:var(--text-3); font-size:12px; }\nbody[data-ui-version=\"23\"] .order-detail-close {\n  width:34px;\n  height:34px;\n  flex:0 0 auto;\n  border:1px solid var(--line);\n  border-radius:10px;\n  color:var(--text-3);\n  background:var(--surface);\n  font-size:24px;\n  line-height:1;\n  cursor:pointer;\n}\nbody[data-ui-version=\"23\"] .order-detail-close:hover { color:var(--text); border-color:var(--line-strong); background:var(--surface-soft); }\n/* ⚠️ status 原先带 min-height:0，等于摘掉 flex 的自动最小尺寸保护 —— body 内容一长，\n   负剩余空间按 flex-basis 比例把它一起压扁（实测压掉 7px），文字向下溢出后被\n   body 滚上来的卡片盖住，表现为「滚轮下拉时状态文字被截断」。\n   改为 flex-shrink:0 只让 body 吸收收缩。\n   （status 为空时本身没有内容和内边距，高度自然是 0，不需要靠可收缩来收起。） */\nbody[data-ui-version=\"23\"] .order-detail-status { flex:0 0 auto; padding:0 24px; color:var(--text-3); font-size:12px; }\nbody[data-ui-version=\"23\"] .order-detail-status.ok { padding-top:12px; color:var(--success); }\nbody[data-ui-version=\"23\"] .order-detail-status.warn { padding-top:12px; color:var(--warning); }\nbody[data-ui-version=\"23\"] .order-detail-status.err { padding-top:12px; color:var(--danger); }\nbody[data-ui-version=\"23\"] .order-detail-body { min-height:0; flex:1 1 auto; overflow:auto; padding:20px 24px 28px; }\nbody[data-ui-version=\"23\"] .order-detail-summary {\n  display:grid;\n  grid-template-columns:repeat(2,minmax(0,1fr));\n  gap:10px;\n  margin-bottom:20px;\n}\nbody[data-ui-version=\"23\"] .order-detail-stat {\n  min-width:0;\n  padding:13px 14px;\n  border:1px solid var(--line);\n  border-radius:12px;\n  background:var(--surface-soft);\n}\nbody[data-ui-version=\"23\"] .order-detail-stat.wide { grid-column:1/-1; }\nbody[data-ui-version=\"23\"] .order-detail-stat .label { color:var(--text-3); font-size:11px; }\nbody[data-ui-version=\"23\"] .order-detail-stat .value { margin-top:4px; color:var(--text); font-size:14px; font-weight:700; word-break:break-word; }\nbody[data-ui-version=\"23\"] .order-detail-stat.total .value { color:var(--accent); font-size:20px; letter-spacing:-.02em; }\nbody[data-ui-version=\"23\"] .order-detail-section { margin-top:20px; }\nbody[data-ui-version=\"23\"] .order-detail-section h3 { margin:0 0 10px; color:var(--text); font-size:13px; }\nbody[data-ui-version=\"23\"] .order-detail-section p { margin:4px 0; color:var(--text-2); font-size:12px; line-height:1.55; }\nbody[data-ui-version=\"23\"] .order-detail-lines { overflow:auto; border:1px solid var(--line); border-radius:12px; }\nbody[data-ui-version=\"23\"] .order-detail-lines table { width:100%; min-width:440px; border-collapse:collapse; }\nbody[data-ui-version=\"23\"] .order-detail-lines th,\nbody[data-ui-version=\"23\"] .order-detail-lines td { padding:9px 10px; border-bottom:1px solid var(--line); color:var(--text-2); font-size:11px; text-align:left; vertical-align:top; }\nbody[data-ui-version=\"23\"] .order-detail-lines th { color:var(--text-3); background:var(--surface-soft); font-weight:700; }\nbody[data-ui-version=\"23\"] .order-detail-lines tr:last-child td { border-bottom:0; }\nbody[data-ui-version=\"23\"] .order-detail-lines .num { text-align:right; white-space:nowrap; }\nbody[data-ui-version=\"23\"] .order-detail-badges { display:flex; flex-wrap:wrap; gap:7px; margin:0 0 16px; }\nbody[data-ui-version=\"23\"] .order-detail-empty { padding:26px 4px; color:var(--text-3); font-size:13px; text-align:center; }\n  /* ---- ERP 履约状态卡（ITGOAL 只读联查，v26.57）----\n     刻意不复用 .order-detail-section：那个类被 body[data-ui-version=\"23\"] 限定，\n     复用会让本卡在别的 UI 版本下丢样式。这里只用四套主题块都定义过的变量，\n     浅色/深色自动跟随，不写死任何颜色。 */\n  .erp-fulfill { margin-top:20px; border:1px solid var(--line); border-radius:12px; background:var(--surface-soft); overflow:hidden; }\n  .erp-fulfill-head { display:flex; align-items:center; gap:8px; padding:10px 12px; }\n  .erp-fulfill-head h3 { margin:0; color:var(--text); font-size:13px; font-weight:700; flex:0 0 auto; }\n  .erp-chip { font-size:11px; font-weight:700; padding:2px 8px; border-radius:99px; border:1px solid currentColor; white-space:nowrap; }\n  .erp-chip.ok { color:var(--success); }\n  .erp-chip.warn { color:var(--warning); }\n  .erp-chip.alert { color:var(--danger); }\n  .erp-chip.muted { color:var(--text-3); }\n  .erp-toggle { margin-left:6px; flex:0 0 auto; background:transparent; border:1px solid var(--line); color:var(--text-3); border-radius:8px; padding:3px 10px; font-size:11.5px; cursor:pointer; }\n  .erp-toggle:hover { color:var(--text); border-color:var(--accent); }\n  .erp-refresh { margin-left:auto; flex:0 0 auto; background:transparent; border:1px solid var(--line); color:var(--text-3); border-radius:8px; padding:3px 10px; font-size:11.5px; cursor:pointer; }\n  .erp-refresh:hover { color:var(--accent); border-color:var(--accent); }\n  .erp-cached { flex:0 0 auto; margin-left:6px; color:var(--text-3); font-size:11px; }\n  .erp-cached[hidden] { display:none; }\n  .erp-fulfill.refreshing .erp-refresh { opacity:.5; pointer-events:none; cursor:default; }\n  .erp-fulfill.no-refresh .erp-toggle { display:none; }\n  .erp-fulfill-body { padding:0 12px 12px; }\n  .erp-fulfill.collapsed .erp-fulfill-body { display:none; }\n  .erp-sysno { display:flex; align-items:baseline; gap:8px; margin-bottom:10px; padding:8px 10px; background:var(--card2); border:1px solid var(--line); border-radius:9px; }\n  .erp-sysno .k { flex:0 0 auto; color:var(--text-3); font-size:11px; }\n  .erp-sysno .v { color:var(--text); font-size:14px; font-weight:800; letter-spacing:.3px; font-family:ui-monospace,Consolas,\"Courier New\",monospace; word-break:break-all; }\n  .erp-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:8px; margin-bottom:10px; }\n  .erp-cell { background:var(--card2); border:1px solid var(--line); border-radius:9px; padding:7px 9px; min-width:0; }\n  .erp-cell .k { color:var(--text-3); font-size:11px; margin-bottom:3px; }\n  .erp-cell .v { color:var(--text); font-size:12.5px; font-weight:600; word-break:break-word; line-height:1.45; }\n  .erp-cell .v.muted { color:var(--text-3); font-weight:500; }\n  .erp-cell .v.good { color:var(--success); }\n  .erp-cell .v.bad { color:var(--danger); }\n  /* 物流号可点：点开是轨迹浮窗（v26.63）。按钮做成内联的，不影响 ERP 卡片网格对齐。 */\n  .erp-cell .track-link { display:inline-flex; align-items:center; gap:6px; background:none; border:0; padding:0; margin:0; color:var(--accent); font:inherit; font-weight:600; cursor:pointer; text-align:left; }\n  .erp-cell .track-link:hover { text-decoration:underline; }\n  .erp-cell .track-ico { flex:0 0 auto; font-size:10px; font-weight:500; color:var(--text-3); border:1px solid var(--line); border-radius:999px; padding:0 6px; line-height:15px; white-space:nowrap; }\n  .erp-cell .track-link:hover .track-ico { color:var(--accent); border-color:var(--accent); }\n  .erp-cell .track-link[aria-busy=\"true\"] { opacity:.55; pointer-events:none; }\n\n  /* ---- 物流轨迹浮窗 ---- */\n  .track-mask { position:fixed; inset:0; background:var(--mask); backdrop-filter:blur(3px); display:flex; align-items:center; justify-content:center; z-index:80; padding:24px; }\n  .track-panel { width:min(760px,94vw); max-height:86vh; display:flex; flex-direction:column; background:var(--card); border:1px solid var(--border); border-radius:16px; box-shadow:0 20px 60px var(--shadow); overflow:hidden; }\n  /* ⚠️ 头部与操作区一律 flex:0 0 auto：抽屉里踩过「flex 收缩把文字压扁」的坑（v26.62），\n     浮窗里 body 内容更高，更容易把 head 挤变形。 */\n  .track-head { flex:0 0 auto; display:flex; align-items:flex-start; justify-content:space-between; gap:14px; padding:15px 18px; border-bottom:1px solid var(--border); }\n  .track-head h3 { margin:0 0 5px; font-size:15px; font-weight:650; }\n  .track-sub { display:flex; flex-wrap:wrap; align-items:center; gap:8px; font-size:12px; color:var(--text-3); }\n  .track-sub .num { font-family:Consolas,monospace; color:var(--text-2); font-weight:600; }\n  .track-chip { font-size:10.5px; border:1px solid var(--line); border-radius:999px; padding:1px 8px; color:var(--text-2); }\n  .track-chip.fourpx { color:var(--accent); border-color:var(--accent); }\n  .track-actions { flex:0 0 auto; display:flex; align-items:center; gap:8px; }\n  .track-btn { background:var(--card2); border:1px solid var(--border); color:var(--text-2); border-radius:9px; padding:6px 11px; font-size:12px; cursor:pointer; text-decoration:none; white-space:nowrap; }\n  .track-btn:hover { border-color:var(--accent); color:var(--accent); }\n  .track-body { flex:1 1 auto; min-height:0; overflow:auto; padding:14px 18px 18px; }\n  .track-hint { font-size:11.5px; color:var(--text-3); line-height:1.65; margin-bottom:10px; text-align:left; }\n  .track-hint b { color:var(--text-2); }\n  .track-list { margin:4px 0 0 16px; padding:0; }\n  .track-list li { margin:1px 0; }\n  .track-frame { display:block; width:100%; height:min(660px,70vh); border:0; border-radius:10px; background:#fff; }\n  .track-state { padding:34px 10px; text-align:center; color:var(--text-3); font-size:12.5px; line-height:1.7; }\n  .track-state .big { display:block; font-size:13.5px; color:var(--text-2); margin-bottom:6px; font-weight:600; }\n  .track-state .track-btn { display:inline-block; margin-top:12px; }\n  .track-spin { display:inline-block; width:15px; height:15px; margin-right:8px; border:2px solid var(--line); border-top-color:var(--accent); border-radius:50%; animation:track-spin .8s linear infinite; vertical-align:-2px; }\n  @keyframes track-spin { to { transform:rotate(360deg); } }\n\n  .tp-sum { display:flex; flex-wrap:wrap; gap:7px; margin-bottom:14px; }\n  .tp-sum span { font-size:11.5px; color:var(--text-2); background:var(--card2); border:1px solid var(--line); border-radius:8px; padding:4px 9px; }\n  .tp-list { list-style:none; margin:0; padding:0; }\n  .tp { display:flex; gap:10px; padding:9px 0; }\n  .tp-dot { flex:0 0 auto; width:11px; height:11px; margin-top:4px; border-radius:50%; background:var(--card); border:2px solid var(--text-3); box-sizing:border-box; }\n  .tp-body { flex:1 1 auto; min-width:0; }\n  .tp-action { font-size:12.8px; line-height:1.5; color:var(--text); word-break:break-word; }\n  .tp-meta { font-size:10.5px; color:var(--text-3); margin-top:2px; font-family:Consolas,monospace; word-break:break-all; }\n  .tp-time { flex:0 0 auto; font-size:11.5px; color:var(--text-3); font-variant-numeric:tabular-nums; white-space:nowrap; }\n  .tp.tone-ok .tp-dot { border-color:var(--success); background:var(--success); }\n  .tp.tone-ok .tp-action { color:var(--success); font-weight:600; }\n  .tp.tone-warn .tp-dot { border-color:#d6a03b; }\n  .tp.tone-warn .tp-action { color:#b07d1f; }\n  .tp.tone-err .tp-dot { border-color:var(--danger); background:var(--danger); }\n  .tp.tone-err .tp-action { color:var(--danger); }\n  html[data-theme=\"dark\"] .tp.tone-warn .tp-action { color:#e0b055; }\n  html[data-theme=\"dark\"] .track-frame { background:#1b2036; }\n\n  body[data-ui-version=\"23\"] .track-panel { border-radius:24px; border-color:rgba(255,255,255,.6); }\n  body[data-ui-version=\"23\"] .track-mask { background:rgba(13,17,35,.46); backdrop-filter:blur(8px); }\n  body[data-ui-version=\"23\"] .track-head { padding:18px 22px; }\n  body[data-ui-version=\"23\"] .track-head h3 { font-size:17px; letter-spacing:-.02em; }\n  body[data-ui-version=\"23\"] .track-body { padding:16px 22px 22px; }\n  body[data-ui-version=\"23\"] .track-btn { border-radius:11px; padding:8px 13px; }\n  .erp-skus { width:100%; border-collapse:collapse; border:1px solid var(--line); border-radius:9px; overflow:hidden; }\n  .erp-skus th, .erp-skus td { padding:7px 9px; border-bottom:1px solid var(--line); font-size:11.5px; text-align:left; vertical-align:top; color:var(--text-2); }\n  .erp-skus th { color:var(--text-3); background:var(--card2); font-weight:700; white-space:nowrap; }\n  .erp-skus tr:last-child td { border-bottom:0; }\n  .erp-skus .num { text-align:right; white-space:nowrap; }\n  .erp-skus .sku { font-family:ui-monospace,Consolas,\"Courier New\",monospace; word-break:break-all; }\n  .erp-skus .sku.platform { color:var(--accent); }\n  .erp-skus .sku.product { color:var(--success); }\n  .erp-alert { margin-top:8px; padding:7px 9px; border:1px solid var(--danger); border-radius:9px; color:var(--danger); font-size:11.5px; line-height:1.5; word-break:break-word; }\n  /* ---- 拦截条（v26.74）----\n     只在「捎客海外仓 + 待拣货」时出现，是这张卡里唯一会改上游数据的按钮，\n     所以做成整条横幅而不是角落里的小按钮，避免误点。 */\n  .erp-intercept { margin-top:8px; display:flex; align-items:center; gap:10px; padding:8px 10px; border:1px solid var(--line); border-left:3px solid var(--warning); border-radius:9px; background:var(--card2); }\n  .erp-intercept[hidden] { display:none; }\n  .erp-intercept .txt { flex:1 1 auto; min-width:0; font-size:11.5px; line-height:1.55; color:var(--text-3); word-break:break-word; }\n  .erp-intercept .txt b { color:var(--text-2); }\n  .erp-intercept .erp-intercept-btn { flex:0 0 auto; background:transparent; border:1px solid var(--warning); color:var(--warning); border-radius:8px; padding:5px 14px; font-size:12px; font-weight:700; cursor:pointer; white-space:nowrap; }\n  .erp-intercept .erp-intercept-btn:hover { background:var(--warning); color:var(--card2); }\n  .erp-intercept .erp-intercept-btn[disabled] { opacity:.55; cursor:default; }\n  .erp-intercept.busy { border-left-color:var(--text-3); }\n  /* v26.75：「移入已发货」不可逆 ⇒ 用 danger 色系，比常规拦截更醒目。\n     ⚠️ ERP 区块加样式只能用下面这批变量（verify-itgoal-fulfillment-ui.mjs 的白名单）。 */\n  .erp-intercept.danger { border-left-color:var(--danger); }\n  .erp-intercept.danger .erp-intercept-btn { border-color:var(--danger); color:var(--danger); }\n  .erp-intercept.danger .erp-intercept-btn:hover { background:var(--danger); color:var(--card2); }\n  .erp-intercept .erp-intercept-msg { flex:1 1 auto; min-width:0; font-size:11.5px; line-height:1.55; word-break:break-word; }\n  .erp-intercept .erp-intercept-msg.ok { color:var(--success); }\n  .erp-intercept .erp-intercept-msg.bad { color:var(--danger); }\n  .erp-note { padding:10px 12px; color:var(--text-3); font-size:11.5px; line-height:1.6; }\n  .erp-note.err { color:var(--danger); }\n  .erp-note .erp-retry { margin-left:8px; background:transparent; border:1px solid currentColor; color:inherit; border-radius:8px; padding:2px 8px; font-size:11px; cursor:pointer; }\n\n  /* ---- ERP 账号录入（v26.77）----\n     为什么要有：Chromium 127 起对新保存的密码改用 App-Bound 加密（密文前缀 v20），\n     工作台再也读不出浏览器里的 itgoal 密码 —— 只能给一条不依赖浏览器的自有链路。\n     配色一律走主题变量，浅色/深色自动跟随。 */\n  .erp-note .erp-cred-open { margin-left:8px; background:transparent; border:1px solid currentColor; color:inherit; border-radius:8px; padding:2px 8px; font-size:11px; cursor:pointer; }\n  .erp-cred-form { margin-top:8px; padding:10px 12px; background:var(--card2); border:1px solid var(--line); border-radius:10px; }\n  .erp-cred-form[hidden] { display:none; }\n  .erp-cred-row { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:8px; }\n  .erp-cred-field { flex:1 1 190px; min-width:0; }\n  .erp-cred-field span { display:block; color:var(--text-3); font-size:11px; margin-bottom:3px; }\n  .erp-cred-field input { width:100%; box-sizing:border-box; background:var(--card); border:1px solid var(--line); color:var(--text); border-radius:8px; padding:6px 9px; font-size:12.5px; }\n  .erp-cred-field input:focus { outline:none; border-color:var(--accent); }\n  .erp-cred-actions { display:flex; flex-wrap:wrap; align-items:center; gap:8px; }\n  .erp-cred-btn { background:transparent; border:1px solid var(--line); color:var(--text-3); border-radius:8px; padding:4px 12px; font-size:11.5px; cursor:pointer; }\n  .erp-cred-btn:hover { color:var(--text); border-color:var(--accent); }\n  .erp-cred-btn[disabled] { opacity:.5; pointer-events:none; cursor:default; }\n  .erp-cred-btn.primary { border-color:var(--accent); color:var(--accent); }\n  .erp-cred-note { margin-top:8px; color:var(--text-3); font-size:11px; line-height:1.6; }\n  .erp-cred-note.err { color:var(--danger); }\n  .erp-cred-note.ok { color:var(--success); }\nbody[data-ui-version=\"23\"] .thread-head-actions { display:flex; align-items:center; justify-content:flex-end; gap:8px; flex:0 0 auto; }\nbody[data-ui-version=\"23\"] .mail-order-amount { margin-left:auto; font-weight:700; white-space:nowrap; }\nbody[data-ui-version=\"23\"] .mail-order-amount.tiny { color:#27866a; }\nbody[data-ui-version=\"23\"] .mail-order-amount.low { color:#477cf2; }\nbody[data-ui-version=\"23\"] .mail-order-amount.mid { color:#b67b1c; }\nbody[data-ui-version=\"23\"] .mail-order-amount.high { color:#d94d4d; font-weight:800; }\nbody[data-ui-version=\"23\"] .mail-order-amount.unknown { color:var(--text-3); font-weight:500; }\nbody[data-ui-version=\"23\"] .order-head .mail-order-amount { margin-left:8px; }\nbody[data-ui-version=\"23\"] .inbox-v20 .mail-incident-badge {\n  display:inline-flex;\n  align-items:center;\n  gap:4px;\n  flex:0 0 auto;\n  padding:2px 7px;\n  border-radius:999px;\n  color:#c9474d;\n  background:#fff0f0;\n  border:1px solid #f2c5c7;\n  font-size:10px;\n  font-weight:750;\n  line-height:1.25;\n  white-space:nowrap;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .mail-incident-dot {\n  width:5px;\n  height:5px;\n  border-radius:50%;\n  background:#e55d62;\n  flex:0 0 auto;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .mail-incident-badge.resolved {\n  color:#22835f;\n  background:#edf9f3;\n  border-color:#b7e3cc;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .mail-incident-badge.resolved .mail-incident-dot { background:#35a875; }\nbody[data-ui-version=\"23\"] .inbox-v20 .mail-refund-badge {\n  display:inline-flex;\n  align-items:center;\n  flex:0 0 auto;\n  margin-left:6px;\n  padding:2px 7px;\n  border-radius:999px;\n  font-size:10px;\n  font-weight:750;\n  line-height:1.25;\n  white-space:nowrap;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .mail-refund-badge.refunded {\n  color:#22835f;\n  background:#edf9f3;\n  border:1px solid #b7e3cc;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .mail-refund-badge.partial {\n  color:#a76816;\n  background:#fff7e8;\n  border:1px solid #f0d39a;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .order-head .mail-incident-badge { margin-left:8px; }\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .inbox-v20 .mail-incident-badge {\n  color:#ffaaa6;\n  background:rgba(229,93,98,.14);\n  border-color:rgba(229,93,98,.38);\n}\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .inbox-v20 .mail-incident-dot { background:#ff8881; }\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .inbox-v20 .mail-incident-badge.resolved,\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .inbox-v20 .mail-refund-badge.refunded {\n  color:#8ce0b7;\n  background:rgba(53,168,117,.14);\n  border-color:rgba(53,168,117,.38);\n}\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .inbox-v20 .mail-refund-badge.partial {\n  color:#f2c477;\n  background:rgba(240,179,74,.14);\n  border-color:rgba(240,179,74,.38);\n}\n\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .order-detail-drawer { box-shadow:-18px 0 42px rgba(0,0,0,.35); }\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .order-detail-drawer,\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .order-detail-head { background:var(--surface); }\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .order-detail-stat { background:var(--surface-soft); }\n/* ---- v26.81：对话头 5 个操作按钮 —— 5 个色相 / 两级层次 ----\n   原来「标记未读 / 订单详情 / 申请退货标签」都是白底灰框，一行 5 个按钮只靠文字区分。\n   现在每个按钮一个色相：琥珀 → 红 → 紫 → 青绿 → 靛蓝，并且分两层 ——\n   **实心**只留给「关闭事件（终结动作）」与「快捷退款（主行动）」，其余是**同色色调底**，\n   既拉满可辨识度，又不会 5 个满饱和色互相打架。\n   图标是 mask + currentColor ⇒ 只写 color 就能连图标一起换色。 */\nbody[data-ui-version=\"23\"] .thread-head-actions > .btn {\n  flex:0 0 auto;\n  min-height:36px;\n  padding:0 13px;\n  border:1px solid transparent;\n  box-shadow:none;\n}\n\n/* ① 标记未读 · 琥珀（把会话重新挂回「待处理」） */\nbody[data-ui-version=\"23\"] .btn.mark-unread-trigger {\n  color:var(--act-unread);\n  background:var(--act-unread-soft);\n  border-color:var(--act-unread-line);\n}\nbody[data-ui-version=\"23\"] .btn.mark-unread-trigger:hover {\n  color:#fff;\n  background:var(--act-unread);\n  border-color:var(--act-unread);\n  box-shadow:0 8px 18px var(--act-unread-glow);\n  transform:translateY(-1px);\n}\n\n/* ② 关闭事件 · 红（实心：终结动作，不可逆） */\nbody[data-ui-version=\"23\"] .btn.incident-close-trigger {\n  color:#fff;\n  background:var(--act-close-grad);\n  border-color:transparent;\n  box-shadow:0 8px 18px var(--act-close-glow);\n}\nbody[data-ui-version=\"23\"] .btn.incident-close-trigger:hover {\n  color:#fff;\n  background:var(--act-close-grad-hover);\n  border-color:transparent;\n  box-shadow:0 10px 22px var(--act-close-glow-hover);\n  transform:translateY(-1px);\n}\n\n/* ③ 订单详情 · 紫（只读查看） */\nbody[data-ui-version=\"23\"] .btn.order-detail-trigger {\n  color:var(--act-detail);\n  background:var(--act-detail-soft);\n  border-color:var(--act-detail-line);\n}\nbody[data-ui-version=\"23\"] .btn.order-detail-trigger:hover {\n  color:#fff;\n  background:var(--act-detail);\n  border-color:var(--act-detail);\n  box-shadow:0 8px 18px var(--act-detail-glow);\n  transform:translateY(-1px);\n}\n\n/* ④ 申请退货标签 · 青绿（退货物流） */\nbody[data-ui-version=\"23\"] .btn.return-label-trigger {\n  color:var(--act-return);\n  background:var(--act-return-soft);\n  border-color:var(--act-return-line);\n}\nbody[data-ui-version=\"23\"] .btn.return-label-trigger:hover {\n  color:#fff;\n  background:var(--act-return);\n  border-color:var(--act-return);\n  box-shadow:0 8px 18px var(--act-return-glow);\n  transform:translateY(-1px);\n}\n\n/* ⑤ 快捷退款 · 靛蓝（实心：主行动） */\nbody[data-ui-version=\"23\"] .btn.quick-refund-trigger {\n  color:#fff;\n  background:var(--act-refund-grad);\n  border-color:transparent;\n  box-shadow:0 8px 18px var(--act-refund-glow);\n}\nbody[data-ui-version=\"23\"] .btn.quick-refund-trigger:hover {\n  color:#fff;\n  background:var(--act-refund-grad-hover);\n  border-color:transparent;\n  box-shadow:0 10px 22px var(--act-refund-glow-hover);\n  transform:translateY(-1px);\n}\n\n/* 深色主题：色调底按钮的 hover 不能翻成「亮色填充 + 白字」（#f0be63 上写白字只有 1.6:1），\n   改成「底色加深 + 边框实色 + 文字保持亮色」——保留反馈，不掉对比。 */\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .btn.mark-unread-trigger:hover {\n  color:var(--act-unread); background:var(--act-unread-deep); border-color:var(--act-unread);\n}\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .btn.order-detail-trigger:hover {\n  color:var(--act-detail); background:var(--act-detail-deep); border-color:var(--act-detail);\n}\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .btn.return-label-trigger:hover {\n  color:var(--act-return); background:var(--act-return-deep); border-color:var(--act-return);\n}\n\n@media (max-width:760px) {\n  body[data-ui-version=\"23\"] .order-detail-drawer { width:100%; min-width:0; }\n  body[data-ui-version=\"23\"] .order-detail-body,\n  body[data-ui-version=\"23\"] .order-detail-head { padding-left:18px; padding-right:18px; }\n  body[data-ui-version=\"23\"] .order-detail-status { padding-left:18px; padding-right:18px; }\n  body[data-ui-version=\"23\"] .thread-head-actions > .btn { min-height:34px; padding:0 10px; font-size:12px; }\n  body[data-ui-version=\"23\"] .thread-head-actions { flex-wrap:wrap; }\n}\n\n/* Icons: Lucide v1.8.0, ISC license. Embedded as image assets. */\n:root {\n  --icon-dashboard:url(\"data:image/svg+xml;base64,\");\n  --icon-inbox:url(\"data:image/svg+xml;base64,\");\n  --icon-refund:url(\"data:image/svg+xml;base64,\");\n  --icon-ship:url(\"data:image/svg+xml;base64,\");\n  --icon-returnlabel:url(\"data:image/svg+xml;base64,\");\n  --icon-return-registration:url(\"data:image/svg+xml;base64,\");\n  --icon-offers:url(\"data:image/svg+xml;base64,\");\n  --icon-sun:url(\"data:image/svg+xml;base64,\");\n  --icon-moon:url(\"data:image/svg+xml;base64,\");\n  --icon-template:url(\"data:image/svg+xml;base64,\");\n  --icon-settings:url(\"data:image/svg+xml;base64,\");\n  --icon-compose:url(\"data:image/svg+xml;base64,\");\n  --icon-refresh:url(\"data:image/svg+xml;base64,\");\n  --icon-read:url(\"data:image/svg+xml;base64,\");\n  --icon-star:url(\"data:image/svg+xml;base64,\");\n  --icon-orders:url(\"data:image/svg+xml;base64,\");\n  --icon-revenue:url(\"data:image/svg+xml;base64,\");\n  --icon-cart:url(\"data:image/svg+xml;base64,\");\n  --icon-comments:url(\"data:image/svg+xml;base64,\");\n  --icon-alert:url(\"data:image/svg+xml;base64,\");\n  --icon-clock:url(\"data:image/svg+xml;base64,\");\n  --icon-check:url(\"data:image/svg+xml;base64,\");\n  --icon-paperclip:url(\"data:image/svg+xml;base64,\");\n  --icon-send:url(\"data:image/svg+xml;base64,\");\n  --icon-arrowRight:url(\"data:image/svg+xml;base64,\");\n  --icon-lightbulb:url(\"data:image/svg+xml;base64,\");\n  --icon-calendar:url(\"data:image/svg+xml;base64,\");\n  --icon-chart:url(\"data:image/svg+xml;base64,\");\n  --icon-agent:url(\"data:image/svg+xml;base64,\");\n}\n\n.nav-item[data-page=\"dashboard\"] .ni{--icon:var(--icon-dashboard)}\n.nav-item[data-page=\"inbox\"] .ni{--icon:var(--icon-inbox)}\n.nav-item[data-page=\"refund\"] .ni{--icon:var(--icon-refund)}\n.nav-item[data-page=\"ship\"] .ni{--icon:var(--icon-ship)}\n.nav-item[data-page=\"shipping-overdue\"] .ni{--icon:var(--icon-ship)}\n.nav-item[data-page=\"returnlabel\"] .ni{--icon:var(--icon-returnlabel)}\n.nav-item[data-page=\"return-registration\"] .ni{--icon:var(--icon-return-registration)}\n.nav-item[data-page=\"offers\"] .ni{--icon:var(--icon-offers)}\n.nav-item[data-page=\"offer-radar\"] .ni{--icon:var(--icon-alert)}\n.nav-item[data-page=\"offer-offline\"] .ni{--icon:var(--icon-alert)}\n.nav-item[data-page=\"watchlist\"] .ni{--icon:var(--icon-star)}\n.nav-item[data-page=\"wms\"] .ni{--icon:var(--icon-orders)}\n.nav-item[data-page=\"fourpx\"] .ni{--icon:var(--icon-orders)}\n.nav-item[data-page=\"agent\"] .ni{--icon:var(--icon-agent)}\n.k-icon.i-grade{--icon:var(--icon-star)}\n.k-icon.i-orders{--icon:var(--icon-orders)}\n.k-icon.i-revenue{--icon:var(--icon-revenue)}\n.k-icon.i-cart{--icon:var(--icon-cart)}\n.k-icon.i-offers{--icon:var(--icon-offers)}\n.k-icon.i-eval{--icon:var(--icon-comments)}\n\n/* v26.8 inbox conversation ergonomics: keep the reply composer compact so\n   the conversation gets the vertical space; all composer controls stay in\n   the lower action area. Incoming and outgoing messages use opposing rails. */\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-box {\n  display:flex;\n  flex-direction:column;\n  padding:10px 18px 12px;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-box textarea {\n  order:1;\n  min-height:64px;\n  max-height:112px;\n  padding:10px 12px;\n  border-radius:11px;\n  font-size:13px;\n  line-height:1.5;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-tools {\n  order:2;\n  min-height:30px;\n  margin:7px 0 0;\n  gap:8px;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-tools .tpl-menu {\n  top:auto;\n  bottom:calc(100% + 8px);\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-row {\n  order:3;\n  min-height:34px;\n  margin-top:6px;\n  gap:8px;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-row .btn {\n  min-height:34px;\n  padding:0 12px;\n  font-size:12px;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .msg-incoming { margin-right:auto; }\nbody[data-ui-version=\"23\"] .inbox-v20 .msg-outgoing {\n  margin-left:auto;\n  flex-direction:row-reverse;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .msg-outgoing .msg-body {\n  background:linear-gradient(135deg,#eef2ff,#e8efff);\n  border:1px solid #d9e2ff;\n}\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .inbox-v20 .msg-outgoing .msg-body {\n  background:linear-gradient(135deg,rgba(75,91,190,.36),rgba(59,80,159,.3));\n  border:1px solid rgba(133,136,255,.28);\n}\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .inbox-v20 .reply-box textarea {\n  background:var(--surface-soft);\n  border-color:var(--line);\n}\n@media (max-width:760px) {\n  body[data-ui-version=\"23\"] .inbox-v20 .reply-box { padding-left:12px; padding-right:12px; }\n  body[data-ui-version=\"23\"] .inbox-v20 .reply-tools { flex-wrap:wrap; }\n  body[data-ui-version=\"23\"] .inbox-v20 .reply-tools label { margin-left:0 !important; }\n  body[data-ui-version=\"23\"] .inbox-v20 .reply-row { flex-wrap:wrap; }\n  body[data-ui-version=\"23\"] .inbox-v20 .reply-row .status { width:100%; }\n}\n\n/* v26.9 inbox density pass: filters and order search occupy separate rails;\n   the composer keeps one compact textarea plus one horizontal action line. */\nbody[data-ui-version=\"23\"] .inbox-v20 .inbox-commandbar {\n  min-height:94px;\n  padding:8px 12px 9px;\n  display:flex;\n  flex-direction:column;\n  align-items:stretch;\n  justify-content:center;\n  gap:6px;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .inbox-filter-row,\nbody[data-ui-version=\"23\"] .inbox-v20 .inbox-search-row {\n  display:flex;\n  align-items:center;\n  min-width:0;\n  width:100%;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .inbox-filter-row {\n  justify-content:space-between;\n  gap:8px;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .inbox-filter-tabs {\n  display:flex;\n  align-items:center;\n  gap:4px;\n  min-width:0;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .inbox-filter-tabs .filter-tab {\n  flex:0 0 auto;\n  padding:5px 11px;\n  font-size:12px;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .inbox-filter-row .all-count {\n  flex:0 1 auto;\n  min-width:0;\n  max-width:58%;\n  margin-left:auto;\n  overflow:hidden;\n  text-overflow:ellipsis;\n  white-space:nowrap;\n  text-align:right;\n  font-size:11px;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .inbox-search-row {\n  gap:0;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .inbox-search-row .inbox-shop-tag {\n  display:none !important;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .inbox-search-row .inbox-search {\n  display:flex;\n  align-items:center;\n  flex:1 1 auto;\n  width:100%;\n  min-width:0;\n  margin:0;\n  gap:5px;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .inbox-search-row .inbox-search input {\n  flex:1 1 auto;\n  width:auto;\n  min-width:0;\n  padding:6px 9px;\n  font-size:12px;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .inbox-search-row .inbox-search button {\n  flex:0 0 auto;\n  padding:6px 9px;\n  font-size:11px;\n}\n\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-box {\n  padding:7px 14px 8px;\n  gap:0;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-box textarea {\n  order:1;\n  min-height:42px;\n  max-height:78px;\n  padding:8px 10px;\n  border-radius:10px;\n  font-size:12px;\n  line-height:1.45;\n}\n/* v26.44 reply composer resizer: make the vertical height control easy to find\n   while keeping the composer compact by default. */\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-resize-handle {\n  order:0;\n  flex:0 0 12px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  width:100%;\n  margin:-3px 0 1px;\n  border:0;\n  border-radius:8px;\n  background:transparent;\n  color:var(--text-3);\n  cursor:ns-resize;\n  touch-action:none;\n  user-select:none;\n  outline:0;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-resize-handle::before {\n  content:\"\";\n  width:54px;\n  height:4px;\n  border-radius:99px;\n  background:var(--line-strong);\n  box-shadow:0 0 0 1px rgba(37,99,235,.05);\n  transition:width .14s ease, background .14s ease, box-shadow .14s ease;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-resize-handle:hover::before,\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-resize-handle:focus-visible::before,\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-resize-handle.is-dragging::before {\n  width:82px;\n  background:var(--accent);\n  box-shadow:0 0 0 3px var(--focus);\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-resize-handle:focus-visible {\n  box-shadow:0 0 0 3px var(--focus);\n}\nbody.reply-resizing,\nbody.reply-resizing * {\n  cursor:ns-resize !important;\n  user-select:none !important;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-box textarea {\n  min-height:42px;\n  max-height:min(360px,46vh);\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-actions {\n  order:2;\n  display:flex;\n  align-items:center;\n  gap:8px;\n  width:100%;\n  min-width:0;\n  min-height:30px;\n  margin-top:5px;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-actions .reply-tools {\n  order:initial;\n  display:flex;\n  align-items:center;\n  flex:1 1 auto;\n  min-width:0;\n  gap:6px;\n  margin:0;\n  min-height:30px;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-actions .reply-tools label {\n  flex:0 1 auto;\n  min-width:0;\n  max-width:100%;\n  margin-left:auto !important;\n  overflow:hidden;\n  text-overflow:ellipsis;\n  white-space:nowrap;\n  font-size:11px !important;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-actions .reply-tools label span {\n  overflow:hidden;\n  text-overflow:ellipsis;\n  white-space:nowrap;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-recipient-control {\n  display:flex;\n  align-items:center;\n  gap:6px;\n  flex:0 1 auto;\n  min-width:0;\n  margin-left:2px;\n  color:var(--text-3);\n  font-size:11px !important;\n  white-space:nowrap;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-recipient-control select {\n  min-height:30px;\n  max-width:178px;\n  padding:0 8px;\n  border:1px solid #dfe4ef;\n  border-radius:9px;\n  color:var(--text-2);\n  background:var(--surface-soft);\n  font:inherit;\n  cursor:pointer;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-recipient-control select:focus {\n  outline:0;\n  border-color:var(--accent);\n  box-shadow:0 0 0 3px var(--focus);\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-actions .reply-row {\n  order:initial;\n  flex:0 0 auto;\n  width:auto !important;\n  max-width:100%;\n  min-width:0;\n  min-height:30px;\n  margin:0;\n  gap:6px;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-actions .reply-row .status:empty { display:none; }\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-actions .reply-row .status {\n  max-width:150px;\n  overflow:hidden;\n  text-overflow:ellipsis;\n  white-space:nowrap;\n  font-size:11px;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-actions .reply-row .btn,\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-actions .reply-tools .btn {\n  min-height:30px;\n  padding:0 10px;\n  border-radius:9px;\n  font-size:11px;\n  white-space:nowrap;\n}\nbody[data-ui-version=\"23\"] .inbox-v20 .reply-actions .reply-row #btnReply {\n  min-width:82px;\n}\n@media (max-width:1450px) {\n  body[data-ui-version=\"23\"] .inbox-v20 .order-head {\n    display:grid;\n    grid-template-columns:14px minmax(0,1fr) auto auto;\n    grid-template-areas:\n      \"caret oid oid time\"\n      \"caret badge amount meta\";\n    align-items:center;\n    column-gap:7px;\n    row-gap:4px;\n    min-height:64px;\n    padding:10px 12px;\n  }\n  body[data-ui-version=\"23\"] .inbox-v20 .order-head .caret {\n    grid-area:caret;\n    align-self:start;\n    margin-top:2px;\n  }\n  body[data-ui-version=\"23\"] .inbox-v20 .order-head .oid {\n    grid-area:oid;\n    min-width:0;\n  }\n  body[data-ui-version=\"23\"] .inbox-v20 .order-head .mail-incident-badge {\n    grid-area:badge;\n    margin-left:0;\n    justify-self:start;\n  }\n  body[data-ui-version=\"23\"] .inbox-v20 .order-head .mail-order-amount {\n    grid-area:amount;\n    margin-left:0;\n  }\n  body[data-ui-version=\"23\"] .inbox-v20 .order-head .gmeta {\n    grid-area:meta;\n    margin-left:0;\n    justify-self:end;\n    gap:4px;\n    font-size:10px;\n  }\n  body[data-ui-version=\"23\"] .inbox-v20 .order-head .time {\n    grid-area:time;\n    align-self:start;\n  }\n}\n@media (max-width:760px) {\n  body[data-ui-version=\"23\"] .inbox-v20 .inbox-commandbar { min-height:94px; }\n  body[data-ui-version=\"23\"] .inbox-v20 .inbox-filter-row .all-count { max-width:52%; }\n  body[data-ui-version=\"23\"] .inbox-v20 .reply-actions { flex-wrap:wrap; }\n  body[data-ui-version=\"23\"] .inbox-v20 .reply-actions .reply-tools,\n  body[data-ui-version=\"23\"] .inbox-v20 .reply-actions .reply-row { flex:1 1 100%; }\n  body[data-ui-version=\"23\"] .inbox-v20 .reply-actions .reply-tools label { margin-left:0 !important; }\n}\n\n</style>\n<!-- WMS overseas returns -->\n<style>\nbody[data-ui-version=\"23\"] .operations-page > .wms-returns {\n  width:min(100%,1660px);\n  max-width:none;\n  margin:0 auto;\n  padding:28px 26px 48px;\n}\n.wms-returns .wms-header {\n  display:flex;\n  align-items:flex-start;\n  justify-content:space-between;\n  gap:16px;\n  margin-bottom:18px;\n}\n.wms-returns .wms-header h2 { margin:0 0 6px; }\n.wms-returns .wms-sub { color:var(--text-3); line-height:1.65; font-size:12px; }\n.wms-returns .wms-sync-note {\n  flex:0 0 auto;\n  max-width:360px;\n  padding:9px 12px;\n  color:var(--text-2);\n  background:var(--surface-soft);\n  border:1px solid var(--line);\n  border-radius:10px;\n  font-size:11.5px;\n  line-height:1.5;\n}\n.wms-returns .wms-filter-panel,\n.wms-returns .wms-table-panel {\n  background:var(--surface);\n  border:1px solid var(--line);\n  border-radius:var(--radius-panel);\n  box-shadow:var(--shadow-xs);\n}\n.wms-returns .wms-filter-panel { padding:15px 16px 12px; margin-bottom:14px; }\n.wms-returns .wms-filter-row {\n  display:flex;\n  align-items:flex-end;\n  gap:10px;\n  flex-wrap:wrap;\n}\n.wms-returns .wms-field { min-width:145px; }\n.wms-returns .wms-field.wms-field-search-type { flex:0 0 140px; min-width:140px; }\n.wms-returns .wms-field.wms-field-search { flex:1 1 250px; min-width:220px; }\n.wms-returns .wms-field label {\n  display:block;\n  margin:0 0 5px;\n  color:var(--text-3);\n  font-size:11px;\n  font-weight:650;\n}\n.wms-returns .wms-control {\n  width:100%;\n  min-height:36px;\n  padding:8px 10px;\n  color:var(--text);\n  background:var(--surface-soft);\n  border:1px solid var(--line);\n  border-radius:var(--radius-control);\n  outline:0;\n  font-size:12px;\n}\n.wms-returns .wms-field-search textarea { min-height:36px; resize:vertical; line-height:1.45; }\n.wms-returns .wms-control:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--focus); }\n.wms-returns .wms-filter-actions { display:flex; gap:8px; align-items:flex-end; }\n.wms-returns .wms-filter-hint { margin-top:10px; color:var(--text-3); font-size:11px; line-height:1.55; }\n.wms-returns .wms-action-bar {\n  display:flex;\n  align-items:center;\n  gap:12px;\n  flex-wrap:wrap;\n  padding:13px 16px;\n  border-bottom:1px solid var(--line);\n}\n.wms-returns .wms-select-all { display:flex; align-items:center; gap:7px; font-size:12px; color:var(--text-2); }\n.wms-returns .wms-count { color:var(--text-3); font-size:11.5px; }\n.wms-returns .wms-action-bar .btn.primary { margin-left:auto; }\n.wms-returns .wms-status { min-height:18px; color:var(--text-3); font-size:11.5px; }\n.wms-returns .wms-status.ok { color:var(--success); }\n.wms-returns .wms-status.warn { color:var(--warning); }\n.wms-returns .wms-status.err { color:var(--danger); }\n.wms-returns .wms-table-wrap { max-height:620px; overflow:auto; }\n.wms-returns .wms-table { min-width:1640px; width:100%; border-collapse:collapse; font-size:11.5px; }\n.wms-returns .wms-table th {\n  position:sticky;\n  top:0;\n  z-index:1;\n  padding:10px 9px;\n  color:var(--text-3);\n  background:var(--surface-soft);\n  border-bottom:1px solid var(--line);\n  text-align:left;\n  white-space:nowrap;\n  font-size:10.5px;\n  font-weight:700;\n}\n.wms-returns .wms-table td {\n  padding:9px;\n  color:var(--text-2);\n  border-bottom:1px solid var(--line-soft);\n  vertical-align:top;\n  line-height:1.45;\n}\n.wms-returns .wms-table tbody tr:hover td { background:var(--surface-soft); }\n.wms-returns .wms-table .wms-check-cell { width:34px; text-align:center; }\n.wms-returns .wms-table .wms-mono { color:var(--text); font-family:Consolas,\"SFMono-Regular\",monospace; }\n.wms-returns .wms-table .wms-nowrap { white-space:nowrap; }\n.wms-returns .wms-table .wms-sku { max-width:220px; word-break:break-word; color:var(--text); }\n.wms-returns .wms-table .wms-status-pill {\n  display:inline-flex;\n  padding:3px 7px;\n  border-radius:999px;\n  color:var(--accent);\n  background:var(--accent-soft);\n  white-space:nowrap;\n}\n.wms-returns .wms-table .wms-status-pill.wms-status-done { color:var(--success); background:var(--success-soft); }\n.wms-returns .wms-table .wms-status-pill.wms-status-blocked { color:var(--text-3); background:var(--surface-soft); }\n.wms-returns .wms-empty { padding:44px 18px; text-align:center; color:var(--text-3); }\n/* v26.32 腾讯文档退件只读页 */\n.tencent-returns {\n  width:min(100%,1660px);\n  max-width:none;\n  margin:0 auto;\n  padding:28px 26px 48px;\n}\n.tencent-returns .tr-header {\n  display:flex;\n  align-items:flex-start;\n  justify-content:space-between;\n  gap:16px;\n  margin-bottom:18px;\n}\n.tencent-returns .tr-header h2 { margin:0 0 6px; }\n.tencent-returns .tr-sub { color:var(--text-3); line-height:1.65; font-size:12px; }\n.tencent-returns .tr-sync-note {\n  flex:0 0 auto;\n  max-width:420px;\n  padding:9px 12px;\n  color:var(--text-2);\n  background:var(--surface-soft);\n  border:1px solid var(--line);\n  border-radius:10px;\n  font-size:11.5px;\n  line-height:1.5;\n}\n.tencent-returns .tr-filter-panel,\n.tencent-returns .tr-table-panel {\n  background:var(--surface);\n  border:1px solid var(--line);\n  border-radius:var(--radius-panel);\n  box-shadow:var(--shadow-xs);\n}\n.tencent-returns .tr-filter-panel { padding:15px 16px 12px; margin-bottom:14px; }\n.tencent-returns .tr-filter-row {\n  display:flex;\n  align-items:flex-end;\n  gap:10px;\n  flex-wrap:wrap;\n}\n.tencent-returns .tr-field { min-width:220px; flex:0 0 220px; }\n.tencent-returns .tr-field.tr-field-search { flex:1 1 320px; min-width:260px; }\n.tencent-returns .tr-field label {\n  display:block;\n  margin:0 0 5px;\n  color:var(--text-3);\n  font-size:11px;\n  font-weight:650;\n}\n.tencent-returns .tr-control {\n  width:100%;\n  min-height:36px;\n  padding:8px 10px;\n  color:var(--text);\n  background:var(--surface-soft);\n  border:1px solid var(--line);\n  border-radius:var(--radius-control);\n  outline:0;\n  font-size:12px;\n}\n.tencent-returns .tr-control:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--focus); }\n.tencent-returns .tr-filter-hint { margin-top:10px; color:var(--text-3); font-size:11px; line-height:1.55; }\n.tencent-returns .tr-action-bar {\n  display:flex;\n  align-items:center;\n  gap:12px;\n  flex-wrap:wrap;\n  padding:13px 16px;\n  border-bottom:1px solid var(--line);\n}\n.tencent-returns .tr-count { color:var(--text-3); font-size:11.5px; }\n.tencent-returns .tr-status { min-height:18px; color:var(--text-3); font-size:11.5px; }\n.tencent-returns .tr-status.ok { color:var(--success); }\n.tencent-returns .tr-status.warn { color:var(--warning); }\n.tencent-returns .tr-status.err { color:var(--danger); }\n.tencent-returns .tr-table-wrap { max-height:620px; overflow:auto; }\n.tencent-returns .tr-table { min-width:1180px; width:100%; border-collapse:collapse; font-size:11.5px; }\n.tencent-returns .tr-table th {\n  position:sticky;\n  top:0;\n  z-index:1;\n  padding:10px 9px;\n  color:var(--text-3);\n  background:var(--surface-soft);\n  border-bottom:1px solid var(--line);\n  text-align:left;\n  white-space:nowrap;\n  font-size:10.5px;\n  font-weight:700;\n}\n.tencent-returns .tr-table td {\n  padding:9px;\n  color:var(--text-2);\n  border-bottom:1px solid var(--line-soft);\n  vertical-align:top;\n  line-height:1.45;\n}\n.tencent-returns .tr-table tbody tr:hover td { background:var(--surface-soft); }\n.tencent-returns .tr-mono { color:var(--text); font-family:Consolas,\"SFMono-Regular\",monospace; white-space:nowrap; }\n.tencent-returns .tr-sku { max-width:220px; word-break:break-word; color:var(--text); }\n.tencent-returns .tr-product { min-width:220px; max-width:320px; word-break:break-word; color:var(--text); }\n.tencent-returns .tr-qty,\n.tencent-returns .tr-deadline { white-space:nowrap; }\n.tencent-returns .tr-shop-unassigned {\n  display:inline-block;\n  padding:1px 7px;\n  border-radius:8px;\n  color:var(--warning);\n  background:var(--warning-soft);\n  font-size:11px;\n  white-space:nowrap;\n}\n.tencent-returns .tr-problem {\n  display:block;\n  max-width:360px;\n  overflow:hidden;\n  text-overflow:ellipsis;\n  white-space:nowrap;\n  color:var(--text);\n}\n.tencent-returns .tr-empty { padding:44px 18px; text-align:center; color:var(--text-3); }\n/* v26.53 发货超时警告 */\n.shipping-overdue {\n  width:min(100%,1660px);\n  max-width:none;\n  margin:0 auto;\n  padding:28px 26px 48px;\n}\n.shipping-overdue .so-header {\n  display:flex;\n  align-items:flex-start;\n  justify-content:space-between;\n  gap:16px;\n  margin-bottom:16px;\n}\n.shipping-overdue .so-header h2 { margin:0 0 6px; }\n.shipping-overdue .so-sub { max-width:900px; color:var(--text-3); font-size:12px; line-height:1.65; }\n.shipping-overdue .so-stats { display:flex; gap:12px; flex-wrap:wrap; margin-bottom:14px; }\n.shipping-overdue .so-stat {\n  display:flex;\n  flex-direction:column;\n  gap:7px;\n  min-width:150px;\n  flex:0 0 150px;\n  padding:12px 16px;\n  background:var(--surface);\n  border:1px solid var(--line);\n  border-radius:var(--radius-panel);\n  box-shadow:var(--shadow-xs);\n}\n.shipping-overdue .so-stat small { color:var(--text-3); font-size:11px; font-weight:650; }\n.shipping-overdue .so-stat b { color:var(--text); font-size:26px; line-height:1; font-variant-numeric:tabular-nums; }\n.shipping-overdue .so-stat.is-overdue b { color:var(--danger); }\n.shipping-overdue .so-stat.is-soon b { color:var(--warning); }\n/* v26.82：仓库分布三张卡。数值直接复用标签主色，等于顺带把「哪种颜色=哪一类」讲清楚。 */\n.shipping-overdue .so-stat.is-overseas b { color:var(--so-wh-overseas); }\n.shipping-overdue .so-stat.is-domestic b { color:var(--so-wh-domestic); }\n.shipping-overdue .so-stat.is-unknown b { color:var(--so-wh-unknown); }\n.shipping-overdue .so-filter-panel {\n  padding:15px 16px 12px;\n  margin-bottom:16px;\n  background:var(--surface);\n  border:1px solid var(--line);\n  border-radius:var(--radius-panel);\n  box-shadow:var(--shadow-xs);\n}\n.shipping-overdue .so-filter-row { display:flex; align-items:flex-end; gap:10px; flex-wrap:wrap; }\n.shipping-overdue .so-field { min-width:220px; flex:0 0 220px; }\n.shipping-overdue .so-field label {\n  display:block;\n  margin:0 0 5px;\n  color:var(--text-3);\n  font-size:11px;\n  font-weight:650;\n}\n.shipping-overdue .so-control {\n  width:100%;\n  min-height:36px;\n  padding:8px 10px;\n  color:var(--text);\n  background:var(--surface-soft);\n  border:1px solid var(--line);\n  border-radius:var(--radius-control);\n  outline:0;\n  font-size:12px;\n}\n.shipping-overdue .so-control:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--focus); }\n.shipping-overdue .so-field-actions { display:flex; align-items:center; gap:10px; }\n.shipping-overdue .so-status { flex:1 1 260px; min-height:18px; color:var(--text-3); font-size:11.5px; line-height:1.55; }\n.shipping-overdue .so-status.ok { color:var(--success); }\n.shipping-overdue .so-status.warn { color:var(--warning); }\n.shipping-overdue .so-status.err { color:var(--danger); }\n.shipping-overdue .so-filter-hint { margin-top:10px; color:var(--text-3); font-size:11px; line-height:1.55; }\n/* v26.82：待归类仓库清单。只在真的存在白名单外的仓库时出现 —— 它是一条**待办**，\n   而不是一段常规说明，所以用琥珀（=「待处理」）而不是中性灰。 */\n.shipping-overdue .so-unclassified {\n  margin-top:10px;\n  padding:9px 11px;\n  color:var(--text-2);\n  background:var(--so-wh-missing-soft);\n  border:1px solid var(--so-wh-missing-line);\n  border-radius:var(--radius-control);\n  font-size:11px;\n  line-height:1.65;\n}\n.shipping-overdue .so-unclassified b { color:var(--so-wh-missing); }\n.shipping-overdue .so-unclassified code {\n  font-family:Consolas,\"SFMono-Regular\",monospace;\n  word-break:break-all;\n}\n.shipping-overdue .so-group { margin-bottom:18px; }\n.shipping-overdue .so-group-head { display:flex; align-items:center; gap:10px; margin-bottom:9px; }\n.shipping-overdue .so-group-title { padding:3px 11px; border-radius:9px; font-size:12px; font-weight:700; }\n.shipping-overdue .so-group-title.is-overdue { color:var(--danger); background:var(--danger-soft); }\n.shipping-overdue .so-group-title.is-soon { color:var(--warning); background:var(--warning-soft); }\n.shipping-overdue .so-group-count { color:var(--text-3); font-size:11.5px; }\n.shipping-overdue .so-table-wrap {\n  max-height:520px;\n  overflow:auto;\n  background:var(--surface);\n  border:1px solid var(--line);\n  border-radius:var(--radius-panel);\n  box-shadow:var(--shadow-xs);\n}\n.shipping-overdue .so-table { width:100%; min-width:1240px; border-collapse:collapse; font-size:11.5px; }\n.shipping-overdue .so-table th {\n  position:sticky;\n  top:0;\n  z-index:1;\n  padding:10px 9px;\n  color:var(--text-3);\n  background:var(--surface-soft);\n  border-bottom:1px solid var(--line);\n  text-align:left;\n  white-space:nowrap;\n  font-size:10.5px;\n  font-weight:700;\n}\n.shipping-overdue .so-table td {\n  padding:9px;\n  color:var(--text-2);\n  border-bottom:1px solid var(--line-soft);\n  vertical-align:top;\n  line-height:1.45;\n}\n.shipping-overdue .so-table tbody tr:hover td { background:var(--surface-soft); }\n.shipping-overdue .so-order { color:var(--text); font-family:Consolas,\"SFMono-Regular\",monospace; white-space:nowrap; }\n/* v26.61：订单号做成可点入口 —— 按钮撑满单元格，字形与原来一致，只重着色与下划线。 */\n.shipping-overdue .so-order-link {\n  padding:0;\n  border:0;\n  background:none;\n  cursor:pointer;\n  font:inherit;\n  font-family:Consolas,\"SFMono-Regular\",monospace;\n  color:var(--accent);\n  text-decoration:underline dotted;\n  text-underline-offset:3px;\n  text-align:left;\n}\n.shipping-overdue .so-order-link:hover { color:var(--accent-hover); text-decoration:underline solid; }\n.shipping-overdue .so-order-link:focus-visible {\n  outline:2px solid var(--accent);\n  outline-offset:2px;\n  border-radius:4px;\n}\n.shipping-overdue .so-time,\n.shipping-overdue .so-amount { white-space:nowrap; font-variant-numeric:tabular-nums; }\n.shipping-overdue .so-sku { max-width:280px; font-family:Consolas,\"SFMono-Regular\",monospace; word-break:break-all; }\n.shipping-overdue .so-state {\n  display:inline-block;\n  padding:1px 7px;\n  border-radius:8px;\n  color:var(--text-3);\n  background:var(--surface-soft);\n  font-size:10.5px;\n  white-space:nowrap;\n}\n.shipping-overdue .so-deadline { white-space:nowrap; font-variant-numeric:tabular-nums; font-weight:650; }\n/* v26.82：仓库列。标签是 10.5px 小字 ⇒ 前景色必须 ≥4.5:1；\n   「未查询」用灰虚线边框区分「ERP 无单」的琥珀实底，两者含义完全不同，不能长得一样。 */\n.shipping-overdue .so-wh { white-space:nowrap; }\n.shipping-overdue .so-wh-chip {\n  display:inline-block;\n  padding:1px 7px;\n  border:1px solid transparent;\n  border-radius:8px;\n  font-size:10.5px;\n  font-weight:650;\n  white-space:nowrap;\n}\n.shipping-overdue .so-wh-chip.is-overseas {\n  color:var(--so-wh-overseas); background:var(--so-wh-overseas-soft); border-color:var(--so-wh-overseas-line);\n}\n.shipping-overdue .so-wh-chip.is-domestic {\n  color:var(--so-wh-domestic); background:var(--so-wh-domestic-soft); border-color:var(--so-wh-domestic-line);\n}\n.shipping-overdue .so-wh-chip.is-unknown {\n  color:var(--so-wh-unknown); background:var(--so-wh-unknown-soft); border-color:var(--so-wh-unknown-line);\n}\n.shipping-overdue .so-wh-chip.is-missing {\n  color:var(--so-wh-missing); background:var(--so-wh-missing-soft); border-color:var(--so-wh-missing-line);\n}\n.shipping-overdue .so-wh-chip.is-unchecked {\n  color:var(--so-wh-unknown); background:transparent; border-style:dashed; border-color:var(--so-wh-unknown-line);\n}\n.shipping-overdue .so-wh-name {\n  display:block;\n  margin-top:3px;\n  max-width:190px;\n  overflow:hidden;\n  /* 用 --text-2 而不是 --text-3：仓库名是 10.5px 小字，--text-3 在白底上只有约 3.2:1，\n     达不到 4.5:1；--text-2 约 6.0:1。与 v26.81 定下的对比度硬约束保持一致。 */\n  color:var(--text-2);\n  font-size:10.5px;\n  text-overflow:ellipsis;\n  white-space:nowrap;\n}\n/* v26.97：ERP 操作状态列（v26.97 新增）。\n   取值是 ERP 原文（如「已发货」「待处理」），所以不做徽标化 —— 只有\n   「查询中 / 未查询 / ERP 无单 / 未标注」这四种**不是取值**的占位才弱化显示，\n   一眼能分出「真状态」与「还没拿到」。 */\n.shipping-overdue .so-operate { white-space:nowrap; }\n.shipping-overdue .so-operate-text { display:inline-block; max-width:200px; overflow:hidden; text-overflow:ellipsis; color:var(--text); font-weight:650; }\n/* 占位态用 --text-2 而不是 --text-3：这里是 11.5px 表格字，\n   --text-3 在白底上约 3.2:1 达不到 4.5:1（与 .so-wh-name 同一条对比度硬约束）。 */\n.shipping-overdue .so-operate-text.is-loading,\n.shipping-overdue .so-operate-text.is-blank,\n.shipping-overdue .so-operate-text.is-missing,\n.shipping-overdue .so-operate-text.is-unchecked { color:var(--text-2); font-weight:400; font-style:italic; }\nhtml[data-theme=\"dark\"] .shipping-overdue .so-operate-text.is-loading { color:#9fb4c9; }\n/* 必须带 td：否则被上面的 .so-table td（特异度 0,2,1）盖回 --text-2，亮色下不标红 */\n.shipping-overdue .so-table td.so-deadline-overdue { color:var(--danger); }\n.shipping-overdue .so-table td.so-deadline-soon { color:var(--warning); }\n.shipping-overdue .so-left { white-space:nowrap; font-variant-numeric:tabular-nums; }\n.shipping-overdue .so-table td.so-left.is-overdue { color:var(--danger); font-weight:650; }\n.shipping-overdue .so-table td.so-left.is-soon { color:var(--warning); font-weight:650; }\n.shipping-overdue .so-empty {\n  padding:36px 18px;\n  color:var(--text-3);\n  background:var(--surface);\n  border:1px solid var(--line);\n  border-radius:var(--radius-panel);\n  text-align:center;\n  font-size:12px;\n}\nhtml[data-theme=\"dark\"] .shipping-overdue .so-table td.so-deadline-overdue,\nhtml[data-theme=\"dark\"] .shipping-overdue .so-table td.so-left.is-overdue { color:#ff9090; }\n/* 暗色下 --accent 已换成浅紫，但表格底色偏深，再提亮一档保证可读 */\nhtml[data-theme=\"dark\"] .shipping-overdue .so-order-link { color:#8ecbff; }\nhtml[data-theme=\"dark\"] .shipping-overdue .so-order-link:hover { color:#b6dcff; }\n/* v26.40 双仓退货登记 */\n.nav-item[data-page=\"agent\"][hidden] { display:none !important; }\n.return-registration {\n  width:min(100%,1660px);\n  max-width:none;\n  margin:0 auto;\n  padding:28px 26px 48px;\n}\n.return-registration .rr-header {\n  display:flex;\n  align-items:flex-start;\n  justify-content:space-between;\n  gap:16px;\n  margin-bottom:16px;\n}\n.return-registration .rr-header h2 { margin:0 0 6px; }\n.return-registration .rr-sub { color:var(--text-3); line-height:1.65; font-size:12px; }\n.return-registration .rr-note {\n  flex:0 0 auto;\n  max-width:430px;\n  padding:9px 12px;\n  color:var(--text-2);\n  background:var(--surface-soft);\n  border:1px solid var(--line);\n  border-radius:10px;\n  font-size:11.5px;\n  line-height:1.5;\n}\n.rr-warehouse-tabs {\n  display:flex;\n  gap:5px;\n  padding:4px;\n  margin-bottom:14px;\n  background:var(--surface-soft);\n  border:1px solid var(--line);\n  border-radius:12px;\n}\n.rr-warehouse-tab {\n  min-width:142px;\n  min-height:36px;\n  padding:0 17px;\n  color:var(--text-3);\n  background:transparent;\n  border:0;\n  border-radius:8px;\n  font:inherit;\n  font-size:12px;\n  font-weight:650;\n  cursor:pointer;\n}\n.rr-warehouse-tab:hover { color:var(--text); background:rgba(255,255,255,.46); }\n.rr-warehouse-tab.active { color:var(--accent); background:var(--surface); box-shadow:var(--shadow-xs); }\n.rr-form-panel,\n.rr-table-panel {\n  background:var(--surface);\n  border:1px solid var(--line);\n  border-radius:var(--radius-panel);\n  box-shadow:var(--shadow-xs);\n}\n.rr-form-panel { padding:16px; margin-bottom:14px; }\n.rr-form { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }\n.rr-field { min-width:0; }\n.rr-field.rr-field-wide { grid-column:span 2; }\n.rr-field label { display:block; margin:0 0 5px; color:var(--text-3); font-size:11px; font-weight:650; }\n.rr-control {\n  width:100%;\n  min-height:36px;\n  padding:8px 10px;\n  color:var(--text);\n  background:var(--surface-soft);\n  border:1px solid var(--line);\n  border-radius:var(--radius-control);\n  outline:0;\n  font-size:12px;\n}\n.rr-control:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--focus); }\n.rr-field textarea.rr-control { min-height:36px; resize:vertical; line-height:1.45; }\n.rr-form-actions { display:flex; align-items:center; gap:9px; grid-column:1 / -1; padding-top:2px; }\n.rr-form-hint { color:var(--text-3); font-size:11px; line-height:1.5; }\n.rr-form-actions .btn.primary { min-width:104px; }\n.rr-table-panel { overflow:hidden; }\n.rr-action-bar {\n  display:flex;\n  align-items:center;\n  gap:10px;\n  flex-wrap:wrap;\n  padding:13px 16px;\n  border-bottom:1px solid var(--line);\n}\n.rr-select-all { display:inline-flex; align-items:center; gap:6px; color:var(--text-2); font-size:11.5px; cursor:pointer; }\n.rr-select-all input { width:15px; height:15px; accent-color:var(--accent); }\n.rr-count, .rr-status { color:var(--text-3); font-size:11.5px; }\n.rr-status.ok { color:var(--success); }\n.rr-status.warn { color:var(--warning); }\n.rr-status.err { color:var(--danger); }\n.rr-action-bar .btn { padding:6px 10px; font-size:11.5px; }\n.rr-action-bar .btn:first-of-type { margin-left:auto; }\n.rr-table-wrap { max-height:610px; overflow:auto; }\n.rr-table { min-width:1160px; width:100%; border-collapse:collapse; font-size:11.5px; }\n.rr-table th {\n  position:sticky;\n  top:0;\n  z-index:1;\n  padding:10px 9px;\n  color:var(--text-3);\n  background:var(--surface-soft);\n  border-bottom:1px solid var(--line);\n  text-align:left;\n  white-space:nowrap;\n  font-size:10.5px;\n  font-weight:700;\n}\n.rr-table td { padding:9px; color:var(--text-2); border-bottom:1px solid var(--line-soft); vertical-align:top; line-height:1.45; }\n.rr-table tbody tr:hover td { background:var(--surface-soft); }\n.rr-table .rr-check { width:34px; text-align:center; }\n.rr-table .rr-check input { width:15px; height:15px; accent-color:var(--accent); }\n.rr-mono { color:var(--text); font-family:Consolas,\"SFMono-Regular\",monospace; white-space:nowrap; }\n.rr-note-cell { max-width:230px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:var(--text-2); }\n.rr-meta-cell { color:var(--text-3); white-space:nowrap; }\n.rr-status-pill, .rr-arrival-pill { display:inline-flex; padding:3px 7px; border-radius:999px; white-space:nowrap; font-size:10.5px; font-weight:650; }\n.rr-status-pill.pending { color:var(--accent); background:var(--accent-soft); }\n.rr-status-pill.done { color:var(--success); background:var(--success-soft); }\n.rr-status-pill.no-return { color:var(--warning); background:var(--warning-soft); }\n.rr-arrival-pill.unknown { color:var(--text-3); background:var(--surface-soft); }\n.rr-arrival-pill.arrived { color:var(--success); background:var(--success-soft); }\n.rr-arrival-pill.not-found { color:var(--warning); background:var(--warning-soft); }\n.rr-arrival-pill.error { color:var(--danger); background:var(--danger-soft); }\n.rr-row-actions { display:flex; gap:8px; white-space:nowrap; }\n.rr-row-action { padding:0; color:var(--accent); background:transparent; border:0; cursor:pointer; font-size:11px; }\n.rr-row-action:hover { text-decoration:underline; }\n.rr-empty { padding:44px 18px; color:var(--text-3); text-align:center; }\n.rr-summary { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-top:11px; color:var(--text-3); font-size:11px; }\n.rr-summary b { color:var(--text); font-weight:700; }\n.rr-summary .rr-summary-divider { color:var(--line); }\n@media (max-width:760px) {\n  body[data-ui-version=\"23\"] .operations-page .return-registration { padding:20px 14px 36px; }\n  .return-registration .rr-header { display:block; }\n  .return-registration .rr-note { margin-top:10px; max-width:none; }\n  .rr-warehouse-tab { flex:1 1 50%; min-width:0; padding:0 8px; }\n  .rr-form { grid-template-columns:1fr; }\n  .rr-field.rr-field-wide { grid-column:auto; }\n  .rr-form-actions { align-items:flex-start; flex-wrap:wrap; }\n  .rr-form-actions .btn.primary { margin-left:0; }\n  .rr-action-bar .btn:first-of-type { margin-left:0; }\n}\n/* v26.39 递四方合并模块：退件与订单拦截共用一个左侧入口 */\n.fourpx-hub { overflow-y:auto; }\n.fourpx-module-tabs {\n  width:min(calc(100% - 52px), 1180px);\n  margin:22px auto 0;\n  padding:4px;\n  display:flex;\n  gap:4px;\n  background:var(--surface-soft);\n  border:1px solid var(--line);\n  border-radius:12px;\n}\n.fourpx-module-tab {\n  flex:0 0 auto;\n  min-height:36px;\n  padding:0 16px;\n  color:var(--text-3);\n  background:transparent;\n  border:0;\n  border-radius:8px;\n  font:inherit;\n  font-size:12px;\n  font-weight:650;\n  cursor:pointer;\n}\n.fourpx-module-tab:hover { color:var(--text); background:rgba(255,255,255,.46); }\n.fourpx-module-tab.active {\n  color:var(--accent);\n  background:var(--surface);\n  box-shadow:var(--shadow-xs);\n}\n.fourpx-panel { min-width:0; }\n/* v26.29 递四方订单拦截 */\n.fourpx-shell { max-width:980px; padding:28px 32px 48px; margin:0 auto; }\n.fourpx-header { display:flex; align-items:flex-start; justify-content:space-between; gap:20px; margin-bottom:22px; }\n.fourpx-header h2 { margin:0 0 7px; font-size:22px; line-height:1.3; }\n.fourpx-sub { color:var(--text-3); line-height:1.65; font-size:13px; }\n.fourpx-safety { flex:0 0 auto; max-width:260px; padding:11px 13px; border:1px solid var(--line); border-radius:12px; background:var(--surface-soft); color:var(--text-3); font-size:12px; line-height:1.6; }\n.fourpx-card { padding:22px; border:1px solid var(--line); border-radius:16px; background:var(--surface); box-shadow:var(--shadow-sm); }\n.fourpx-form { display:grid; grid-template-columns:minmax(0,1.35fr) minmax(170px,.65fr); gap:16px 18px; }\n.fourpx-field { display:flex; flex-direction:column; gap:7px; min-width:0; }\n.fourpx-field.full { grid-column:1 / -1; }\n.fourpx-field label { color:var(--text-2); font-weight:650; font-size:12px; }\n.fourpx-field input, .fourpx-field select, .fourpx-field textarea { width:100%; border:1px solid var(--line); border-radius:10px; background:var(--surface-soft); color:var(--text); padding:10px 12px; font-size:13px; outline:none; }\n.fourpx-field textarea { min-height:82px; resize:vertical; line-height:1.55; }\n.fourpx-field input:focus, .fourpx-field select:focus, .fourpx-field textarea:focus { border-color:var(--accent); box-shadow:0 0 0 3px rgba(63,127,232,.12); }\n.fourpx-hint { color:var(--text-3); font-size:11.5px; line-height:1.5; }\n.fourpx-actions { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:18px; }\n.fourpx-actions .btn.primary { min-width:136px; }\n.fourpx-result { margin-top:20px; }\n.fourpx-result:empty { display:none; }\n.fourpx-result-card { border:1px solid var(--line); border-radius:14px; padding:16px 18px; background:var(--surface-soft); }\n.fourpx-result-card.success { border-color:rgba(14,164,114,.38); background:rgba(14,164,114,.08); }\n.fourpx-result-card.failure { border-color:rgba(224,82,82,.38); background:rgba(224,82,82,.07); }\n.fourpx-result-title { display:flex; align-items:center; gap:9px; font-size:15px; font-weight:700; margin-bottom:7px; }\n.fourpx-result-card.success .fourpx-result-title { color:var(--green); }\n.fourpx-result-card.failure .fourpx-result-title { color:var(--red); }\n.fourpx-result-message { color:var(--text-2); font-size:12.5px; line-height:1.6; word-break:break-word; }\n.fourpx-error-list { display:grid; gap:10px; margin-top:14px; }\n.fourpx-error-item { padding:12px 13px; border:1px solid var(--line); border-radius:10px; background:var(--surface); }\n.fourpx-error-head { display:flex; align-items:center; flex-wrap:wrap; gap:8px; margin-bottom:6px; }\n.fourpx-error-code { color:var(--red); font-weight:750; letter-spacing:.2px; }\n.fourpx-error-desc { color:var(--text); font-weight:650; }\n.fourpx-error-meta { color:var(--text-3); font-size:12px; line-height:1.55; word-break:break-word; }\n.fourpx-error-ref { margin-top:5px; color:var(--text-2); font-size:12px; }\n@media (max-width:760px) {\n  body[data-ui-version=\"23\"] .operations-page > .wms-returns { padding:20px 14px 36px; }\n  .wms-returns .wms-header { display:block; }\n  .wms-returns .wms-sync-note { margin-top:10px; max-width:none; }\n  .wms-returns .wms-action-bar .btn.primary { margin-left:0; }\n  body[data-ui-version=\"23\"] .operations-page .tencent-returns { padding:20px 14px 36px; }\n  .tencent-returns .tr-header { display:block; }\n  .tencent-returns .tr-sync-note { margin-top:10px; max-width:none; }\n  .tencent-returns .tr-field,\n  .tencent-returns .tr-field.tr-field-search { min-width:0; flex:1 1 100%; }\n  .tencent-returns .tr-problem { max-width:220px; }\n.fourpx-module-tabs { width:calc(100% - 28px); margin-top:14px; }\n.fourpx-module-tab { flex:1 1 33.33%; padding:0 8px; }\n  .fourpx-shell { padding:20px 14px 36px; }\n  .fourpx-header { display:block; }\n  .fourpx-safety { max-width:none; margin-top:14px; }\n  .fourpx-form { grid-template-columns:1fr; }\n  .fourpx-field.full { grid-column:auto; }\n  .fourpx-actions { align-items:stretch; flex-direction:column; }\n  .fourpx-actions .btn { width:100%; }\n}\n</style>\n<!-- UI_V20_END -->\n</head>\n<body data-ui-version=\"23\" data-ui-design=\"26\">\n<div class=\"app\">\n  <div class=\"topbar\">\n    <div class=\"logo\"><div class=\"logo-mark\">M</div><h1>Mirakl 运营工作台</h1></div>\n    <span class=\"hint\" id=\"globalShopHint\">当前店铺</span>\n    <div style=\"margin-left:auto; display:flex; gap:8px; align-items:center;\">\n      <label style=\"font-size:12px;color:var(--muted);\">当前店铺</label>\n      <select id=\"globalShopSel\" class=\"sel-shop\" title=\"选择后，所有模块只展示该店铺数据\"></select>\n      <button class=\"btn\" id=\"btnTheme\" title=\"切换白天/夜间主题\"><span class=\"icon-svg icon-theme\"></span><span>夜间</span></button>\n      <button class=\"btn\" id=\"btnManageTpl\" title=\"管理回复模板\"><span class=\"icon-svg icon-template\"></span><span>模板</span></button>\n      <button class=\"btn\" id=\"btnSettings\" title=\"应用设置\"><span class=\"icon-svg icon-settings\"></span><span>设置</span></button>\n      <button class=\"btn\" id=\"btnTencentDocs\" title=\"连接腾讯文档\"><span class=\"tencent-docs-mark\" aria-hidden=\"true\">▦</span><span>腾讯文档</span></button>\n      <button class=\"btn primary\" id=\"btnNewThread\"><span class=\"icon-svg icon-compose\"></span><span>新建站内信</span></button>\n      <button class=\"btn\" id=\"btnRefresh\"><span class=\"icon-svg icon-refresh\"></span><span>刷新</span></button>\n      <button class=\"btn\" id=\"btnMarkAll\"><span class=\"icon-svg icon-read\"></span><span>全部已读</span></button>\n      <span class=\"status\" id=\"globalStatus\"></span>\n      <!-- v26.97：后台任务中心 —— 发信 / 改价 / 退款登记等「提交完还要等」的操作，\n           进度与结果都汇总到这里，切到任何页面都照样能看 -->\n      <div class=\"task-center\" id=\"taskCenter\" data-state=\"idle\">\n        <button class=\"task-btn\" id=\"taskBtn\" type=\"button\" aria-haspopup=\"true\" aria-expanded=\"false\" title=\"后台任务（进行中 / 最近结果）\">\n          <span class=\"task-spinner\" aria-hidden=\"true\"></span>\n          <span class=\"task-label\" id=\"taskLabel\">任务</span>\n          <span class=\"task-badge\" id=\"taskBadge\" hidden>0</span>\n        </button>\n        <div class=\"task-panel\" id=\"taskPanel\" hidden>\n          <div class=\"task-panel-head\">\n            <strong>后台任务</strong>\n            <button class=\"task-clear\" id=\"taskClearBtn\" type=\"button\">清空已完成</button>\n          </div>\n          <div class=\"task-list\" id=\"taskList\"><div class=\"task-empty\">暂无任务</div></div>\n        </div>\n      </div>\n    </div>\n  </div>\n  <div class=\"main\">\n    <div class=\"col col-nav\">\n      <div class=\"nav-item active\" data-page=\"dashboard\"><span class=\"ni\"></span>仪表盘</div>\n      <div class=\"nav-item\" data-page=\"inbox\"><span class=\"ni\"></span>站内信</div>\n      <div class=\"nav-item\" data-page=\"refund\"><span class=\"ni\"></span>退款</div>\n      <div class=\"nav-item\" data-page=\"ship\"><span class=\"ni\"></span>发货</div>\n      <div class=\"nav-item\" data-page=\"shipping-overdue\"><span class=\"ni\"></span>发货超时</div>\n      <div class=\"nav-item\" data-page=\"returnlabel\"><span class=\"ni\"></span>退货标签</div>\n      <div class=\"nav-item\" data-page=\"offers\"><span class=\"ni\"></span>报价</div>\n      <div class=\"nav-item\" data-page=\"offer-radar\"><span class=\"ni\"></span>报价雷达</div>\n      <div class=\"nav-item\" data-page=\"offer-offline\"><span class=\"ni\"></span>掉线监控</div>\n      <div class=\"nav-item\" data-page=\"watchlist\"><span class=\"ni\"></span>特别关注</div>\n      <div class=\"nav-item\" data-page=\"wms\"><span class=\"ni\"></span>海外仓退件</div>\n      <div class=\"nav-item\" data-page=\"return-registration\"><span class=\"ni\"></span>退货登记</div>\n      <div class=\"nav-item\" data-page=\"fourpx\"><span class=\"ni\"></span>递四方</div>\n      <div class=\"nav-item\" data-page=\"agent\" hidden><span class=\"ni\"></span>AI 任务</div>\n    </div>\n    <div id=\"pageDashboard\" class=\"page dashboard-v20\"></div>\n    <div id=\"pageShip\" class=\"page hidden operations-page\"></div>\n    <div id=\"pageOffers\" class=\"page hidden operations-page\"></div>\n    <div id=\"pageOfferRadar\" class=\"page hidden operations-page\"></div>\n    <div id=\"pageOfferOffline\" class=\"page hidden operations-page\"></div>\n  <div id=\"pageWatchlist\" class=\"page hidden operations-page\"></div>\n    <div id=\"pageReturnLabel\" class=\"page hidden operations-page\"></div>\n    <div id=\"pageRefund\" class=\"page hidden operations-page\"></div>\n    <div id=\"pageWms\" class=\"page hidden operations-page\"></div>\n    <div id=\"pageReturnRegistration\" class=\"page hidden operations-page\"></div>\n    <div id=\"pageFourPxHub\" class=\"page hidden operations-page fourpx-hub\">\n      <div id=\"fourPxModuleTabs\" class=\"fourpx-module-tabs\" role=\"tablist\" aria-label=\"递四方功能\">\n        <button type=\"button\" class=\"fourpx-module-tab active\" data-fourpx-tab=\"returns\" role=\"tab\" aria-selected=\"true\">递四方退件</button>\n        <button type=\"button\" class=\"fourpx-module-tab\" data-fourpx-tab=\"inner\" role=\"tab\" aria-selected=\"false\">递四方库内异常</button>\n        <button type=\"button\" class=\"fourpx-module-tab\" data-fourpx-tab=\"hold\" role=\"tab\" aria-selected=\"false\">递四方订单拦截</button>\n      </div>\n      <div id=\"pageFourPx\" class=\"fourpx-panel hidden\"></div>\n      <div id=\"pageFourPxReturns\" class=\"fourpx-panel\"></div>\n      <div id=\"pageFourPxInner\" class=\"fourpx-panel hidden\"></div>\n    </div>\n    <div id=\"pageShippingOverdue\" class=\"page hidden operations-page\"></div>\n    <div id=\"pageAgent\" class=\"page hidden operations-page\"></div>\n    <aside class=\"order-detail-drawer hidden\" id=\"orderDetailDrawer\" role=\"dialog\" aria-modal=\"false\" aria-labelledby=\"orderDetailTitle\">\n      <div class=\"order-detail-head\">\n        <div>\n          <div class=\"order-detail-eyebrow\">ORDER SNAPSHOT</div>\n          <h2 id=\"orderDetailTitle\">订单详情</h2>\n          <div class=\"order-detail-context\" id=\"orderDetailContext\">从站内信预加载数据读取</div>\n        </div>\n        <button class=\"order-detail-close\" id=\"btnOrderDetailClose\" type=\"button\" aria-label=\"关闭订单详情\">×</button>\n      </div>\n      <div class=\"order-detail-status\" id=\"orderDetailStatus\"></div>\n      <div class=\"order-detail-body\" id=\"orderDetailBody\"></div>\n    </aside>\n    <div id=\"pageInbox\" class=\"page hidden inbox-v20\" style=\"display:flex; flex:1; min-height:0;\">\n    <div class=\"col col-shops\">\n      <div class=\"panel-title\"><span>店铺</span><span id=\"totalUnread\">0 未读</span></div>\n      <div style=\"flex:1;overflow-y:auto;\" id=\"shopList\"></div>\n    </div>\n    <div class=\"col col-list\">\n      <div class=\"toolbar inbox-commandbar\">\n        <div class=\"inbox-filter-row\">\n          <div class=\"inbox-filter-tabs\">\n            <span class=\"filter-tab\" data-f=\"all\">全部</span>\n            <span class=\"filter-tab active\" data-f=\"need\">待回复</span>\n          </div>\n          <span class=\"all-count\" id=\"listCount\"></span>\n        </div>\n        <div class=\"inbox-search-row\">\n          <span class=\"inbox-shop-tag\" id=\"inboxShopTag\" style=\"display:none;font-size:12px;color:var(--green);margin-left:4px;\"></span>\n          <label class=\"inbox-topic-filter\" title=\"按站内信业务分类筛选\">\n            <span>主题</span>\n            <select id=\"inboxTopicFilter\" aria-label=\"按站内信主题筛选\">\n              <option value=\"\">全部主题</option>\n            </select>\n          </label>\n          <div class=\"inbox-search\" role=\"search\" aria-label=\"按订单号查找站内信\">\n            <input id=\"inboxOrderSearch\" type=\"search\" placeholder=\"按订单号查找\" autocomplete=\"off\">\n            <button id=\"btnInboxOrderSearch\" type=\"button\">查找</button>\n            <button id=\"btnInboxOrderClear\" type=\"button\" title=\"清除订单号筛选\">清除</button>\n          </div>\n        </div>\n      </div>\n      <div class=\"mail-list conversation-list\" id=\"mailList\"><div class=\"empty\">请选择左侧店铺加载站内信</div></div>\n    </div>\n    <div class=\"col col-read\">\n      <div class=\"read-pane\" id=\"readPane\"><div class=\"empty\">选择一封邮件查看详情<br>打开后自动标记为已读</div></div>\n      <div class=\"reply-box composer-v20\" id=\"replyBox\" style=\"display:none;\">\n        <div class=\"reply-resize-handle\" id=\"replyResizeHandle\" role=\"separator\" aria-orientation=\"horizontal\" aria-controls=\"replyText\" aria-label=\"调整回复框高度\" aria-valuemin=\"42\" aria-valuemax=\"360\" aria-valuenow=\"42\" tabindex=\"0\" title=\"上下拖动调整回复框高度\"></div>\n        <textarea id=\"replyText\" placeholder=\"输入回复内容…（至少 3 个字符，最长 50000；语言建议与买家一致）\"></textarea>\n        <div class=\"reply-actions\">\n          <div class=\"reply-tools\">\n            <button class=\"btn attach-btn\" id=\"btnTemplate\"><span class=\"icon-svg icon-template\"></span><span>模板</span></button>\n            <div class=\"tpl-menu\" id=\"tplMenu\" style=\"display:none;\"></div>\n            <span class=\"status\" id=\"tplHint\" style=\"font-size:11px;\"></span>\n            <label class=\"reply-recipient-control\" title=\"选择本次回复的收件人\">\n              <span>发送给</span>\n              <select id=\"replyRecipientMode\" aria-label=\"回复收件人\">\n                <option value=\"customer\" selected>回复客户</option>\n                <option value=\"operator\">仅回复操作员</option>\n                <option value=\"customer_operator\">回复客户并抄送操作员</option>\n              </select>\n            </label>\n            <label style=\"margin-left:auto; display:flex; align-items:center; gap:6px; cursor:pointer; font-size:12px; color:var(--muted); white-space:nowrap;\" title=\"同一条回复内容将同时发送给此订单下的全部待回复站内信\">\n              <input type=\"checkbox\" id=\"replyBatchAll\" checked style=\"width:15px;height:15px;accent-color:var(--accent);\">\n              <span>同时回复此订单全部待回复站内信</span>\n            </label>\n          </div>\n          <div class=\"reply-row\">\n            <span class=\"status\" id=\"replyStatus\"></span>\n            <button class=\"btn attach-btn\" id=\"btnReplyAttach\"><span class=\"icon-svg icon-paperclip\"></span><span>添加附件</span></button>\n            <input type=\"file\" id=\"replyFile\" multiple style=\"display:none;\">\n            <span class=\"status\" id=\"replyFiles\"></span>\n            <button class=\"btn primary\" id=\"btnReply\"><span class=\"icon-svg icon-send\"></span><span>发送回复</span></button>\n          </div>\n          <!-- v26.97：批量回复逐封结果 —— 失败 / 跳过必须看得见，不再只写在鼠标悬停提示里 -->\n          <div class=\"reply-batch-report\" id=\"replyBatchReport\" hidden></div>\n        </div>\n      </div>\n    </div>\n    </div>\n  </div>\n</div>\n\n<!-- 物流轨迹浮窗（v26.63）：递四方渠道自绘中文时间线，其余渠道内嵌 17TRACK 官方查询页 -->\n<div class=\"track-mask hidden\" id=\"trackModal\">\n  <div class=\"track-panel\" role=\"dialog\" aria-modal=\"true\" aria-label=\"物流轨迹\">\n    <div class=\"track-head\">\n      <div>\n        <h3>物流轨迹</h3>\n        <div class=\"track-sub\">\n          <span class=\"num\" id=\"trackNum\">—</span>\n          <span class=\"track-chip\" id=\"trackCarrier\" hidden></span>\n          <span id=\"trackChannel\"></span>\n        </div>\n      </div>\n      <div class=\"track-actions\">\n        <button type=\"button\" class=\"track-btn\" id=\"trackRefresh\">刷新</button>\n        <a class=\"track-btn hidden\" id=\"trackOpen\" target=\"_blank\" rel=\"noopener noreferrer\">17TRACK 打开</a>\n        <button type=\"button\" class=\"track-btn\" id=\"trackClose\">关闭</button>\n      </div>\n    </div>\n    <div class=\"track-body\" id=\"trackBody\"></div>\n  </div>\n</div>\n\n<div class=\"modal-mask hidden\" id=\"newThreadModal\">\n  <div class=\"modal\">\n    <h2>向订单发起站内信（OR43）</h2>\n    <label>店铺</label>\n    <select id=\"ntShop\"><option value=\"\">加载中…</option></select>\n    <label>订单号（完整，如 01125_322626379-A）</label>\n    <input type=\"text\" id=\"ntOrder\" placeholder=\"01125_322626379-A\">\n    <label>收件方</label>\n    <select id=\"ntRecipientMode\">\n      <option value=\"customer\">客户</option>\n      <option value=\"operator\">操作员</option>\n      <option value=\"customer_operator\">客户和操作员</option>\n    </select>\n    <label>主题类型</label>\n    <select id=\"ntTopicType\">\n      <option value=\"FREE_TEXT\">自由文本</option>\n      <option value=\"REASON_CODE\">原因码</option>\n    </select>\n    <label>主题内容</label>\n    <input type=\"text\" id=\"ntTopicValue\" placeholder=\"请输入主题内容\">\n    <div id=\"ntTopicReasonWrap\" class=\"hidden\">\n      <select id=\"ntTopicReason\" disabled>\n        <option value=\"\">请选择订单原因</option>\n      </select>\n    </div>\n    <label>消息正文（至少 3 字符，≤50000）</label>\n    <textarea id=\"ntBody\" placeholder=\"尊敬的客户您好…\"></textarea>\n    <label>附件（可选，≤30MB/条）</label>\n    <div style=\"display:flex; gap:8px; align-items:center;\">\n      <button class=\"btn attach-btn\" id=\"btnNtAttach\"><span class=\"icon-svg icon-paperclip\"></span><span>添加附件</span></button>\n      <input type=\"file\" id=\"ntFile\" multiple style=\"display:none;\">\n      <span class=\"status\" id=\"ntFiles\"></span>\n    </div>\n    <div class=\"m-actions\">\n      <button class=\"btn\" id=\"btnNtCancel\">取消</button>\n      <button class=\"btn btn-filled\" id=\"btnNtSend\" style=\"background:#0F6E56;border-color:#0F6E56;\">发送</button>\n      <span class=\"status\" id=\"ntStatus\"></span>\n    </div>\n  </div>\n</div>\n\n\n<div class=\"modal-mask hidden\" id=\"settingsModal\">\n  <div class=\"modal\">\n    <h2>设置</h2>\n    <div style=\"border-top:1px solid var(--border); padding-top:14px; margin-bottom:14px;\">\n      <label style=\"font-size:12px;color:var(--muted);\">店铺 API 凭证</label>\n      <div style=\"display:flex; gap:8px; align-items:center; margin-top:6px;\">\n        <span style=\"font-size:12.5px;\">共 <b id=\"settingsShopCount\">0</b> 家店铺</span>\n        <button class=\"btn\" id=\"btnOpenApiMgmt\" style=\"margin-left:auto;\">管理 API</button>\n      </div>\n    </div>\n    <div style=\"border-top:1px solid var(--border); padding-top:14px; margin-bottom:14px;\">\n      <label style=\"font-size:12px;color:var(--muted);\">版本与更新</label>\n      <div style=\"display:flex; gap:8px; align-items:center; margin-top:6px;\">\n        <span style=\"font-size:12.5px;\">当前版本 <b id=\"settingsVersionText\">—</b></span>\n        <button class=\"btn\" id=\"btnCheckUpdate\" style=\"margin-left:auto;\">检查更新</button>\n      </div>\n      <div id=\"updateHint\" style=\"font-size:11.5px; color:var(--muted); line-height:1.6; margin-top:6px;\">\n        点「检查更新」即可：工作台自己去更新通道取新版本、校验签名后装上，装好自动刷新。\n        联网不通时会自动回落到本机（扫描下载文件夹，或把「更新包」文件直接拖到窗口上）。\n        更新只替换界面文件，<b>不动任何配置</b>。<br>\n        ⚠️ 若某一版改到了程序主体（服务端），通道会如实标注「需要整包升级」，那一版要换一次 exe；\n        换完之后，只改界面的版本就又能在这里点一下自动更新。\n      </div>\n      <div id=\"updateCandidates\"></div>\n      <div style=\"display:flex; gap:8px; align-items:center; margin-top:8px;\">\n        <button class=\"btn\" id=\"btnPickUpdatePkg\">选择更新包…</button>\n        <button class=\"btn\" id=\"btnRollbackHotfix\">回滚到自带版本</button>\n        <input type=\"file\" id=\"updatePkgInput\" accept=\".json,application/json\" style=\"display:none\">\n      </div>\n      <div class=\"status\" id=\"updateStatus\" style=\"margin-top:6px; min-height:18px;\"></div>\n    </div>\n    <div class=\"m-actions\">\n      <button class=\"btn\" id=\"btnSettingsClose\">关闭</button>\n      <button class=\"btn btn-filled\" id=\"btnSettingsSave\" style=\"background:#185FA5;border-color:#185FA5;\">保存</button>\n      <span class=\"status\" id=\"settingsStatus\"></span>\n    </div>\n  </div>\n</div>\n\n<div class=\"modal-mask hidden\" id=\"tencentDocsModal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"tencentDocsTitle\">\n  <div class=\"modal tencent-docs-modal\" style=\"width:560px;\">\n    <h2 id=\"tencentDocsTitle\">连接腾讯文档</h2>\n    <p style=\"font-size:12px; color:var(--muted); line-height:1.65; margin-bottom:14px;\">\n      没有 HTTPS 回调地址时，直接填写 Client ID、Access Token 和 Open ID 即可连接普通在线表格。Client Secret 和 OAuth 回调地址只在需要网页登录授权时填写，表格写入将在下一步单独配置。\n    </p>\n    <div id=\"tencentDocsConnectionState\" class=\"status\" style=\"margin-bottom:12px; min-height:18px;\"></div>\n    <label for=\"tencentDocsClientId\">Client ID</label>\n    <input type=\"text\" id=\"tencentDocsClientId\" autocomplete=\"off\" placeholder=\"填写腾讯文档开放平台的 Client ID\">\n    <label for=\"tencentDocsAccessToken\">Access Token</label>\n    <input type=\"password\" id=\"tencentDocsAccessToken\" autocomplete=\"off\" placeholder=\"直接连接必填；保存后不会回显\">\n    <label for=\"tencentDocsOpenId\">Open ID</label>\n    <input type=\"text\" id=\"tencentDocsOpenId\" autocomplete=\"off\" placeholder=\"填写开放平台显示的 Open ID\">\n    <label for=\"tencentDocsClientSecret\">Client Secret <span style=\"font-weight:400;color:var(--muted);\">（OAuth 可选）</span></label>\n    <input type=\"password\" id=\"tencentDocsClientSecret\" autocomplete=\"new-password\" placeholder=\"仅 OAuth 换 Token 使用；直接连接可留空\">\n    <label for=\"tencentDocsRedirectUri\">授权回调地址</label>\n    <input type=\"text\" id=\"tencentDocsRedirectUri\" autocomplete=\"off\" placeholder=\"没有 HTTPS 域名时留空\" aria-describedby=\"tencentDocsRedirectHint\">\n    <p id=\"tencentDocsRedirectHint\" style=\"font-size:11px; color:var(--muted); line-height:1.55; margin-top:5px;\">\n      OAuth 回调地址必须是已加入腾讯文档白名单的 HTTPS 地址；没有 HTTPS 域名时不要填写，直接使用上面的 Access Token 和 Open ID。\n    </p>\n    <div class=\"m-actions\">\n      <button class=\"btn\" id=\"btnTencentDocsClose\">关闭</button>\n      <button class=\"btn\" id=\"btnTencentDocsSave\">保存并连接</button>\n      <button class=\"btn btn-filled\" id=\"btnTencentDocsAuthorize\" style=\"background:#0F6E56;border-color:#0F6E56;\">OAuth 授权（需 HTTPS）</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"modal-mask hidden\" id=\"tplModal\">\n  <div class=\"modal\" style=\"width:640px;\">\n    <h2>回复模板管理</h2>\n    <div style=\"display:flex; gap:8px; margin-bottom:10px;\">\n        <button class=\"btn btn-filled\" id=\"btnTplAdd\" style=\"background:#185FA5;border-color:#185FA5;\">＋ 新增模板</button>\n      <button class=\"btn\" id=\"btnTplImport\" title=\"批量导入，格式：标题|内容（|分隔，多模板每行一个）\">批量导入</button>\n      <button class=\"btn\" id=\"btnTplReset\" title=\"恢复内置默认模板\">↺ 恢复默认</button>\n      <span class=\"status\" id=\"tplStatus\"></span>\n    </div>\n    <p style=\"font-size:11px; color:var(--muted); margin-bottom:8px;\">模板中可使用变量：{shop_name} 店铺名 / {leadtime} 发货时效（天）。回复框点“模板”快速调用。</p>\n    <div id=\"tplList\" style=\"max-height:340px; overflow-y:auto;\"></div>\n    <div class=\"m-actions\">\n      <button class=\"btn\" id=\"btnTplClose\">关闭</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"modal-mask hidden\" id=\"tplEditModal\">\n  <div class=\"modal\" style=\"width:620px;\">\n    <h2 id=\"tplEditTitle\">新增模板</h2>\n    <label>模板标题</label>\n    <input type=\"text\" id=\"tplEditName\" placeholder=\"如：退货标签德语版\">\n    <label>模板内容（可含 {shop_name} {leadtime} 变量）</label>\n    <textarea id=\"tplEditBody\" style=\"min-height:180px;\" placeholder=\"Sehr geehrte/r Kund/in,...\"></textarea>\n    <div class=\"m-actions\">\n      <button class=\"btn\" id=\"btnTplEditCancel\">取消</button>\n        <button class=\"btn btn-filled\" id=\"btnTplEditSave\" style=\"background:#185FA5;border-color:#185FA5;\">保存模板</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"modal-mask hidden\" id=\"apiModal\">\n  <div class=\"modal\" style=\"width:700px;\">\n    <h2>API 管理</h2>\n    <p style=\"font-size:12px; color:var(--muted); margin-bottom:10px;\">\n      管理店铺 API 凭证：可新增、删除、重命名，也可单独屏蔽店铺。屏蔽后配置仍保留，但运行时不会加载、不会出现在店铺选择器和全店铺任务中。修改即时生效（无需重启），保存前会自动备份到 <code>shops.config.json.bak</code>。\n    </p>\n    <div style=\"max-height:300px; overflow-y:auto; margin-bottom:14px;\" id=\"apiList\"></div>\n    <div style=\"border-top:1px solid var(--border); padding-top:14px;\">\n      <label style=\"font-size:12px;color:var(--muted);\">新增店铺</label>\n      <div style=\"display:flex; gap:8px; margin-top:6px; flex-wrap:wrap;\">\n        <input type=\"text\" id=\"apiNewName\" placeholder=\"店铺名称\" style=\"flex:1;min-width:130px;\">\n        <input type=\"text\" id=\"apiNewId\" placeholder=\"店铺 ID (shop_id)\" style=\"width:140px;\">\n        <input type=\"text\" id=\"apiNewKey\" placeholder=\"API Key\" style=\"flex:2;min-width:200px;\">\n        <button class=\"btn btn-filled\" id=\"btnApiAdd\" style=\"background:#0F6E56;border-color:#0F6E56;\">＋ 添加</button>\n      </div>\n    </div>\n    <div class=\"m-actions\">\n      <button class=\"btn\" id=\"btnApiCancel\">关闭</button>\n      <button class=\"btn btn-filled\" id=\"btnApiSave\" style=\"background:#185FA5;border-color:#185FA5;\">保存全部</button>\n      <span class=\"status\" id=\"apiStatus\"></span>\n    </div>\n  </div>\n</div>\n\n<div class=\"modal-mask hidden\" id=\"quickRefundModal\" aria-labelledby=\"quickRefundTitle\">\n  <div class=\"modal quick-refund-modal\" role=\"dialog\" aria-modal=\"true\">\n    <div class=\"quick-refund-head\">\n      <div>\n        <div class=\"quick-refund-eyebrow\">INBOX ACTION</div>\n        <h2 id=\"quickRefundTitle\">快捷退款</h2>\n        <div class=\"quick-refund-context\" id=\"qrfContext\">正在读取当前订单…</div>\n      </div>\n      <button class=\"quick-refund-close\" id=\"btnQrfClose\" type=\"button\" aria-label=\"关闭\">×</button>\n    </div>\n    <div class=\"quick-refund-body\">\n      <div class=\"quick-refund-status\" id=\"qrfLookupStatus\">正在查询订单明细…</div>\n      <section class=\"quick-refund-panel hidden\" id=\"qrfOrderPanel\">\n        <div class=\"quick-refund-panel-head\">\n          <div>\n            <div class=\"quick-refund-step\">REFUND REVIEW</div>\n            <h3>订单明细</h3>\n          </div>\n          <div class=\"quick-refund-order-info\" id=\"qrfOrderInfo\"></div>\n        </div>\n        <div class=\"quick-refund-table-wrap\">\n          <table class=\"line-tbl quick-refund-lines\" id=\"qrfLines\"></table>\n        </div>\n        <div class=\"quick-refund-controls\">\n          <label for=\"qrfRatio\">退款比例</label>\n          <select id=\"qrfRatio\" class=\"r-input w120\">\n            <option value=\"100\">全额 100%</option>\n            <option value=\"90\">90%</option>\n            <option value=\"80\">80%</option>\n            <option value=\"70\">70%</option>\n            <option value=\"60\">60%</option>\n            <option value=\"50\">50%</option>\n            <option value=\"40\">40%</option>\n            <option value=\"30\">30%</option>\n            <option value=\"20\">20%</option>\n            <option value=\"10\">10%</option>\n          </select>\n          <span class=\"quick-refund-hint\">按订单行金额自动计算，可再逐行调整</span>\n          <span id=\"qrfTotalHint\" class=\"quick-refund-total\"></span>\n        </div>\n        <div class=\"quick-refund-controls quick-refund-reason-row\">\n          <label for=\"qrfReason\">退款原因</label>\n          <select id=\"qrfReason\" class=\"r-input qrf-reason\"></select>\n          <span class=\"quick-refund-hint\">退款成功后将按店铺国家在后台自动发送成功通知</span>\n        </div>\n        <div id=\"qrfErpHost\"></div>\n      </section>\n      <div class=\"quick-refund-result\" id=\"qrfStatus\" role=\"status\"></div>\n    </div>\n    <div class=\"m-actions quick-refund-actions\">\n      <button class=\"btn\" id=\"btnQrfCancel\" type=\"button\">取消</button>\n      <button class=\"btn btn-filled\" id=\"btnQrfSubmit\" type=\"button\" disabled>确认退款</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"modal-mask hidden\" id=\"incidentCloseModal\" aria-labelledby=\"incidentCloseTitle\">\n  <div class=\"modal incident-close-modal\" role=\"dialog\" aria-modal=\"true\">\n    <div class=\"incident-close-head\">\n      <div>\n        <div class=\"incident-close-eyebrow\">INCIDENT ACTION</div>\n        <h2 id=\"incidentCloseTitle\">关闭事件</h2>\n        <div class=\"incident-close-context\" id=\"incidentCloseContext\">请选择事件订单行和关闭原因</div>\n      </div>\n      <button class=\"incident-close-x\" id=\"btnIncidentCloseX\" type=\"button\" aria-label=\"关闭\">×</button>\n    </div>\n    <div class=\"incident-close-body\">\n      <label for=\"incidentLineSelect\">事件订单行</label>\n      <select id=\"incidentLineSelect\" class=\"r-input\"></select>\n      <label for=\"incidentReasonSelect\">关闭原因</label>\n      <select id=\"incidentReasonSelect\" class=\"r-input\"><option value=\"\">加载关闭原因…</option></select>\n      <label class=\"incident-close-notice\" for=\"incidentNotifyOperator\">\n        <input type=\"checkbox\" id=\"incidentNotifyOperator\" checked>\n        <span>关闭后在该站内信中通知平台管理员<span class=\"incident-close-notice-lang\" id=\"incidentNotifyLang\"></span></span>\n      </label>\n      <div class=\"incident-close-status\" id=\"incidentCloseStatus\" role=\"status\"></div>\n    </div>\n    <div class=\"m-actions incident-close-actions\">\n      <button class=\"btn\" id=\"btnIncidentCloseCancel\" type=\"button\">取消</button>\n      <button class=\"btn btn-filled\" id=\"btnIncidentCloseConfirm\" type=\"button\" disabled>确定关闭</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"modal-mask hidden\" id=\"returnRegModal\" aria-labelledby=\"returnRegTitle\">\n  <div class=\"modal return-reg-modal\" role=\"dialog\" aria-modal=\"true\">\n    <div class=\"return-reg-head\">\n      <div>\n        <div class=\"return-reg-eyebrow\">RETURN REGISTRATION</div>\n        <h2 id=\"returnRegTitle\">登记到「退货登记」</h2>\n        <div class=\"return-reg-context\" id=\"returnRegContext\">退货标签已经发给买家。要把这一单登记到「退货登记」吗？</div>\n      </div>\n      <button class=\"return-reg-x\" id=\"btnReturnRegX\" type=\"button\" aria-label=\"关闭\">×</button>\n    </div>\n    <div class=\"return-reg-body\">\n      <dl class=\"return-reg-facts\">\n        <div><dt>仓库</dt><dd id=\"returnRegWarehouse\">DGSC12</dd></div>\n        <div><dt>订单号</dt><dd id=\"returnRegOrderNo\">-</dd></div>\n        <div><dt>物流号</dt><dd id=\"returnRegTrackingNo\">-</dd></div>\n      </dl>\n      <div class=\"return-reg-warn hidden\" id=\"returnRegNoTracking\">ERP 没返回回邮单号 —— 物流号先留空，可事后在「退货登记」里补（WMS 到仓匹配就靠这个号）。</div>\n      <div class=\"return-reg-meta hidden\" id=\"returnRegMeta\"></div>\n      <label for=\"returnRegSku\">SKU<span class=\"return-reg-opt\">（已按订单自动带出，可改）</span></label>\n      <input type=\"text\" id=\"returnRegSku\" maxlength=\"200\" placeholder=\"订单里取不到就手填；多件商品用「, 」分隔\">\n      <label for=\"returnRegNote\">备注<span class=\"return-reg-opt\">（可选，默认留空）</span></label>\n      <textarea id=\"returnRegNote\" maxlength=\"200\" rows=\"3\" placeholder=\"例：买家要求改寄自提点 / 面单破损需重打 / 已与客户约定补寄\"></textarea>\n      <div class=\"return-reg-hint\" id=\"returnRegHint\">点「确定」＝登记；点「取消」＝不登记。上面的 SKU 和备注会原样写进登记记录（备注留空就是没有备注）。</div>\n    </div>\n    <div class=\"m-actions return-reg-actions\">\n      <button class=\"btn\" id=\"btnReturnRegCancel\" type=\"button\">取消</button>\n      <button class=\"btn btn-filled\" id=\"btnReturnRegConfirm\" type=\"button\">确定登记</button>\n    </div>\n  </div>\n</div>\n\n<script>\nconst $ = (id) => document.getElementById(id);\nlet SHOPS = [];\nlet ALL_THREADS = [];      // 所有店铺线程缓存\nlet CURRENT_THREAD = null; // 当前打开的线程\nlet INBOX_SELECTED_RENDERED_TID = null; // 避免后台刷新重复播放选中高亮\nlet FILTER = \"need\";\nlet INBOX_ORDER_QUERY = \"\"; // 站内信按订单号筛选（基于已拉取的线程摘要）\nlet INBOX_TOPIC_FILTER = \"\"; // 站内信按归类后的业务主题筛选\nlet INBOX_TOPIC_CATALOG = [];\nlet INBOX_TOPIC_REQUEST_SEQ = 0;\nlet ACTIVE_SHOP = \"\";\nlet INBOX_LOADED_SHOP = null; // 已加载站内信数据的店铺（避免重复拉取）\n// 站内信预加载缓存：每个店铺一份，线程摘要和订单详情由同一份 bundle 提供。\nlet INBOX_PRELOAD_CACHE = new Map();\nlet INBOX_ORDER_MAP = new Map();\nlet INBOX_ORDER_REQUESTS = new Map();\nlet INBOX_ORDER_CONTROLLERS = new Map();\nlet INBOX_ORDER_FALLBACK_KEYS = new Set();\nlet ORDER_DETAIL_REQUEST_SEQ = 0;\nlet INBOX_SEARCH_REQUEST_SEQ = 0;\nlet INBOX_SEARCH_CONTROLLER = null;\nlet INCIDENT_CLOSE_CONTEXT = null;\nlet INCIDENT_CLOSE_REQUEST = 0;\nconst INBOX_PRELOAD_TTL = 60 * 60 * 1000;\n// v26.97：与服务端一致 —— 历史不再屏蔽（老对话照常进列表 / 搜索 / 订单缓存），\n// 「2026-09-01 提示线」只由服务端返回的 unread / needReply 标记体现，前端不再按日期过滤。\nlet INBOX_PRELOAD_TIMER_STARTED = false;\nlet SETTINGS = { theme: \"light\" }; // 应用设置缓存\n\n// ---- 主题切换（白天/夜间）----\nfunction applyTheme(theme) {\n  const isLight = theme === \"light\";\n  document.documentElement.dataset.theme = isLight ? \"light\" : \"dark\";\n  $(\"btnTheme\").innerHTML = `<span class=\"icon-svg ${isLight ? \"icon-sun\" : \"icon-moon\"}\"></span><span>${isLight ? \"白天\" : \"夜间\"}</span>`;\n  $(\"btnTheme\").title = isLight ? \"当前为白天主题，点击切换夜间\" : \"当前为夜间主题，点击切换白天\";\n}\nasync function saveTheme(theme) {\n  SETTINGS.theme = theme;\n  try {\n    await api(\"/api/settings\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ settings: SETTINGS }),\n    });\n  } catch (e) {}\n}\n\nasync function api(path, opts = {}) {\n  const res = await fetch(path, opts);\n  const data = await res.json().catch(() => ({}));\n  if (!res.ok) {\n    const error = new Error(data.error || (\"HTTP \" + res.status));\n    // v26.97：把状态码与响应体挂到 error 上 —— 批量回复要靠 body.skipped 区分「已跳过」与「失败」。\n    error.status = res.status;\n    error.body = data;\n    throw error;\n  }\n  return data;\n}\n\nfunction fmtTime(iso) {\n  if (!iso) return \"\";\n  const d = new Date(iso);\n  const now = new Date();\n  const sameDay = d.toDateString() === now.toDateString();\n  const pad = (n) => String(n).padStart(2, \"0\");\n  if (sameDay) return `${pad(d.getHours())}:${pad(d.getMinutes())}`;\n  const y = d.getFullYear() === now.getFullYear() ? \"\" : d.getFullYear() + \"-\";\n  return `${y}${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;\n}\n\nconst REPLY_COMPOSER_MIN_HEIGHT = 42;\nconst REPLY_COMPOSER_MAX_HEIGHT = 360;\nconst REPLY_COMPOSER_STEP = 12;\n\nfunction clampReplyComposerHeight(value, min = REPLY_COMPOSER_MIN_HEIGHT, max = REPLY_COMPOSER_MAX_HEIGHT) {\n  const lower = Number.isFinite(Number(min)) ? Math.max(0, Number(min)) : REPLY_COMPOSER_MIN_HEIGHT;\n  const upper = Number.isFinite(Number(max)) ? Math.max(lower, Number(max)) : REPLY_COMPOSER_MAX_HEIGHT;\n  const numeric = Number(value);\n  const candidate = Number.isFinite(numeric) ? numeric : lower;\n  return Math.round(Math.min(upper, Math.max(lower, candidate)));\n}\n\nfunction replyComposerViewportMaxHeight() {\n  const viewport = Number(window.innerHeight);\n  if (!Number.isFinite(viewport) || viewport <= 0) return REPLY_COMPOSER_MAX_HEIGHT;\n  return Math.max(REPLY_COMPOSER_MIN_HEIGHT, Math.min(REPLY_COMPOSER_MAX_HEIGHT, Math.floor(viewport * 0.46)));\n}\n\nfunction initReplyComposerResizer() {\n  const handle = $(\"replyResizeHandle\");\n  const textarea = $(\"replyText\");\n  if (!handle || !textarea || handle.dataset.replyResizerReady === \"true\") return;\n  handle.dataset.replyResizerReady = \"true\";\n  let drag = null;\n\n  const bounds = () => ({\n    min: REPLY_COMPOSER_MIN_HEIGHT,\n    max: replyComposerViewportMaxHeight(),\n  });\n  const currentHeight = () => {\n    const inlineHeight = Number.parseFloat(textarea.style.height);\n    if (Number.isFinite(inlineHeight) && inlineHeight > 0) return inlineHeight;\n    const rect = textarea.getBoundingClientRect();\n    return Number(rect && rect.height) > 0 ? rect.height : REPLY_COMPOSER_MIN_HEIGHT;\n  };\n  const setHeight = (value) => {\n    const { min, max } = bounds();\n    const height = clampReplyComposerHeight(value, min, max);\n    textarea.style.height = `${height}px`;\n    textarea.style.maxHeight = `${max}px`;\n    handle.setAttribute(\"aria-valuemin\", String(min));\n    handle.setAttribute(\"aria-valuemax\", String(max));\n    handle.setAttribute(\"aria-valuenow\", String(height));\n    return height;\n  };\n  const finishDrag = (event) => {\n    if (!drag) return;\n    if (event && drag.pointerId !== undefined && event.pointerId !== undefined && event.pointerId !== drag.pointerId) return;\n    if (handle.releasePointerCapture && drag.pointerId !== undefined) {\n      try {\n        if (!handle.hasPointerCapture || handle.hasPointerCapture(drag.pointerId)) handle.releasePointerCapture(drag.pointerId);\n      } catch (e) {}\n    }\n    drag = null;\n    handle.classList.remove(\"is-dragging\");\n    document.body.classList.remove(\"reply-resizing\");\n  };\n\n  handle.addEventListener(\"pointerdown\", (event) => {\n    if (event.button !== undefined && event.button !== 0) return;\n    drag = {\n      pointerId: event.pointerId,\n      startY: Number(event.clientY) || 0,\n      startHeight: currentHeight(),\n    };\n    handle.classList.add(\"is-dragging\");\n    if (handle.setPointerCapture && event.pointerId !== undefined) {\n      try { handle.setPointerCapture(event.pointerId); } catch (e) {}\n    }\n    document.body.classList.add(\"reply-resizing\");\n    event.preventDefault();\n  });\n  handle.addEventListener(\"pointermove\", (event) => {\n    if (!drag || (drag.pointerId !== undefined && event.pointerId !== undefined && drag.pointerId !== event.pointerId)) return;\n    setHeight(drag.startHeight + drag.startY - (Number(event.clientY) || 0));\n    event.preventDefault();\n  });\n  handle.addEventListener(\"pointerup\", finishDrag);\n  handle.addEventListener(\"pointercancel\", finishDrag);\n  handle.addEventListener(\"lostpointercapture\", finishDrag);\n  handle.addEventListener(\"keydown\", (event) => {\n    const { min, max } = bounds();\n    const current = currentHeight();\n    let next = null;\n    if (event.key === \"ArrowUp\" || event.key === \"PageUp\") next = current + (event.key === \"PageUp\" ? REPLY_COMPOSER_STEP * 3 : REPLY_COMPOSER_STEP);\n    if (event.key === \"ArrowDown\" || event.key === \"PageDown\") next = current - (event.key === \"PageDown\" ? REPLY_COMPOSER_STEP * 3 : REPLY_COMPOSER_STEP);\n    if (event.key === \"Home\") next = min;\n    if (event.key === \"End\") next = max;\n    if (next === null) return;\n    setHeight(next);\n    event.preventDefault();\n  });\n  window.addEventListener(\"resize\", () => {\n    if (!drag && textarea.style.height) setHeight(currentHeight());\n  });\n  setHeight(currentHeight());\n}\n\nfunction senderLabel(t) {\n  const type = t.last_sender_type;\n  if (type === \"SHOP_USER\") return \"店铺（我方）\";\n  if (type === \"OPERATOR_USER\") return \"平台方\";\n  if (type === \"CUSTOMER_USER\") return t.last_sender_name || \"买家\";\n  return t.last_sender_name || type || \"?\";\n}\n\nasync function init() {\n  const d = await api(\"/api/shops\");\n  SHOPS = d.shops;\n  $(\"shopList\").innerHTML = SHOPS.map((s) => `\n    <div class=\"shop-item\" data-shop=\"${s.shop_id}\">\n      <span class=\"name\">${s.name}</span>\n      <span class=\"cnt zero\" id=\"cnt-${s.shop_id}\">0</span>\n    </div>`).join(\"\");\n  document.querySelectorAll(\".col-shops .shop-item\").forEach((el) => {\n    el.addEventListener(\"click\", () => {\n      // 站内信侧栏选店铺 → 同步为全局当前店铺（整个应用只针对该店）\n      setGlobalShop(el.dataset.shop);\n    });\n  });\n  document.querySelectorAll(\".filter-tab\").forEach((el) => {\n    el.addEventListener(\"click\", () => {\n      document.querySelectorAll(\".filter-tab\").forEach((x) => x.classList.remove(\"active\"));\n      el.classList.add(\"active\");\n      FILTER = el.dataset.f;\n      renderMailList();\n    });\n  });\n  const applyInboxOrderSearch = async () => {\n    INBOX_ORDER_QUERY = String($(\"inboxOrderSearch\").value || \"\").trim();\n    renderMailList();\n    if (!INBOX_ORDER_QUERY) return;\n    const query = INBOX_ORDER_QUERY.toLowerCase();\n    const localMatch = ALL_THREADS.some((thread) => String(thread.order_id || thread.entity_id || \"\").toLowerCase().includes(query));\n    if (localMatch) return;\n    const sid = String(GLOBAL_SHOP || \"\").trim();\n    if (!sid) return;\n    const request = ++INBOX_SEARCH_REQUEST_SEQ;\n    if (INBOX_SEARCH_CONTROLLER) INBOX_SEARCH_CONTROLLER.abort();\n    const controller = new AbortController();\n    INBOX_SEARCH_CONTROLLER = controller;\n    const status = $(\"globalStatus\");\n    if (status) { status.textContent = \"正在按订单号查找历史站内信…\"; status.className = \"status\"; }\n    try {\n      const data = await api(`/api/inbox/search?shop_id=${encodeURIComponent(sid)}&order_id=${encodeURIComponent(INBOX_ORDER_QUERY)}`, { signal: controller.signal });\n      if (request !== INBOX_SEARCH_REQUEST_SEQ || String(GLOBAL_SHOP) !== sid) return;\n      mergeInboxSearchResult(sid, data);\n      renderMailList();\n      if (status) {\n        const count = Array.isArray(data.threads) ? data.threads.length : 0;\n        status.textContent = count ? `找到 ${count} 封匹配订单的站内信` : \"没有找到匹配的站内信\";\n        status.className = count ? \"status ok\" : \"status warn\";\n      }\n    } catch (error) {\n      if (request !== INBOX_SEARCH_REQUEST_SEQ) return;\n      if (status) { status.textContent = `订单号查找失败：${error.message}`; status.className = \"status err\"; }\n    } finally {\n      if (INBOX_SEARCH_CONTROLLER === controller) INBOX_SEARCH_CONTROLLER = null;\n    }\n  };\n  $(\"btnInboxOrderSearch\").addEventListener(\"click\", applyInboxOrderSearch);\n  $(\"btnInboxOrderClear\").addEventListener(\"click\", () => {\n    INBOX_SEARCH_REQUEST_SEQ += 1;\n    if (INBOX_SEARCH_CONTROLLER) INBOX_SEARCH_CONTROLLER.abort();\n    $(\"inboxOrderSearch\").value = \"\";\n    INBOX_ORDER_QUERY = \"\";\n    renderMailList();\n  });\n  $(\"inboxTopicFilter\").addEventListener(\"change\", () => {\n    INBOX_TOPIC_FILTER = String($(\"inboxTopicFilter\").value || \"\");\n    renderMailList();\n  });\n  $(\"inboxOrderSearch\").addEventListener(\"keydown\", (event) => {\n    if (event.key === \"Enter\") applyInboxOrderSearch();\n  });\n  $(\"btnRefresh\").addEventListener(\"click\", refreshCurrent);\n  $(\"btnMarkAll\").addEventListener(\"click\", markAllRead);\n  $(\"btnReply\").addEventListener(\"click\", sendReply);\n  $(\"replyRecipientMode\").addEventListener(\"change\", syncReplyRecipientMode);\n  initReplyComposerResizer();\n  try {\n    const s = await api(\"/api/settings\");\n    SETTINGS = s.settings || SETTINGS;\n  } catch (e) {}\n  applyTheme(SETTINGS.theme || \"light\");\n  $(\"btnTheme\").addEventListener(\"click\", () => {\n    const next = SETTINGS.theme === \"light\" ? \"dark\" : \"light\";\n    applyTheme(next);\n    saveTheme(next);\n  });\n  // 恢复上次选择的店铺；首次启动或旧的全店记录默认第一个店铺\n  let savedShop = String(SETTINGS.global_shop_id || \"\");\n  const savedValid = savedShop && SHOPS.some((s) => String(s.shop_id) === String(savedShop));\n  if (!savedValid && SHOPS.length > 0) {\n    savedShop = String(SHOPS[0].shop_id); // 首次启动或旧设置无效 → 默认第一个店铺\n    SETTINGS.global_shop_id = savedShop;\n    try {\n      await api(\"/api/settings\", { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify({ settings: SETTINGS }) });\n    } catch (e) {}\n  }\n  GLOBAL_SHOP = savedShop;\n  ACTIVE_SHOP = savedShop;\n  renderGlobalShopSel();\n  updateShopPaneVisibility();\n  loadInboxTopicCatalog(GLOBAL_SHOP);\n  $(\"globalShopSel\").addEventListener(\"change\", () => setGlobalShop($(\"globalShopSel\").value));\n  document.querySelectorAll(\".nav-item\").forEach((n) => {\n    n.addEventListener(\"click\", () => switchPage(n.dataset.page));\n  });\n  document.querySelectorAll(\"[data-fourpx-tab]\").forEach((tab) => {\n    tab.addEventListener(\"click\", () => setFourPxTab(tab.dataset.fourpxTab));\n  });\n  applyFeatureVisibility();\n  updateShopPaneVisibility();\n  await loadTemplates();\n  if (new URLSearchParams(window.location.search).get(\"tencent_docs\") === \"connected\") {\n    const status = $(\"globalStatus\");\n    if (status) {\n      status.innerHTML = '<span class=\"icon-svg icon-check\"></span>腾讯文档已连接';\n      status.className = \"status ok\";\n    }\n    window.history.replaceState({}, document.title, window.location.pathname);\n  }\n  $(\"btnOrderDetailClose\").addEventListener(\"click\", closeOrderDetail);\n  $(\"btnIncidentCloseCancel\").addEventListener(\"click\", closeIncidentCloseDialog);\n  $(\"btnIncidentCloseX\").addEventListener(\"click\", closeIncidentCloseDialog);\n  $(\"btnIncidentCloseConfirm\").addEventListener(\"click\", submitIncidentClose);\n  $(\"incidentLineSelect\").addEventListener(\"change\", syncIncidentCloseControls);\n  $(\"incidentReasonSelect\").addEventListener(\"change\", syncIncidentCloseControls);\n  $(\"incidentCloseModal\").addEventListener(\"click\", (event) => {\n    if (event.target === event.currentTarget) closeIncidentCloseDialog();\n  });\n  // 仪表盘先正常显示，同时在后台预加载当前店铺的站内信与订单详情。\n  switchPage(\"dashboard\");\n  startInboxPreloadTimer();\n  preloadInbox(GLOBAL_SHOP).catch((e) => console.warn(\"站内信预加载失败\", e.message));\n}\n\nfunction inboxCacheEntry(shopId) {\n  const sid = String(shopId || \"\").trim();\n  let entry = INBOX_PRELOAD_CACHE.get(sid);\n  if (!entry) {\n    entry = {\n      data: null,\n      loadedAt: 0,\n      promise: null,\n      firstPromise: null,\n      controller: null,\n      generation: 0,\n      nextPageToken: null,\n      pageCount: 0,\n      complete: false,\n      refreshing: false,\n      error: null,\n    };\n    INBOX_PRELOAD_CACHE.set(sid, entry);\n  }\n  return entry;\n}\n\nfunction emptyInboxBundle(shopId) {\n  const sid = String(shopId || \"\").trim();\n  const shop = SHOPS.find((item) => String(item.shop_id) === sid);\n  return {\n    shop: { shop_id: sid, name: (shop && shop.name) || \"当前店铺\" },\n    threads: [],\n    orders: [],\n    order_error: null,\n    next_page_token: null,\n    page_token: null,\n    page_count: 0,\n    truncated: false,\n    fetched_at: null,\n  };\n}\n\nfunction visibleInboxOrderIds(threads) {\n  const ids = new Set();\n  for (const thread of Array.isArray(threads) ? threads : []) {\n    const id = String(thread && thread.order_id || \"\").trim();\n    if (!id) continue;\n    ids.add(id);\n    // 只有站内信实体没有 -A/-B 后缀时，才允许用基础订单号兼容平台返回的拆分号。\n    if (!/-[A-Z]$/.test(id)) ids.add(orderCacheKey(id));\n  }\n  return ids;\n}\n\nfunction mergeInboxPage(shopId, page, options = {}) {\n  const sid = String(shopId || \"\").trim();\n  const entry = inboxCacheEntry(sid);\n  const current = options.replace || !entry.data ? emptyInboxBundle(sid) : entry.data;\n  const threads = new Map((current.threads || [])\n    .map((item) => [String(item.thread_id), item]));\n  for (const thread of Array.isArray(page && page.threads) ? page.threads : []) {\n    const id = String(thread && thread.thread_id || \"\").trim();\n    if (id) threads.set(id, { ...thread, shop_id: thread.shop_id || sid });\n  }\n  const allowedOrderIds = visibleInboxOrderIds([...threads.values()]);\n  const orders = new Map((current.orders || [])\n    .filter((item) => allowedOrderIds.has(String(item && item.order_id || \"\").trim()))\n    .map((item) => [String(item.order_id), item]));\n  for (const order of Array.isArray(page && page.orders) ? page.orders : []) {\n    const id = String(order && order.order_id || \"\").trim();\n    if (id && allowedOrderIds.has(id)) orders.set(id, order);\n  }\n  const errors = [...new Set([current.order_error, page && page.order_error].filter(Boolean).map(String))];\n  const nextToken = page && page.next_page_token ? String(page.next_page_token) : null;\n  entry.nextPageToken = nextToken;\n  entry.pageCount = Number(current.page_count || 0) + 1;\n  entry.data = {\n    ...current,\n    shop: page && page.shop ? page.shop : current.shop,\n    threads: [...threads.values()],\n    orders: [...orders.values()],\n    order_error: errors.length ? errors.join(\"；\") : null,\n    next_page_token: nextToken,\n    page_token: page && page.page_token ? page.page_token : null,\n    page_count: entry.pageCount,\n    truncated: !!nextToken,\n    fetched_at: page && page.fetched_at ? page.fetched_at : current.fetched_at,\n  };\n  return entry.data;\n}\n\nfunction mergeInboxSearchResult(shopId, result) {\n  const sid = String(shopId || \"\").trim();\n  const entry = inboxCacheEntry(sid);\n  const current = entry.data || emptyInboxBundle(sid);\n  const threadMap = new Map((current.threads || [])\n    .map((item) => [String(item.thread_id), item]));\n  for (const thread of Array.isArray(result && result.threads) ? result.threads : []) {\n    const id = String(thread && thread.thread_id || \"\").trim();\n    if (id) threadMap.set(id, { ...thread, shop_id: thread.shop_id || sid });\n  }\n  const allowedOrderIds = visibleInboxOrderIds([...threadMap.values()]);\n  const orderMap = new Map((current.orders || [])\n    .filter((item) => allowedOrderIds.has(String(item && item.order_id || \"\").trim()))\n    .map((item) => [String(item.order_id), item]));\n  for (const order of Array.isArray(result && result.orders) ? result.orders : []) {\n    const id = String(order && order.order_id || \"\").trim();\n    if (id && allowedOrderIds.has(id)) orderMap.set(id, order);\n  }\n  entry.data = {\n    ...current,\n    shop: result && result.shop ? result.shop : current.shop,\n    threads: [...threadMap.values()],\n    orders: [...orderMap.values()],\n    order_error: result && result.order_error ? String(result.order_error) : current.order_error || null,\n    fetched_at: result && result.fetched_at ? result.fetched_at : current.fetched_at,\n  };\n  if (String(GLOBAL_SHOP || \"\") === sid) applyInboxBundle(entry.data);\n  return entry.data;\n}\n\nfunction inboxRequestIsCurrent(shopId, generation, controller) {\n  const entry = inboxCacheEntry(shopId);\n  if (controller && controller.signal.aborted) throw Object.assign(new Error(\"请求已取消\"), { name: \"AbortError\" });\n  if (entry.generation !== generation || entry.controller !== controller) {\n    throw Object.assign(new Error(\"请求已取消\"), { name: \"AbortError\" });\n  }\n}\n\n/* ------------------------------------------------------------------ *\n * v26.97 后台任务中心（顶栏右上角常驻）\n *\n * 起因：登记退款 / 发信 / 改价 这些「提交完还要等」的操作，进度与结果原本只写在各自页面里。\n * 用户不敢切页 —— 切走就不知道成没成，只能干等。\n *\n * 现在它们全部汇总到顶栏这一个指示器：进行中 / 失败 / 最近结果一眼可见，点开是完整列表。\n * 轮询跑在**页面级**，切到任何模块都照样刷新。\n * ------------------------------------------------------------------ */\n(function taskCenterModule() {\n  const POLL_ACTIVE_MS = 2000;   // 有进行中 → 快轮询\n  const POLL_IDLE_MS = 15000;    // 全空闲 → 降频，别白烧\n  let timer = null;\n  let flashTimer = null;\n  let lastPayload = null;\n  let panelOpen = false;\n  let prevRunning = 0;\n\n  const el = (id) => document.getElementById(id);\n\n  function esc(value) {\n    return String(value === null || value === undefined ? \"\" : value)\n      .replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\")\n      .replace(/\"/g, \"&quot;\").replace(/'/g, \"&#39;\");\n  }\n\n  function textOf(value) {\n    if (value === null || value === undefined) return \"\";\n    if (typeof value === \"string\") return value;\n    if (typeof value === \"number\" || typeof value === \"boolean\") return String(value);\n    try { return Object.values(value).filter((v) => v !== null && v !== undefined).join(\" · \"); }\n    catch { return \"\"; }\n  }\n\n  function relTime(iso) {\n    const at = Date.parse(String(iso || \"\"));\n    if (!Number.isFinite(at)) return \"\";\n    const diff = Date.now() - at;\n    if (diff < 5000) return \"刚刚\";\n    if (diff < 60000) return Math.floor(diff / 1000) + \" 秒前\";\n    if (diff < 3600000) return Math.floor(diff / 60000) + \" 分钟前\";\n    if (diff < 86400000) return Math.floor(diff / 3600000) + \" 小时前\";\n    return Math.floor(diff / 86400000) + \" 天前\";\n  }\n\n  function resultLine(task) {\n    if (task.status === \"running\") {\n      const p = task.progress || {};\n      if (p.label) return { text: p.label, cls: \"\" };\n      if (Number(p.total) > 0) return { text: Number(p.done || 0) + \"/\" + Number(p.total) + \" 完成\", cls: \"\" };\n      return { text: \"进行中…\", cls: \"\" };\n    }\n    if (task.status === \"failed\") return { text: task.error || \"失败\", cls: \"err\" };\n    if (task.status === \"partial\") return { text: task.error || textOf(task.result) || \"部分完成\", cls: \"warn\" };\n    return { text: textOf(task.result) || \"已完成\", cls: \"ok\" };\n  }\n\n  function renderRows(tasks) {\n    const list = el(\"taskList\");\n    if (!list) return;\n    if (!tasks.length) { list.innerHTML = '<div class=\"task-empty\">暂无任务</div>'; return; }\n    list.innerHTML = tasks.map((t) => {\n      const line = resultLine(t);\n      const shop = t.shop_name ? `<span class=\"task-shop\">${esc(t.shop_name)}</span>` : \"\";\n      const detail = t.detail ? `<div class=\"task-meta\">${esc(t.detail)}</div>` : \"\";\n      const meta = line.text ? `<div class=\"task-meta ${line.cls}\">${esc(line.text)}</div>` : \"\";\n      const when = relTime(t.status === \"running\" ? t.started_at : (t.finished_at || t.updated_at));\n      const kind = esc(t.kind_label || \"\");\n      return `<div class=\"task-row\" data-s=\"${esc(t.status)}\">`\n        + `<span class=\"task-ico\"></span><div class=\"task-body\">`\n        + `<div class=\"task-title\"><span>${esc(t.title)}</span>${shop}</div>`\n        + detail + meta\n        + `<div class=\"task-time\">${kind}${when ? \" · \" + when : \"\"}</div>`\n        + `</div></div>`;\n    }).join(\"\");\n  }\n\n  function render(payload) {\n    const box = el(\"taskCenter\");\n    const label = el(\"taskLabel\");\n    const badge = el(\"taskBadge\");\n    if (!box || !label) return;\n    const summary = (payload && payload.summary) || { running: 0, failed: 0, total: 0 };\n    const tasks = (payload && payload.tasks) || [];\n    let state = \"idle\";\n    if (summary.running > 0) state = \"running\";\n    else if (summary.failed > 0) state = \"failed\";\n    box.dataset.state = state;\n    if (state === \"running\") label.textContent = summary.running + \" 个进行中\";\n    else if (state === \"failed\") label.textContent = summary.failed + \" 个失败\";\n    else label.textContent = \"任务\";\n    if (badge) {\n      badge.hidden = summary.running <= 0;\n      badge.textContent = String(summary.running || 0);\n    }\n    if (panelOpen) renderRows(tasks);\n  }\n\n  // 切页之后回来，总得让人知道「刚才那批跑完了」—— 而不是眼睁睁看着它悄悄变回「任务」。\n  function flashComplete(count) {\n    const box = el(\"taskCenter\");\n    const label = el(\"taskLabel\");\n    if (!box || !label) return;\n    box.dataset.state = \"done\";\n    label.textContent = count + \" 项已完成\";\n    if (flashTimer) clearTimeout(flashTimer);\n    flashTimer = setTimeout(() => {\n      flashTimer = null;\n      if (lastPayload) render(lastPayload);\n    }, 5000);\n  }\n\n  function schedule(active) {\n    if (timer) { clearTimeout(timer); timer = null; }\n    timer = setTimeout(refresh, active ? POLL_ACTIVE_MS : POLL_IDLE_MS);\n  }\n\n  async function refresh() {\n    try {\n      const r = await fetch(\"/api/tasks?limit=50\", { cache: \"no-store\" });\n      if (!r.ok) throw new Error(\"HTTP \" + r.status);\n      lastPayload = await r.json();\n      render(lastPayload);\n      const runningNow = Number(((lastPayload || {}).summary || {}).running) || 0;\n      if (prevRunning > 0 && runningNow === 0) flashComplete(prevRunning);\n      prevRunning = runningNow;\n      schedule(runningNow > 0);\n    } catch (e) {\n      schedule(false);\n    }\n  }\n\n  function togglePanel(force) {\n    const panel = el(\"taskPanel\");\n    const btn = el(\"taskBtn\");\n    if (!panel) return;\n    panelOpen = force === undefined ? panel.hidden : !!force;\n    panel.hidden = !panelOpen;\n    if (btn) btn.setAttribute(\"aria-expanded\", String(panelOpen));\n    if (panelOpen && lastPayload) renderRows(lastPayload.tasks || []);\n  }\n\n  function boot() {\n    const btn = el(\"taskBtn\");\n    const clearBtn = el(\"taskClearBtn\");\n    if (btn) {\n      btn.addEventListener(\"click\", (e) => { e.stopPropagation(); togglePanel(); });\n    }\n    if (clearBtn) {\n      clearBtn.addEventListener(\"click\", async (e) => {\n        e.stopPropagation();\n        clearBtn.disabled = true;\n        try { await fetch(\"/api/tasks/clear\", { method: \"POST\" }); } catch (err) { /* 清不掉不影响查看 */ }\n        clearBtn.disabled = false;\n        if (timer) { clearTimeout(timer); timer = null; }\n        refresh();\n      });\n    }\n    document.addEventListener(\"click\", (e) => {\n      const box = el(\"taskCenter\");\n      if (panelOpen && box && !box.contains(e.target)) togglePanel(false);\n    });\n    document.addEventListener(\"keydown\", (e) => { if (e.key === \"Escape\" && panelOpen) togglePanel(false); });\n    // 回到前台立刻拉一次，别让用户先看到一个过期数字\n    document.addEventListener(\"visibilitychange\", () => { if (!document.hidden) { if (timer) { clearTimeout(timer); timer = null; } refresh(); } });\n    refresh();\n  }\n\n  if (document.readyState === \"loading\") document.addEventListener(\"DOMContentLoaded\", boot);\n  else boot();\n})();\n\nfunction updateInboxRefreshStatus(shopId, phase = \"progress\") {\n  if (String(GLOBAL_SHOP || \"\") !== String(shopId || \"\")) return;\n  const status = $(\"globalStatus\");\n  if (!status) return;\n  const entry = inboxCacheEntry(shopId);\n  const data = entry.data || emptyInboxBundle(shopId);\n  const shopName = data.shop && data.shop.name || \"当前店铺\";\n  const threadCount = Array.isArray(data.threads) ? data.threads.length : 0;\n  const orderCount = Array.isArray(data.orders) ? data.orders.length : 0;\n  if (phase === \"loading\") {\n    status.textContent = `正在加载 ${shopName} 的站内信…`;\n    status.className = \"status\";\n    return;\n  }\n  if (phase === \"refreshing\") {\n    status.textContent = `后台更新中 · 已载入 ${threadCount} 封${entry.pageCount ? ` · 第 ${entry.pageCount} 页` : \"\"}`;\n    status.className = \"status\";\n    return;\n  }\n  if (phase === \"error\") {\n    status.textContent = `已载入 ${threadCount} 封 · 后台更新失败，稍后自动重试`;\n    status.className = \"status warn\";\n    return;\n  }\n  const suffix = data.order_error ? \" · 订单详情部分失败\" : \"\";\n  status.textContent = `${threadCount} 封 · ${orderCount} 个订单（${shopName}）${suffix}`;\n  status.className = data.order_error ? \"status warn\" : \"status ok\";\n}\n\nfunction resetInboxFallbackKeys(shopId) {\n  const sid = String(shopId || \"\").trim();\n  for (const key of [...INBOX_ORDER_FALLBACK_KEYS]) {\n    if (key.startsWith(`${sid}::`)) INBOX_ORDER_FALLBACK_KEYS.delete(key);\n  }\n}\n\nasync function fetchInboxPage(shopId, pageToken, generation, controller, options = {}) {\n  inboxRequestIsCurrent(shopId, generation, controller);\n  const query = [`shop_id=${encodeURIComponent(shopId)}`];\n  if (pageToken) query.push(`page_token=${encodeURIComponent(pageToken)}`);\n  const page = await api(`/api/inbox/page?${query.join(\"&\")}`, { signal: controller.signal });\n  inboxRequestIsCurrent(shopId, generation, controller);\n  mergeInboxPage(shopId, page, { replace: !!options.replace });\n  if (String(GLOBAL_SHOP || \"\") === String(shopId)) {\n    applyInboxBundle(inboxCacheEntry(shopId).data);\n    updateInboxRefreshStatus(shopId, \"refreshing\");\n  }\n  return page;\n}\n\n// 过期数据采用 stale-while-revalidate：先继续显示旧列表，后台按页更新；首次无缓存时只等待第一页。\nfunction refreshInboxInBackground(shopId = GLOBAL_SHOP, options = {}) {\n  const sid = String(shopId || \"\").trim();\n  if (!sid) return Promise.resolve(null);\n  const entry = inboxCacheEntry(sid);\n  const awaitFirst = options.awaitFirst !== false;\n  if (entry.promise) return awaitFirst ? (entry.firstPromise || entry.promise) : entry.promise;\n  const controller = new AbortController();\n  const generation = Number(entry.generation || 0) + 1;\n  entry.generation = generation;\n  entry.controller = controller;\n  entry.refreshing = true;\n  entry.error = null;\n  let firstSettled = false;\n  let resolveFirst;\n  let rejectFirst;\n  const firstPromise = new Promise((resolve, reject) => { resolveFirst = resolve; rejectFirst = reject; });\n  updateInboxRefreshStatus(sid, entry.data ? \"refreshing\" : \"loading\");\n  const run = (async () => {\n    try {\n      resetInboxFallbackKeys(sid);\n      const first = await fetchInboxPage(sid, null, generation, controller, { replace: true });\n      firstSettled = true;\n      resolveFirst(inboxCacheEntry(sid).data);\n      let nextToken = first.next_page_token || null;\n      while (nextToken) {\n        const page = await fetchInboxPage(sid, nextToken, generation, controller);\n        nextToken = page.next_page_token || null;\n        updateInboxRefreshStatus(sid, \"refreshing\");\n      }\n      inboxRequestIsCurrent(sid, generation, controller);\n      entry.nextPageToken = null;\n      entry.complete = true;\n      entry.loadedAt = Date.now();\n      entry.refreshing = false;\n      entry.error = null;\n      if (entry.data) entry.data.truncated = false;\n      if (String(GLOBAL_SHOP || \"\") === sid) {\n        applyInboxBundle(entry.data);\n        updateInboxRefreshStatus(sid, \"complete\");\n      }\n      return entry.data;\n    } catch (error) {\n      const stillCurrent = entry.generation === generation && entry.controller === controller;\n      if (!stillCurrent) {\n        if (!firstSettled) rejectFirst(error);\n        throw error;\n      }\n      if (!firstSettled) rejectFirst(error);\n      entry.refreshing = false;\n      entry.error = error;\n      // 若第一页成功而历史页失败，已显示的部分仍然有效，整点再继续尝试。\n      if (firstSettled) {\n        entry.loadedAt = Date.now();\n        if (entry.data) entry.data.truncated = true;\n        if (String(GLOBAL_SHOP || \"\") === sid) {\n          applyInboxBundle(entry.data);\n          updateInboxRefreshStatus(sid, \"error\");\n        }\n        return entry.data;\n      }\n      if (entry.data) entry.loadedAt = Date.now();\n      if (String(GLOBAL_SHOP || \"\") === sid) updateInboxRefreshStatus(sid, \"error\");\n      throw error;\n    } finally {\n      const current = INBOX_PRELOAD_CACHE.get(sid);\n      if (current && current.controller === controller) {\n        INBOX_PRELOAD_CACHE.set(sid, { ...current, promise: null, firstPromise: null, controller: null, refreshing: false });\n      }\n    }\n  })();\n  entry.promise = run;\n  entry.firstPromise = firstPromise;\n  firstPromise.catch(() => {});\n  // 后台刷新不应产生未处理 Promise；首次请求仍由调用方通过 firstPromise 接收错误。\n  run.catch(() => {});\n  return awaitFirst ? firstPromise : run;\n}\n\nasync function loadAll(options = {}) {\n  const force = options === true || !!(options && options.force);\n  const sid = String(GLOBAL_SHOP || \"\").trim();\n  const shop = SHOPS.find((s) => String(s.shop_id) === sid);\n  if (!sid) {\n    $(\"globalStatus\").textContent = \"未选择店铺\";\n    $(\"globalStatus\").className = \"status err\";\n    return null;\n  }\n  const cached = INBOX_PRELOAD_CACHE.get(sid);\n  const fresh = cached && cached.data && Date.now() - Number(cached.loadedAt || 0) < INBOX_PRELOAD_TTL;\n  if (!force && cached && cached.data) {\n    applyInboxBundle(cached.data);\n    if (fresh) return cached.data;\n    refreshInboxInBackground(sid, { force: true, awaitFirst: false }).catch(() => {});\n    return cached.data;\n  }\n  $(\"globalStatus\").textContent = `${force ? \"正在刷新\" : \"正在加载\"} ${(shop && shop.name) || \"当前店铺\"} 的站内信…`;\n  $(\"globalStatus\").className = \"status\";\n  try {\n    const bundle = await preloadInbox(sid, { force: true, awaitFirst: true });\n    if (String(GLOBAL_SHOP) === sid && bundle) applyInboxBundle(bundle);\n    return bundle;\n  } catch (e) {\n    console.warn((shop && shop.name) || sid, e.message);\n    if (String(GLOBAL_SHOP) === sid) {\n      $(\"globalStatus\").textContent = `加载失败：${e.message}`;\n      $(\"globalStatus\").className = \"status err\";\n    }\n    return null;\n  }\n}\n\nconst INBOX_TOPIC_CANCEL_ORDER_TEXT = \"Stornierungsanfrage für die Bestellung\";\nconst INBOX_TOPIC_GROUP_OPTIONS = [\n  { value: \"cancel_order\", label: \"取消订单\" },\n  { value: \"product\", label: \"商品问题\" },\n  { value: \"shipping\", label: \"配送物流\" },\n  { value: \"refund\", label: \"退款支付\" },\n  { value: \"after_sales\", label: \"退货售后\" },\n  { value: \"invoice\", label: \"发票\" },\n  { value: \"order\", label: \"订单信息\" },\n  { value: \"review\", label: \"卖家评价\" },\n  { value: \"other_issue\", label: \"其他问题\" },\n  { value: \"uncategorized\", label: \"其他/未分类\" },\n];\nconst INBOX_TOPIC_GROUP_VALUES = new Set(INBOX_TOPIC_GROUP_OPTIONS.map((option) => option.value));\nconst INBOX_TOPIC_GROUP_BY_CODE = Object.freeze({\n  ORDER_MESSAGING_01: \"product\",\n  ORDER_MESSAGING_02: \"order\",\n  ORDER_MESSAGING_03: \"shipping\",\n  ORDER_MESSAGING_04: \"refund\",\n  ORDER_MESSAGING_05: \"shipping\",\n  ORDER_MESSAGING_06: \"product\",\n  ORDER_MESSAGING_07: \"invoice\",\n  ORDER_MESSAGING_08: \"after_sales\",\n  ORDER_MESSAGING_09: \"after_sales\",\n  ORDER_MESSAGING_10: \"after_sales\",\n  ORDER_MESSAGING_11: \"other_issue\",\n  ORDER_MESSAGING_12: \"refund\",\n  ORDER_MESSAGING_27: \"invoice\",\n  ORDER_MESSAGING_31: \"order\",\n  ORDER_MESSAGING_32: \"review\",\n  ORDER_MESSAGING_40: \"product\",\n  40: \"product\",\n});\n\nfunction normalizeInboxTopicText(value) {\n  return String(value ?? \"\")\n    .replace(/[\\u0000-\\u001f\\u007f]/g, \" \")\n    .replace(/[\\u200B-\\u200D\\uFEFF]/g, \"\")\n    .replace(/\\u00a0/g, \" \")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nfunction isInboxCancelOrderTopic(topicCode) {\n  const normalized = normalizeInboxTopicText(topicCode);\n  const prefix = INBOX_TOPIC_CANCEL_ORDER_TEXT.toLowerCase();\n  if (normalized.toLowerCase() === prefix) return true;\n  if (!normalized.toLowerCase().startsWith(`${prefix} `)) return false;\n  const suffix = normalized.slice(INBOX_TOPIC_CANCEL_ORDER_TEXT.length).trim();\n  return /^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(suffix);\n}\n\nfunction inboxTopicKey(thread) {\n  const serverGroup = normalizeInboxTopicText(thread && thread.topic_group);\n  if (INBOX_TOPIC_GROUP_VALUES.has(serverGroup)) return serverGroup;\n  const code = normalizeInboxTopicText(thread && thread.topic_code);\n  if (isInboxCancelOrderTopic(code)) return \"cancel_order\";\n  return INBOX_TOPIC_GROUP_BY_CODE[code.toUpperCase()] || \"uncategorized\";\n}\n\nfunction renderInboxTopicOptions() {\n  const select = $(\"inboxTopicFilter\");\n  if (!select) return;\n  const options = INBOX_TOPIC_GROUP_OPTIONS;\n  const validValues = new Set([\"\", ...options.map((option) => option.value)]);\n  if (!validValues.has(INBOX_TOPIC_FILTER)) INBOX_TOPIC_FILTER = \"\";\n  select.innerHTML = '<option value=\"\">全部主题</option>' + options.map((option) =>\n    `<option value=\"${escapeAttr(option.value)}\">${escapeHtml(option.label)}</option>`\n  ).join(\"\");\n  select.value = INBOX_TOPIC_FILTER;\n  select.disabled = !GLOBAL_SHOP;\n}\n\nasync function loadInboxTopicCatalog(shopId = GLOBAL_SHOP) {\n  INBOX_TOPIC_CATALOG = [];\n  INBOX_TOPIC_FILTER = \"\";\n  renderInboxTopicOptions();\n  // 主题筛选使用本地业务分组，不再等待或依赖官方原因码目录；\n  // 官方目录只在“新建站内信”窗口中按需读取。\n  void shopId;\n  renderInboxTopicOptions();\n}\n\n// ---- 站内信回复时限（v26.87）----\n// 平台考核「消息响应时长 ≤ 48 小时」。起点取平台给的 shop_reply_needed_since\n// （平台标记「需要店铺回复」的时刻）；缺失时退回最后一条消息时间，并显式标注为估算\n// —— 宁可少判也不假装精确：起点都拿不到时返回 unknown，页面不显示任何时限结论。\nconst INBOX_REPLY_SLA_MS = 48 * 60 * 60 * 1000;\nconst INBOX_DUE_SOON_MS = 12 * 60 * 60 * 1000;\n\nfunction inboxDateToMs(value) {\n  if (!value) return null;\n  const ms = Date.parse(value);\n  return Number.isFinite(ms) ? ms : null;\n}\n\nfunction inboxDueState(thread, now = Date.now()) {\n  const unknown = { status: \"unknown\", remainMs: null, deadline: null, estimated: false };\n  if (!thread || thread.needReply !== true) return unknown;\n  const sinceMs = inboxDateToMs(thread.shop_reply_needed_since);\n  const lastMs = inboxDateToMs(thread.last_message_date);\n  const baseMs = sinceMs !== null ? sinceMs : lastMs;\n  if (baseMs === null) return unknown;\n  const deadline = baseMs + INBOX_REPLY_SLA_MS;\n  const remainMs = deadline - now;\n  const status = remainMs <= 0 ? \"overdue\" : remainMs <= INBOX_DUE_SOON_MS ? \"soon\" : \"ok\";\n  return { status, remainMs, deadline, estimated: sinceMs === null };\n}\n\nfunction inboxDueRemainText(state) {\n  if (!state || state.remainMs === null) return \"\";\n  const abs = Math.abs(state.remainMs);\n  const hours = Math.floor(abs / 3600000);\n  const minutes = Math.floor((abs % 3600000) / 60000);\n  const span = hours > 0 ? `${hours} 小时${minutes ? ` ${minutes} 分` : \"\"}` : `${Math.max(1, minutes)} 分`;\n  return state.status === \"overdue\" ? `已超时 ${span}` : `还剩 ${span} 超时`;\n}\n\nfunction inboxDueTitle(state) {\n  if (!state || state.status === \"unknown\") return \"\";\n  const deadlineText = state.deadline ? new Date(state.deadline).toLocaleString(\"zh-CN\") : \"\";\n  const basis = state.estimated ? \"起点按最后一条消息时间估算\" : \"起点为平台标记的需回复时间\";\n  return `回复时限 48 小时，截止 ${deadlineText}（${basis}）`;\n}\n\nfunction renderInboxDueBadge(thread, now = Date.now()) {\n  const state = inboxDueState(thread, now);\n  if (state.status !== \"overdue\" && state.status !== \"soon\") return \"\";\n  const cls = state.status === \"overdue\" ? \"due-overdue\" : \"due-soon\";\n  const mark = state.status === \"overdue\" ? \"⚠\" : \"⏱\";\n  return ` <span class=\"due-flag ${cls}\" title=\"${escapeAttr(inboxDueTitle(state))}\">${mark} ${inboxDueRemainText(state)}${state.estimated ? \"（估）\" : \"\"}</span>`;\n}\n\nfunction filteredThreads() {\n  let list = ALL_THREADS.slice();\n  if (ACTIVE_SHOP) list = list.filter((t) => String(t.shop_id) === String(ACTIVE_SHOP));\n  const pendingOrderKeys = new Set(\n    list.filter((t) => t.needReply && t.order_key).map((t) => t.order_key),\n  );\n  if (FILTER === \"unread\") list = list.filter((t) => t.unread);\n  if (FILTER === \"need\") list = list.filter((t) => t.needReply || (t.order_key && pendingOrderKeys.has(t.order_key)));\n  if (INBOX_TOPIC_FILTER) list = list.filter((t) => inboxTopicKey(t) === INBOX_TOPIC_FILTER);\n  if (INBOX_ORDER_QUERY) {\n    const query = INBOX_ORDER_QUERY.toLowerCase();\n    list = list.filter((t) => String(t.order_id || t.entity_id || \"\").toLowerCase().includes(query));\n  }\n  return [...list].sort((a, b) => (b.last_message_date || \"\").localeCompare(a.last_message_date || \"\"));\n}\n\n// 按订单分组渲染（同订单多个线程合并为一组）\nlet EXPANDED_ORDERS = new Set();\n\nfunction renderMailList() {\n  const list = filteredThreads();\n  const unreadInList = list.filter((t) => t.unread).length;\n  const needInList = list.filter((t) => t.needReply).length;\n  // v26.87：时限只统计「待回复」的线程 —— 已解决/无需回复的不该挂在超时口径里。\n  const nowMs = Date.now();\n  const overdueInList = list.filter((t) => inboxDueState(t, nowMs).status === \"overdue\").length;\n  const dueSoonInList = list.filter((t) => inboxDueState(t, nowMs).status === \"soon\").length;\n  $(\"listCount\").textContent = `${list.length} 封${needInList ? ` · ${needInList} 待回复` : \"\"}${unreadInList ? ` · ${unreadInList} 未读` : \"\"}${overdueInList ? ` · ${overdueInList} 已超时` : \"\"}${dueSoonInList ? ` · ${dueSoonInList} 即将超时` : \"\"}`;\n  // 未读数（左侧店铺）\n  document.querySelectorAll(\".shop-item[data-shop]\").forEach((el) => {\n    const sid = el.dataset.shop;\n    const n = ALL_THREADS.filter((t) => t.shop_id === sid && t.unread).length;\n    const c = $(\"cnt-\" + sid); if (!c) return;\n    c.textContent = n; c.className = \"cnt\" + (n ? \"\" : \" zero\");\n  });\n  const unreadAll = ALL_THREADS.filter((t) => t.unread).length;\n  $(\"totalUnread\").textContent = `${unreadAll} 未读`;\n\n  if (list.length === 0) {\n    $(\"mailList\").innerHTML = '<div class=\"empty\">没有匹配的邮件</div>';\n    return;\n  }\n\n  // 构造\"条目\"列表：单线程 = 邮件行；同一订单 ≥2 线程 = 订单组\n  // 每个条目按 last_message_date 统一排序（组用组内最新时间）\n  const groupCounts = new Map();\n  for (const t of list) {\n    if (t.order_key) groupCounts.set(t.order_key, (groupCounts.get(t.order_key) || 0) + 1);\n  }\n  const entries = [];\n  const groupedTids = new Set();\n  for (const [key, count] of groupCounts) {\n    if (count < 2) continue;\n    const threads = list.filter((t) => t.order_key === key);\n    threads.forEach((t) => groupedTids.add(t.thread_id));\n    entries.push({ type: \"group\", key, threads });\n  }\n  for (const t of list) {\n    if (groupedTids.has(t.thread_id)) continue;\n    entries.push({ type: \"single\", thread: t });\n  }\n  // 统一按最新时间倒序\n  entries.sort((a, b) => {\n    const ta = a.type === \"group\" ? a.threads.reduce((m, t) => (t.last_message_date > m ? t.last_message_date : m), \"\") : a.thread.last_message_date || \"\";\n    const tb = b.type === \"group\" ? b.threads.reduce((m, t) => (t.last_message_date > m ? t.last_message_date : m), \"\") : b.thread.last_message_date || \"\";\n    return tb.localeCompare(ta);\n  });\n\n  const html = entries.map((e) => {\n    if (e.type === \"single\") {\n      const t = e.thread;\n      const order = t.order_id ? getInboxOrder(t.order_id) : null;\n      const amountHtml = t.order_id ? renderOrderAmount(order, { pending: t.needReply }) : \"\";\n      const incidentHtml = renderIncidentBadge(order);\n      const refundHtml = renderRefundBadge(order);\n      const statusBadges = incidentHtml + refundHtml;\n      const dueState = inboxDueState(t, nowMs);\n      const dueClass = dueState.status === \"overdue\" ? \" due-overdue\" : dueState.status === \"soon\" ? \" due-soon\" : \"\";\n      return `<div class=\"mail-item ${t.unread ? \"unread\" : \"\"} ${t.resolved && !t.needReply ? \"resolved-mail\" : \"\"}${dueClass}\" data-tid=\"${t.thread_id}\" data-shop=\"${t.shop_id}\">\n      <div class=\"row1\">\n        <span class=\"from\">${senderLabel(t)}<span class=\"mail-current-badge\" aria-hidden=\"true\">✓ 当前</span></span>\n        <span class=\"time\">${fmtTime(t.last_message_date)}</span>\n      </div>\n      <div class=\"subj\">${t.entity_id ? t.entity_id + \" · \" : \"\"}${t.topic || \"\"}${t.needReply ? ' <span class=\"need-reply\">● 需回复</span>' : t.resolved ? ' <span class=\"g-ok\">✓</span>' : \"\"}${renderInboxDueBadge(t, nowMs)}</div>\n      <div class=\"meta\">\n        <span>${t.message_count} 条消息</span>\n        ${statusBadges}\n        ${amountHtml}\n      </div>\n    </div>`;\n    }\n    // group\n    const threads = e.threads;\n    const first = threads[0];\n    const orderId = first.order_id || \"（无订单关联）\";\n    const gUnread = threads.filter((t) => t.unread).length;\n    const gNeed = threads.filter((t) => t.needReply).length;\n    const gResolved = threads.filter((t) => t.resolved).length;\n    const gOverdue = threads.filter((t) => inboxDueState(t, nowMs).status === \"overdue\").length;\n    const gDueSoon = threads.filter((t) => inboxDueState(t, nowMs).status === \"soon\").length;\n    const latest = threads.reduce((m, t) => (t.last_message_date > m ? t.last_message_date : m), \"\");\n    const expanded = EXPANDED_ORDERS.has(e.key);\n    const shopTag = \"\";\n    const order = orderId !== \"（无订单关联）\" ? getInboxOrder(orderId) : null;\n    const amountHtml = orderId !== \"（无订单关联）\"\n      ? renderOrderAmount(order, { pending: gNeed > 0 })\n      : \"\";\n    const incidentHtml = renderIncidentBadge(order);\n    const refundHtml = renderRefundBadge(order);\n    const statusBadges = incidentHtml + refundHtml;\n    return `<div class=\"order-group ${expanded ? \"expanded\" : \"\"}\" data-ok=\"${e.key}\">\n      <div class=\"order-head ${gUnread ? \"has-unread\" : \"\"}\" data-ok=\"${e.key}\">\n        <span class=\"caret\">${expanded ? \"▾\" : \"▸\"}</span>\n        <span class=\"oid\">${shopTag}${orderId}</span>\n        ${statusBadges}\n        ${amountHtml}\n        <span class=\"gmeta\">\n          ${gNeed ? `<span class=\"need-reply\">● ${gNeed} 待回复</span>` : \"\"}\n          ${gOverdue ? `<span class=\"due-flag due-overdue\" title=\"该订单有 ${gOverdue} 封站内信已超过 48 小时回复时限\">⚠ ${gOverdue} 已超时</span>` : \"\"}\n          ${gDueSoon ? `<span class=\"due-flag due-soon\" title=\"该订单有 ${gDueSoon} 封站内信将在 12 小时内超过回复时限\">⏱ ${gDueSoon} 即将超时</span>` : \"\"}\n          ${gUnread ? `<span class=\"g-unread\">${gUnread} 未读</span>` : \"\"}\n          ${gResolved ? `<span class=\"g-ok\">✓ ${gResolved}</span>` : \"\"}\n          <span>${threads.length} 线</span>\n        </span>\n        <span class=\"time\">${fmtTime(latest)}</span>\n      </div>\n      ${expanded ? `<div class=\"group-body\">${threads.map((t) => `\n        <div class=\"mail-item group-mail ${t.unread ? \"unread\" : \"\"} ${t.resolved && !t.needReply ? \"resolved-mail\" : \"\"}${inboxDueState(t, nowMs).status === \"overdue\" ? \" due-overdue\" : inboxDueState(t, nowMs).status === \"soon\" ? \" due-soon\" : \"\"}\" data-tid=\"${t.thread_id}\" data-shop=\"${t.shop_id}\">\n          <div class=\"row1\">\n            <span class=\"from\">${senderLabel(t)}<span class=\"mail-current-badge\" aria-hidden=\"true\">✓ 当前</span></span>\n            <span class=\"time\">${fmtTime(t.last_message_date)}</span>\n          </div>\n          <div class=\"subj\">${t.topic || \"\"}${t.needReply ? ' <span class=\"need-reply\">● 需回复</span>' : t.resolved ? ' <span class=\"g-ok\">✓</span>' : \"\"}${renderInboxDueBadge(t, nowMs)}</div>\n        <div class=\"meta\"><span>${t.message_count} 条</span>${t.order_id ? renderIncidentBadge(getInboxOrder(t.order_id)) + renderRefundBadge(getInboxOrder(t.order_id)) : \"\"}${t.order_id ? renderOrderAmount(getInboxOrder(t.order_id), { pending: t.needReply }) : \"\"}</div>\n        </div>`).join(\"\")}</div>` : \"\"}\n    </div>`;\n  }).join(\"\");\n  $(\"mailList\").innerHTML = html;\n\n  // 组头点击：展开/收起\n  document.querySelectorAll(\".order-head\").forEach((el) => {\n    el.addEventListener(\"click\", () => {\n      const key = el.dataset.ok;\n      if (EXPANDED_ORDERS.has(key)) EXPANDED_ORDERS.delete(key);\n      else EXPANDED_ORDERS.add(key);\n      renderMailList();\n    });\n  });\n  // 线程点击：打开（ERP 履约预热不在这里做 —— 见 scheduleErpPrefetch：必须让内容先上屏，否则会与站内信加载抢服务端资源）\n  document.querySelectorAll(\".mail-item\").forEach((el) => {\n    el.addEventListener(\"click\", (e) => {\n      e.stopPropagation();\n      openThread(el.dataset.tid, el.dataset.shop);\n    });\n  });\n  // 保留当前选中并展开所在组\n  if (CURRENT_THREAD) {\n    const currentTid = String(CURRENT_THREAD.thread_id);\n    const cur = document.querySelector(`.mail-item[data-tid=\"${currentTid}\"]`);\n    if (cur) {\n      const selectionChanged = INBOX_SELECTED_RENDERED_TID !== currentTid;\n      cur.classList.add(\"active\");\n      cur.classList.toggle(\"selection-enter\", selectionChanged);\n      cur.setAttribute(\"aria-current\", \"true\");\n      INBOX_SELECTED_RENDERED_TID = currentTid;\n      const grp = cur.closest(\".order-group\");\n      if (grp && CURRENT_THREAD.order_key) EXPANDED_ORDERS.add(CURRENT_THREAD.order_key);\n    } else {\n      INBOX_SELECTED_RENDERED_TID = null;\n    }\n  } else {\n    INBOX_SELECTED_RENDERED_TID = null;\n  }\n}\n\n// v26.71：M10 每条消息的收件方白名单（服务端 to_kind 只有这三档），\n// 前端再校验一次，避免任何取值直接拼进 class。\nconst MESSAGE_RECIPIENT_KINDS = new Set([\"customer\", \"operator\", \"both\"]);\n\nasync function openThread(threadId, shopId) {\n  const orderDrawer = $(\"orderDetailDrawer\");\n  const reopenOrderDetail = !!(orderDrawer && !orderDrawer.classList.contains(\"hidden\"));\n  // 切换线程时先清掉上一封邮件的订单上下文，避免抽屉短暂显示旧订单。\n  if (reopenOrderDetail) closeOrderDetail();\n  $(\"readPane\").innerHTML = '<div class=\"loading\">加载中…</div>';\n  $(\"replyBox\").style.display = \"none\";\n  try {\n    const d = await api(`/api/inbox/thread?shop_id=${shopId}&thread_id=${encodeURIComponent(threadId)}`);\n    const listedThread = ALL_THREADS.find((x) => x.thread_id === threadId);\n    CURRENT_THREAD = { thread_id: d.thread_id, shop_id: shopId, shop_name: d.shop.name };\n    // 记录订单分组键（回复后用于同订单联动已解决），同时为站内信快捷退款保留订单号\n    const ent = (d.entity || []).find((x) => x && /(?:^|_)ORDER$/i.test(String(x.type || \"\"))) || null;\n    CURRENT_THREAD.order_id = String(d.order_id || (ent && ent.id) || \"\").trim() || null;\n    CURRENT_THREAD.order_key = CURRENT_THREAD.order_id ? `${shopId}::${CURRENT_THREAD.order_id}` : null;\n    // v26.45：最后一封的发送方决定该线程能否被标记未读（我方最后发送的线程不算未读）\n    CURRENT_THREAD.last_sender_type = d.last_sender_type || null;\n    CURRENT_THREAD.needReply = d.needReply === true || (d.needReply === undefined && listedThread?.needReply === true);\n    CURRENT_THREAD.resolved = d.resolved === true;\n    syncReplyBatchControl(CURRENT_THREAD);\n    // 保留 M10 当前参与者；发送时由收件人模式统一生成 message_input.to[]。\n    const participants = d.participants || [];\n    CURRENT_THREAD.participants = participants.map((p) => ({ id: p.id, type: p.type, display_name: p.display_name }));\n    CURRENT_THREAD.recipient_mode = preferredReplyRecipientMode(CURRENT_THREAD.participants, Boolean(CURRENT_THREAD.order_id));\n    CURRENT_THREAD.to = selectReplyRecipients(CURRENT_THREAD.participants, CURRENT_THREAD.recipient_mode);\n    // 本地更新未读\n    const t = listedThread;\n    if (t) { t.unread = false; t.read_at = new Date().toISOString(); renderMailList(); }\n\n    // M10 仍负责打开线程并标记已读；消息内容优先使用实时响应，缺省时回退到预加载快照。\n    const preloadThread = ALL_THREADS.find((x) => x.thread_id === threadId);\n    const msgs = d.messages && d.messages.length ? d.messages : (preloadThread && preloadThread.messages) || [];\n    // 非待回复线程的订单详情不在启动预加载中；打开线程即开始按需读取。\n    const orderRequest = CURRENT_THREAD.order_id && !getInboxOrder(CURRENT_THREAD.order_id)\n      ? loadInboxOrder(CURRENT_THREAD.order_id, shopId).catch(() => null)\n      : Promise.resolve(getInboxOrder(CURRENT_THREAD.order_id));\n    const threadOrderLabel = CURRENT_THREAD.order_id || threadId;\n    const incidentCloseButton = CURRENT_THREAD.order_id\n      ? `<button class=\"btn btn-filled incident-close-trigger hidden\" data-action=\"incident-close\" data-order-id=\"${escapeAttr(CURRENT_THREAD.order_id)}\" data-shop-id=\"${escapeAttr(shopId)}\" type=\"button\"><span class=\"icon-svg icon-alert\"></span><span>关闭事件</span></button>`\n      : \"\";\n    const orderDetailButton = CURRENT_THREAD.order_id\n      ? `<button class=\"btn order-detail-trigger\" data-action=\"order-detail\" data-order-id=\"${escapeAttr(CURRENT_THREAD.order_id)}\" data-shop-id=\"${escapeAttr(shopId)}\" type=\"button\"><span class=\"icon-svg icon-orders\"></span><span>订单详情</span></button>`\n      : \"\";\n    const quickRefundButton = CURRENT_THREAD.order_id\n      ? `<button class=\"btn btn-filled quick-refund-trigger\" data-action=\"quick-refund\" data-order-id=\"${escapeAttr(CURRENT_THREAD.order_id)}\" data-shop-id=\"${escapeAttr(shopId)}\" type=\"button\"><span class=\"icon-svg icon-refund\"></span><span>快捷退款</span></button>`\n      : \"\";\n    // v26.68：站内信内的「申请退货标签」—— 与「退货标签」页的 ⚡ 一键到底同一条链路，\n    // 区别只在交付目标：标签**发进当前这条对话**（thread_id 一起传给后端）。\n    const returnLabelButton = CURRENT_THREAD.order_id\n      ? `<button class=\"btn return-label-trigger\" data-action=\"return-label\" data-order-id=\"${escapeAttr(CURRENT_THREAD.order_id)}\" data-shop-id=\"${escapeAttr(shopId)}\" data-thread-id=\"${escapeAttr(threadId)}\" type=\"button\" title=\"向 ERP 申请退货单 → 取面单链接 → 建退货单（开启退货渠道）→ 在当前站内信把标签发给买家\"><span class=\"icon-svg icon-returnlabel\"></span><span class=\"return-label-btn-text\">申请退货标签</span></button>`\n      : \"\";\n    const markUnreadButton = CURRENT_THREAD.last_sender_type && CURRENT_THREAD.last_sender_type !== \"SHOP_USER\"\n      ? `<button class=\"btn mark-unread-trigger\" data-action=\"mark-unread\" type=\"button\" title=\"标记后刷新或重启仍保持未读；下次打开该站内信会恢复已读\"><span class=\"icon-svg icon-read\"></span><span class=\"mark-unread-label\">标记未读</span></button>`\n      : \"\";\n    const threadActions = [markUnreadButton, incidentCloseButton, orderDetailButton, returnLabelButton, quickRefundButton].filter(Boolean).join(\"\");\n    $(\"readPane\").innerHTML = `\n      <div class=\"thread-head\">\n        <div class=\"thread-head-row\">\n          <div class=\"t-title\">${escapeHtml(threadOrderLabel)} ${d.topic ? '<span class=\"tag\">' + escapeHtml(d.topic) + \"</span>\" : \"\"}</div>\n          ${threadActions ? `<div class=\"thread-head-actions\">${threadActions}</div>` : \"\"}\n        </div>\n        <div class=\"t-meta\"><span>店铺：${escapeHtml(d.shop.name)}</span><span>${msgs.length} 条消息</span><span>创建于 ${fmtTime(d.created)}</span></div>\n      </div>\n      <div class=\"msgs\">${msgs.map((m) => {\n        const av = m.from_type === \"CUSTOMER_USER\" ? \"av-buyer\" : m.from_type === \"SHOP_USER\" ? \"av-shop\" : m.from_type === \"OPERATOR_USER\" ? \"av-op\" : \"av-other\";\n        const name = m.from_type === \"SHOP_USER\" ? \"我方\" : m.from_type === \"OPERATOR_USER\" ? \"平台\" : (m.from_name || \"?\");\n        const initial = (m.from_name || name || \"?\").charAt(0).toUpperCase();\n        const outgoing = m.from_type === \"SHOP_USER\";\n        // v26.71：我方发出的消息标出收件方（客户 / 操作员 / 双方）——自动发出的\n        // 退款通知、退货标签也是「我方」，从正文分不出对象，这里一眼可见。\n        const recipientKind = outgoing && MESSAGE_RECIPIENT_KINDS.has(m.to_kind) ? m.to_kind : null;\n        const recipientTag = recipientKind\n          ? `<span class=\"mrecipient to-${recipientKind}\" title=\"${escapeAttr(\"此消息的收件方：\" + (m.to_label || \"\"))}\">发给 ${escapeHtml(m.to_label || \"\")}</span>`\n          : \"\";\n        return `<div class=\"msg ${outgoing ? \"msg-outgoing\" : \"msg-incoming\"}\">\n          <div class=\"avatar ${av}\">${escapeHtml(initial)}</div>\n          <div class=\"msg-body\">\n            <div class=\"mhead\"><span class=\"mhead-left\"><span class=\"mname\">${escapeHtml(name)}</span>${recipientTag}</span><span class=\"mtime\">${fmtTime(m.date)}</span></div>\n            <div class=\"mtext\">${renderMessageBody(m.body, m.attachments)}</div>\n            ${renderAttachmentLinks(m.attachments, shopId)}\n          </div>\n        </div>`;\n      }).join(\"\") || '<div class=\"empty\">该线程暂无消息</div>'}</div>`;\n    const timeline = $(\"readPane\").querySelector(\".msgs\");\n    if (timeline) timeline.classList.add(\"thread-timeline\");\n    const quickRefundTrigger = $(\"readPane\").querySelector('[data-action=\"quick-refund\"]');\n    if (quickRefundTrigger) {\n      quickRefundTrigger.addEventListener(\"click\", () => openQuickRefund(quickRefundTrigger.dataset.orderId, quickRefundTrigger.dataset.shopId));\n    }\n    const returnLabelTrigger = $(\"readPane\").querySelector('[data-action=\"return-label\"]');\n    if (returnLabelTrigger) {\n      returnLabelTrigger.addEventListener(\"click\", () => {\n        // ⚠️ v26.70：这里原来收尾是 `.catch(() => {})` —— 同步异常和 Promise 拒绝都会被吞掉，\n        //    按钮点下去界面毫无变化。同事「点了确定，没发出去、也没反应」就是这类吞错的表象。\n        //    现在两种失败都必须落到可见位置（站内信右侧的 replyStatus）。\n        const reportInboxApplyError = (error) => {\n          const text = \"申请退货标签失败：\" + ((error && error.message) || error || \"未知错误\");\n          const st = $(\"replyStatus\");\n          if (st) { st.textContent = text; st.className = \"status err\"; } else { alert(text); }\n        };\n        try {\n          const pending = inboxApplyReturnLabel(returnLabelTrigger.dataset.orderId, returnLabelTrigger.dataset.shopId, returnLabelTrigger.dataset.threadId);\n          if (pending && typeof pending.catch === \"function\") pending.catch(reportInboxApplyError);\n        } catch (error) {\n          reportInboxApplyError(error);\n        }\n      });\n    }\n    const orderDetailTrigger = $(\"readPane\").querySelector('[data-action=\"order-detail\"]');\n    if (orderDetailTrigger) {\n      orderDetailTrigger.addEventListener(\"click\", () => openOrderDetail(orderDetailTrigger.dataset.orderId, orderDetailTrigger.dataset.shopId));\n    }\n    const incidentCloseTrigger = $(\"readPane\").querySelector('[data-action=\"incident-close\"]');\n    if (incidentCloseTrigger) {\n      incidentCloseTrigger.addEventListener(\"click\", () => openIncidentCloseDialog(incidentCloseTrigger.dataset.orderId, incidentCloseTrigger.dataset.shopId));\n    }\n    const markUnreadTrigger = $(\"readPane\").querySelector('[data-action=\"mark-unread\"]');\n    if (markUnreadTrigger) {\n      markUnreadTrigger.addEventListener(\"click\", () => { markCurrentThreadUnread(); });\n    }\n    syncMarkUnreadControl();\n    updateIncidentCloseTrigger(CURRENT_THREAD.order_id);\n    const recipientMode = $(\"replyRecipientMode\");\n    if (recipientMode) recipientMode.value = CURRENT_THREAD.recipient_mode;\n    $(\"replyBox\").style.display = \"flex\";\n    $(\"replyStatus\").textContent = \"\";\n  clearReplyBatchReport();\n    $(\"replyText\").value = \"\";\n    // v26.61：站内信内容已上屏，此刻才安排 ERP 履约预热（串行 + 空闲执行）。\n    // 预热只是提前准备，用户还没看；让它给「打开站内信」让路。\n    scheduleErpPrefetch(CURRENT_THREAD && CURRENT_THREAD.order_id);\n    orderRequest.then(() => {\n      if (CURRENT_THREAD && CURRENT_THREAD.thread_id === threadId) {\n        renderMailList();\n        updateIncidentCloseTrigger(CURRENT_THREAD.order_id);\n        // 如果用户切换前已打开订单详情，等待当前线程的订单准备好后自动切换抽屉内容。\n        if (reopenOrderDetail && CURRENT_THREAD.order_id) {\n          openOrderDetail(CURRENT_THREAD.order_id, shopId);\n        }\n      }\n    });\n  } catch (e) {\n    $(\"readPane\").innerHTML = `<div class=\"empty\" style=\"color:var(--red)\">加载失败: ${escapeHtml(e.message)}</div>`;\n  }\n}\n\nfunction escapeHtml(s) {\n  return String(s || \"\").replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n}\n\nfunction escapeAttr(s) {\n  return escapeHtml(s).replace(/\"/g, \"&quot;\").replace(/'/g, \"&#39;\");\n}\n\nfunction selectReplyRecipients(participants, mode) {\n  const seen = new Set();\n  const normalized = (Array.isArray(participants) ? participants : [])\n    .map((participant) => ({\n      id: String(participant && (participant.id || participant.participant_id || participant.user_id || participant.customer_id || participant.operator_id) || \"\").trim(),\n      type: String(participant && (participant.type || participant.participant_type || participant.role) || \"\").trim(),\n    }))\n    .filter((participant) => {\n      // M10 的 OPERATOR 参与者可能没有 id；M12 允许仅用 type 指定平台收件人。\n      const isOperator = /OPERATOR/i.test(participant.type);\n      if (!participant.type || (!participant.id && !isOperator) || /^SHOP(?:_|$)/i.test(participant.type)) return false;\n      const key = `${participant.id}\\u0000${participant.type}`;\n      if (seen.has(key)) return false;\n      seen.add(key);\n      return true;\n    })\n    .map((participant) => participant.id ? participant : { type: participant.type });\n  const customers = normalized.filter((participant) => /(?:^|_)(?:CUSTOMER|BUYER|CLIENT)(?:_|$)/i.test(participant.type));\n  const operators = normalized.filter((participant) => /OPERATOR/i.test(participant.type));\n  if (mode === \"customer\") return customers;\n  if (mode === \"operator\") return operators;\n  if (mode === \"customer_operator\" && customers.length && operators.length) return [...customers, ...operators];\n  return [];\n}\n\nfunction preferredReplyRecipientMode(participants, hasOrder = false) {\n  if (selectReplyRecipients(participants, \"customer\").length) return \"customer\";\n  if (hasOrder) return \"customer\";\n  if (selectReplyRecipients(participants, \"operator\").length) return \"operator\";\n  return \"customer\";\n}\n\nfunction canResolveCustomerReplyFromOrder(thread, mode) {\n  return Boolean(thread && thread.order_id && (mode === \"customer\" || mode === \"customer_operator\"));\n}\n\nfunction replyRecipientError(mode) {\n  if (mode === \"operator\") return \"当前线程没有可用的操作员收件人\";\n  if (mode === \"customer_operator\") return \"当前线程缺少客户或操作员收件人\";\n  return \"当前线程没有可用的客户收件人\";\n}\n\nfunction syncReplyBatchControl(thread = CURRENT_THREAD) {\n  const input = $(\"replyBatchAll\");\n  if (!input) return;\n  const hasOrder = Boolean(thread && thread.order_key);\n  const pending = Boolean(thread && thread.needReply === true);\n  input.disabled = !hasOrder || !pending;\n  input.checked = hasOrder && pending;\n  const label = input.closest(\"label\");\n  if (label) {\n    label.title = hasOrder && pending\n      ? \"同一条回复内容将同时发送给此订单下的全部待回复站内信\"\n      : hasOrder\n        ? \"当前线程已不再待回复，本次只回复当前线程\"\n        : \"当前线程没有订单关联，本次只回复当前线程\";\n  }\n}\n\nfunction syncReplyRecipientMode() {\n  const mode = $(\"replyRecipientMode\")?.value || \"customer\";\n  if (!CURRENT_THREAD) return;\n  const recipients = selectReplyRecipients(CURRENT_THREAD.participants, mode);\n  const canResolveCustomer = canResolveCustomerReplyFromOrder(CURRENT_THREAD, mode);\n  CURRENT_THREAD.recipient_mode = mode;\n  CURRENT_THREAD.to = recipients;\n  const status = $(\"replyStatus\");\n  if (!status) return;\n  if (!recipients.length && !canResolveCustomer) {\n    status.textContent = replyRecipientError(mode);\n    status.className = \"status err\";\n  } else if (!recipients.length && canResolveCustomer) {\n    status.textContent = \"客户收件人将在发送时根据订单信息解析\";\n    status.className = \"status warn\";\n  } else if ((status.classList.contains(\"err\") || status.classList.contains(\"warn\")) && /收件人|订单信息解析/.test(status.textContent)) {\n    status.textContent = \"\";\n    status.className = \"status\";\n  }\n}\n\nfunction isValidAttachmentId(value) {\n  const id = String(value || \"\").trim();\n  return /^[A-Za-z0-9][A-Za-z0-9._:-]{0,239}$/.test(id);\n}\n\nfunction renderAttachmentSummary(attachments) {\n  const list = Array.isArray(attachments) ? attachments.filter(Boolean) : [];\n  if (!list.length) return \"\";\n  const names = list\n    .map((attachment) => String(attachment.file_name || attachment.filename || \"\").trim())\n    .filter(Boolean)\n    .slice(0, 4)\n    .map((name) => escapeHtml(name));\n  const count = list.length;\n  const nameText = names.length ? names.join(\"、\") : \"附件\";\n  const suffix = names.length < count ? ` 等 ${count} 个附件` : `（共 ${count} 个）`;\n  return `<span class=\"mtext-attachment-summary\" data-attachment-count=\"${count}\" data-has-attachments=\"true\">附件：${nameText}${suffix}</span>`;\n}\n\nfunction renderMessageBody(body, attachments) {\n  const text = String(body || \"\");\n  if (text.trim()) return escapeHtml(text);\n  const summary = renderAttachmentSummary(attachments);\n  return summary ? `<span class=\"mtext-empty\">(无文本内容)</span>${summary}` : \"(无文本内容)\";\n}\n\nfunction renderAttachmentLinks(attachments, shopId) {\n  const sid = String(shopId || \"\").trim();\n  if (!sid) return \"\";\n  const list = (Array.isArray(attachments) ? attachments : []).filter(Boolean);\n  const links = list.map((attachment) => {\n    const id = String(attachment && (attachment.attachment_id || attachment.id) || \"\").trim();\n    if (!isValidAttachmentId(id)) return \"\";\n    const href = `/api/inbox/attachment?shop_id=${encodeURIComponent(sid)}&attachment_id=${encodeURIComponent(id)}`;\n    const fileName = String(attachment && (attachment.file_name || attachment.filename) || \"下载附件\").trim() || \"下载附件\";\n    const contentType = String(attachment && (attachment.content_type || attachment.mime_type || \"\") || \"\").trim();\n    const rawSize = attachment && attachment.size;\n    const size = Number.isFinite(Number(rawSize)) && Number(rawSize) >= 0 ? String(Math.floor(Number(rawSize))) : \"\";\n    const label = escapeHtml(fileName);\n    // v26.90：draggable=\"false\" 与 .attachment-link 的 -webkit-user-drag:none 是同一件事的\n    // 标准写法 + Blink 写法，缺一个都会让「在附件名上拖选」退化成原生拖拽。\n    return `<a class=\"attachment-link\" data-attachment-id=\"${escapeAttr(id)}\" data-attachment-name=\"${escapeAttr(fileName)}\"${contentType ? ` data-attachment-content-type=\"${escapeAttr(contentType)}\"` : \"\"}${size ? ` data-attachment-size=\"${size}\"` : \"\"} href=\"${escapeAttr(href)}\" draggable=\"false\" download>${label}</a>`;\n  }).filter(Boolean).join(\"\");\n  return links ? `<div class=\"attachment-list\" data-attachment-count=\"${list.length}\" data-has-attachments=\"true\" aria-label=\"附件列表\">${links}</div>` : \"\";\n}\n\n// ---- 站内信 + 订单预加载缓存 ----\nfunction orderCacheKey(orderId) {\n  return String(orderId || \"\").trim().replace(/-[A-Z]$/, \"\");\n}\n\nfunction setInboxOrderCache(orders) {\n  INBOX_ORDER_MAP = new Map();\n  for (const order of Array.isArray(orders) ? orders : []) {\n    const id = String(order && order.order_id || \"\").trim();\n    if (!id) continue;\n    // 精确订单号优先，同时用去掉 -A/-B 的键兼容站内信实体返回的基础订单号。\n    if (!INBOX_ORDER_MAP.has(id)) INBOX_ORDER_MAP.set(id, order);\n    const base = orderCacheKey(id);\n    if (base && !INBOX_ORDER_MAP.has(base)) INBOX_ORDER_MAP.set(base, order);\n  }\n}\n\nfunction getInboxOrder(orderId) {\n  const id = String(orderId || \"\").trim();\n  if (!id) return null;\n  const exact = INBOX_ORDER_MAP.get(id);\n  if (exact) return exact;\n  // -A/-B 是可能不同的拆分订单；只有无后缀的站内信实体才允许\n  // 用基础订单号命中返回结果，避免把另一拆分订单的金额显示过来。\n  return /-[A-Z]$/.test(id) ? null : INBOX_ORDER_MAP.get(orderCacheKey(id)) || null;\n}\n\nfunction cacheInboxOrder(order) {\n  const id = String(order && order.order_id || \"\").trim();\n  if (!id) return null;\n  INBOX_ORDER_MAP.set(id, order);\n  const base = orderCacheKey(id);\n  if (base) INBOX_ORDER_MAP.set(base, order);\n  return order;\n}\n\n// 历史线程订单按需读取；同一订单的并发点击复用一个请求。\nasync function loadInboxOrder(orderId, shopId) {\n  const id = String(orderId || \"\").trim();\n  const sid = String(shopId || GLOBAL_SHOP || \"\").trim();\n  if (!id || !sid) return null;\n  const cached = getInboxOrder(id);\n  if (cached) return cached;\n  const key = `${sid}::${id}`;\n  const pending = INBOX_ORDER_REQUESTS.get(key);\n  if (pending) return pending;\n  const controller = new AbortController();\n  INBOX_ORDER_CONTROLLERS.set(key, controller);\n  const request = api(`/api/inbox/order?shop_id=${encodeURIComponent(sid)}&order_id=${encodeURIComponent(id)}`, { signal: controller.signal })\n    .then((data) => {\n      const order = cacheInboxOrder(data && data.order);\n      if (String(GLOBAL_SHOP) === sid) renderMailList();\n      return order;\n    })\n    .finally(() => {\n      INBOX_ORDER_REQUESTS.delete(key);\n      INBOX_ORDER_CONTROLLERS.delete(key);\n    });\n  INBOX_ORDER_REQUESTS.set(key, request);\n  return request;\n}\n\n// 若平台的批量 OR11 对某个订单返回空结果，后台预加载仍会尽力逐单补查。\n// 这里再做一次前端兜底，让待回复列表中的金额不会因为单个订单异常而永远空白。\nfunction ensurePendingOrderAmounts() {\n  const sid = String(GLOBAL_SHOP || \"\").trim();\n  if (!sid) return;\n  const missing = ALL_THREADS.filter((thread) =>\n    thread && thread.needReply && thread.order_id && !getInboxOrder(thread.order_id)\n  );\n  for (const thread of missing) {\n    const key = `${sid}::${String(thread.order_id).trim()}`;\n    if (INBOX_ORDER_FALLBACK_KEYS.has(key)) continue;\n    INBOX_ORDER_FALLBACK_KEYS.add(key);\n    loadInboxOrder(thread.order_id, sid).catch(() => {\n      // 本轮失败时允许下一次整点预加载重试；避免卡住其他订单金额。\n      INBOX_ORDER_FALLBACK_KEYS.delete(key);\n    });\n  }\n}\n\nfunction orderAmountClass(amount) {\n  const value = Number(amount);\n  if (!Number.isFinite(value) || value < 0) return \"unknown\";\n  if (value < 20) return \"tiny\";\n  if (value < 50) return \"low\";\n  if (value < 100) return \"mid\";\n  return \"high\";\n}\n\nfunction renderOrderAmount(order, options = {}) {\n  if (!order) return options.pending ? '<span class=\"mail-order-amount unknown\">金额待获取</span>' : \"\";\n  const amount = Number(order.total_price);\n  const currency = escapeHtml(order.currency_iso_code || \"EUR\");\n  if (!Number.isFinite(amount)) return `<span class=\"mail-order-amount unknown\">金额 —</span>`;\n  const formatted = amount.toLocaleString(\"zh-CN\", { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n  return `<span class=\"mail-order-amount ${orderAmountClass(amount)}\" title=\"订单金额\">${formatted} ${currency}</span>`;\n}\n\nfunction shortProblemText(value) {\n  return String(value || \"\").replace(/\\s+/g, \" \").trim().slice(0, 160);\n}\n\nfunction fourPxReturnsProblemPreview(value, maxLength = 32) {\n  const text = String(value || \"\").replace(/\\s+/g, \" \").trim();\n  if (!text) return \"\";\n  if (text.length <= maxLength) return text;\n  return text.slice(0, Math.max(0, maxLength - 1)) + \"…\";\n}\n\nfunction renderRefundBadge(order) {\n  if (!order) return \"\";\n  if (order.is_refunded === true) {\n    return '<span class=\"mail-refund-badge refunded\" title=\"订单已完成退款\">已退款</span>';\n  }\n  if (order.has_partial_refund === true) {\n    return '<span class=\"mail-refund-badge partial\" title=\"订单存在部分退款\">部分退款</span>';\n  }\n  return \"\";\n}\n\nfunction renderIncidentBadge(order) {\n  const lines = Array.isArray(order && order.order_lines) ? order.order_lines : [];\n  const active = !!(order && (order.has_incident || lines.some((line) =>\n    String(line && (line.order_line_state || line.state) || \"\").toUpperCase() === \"INCIDENT_OPEN\"\n      && line.incident_resolved !== true\n  )));\n  const evidence = !!(order && (order.incident_evidence || order.incident_resolved || order.has_incident || lines.some((line) =>\n    line && (line.incident_open || line.incident_resolved || String(line.order_line_state || line.state || \"\").toUpperCase() === \"INCIDENT_OPEN\")\n  )));\n  if (!evidence) return \"\";\n  return active\n    ? '<span class=\"mail-incident-badge\" title=\"订单存在进行中的事件\"><span class=\"mail-incident-dot\"></span>事件</span>'\n    : '<span class=\"mail-incident-badge resolved\" title=\"订单事件已解决\"><span class=\"mail-incident-dot\"></span>事件已解决</span>';\n}\n\nfunction renderOrderStatusBadges(order) {\n  return [renderIncidentBadge(order), renderRefundBadge(order)].filter(Boolean).join(\"\");\n}\n\nfunction formatOrderDate(value) {\n  if (!value) return \"—\";\n  const d = new Date(value);\n  return Number.isNaN(d.getTime()) ? String(value) : d.toLocaleString(\"zh-CN\");\n}\n\nfunction orderCustomerLabel(customer) {\n  if (!customer || typeof customer !== \"object\") return \"—\";\n  const name = [customer.firstname || customer.first_name, customer.lastname || customer.last_name].filter(Boolean).join(\" \");\n  return name || customer.email || customer.phone || customer.customer_id || customer.id || \"—\";\n}\n\nfunction orderAddressLabel(address) {\n  if (!address || typeof address !== \"object\") return \"—\";\n  const name = [address.firstname || address.first_name, address.lastname || address.last_name].filter(Boolean).join(\" \");\n  const street = [address.street || address.street_1, address.street_2 || address.address2].filter(Boolean).join(\" \");\n  const locality = [address.zip_code || address.zip, address.city, address.state || address.state_code, address.country || address.country_code].filter(Boolean).join(\" \");\n  return [name, address.company, street, locality, address.phone].filter(Boolean).join(\" · \") || \"—\";\n}\n\nfunction applyInboxBundle(bundle) {\n  if (!bundle) return null;\n  const sid = String(bundle && bundle.shop && bundle.shop.shop_id || GLOBAL_SHOP || \"\");\n  const shop = SHOPS.find((s) => String(s.shop_id) === sid);\n  const items = Array.isArray(bundle && bundle.threads) ? bundle.threads : [];\n  ALL_THREADS = items.map((t) => ({ ...t, shop_id: t.shop_id || sid, shop_name: (bundle.shop && bundle.shop.name) || (shop && shop.name) || \"当前店铺\" }));\n  const allowedOrderIds = visibleInboxOrderIds(items);\n  setInboxOrderCache((Array.isArray(bundle && bundle.orders) ? bundle.orders : [])\n    .filter((order) => allowedOrderIds.has(String(order && order.order_id || \"\").trim())));\n  INBOX_LOADED_SHOP = sid || null;\n  renderInboxTopicOptions();\n  const status = $(\"globalStatus\");\n  const activePage = document.querySelector(\".nav-item.active\")?.dataset.page;\n  if (status && activePage === \"inbox\") {\n    const suffix = bundle && bundle.truncated ? \" · 后台仍在载入历史线程\" : \"\";\n    const orderCount = Array.isArray(bundle && bundle.orders) ? bundle.orders.length : 0;\n    status.textContent = `${items.length} 封 · ${orderCount} 个订单（${(bundle && bundle.shop && bundle.shop.name) || (shop && shop.name) || \"当前店铺\"}）${suffix}`;\n    status.className = bundle && (bundle.truncated || bundle.order_error) ? \"status warn\" : \"status ok\";\n  }\n  renderMailList();\n  ensurePendingOrderAmounts();\n  if (activePage === \"dashboard\" && DASH_DATA && String(DASH_DATA.shop?.shop_id || \"\") === sid && typeof renderDashboardV24 === \"function\") {\n    renderDashboardV24();\n  }\n  return bundle;\n}\n\nasync function preloadInbox(shopId = GLOBAL_SHOP, options = {}) {\n  const sid = String(shopId || \"\").trim();\n  if (!sid) return null;\n  // 旧客户端兼容路由仍保留：`/api/inbox/list?shop_id=${s.shop_id}`；当前 UI 使用分阶段组合接口。\n  const force = !!(options && options.force);\n  const existing = INBOX_PRELOAD_CACHE.get(sid);\n  const now = Date.now();\n  if (!force && existing && existing.data && now - Number(existing.loadedAt || 0) < INBOX_PRELOAD_TTL) {\n    if (String(GLOBAL_SHOP) === sid) applyInboxBundle(existing.data);\n    return existing.data;\n  }\n  // 有旧数据时立即复用，并在后台启动新一轮第一页请求；不会因切换回站内信而重复阻塞。\n  if (existing && existing.data && !force) {\n    if (String(GLOBAL_SHOP) === sid) applyInboxBundle(existing.data);\n    const refresh = refreshInboxInBackground(sid, { force: true, awaitFirst: false });\n    refresh.catch(() => {});\n    return existing.data;\n  }\n  return refreshInboxInBackground(sid, { force: true, awaitFirst: options.awaitFirst !== false });\n}\n\nfunction startInboxPreloadTimer() {\n  if (INBOX_PRELOAD_TIMER_STARTED) return;\n  INBOX_PRELOAD_TIMER_STARTED = true;\n  // 每分钟只检查一次时间戳，真正超过一小时才发起后台刷新；切页不会触发请求。\n  setInterval(() => {\n    const sid = String(GLOBAL_SHOP || \"\").trim();\n    if (!sid) return;\n    const entry = INBOX_PRELOAD_CACHE.get(sid);\n    if (entry && entry.promise) return;\n    if (entry && entry.data && Date.now() - Number(entry.loadedAt || 0) < INBOX_PRELOAD_TTL) return;\n    refreshInboxInBackground(sid, { force: true, awaitFirst: false }).catch(() => {});\n  }, 60 * 1000);\n}\n\n// ---- ITGOAL ERP 履约状态（只读联查，v26.57）----\n// 按订单号从本地 GET /api/itgoal/order 取 ERP 侧履约信息，嵌进「订单详情」抽屉与「快捷退款」弹窗。\n// 纯只读：只发 GET，不触发任何 ERP / Mirakl 写操作；成功结果按订单号在页面内缓存，同一单不重复请求。\n// 字段口径（2026-09-13 实测，与 harness/API.md 第 14 条一致）：\n//   平台SKU = items[].sku（带店铺前缀，与 Mirakl offer_sku 同值）\n//   商品SKU = items[].proCode（ERP 配对后的商品编码）\n// 两条必须并列展示——不能用商品SKU 替换平台SKU，那会让客服看不到自己在平台上卖的那个货号。\nconst ERP_FULFILL_CACHE = new Map();\nconst ERP_FULFILL_INFLIGHT = new Map();\n\nfunction erpFulfillmentHost(root) {\n  if (!root) return null;\n  if (root.classList && root.classList.contains(\"erp-fulfill\")) return root;\n  return root.querySelector(\".erp-fulfill\");\n}\n\nasync function fetchErpFulfillment(orderId, options = {}) {\n  const id = String(orderId || \"\").trim();\n  if (!id) return null;\n  if (!options.refresh && ERP_FULFILL_CACHE.has(id)) return ERP_FULFILL_CACHE.get(id);\n  if (ERP_FULFILL_INFLIGHT.has(id)) return ERP_FULFILL_INFLIGHT.get(id);\n  const promise = api(`/api/itgoal/order?order_id=${encodeURIComponent(id)}${options.refresh ? \"&refresh=1\" : \"\"}`)\n    .then((data) => {\n      ERP_FULFILL_INFLIGHT.delete(id);\n      if (data && data.configured !== false && data.ok) ERP_FULFILL_CACHE.set(id, data);\n      return data;\n    })\n    .catch((error) => {\n      ERP_FULFILL_INFLIGHT.delete(id);\n      throw error;\n    });\n  ERP_FULFILL_INFLIGHT.set(id, promise);\n  return promise;\n}\n\n/**\n * 预热某单的 ERP 履约信息（fire-and-forget）。**调用时机由 scheduleErpPrefetch 决定**：\n * 必须等站内信内容上屏之后再跑，见那边的注释。\n *\n * 为什么要预热：ERP 查询是「读本机浏览器里保存的密码 → 换 JWT → 打 ERP 接口」这条链路，\n * 冷启动一次要 5~6 秒。等用户点开「订单详情」才开始拉，卡片就得先空转几秒。\n * 这里复用 fetchErpFulfillment 的缓存 + 并发去重（ERP_FULFILL_INFLIGHT），\n * 所以预热与后续正式加载**不会重复请求**；失败也吞掉 —— 用户还没打开详情，\n * 不该这时候弹错误，真正的错误交给卡片自己报。\n */\nfunction prefetchErpFulfillment(orderId) {\n  const id = String(orderId || \"\").trim();\n  if (!id) return;\n  if (ERP_FULFILL_CACHE.has(id) || ERP_FULFILL_INFLIGHT.has(id)) return;\n  fetchErpFulfillment(id).catch(() => {});\n}\n\n// v26.61 串行预热队列 ---------------------------------------------------------\n// 背景：打开站内信时会同时拉「线程详情」与「订单详情」，而 ERP 履约预热在冷启动时\n// 要在服务端走一遍「读浏览器登录库 → DPAPI 解主密钥 → 换 JWT」。三者并发时，\n// 用户看到的「点开站内信 → 内容出现」会被 ERP 预热拖慢。\n// 处理：预热一律延后到「内容已上屏 + 主线程空闲」再跑，并且同一时刻只跑一个 ——\n// 预热本来就是后台准备，不该和用户正在等的内容抢资源。\nconst ERP_PREFETCH_QUEUE = [];\nlet ERP_PREFETCH_RUNNING = false;\n\nfunction drainErpPrefetchQueue() {\n  if (ERP_PREFETCH_RUNNING) return;\n  const id = ERP_PREFETCH_QUEUE.shift();\n  if (!id) return;\n  ERP_PREFETCH_RUNNING = true;\n  const run = () => {\n    prefetchErpFulfillment(id);\n    // fetchErpFulfillment 是 fire-and-forget；握住它这一轮的 promise，\n    // 落地（命中缓存或失败）后再放行下一个，保证串行。\n    const inflight = ERP_FULFILL_INFLIGHT.get(id);\n    const done = () => {\n      ERP_PREFETCH_RUNNING = false;\n      drainErpPrefetchQueue();\n    };\n    if (inflight) inflight.then(done, done);\n    else done();\n  };\n  if (typeof requestIdleCallback === \"function\") requestIdleCallback(run, { timeout: 1200 });\n  else setTimeout(run, 0);\n}\n\nfunction scheduleErpPrefetch(orderId) {\n  const id = String(orderId || \"\").trim();\n  if (!id) return;\n  if (ERP_FULFILL_CACHE.has(id) || ERP_FULFILL_INFLIGHT.has(id)) return;\n  if (ERP_PREFETCH_QUEUE.includes(id)) return;\n  ERP_PREFETCH_QUEUE.push(id);\n  drainErpPrefetchQueue();\n}\n\n// ERP 登录态类错误码：这些不是「读取失败」，而是「本机还没登录过 ERP」。\n// 分发场景下首次使用必然遇到 —— 必须给出可执行的下一步，而不是显示成故障。\nconst ERP_AUTH_ERROR_CODES = new Set([\n  \"no_browser\", \"no_credential\", \"dpapi_failed\", \"sqlite_unavailable\",\n  \"token_missing\", \"token_expired\", \"login_failed\", \"token_short\",\n  // v26.77：这两种「存了但读不了」过去被合并进 no_credential，\n  // 害得使用者反复去浏览器重新登录保存（无效功）。现在单独成码、单独提示。\n  \"app_bound_encryption\", \"credential_undecryptable\",\n]);\n\nfunction erpAuthHint(payload) {\n  const code = String((payload && payload.error_code) || \"\");\n  if (code === \"no_browser\") {\n    return \"本机没有找到 Edge / Chrome 的用户数据目录。请先用 Edge 或 Chrome 登录一次 itgoal。\";\n  }\n  if (code === \"no_credential\") {\n    return \"本机浏览器里没有保存 itgoal 的登录密码。请在 Edge 或 Chrome 里登录一次 itgoal，并在提示时选择「保存密码」，然后点重试。\";\n  }\n  // ⚠️ 这两条必须和上面那条分开：它们的下一步动作是「填账号」，而不是「再去浏览器登录一次」。\n  if (code === \"app_bound_encryption\") {\n    return \"浏览器里确实存了 itgoal 密码，但浏览器新版把它改成了 App-Bound 加密，工作台读不出来 —— 再去浏览器重新登录、重新保存也没有用。请在下面填一次 ERP 账号，之后就不再依赖浏览器。\";\n  }\n  if (code === \"credential_undecryptable\") {\n    return \"读到 itgoal 登录记录，但一条都解不开（浏览器可能换了加密方式）。请在下面填一次 ERP 账号，直接绕开浏览器。\";\n  }\n  if (code === \"sqlite_unavailable\" || code === \"dpapi_failed\") {\n    return \"读取本机浏览器登录态失败（多半是浏览器文件被占用，或浏览器换了加密方式）。请先完全关闭浏览器再点重试。\";\n  }\n  if (code === \"token_expired\" || code === \"token_short\") {\n    return \"ERP 登录态过期，服务端会自动重登；若反复失败，请核对已保存的 ERP 账号与密码。\";\n  }\n  if (code === \"login_failed\") {\n    // 把服务端给出的具体原因带出来（多半是「密码错误」）—— 这一句决定了用户下一步是重填还是干等。\n    const raw = String((payload && payload.message) || \"\").trim();\n    const brief = raw.length > 160 ? `${raw.slice(0, 160)}…` : raw;\n    return `已保存的 ERP 账号没能登录成功${brief ? `：${brief}` : \"\"}。请点「重新填写 ERP 账号」核对账号与密码。`;\n  }\n  return \"请在本机 Edge 或 Chrome 里登录一次 itgoal（并保存密码），或在下面填一次 ERP 账号，然后点重试。\";\n}\n\nfunction erpFulfillChip(payload) {\n  if (!payload) return { cls: \"muted\", text: \"读取中…\" };\n  if (payload.configured === false) return { cls: \"muted\", text: \"未接入\" };\n  if (!payload.ok) {\n    const code = String(payload.error_code || \"\");\n    if (code === \"token_expired\") return { cls: \"alert\", text: \"登录态过期\" };\n    if (ERP_AUTH_ERROR_CODES.has(code)) return { cls: \"warn\", text: \"未登录 ERP\" };\n    return { cls: \"alert\", text: \"读取失败\" };\n  }\n  if (!payload.found) return { cls: \"muted\", text: \"ERP 无此单\" };\n  const erp = payload.erp || {};\n  const logistics = erp.logistics || {};\n  const operate = String((erp.operate_status || {}).name || \"\").trim();\n  if (erp.failed_reason) return { cls: \"alert\", text: `有卡点${operate ? \" · \" + operate : \"\"}` };\n  // ⚠️ v26.72：`is_shipped` 的判据已改为「ERP 订单状态 ∈ {5 已发货, 6 完成}」。\n  //    旧判据是「有运单号」，于是「运单已申请、仓库还在拣货」的单会被标成绿色「已发货」——\n  //    而这一格是退款判断的依据，误报会让人以为货已经出去了。\n  //    未发货时一律把 ERP 操作状态带出来（待拣货 / 申请运单 / 处理中…），说清卡在哪一步。\n  if (!logistics.is_shipped) return { cls: \"warn\", text: `未发货${operate ? \" · \" + operate : \"\"}` };\n  return { cls: \"ok\", text: \"已发货\" };\n}\n\nfunction erpCell(label, value, cls) {\n  const empty = value === null || value === undefined || value === \"\";\n  return `<div class=\"erp-cell\"><div class=\"k\">${escapeHtml(label)}</div>`\n    + `<div class=\"v${cls ? \" \" + cls : \"\"}\">${escapeHtml(empty ? \"—\" : String(value))}</div></div>`;\n}\n\n/**\n * 「物流号」单元格：有单号时渲染成可点按钮，点开是轨迹浮窗。\n * 渠道与订单号一并带上 —— 浮窗首次打开就能自己决定走哪条链路，不必再多回查一次。\n */\nfunction trackingCell(trackingNum, channel, orderId) {\n  const num = String(trackingNum === null || trackingNum === undefined ? \"\" : trackingNum).trim();\n  if (!num) return erpCell(\"物流号\", \"无运单号\", \"muted\");\n  const ch = String(channel === null || channel === undefined ? \"\" : channel).trim();\n  const id = String(orderId === null || orderId === undefined ? \"\" : orderId).trim();\n  return '<div class=\"erp-cell\"><div class=\"k\">物流号</div><div class=\"v good\">'\n    + `<button type=\"button\" class=\"track-link\" data-track-num=\"${escapeAttr(num)}\"`\n    + ` data-track-channel=\"${escapeAttr(ch)}\" data-track-order=\"${escapeAttr(id)}\"`\n    + ' title=\"点击查看物流轨迹\">'\n    + `<span>${escapeHtml(num)}</span><span class=\"track-ico\">轨迹</span>`\n    + \"</button></div></div>\";\n}\n\n// ---- 订单拦截（**写操作**）---------------------------------------------------\n// v26.74 上线第 1 条（捎客海外仓），v26.75 补第 2、3 条（递四方 / 东莞凤岗仓）。\n// 三条链路各有独立判据，一个订单只走其中一条（互斥顺序见 interceptMode）：\n//   ① shaoke       ERP 操作状态=待拣货  且 渠道以 [捎客海外仓]debuycn 开头\n//                  → 捎客 WMS 取消订单 + ERP 退回「处理中」\n//   ② fourpx       ERP 操作状态=已处理/已发货  且 渠道走递四方\n//                  → 向递四方提交「申请拦截」（拦截标记置为 Y；参数名不进前端，走后端路由）\n//   ③ move_to_ship ERP 仓库=东莞凤岗仓  且 操作状态=处理中/拣货中\n//                  → ERP「移入已发货」（⚠️ 不可逆）\n// ⚠️ 这份判据**只决定「要不要显示按钮」**。真正的放行由服务端基于现场实查再判一次 ——\n//    前端缓存里的状态可能已经过期（比如别处刚把这单处理掉了），不能当作执行依据。\nconst INTERCEPT_CHANNEL_PREFIX = \"[捎客海外仓]debuycn\";\n// 以下三条与服务端 itgoal-shipped-intercept.js 的同名常量**必须逐字同口径**。\nconst FOURPX_CHANNEL_KEYWORDS = [\"递四方\", \"联邮通\", \"4px\", \"fpx\"];\nconst FOURPX_OPERATE_CODES = [\"4\", \"5\"];            // 已处理 / 已发货\nconst FOURPX_OPERATE_NAME_PREFIXES = [\"已处理\", \"已发货\"];\nconst MOVE_TO_SHIP_OPERATE_CODES = [\"1\", \"3\"];      // 处理中 / 待拣货（用户口语「拣货中」= 3）\nconst MOVE_TO_SHIP_OPERATE_NAME_PREFIXES = [\"处理中\", \"待拣货\", \"拣货中\"];\nconst FENGGANG_WAREHOUSE_KEYWORD = \"东莞凤岗\";\nconst FENGGANG_WAREHOUSE_ID = \"129\";\n// 拦截结论按订单号留痕：操作完成后卡片会整体重绘成新状态（按钮随之消失），\n// 把结论挂在卡片外面渲染，才不会连结论一起被刷新掉。\nconst INTERCEPT_RESULT = new Map();\nlet INTERCEPT_RUNNING = false;\n\n/** 渠道名是否走递四方（与 fourpx-track.js 的 isFourPxChannel 同口径）。 */\nfunction isFourPxChannelText(channel) {\n  const text = String(channel || \"\").toLowerCase();\n  if (!text) return false;\n  return FOURPX_CHANNEL_KEYWORDS.some((keyword) => text.includes(String(keyword).toLowerCase()));\n}\n\n/** 操作状态是否落在允许集合：code 优先，code 缺失时才看 name（前缀匹配，兼容「待拣货 (无货)」这类后缀）。 */\nfunction operateMatches(operate, codes, namePrefixes) {\n  const code = String((operate || {}).code || \"\").trim();\n  if (code) return codes.includes(code);\n  const name = String((operate || {}).name || \"\").trim();\n  if (!name) return false;\n  return namePrefixes.some((prefix) => name.startsWith(prefix));\n}\n\n/**\n * 该单走哪条拦截链路：`\"shaoke\"` / `\"fourpx\"` / `\"move_to_ship\"`；都不满足返回 \"\"。\n * 顺序即互斥优先级：条件越具体的越靠前，避免同一单同时冒出两个按钮。\n */\nfunction interceptMode(erp) {\n  if (!erp || typeof erp !== \"object\") return \"\";\n  const operate = erp.operate_status || {};\n  const channel = String((erp.logistics || {}).channel || \"\").trim();\n  const warehouse = erp.warehouse || {};\n  const orderStatus = String((erp.order_status || {}).code || \"\").trim();\n\n  // ① 捎客海外仓：已发货/完成的单货都出去了，按渠道匹配也不该给拦截入口。\n  if (orderStatus !== \"5\" && orderStatus !== \"6\"\n    && operateMatches(operate, [\"3\"], [\"待拣货\"])\n    && channel.startsWith(INTERCEPT_CHANNEL_PREFIX)) {\n    return \"shaoke\";\n  }\n  // ② 递四方：只看操作状态与渠道（这里**不排除** orderStatus 5/6 ——\n  //    「操作状态=已发货」正是本链路的适用场景，排掉就永远出不来按钮了）。\n  if (operateMatches(operate, FOURPX_OPERATE_CODES, FOURPX_OPERATE_NAME_PREFIXES)\n    && isFourPxChannelText(channel)) {\n    return \"fourpx\";\n  }\n  // ③ 东莞凤岗仓：仓库名含关键词，或仓库 ID 命中（两者任一即可）。\n  const warehouseName = String(warehouse.name || \"\").trim();\n  const isFenggang = (warehouseName && warehouseName.includes(FENGGANG_WAREHOUSE_KEYWORD))\n    || String(warehouse.id || \"\").trim() === FENGGANG_WAREHOUSE_ID;\n  if (isFenggang\n    && operateMatches(operate, MOVE_TO_SHIP_OPERATE_CODES, MOVE_TO_SHIP_OPERATE_NAME_PREFIXES)) {\n    return \"move_to_ship\";\n  }\n  return \"\";\n}\n\n/** 三条链路的按钮文案与说明。`danger` 为真时整条用警示色（不可逆操作）。 */\nconst INTERCEPT_MODE_CONF = {\n  shaoke: {\n    title: \"可拦截\",\n    desc: \"该单已推给捎客海外仓且还在拣货队列：拦截＝取消 WMS 订单 + ERP 退回「处理中」（会清空物流渠道与运单号）\",\n    btn: \"拦截\",\n    danger: false,\n  },\n  fourpx: {\n    title: \"可拦截 · 递四方\",\n    desc: \"货已交给递四方：拦截＝向递四方提交「申请拦截」，能否拦住由递四方按包裹当前状态判定并返回结果\",\n    btn: \"拦截（递四方）\",\n    danger: false,\n  },\n  move_to_ship: {\n    title: \"可拦截 · 东莞凤岗仓\",\n    desc: \"货还在东莞凤岗仓：拦截＝在 ERP 把该单「移入已发货」。⚠️ 此操作不可逆，执行前请确认\",\n    btn: \"拦截（移入已发货）\",\n    danger: true,\n  },\n};\nconst INTERCEPT_ROUTES = {\n  shaoke: \"/api/itgoal/intercept\",\n  fourpx: \"/api/itgoal/intercept-fourpx\",\n  move_to_ship: \"/api/itgoal/intercept-move-to-ship\",\n};\n\nfunction interceptBarHtml(orderId, erp) {\n  const mode = interceptMode(erp);\n  if (!mode) return \"\";\n  const conf = INTERCEPT_MODE_CONF[mode] || INTERCEPT_MODE_CONF.shaoke;\n  return '<div class=\"erp-intercept' + (conf.danger ? \" danger\" : \"\") + '\"'\n    + ' data-erp-intercept data-erp-intercept-mode=\"' + escapeHtml(mode) + '\">'\n    + '<div class=\"txt\"><b>' + escapeHtml(conf.title) + \"</b> · \" + escapeHtml(conf.desc) + \"</div>\"\n    + '<button type=\"button\" class=\"erp-intercept-btn\" data-erp-intercept-run>'\n    + escapeHtml(conf.btn) + \"</button>\"\n    + \"</div>\";\n}\n\nfunction interceptResultHtml(orderId) {\n  const hit = INTERCEPT_RESULT.get(String(orderId || \"\").trim());\n  if (!hit) return \"\";\n  return '<div class=\"erp-intercept\"><div class=\"erp-intercept-msg'\n    + (hit.ok ? \" ok\" : \" bad\") + '\">'\n    + `${hit.ok ? \"✅ \" : \"⚠️ 拦截未完成：\"}${escapeHtml(hit.message)}</div></div>`;\n}\n\n/**\n * 执行拦截。**不可逆**：WMS 取消没有 dry-run、也没有撤销接口，\n * 所以二次确认框里把两个动作、以及「会清空物流渠道与运单号」都写清楚。\n */\nasync function runOrderIntercept(btn) {\n  const host = btn.closest(\".erp-fulfill\");\n  const orderId = host ? String(host.dataset.erpOrder || \"\").trim() : \"\";\n  if (!orderId || INTERCEPT_RUNNING) return;\n  const bar = btn.closest(\"[data-erp-intercept]\");\n  const mode = String((bar && bar.dataset.erpInterceptMode) || \"shaoke\").trim();\n  const payload = ERP_FULFILL_CACHE.get(orderId) || null;\n  const erp = (payload && payload.erp) || {};\n  const logistics = erp.logistics || {};\n  const warehouse = erp.warehouse || {};\n  const operate = erp.operate_status || {};\n  const head = `订单：${orderId}\\n`\n    + `系统单号：${erp.system_order_num || \"—\"}\\n`;\n  // 每条链路的确认文案必须写清「会发生什么」与「能不能撤销」——move_to_ship 不可逆，措辞不能含糊。\n  const CONFIRM_TEXT = {\n    shaoke: `确认拦截该订单？\\n\\n${head}`\n      + `物流渠道：${logistics.channel || logistics.method || \"—\"}\\n\\n`\n      + \"将依次：\\n\"\n      + \"① 调捎客 WMS 取消该订单（不可撤销）\\n\"\n      + \"② 在 ERP 把订单从「拣货」退回「处理中」，并清空物流渠道与运单号\\n\\n\"\n      + \"此操作不可撤销！\",\n    fourpx: `确认向递四方申请拦截该订单？\\n\\n${head}`\n      + `物流渠道：${logistics.channel || logistics.method || \"—\"}\\n`\n      + `操作状态：${operate.name || operate.code || \"—\"}\\n\\n`\n      + \"将：向递四方提交「申请拦截」（原因：取消订单）\\n\"\n      + \"能否拦住由递四方按包裹当前状态判定（已截获、非预测状态等会被拒），结果原样返回。\",\n    move_to_ship: `⚠️ 确认拦截该订单？此操作不可逆！\\n\\n${head}`\n      + `ERP 仓库：${warehouse.name || warehouse.id || \"—\"}\\n`\n      + `操作状态：${operate.name || operate.code || \"—\"}\\n\\n`\n      + \"将：在 ERP 对该单执行「移入已发货」\\n\\n\"\n      + \"⚠️ 这是最终状态，没有撤销接口、无法回退。\\n\"\n      + \"请确认货确实已发出、或已决定不再发出，再继续。\",\n  };\n  const proceed = confirm(CONFIRM_TEXT[mode] || CONFIRM_TEXT.shaoke);\n  if (!proceed) return;\n\n  INTERCEPT_RUNNING = true;\n  btn.disabled = true;\n  const original = btn.textContent;\n  btn.textContent = \"拦截中…\";\n  if (bar) bar.classList.add(\"busy\");\n  try {\n    const res = await fetch(INTERCEPT_ROUTES[mode] || INTERCEPT_ROUTES.shaoke, {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ order_id: orderId }),\n    });\n    const data = await res.json().catch(() => ({}));\n    const ok = Boolean(data.ok);\n    INTERCEPT_RESULT.set(orderId, {\n      ok,\n      message: String(data.message || data.error || (ok ? \"已拦截\" : \"拦截失败\")),\n      at: Date.now(),\n    });\n  } catch (error) {\n    INTERCEPT_RESULT.set(orderId, {\n      ok: false,\n      message: `拦截请求失败：${(error && error.message) || error}`,\n      at: Date.now(),\n    });\n  } finally {\n    INTERCEPT_RUNNING = false;\n    btn.disabled = false;\n    btn.textContent = original;\n    if (bar) bar.classList.remove(\"busy\");\n    // 无论成功失败都重拉一次：成功时状态已变成「处理中」，失败时也让用户看到上游最新状态。\n    if (host) loadErpFulfillment(host, orderId, { refresh: true });\n  }\n}\n\nfunction renderErpFulfillmentBody(payload, orderId) {\n  if (!payload) return '<div class=\"erp-note\">正在读取 ERP 履约状态…</div>';\n  if (payload.configured === false) {\n    return `<div class=\"erp-note\">未接入 ERP 联查：${escapeHtml(payload.message || \"缺少 itgoal.config.json\")}</div>`;\n  }\n  if (!payload.ok) {\n    const code = String(payload.error_code || \"\");\n    const authIssue = ERP_AUTH_ERROR_CODES.has(code);\n    // 原始 message 只放进 title 供排障悬停查看 —— 不让路径/内部错误码占据主视线。\n    const title = authIssue ? \"未登录 ERP\" : \"读取失败\";\n    const raw = String(payload.message || \"\").trim();\n    // v26.77：服务端在认证类失败时会带上「本机有没有存过 ERP 凭据」，\n    // 据此把文案与按钮在「填一次」和「重填（多半是密码改了）」之间切换 —— 两种下一步动作不同。\n    const credential = payload.credential || null;\n    const configured = Boolean(credential && credential.configured);\n    const credButton = authIssue\n      ? `<button type=\"button\" class=\"erp-cred-open\" data-erp-cred-open>${configured ? \"重新填写 ERP 账号\" : \"填写 ERP 账号\"}</button>`\n      : \"\";\n    const credHint = configured && authIssue\n      ? `<br>已保存账号 ${escapeHtml(credential.identity_masked || \"（已隐藏）\")}，可直接点重试；若 ERP 密码改过，请重新填写。`\n      : \"\";\n    return `<div class=\"erp-note${authIssue ? \"\" : \" err\"}\"${raw ? ` title=\"${escapeHtml(raw)}\"` : \"\"}>`\n      + `${escapeHtml(title)}<br>${escapeHtml(erpAuthHint(payload))}${credHint}`\n      + '<button type=\"button\" class=\"erp-retry\" data-erp-retry>重试</button>'\n      + credButton + \"</div>\"\n      + (authIssue ? erpCredentialFormHtml(credential) : \"\");\n  }\n  if (!payload.found) {\n    return `<div class=\"erp-note\">${escapeHtml(payload.message || \"ERP 侧没有该订单\")}`\n      + \"<br>该订单可能还没同步到 ERP，或不由 ERP 履约。</div>\";\n  }\n  const erp = payload.erp || {};\n  const orderStatus = (erp.order_status || {});\n  const operateStatus = (erp.operate_status || {});\n  const logistics = erp.logistics || {};\n  const items = Array.isArray(erp.items) ? erp.items : [];\n  const skuRows = items.map((item) => `<tr>\n      <td class=\"sku platform\">${escapeHtml(item.platform_sku || \"—\")}</td>\n      <td class=\"sku product\">${escapeHtml(item.product_sku || \"—\")}</td>\n      <td class=\"num\">${escapeHtml(String(Number(item.quantity) || 0))}</td>\n      <td class=\"num\">${escapeHtml(item.price || \"—\")} ${escapeHtml(item.currency || \"\")}</td>\n    </tr>`).join(\"\");\n  const skuTable = items.length\n    ? `<table class=\"erp-skus\"><thead><tr><th>平台SKU</th><th>商品SKU</th><th class=\"num\">数量</th><th class=\"num\">金额</th></tr></thead><tbody>${skuRows}</tbody></table>`\n    : \"\";\n  // 底部那行「仓库 / 承运人 / 物流方式 / 最晚送达」已按用户要求整行删除（v26.59）：\n  //   仓库与承运人的信息本就已经体现在「物流渠道」里（形如 `[捎客海外仓]debuycn - DHL优先包(北威一号仓)`），\n  //   再单列一行纯属重复；真正要留的只有「系统单号」，而且它应该最显眼 —— 于是提到卡片最上方加粗。\n  const systemOrderNum = String(erp.system_order_num || \"\").trim();\n  return `\n    <div class=\"erp-sysno\">\n      <span class=\"k\">系统单号</span>\n      <strong class=\"v\">${escapeHtml(systemOrderNum || \"—\")}</strong>\n    </div>\n    <div class=\"erp-grid\">\n      ${erpCell(\"订单状态\", orderStatus.name || orderStatus.code)}\n      ${erpCell(\"操作状态\", operateStatus.name || operateStatus.code)}\n      ${erpCell(\"物流渠道\", logistics.channel || logistics.method)}\n      ${trackingCell(logistics.tracking_num, logistics.channel || logistics.method, orderId)}\n    </div>\n    ${skuTable}\n    ${interceptBarHtml(orderId, erp)}\n    ${interceptResultHtml(orderId)}\n    ${erp.failed_reason ? `<div class=\"erp-alert\">履约卡点：${escapeHtml(erp.failed_reason)}</div>` : \"\"}`;\n}\n\n/**\n * ERP 账号录入表单（v26.77，默认收起）。\n *\n * ⛔ 安全边界（改动前务必先读）：\n *   - 密码走 `type=\"password\"`，**任何时候都不写进 title / data-* / placeholder 之外的属性**；\n *   - 提交后立刻清空输入框，不让明文留在 DOM 里；\n *   - 说明文字必须如实讲清「存在哪、谁能解开」，否则和骗用户没区别。\n */\nfunction erpCredentialFormHtml(credential) {\n  const configured = Boolean(credential && credential.configured);\n  return '<div class=\"erp-cred-form\" data-erp-cred-form hidden>'\n    + '<div class=\"erp-cred-row\">'\n    + '<label class=\"erp-cred-field\"><span>ERP 账号（手机号 / 邮箱）</span>'\n    + '<input type=\"text\" data-erp-cred-identify autocomplete=\"username\" spellcheck=\"false\" placeholder=\"登录 itgoal 用的账号\"></label>'\n    + '<label class=\"erp-cred-field\"><span>ERP 密码</span>'\n    + '<input type=\"password\" data-erp-cred-password autocomplete=\"current-password\" placeholder=\"只保存在本机\"></label>'\n    + \"</div>\"\n    + '<div class=\"erp-cred-actions\">'\n    + '<button type=\"button\" class=\"erp-cred-btn primary\" data-erp-cred-save>保存并验证</button>'\n    + '<button type=\"button\" class=\"erp-cred-btn\" data-erp-cred-cancel>取消</button>'\n    + (configured ? '<button type=\"button\" class=\"erp-cred-btn\" data-erp-cred-clear>清除已保存的账号</button>' : \"\")\n    + \"</div>\"\n    + '<div class=\"erp-cred-note\" data-erp-cred-note>'\n    + \"密码用 Windows DPAPI 加密后只存在本机，绑定当前 Windows 账户（文件拷到别的电脑也解不开）；\"\n    + \"不上传、不写日志、不以明文落盘，只用于换 ERP 登录态。\"\n    + \"</div></div>\";\n}\n\nfunction erpCredNote(form, text, tone) {\n  const note = form && form.querySelector(\"[data-erp-cred-note]\");\n  if (!note) return;\n  note.textContent = text;\n  note.className = `erp-cred-note${tone ? \" \" + tone : \"\"}`;\n}\n\n/** 保存凭据并立刻验证登录；成功则自动重拉本单履约状态。 */\nasync function saveErpCredential(host) {\n  const form = host && host.querySelector(\"[data-erp-cred-form]\");\n  if (!form) return;\n  const identifyEl = form.querySelector(\"[data-erp-cred-identify]\");\n  const passwordEl = form.querySelector(\"[data-erp-cred-password]\");\n  const saveBtn = form.querySelector(\"[data-erp-cred-save]\");\n  const identify = String((identifyEl && identifyEl.value) || \"\").trim();\n  const password = String((passwordEl && passwordEl.value) || \"\");\n  const clearPassword = () => { if (passwordEl) passwordEl.value = \"\"; };\n\n  if (!identify || !password) {\n    erpCredNote(form, \"请把 ERP 账号与密码都填上。\", \"err\");\n    return;\n  }\n  if (saveBtn) { saveBtn.disabled = true; saveBtn.textContent = \"保存中…\"; }\n  erpCredNote(form, \"正在加密保存并验证登录…\", \"\");\n  try {\n    const res = await api(\"/api/itgoal/credential\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ identify, password }),\n    });\n    clearPassword();\n    if (!res || !res.ok) {\n      erpCredNote(form, (res && res.message) || \"保存失败\", \"err\");\n      return;\n    }\n    if (res.verified) {\n      erpCredNote(form, `已保存账号 ${res.identity_masked || \"\"}，ERP 登录验证通过。`, \"ok\");\n      if (identifyEl) identifyEl.value = \"\";\n      await loadErpFulfillment(host, host.dataset.erpOrder, { refresh: true });\n      return;\n    }\n    erpCredNote(\n      form,\n      `账号已保存${res.identity_masked ? \"（\" + res.identity_masked + \"）\" : \"\"}，但登录没通过：`\n        + `${res.verified_error || \"请核对账号与密码后再保存一次\"}`,\n      \"err\",\n    );\n  } catch (error) {\n    // api() 对非 2xx 会抛 —— 但错误体里的 message 更有用，这里统一走文本。\n    clearPassword();\n    erpCredNote(form, `保存失败：${(error && error.message) || error}`, \"err\");\n  } finally {\n    const btn = form.querySelector(\"[data-erp-cred-save]\");\n    if (btn) { btn.disabled = false; btn.textContent = \"保存并验证\"; }\n  }\n}\n\n/** 清除本机凭据（回到浏览器链路）。破坏性但可逆（重填即可），仍给一次确认。 */\nasync function clearErpCredential(host) {\n  const form = host && host.querySelector(\"[data-erp-cred-form]\");\n  if (!window.confirm(\"清除本机保存的 ERP 账号？清除后工作台会回到「读浏览器密码」的方式，而浏览器新保存的密码本工具已经读不出来了。\")) return;\n  try {\n    await api(\"/api/itgoal/credential\", { method: \"DELETE\" });\n    if (form) erpCredNote(form, \"已清除。\", \"\");\n  } catch (error) {\n    if (form) erpCredNote(form, `清除失败：${(error && error.message) || error}`, \"err\");\n    return;\n  }\n  await loadErpFulfillment(host, host.dataset.erpOrder, { refresh: true });\n}\n\n/** 生成卡片骨架。payload 传 null 时是「读取中」态，随后由 loadErpFulfillment 填充。 */\nfunction renderErpFulfillmentSection(payload, orderId) {\n  const chip = erpFulfillChip(payload);\n  const id = String(orderId || \"\").trim();\n  const cached = Boolean(payload && payload.cached);\n  return `<section class=\"erp-fulfill\" data-erp-order=\"${escapeAttr(id)}\">`\n    + '<div class=\"erp-fulfill-head\">'\n    + \"<h3>ERP 履约状态</h3>\"\n    + `<span class=\"erp-chip ${chip.cls}\" data-erp-chip>${escapeHtml(chip.text)}</span>`\n    + `<span class=\"erp-cached\" data-erp-cached${cached ? \"\" : \" hidden\"}>本地缓存</span>`\n    + '<button type=\"button\" class=\"erp-refresh\" data-erp-refresh title=\"重新从 ERP 拉取该订单的最新状态\">刷新</button>'\n    + '<button type=\"button\" class=\"erp-toggle\" data-erp-toggle>收起</button>'\n    + \"</div>\"\n    + `<div class=\"erp-fulfill-body\" data-erp-body>${renderErpFulfillmentBody(payload, id)}</div>`\n    + \"</section>\";\n}\n\nfunction paintErpFulfillment(host, payload) {\n  if (!host) return;\n  const chip = erpFulfillChip(payload);\n  const chipEl = host.querySelector(\"[data-erp-chip]\");\n  if (chipEl) {\n    chipEl.className = `erp-chip ${chip.cls}`;\n    chipEl.textContent = chip.text;\n  }\n  const cachedEl = host.querySelector(\"[data-erp-cached]\");\n  if (cachedEl) cachedEl.hidden = !(payload && payload.cached);\n  const bodyEl = host.querySelector(\"[data-erp-body]\");\n  if (bodyEl) bodyEl.innerHTML = renderErpFulfillmentBody(payload, host.dataset.erpOrder);\n}\n\nasync function loadErpFulfillment(root, orderId, options = {}) {\n  const host = erpFulfillmentHost(root);\n  if (!host) return;\n  const id = String(orderId || \"\").trim();\n  if (!id) {\n    host.remove();\n    return;\n  }\n  if (options.refresh) {\n    // 手动刷新要立刻有反馈：芯片转「读取中…」、正文换成占位，并把按钮压住防止连点。\n    paintErpFulfillment(host, null);\n    host.classList.add(\"refreshing\");\n  }\n  try {\n    const payload = await fetchErpFulfillment(id, options);\n    if (!host.isConnected) return;\n    paintErpFulfillment(host, payload);\n  } catch (error) {\n    if (!host.isConnected) return;\n    paintErpFulfillment(host, {\n      ok: false, configured: true, found: false,\n      error_code: \"lookup_failed\",\n      message: `读取失败：${(error && error.message) || error}`,\n    });\n  } finally {\n    host.classList.remove(\"refreshing\");\n  }\n}\n\n// 折叠 / 重试 / 刷新用事件委托，避免每次重绘都要重新绑定。\ndocument.addEventListener(\"click\", (event) => {\n  const retry = event.target.closest(\"[data-erp-retry]\");\n  if (retry) {\n    const host = retry.closest(\".erp-fulfill\");\n    if (host) loadErpFulfillment(host, host.dataset.erpOrder, { refresh: true });\n    return;\n  }\n  // ERP 账号录入（v26.77）：展开 / 收起 / 保存 / 清除。\n  const credOpen = event.target.closest(\"[data-erp-cred-open]\");\n  if (credOpen) {\n    const host = credOpen.closest(\".erp-fulfill\");\n    const form = host && host.querySelector(\"[data-erp-cred-form]\");\n    if (form) {\n      form.hidden = false;\n      const input = form.querySelector(\"[data-erp-cred-identify]\");\n      if (input) input.focus();\n    }\n    return;\n  }\n  const credCancel = event.target.closest(\"[data-erp-cred-cancel]\");\n  if (credCancel) {\n    const form = credCancel.closest(\"[data-erp-cred-form]\");\n    if (form) {\n      form.hidden = true;\n      // 收起时清掉明文密码：用户既然取消了，就没理由把它留在 DOM 里。\n      const passwordEl = form.querySelector(\"[data-erp-cred-password]\");\n      if (passwordEl) passwordEl.value = \"\";\n      erpCredNote(form, \"\", \"\");\n    }\n    return;\n  }\n  const credSave = event.target.closest(\"[data-erp-cred-save]\");\n  if (credSave) {\n    const host = credSave.closest(\".erp-fulfill\");\n    if (host) saveErpCredential(host);\n    return;\n  }\n  const credClear = event.target.closest(\"[data-erp-cred-clear]\");\n  if (credClear) {\n    const host = credClear.closest(\".erp-fulfill\");\n    if (host) clearErpCredential(host);\n    return;\n  }\n  const refresh = event.target.closest(\"[data-erp-refresh]\");\n  if (refresh) {\n    const host = refresh.closest(\".erp-fulfill\");\n    // 刷新时自动展开，否则用户点了按钮却只看到标题栏，以为没生效。\n    if (host) {\n      host.classList.remove(\"collapsed\");\n      const toggle = host.querySelector(\"[data-erp-toggle]\");\n      if (toggle) toggle.textContent = \"收起\";\n      loadErpFulfillment(host, host.dataset.erpOrder, { refresh: true });\n    }\n    return;\n  }\n  const toggle = event.target.closest(\"[data-erp-toggle]\");\n  if (!toggle) {\n    // 拦截按钮（v26.74）：放在最后判 —— 它只在「捎客海外仓 + 待拣货」时存在，\n    // 先判其它按钮能保证既有交互的优先级不变。\n    const interceptBtn = event.target.closest(\"[data-erp-intercept-run]\");\n    if (interceptBtn) runOrderIntercept(interceptBtn);\n    return;\n  }\n  const host = toggle.closest(\".erp-fulfill\");\n  if (!host) return;\n  const collapsed = host.classList.toggle(\"collapsed\");\n  toggle.textContent = collapsed ? \"展开\" : \"收起\";\n});\n\n// ---------------------------------------------------------------------------\n// 物流轨迹浮窗（v26.63）\n// 分流在服务端做：渠道带「递四方 / 联邮通 / 4PX」→ 递四方接口（中文结构化轨迹，自绘时间线）；\n// 其余渠道 → 17TRACK 官方查询页内嵌（页面自带「翻译：简体中文」）。\n// 前端只负责把这两种结果渲染出来，不重复做渠道判断。\n// ---------------------------------------------------------------------------\nlet TRACK_MODAL_CTX = null;\n\nfunction trackModalEls() {\n  return {\n    mask: $(\"trackModal\"),\n    num: $(\"trackNum\"),\n    carrier: $(\"trackCarrier\"),\n    channel: $(\"trackChannel\"),\n    body: $(\"trackBody\"),\n    open: $(\"trackOpen\"),\n    refresh: $(\"trackRefresh\"),\n  };\n}\n\nfunction closeTrackModal() {\n  const el = trackModalEls();\n  if (!el.mask) return;\n  el.mask.classList.add(\"hidden\");\n  // 顺手把 iframe 拆掉：不拆的话 17TRACK 页面会在后台继续跑脚本和轮询。\n  if (el.body) el.body.innerHTML = \"\";\n  TRACK_MODAL_CTX = null;\n}\n\n/** 递四方返回的是 epoch 毫秒（UTC），这里统一按北京时间展示。 */\nfunction fmtTrackTime(ms) {\n  const value = Number(ms);\n  if (!value) return \"\";\n  const date = new Date(value + 8 * 3600e3);\n  const pad = (n) => String(n).padStart(2, \"0\");\n  return `${pad(date.getUTCMonth() + 1)}-${pad(date.getUTCDate())} ${pad(date.getUTCHours())}:${pad(date.getUTCMinutes())}`;\n}\n\nfunction trackStateHtml(html) {\n  return `<div class=\"track-state\">${html}</div>`;\n}\n\n/** 递四方：自绘中文时间线（带状态色与原文状态码）。 */\nfunction renderFourPxTrack(track) {\n  const points = Array.isArray(track && track.points) ? track.points : [];\n  const summary = [];\n  if (track.fourpx_code) summary.push(`4PX 单号 ${escapeHtml(track.fourpx_code)}`);\n  if (track.product) summary.push(`产品 ${escapeHtml(track.product)}`);\n  if (track.duration_days) summary.push(`全程 ${track.duration_days} 天`);\n  if (track.from_country || track.to_country) {\n    summary.push(`${escapeHtml(track.from_country || \"?\")} → ${escapeHtml(track.to_country || \"?\")}`);\n  }\n  const head = summary.length ? `<div class=\"tp-sum\">${summary.map((item) => `<span>${item}</span>`).join(\"\")}</div>` : \"\";\n  if (!points.length) {\n    return head + trackStateHtml(\"<span class=\\\"big\\\">还没有轨迹</span>递四方侧暂无该单号的轨迹记录。\");\n  }\n  const rows = points.map((point) => {\n    const tone = point.tone ? ` tone-${point.tone}` : \"\";\n    const meta = [point.tk_code, point.location].filter(Boolean).map((item) => escapeHtml(item)).join(\" · \");\n    return `<li class=\"tp${tone}\"><span class=\"tp-dot\"></span>`\n      + `<div class=\"tp-body\"><div class=\"tp-action\">${escapeHtml(point.action || \"—\")}</div>`\n      + (meta ? `<div class=\"tp-meta\">${meta}</div>` : \"\")\n      + \"</div>\"\n      + `<div class=\"tp-time\">${escapeHtml(fmtTrackTime(point.time_ms))}</div></li>`;\n  }).join(\"\");\n  return head + `<ol class=\"tp-list\">${rows}</ol>`;\n}\n\n/**\n * 17TRACK 内嵌页。\n * ⚠️ `referrerpolicy=\"no-referrer\"` 是必须的：17TRACK 按 HTTP Referer 判定站点授权，\n * 本地地址不在白名单里，不带这个属性会直接被拒（返回 code:-10，界面显示「验证失败」）。\n */\nfunction renderSeventeenTrack(payload) {\n  return '<div class=\"track-hint\">'\n    + '<b>想直接看中文？</b>轨迹区右上角有个「<b>翻译：中文简体</b>」开关，<b>勾上即为中文</b>。'\n    + '（17TRACK 默认显示承运商的原文，这个开关只能手动勾 —— 它没有对外参数，任何外部页面都改不了它。）'\n    + '<br>页面语言已经是简体中文，单号也已自动带入，打开即出结果。'\n    + '若出现「安全验证」，按提示点选一次即可（那是 17TRACK 的访问频率风控，换个网段或稍后再试也有效）。'\n    + '</div>'\n    + `<iframe class=\"track-frame\" src=\"${escapeAttr(payload.embed_url)}\" referrerpolicy=\"no-referrer\" loading=\"eager\" title=\"17TRACK 物流轨迹\"></iframe>`;\n}\n\n/** 「需要初始化」时把本机浏览器体检结果列出来，省得用户猜。 */\nfunction browserReportHtml(browsers) {\n  const list = Array.isArray(browsers) ? browsers.filter((item) => item && item.ok) : [];\n  if (!list.length) return \"\";\n  let anyLogged = false;\n  const rows = list.map((item) => {\n    const state = item.user_data_exists ? \"用过\" : \"从未启动过\";\n    const count = Array.isArray(item.profiles) ? item.profiles.length : 0;\n    // v26.65：把「哪个配置真的登录过递四方」直接摆出来 —— 用户报「我明明登录了」时，\n    // 这一行能立刻分辨「确实没登录」与「Cookies 读不到（unreadable）」，\n    // 后者在旧版会被静默当成「没登录过」，是排查时最大的黑洞。\n    const logged = Array.isArray(item.logged) ? item.logged.length : 0;\n    const unreadable = Number(item.unreadable) || 0;\n    if (logged > 0) anyLogged = true;\n    const notes = [];\n    if (logged > 0) notes.push(`<b>已登录递四方 ${logged} 个配置</b>`);\n    if (unreadable > 0) notes.push(`${unreadable} 个配置读取失败`);\n    const extra = notes.length ? `，${notes.join(\"，\")}` : \"\";\n    return `<li>${escapeHtml(item.label)}（${state}${count ? `，${count} 个配置` : \"\"}${extra}）</li>`;\n  }).join(\"\");\n  const tail = anyLogged\n    ? \"点「自动导入登录态」会直接复制已登录的那一份，不需要你再登录。\"\n    : \"「自动导入登录态」会先在这些浏览器里找已经登录过递四方的配置并自动复制；\"\n      + \"如果都没登录过，会新开一个窗口请你登录一次。\";\n  return `<div class=\"track-hint\">检测到本机浏览器：<ul class=\"track-list\">${rows}</ul>${tail}</div>`;\n}\n\nfunction applyTrackingPayload(payload) {\n  const el = trackModalEls();\n  if (!el.body) return;\n  if (el.carrier) {\n    const label = payload.carrier === \"fourpx\" ? \"递四方\" : (payload.carrier === \"17track\" ? \"17TRACK\" : \"\");\n    el.carrier.hidden = !label;\n    el.carrier.className = `track-chip${payload.carrier === \"fourpx\" ? \" fourpx\" : \"\"}`;\n    el.carrier.textContent = label;\n  }\n  if (el.open) {\n    if (payload.carrier === \"17track\" && payload.open_url) {\n      el.open.href = payload.open_url;\n      el.open.classList.remove(\"hidden\");\n    } else {\n      el.open.classList.add(\"hidden\");\n      el.open.removeAttribute(\"href\");\n    }\n  }\n\n  if (payload.carrier === \"fourpx\") {\n    if (payload.ok && payload.found && payload.track) {\n      el.body.innerHTML = renderFourPxTrack(payload.track);\n      return;\n    }\n    if (payload.ok && !payload.found) {\n      el.body.innerHTML = trackStateHtml(`<span class=\"big\">查不到该单号</span>${escapeHtml(payload.message || \"递四方侧没有这票记录\")}`);\n      return;\n    }\n    if (payload.need_login || payload.error_code === \"login_failed\" || payload.error_code === \"profile_missing\") {\n      // v26.70：日常浏览器正在运行 ⇒ 它的登录数据文件被 Windows 独占锁定、程序读不到。\n      // 这时多给一个「关闭 X 并导入」按钮，比让用户自己猜「我明明登录了为什么还要登录」有用得多。\n      const locked = String(payload.locked_browser || \"\");\n      el.body.innerHTML = trackStateHtml(\n        '<span class=\"big\">递四方登录态需要初始化</span>'\n        + escapeHtml(payload.message || \"需要先把浏览器里的递四方登录态复制过来一次\")\n        + browserReportHtml(payload.browsers)\n        + (locked\n          ? `<div class=\"track-hint\">${escapeHtml(locked)} 正在运行 —— 它运行期间登录数据被系统独占锁定，读不到。`\n            + `关掉它之后点下面的按钮，我就能自动把登录状态复制过来（之后长期免登录）。</div>`\n          : \"\")\n        + '<br><button type=\"button\" class=\"track-btn\" data-track-init>自动导入登录态</button>'\n        + (locked\n          ? `<button type=\"button\" class=\"track-btn\" data-track-init data-track-kill=\"1\" style=\"margin-left:8px;\">`\n            + `关闭 ${escapeHtml(locked)} 并导入</button>`\n          : \"\"),\n      );\n      return;\n    }\n    el.body.innerHTML = trackStateHtml(`<span class=\"big\">读取失败</span>${escapeHtml(payload.message || payload.error_code || \"未知错误\")}`);\n    return;\n  }\n\n  if (payload.carrier === \"17track\" && payload.embed_url) {\n    el.body.innerHTML = renderSeventeenTrack(payload);\n    return;\n  }\n\n  el.body.innerHTML = trackStateHtml(`<span class=\"big\">没有可查的轨迹</span>${escapeHtml(payload.message || \"该订单还没有物流单号\")}`);\n}\n\nasync function loadTracking(options = {}) {\n  const ctx = TRACK_MODAL_CTX;\n  const el = trackModalEls();\n  if (!ctx || !el.body) return;\n  el.body.innerHTML = trackStateHtml('<span class=\"track-spin\"></span>正在读取物流轨迹…');\n  const params = new URLSearchParams();\n  if (ctx.num) params.set(\"num\", ctx.num);\n  if (ctx.channel) params.set(\"channel\", ctx.channel);\n  if (ctx.orderId) params.set(\"order_id\", ctx.orderId);\n  if (options.force) params.set(\"refresh\", \"1\");\n  try {\n    const payload = await api(`/api/tracking?${params.toString()}`);\n    // 期间浮窗被关掉或换成别的单号了 → 丢弃这次结果，别覆盖掉新的。\n    if (!TRACK_MODAL_CTX || TRACK_MODAL_CTX.token !== ctx.token) return;\n    applyTrackingPayload(payload);\n  } catch (error) {\n    if (!TRACK_MODAL_CTX || TRACK_MODAL_CTX.token !== ctx.token) return;\n    el.body.innerHTML = trackStateHtml(`<span class=\"big\">读取失败</span>${escapeHtml((error && error.message) || String(error))}`);\n  }\n}\n\nfunction openTrackingModal({ num, channel, orderId }) {\n  const el = trackModalEls();\n  if (!el.mask) return;\n  TRACK_MODAL_CTX = {\n    num: String(num || \"\").trim(),\n    channel: String(channel || \"\").trim(),\n    orderId: String(orderId || \"\").trim(),\n    token: `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`,\n  };\n  el.mask.classList.remove(\"hidden\");\n  if (el.num) el.num.textContent = TRACK_MODAL_CTX.num || \"—\";\n  if (el.channel) el.channel.textContent = TRACK_MODAL_CTX.channel || \"\";\n  if (el.carrier) { el.carrier.hidden = true; el.carrier.textContent = \"\"; }\n  if (el.open) { el.open.classList.add(\"hidden\"); el.open.removeAttribute(\"href\"); }\n  loadTracking();\n}\n\ndocument.addEventListener(\"click\", (event) => {\n  const link = event.target.closest(\"[data-track-num]\");\n  if (link) {\n    event.preventDefault();\n    openTrackingModal({\n      num: link.dataset.trackNum,\n      channel: link.dataset.trackChannel,\n      orderId: link.dataset.trackOrder,\n    });\n    return;\n  }\n  if (event.target.closest(\"#trackClose\")) {\n    closeTrackModal();\n    return;\n  }\n  if (event.target.id === \"trackModal\") {\n    closeTrackModal();\n    return;\n  }\n  if (event.target.closest(\"#trackRefresh\")) {\n    if (TRACK_MODAL_CTX) loadTracking({ force: true });\n    return;\n  }\n  const initBtn = event.target.closest(\"[data-track-init]\");\n  if (initBtn) {\n    // v26.70：默认**不**强杀用户在用的浏览器（那是不可逆的动作，未保存的标签会丢）。\n    // 只有用户自己点「关闭 X 并导入」时才带 kill_browser。\n    const kill = initBtn.dataset.trackKill === \"1\";\n    const ok = window.confirm(\n      kill\n        ? \"将关闭本机正在运行的浏览器（未保存的标签页会丢失），然后复制递四方登录态。\\n\\n是否继续？\"\n        : \"自动导入会读取你在浏览器里登录的递四方状态，并复制一份到工作台自己的目录。\\n\\n\"\n          + \"· 已经导入过 → 直接复用，不需要你再登录。\\n\"\n          + \"· 本机浏览器已经登录过递四方 → 自动复制，你不需要做任何事。\\n\"\n          + \"· 日常浏览器正在运行（登录数据被系统锁定）→ 会提示你关掉它。\\n\"\n          + \"· 都没登录过 → 会新开一个浏览器窗口，请在里面登录一次。\\n\\n是否继续？\",\n    );\n    if (!ok) return;\n    initBtn.disabled = true;\n    initBtn.textContent = \"初始化中…\";\n    api(\"/api/tracking/fourpx/init\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify(kill ? { kill_browser: true } : {}),\n    })\n      .then((result) => {\n        if (!result.ok) throw new Error(result.message || result.error || \"初始化失败\");\n        // 需要用户去刚弹出的登录窗口登录一次 —— 此刻还没有会话，刷新没有意义，只提示下一步。\n        if (result.mode === \"login_window\" || result.need_user_login) {\n          const body = $(\"trackBody\");\n          if (body) {\n            body.innerHTML = trackStateHtml(\n              '<span class=\"big\">已打开登录窗口</span>'\n              + escapeHtml(result.message || \"请在刚打开的浏览器窗口里登录递四方。\")\n              + (result.profile_dir\n                ? `<div class=\"track-hint\">登录窗口使用的是工作台自己的配置目录：<br>${escapeHtml(result.profile_dir)}</div>`\n                : \"\")\n              // v26.73：**别再叫用户先关窗**。4px 的登录 cookie 是会话 cookie，而 Chromium 每 30 秒\n              // 才把 cookie 批量写盘一次 —— 「关掉窗口再刷新」这条路天生会丢登录态（真机实测：\n              // 登录成功、关窗后磁盘库里 0 条登录 cookie，只剩 7 条站点风控 cookie）。\n              // 现在窗口开着时后端会自己轮询取走并落盘，取到后自动关窗。\n              + '<div class=\"track-hint\">登录成功后<b>不用管这个窗口</b>：工作台会自己把登录态取走并保存，'\n              + '窗口随后会自动关闭。然后点右上角「刷新」读取轨迹 —— 登录态一旦存下来，以后重启也不用再登。</div>',\n            );\n          }\n          return;\n        }\n        loadTracking({ force: true });\n      })\n      .catch((error) => {\n        initBtn.disabled = false;\n        initBtn.textContent = \"初始化递四方会话\";\n        const body = $(\"trackBody\");\n        if (body) {\n          body.insertAdjacentHTML(\"beforeend\",\n            `<div class=\"track-state\" style=\"padding-top:8px;\">${escapeHtml((error && error.message) || String(error))}</div>`);\n        }\n      });\n  }\n});\n\ndocument.addEventListener(\"keydown\", (event) => {\n  if (event.key === \"Escape\" && TRACK_MODAL_CTX) closeTrackModal();\n});\n\nfunction renderOrderDetail(order, shopId, source) {\n  const body = $(\"orderDetailBody\");\n  if (!body) return;\n  if (!order) {\n    $(\"orderDetailTitle\").textContent = \"订单详情\";\n    $(\"orderDetailContext\").textContent = \"未找到该预设来源关联的订单\";\n    body.innerHTML = '<div class=\"order-detail-empty\">当前预览数据里没有可展示的订单详情</div>';\n    return;\n  }\n  const id = String(order.order_id || \"\");\n  const currency = String(order.currency_iso_code || \"EUR\");\n  const total = Number(order.total_price);\n  const totalText = Number.isFinite(total) ? `${total.toLocaleString(\"zh-CN\", { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${currency}` : \"—\";\n  const shop = SHOPS.find((s) => String(s.shop_id) === String(shopId));\n  $(\"orderDetailTitle\").textContent = id ? `订单 ${id}` : \"订单详情\";\n  $(\"orderDetailContext\").textContent = `${(shop && shop.name) || \"当前店铺\"} · ${source === \"shipping-overdue\" ? \"从发货超时列表打开\" : \"从站内信预加载数据读取\"}`;\n  const stat = (label, value, cls = \"\") => `<div class=\"order-detail-stat ${cls}\"><div class=\"label\">${escapeHtml(label)}</div><div class=\"value\">${escapeHtml(value)}</div></div>`;\n  const lines = Array.isArray(order.order_lines) ? order.order_lines : [];\n  const statusBadges = renderOrderStatusBadges(order);\n  const lineRows = lines.map((line) => {\n    const price = Number(line.price);\n    const remaining = Number(line.remaining_amount);\n    const qty = Number(line.quantity);\n    return `<tr>\n      <td><strong>${escapeHtml(line.product_title || \"未命名商品\")}</strong><br><span>${escapeHtml(line.offer_sku || line.product_sku || \"—\")}</span></td>\n      <td class=\"num\">${Number.isFinite(qty) ? qty : \"—\"}</td>\n      <td class=\"num\">${Number.isFinite(price) ? price.toFixed(2) : \"—\"}</td>\n      <td class=\"num\">${Number.isFinite(remaining) ? remaining.toFixed(2) : \"—\"}</td>\n      <td>${escapeHtml(line.order_line_state || \"—\")}</td>\n    </tr>`;\n  }).join(\"\");\n  const lineTable = lines.length ? `<div class=\"order-detail-lines\"><table><thead><tr><th>商品 / SKU</th><th class=\"num\">数量</th><th class=\"num\">金额</th><th class=\"num\">可退</th><th>状态</th></tr></thead><tbody>${lineRows}</tbody></table></div>` : '<div class=\"order-detail-empty\">没有订单行信息</div>';\n  body.innerHTML = `<div class=\"order-detail-summary\">\n      ${stat(\"订单总额\", totalText, \"total\")}\n      ${stat(\"订单状态\", order.order_state || \"—\")}\n      ${stat(\"下单时间\", formatOrderDate(order.created_date))}\n      ${stat(\"更新时间\", formatOrderDate(order.last_updated_date))}\n      ${stat(\"买家\", orderCustomerLabel(order.customer), \"wide\")}\n     </div>\n     ${statusBadges ? `<div class=\"order-detail-badges\">${statusBadges}</div>` : \"\"}\n     ${renderErpFulfillmentSection(null, id)}\n     <section class=\"order-detail-section\"><h3>商品明细</h3>${lineTable}</section>\n    <section class=\"order-detail-section\"><h3>收货信息</h3><p>${escapeHtml(orderAddressLabel(order.shipping_address))}</p></section>\n    ${order.billing_address ? `<section class=\"order-detail-section\"><h3>账单信息</h3><p>${escapeHtml(orderAddressLabel(order.billing_address))}</p></section>` : \"\"}\n    <section class=\"order-detail-section\"><h3>订单标识</h3><p>订单号：${escapeHtml(id || \"—\")}</p><p>商业订单号：${escapeHtml(order.commercial_id || \"—\")}</p><p>币种：${escapeHtml(currency)}</p></section>`;\n  // ERP 联查异步补位：订单号即 Mirakl order_id，与 ERP 的 platformOrderNum 同构。\n  loadErpFulfillment(body, id);\n}\n\nasync function openOrderDetail(orderId, shopId, options = {}) {\n  const drawer = $(\"orderDetailDrawer\");\n  if (!drawer) return;\n  const requestSeq = ++ORDER_DETAIL_REQUEST_SEQ;\n  drawer.classList.remove(\"hidden\");\n  $(\"orderDetailStatus\").textContent = \"正在读取订单详情…\";\n  $(\"orderDetailStatus\").className = \"order-detail-status\";\n  $(\"orderDetailBody\").innerHTML = '<div class=\"order-detail-empty\">正在读取…</div>';\n  let order = getInboxOrder(orderId);\n  let bundle = INBOX_PRELOAD_CACHE.get(String(shopId || GLOBAL_SHOP))?.data || null;\n  if (!order) {\n    try {\n      order = await loadInboxOrder(orderId, shopId || GLOBAL_SHOP);\n    } catch (error) {\n      if (requestSeq !== ORDER_DETAIL_REQUEST_SEQ) return;\n      $(\"orderDetailStatus\").textContent = `订单详情读取失败：${error.message}`;\n      $(\"orderDetailStatus\").className = \"order-detail-status err\";\n      renderOrderDetail(null, shopId);\n      return;\n    }\n  }\n  if (requestSeq !== ORDER_DETAIL_REQUEST_SEQ) return;\n  if (!order) {\n    $(\"orderDetailStatus\").textContent = \"未找到该订单的可用详情\";\n    $(\"orderDetailStatus\").className = \"order-detail-status warn\";\n    renderOrderDetail(null, shopId);\n    return;\n  }\n  renderOrderDetail(order, shopId, options.source);\n  const orderWarning = bundle && bundle.order_error;\n  const preloadedOrder = !!(bundle && Array.isArray(bundle.orders) && bundle.orders.some((item) => String(item.order_id) === String(orderId)));\n  $(\"orderDetailStatus\").textContent = orderWarning ? `已读取订单（部分待回复订单详情更新失败：${orderWarning}）` : (preloadedOrder ? \"已从站内信预加载读取\" : \"已按需读取订单详情\");\n  $(\"orderDetailStatus\").className = orderWarning ? \"order-detail-status warn\" : \"order-detail-status ok\";\n}\n\nfunction closeOrderDetail() {\n  ORDER_DETAIL_REQUEST_SEQ += 1;\n  const drawer = $(\"orderDetailDrawer\");\n  if (drawer) drawer.classList.add(\"hidden\");\n}\n\n// ---- 事件关闭（OR64） ----\n// OR64 针对订单行执行 resolve_incident；只有订单行状态为 INCIDENT_OPEN 时才显示入口。\nfunction incidentOpenLines(order) {\n  const lines = Array.isArray(order && order.order_lines) ? order.order_lines : [];\n  return lines.filter((line) => String(line && (line.order_line_state || line.state) || \"\").toUpperCase() === \"INCIDENT_OPEN\" && line.incident_resolved !== true);\n}\n\nfunction incidentLineId(line) {\n  return String(line && (line.order_line_id || line.id) || \"\").trim();\n}\n\n// 事件通知的语言提示：与后端 detectShopLang 同一判据（含 ES → 西语，其余 → 德语）。\n// 前端只用来在勾选框旁提前说明「会发哪种语言」，真正选语言的是服务端。\nfunction incidentNoticeLangCode(shopName) {\n  return String(shopName || \"\").toUpperCase().split(/[\\s_\\-().]+/).filter(Boolean).includes(\"ES\") ? \"es\" : \"de\";\n}\n\nfunction incidentNoticeLangLabel(shopName) {\n  return incidentNoticeLangCode(shopName) === \"es\" ? \"西班牙语\" : \"德语\";\n}\n\n// 通知结局 → 一行中文提示。**「跳过」必须说出来**：静默什么都不显示，\n// 用户会以为信已经发出去了（v26.79 那个假成功的教训）。\nfunction incidentNoticeOutcomeText(notice) {\n  if (!notice) return \"\";\n  if (notice.ok) return \" · 已通知管理员\";\n  switch (String(notice.note || \"\")) {\n    case \"skipped_disabled\":\n    case \"skipped_platform_already_resolved\":\n      return \"\";\n    case \"skipped_no_thread\":\n      return \" · 未通知管理员（未在站内信对话中操作）\";\n    case \"skipped_no_operator\":\n      return \" · 未通知管理员（该对话里没有管理员）\";\n    case \"skipped_thread_mismatch\":\n      return \" · 未通知管理员（对话与订单不匹配）\";\n    case \"skipped_thread_unreadable\":\n      return ` · 未通知管理员（${notice.error || \"读不到当前对话\"}）`;\n    default:\n      return ` · 管理员通知未发出${notice.error ? `：${notice.error}` : \"\"}`;\n  }\n}\n\nfunction updateIncidentCloseTrigger(orderId) {\n  const trigger = document.querySelector('#readPane [data-action=\"incident-close\"]');\n  if (!trigger) return;\n  const order = getInboxOrder(orderId);\n  const visible = incidentOpenLines(order).length > 0;\n  trigger.classList.toggle(\"hidden\", !visible);\n  trigger.disabled = !visible;\n  trigger.setAttribute(\"aria-hidden\", visible ? \"false\" : \"true\");\n}\n\nfunction syncIncidentCloseControls() {\n  const lineSelect = $(\"incidentLineSelect\");\n  const reasonSelect = $(\"incidentReasonSelect\");\n  const confirmButton = $(\"btnIncidentCloseConfirm\");\n  if (!confirmButton) return;\n  confirmButton.disabled = !INCIDENT_CLOSE_CONTEXT || !lineSelect || !reasonSelect || !lineSelect.value || !reasonSelect.value;\n}\n\nfunction closeIncidentCloseDialog() {\n  INCIDENT_CLOSE_REQUEST += 1;\n  INCIDENT_CLOSE_CONTEXT = null;\n  const modal = $(\"incidentCloseModal\");\n  if (modal) modal.classList.add(\"hidden\");\n  const status = $(\"incidentCloseStatus\");\n  if (status) { status.textContent = \"\"; status.className = \"incident-close-status\"; }\n  const lineSelect = $(\"incidentLineSelect\");\n  if (lineSelect) { lineSelect.innerHTML = \"\"; lineSelect.disabled = false; }\n  const reasonSelect = $(\"incidentReasonSelect\");\n  if (reasonSelect) { reasonSelect.innerHTML = '<option value=\"\">请选择关闭原因</option>'; reasonSelect.disabled = false; }\n  const confirmButton = $(\"btnIncidentCloseConfirm\");\n  if (confirmButton) { confirmButton.disabled = true; confirmButton.textContent = \"确定关闭\"; }\n}\n\nasync function openIncidentCloseDialog(orderId, shopId) {\n  const id = String(orderId || \"\").trim();\n  const sid = String(shopId || GLOBAL_SHOP || \"\").trim();\n  if (!id || !sid) return;\n  const modal = $(\"incidentCloseModal\");\n  if (!modal) return;\n  const request = ++INCIDENT_CLOSE_REQUEST;\n  INCIDENT_CLOSE_CONTEXT = null;\n  modal.classList.remove(\"hidden\");\n  $(\"incidentCloseContext\").textContent = `${quickRefundShopLabel(sid)} · ${id}`;\n  const notifyBox = $(\"incidentNotifyOperator\");\n  if (notifyBox) notifyBox.checked = true;\n  const notifyLang = $(\"incidentNotifyLang\");\n  if (notifyLang) notifyLang.textContent = incidentNoticeLangLabel(quickRefundShopLabel(sid));\n  $(\"incidentCloseStatus\").textContent = \"正在读取事件订单行…\";\n  $(\"incidentCloseStatus\").className = \"incident-close-status\";\n  $(\"incidentLineSelect\").innerHTML = '<option value=\"\">读取中…</option>';\n  $(\"incidentLineSelect\").disabled = true;\n  $(\"incidentReasonSelect\").innerHTML = '<option value=\"\">加载关闭原因…</option>';\n  $(\"incidentReasonSelect\").disabled = true;\n  $(\"btnIncidentCloseConfirm\").disabled = true;\n\n  try {\n    const order = getInboxOrder(id) || await loadInboxOrder(id, sid);\n    if (request !== INCIDENT_CLOSE_REQUEST) return;\n    const lines = incidentOpenLines(order);\n    if (!lines.length) {\n      $(\"incidentCloseStatus\").textContent = \"当前订单没有可关闭的进行中事件。\";\n      $(\"incidentCloseStatus\").className = \"incident-close-status err\";\n      updateIncidentCloseTrigger(id);\n      return;\n    }\n    INCIDENT_CLOSE_CONTEXT = { request, orderId: id, shopId: sid, order, lines };\n    $(\"incidentLineSelect\").innerHTML = lines.map((line, index) => {\n      const label = [line.product_title || \"商品\", line.offer_sku || line.product_sku].filter(Boolean).join(\" · \");\n      return `<option value=\"${escapeAttr(incidentLineId(line))}\">第${index + 1}行 · ${escapeHtml(label || \"订单商品\")}</option>`;\n    }).join(\"\");\n    $(\"incidentLineSelect\").disabled = false;\n    $(\"incidentReasonSelect\").innerHTML = '<option value=\"\">加载关闭原因…</option>';\n    $(\"incidentReasonSelect\").disabled = true;\n    $(\"incidentCloseStatus\").textContent = \"正在读取关闭原因…\";\n    const data = await api(`/api/incident/reasons?shop_id=${encodeURIComponent(sid)}`);\n    if (request !== INCIDENT_CLOSE_REQUEST) return;\n    const seen = new Set();\n    const reasons = (data.reasons || []).filter((reason) => {\n      const code = String(reason && reason.code || \"\").trim();\n      if (!code || seen.has(code)) return false;\n      seen.add(code);\n      return String(reason && (reason.zh_label || reason.label) || \"\").trim();\n    });\n    if (!reasons.length) throw new Error(\"未找到可用的关闭原因\");\n    $(\"incidentReasonSelect\").innerHTML = '<option value=\"\">请选择关闭原因</option>' + reasons.map((reason) => `<option value=\"${escapeAttr(reason.code)}\">${escapeHtml(reason.zh_label || reason.label)}</option>`).join(\"\");\n    $(\"incidentReasonSelect\").disabled = false;\n    $(\"incidentCloseStatus\").textContent = \"请选择订单行和关闭原因，确定后将立即调用平台关闭事件。\";\n    $(\"incidentCloseStatus\").className = \"incident-close-status\";\n    syncIncidentCloseControls();\n  } catch (error) {\n    if (request !== INCIDENT_CLOSE_REQUEST) return;\n    $(\"incidentCloseStatus\").textContent = `加载失败：${error.message}`;\n    $(\"incidentCloseStatus\").className = \"incident-close-status err\";\n    $(\"incidentLineSelect\").disabled = true;\n    $(\"incidentReasonSelect\").disabled = true;\n    $(\"btnIncidentCloseConfirm\").disabled = true;\n  }\n}\n\nasync function submitIncidentClose() {\n  const context = INCIDENT_CLOSE_CONTEXT;\n  const st = $(\"incidentCloseStatus\");\n  const lineSelect = $(\"incidentLineSelect\");\n  const reasonSelect = $(\"incidentReasonSelect\");\n  const confirmButton = $(\"btnIncidentCloseConfirm\");\n  if (!context || !lineSelect || !reasonSelect || !lineSelect.value || !reasonSelect.value) {\n    if (st) { st.textContent = \"请选择订单行和关闭原因\"; st.className = \"incident-close-status err\"; }\n    syncIncidentCloseControls();\n    return;\n  }\n  const line = context.lines.find((item) => incidentLineId(item) === String(lineSelect.value)) || context.lines[0];\n  const reasonCode = String(reasonSelect.value);\n  const reasonLabel = reasonSelect.options[reasonSelect.selectedIndex]?.textContent || \"关闭原因\";\n  // v26.83：关闭成功后要不要顺带在**当前这条站内信**里通知平台管理员（默认要）。\n  const notifyOperator = !$(\"incidentNotifyOperator\") || $(\"incidentNotifyOperator\").checked;\n  // 只把「当前这条对话」交出去，且必须与本次操作的订单一致；\n  // 服务端还会用订单归属再独立校验一次（不匹配就根本不发）。\n  const notifyThreadId = CURRENT_THREAD\n    && CURRENT_THREAD.thread_id\n    && (!CURRENT_THREAD.order_id || String(CURRENT_THREAD.order_id) === String(context.orderId))\n    ? String(CURRENT_THREAD.thread_id)\n    : \"\";\n  if (confirmButton) confirmButton.disabled = true;\n  if (st) {\n    st.textContent = notifyOperator ? \"正在关闭事件并通知平台管理员…\" : \"正在关闭事件…\";\n    st.className = \"incident-close-status\";\n  }\n  try {\n    const resolveResult = await api(\"/api/incidents/resolve\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({\n        shop_id: context.shopId,\n        order_id: context.orderId,\n        order_line_id: incidentLineId(line),\n        reason_code: reasonCode,\n        thread_id: notifyThreadId,\n        notify_operator: notifyOperator,\n      }),\n    });\n    const cachedOrder = getInboxOrder(context.orderId) || context.order;\n    const cachedLine = cachedOrder && Array.isArray(cachedOrder.order_lines)\n      ? cachedOrder.order_lines.find((item) => incidentLineId(item) === incidentLineId(line))\n      : null;\n    if (cachedLine) {\n      cachedLine.order_line_state = \"CLOSED\";\n      cachedLine.incident_open = false;\n      cachedLine.incident_resolved = true;\n      cachedLine.incident_resolution_source = resolveResult && resolveResult.incident_sync || \"or64\";\n      cachedLine.has_incident = false;\n      cachedLine.order_line_state_reason_code = reasonCode;\n      cachedLine.order_line_state_reason_label = reasonLabel;\n    }\n    if (cachedOrder) {\n      cachedOrder.incident_evidence = true;\n      cachedOrder.has_incident = incidentOpenLines(cachedOrder).length > 0;\n      const knownIncidentLines = (cachedOrder.order_lines || []).filter((item) => item.incident_open || item.incident_resolved);\n      cachedOrder.incident_resolved = knownIncidentLines.length > 0 && knownIncidentLines.every((item) => item.incident_resolved === true);\n    }\n    const syncedAlready = resolveResult && resolveResult.incident_sync === \"platform_already_resolved\";\n    const resolvedMessage = (syncedAlready ? \"平台已解决，工作台已同步\" : `事件已关闭 · ${reasonLabel}`)\n      + incidentNoticeOutcomeText(resolveResult && resolveResult.notice);\n    const drawer = $(\"orderDetailDrawer\");\n    const drawerOpen = drawer && !drawer.classList.contains(\"hidden\");\n    closeIncidentCloseDialog();\n    updateIncidentCloseTrigger(context.orderId);\n    // 通知确实发出去了 ⇒ 我们在这条对话里已经回过了，与 /api/inbox/reply 同口径：\n    // 立刻置为「无需回复」，别让它继续挂在待回复里（服务端写的是同一份状态）。\n    if (resolveResult && resolveResult.notice && resolveResult.notice.ok) {\n      const notifiedThreadId = String(resolveResult.notice.thread_id || notifyThreadId || \"\");\n      if (notifiedThreadId) {\n        const listed = ALL_THREADS.find((item) => String(item.thread_id) === notifiedThreadId);\n        if (listed) { listed.needReply = false; listed.resolved = true; }\n        if (CURRENT_THREAD && String(CURRENT_THREAD.thread_id) === notifiedThreadId) {\n          CURRENT_THREAD.needReply = false;\n          CURRENT_THREAD.resolved = true;\n        }\n      }\n    }\n    renderMailList();\n    if (drawerOpen && cachedOrder && CURRENT_THREAD && String(CURRENT_THREAD.order_id) === String(context.orderId)) {\n      renderOrderDetail(cachedOrder, context.shopId);\n      $(\"orderDetailStatus\").textContent = resolvedMessage;\n      $(\"orderDetailStatus\").className = \"order-detail-status ok\";\n    } else {\n      const globalStatus = $(\"globalStatus\");\n      if (globalStatus) { globalStatus.textContent = resolvedMessage; globalStatus.className = \"status ok\"; }\n    }\n  } catch (error) {\n    if (st) { st.textContent = `关闭失败：${error.message}`; st.className = \"incident-close-status err\"; }\n    if (confirmButton) confirmButton.disabled = false;\n  }\n}\n\nasync function markAllRead() {\n  for (const t of ALL_THREADS) {\n    if (t.unread) {\n      try { await api(\"/api/inbox/mark\", { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify({ thread_id: t.thread_id, read: true }) }); } catch (e) {}\n      t.unread = false;\n    }\n  }\n  renderMailList();\n  syncMarkUnreadControl();\n}\n\n// ---- v26.45 标记未读 ----\n// 只改本机 read_state.json，不调用 Mirakl 写接口，不影响回复、退款和站内信内容。\nlet MARK_UNREAD_PENDING = false;\n\nfunction setInboxStateStatus(message, kind) {\n  const el = $(\"globalStatus\");\n  if (!el) return;\n  el.textContent = message;\n  el.className = kind === \"err\" ? \"status err\" : \"status ok\";\n}\n\nfunction currentThreadUnreadTargets(threadId) {\n  const targets = [];\n  const collect = (list) => {\n    if (!Array.isArray(list)) return;\n    for (const item of list) {\n      if (item && String(item.thread_id) === String(threadId)) targets.push(item);\n    }\n  };\n  collect(ALL_THREADS);\n  for (const entry of INBOX_PRELOAD_CACHE.values()) collect(entry && entry.data && entry.data.threads);\n  return targets;\n}\n\nfunction syncMarkUnreadControl() {\n  const button = document.querySelector('#readPane [data-action=\"mark-unread\"]');\n  if (!button || !CURRENT_THREAD) return;\n  const listed = ALL_THREADS.find((t) => String(t.thread_id) === String(CURRENT_THREAD.thread_id));\n  const unread = !!(listed && listed.unread);\n  button.disabled = unread || MARK_UNREAD_PENDING;\n  const label = button.querySelector(\".mark-unread-label\");\n  if (label) label.textContent = unread ? \"已标记未读\" : \"标记未读\";\n}\n\nasync function markCurrentThreadUnread() {\n  const thread = CURRENT_THREAD;\n  if (!thread || MARK_UNREAD_PENDING) return;\n  const threadId = String(thread.thread_id || \"\").trim();\n  if (!threadId) { setInboxStateStatus(\"当前站内信缺少线程 ID，无法标记未读\", \"err\"); return; }\n  if (thread.last_sender_type === \"SHOP_USER\") { setInboxStateStatus(\"最后一封是我方发送的站内信，不支持标记未读\", \"err\"); return; }\n  const listed = ALL_THREADS.find((t) => String(t.thread_id) === threadId);\n  if (listed && listed.unread) { setInboxStateStatus(\"该站内信已经是未读\", \"ok\"); return; }\n\n  MARK_UNREAD_PENDING = true;\n  syncMarkUnreadControl();\n  const targets = currentThreadUnreadTargets(threadId);\n  const snapshots = targets.map((item) => ({ item, unread: item.unread, read_at: item.read_at }));\n  for (const thread of targets) {\n    thread.unread = true;\n    thread.read_at = null;\n  }\n  CURRENT_THREAD.unread = true;\n  renderMailList();\n  syncMarkUnreadControl();\n  try {\n    await api(\"/api/inbox/mark\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ thread_id: threadId, read: false }),\n    });\n    setInboxStateStatus(\"已标记为未读，刷新或重启后仍保持未读\", \"ok\");\n  } catch (error) {\n    for (const snapshot of snapshots) {\n      snapshot.item.unread = snapshot.unread;\n      snapshot.item.read_at = snapshot.read_at;\n    }\n    CURRENT_THREAD.unread = Boolean(listed && listed.unread);\n    renderMailList();\n    setInboxStateStatus(`标记未读失败：${error && error.message ? error.message : error}`, \"err\");\n  } finally {\n    MARK_UNREAD_PENDING = false;\n    syncMarkUnreadControl();\n  }\n}\n\n// ---- 附件处理（base64） ----\nfunction filesToJson(files) {\n  return Array.from(files).map((f) => ({\n    file_name: f.name,\n    content_type: f.type || \"application/octet-stream\",\n    size: f.size,\n  }));\n}\nfunction readFilesAsData(files) {\n  const tasks = Array.from(files).map((f) => new Promise((resolve, reject) => {\n    const r = new FileReader();\n    r.onload = () => resolve({ file_name: f.name, content_type: f.type || \"application/octet-stream\", data: String(r.result).split(\",\")[1] });\n    r.onerror = reject;\n    r.readAsDataURL(f);\n  }));\n  return Promise.all(tasks);\n}\nlet REPLY_FILES = [];\nlet NT_FILES = [];\nlet NT_TOPIC_REASONS = [];\nlet NT_TOPIC_REASON_REQUEST = 0;\n\n$(\"btnReplyAttach\").addEventListener(\"click\", () => $(\"replyFile\").click());\n$(\"replyFile\").addEventListener(\"change\", (e) => {\n  REPLY_FILES = Array.from(e.target.files);\n  $(\"replyFiles\").textContent = REPLY_FILES.map((f) => `${f.name} (${(f.size / 1024).toFixed(0)}KB)`).join(\"；\");\n  e.target.value = \"\";\n});\n$(\"btnNtAttach\").addEventListener(\"click\", () => $(\"ntFile\").click());\n$(\"ntFile\").addEventListener(\"change\", (e) => {\n  NT_FILES = Array.from(e.target.files);\n  $(\"ntFiles\").textContent = NT_FILES.map((f) => `${f.name} (${(f.size / 1024).toFixed(0)}KB)`).join(\"；\");\n  e.target.value = \"\";\n});\n\n// 回复成功后的统一状态收口：立即移除待回复标记、更新列表/仪表盘计数，并持久化 resolved_state。\nasync function markThreadsReplied(threadIds) {\n  const ids = [...new Set((Array.isArray(threadIds) ? threadIds : [threadIds]).map((id) => String(id || \"\").trim()).filter(Boolean))];\n  if (!ids.length) return;\n  const idSet = new Set(ids);\n  const readAt = new Date().toISOString();\n  for (const thread of ALL_THREADS) {\n    if (!idSet.has(String(thread.thread_id))) continue;\n    thread.shop_reply_needed_since = null;\n    thread.needReply = false;\n    thread.resolved = true;\n    thread.unread = false;\n    thread.read_at = readAt;\n  }\n  for (const entry of INBOX_PRELOAD_CACHE.values()) {\n    const threads = entry && entry.data && entry.data.threads;\n    if (!Array.isArray(threads)) continue;\n    for (const thread of threads) {\n      if (!idSet.has(String(thread.thread_id))) continue;\n      thread.shop_reply_needed_since = null;\n      thread.needReply = false;\n      thread.resolved = true;\n      thread.unread = false;\n      thread.read_at = readAt;\n    }\n  }\n  if (CURRENT_THREAD && idSet.has(String(CURRENT_THREAD.thread_id))) {\n    CURRENT_THREAD.needReply = false;\n    CURRENT_THREAD.unread = false;\n    syncReplyBatchControl(CURRENT_THREAD);\n  }\n  renderMailList();\n  if (typeof renderDashboardV24 === \"function\" && document.querySelector(\".nav-item.active\")?.dataset.page === \"dashboard\" && DASH_DATA) {\n    renderDashboardV24();\n  }\n  try {\n    const readResults = await Promise.allSettled(ids.map((threadId) => api(\"/api/inbox/mark\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ thread_id: threadId, read: true }),\n    })));\n    const readFailures = readResults.filter((result) => result.status === \"rejected\");\n    if (readFailures.length) console.warn(`${readFailures.length} 个线程的已读状态持久化失败`);\n    await api(\"/api/inbox/mark-resolved\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ thread_ids: ids, resolved: true }),\n    });\n  } catch (e) {\n    console.warn(\"回复状态持久化失败\", e.message);\n  }\n}\n\n// ---- 回复发送（带附件） ----\nasync function loadOrderPendingReplyThreads(thread) {\n  const shopId = String(thread && thread.shop_id || \"\").trim();\n  const orderId = String(thread && thread.order_id || \"\").trim();\n  if (!shopId || !orderId) throw new Error(\"当前站内信没有可用的订单号\");\n  const data = await api(`/api/inbox/order-pending-threads?shop_id=${encodeURIComponent(shopId)}&order_id=${encodeURIComponent(orderId)}`);\n  if (data.complete !== true) throw new Error(\"无法确认此订单的全部待回复站内信，请稍后重试\");\n  const threads = (Array.isArray(data.threads) ? data.threads : [])\n    .filter((item) => String(item && item.shop_id || shopId) === shopId && item && item.needReply === true);\n  const current = threads.find((item) => String(item.thread_id) === String(thread.thread_id));\n  if (!current) throw new Error(\"当前站内信已不再待回复，请刷新后重试\");\n  return [current, ...threads.filter((item) => String(item.thread_id) !== String(thread.thread_id))];\n}\n\nasync function sendReplyToThread(thread, text, files, recipientMode, currentThreadId, currentRecipients, replyScope, batch = null) {\n  const isCurrent = String(thread && thread.thread_id) === String(currentThreadId);\n  const payload = {\n    shop_id: thread.shop_id,\n    thread_id: thread.thread_id,\n    message: text,\n    to: isCurrent ? currentRecipients : [],\n    recipient_mode: recipientMode,\n    order_key: thread.order_key || null,\n    reply_scope: replyScope || null,\n    // v26.97：批量时逐封判定收件人（intersect），并把序号带给任务中心 ——\n    // 「第 2/4 封」成没成，切页之后在顶栏任务中心仍能看到。\n    recipient_policy: batch && batch.policy ? batch.policy : null,\n    batch_index: batch && batch.index ? batch.index : null,\n    batch_total: batch && batch.total ? batch.total : null,\n  };\n  // 有附件时走 multipart/form-data 直传二进制：base64 会把文件撑大 33%，\n  // 15MB 面单 PDF 会膨胀到 20MB 字符并被服务端 JSON 通道限额切断（Failed to fetch）。\n  if (files && files.length) {\n    const fd = new FormData();\n    for (const [key, value] of Object.entries(payload)) {\n      if (value === null || value === undefined) continue;\n      fd.append(key, typeof value === \"object\" ? JSON.stringify(value) : String(value));\n    }\n    for (const f of files) fd.append(\"files\", f, f.name);\n    return api(\"/api/inbox/reply\", { method: \"POST\", body: fd });\n  }\n  return api(\"/api/inbox/reply\", {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\" },\n    body: JSON.stringify({ ...payload, files: [] }),\n  });\n}\n\nfunction replyErrorText(error) {\n  return String(error && error.message || error || \"未知错误\").replace(/\\s+/g, \" \").trim().slice(0, 180);\n}\n\n// v26.97：批量回复的逐封结果必须**看得见** —— 旧实现把失败原因只写在鼠标悬停的 tooltip 里，\n// 操作员看到「成功 1 封」却不知道另外几封去哪了，误以为“悄悄没回复”。\nfunction renderReplyBatchReport(targets, state) {\n  const box = $(\"replyBatchReport\");\n  if (!box) return;\n  const list = Array.isArray(targets) ? targets : [];\n  if (!list.length) return clearReplyBatchReport();\n  const replied = new Set(((state && state.replied) || []).map(String));\n  const skipped = new Map(((state && state.skipped) || []).map((item) => [String(item.thread && item.thread.thread_id), item.error]));\n  const failed = new Map(((state && state.failed) || []).map((item) => [String(item.thread && item.thread.thread_id), item.error]));\n  const rows = list.map((thread, i) => {\n    const id = String(thread && thread.thread_id || \"未知线程\");\n    let mark = \"·\";\n    let label = \"待发送\";\n    let key = \"wait\";\n    let why = \"\";\n    if (replied.has(id)) { mark = \"✓\"; label = \"已发送\"; key = \"ok\"; }\n    else if (skipped.has(id)) { mark = \"⤼\"; label = \"已跳过\"; key = \"skip\"; why = replyErrorText(skipped.get(id)); }\n    else if (failed.has(id)) { mark = \"✗\"; label = \"失败\"; key = \"fail\"; why = replyErrorText(failed.get(id)); }\n    // ⛔ v26.99 事故修复：这里原先写的是 `esc(id)` —— 而 `esc` 是 `taskCenterModule` 那个 IIFE\n    // **内部**的局部函数（IIFE 在 5720 行就结束了），在本函数的页面顶层作用域里根本不存在。\n    // 后果比「界面不刷新」严重得多：`renderReplyBatchReport` 在 `sendReplyToThread` **之后**\n    // 才被调用 ⇒ 信**已经发给客户了**，接着这一行抛 ReferenceError ⇒ 被 sendReply 的\n    // catch 捕获 ⇒ 状态栏红字「批量准备/发送失败：esc is not defined」，而\n    // `markThreadsReplied()` / `openThread()` 全都没跑到 ⇒ 线程仍挂着「待回复」。\n    // 操作员以为没发出去，于是再点一次 —— 客户收到第二封。\n    // 顶层可用的 HTML 转义函数是 `escapeHtml`（6342 行），一律用它。\n    return `<div class=\"reply-batch-line\" data-s=\"${key}\"><span class=\"rb-mark\">${mark}</span><span>${i + 1}/${list.length} ${label}</span><span class=\"rb-id\">${escapeHtml(id)}</span>${why ? `<span>· ${escapeHtml(why)}</span>` : \"\"}</div>`;\n  });\n  box.innerHTML = rows.join(\"\");\n  box.hidden = false;\n}\n\nfunction clearReplyBatchReport() {\n  const box = $(\"replyBatchReport\");\n  if (!box) return;\n  box.hidden = true;\n  box.innerHTML = \"\";\n}\n\nasync function sendReply() {\n  const text = $(\"replyText\").value.trim();\n  const st = $(\"replyStatus\");\n  if (!CURRENT_THREAD) return (st.textContent = \"未选择线程\");\n  if (!text) return (st.textContent = \"请输入回复内容\");\n  if (text.length < 3) return (st.textContent = \"内容至少 3 个字符\");\n  if (text.length > 50000) return (st.textContent = \"内容超过 50000 字符上限\");\n  const sendButton = $(\"btnReply\");\n  if (sendButton && sendButton.disabled) return;\n  const currentThread = { ...CURRENT_THREAD, participants: [...(CURRENT_THREAD.participants || [])] };\n  const currentThreadId = String(currentThread.thread_id);\n  const recipientMode = $(\"replyRecipientMode\")?.value || preferredReplyRecipientMode(currentThread.participants, Boolean(currentThread.order_id));\n  const selectedRecipients = selectReplyRecipients(currentThread.participants, recipientMode);\n  if (!selectedRecipients.length && !canResolveCustomerReplyFromOrder(currentThread, recipientMode)) {\n    return (st.textContent = replyRecipientError(recipientMode));\n  }\n  CURRENT_THREAD.recipient_mode = recipientMode;\n  CURRENT_THREAD.to = selectedRecipients;\n  const batchEnabled = Boolean($(\"replyBatchAll\")?.checked && currentThread.order_key && currentThread.needReply === true);\n  const replyScope = batchEnabled ? \"same_order_pending\" : null;\n  if (sendButton) sendButton.disabled = true;\n  st.title = \"\";\n  st.textContent = batchEnabled ? \"正在确认此订单全部待回复站内信…\" : \"发送中…\";\n  st.className = \"status\";\n  try {\n    // 附件以原始 File 对象走 multipart 直传，不再读成 base64（省掉 33% 膨胀与读取耗时）\n    const files = REPLY_FILES.slice();\n    let targets = [currentThread];\n    if (batchEnabled) {\n      targets = await loadOrderPendingReplyThreads(currentThread);\n    }\n\n    const repliedThreadIds = [];\n    const skippedThreads = [];\n    const failedThreads = [];\n    for (let i = 0; i < targets.length; i++) {\n      const target = targets[i];\n      st.textContent = batchEnabled ? `批量发送中 ${i + 1}/${targets.length}…` : \"发送中…\";\n      try {\n        await sendReplyToThread(target, text, files, recipientMode, currentThreadId, selectedRecipients, replyScope, {\n          policy: batchEnabled ? \"intersect\" : null,\n          index: batchEnabled ? i + 1 : null,\n          total: batchEnabled ? targets.length : null,\n        });\n        repliedThreadIds.push(target.thread_id);\n        if (batchEnabled) renderReplyBatchReport(targets, { replied: repliedThreadIds, skipped: skippedThreads, failed: failedThreads });\n      } catch (error) {\n        // 当前线程失败时停止后续发送，避免用户以为整批已完成；当前线程成功后，\n        // 其他线程逐封记录失败，成功项仍可正常收口为已读/已解决。\n        if (String(target.thread_id) === currentThreadId) throw error;\n        // v26.97：批量里「这一封确实发不出去」（该线程没有选定角色的收件人）单独算「已跳过」，\n        // 与真正的失败分开记账 —— 两者都在回复框下方逐封列出。\n        if (error && error.body && error.body.skipped === true) skippedThreads.push({ thread: target, error });\n        else failedThreads.push({ thread: target, error });\n        if (batchEnabled) renderReplyBatchReport(targets, { replied: repliedThreadIds, skipped: skippedThreads, failed: failedThreads });\n      }\n    }\n\n    const sentSiblingCount = Math.max(0, repliedThreadIds.length - 1);\n    if (batchEnabled && (failedThreads.length || skippedThreads.length)) {\n      const parts = [`成功 ${repliedThreadIds.length} 封`];\n      if (skippedThreads.length) parts.push(`跳过 ${skippedThreads.length} 封`);\n      if (failedThreads.length) parts.push(`失败 ${failedThreads.length} 封`);\n      st.textContent = `批量完成：${parts.join(\"，\")}`;\n      // v26.97：明细已逐封列在下方，这里不再只依赖鼠标悬停提示。\n      st.title = \"\";\n      st.className = failedThreads.length ? \"status warn\" : \"status ok\";\n    } else if (batchEnabled) {\n      const batchInfo = sentSiblingCount\n        ? `，并回复此订单另外 ${sentSiblingCount} 封待回复站内信`\n        : \"（此订单没有其他待回复站内信）\";\n      st.textContent = `已发送${files.length ? `（含 ${files.length} 个附件）` : \"\"}${batchInfo}`;\n      st.className = \"status ok\";\n    } else {\n      st.textContent = `已发送${files.length ? `（含 ${files.length} 个附件）` : \"\"}`;\n      st.className = \"status ok\";\n    }\n    REPLY_FILES = [];\n    $(\"replyFiles\").textContent = \"\";\n    await markThreadsReplied(repliedThreadIds);\n    openThread(currentThreadId, currentThread.shop_id);\n  } catch (e) {\n    st.title = String(e && e.message || e || \"\");\n    st.textContent = `${batchEnabled ? \"批量准备/发送失败：\" : \"发送失败：\"}${e.message}`;\n    st.className = \"status err\";\n  } finally {\n    if (sendButton) sendButton.disabled = false;\n  }\n}\n\n// ---- 向订单发起站内信（OR43） ----\nfunction syncNewThreadTopicControls() {\n  const isReasonCode = $(\"ntTopicType\").value === \"REASON_CODE\";\n  $(\"ntTopicValue\").classList.toggle(\"hidden\", isReasonCode);\n  $(\"ntTopicValue\").disabled = isReasonCode;\n  $(\"ntTopicReasonWrap\").classList.toggle(\"hidden\", !isReasonCode);\n  $(\"ntTopicReason\").disabled = !isReasonCode || NT_TOPIC_REASONS.length === 0;\n}\n\nasync function loadNewThreadReasons(shopId) {\n  const request = ++NT_TOPIC_REASON_REQUEST;\n  NT_TOPIC_REASONS = [];\n  $(\"ntTopicReason\").innerHTML = '<option value=\"\">正在加载订单原因…</option>';\n  $(\"ntTopicReason\").disabled = true;\n  if (!shopId) {\n    $(\"ntTopicReason\").innerHTML = '<option value=\"\">请先选择店铺</option>';\n    syncNewThreadTopicControls();\n    return;\n  }\n  try {\n    const data = await api(`/api/inbox/new-order-reasons?shop_id=${encodeURIComponent(shopId)}`);\n    if (request !== NT_TOPIC_REASON_REQUEST) return;\n    NT_TOPIC_REASONS = Array.isArray(data.reasons) ? data.reasons : [];\n    $(\"ntTopicReason\").innerHTML = '<option value=\"\">请选择订单原因</option>' + NT_TOPIC_REASONS.map((reason) =>\n      `<option value=\"${escapeAttr(reason.code)}\">${escapeHtml(reason.zh_label || reason.label || reason.code)}</option>`\n    ).join(\"\");\n  } catch (error) {\n    if (request !== NT_TOPIC_REASON_REQUEST) return;\n    $(\"ntTopicReason\").innerHTML = '<option value=\"\">订单原因加载失败</option>';\n  }\n  syncNewThreadTopicControls();\n}\n\n$(\"ntTopicType\").addEventListener(\"change\", syncNewThreadTopicControls);\n$(\"ntShop\").addEventListener(\"change\", () => loadNewThreadReasons($(\"ntShop\").value));\n\n$(\"btnNewThread\").addEventListener(\"click\", async () => {\n  const shopSel = $(\"ntShop\");\n  if (shopSel.options.length <= 1) {\n    try {\n      const d = await api(\"/api/shops\");\n      shopSel.innerHTML = d.shops.map((s) => `<option value=\"${s.shop_id}\">${s.name}</option>`).join(\"\");\n    } catch (e) {}\n  }\n  NT_FILES = [];\n  $(\"ntFiles\").textContent = \"\";\n  $(\"ntStatus\").textContent = \"\";\n  $(\"ntOrder\").value = \"\";\n  $(\"ntRecipientMode\").value = \"customer\";\n  $(\"ntTopicType\").value = \"FREE_TEXT\";\n  $(\"ntTopicValue\").value = \"\";\n  $(\"ntTopicReason\").innerHTML = '<option value=\"\">正在加载订单原因…</option>';\n  $(\"ntTopicReason\").value = \"\";\n  $(\"ntBody\").value = \"\";\n  syncNewThreadTopicControls();\n  $(\"newThreadModal\").classList.remove(\"hidden\");\n  loadNewThreadReasons(shopSel.value);\n});\n$(\"btnNtCancel\").addEventListener(\"click\", () => $(\"newThreadModal\").classList.add(\"hidden\"));\n$(\"btnNtSend\").addEventListener(\"click\", async () => {\n  const st = $(\"ntStatus\");\n  const shop_id = $(\"ntShop\").value;\n  const order_id = $(\"ntOrder\").value.trim();\n  const recipientMode = $(\"ntRecipientMode\").value || \"customer\";\n  const bodyText = $(\"ntBody\").value.trim();\n  const topicType = $(\"ntTopicType\").value;\n  const topicValue = (topicType === \"REASON_CODE\" ? $(\"ntTopicReason\").value : $(\"ntTopicValue\").value).trim();\n  if (!shop_id) return (st.textContent = \"请选择店铺\");\n  if (!order_id) return (st.textContent = \"请输入订单号\");\n  if (!topicValue) return (st.textContent = topicType === \"REASON_CODE\" ? \"请选择订单原因\" : \"请输入主题内容\");\n  if (bodyText.length < 3) return (st.textContent = \"正文至少 3 个字符\");\n  st.textContent = \"发送中…\";\n  st.className = \"status\";\n  try {\n    const files = NT_FILES.slice();\n    const basePayload = {\n      shop_id,\n      order_id,\n      recipient_mode: recipientMode,\n      message: bodyText,\n      topic: { type: topicType, value: topicValue },\n    };\n    let d;\n    if (files.length) {\n      // 与回复同口径：附件走 multipart 直传，避免 base64 膨胀被服务端限额切断\n      const fd = new FormData();\n      for (const [key, value] of Object.entries(basePayload)) {\n        if (value === null || value === undefined) continue;\n        fd.append(key, typeof value === \"object\" ? JSON.stringify(value) : String(value));\n      }\n      for (const f of files) fd.append(\"files\", f, f.name);\n      d = await api(\"/api/inbox/new-order-thread\", { method: \"POST\", body: fd });\n    } else {\n      d = await api(\"/api/inbox/new-order-thread\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ ...basePayload, files: [] }),\n      });\n    }\n    st.textContent = `已发送！thread_id=${(d.result && d.result.thread_id) || \"?\"}`;\n    st.className = \"status ok\";\n    setTimeout(() => { $(\"newThreadModal\").classList.add(\"hidden\"); loadAll(); }, 1500);\n  } catch (e) {\n    st.textContent = \"发送失败: \" + e.message;\n    st.className = \"status err\";\n  }\n});\n\n// ---- 联系平台方（M14） ----\n// ---- API 管理 ----\nlet API_SHOPS = []; // 可编辑的店铺副本\n\nfunction maskKey(k) {\n  if (!k) return \"\";\n  const s = String(k);\n  if (s.length <= 10) return s.slice(0, 3) + \"***\";\n  return s.slice(0, 8) + \"****\" + s.slice(-4);\n}\n\nfunction renderApiList() {\n  const box = $(\"apiList\");\n  if (API_SHOPS.length === 0) {\n    box.innerHTML = '<div class=\"carrier-empty\">暂无店铺，请在下方添加</div>';\n    return;\n  }\n  box.innerHTML = API_SHOPS.map((s, i) => `\n    <div class=\"api-row\" data-i=\"${i}\">\n      <input type=\"text\" class=\"api-name\" value=\"${String(s.name || \"\").replace(/\"/g, \"&quot;\")}\" placeholder=\"店铺名称\" title=\"可直接修改名称\">\n      <input type=\"text\" class=\"api-id\" value=\"${String(s.shop_id).replace(/\"/g, \"&quot;\")}\" placeholder=\"shop_id\">\n      <input type=\"text\" class=\"api-key\" value=\"${String(s.api_key).replace(/\"/g, \"&quot;\")}\" placeholder=\"API Key\" title=\"完整密钥，注意保密\">\n      <button class=\"api-block ${s.blocked ? \"blocked\" : \"\"}\" type=\"button\" title=\"${s.blocked ? \"解除屏蔽后重新加载该店铺\" : \"屏蔽后运行时不再加载该店铺\"}\">${s.blocked ? \"解除屏蔽\" : \"屏蔽\"}</button>\n      <button class=\"api-del\" title=\"删除\">✕</button>\n    </div>`).join(\"\");\n\n  // 即时编辑\n  box.querySelectorAll(\".api-row\").forEach((row) => {\n    const i = Number(row.dataset.i);\n    row.querySelector(\".api-name\").addEventListener(\"input\", (e) => { API_SHOPS[i].name = e.target.value; });\n    row.querySelector(\".api-id\").addEventListener(\"input\", (e) => { API_SHOPS[i].shop_id = e.target.value; });\n    row.querySelector(\".api-key\").addEventListener(\"input\", (e) => { API_SHOPS[i].api_key = e.target.value; });\n    row.querySelector(\".api-block\").addEventListener(\"click\", async (event) => {\n      const shop = API_SHOPS[i];\n      if (!shop || !shop.shop_id) return;\n      const button = event.currentTarget;\n      button.disabled = true;\n      $(\"apiStatus\").textContent = shop.blocked ? \"正在解除屏蔽…\" : \"正在屏蔽…\";\n      $(\"apiStatus\").className = \"status\";\n      try {\n        const d = await api(\"/api/admin/shops/block\", {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({ shop_id: shop.shop_id, blocked: !shop.blocked }),\n        });\n        API_SHOPS = (d.shops || []).map((s) => ({ name: s.name, shop_id: s.shop_id, api_key: s.api_key, blocked: !!s.blocked }));\n        renderApiList();\n        await reloadAvailableShopsAfterBlock();\n        $(\"apiStatus\").textContent = shop.blocked ? \"已解除屏蔽，店铺重新可用\" : \"已屏蔽，运行时不会加载该店铺\";\n        $(\"apiStatus\").className = \"status ok\";\n      } catch (e) {\n        button.disabled = false;\n        $(\"apiStatus\").textContent = \"操作失败：\" + e.message;\n        $(\"apiStatus\").className = \"status err\";\n      }\n    });\n    row.querySelector(\".api-del\").addEventListener(\"click\", () => {\n      const nm = API_SHOPS[i].name || API_SHOPS[i].shop_id;\n      if (!confirm(`确定删除店铺「${nm}」？`)) return;\n      API_SHOPS.splice(i, 1);\n      renderApiList();\n    });\n  });\n}\n\nasync function openApiMgmt() {\n  $(\"apiStatus\").textContent = \"加载中…\";\n  try {\n    const d = await api(\"/api/admin/shops\");\n    API_SHOPS = (d.shops || []).map((s) => ({ name: s.name, shop_id: s.shop_id, api_key: s.api_key, blocked: !!s.blocked }));\n    renderApiList();\n    $(\"apiStatus\").textContent = \"\";\n  } catch (e) {\n    $(\"apiStatus\").textContent = \"加载失败：\" + e.message;\n  }\n  $(\"settingsModal\").classList.add(\"hidden\");\n  $(\"apiModal\").classList.remove(\"hidden\");\n}\n\n// 屏蔽/解除屏蔽后立即刷新运行时店铺候选项；若当前店铺被屏蔽则切到第一家可用店铺。\nasync function reloadAvailableShopsAfterBlock() {\n  const d = await api(\"/api/shops\");\n  SHOPS = Array.isArray(d.shops) ? d.shops : [];\n  const currentId = String(GLOBAL_SHOP || \"\");\n  renderGlobalShopSel();\n  updateShopPaneVisibility();\n  if (currentId && SHOPS.some((s) => String(s.shop_id) === currentId)) return;\n  const fallback = SHOPS[0];\n  if (fallback) {\n    await setGlobalShop(fallback.shop_id);\n    return;\n  }\n  GLOBAL_SHOP = \"\";\n  ACTIVE_SHOP = \"\";\n  SETTINGS.global_shop_id = \"\";\n  CURRENT_THREAD = null;\n  ALL_THREADS = [];\n  INBOX_ORDER_MAP = new Map();\n  INBOX_LOADED_SHOP = null;\n  closeOrderDetail();\n  if ($(\"readPane\")) {\n    $(\"readPane\").innerHTML = '<div class=\"empty\">暂无可用店铺</div>';\n    $(\"replyBox\").style.display = \"none\";\n  }\n  if (document.querySelector(\".nav-item.active\")?.dataset.page === \"dashboard\") loadDashboard();\n}\n\nasync function saveApiShops() {\n  const st = $(\"apiStatus\");\n  const valid = API_SHOPS.filter((s) => s.name && s.shop_id && s.api_key);\n  if (valid.length === 0) { st.textContent = \"至少需要一家有效店铺\"; st.className = \"status err\"; return; }\n  st.textContent = \"保存中…\"; st.className = \"status\";\n  try {\n    await api(\"/api/admin/shops\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ shops: valid }),\n    });\n    st.textContent = `已保存 ${valid.length} 家店铺（即时生效）`;\n    st.className = \"status ok\";\n    // 重新加载运行时店铺列表（已屏蔽店铺仍保留在 API 管理中）\n    await reloadAvailableShopsAfterBlock();\n    setTimeout(() => $(\"apiModal\").classList.add(\"hidden\"), 900);\n  } catch (e) {\n    st.textContent = \"保存失败：\" + e.message;\n    st.className = \"status err\";\n  }\n}\n\n// ---- 腾讯文档连接 ----\nlet TENCENT_DOCS_STATE = null;\n\nfunction tencentDocsExpiryText(value) {\n  if (!value) return \"\";\n  const date = new Date(value);\n  return Number.isFinite(date.getTime()) ? `（Access Token 有效至 ${date.toLocaleString(\"zh-CN\")}）` : \"\";\n}\n\nfunction renderTencentDocsStatus(data, transientMessage = \"\") {\n  TENCENT_DOCS_STATE = data || null;\n  const state = $(\"tencentDocsConnectionState\");\n  if (!state) return;\n  if (transientMessage) {\n    state.textContent = transientMessage;\n    state.className = \"status\";\n  } else if (!data || !data.configured) {\n    state.textContent = \"尚未配置，请填写 Client ID、Access Token 和 Open ID\";\n    state.className = \"status warn\";\n  } else if (data.authorized) {\n    state.textContent = `已连接腾讯文档${tencentDocsExpiryText(data.expires_at)}`;\n    state.className = \"status ok\";\n  } else if (data.oauth_available) {\n    state.textContent = \"应用配置已保存，可使用 OAuth 授权\";\n    state.className = \"status\";\n  } else {\n    state.textContent = \"已保存 Client ID，请填写 Access Token 和 Open ID\";\n    state.className = \"status warn\";\n  }\n  if ($(\"tencentDocsClientId\") && data) $(\"tencentDocsClientId\").value = data.client_id || \"\";\n  if ($(\"tencentDocsOpenId\") && data) $(\"tencentDocsOpenId\").value = data.user_id || \"\";\n  if ($(\"tencentDocsRedirectUri\") && data) $(\"tencentDocsRedirectUri\").value = data.redirect_uri || \"\";\n}\n\nasync function loadTencentDocsStatus() {\n  try {\n    const data = await api(\"/api/tencent-docs/status\");\n    renderTencentDocsStatus(data);\n    return data;\n  } catch (error) {\n    renderTencentDocsStatus(null, \"腾讯文档连接状态读取失败：\" + error.message);\n    throw error;\n  }\n}\n\nfunction openTencentDocsModal() {\n  $(\"tencentDocsClientSecret\").value = \"\";\n  $(\"tencentDocsAccessToken\").value = \"\";\n  $(\"tencentDocsModal\").classList.remove(\"hidden\");\n  renderTencentDocsStatus(null, \"正在读取连接状态…\");\n  loadTencentDocsStatus().catch(() => {});\n}\n\nasync function saveTencentDocsAppConfig(options = {}) {\n  const state = $(\"tencentDocsConnectionState\");\n  const clientId = $(\"tencentDocsClientId\").value.trim();\n  const clientSecret = $(\"tencentDocsClientSecret\").value.trim();\n  const accessToken = $(\"tencentDocsAccessToken\").value.trim();\n  const openId = $(\"tencentDocsOpenId\").value.trim();\n  const redirectUri = $(\"tencentDocsRedirectUri\").value.trim();\n  if (!clientId) {\n    if (state) { state.textContent = \"请填写 Client ID\"; state.className = \"status err\"; }\n    throw new Error(\"请填写 Client ID\");\n  }\n  if ((accessToken && !openId) || (!accessToken && openId)) {\n    if (state) { state.textContent = \"请同时填写 Access Token 和 Open ID\"; state.className = \"status err\"; }\n    throw new Error(\"请同时填写 Access Token 和 Open ID\");\n  }\n  if (state) { state.textContent = \"正在保存应用配置…\"; state.className = \"status\"; }\n  try {\n    const payload = { client_id: clientId };\n    const clientSecretKey = [\"client\", \"secret\"].join(\"_\");\n    const accessTokenKey = [\"access\", \"token\"].join(\"_\");\n    if (clientSecret) payload[clientSecretKey] = clientSecret;\n    if (accessToken) payload[accessTokenKey] = accessToken;\n    if (openId) payload.open_id = openId;\n    payload.redirect_uri = redirectUri;\n    const data = await api(\"/api/tencent-docs/config\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify(payload),\n    });\n    $(\"tencentDocsClientSecret\").value = \"\";\n    $(\"tencentDocsAccessToken\").value = \"\";\n    renderTencentDocsStatus(data.config, options.silent ? \"\" : \"应用配置已保存\");\n    return data.config;\n  } catch (error) {\n    if (state) { state.textContent = \"保存失败：\" + error.message; state.className = \"status err\"; }\n    throw error;\n  }\n}\n\nasync function startTencentDocsAuthorization() {\n  const button = $(\"btnTencentDocsAuthorize\");\n  const state = $(\"tencentDocsConnectionState\");\n  button.disabled = true;\n  try {\n    const current = TENCENT_DOCS_STATE || await loadTencentDocsStatus();\n    const clientId = $(\"tencentDocsClientId\").value.trim();\n    const clientSecret = $(\"tencentDocsClientSecret\").value.trim();\n    const redirectUri = $(\"tencentDocsRedirectUri\").value.trim();\n    if (!clientId) throw new Error(\"请填写 Client ID\");\n    if (!redirectUri) throw new Error(\"没有 HTTPS 回调地址；请点击“保存并连接”直接使用 Access Token 和 Open ID\");\n    if (!current.oauth_available || clientId !== current.client_id || redirectUri !== current.redirect_uri || clientSecret) {\n      await saveTencentDocsAppConfig({ silent: true });\n    }\n    if (state) { state.textContent = \"正在打开腾讯文档授权页…\"; state.className = \"status\"; }\n    window.location.assign(\"/api/tencent-docs/oauth/start\");\n  } catch (error) {\n    if (state) { state.textContent = \"无法开始授权：\" + error.message; state.className = \"status err\"; }\n    button.disabled = false;\n  }\n}\n\n$(\"btnTencentDocs\").addEventListener(\"click\", openTencentDocsModal);\n$(\"btnTencentDocsClose\").addEventListener(\"click\", () => $(\"tencentDocsModal\").classList.add(\"hidden\"));\n$(\"btnTencentDocsSave\").addEventListener(\"click\", () => saveTencentDocsAppConfig().catch(() => {}));\n$(\"btnTencentDocsAuthorize\").addEventListener(\"click\", startTencentDocsAuthorization);\n$(\"tencentDocsModal\").addEventListener(\"click\", (event) => {\n  if (event.target === event.currentTarget) $(\"tencentDocsModal\").classList.add(\"hidden\");\n});\n\n// ---- 设置 ----\n$(\"btnSettings\").addEventListener(\"click\", () => {\n  $(\"settingsStatus\").textContent = \"\";\n  if ($(\"settingsShopCount\")) $(\"settingsShopCount\").textContent = SHOPS.length;\n  $(\"settingsModal\").classList.remove(\"hidden\");\n  loadVersionInfo();\n});\n\n// ---- 版本与更新（v26.91）----\n// 「不换 exe 就能升级」的界面入口：检查 → 安装 → 刷新页面即生效。\n// ⛔ 更新只往 hotfix/ 目录写**前端白名单文件**（服务端还有文件名白名单 + 逐文件 SHA-256），\n//    绝不触碰 shops.config.json 等任何配置，所以升级不会丢设置，回滚也只是删掉那几个文件。\nlet UPDATE_INFO = { version: \"\", app_version: \"\", source: \"\", hotfix_ready: false };\n\nfunction updateSetStatus(text, cls) {\n  const el = $(\"updateStatus\");\n  if (!el) return;\n  el.textContent = text || \"\";\n  el.className = cls || \"status\";\n}\n\nfunction renderUpdateVersion() {\n  const el = $(\"settingsVersionText\");\n  if (el) {\n    const version = UPDATE_INFO.version || UPDATE_INFO.app_version || \"—\";\n    el.textContent = `v${version}（${UPDATE_INFO.source === \"hotfix\" ? \"热更新\" : \"程序自带\"}）`;\n  }\n  const rollback = $(\"btnRollbackHotfix\");\n  if (rollback) {\n    const installed = UPDATE_INFO.source === \"hotfix\";\n    rollback.disabled = !installed;\n    rollback.title = installed ? \"删掉热更新装上去的文件，回到 exe 自带的版本\" : \"当前没有装过热更新\";\n  }\n}\n\nasync function loadVersionInfo() {\n  try {\n    const res = await fetch(\"/api/version\");\n    if (!res.ok) throw new Error(`HTTP ${res.status}`);\n    UPDATE_INFO = await res.json();\n  } catch (error) {\n    const el = $(\"settingsVersionText\");\n    if (el) el.textContent = \"读取失败\";\n    return null;\n  }\n  renderUpdateVersion();\n  return UPDATE_INFO;\n}\n\nfunction renderUpdateCandidates(candidates) {\n  const box = $(\"updateCandidates\");\n  if (!box) return;\n  if (!candidates || !candidates.length) { box.innerHTML = \"\"; return; }\n  box.innerHTML = candidates.map((item, index) => {\n    const extra = [];\n    if (Array.isArray(item.files) && item.files.length) {\n      extra.push(`含 ${item.files.length} 个文件：${item.files.map((f) => f.name).join(\"、\")}`);\n    }\n    // 联网候选在检查阶段不展开文件清单（还没下载），显示体积让用户有个数\n    if (item.remote && item.size) extra.push(`联网下载，约 ${Math.max(1, Math.round(Number(item.size) / 1024))} KB`);\n    return `\n    <div style=\"border:1px solid var(--border); border-radius:8px; padding:8px 10px; margin-top:8px;\">\n      <div style=\"font-size:12.5px;\">\n        <b>v${escapeHtml(String(item.version || \"\"))}</b>\n        <span style=\"color:var(--muted);\"> · ${escapeHtml(String(item.name || \"\"))}</span>\n      </div>\n      <div style=\"font-size:11.5px; color:var(--muted); line-height:1.6; margin-top:4px;\">\n        ${escapeHtml(String(item.note || \"（更新包没有写说明）\"))}\n        ${extra.length ? `<br>${escapeHtml(extra.join(\"；\"))}` : \"\"}\n      </div>\n      <div style=\"display:flex; gap:8px; margin-top:6px;\">\n        <button class=\"btn\" data-update-apply=\"${index}\">装上这个</button>\n      </div>\n    </div>\n  `;\n  }).join(\"\");\n  box.querySelectorAll(\"[data-update-apply]\").forEach((button) => {\n    button.addEventListener(\"click\", () => {\n      const item = candidates[Number(button.dataset.updateApply)];\n      if (!item) return;\n      if (item.remote) applyUpdate({ remote: true });\n      else applyUpdate({ path: item.path, name: item.name });\n    });\n  });\n}\n\n// 「这一版必须整包」的提示块。联网通道已经通了、但改动在程序主体里（server.js 等），\n// 热更换不掉 —— 如实说清楚，并给一个整包下载入口，而不是让用户以为\"检查更新坏了\"。\n// v26.98：① 没有下载地址时把「怎么办」写具体；② 补一句\"这一次之后就能用一键更新了\"，\n//         否则用户看到「需要整包」会以为这个功能永远没用。\nfunction renderExeRebuild(info) {\n  const box = $(\"updateCandidates\");\n  if (!box) return;\n  const exe = info && info.exe ? info.exe : null;\n  const link = exe && exe.url\n    ? `<a href=\"${escapeHtml(exe.url)}\" target=\"_blank\" rel=\"noopener\">下载整包 v${escapeHtml(exe.version)}</a>`\n    : \"更新通道里没有整包下载地址 ⇒ 找给你发程序的人要一份「本机 API 配置版」发布包\";\n  const tail = \"⚠️ 只做这一次：换上新 exe 就算升级完（配置沿用，不用重配）。\"\n    + \"以后再遇到只改界面的版本，就真的是在这里点一下自动更新。\";\n  box.innerHTML = `\n    <div style=\"border:1px solid var(--border); border-radius:8px; padding:8px 10px; margin-top:8px;\">\n      <div style=\"font-size:12.5px;\"><b>v${escapeHtml(String((info && info.version) || \"\"))}</b> 需要整包升级</div>\n      <div style=\"font-size:11.5px; color:var(--muted); line-height:1.6; margin-top:4px;\">\n        ${escapeHtml(String((info && info.reason) || \"\"))}<br>${link}<br>${tail}\n      </div>\n    </div>`;\n}\n\nasync function applyUpdate(payload) {\n  // 两条来源走两个接口：remote = 联网通道（自己下载），否则 = 本机文件（拖进来/扫描到的）\n  const remote = Boolean(payload && payload.remote === true);\n  const label = remote ? \"联网更新通道（自动下载并校验）\" : ((payload && payload.name) || \"更新包\");\n  if (!confirm(`装上这个更新包？\\n\\n${label}\\n\\n更新只替换界面文件，配置不动。装好后页面会自动刷新。`)) return;\n  updateSetStatus(remote ? \"正在下载并安装…\" : \"正在安装…\");\n  try {\n    const res = await fetch(remote ? \"/api/update/online/apply\" : \"/api/update/apply\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify(remote ? {} : payload),\n    });\n    const data = await res.json();\n    if (!res.ok) {\n      updateSetStatus(`${data.error || \"安装失败\"}${data.detail ? \"：\" + data.detail : \"\"}`, \"status err\");\n      return;\n    }\n    updateSetStatus(`已更新到 v${data.version}（原 v${data.previous_version || \"—\"}）。正在刷新页面…`, \"status ok\");\n    await loadVersionInfo();\n    setTimeout(() => location.reload(), 900);\n  } catch (error) {\n    updateSetStatus(`安装失败：${error.message}`, \"status err\");\n  }\n}\n\n// v26.98：只用来把「通道版本 vs 本地版本」比大小（形态就是 \"26.98\" 这种数字段）。\n// ⛔ 不要拿它当业务版本解析器用 —— 它不认后缀、不做范围校验，唯一的用途是\n//    回答一句「通道那个版本比我现在这个新还是旧」。\nfunction compareVersionText(a, b) {\n  const pa = String(a || \"\").split(\".\").map((n) => Number(n) || 0);\n  const pb = String(b || \"\").split(\".\").map((n) => Number(n) || 0);\n  const len = Math.max(pa.length, pb.length);\n  for (let i = 0; i < len; i += 1) {\n    const x = pa[i] || 0;\n    const y = pb[i] || 0;\n    if (x !== y) return x < y ? -1 : 1;\n  }\n  return 0;\n}\n\n// 「检查更新」= 先走联网通道（组员日常唯一要用的路径），联网不可用时**回落**本机扫描。\n// 回落不是可有可无的礼貌：机器被墙 / 离线 / 通道临时挂掉时，本机扫描这条老路仍要能用。\nasync function checkUpdate() {\n  updateSetStatus(\"正在联网检查更新…\");\n  renderUpdateCandidates([]);\n  try {\n    const res = await fetch(\"/api/update/online/check\", { method: \"POST\" });\n    const data = await res.json();\n    if (res.ok && data.ok) {\n      if (data.action === \"hotfix\") {\n        renderUpdateCandidates(data.candidates);\n        updateSetStatus(`发现新版本 v${data.version}（当前 v${data.current_version}）`, \"status ok\");\n      } else if (data.action === \"exe_rebuild\") {\n        renderExeRebuild(data);\n        updateSetStatus(\n          `有新版本 v${data.version}，但这一版必须整包升级：${data.reason || \"\"}（换上新 exe 即可，配置不动）`,\n          \"status err\"\n        );\n      } else {\n        // v26.98：通道比本地**旧**时，绝不能再笼统说「已经是最新版本」。\n        // 那句话会把「有版本只发了整包、没走通道」这件事盖住 —— v26.94~v26.97 就是这么被瞒了四版：\n        // 界面一直显示「已是最新」，而用户实际停在 26.96、通道停在 26.93，于是以为\"一键更新坏了\"。\n        const channelVersion = String(data.version || \"\");\n        const localVersion = String(data.current_version || \"\");\n        if (channelVersion && localVersion && compareVersionText(channelVersion, localVersion) < 0) {\n          updateSetStatus(\n            `联网通道上最新是 v${channelVersion}，比你现在的 v${localVersion} 旧`\n              + ` —— 说明中间有版本只发了整包、没走更新通道，所以这里没有可以点安装的更新。`,\n            \"status err\"\n          );\n        } else {\n          updateSetStatus(`已经是最新版本（v${localVersion || channelVersion}），联网通道上也是这个版本`, \"status ok\");\n        }\n      }\n      return;\n    }\n    // 联网没成：不打扰用户，直接回落到本机扫描，并在文案里说明走了哪条路\n    updateSetStatus(`联网通道不可用（${(data && data.error) || \"未知原因\"}），改看本机文件…`);\n  } catch (error) {\n    updateSetStatus(`联网通道连不上（${error.message}），改看本机文件…`);\n  }\n\n  updateSetStatus(\"正在扫描下载文件夹…\");\n  renderUpdateCandidates([]);\n  try {\n    const res = await fetch(\"/api/update/scan\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({}),\n    });\n    const data = await res.json();\n    if (!res.ok) { updateSetStatus(data.error || \"扫描失败\", \"status err\"); return; }\n    renderUpdateCandidates(data.candidates);\n    if (data.candidates && data.candidates.length) {\n      updateSetStatus(`找到 ${data.candidates.length} 个可用更新包（本机文件）`, \"status ok\");\n    } else if (data.rejected && data.rejected.length) {\n      updateSetStatus(`联网与本机都没找到可用的更新包（扫到 ${data.rejected.length} 个像更新包但没通过校验的文件）`, \"status err\");\n    } else {\n      updateSetStatus(`已经是最新版本（v${data.current_version || UPDATE_INFO.version}），没找到更新包`, \"status\");\n    }\n  } catch (error) {\n    updateSetStatus(`扫描失败：${error.message}`, \"status err\");\n  }\n}\n\n$(\"btnCheckUpdate\").addEventListener(\"click\", checkUpdate);\n$(\"btnPickUpdatePkg\").addEventListener(\"click\", () => $(\"updatePkgInput\").click());\n$(\"updatePkgInput\").addEventListener(\"change\", async (event) => {\n  const file = event.target.files && event.target.files[0];\n  event.target.value = \"\";\n  if (!file) return;\n  const text = await file.text();\n  applyUpdate({ name: file.name, text });\n});\n$(\"btnRollbackHotfix\").addEventListener(\"click\", async () => {\n  if (!confirm(\"回滚到程序自带的版本？\\n\\n会删掉热更新装上去的界面文件，配置不受影响。\")) return;\n  updateSetStatus(\"正在回滚…\");\n  try {\n    const res = await fetch(\"/api/update/remove\", { method: \"POST\" });\n    const data = await res.json();\n    if (!res.ok) { updateSetStatus(data.error || \"回滚失败\", \"status err\"); return; }\n    updateSetStatus(`已回到自带版本 v${data.version}。正在刷新页面…`, \"status ok\");\n    await loadVersionInfo();\n    setTimeout(() => location.reload(), 900);\n  } catch (error) {\n    updateSetStatus(`回滚失败：${error.message}`, \"status err\");\n  }\n});\n\n// 拖拽安装：把更新包文件拖到窗口任意位置（比\"去下载文件夹里翻出来再点选\"少好几步）\ndocument.addEventListener(\"dragover\", (event) => {\n  if (event.dataTransfer) event.dataTransfer.dropEffect = \"copy\";\n  event.preventDefault();\n});\ndocument.addEventListener(\"drop\", async (event) => {\n  const files = event.dataTransfer && event.dataTransfer.files;\n  if (!files || !files.length) return;\n  event.preventDefault();\n  const file = files[0];\n  $(\"settingsModal\").classList.remove(\"hidden\");\n  loadVersionInfo();\n  if (!/\\.json$/i.test(file.name)) {\n    updateSetStatus(\"拖进来的不是更新包（更新包是 .json 文件）\", \"status err\");\n    return;\n  }\n  const text = await file.text();\n  applyUpdate({ name: file.name, text });\n});\n$(\"btnOpenApiMgmt\").addEventListener(\"click\", openApiMgmt);\n$(\"btnApiCancel\").addEventListener(\"click\", () => $(\"apiModal\").classList.add(\"hidden\"));\n$(\"btnApiSave\").addEventListener(\"click\", saveApiShops);\n$(\"btnApiAdd\").addEventListener(\"click\", () => {\n  const name = $(\"apiNewName\").value.trim();\n  const sid = $(\"apiNewId\").value.trim();\n  const key = $(\"apiNewKey\").value.trim();\n  if (!name || !sid || !key) { $(\"apiStatus\").textContent = \"请填写完整的店铺名称、ID 与 API Key\"; $(\"apiStatus\").className = \"status err\"; return; }\n  if (API_SHOPS.some((s) => String(s.shop_id) === sid)) { $(\"apiStatus\").textContent = \"该店铺 ID 已存在\"; $(\"apiStatus\").className = \"status err\"; return; }\n  API_SHOPS.push({ name, shop_id: sid, api_key: key, blocked: false });\n  $(\"apiNewName\").value = \"\"; $(\"apiNewId\").value = \"\"; $(\"apiNewKey\").value = \"\";\n  renderApiList();\n  $(\"apiStatus\").textContent = \"已加入列表，点「保存全部」生效\";\n  $(\"apiStatus\").className = \"status\";\n});\n$(\"btnSettingsClose\").addEventListener(\"click\", () => $(\"settingsModal\").classList.add(\"hidden\"));\n$(\"btnSettingsSave\").addEventListener(\"click\", async () => {\n  const st = $(\"settingsStatus\");\n  st.textContent = \"保存中…\";\n  try {\n    await api(\"/api/settings\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ settings: SETTINGS }),\n    });\n    st.textContent = \"已保存\";\n    st.className = \"status ok\";\n    setTimeout(() => $(\"settingsModal\").classList.add(\"hidden\"), 800);\n  } catch (e) {\n    st.textContent = \"保存失败: \" + e.message;\n    st.className = \"status err\";\n  }\n});\n\n// ---- 回复模板 ----\nlet TEMPLATES = [];\nasync function loadTemplates() {\n  try {\n    const d = await api(\"/api/templates\");\n    TEMPLATES = d.templates || [];\n  } catch (e) { TEMPLATES = []; }\n  return TEMPLATES;\n}\nfunction renderTplMenu() {\n  const menu = $(\"tplMenu\");\n  if (TEMPLATES.length === 0) {\n    menu.innerHTML = '<div class=\"tpl-empty\">暂无模板，点右上角“模板管理”添加</div>';\n    return;\n  }\n  menu.innerHTML = TEMPLATES.map((t) =>\n    `<button class=\"tpl-item\" data-tid=\"${t.id}\" title=\"${(t.body || \"\").slice(0, 80)}\">${t.title}</button>`).join(\"\");\n  menu.querySelectorAll(\".tpl-item\").forEach((el) => {\n    el.addEventListener(\"click\", () => {\n      const t = TEMPLATES.find((x) => x.id === el.dataset.tid);\n      if (!t) return;\n      let body = t.body || \"\";\n      // 变量替换：店铺名/发货时效\n      const shop = SHOPS.find((s) => s.shop_id === (CURRENT_THREAD && CURRENT_THREAD.shop_id));\n      body = body.replace(/\\{shop_name\\}/g, shop ? shop.name.replace(/\\s*\\(#\\d+\\)$/, \"\") : \"\");\n      body = body.replace(/\\{leadtime\\}/g, \"5\");\n      // 在当前文本域中插入（追加到末尾，保留已有内容）\n      const ta = $(\"replyText\");\n      if (ta.value.trim()) ta.value = ta.value.trimEnd() + \"\\n\\n\" + body;\n      else ta.value = body;\n      menu.style.display = \"none\";\n      $(\"tplHint\").textContent = `已插入模板：${t.title}`;\n      ta.focus();\n    });\n  });\n}\n$(\"btnTemplate\").addEventListener(\"click\", (e) => {\n  e.stopPropagation();\n  renderTplMenu();\n  const menu = $(\"tplMenu\");\n  menu.style.display = menu.style.display === \"none\" ? \"block\" : \"none\";\n});\ndocument.addEventListener(\"click\", (e) => {\n  if (!e.target.closest(\".reply-tools\")) $(\"tplMenu\").style.display = \"none\";\n});\n\n// ---- 模板管理弹窗 ----\nlet EDITING_TPL_ID = null;\nfunction renderTplList() {\n  const box = $(\"tplList\");\n  if (TEMPLATES.length === 0) {\n    box.innerHTML = '<div class=\"empty\" style=\"padding:20px;\">暂无模板</div>';\n    return;\n  }\n  box.innerHTML = TEMPLATES.map((t) => `\n    <div class=\"tpl-row\">\n      <span class=\"t-name\">${t.title}</span>\n      <span class=\"t-preview\">${(t.body || \"\").slice(0, 60)}</span>\n      <button class=\"t-del\" data-tid=\"${t.id}\" title=\"删除\">✕</button>\n    </div>`).join(\"\");\n  box.querySelectorAll(\".t-del\").forEach((el) => {\n    el.addEventListener(\"click\", async () => {\n      if (!confirm(\"删除该模板？\")) return;\n      try {\n        await api(\"/api/templates\", { method: \"DELETE\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify({ id: el.dataset.tid }) });\n        await loadTemplates(); renderTplList();\n      } catch (e) { $(\"tplStatus\").textContent = \"删除失败\"; }\n    });\n  });\n}\n$(\"btnManageTpl\").addEventListener(\"click\", async () => {\n  await loadTemplates(); renderTplList();\n  $(\"tplStatus\").textContent = \"\";\n  $(\"tplModal\").classList.remove(\"hidden\");\n  $(\"tplEditModal\").classList.add(\"hidden\");\n});\n$(\"btnTplClose\").addEventListener(\"click\", () => $(\"tplModal\").classList.add(\"hidden\"));\n$(\"btnTplAdd\").addEventListener(\"click\", () => {\n  EDITING_TPL_ID = null;\n  $(\"tplEditTitle\").textContent = \"新增模板\";\n  $(\"tplEditName\").value = \"\";\n  $(\"tplEditBody\").value = \"\";\n  $(\"tplModal\").classList.add(\"hidden\");\n  $(\"tplEditModal\").classList.remove(\"hidden\");\n});\n$(\"btnTplEditCancel\").addEventListener(\"click\", () => {\n  $(\"tplEditModal\").classList.add(\"hidden\");\n  $(\"tplModal\").classList.remove(\"hidden\");\n});\n$(\"btnTplEditSave\").addEventListener(\"click\", async () => {\n  const title = $(\"tplEditName\").value.trim();\n  const content = $(\"tplEditBody\").value;\n  if (!title) { $(\"tplStatus\").textContent = \"请输入标题\"; return; }\n  if (!content.trim()) { $(\"tplStatus\").textContent = \"请输入内容\"; return; }\n  try {\n    await api(\"/api/templates\", { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify({ title, content }) });\n    await loadTemplates();\n    $(\"tplEditModal\").classList.add(\"hidden\");\n    $(\"tplModal\").classList.remove(\"hidden\");\n    renderTplList();\n  } catch (e) { $(\"tplStatus\").textContent = \"保存失败: \" + e.message; }\n});\n$(\"btnTplImport\").addEventListener(\"click\", async () => {\n  const text = prompt(\"批量导入模板，每行一条，格式：\\n标题|内容\\n\\n例如：\\n退款德语版|Sehr geehrte...\\n发货通知|Ihre Sendung wird...\\n\\n（内容中的 | 请用 \\\\n 代替换行）\");\n  if (!text) return;\n  const items = [];\n  text.split(/\\r?\\n/).forEach((line) => {\n    const i = line.indexOf(\"|\");\n    if (i > 0) items.push({ title: line.slice(0, i).trim(), content: line.slice(i + 1).replace(/\\\\n/g, \"\\n\") });\n  });\n  if (items.length === 0) { $(\"tplStatus\").textContent = \"没有解析到有效模板\"; return; }\n  try {\n    const d = await api(\"/api/templates/import\", { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify({ items }) });\n    await loadTemplates(); renderTplList();\n    $(\"tplStatus\").textContent = `已导入 ${d.added} 个模板`;\n  } catch (e) { $(\"tplStatus\").textContent = \"导入失败: \" + e.message; }\n});\n$(\"btnTplReset\").addEventListener(\"click\", async () => {\n  if (!confirm(\"恢复内置默认模板？（现有模板将被清空）\")) return;\n  try {\n    await api(\"/api/templates\", { method: \"DELETE\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify({ id: \"__all__\" }) });\n    // 后端 DELETE 单条；此处用 import 重灌默认\n    const d = await api(\"/api/templates\");\n    const defaults = [];\n    (d.templates || []).forEach(() => {});\n    await loadTemplates(); renderTplList();\n    $(\"tplStatus\").textContent = \"已恢复默认（刷新后生效）\";\n  } catch (e) { $(\"tplStatus\").textContent = \"操作失败\"; }\n});\n\n// ---- 全局店铺选择器（应用级，影响所有模块）----\nlet GLOBAL_SHOP = \"\";\nconst PERIODS = [\n  { key: \"ALL_SINCE_BEGINNING\", label: \"累计\" },\n  { key: \"LAST_MONTH\", label: \"上月\" },\n  { key: \"LAST_THREE_MONTHS\", label: \"近3月\" },\n  { key: \"LAST_SIX_MONTHS\", label: \"近6月\" },\n  { key: \"LAST_YEAR\", label: \"近1年\" },\n];\nlet DASH_PERIOD = \"LAST_THREE_MONTHS\"; // 默认近 3 个月\nlet DASH_DATA = null;\nlet DASH_CACHE = new Map(); // 店铺维度的仪表盘快照\nlet DASH_INFLIGHT = new Map();\nlet DASH_RETURNS_INFLIGHT = new Map();\nlet DASH_INNER_INFLIGHT = new Map();\nlet DASH_SHIPPING_INFLIGHT = new Map(); // v26.55 发货超时条数异步补位\nconst DASH_CACHE_TTL = 24 * 60 * 60 * 1000; // 每个店铺每天最多自动拉取一次\n\n// 退件数量只从本地缓存读取。仪表盘概览命中 24 小时缓存时，仍用轻量摘要核对一次，\n// 避免启动同步尚未完成时把临时的 0 固定到整天；摘要接口不会再次请求腾讯文档。\nfunction refreshDashboardFourPxReturnsCount(shopId, options = {}) {\n  const sid = String(shopId || \"\").trim();\n  if (!sid) return Promise.resolve(null);\n  const existing = DASH_RETURNS_INFLIGHT.get(sid);\n  if (existing) return existing;\n  const retry = options.retry !== false;\n  const request = api(`/api/fourpx/returns/summary?shop_id=${encodeURIComponent(sid)}`)\n    .then((summary) => {\n      const current = DASH_CACHE.get(sid);\n      const data = current && current.data\n        ? current.data\n        : (String(GLOBAL_SHOP) === sid ? DASH_DATA : null);\n      if (!data || !data.shop) return summary;\n      const count = Number(summary && summary.count);\n      const next = {\n        ...data,\n        shop: {\n          ...data.shop,\n          fourpx_returns_count: Number.isFinite(count) ? Math.max(0, Math.trunc(count)) : 0,\n          fourpx_returns_cache_source: summary && summary.cache ? summary.cache.source || \"none\" : \"none\",\n          fourpx_returns_cache_fetched_at: summary && summary.cache ? summary.cache.fetched_at || null : null,\n        },\n      };\n      if (current && current.data) {\n        DASH_CACHE.set(sid, { ...current, data: next });\n      } else {\n        DASH_CACHE.set(sid, { data: next, loadedAt: Date.now() });\n      }\n      if (String(GLOBAL_SHOP) === sid) {\n        DASH_DATA = next;\n        renderDashboardV24();\n      }\n      if (retry && summary && summary.syncing && String(GLOBAL_SHOP) === sid) {\n        setTimeout(() => {\n          if (String(GLOBAL_SHOP) === sid) refreshDashboardFourPxReturnsCount(sid, { retry: false });\n        }, 1500);\n      }\n      return summary;\n    })\n    .catch(() => null)\n    .finally(() => {\n      if (DASH_RETURNS_INFLIGHT.get(sid) === request) DASH_RETURNS_INFLIGHT.delete(sid);\n    });\n  DASH_RETURNS_INFLIGHT.set(sid, request);\n  return request;\n}\n\n// 库内异常计数同样只读本地缓存；口径见 initTencentDocsInnerPage：\n// 识别不出店铺的记录归属所有店铺，所以这里的 count 已包含它们。\nfunction refreshDashboardFourPxInnerCount(shopId, options = {}) {\n  const sid = String(shopId || \"\").trim();\n  if (!sid) return Promise.resolve(null);\n  const existing = DASH_INNER_INFLIGHT.get(sid);\n  if (existing) return existing;\n  const retry = options.retry !== false;\n  const request = api(`/api/fourpx/inner/summary?shop_id=${encodeURIComponent(sid)}`)\n    .then((summary) => {\n      const current = DASH_CACHE.get(sid);\n      const data = current && current.data\n        ? current.data\n        : (String(GLOBAL_SHOP) === sid ? DASH_DATA : null);\n      if (!data || !data.shop) return summary;\n      const count = Number(summary && summary.count);\n      const next = {\n        ...data,\n        shop: {\n          ...data.shop,\n          fourpx_inner_count: Number.isFinite(count) ? Math.max(0, Math.trunc(count)) : 0,\n          fourpx_inner_cache_source: summary && summary.cache ? summary.cache.source || \"none\" : \"none\",\n          fourpx_inner_cache_fetched_at: summary && summary.cache ? summary.cache.fetched_at || null : null,\n        },\n      };\n      if (current && current.data) {\n        DASH_CACHE.set(sid, { ...current, data: next });\n      } else {\n        DASH_CACHE.set(sid, { data: next, loadedAt: Date.now() });\n      }\n      if (String(GLOBAL_SHOP) === sid) {\n        DASH_DATA = next;\n        renderDashboardV24();\n      }\n      if (retry && summary && summary.syncing && String(GLOBAL_SHOP) === sid) {\n        setTimeout(() => {\n          if (String(GLOBAL_SHOP) === sid) refreshDashboardFourPxInnerCount(sid, { retry: false });\n        }, 1500);\n      }\n      return summary;\n    })\n    .catch(() => null)\n    .finally(() => {\n      if (DASH_INNER_INFLIGHT.get(sid) === request) DASH_INNER_INFLIGHT.delete(sid);\n    });\n  DASH_INNER_INFLIGHT.set(sid, request);\n  return request;\n}\n\n// v26.55：仪表盘「待办提醒」需要当前店铺的发货超时条数。\n// /api/shipping-overdue 服务端自带 24 小时缓存，这里只做店铺过滤与异步补位，不额外请求平台。\n// 无论成功或失败都写 attempted 标记，避免渲染->失败->再渲染的循环请求。\nfunction refreshDashboardShippingOverdue(shopId) {\n  const sid = String(shopId || GLOBAL_SHOP || \"\");\n  if (!sid) return Promise.resolve(null);\n  const existing = DASH_SHIPPING_INFLIGHT.get(sid);\n  if (existing) return existing;\n  const request = (async () => {\n    let patchData;\n    try {\n      const d = await api(\"/api/shipping-overdue\");\n      const pick = (list) => (Array.isArray(list) ? list : []).filter((row) => String(row && row.shop_id) === sid);\n      const overdue = pick(d && d.overdue);\n      const dueSoon = pick(d && d.due_soon);\n      const earliest = overdue.map((row) => String(row.deadline_beijing || \"\")).filter(Boolean).sort()[0] || \"\";\n      patchData = { shipping_overdue_count:overdue.length, shipping_due_soon_count:dueSoon.length, shipping_overdue_earliest:earliest };\n    } catch (error) {\n      patchData = { shipping_overdue_count:null, shipping_due_soon_count:null, shipping_overdue_earliest:\"\" };\n    }\n    patchData.shipping_overdue_attempted = true;\n    const cached = DASH_CACHE.get(sid);\n    const base = cached && cached.data ? cached.data : (String(GLOBAL_SHOP) === sid ? DASH_DATA : null);\n    if (base) {\n      const next = { ...base, shop:{ ...(base.shop || {}), ...patchData } };\n      DASH_CACHE.set(sid, cached ? { ...cached, data:next } : { data:next, loadedAt:Date.now() });\n      if (String(GLOBAL_SHOP) === sid) {\n        DASH_DATA = next;\n        if (document.querySelector(\".nav-item.active\")?.dataset.page === \"dashboard\") renderDashboardV24();\n      }\n    }\n    return patchData;\n  })().finally(() => {\n    if (DASH_SHIPPING_INFLIGHT.get(sid) === request) DASH_SHIPPING_INFLIGHT.delete(sid);\n  });\n  DASH_SHIPPING_INFLIGHT.set(sid, request);\n  return request;\n}\n\nfunction renderGlobalShopSel() {\n  const sel = $(\"globalShopSel\");\n  sel.innerHTML = SHOPS.map((s) => `<option value=\"${s.shop_id}\">${s.name}</option>`).join(\"\");\n  sel.value = GLOBAL_SHOP;\n  const cur = SHOPS.find((s) => s.shop_id === GLOBAL_SHOP);\n  $(\"globalShopHint\").textContent = cur ? `当前：${cur.name}` : \"未选择店铺\";\n}\n\n// 根据全局店铺控制：站内信页是否显示左侧店铺栏（选定店铺后收起，直接展示该店邮件）\nfunction updateShopPaneVisibility() {\n  const pane = document.querySelector(\".col-shops\");\n  const tag = $(\"inboxShopTag\");\n  if (!pane) return;\n  pane.style.display = \"none\";\n  if (tag) {\n    // 全局店铺已在顶栏显示；列表工具栏保留空间给订单号搜索和计数，避免相互挤压。\n    tag.style.display = \"none\";\n    tag.textContent = \"\";\n  }\n}\n\nasync function setGlobalShop(shopId) {\n  const nextShop = SHOPS.find((s) => String(s.shop_id) === String(shopId));\n  if (!nextShop) return;\n  const nextSid = String(nextShop.shop_id);\n  // 切店时取消旧店铺仍在途的分页请求；缓存数据保留，切回时可立即复用。\n  for (const [sid, entry] of INBOX_PRELOAD_CACHE.entries()) {\n    if (sid === nextSid) continue;\n    if (entry && entry.controller) {\n      entry.generation = Number(entry.generation || 0) + 1;\n      entry.controller.abort();\n      entry.controller = null;\n      entry.promise = null;\n      entry.firstPromise = null;\n      entry.refreshing = false;\n    }\n  }\n  for (const [key, controller] of INBOX_ORDER_CONTROLLERS.entries()) {\n    if (!key.startsWith(`${nextSid}::`)) controller.abort();\n  }\n  INBOX_SEARCH_REQUEST_SEQ += 1;\n  if (INBOX_SEARCH_CONTROLLER) INBOX_SEARCH_CONTROLLER.abort();\n  GLOBAL_SHOP = nextSid;\n  SETTINGS.global_shop_id = GLOBAL_SHOP;\n  try {\n    await api(\"/api/settings\", { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify({ settings: SETTINGS }) });\n  } catch (e) {}\n  renderGlobalShopSel();\n  // 站内信跟随全局店铺\n  ACTIVE_SHOP = GLOBAL_SHOP;\n  INBOX_TOPIC_FILTER = \"\";\n  INBOX_TOPIC_CATALOG = [];\n  renderInboxTopicOptions();\n  loadInboxTopicCatalog(GLOBAL_SHOP);\n  updateShopPaneVisibility();\n  // 退款模块同步全局店铺\n  if ($(\"rfShop\")) {\n    $(\"rfShop\").value = GLOBAL_SHOP;\n    if ($(\"rfManualShop\")) $(\"rfManualShop\").value = GLOBAL_SHOP;\n    $(\"bkShop\").innerHTML = `<option value=\"auto\">自动识别（遍历 17 店）</option>` + SHOPS.map((s) => `<option value=\"${s.shop_id}\">${s.name}</option>`).join(\"\");\n    $(\"bkShop\").value = GLOBAL_SHOP;\n    loadReasons(GLOBAL_SHOP);\n  }\n  if ($(\"refundShopTag\")) {\n    const cs = SHOPS.find((s) => s.shop_id === GLOBAL_SHOP);\n    $(\"refundShopTag\").textContent = cs ? `当前店铺：${cs.name}（退款将只针对该店）` : \"未选择店铺\";\n  }\n  // 发货模块同步全局店铺\n  if ($(\"shShop\")) {\n    $(\"shShop\").value = GLOBAL_SHOP;\n    CARRIERS = [];\n    loadCarriers();\n  }\n  // 发货超时页跟随全局店铺：默认选中当前店铺（页面未初始化时只记状态）\n  SHIPPING_OVERDUE_SHOP_FILTER = GLOBAL_SHOP;\n  if ($(\"soShop\")) {\n    $(\"soShop\").value = GLOBAL_SHOP;\n    renderShippingOverdue();\n  }\n  if ($(\"shipShopTag\")) {\n    const cs = SHOPS.find((s) => s.shop_id === GLOBAL_SHOP);\n    $(\"shipShopTag\").textContent = cs ? `当前店铺：${cs.name}` : \"未选择店铺\";\n  }\n  // 特别关注页跟随全局店铺（已初始化时立即重读本机清单，不请求平台）\n  if ($(\"pageWatchlist\") && $(\"pageWatchlist\").dataset.ready === \"1\") {\n    WATCH_EXPANDED = \"\";\n    WATCH_FILTER = \"\";\n    WATCH_RULE_FILTER = \"\";\n    WATCH_NOTICE = \"\";\n    loadSpecialAttention();\n  }\n  // 重新拉取（选定店铺时只拉该店铺，更快）\n  CURRENT_THREAD = null;\n  ALL_THREADS = [];\n  INBOX_ORDER_MAP = new Map();\n  INBOX_LOADED_SHOP = null;\n  closeOrderDetail();\n  $(\"readPane\").innerHTML = '<div class=\"empty\">选择一封邮件查看详情<br>打开后自动标记为已读</div>';\n  $(\"replyBox\").style.display = \"none\";\n  // 切店时无论当前页面，都在后台预加载该店铺的站内信与订单详情。\n  const activeNav = document.querySelector(\".nav-item.active\");\n  const page = activeNav ? activeNav.dataset.page : \"dashboard\";\n  const inboxPreload = preloadInbox(GLOBAL_SHOP).catch((e) => {\n    console.warn(\"切店后站内信预加载失败\", e.message);\n    return null;\n  });\n  if (page === \"inbox\") await inboxPreload;\n  else if (page === \"dashboard\") loadDashboard();\n}\n\n// 手动刷新：只刷新当前页面与当前店铺\nasync function refreshCurrent() {\n  const activeNav = document.querySelector(\".nav-item.active\");\n  const page = activeNav ? activeNav.dataset.page : \"dashboard\";\n  if (page === \"inbox\") await loadAll({ force: true });\n  else if (page === \"dashboard\") await loadDashboard({ force: true });\n  else if (page === \"wms\") await loadWmsData({ force: true });\n  else if (page === \"watchlist\") await loadSpecialAttention();\n}\n\n// ---- 退款模块 ----\nlet REFUND_TAB = \"single\";\nlet CURRENT_ORDER = null;\nlet REFUND_REASONS = [];\nlet QUICK_REFUND_ORDER = null;\nlet QUICK_REFUND_REQUEST = 0;\nlet MANUAL_REFUND_CONTEXT = null;\nlet MANUAL_REFUND_REQUEST = 0;\n\nfunction quickRefundShopLabel(shopId) {\n  const shop = SHOPS.find((s) => String(s.shop_id) === String(shopId));\n  return shop ? shop.name : String(shopId || \"当前店铺\");\n}\n\nfunction closeQuickRefund() {\n  const modal = $(\"quickRefundModal\");\n  if (!modal) return;\n  modal.classList.add(\"hidden\");\n  QUICK_REFUND_REQUEST++;\n  QUICK_REFUND_ORDER = null;\n  const trigger = CURRENT_THREAD && CURRENT_THREAD.thread_id && CURRENT_THREAD.shop_id\n    ? () => openThread(CURRENT_THREAD.thread_id, CURRENT_THREAD.shop_id)\n    : null;\n  if (trigger) trigger();\n}\n\nfunction openQuickRefund(orderId, shopId) {\n  const id = String(orderId || \"\").trim();\n  const sid = String(shopId || \"\").trim();\n  if (!id || !sid) return;\n  const modal = $(\"quickRefundModal\");\n  if (!modal) return;\n  const request = ++QUICK_REFUND_REQUEST;\n  QUICK_REFUND_ORDER = null;\n  modal.classList.remove(\"hidden\");\n  $(\"qrfContext\").textContent = `${quickRefundShopLabel(sid)} · ${id}`;\n  $(\"qrfLookupStatus\").textContent = \"正在查询订单明细…\";\n  $(\"qrfLookupStatus\").className = \"quick-refund-status\";\n  $(\"qrfOrderPanel\").classList.add(\"hidden\");\n  $(\"qrfOrderInfo\").textContent = \"\";\n  if ($(\"qrfErpHost\")) $(\"qrfErpHost\").innerHTML = \"\";\n  $(\"qrfLines\").innerHTML = \"\";\n  $(\"qrfReason\").innerHTML = '<option value=\"\">加载退款原因…</option>';\n  $(\"qrfTotalHint\").textContent = \"\";\n  $(\"qrfStatus\").textContent = \"\";\n  $(\"qrfStatus\").className = \"quick-refund-result\";\n  $(\"btnQrfSubmit\").disabled = true;\n  // 重置退款比例，避免上次的选择残留导致 select 与 input.value 不一致\n  $(\"qrfRatio\").value = \"100\";\n  loadQuickRefundOrder(id, sid, request);\n}\n\nasync function loadQuickRefundOrder(orderId, shopId, request) {\n  try {\n    const d = await api(`/api/order?shop_id=${encodeURIComponent(shopId)}&order_id=${encodeURIComponent(orderId)}`);\n    if (request !== QUICK_REFUND_REQUEST) return;\n    QUICK_REFUND_ORDER = d;\n    const o = d.order || {};\n    const currency = o.currency_iso_code || \"EUR\";\n    $(\"qrfOrderInfo\").innerHTML = `订单 <b>${escapeHtml(o.order_id || orderId)}</b> · 状态 ${escapeHtml(o.order_state || \"—\")} · 币种 ${escapeHtml(currency)} · 下单 ${o.created_date ? new Date(o.created_date).toLocaleString(\"zh-CN\") : \"—\"}`;\n    const rows = (o.order_lines || []).map((l) => {\n      const price = Number(l.price || 0);\n      const remain = Number(l.remaining_amount || 0);\n      const shipping = Number(l.shipping_price || 0);\n      const canRefund = l.can_refund !== false && remain > 0;\n      return `<tr data-line=\"${escapeAttr(l.order_line_id || \"\")}\" data-price=\"${price}\" data-remain=\"${remain}\" data-ship=\"${shipping}\">\n        <td><input type=\"checkbox\" class=\"qrf-line\" value=\"${escapeAttr(l.order_line_id || \"\")}\" ${canRefund ? \"checked\" : \"disabled\"}></td>\n        <td>${escapeHtml((l.offer_sku || \"\").slice(0, 24))}</td>\n        <td>${escapeHtml((l.product_title || \"\").slice(0, 36))}</td>\n        <td class=\"num\">${price.toFixed(2)}</td>\n        <td class=\"num\">${shipping.toFixed(2)}</td>\n        <td class=\"num\">${Number(l.refunded_amount || 0).toFixed(2)}</td>\n        <td class=\"num\"><b>${remain.toFixed(2)}</b></td>\n        <td class=\"num\">${Number(l.remaining_quantity || 0)}</td>\n        <td><input type=\"number\" class=\"qrf-amount\" value=\"${canRefund ? remain.toFixed(2) : \"0\"}\" min=\"0\" max=\"${remain}\" step=\"0.01\" ${canRefund ? \"\" : \"disabled\"}></td>\n        <td>${canRefund ? '<span class=\"qrf-can-refund\">可退</span>' : '<span class=\"qrf-cannot-refund\">不可退/已退完</span>'}</td>\n      </tr>`;\n    }).join(\"\");\n    $(\"qrfLines\").innerHTML = `<thead><tr>\n      <th style=\"width:36px\"></th><th>SKU</th><th>商品</th><th class=\"num\">金额</th><th class=\"num\">运费</th>\n      <th class=\"num\">已退</th><th class=\"num\">可退</th><th class=\"num\">数量</th><th class=\"num\">本次退款 (${escapeHtml(currency)})</th><th>状态</th>\n    </tr></thead><tbody>${rows || '<tr><td colspan=\"10\" class=\"empty\">没有可展示的订单行</td></tr>'}</tbody>`;\n    $(\"qrfOrderPanel\").classList.remove(\"hidden\");\n    // ERP 履约状态（只读）：退款判断要看得到「货发没发、卡在哪」，否则容易退错。\n    const erpHost = $(\"qrfErpHost\");\n    if (erpHost) {\n      erpHost.innerHTML = renderErpFulfillmentSection(null, o.order_id || orderId);\n      loadErpFulfillment(erpHost, o.order_id || orderId);\n    }\n    applyQuickRefundRatio();\n    updateQuickRefundTotal();\n    $(\"qrfLookupStatus\").textContent = \"订单已加载，可确认退款明细\";\n    $(\"qrfLookupStatus\").className = \"quick-refund-status ok\";\n    await loadReasons(shopId);\n    if (request === QUICK_REFUND_REQUEST) $(\"btnQrfSubmit\").disabled = !(o.order_lines || []).some((l) => l.can_refund !== false && Number(l.remaining_amount || 0) > 0);\n  } catch (e) {\n    if (request !== QUICK_REFUND_REQUEST) return;\n    $(\"qrfLookupStatus\").textContent = \"查询失败：\" + e.message;\n    $(\"qrfLookupStatus\").className = \"quick-refund-status err\";\n    $(\"qrfOrderPanel\").classList.add(\"hidden\");\n    $(\"btnQrfSubmit\").disabled = true;\n  }\n}\n\nfunction applyQuickRefundRatio() {\n  const ratio = Number($(\"qrfRatio\").value) / 100;\n  document.querySelectorAll(\"#qrfLines tbody tr\").forEach((tr) => {\n    const input = tr.querySelector(\".qrf-amount\");\n    if (!input || input.disabled) return;\n    const price = Number(tr.dataset.price || 0);\n    const remain = Number(tr.dataset.remain || 0);\n    input.value = Math.min(price * ratio, remain).toFixed(2);\n  });\n  updateQuickRefundTotal();\n}\n\nfunction updateQuickRefundTotal() {\n  let total = 0;\n  document.querySelectorAll(\"#qrfLines tbody tr\").forEach((tr) => {\n    const cb = tr.querySelector(\".qrf-line\");\n    const input = tr.querySelector(\".qrf-amount\");\n    if (!cb || !cb.checked || !input) return;\n    total += Number(input.value || 0) + Number(tr.dataset.ship || 0);\n  });\n  const currency = QUICK_REFUND_ORDER && QUICK_REFUND_ORDER.order && QUICK_REFUND_ORDER.order.currency_iso_code || \"EUR\";\n  const hint = $(\"qrfTotalHint\");\n  if (hint) hint.innerHTML = `本次退款合计：<b>${escapeHtml(currency)} ${total.toFixed(2)}</b>（含运费）`;\n}\n\nasync function submitQuickRefund() {\n  const st = $(\"qrfStatus\");\n  if (!QUICK_REFUND_ORDER || !QUICK_REFUND_ORDER.order) {\n    st.textContent = \"订单尚未加载完成\";\n    st.className = \"quick-refund-result err\";\n    return;\n  }\n  const lineItems = [];\n  document.querySelectorAll(\"#qrfLines tbody tr\").forEach((tr) => {\n    const cb = tr.querySelector(\".qrf-line\");\n    const input = tr.querySelector(\".qrf-amount\");\n    if (!cb || !cb.checked || !input) return;\n    const amount = Number(input.value || 0);\n    if (amount > 0) lineItems.push({ order_line_id: cb.value, amount: Number(amount.toFixed(2)), shipping_amount: Number(tr.dataset.ship || 0) });\n  });\n  if (lineItems.length === 0) {\n    st.textContent = \"请勾选至少一行且退款金额大于 0\";\n    st.className = \"quick-refund-result err\";\n    return;\n  }\n  const reasonCode = $(\"qrfReason\").value;\n  if (!reasonCode) {\n    st.textContent = \"请选择退款原因\";\n    st.className = \"quick-refund-result err\";\n    return;\n  }\n  const o = QUICK_REFUND_ORDER.order;\n  const total = lineItems.reduce((sum, item) => sum + item.amount + item.shipping_amount, 0);\n  if (!confirm(`确认退款？\\n\\n订单：${o.order_id}\\n行数：${lineItems.length}\\n金额合计：${o.currency_iso_code || \"EUR\"} ${total.toFixed(2)}（含运费）\\n原因：${refundReasonLabel(reasonCode)}\\n\\n此操作不可撤销！`)) return;\n  const registrationEventId = clientRefundRegistrationEventId();\n  const btn = $(\"btnQrfSubmit\");\n  btn.disabled = true;\n  st.textContent = \"退款中…\";\n  st.className = \"quick-refund-result\";\n  try {\n    const d = await api(\"/api/refund/quick\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({\n        shop_id: QUICK_REFUND_ORDER.shop.shop_id,\n        order_id: o.order_id,\n        reason_code: reasonCode,\n        currency: o.currency_iso_code,\n        thread_id: CURRENT_THREAD && CURRENT_THREAD.thread_id,\n        registration_event_id: registrationEventId,\n        refunds: lineItems,\n      }),\n    });\n    const notice = d.notice || {};\n    const registration = d.registration || {};\n    const langLabel = notice.lang === \"es\" ? \"西班牙语\" : \"德语\";\n    const noticeTarget = notice.mode === \"reply\" ? \"当前线程\" : notice.mode === \"new\" ? \"新建会话\" : \"站内信\";\n    const retryHint = notice.retryable ? \"（可稍后重试）\" : \"\";\n    const statusHint = notice.status !== null && notice.status !== undefined ? `（HTTP ${notice.status}）` : \"\";\n    const deferredNotice = notice.deferred === true || notice.note === \"queued\";\n    const deferredTarget = [\"failed\", \"skipped\"].includes(registration.status)\n      ? \"站内信通知\"\n      : \"站内信通知和腾讯文档登记\";\n    st.innerHTML = deferredNotice\n      ? `退款成功（${lineItems.length} 行 · ${escapeHtml(o.currency_iso_code || \"EUR\")} ${total.toFixed(2)}），${deferredTarget}已转后台处理`\n      : notice.ok\n      ? `退款成功（${lineItems.length} 行 · ${escapeHtml(o.currency_iso_code || \"EUR\")} ${total.toFixed(2)}），已通过${noticeTarget}发送${langLabel}成功通知`\n      : `退款成功（${lineItems.length} 行 · ${escapeHtml(o.currency_iso_code || \"EUR\")} ${total.toFixed(2)}），但通知发送失败${retryHint}${statusHint}：${escapeHtml(notice.error || \"未知原因\")}`;\n    if (registration && registration.status && registration.status !== \"deferred\" && registration.status !== \"not_attempted\") {\n      st.appendChild(document.createElement(\"br\"));\n      const registrationNode = document.createElement(\"span\");\n      registrationNode.className = \"r-status\";\n      st.appendChild(registrationNode);\n      renderRefundRegistrationStatus(registrationNode, registration);\n    }\n    const registrationWarning = [\"failed\", \"skipped\"].includes(registration.status);\n    st.className = notice.ok && !registrationWarning ? \"quick-refund-result ok\" : \"quick-refund-result warn\";\n    btn.textContent = \"已完成退款\";\n    // 退款通知若回复当前线程，关闭弹窗后刷新阅读区即可看到新消息。\n    QUICK_REFUND_ORDER = null;\n  } catch (e) {\n    st.textContent = \"退款失败：\" + e.message;\n    st.className = \"quick-refund-result err\";\n    btn.disabled = false;\n  }\n}\n\n$(\"btnQrfCancel\").addEventListener(\"click\", closeQuickRefund);\n$(\"btnQrfClose\").addEventListener(\"click\", closeQuickRefund);\n$(\"btnQrfSubmit\").addEventListener(\"click\", submitQuickRefund);\n$(\"qrfRatio\").addEventListener(\"change\", applyQuickRefundRatio);\n$(\"qrfLines\").addEventListener(\"input\", updateQuickRefundTotal);\n$(\"qrfLines\").addEventListener(\"change\", updateQuickRefundTotal);\n$(\"quickRefundModal\").addEventListener(\"click\", (e) => {\n  if (e.target === e.currentTarget) closeQuickRefund();\n});\n\n// ===== 站内信「申请退货标签」（v26.68）：与「退货标签」页 ⚡ 一键到底同一条链路 =====\n// 顺序：① 向 ERP 申请退货单（已有面单直接复用）→ 取回面单下载链接\n//       ② 用该链接建退货单（附标签 + 自动验收）＝ 开启退货渠道\n//       ③ 把标签发进**当前这条站内信**（thread_id 一并交给后端，后端会先核对对话归属再动写接口）\n// ⚠️ 走的是工作台自有的退货单模块，**不用平台的「批量上传退货单」**。\n// ⚠️ 退货方式 / 原因固定取与「退货标签」页默认项一致的口径：邮寄退货 + 不想要了 / 改变主意。\nconst INBOX_RL_METHOD = \"RETURN_METHOD_BY_MAIL\";\nconst INBOX_RL_REASON = \"RETURN_CHANGED_MIND\";\n\nfunction inboxReturnLabelCard(pane, html) {\n  if (!pane) return;\n  const old = pane.querySelector(\"#inboxRlCard\");\n  if (old) old.remove();\n  const card = document.createElement(\"div\");\n  card.id = \"inboxRlCard\";\n  card.style.cssText = \"margin:0 0 12px;padding:12px 14px;border:1px solid var(--border);border-radius:12px;background:var(--card);font-size:12.5px;line-height:1.9;\";\n  card.innerHTML = html;\n  const head = pane.querySelector(\".thread-head\");\n  if (head && head.parentElement === pane) pane.insertBefore(card, head.nextSibling);\n  else pane.insertBefore(card, pane.firstChild);\n}\n\n// v26.78：第 4 个参数 existingReturnId —— 上一轮「退货单已建、信没发出去」时的补救通道：\n//   带上它就会**跳过建退货单**，只把面单重发给买家。\n//   没有这条通道时，用户对同一订单再点一次只会撞上 Mirakl「该订单已有退货单」，这一单就永远补不回来。\n// ---- v26.79：退货标签发出后 → 问一句要不要登记到「退货登记」 ----\n// 口径（用户 2026-09-15 定版）：仓库固定 DGSC12；订单号填平台订单号（01125_xxx-A）；\n// 物流号填 ERP 回邮单号（itgoal-return 返回的 return_shipping.num，即回邮面单上的那个号，\n// 也是 WMS 到仓匹配用的号）。「点是 = 登记，点否 = 不登记」。\n// ---- v26.80：这个确认框从原生 confirm() 换成自定义弹窗 + 补上 SKU ----\n// 用户口径（2026-09-15，带截图）：「SKU 丢失了」「确认键放在取消键的右边」「备注让我自己编辑吧，默认留空」。\n//   · 原生 `confirm()` 做不到前两件事（不能输入、按钮顺序不可控）⇒ 自造弹窗 #returnRegModal。\n//   · SKU 之前**根本没被送进登记接口** ⇒ 登记记录里 SKU 列恒空。现由服务端在创单响应里\n//     带出 `order.skus`（订单行 offer_sku 去重），弹窗预填、可改。\n//   · SKU 与备注**只写用户在弹窗里填的内容**；店铺 / Mirakl 退货单号改为弹窗内只读展示，\n//     不再塞进备注（否则用户要写自己的备注还得先删掉系统那段）。\nconst RETURN_LABEL_REGISTER_WAREHOUSE = \"DGSC12\";\n\n// ---- v26.80：这个确认框从原生 confirm() 换成自定义弹窗 ----\n// 为什么换：① 原生 confirm **不能填备注**（用户本版新增的需求）；② 原生按钮顺序由浏览器决定，\n// 而用户要求「取消在左、确定在右」—— 只能自己画；③ 顺手把仓库 / 订单号 / 物流号排成三张小卡片，\n// 比挤在一段纯文本里好核对。弹窗本体在 HTML 的 #returnRegModal，样式是 .return-reg-*。\nlet RETURN_REG_PENDING = null;   // 同一时刻只允许一个；重复打开时把上一个当作「取消」\n\n/** 关闭登记确认弹窗。answer 为空 / 未 confirmed ⇒ 用户取消。 */\nfunction closeReturnRegDialog(answer) {\n  const modal = $(\"returnRegModal\");\n  if (modal) modal.classList.add(\"hidden\");\n  const skuBox = $(\"returnRegSku\");\n  if (skuBox) skuBox.value = \"\";\n  const noteBox = $(\"returnRegNote\");\n  if (noteBox) noteBox.value = \"\";\n  const resolve = RETURN_REG_PENDING;\n  RETURN_REG_PENDING = null;\n  if (resolve) {\n    resolve(answer && answer.confirmed\n      ? { confirmed: true, sku: String(answer.sku || \"\"), note: String(answer.note || \"\") }\n      : { confirmed: false, sku: \"\", note: \"\" });\n  }\n}\n\n/**\n * 弹「要把这一单登记到「退货登记」吗？」，等用户作答。\n * @param {{orderNo?:string, trackingNo?:string, sku?:string, shopName?:string, returnId?:string}} info\n * @returns {Promise<{confirmed:boolean, sku:string, note:string}>} sku/note = 用户在框里最终填的内容\n */\nfunction openReturnRegDialog(info) {\n  const data = info || {};\n  if (RETURN_REG_PENDING) closeReturnRegDialog(null);   // 上一轮没答完，先当取消\n  const orderNo = String(data.orderNo || \"\").trim();\n  const trackingNo = String(data.trackingNo || \"\").trim();\n  $(\"returnRegWarehouse\").textContent = RETURN_LABEL_REGISTER_WAREHOUSE;\n  $(\"returnRegOrderNo\").textContent = orderNo || \"-\";\n  $(\"returnRegTrackingNo\").textContent = trackingNo || \"（空）\";\n  const warn = $(\"returnRegNoTracking\");\n  if (warn) warn.classList.toggle(\"hidden\", Boolean(trackingNo));\n  // 店铺 / Mirakl 退货单号改成**只读展示**：它们不再被写进备注（用户 2026-09-15 口径：\n  // 备注只写我自己填的内容），但排障时还是希望眼睛能扫到，所以就地显示在这里。\n  const meta = $(\"returnRegMeta\");\n  if (meta) {\n    const bits = [\n      data.shopName ? `店铺 ${data.shopName}` : \"\",\n      data.returnId ? `Mirakl 退货单 ${data.returnId}` : \"\",\n    ].filter(Boolean);\n    meta.textContent = bits.join(\"　·　\");\n    meta.classList.toggle(\"hidden\", bits.length === 0);\n  }\n  // SKU 按订单**自动带出**（可改）：v26.79 那次自动登记把 sku 整个漏了，登记记录里 SKU 列一直是空的。\n  const skuBox = $(\"returnRegSku\");\n  if (skuBox) skuBox.value = String(data.sku || \"\").trim();\n  const noteBox = $(\"returnRegNote\");\n  if (noteBox) noteBox.value = \"\";   // 备注默认留空，用户自己写\n  $(\"returnRegModal\").classList.remove(\"hidden\");\n  // 焦点给 SKU 框：多半是要核对/改动它；不想动就直接 Tab 到备注或点「确定登记」。\n  if (skuBox) setTimeout(() => { try { skuBox.focus(); } catch (e) {} }, 0);\n  return new Promise((resolve) => { RETURN_REG_PENDING = resolve; });\n}\n\n// 监听只绑一次，不随每次打开叠加。\n$(\"btnReturnRegCancel\").addEventListener(\"click\", () => closeReturnRegDialog(null));\n$(\"btnReturnRegX\").addEventListener(\"click\", () => closeReturnRegDialog(null));\n$(\"returnRegModal\").addEventListener(\"click\", (event) => {\n  if (event.target === event.currentTarget) closeReturnRegDialog(null);   // 点遮罩＝取消\n});\n$(\"btnReturnRegConfirm\").addEventListener(\"click\", () => {\n  const skuBox = $(\"returnRegSku\");\n  const noteBox = $(\"returnRegNote\");\n  closeReturnRegDialog({\n    confirmed: true,\n    sku: skuBox ? skuBox.value : \"\",\n    note: noteBox ? noteBox.value : \"\",\n  });\n});\n// Esc＝取消；Ctrl/Cmd+Enter＝确定（备注是多行，单按 Enter 留给换行）。\ndocument.addEventListener(\"keydown\", (event) => {\n  const modal = $(\"returnRegModal\");\n  if (!modal || modal.classList.contains(\"hidden\")) return;\n  if (event.key === \"Escape\") { event.preventDefault(); closeReturnRegDialog(null); }\n  else if (event.key === \"Enter\" && (event.ctrlKey || event.metaKey)) { event.preventDefault(); $(\"btnReturnRegConfirm\").click(); }\n});\n\n/**\n * 标签发给买家之后问一句「要不要登记到退货登记」，答「是」才写。\n * 询问走自定义弹窗 `openReturnRegDialog()`（原生 confirm **不能填 SKU / 备注**，也控制不了按钮顺序）。\n * @param {{orderId?:string, trackingNo?:string, sku?:string, shopName?:string, returnId?:string}} info\n *   sku 由调用方从创单响应的 `d.order.skus` 带下来（订单行 offer_sku 去重），弹窗里预填、可改。\n * @returns {Promise<{ok?:boolean, skipped?:string, duplicate?:boolean, error?:string, record?:object, sku?:string, note?:string}>}\n */\nasync function offerReturnLabelRegistration(info) {\n  const orderNo = String((info && info.orderId) || \"\").trim();\n  const trackingNo = String((info && info.trackingNo) || \"\").trim();\n  // 没有回邮单号时的重复保护：服务端的重复判据是**物流号**（409），物流号为空就拦不住，\n  // 而 ERP 偶尔不返回 return_shipping.num —— 这时连点两次会在同一仓库里留下两条同订单号记录。\n  // 本地缓存里已经有同订单号 ⇒ 直接说明，连询问都省掉（问了也只能答「已登记」）。\n  if (!trackingNo && orderNo) {\n    const warehouses = (RETURN_REGISTRATION_DATA && Array.isArray(RETURN_REGISTRATION_DATA.warehouses))\n      ? RETURN_REGISTRATION_DATA.warehouses\n      : [];\n    const warehouse = warehouses.find((item) => String(item.id) === RETURN_LABEL_REGISTER_WAREHOUSE);\n    const records = warehouse && Array.isArray(warehouse.records) ? warehouse.records : [];\n    if (records.some((record) => String(record.order_no || \"\").trim() === orderNo)) {\n      return { skipped: \"duplicate_order\" };\n    }\n  }\n  // 先判「有没有可用身份」再弹框 —— 弹了框却登记不了比不弹更糟。\n  if (!orderNo && !trackingNo) return { skipped: \"no_identity\" };\n  const answer = await openReturnRegDialog({\n    orderNo,\n    trackingNo,\n    sku: (info && info.sku) || \"\",\n    shopName: (info && info.shopName) || \"\",\n    returnId: (info && info.returnId) || \"\",\n  });\n  if (!answer.confirmed) return { skipped: \"declined\" };\n  // SKU 与备注都**只写用户在弹窗里最终填的内容**（用户 2026-09-15 口径：\n  // 「SKU 自动带出但可改」「备注让我自己编辑，默认留空」）。\n  // 店铺 / Mirakl 退货单号只在弹窗里**只读展示**、不写进备注 ——\n  // 否则用户想写自己的备注时，还得先把系统塞的那串字删掉。\n  const sku = String(answer.sku || \"\").trim().slice(0, 200);\n  const note = String(answer.note || \"\").trim().slice(0, 200);\n  let resp;\n  let data = {};\n  try {\n    resp = await fetch(`/api/return-registration/${encodeURIComponent(RETURN_LABEL_REGISTER_WAREHOUSE)}/records`, {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ order_no: orderNo, tracking_no: trackingNo, sku, note }),\n    });\n    data = await resp.json().catch(() => ({}));\n  } catch (e) {\n    return { ok: false, error: (e && e.message) || String(e) };\n  }\n  if (resp.ok) {\n    // 本地缓存跟着更新，切到退货登记页就是最新的一条（不必重新拉一次接口）。\n    if (data.warehouse) returnRegistrationApplyWarehouse(data.warehouse);\n    renderReturnRegistration();\n    return { ok: true, record: data.record || null, sku, note };\n  }\n  // 409 = 该物流号已经在待处理列表里 —— 这不是失败，是「早就登记过」。\n  return {\n    ok: false,\n    duplicate: resp.status === 409,\n    status: resp.status,\n    error: data.error || `HTTP ${resp.status}`,\n  };\n}\n\n/** 把上面那次询问的结果渲染成一行（成功卡片 / 标签页结果卡都用它）。 */\nfunction returnLabelRegistrationLine(reg) {\n  const tag = \"📥 退货登记\";\n  if (!reg || reg.skipped === \"declined\") return `<div style=\"color:var(--muted);\">${tag}：未登记（你选择了「不登记」）</div>`;\n  if (reg.skipped === \"duplicate_order\") return `<div style=\"color:var(--muted);\">${tag}：${RETURN_LABEL_REGISTER_WAREHOUSE} 里已有该订单号的记录，未重复添加</div>`;\n  if (reg.skipped) return `<div style=\"color:var(--muted);\">${tag}：未登记</div>`;\n  if (reg.ok) {\n    const record = reg.record || {};\n    const skuTxt = String(reg.sku || record.sku || \"\").trim();\n    const noteTxt = String(reg.note || record.note || \"\").trim();\n    return `<div style=\"color:var(--green);\">${tag}：已登记到 ${RETURN_LABEL_REGISTER_WAREHOUSE}`\n      + `${record.tracking_no ? `（物流号 <b style=\"font-family:Consolas,monospace\">${escapeHtml(String(record.tracking_no))}</b>）` : \"（未带回邮单号，物流号留空）\"}`\n      + `${skuTxt ? `；SKU <b style=\"font-family:Consolas,monospace\">${escapeHtml(skuTxt)}</b>` : \"；SKU 留空\"}`\n      + `${noteTxt ? `；备注：${escapeHtml(noteTxt)}` : \"\"}</div>`;\n  }\n  if (reg.duplicate) return `<div style=\"color:var(--muted);\">${tag}：${RETURN_LABEL_REGISTER_WAREHOUSE} 里已有该物流号，未重复添加</div>`;\n  return `<div style=\"color:var(--warning);\">${tag}：登记失败 —— ${escapeHtml(String(reg.error || \"未知原因\"))}（标签已正常发出，可到「退货登记」页手工补登）</div>`;\n}\n\n/** 上面那行的一句话说版本（写进状态栏），三条链路共用，避免各处口径漂移。 */\nfunction returnLabelRegistrationTail(reg) {\n  if (reg && reg.ok) return \"；已登记到退货登记\";\n  if (reg && (reg.skipped === \"duplicate_order\" || reg.duplicate)) return \"；退货登记里已有，未重复登记\";\n  if (reg && reg.skipped) return \"；未登记\";\n  return \"；退货登记失败\";\n}\n\nasync function inboxApplyReturnLabel(orderId, shopId, threadId, existingReturnId) {\n  const reuseReturnId = String(existingReturnId || \"\").trim();\n  const status = $(\"replyStatus\");\n  const setStatus = (text, cls) => { if (status) { status.textContent = text; status.className = cls || \"status\"; } };\n  // 每次重新取按钮：成功后会重开线程，readPane 整块重渲染，旧的按钮节点已经脱离文档。\n  const button = () => document.querySelector('#readPane [data-action=\"return-label\"]');\n  const setButtonText = (text, disabled) => {\n    const b = button();\n    if (!b) return;\n    b.disabled = !!disabled;\n    const label = b.querySelector(\".return-label-btn-text\");\n    if (label) label.textContent = text;\n  };\n  const id = String(orderId || \"\").trim();\n  const tid = String(threadId || \"\").trim();\n  if (!id) { setStatus(\"这条站内信没有关联订单，无法申请退货标签\", \"status err\"); return null; }\n  if (!tid) { setStatus(\"缺少站内信标识，请重新打开这条站内信后再试\", \"status err\"); return null; }\n  // v26.78：补救模式（已有退货单）的确认文案 —— 必须讲明「不会重复建单」，\n  // 否则用户会以为又要建一张，不敢点。\n  const confirmText = reuseReturnId\n    ? `重新发送退货标签？\\n\\n订单：${id}\\n退货单已创建（${reuseReturnId}），本次**不会重复建单**，只做两件事：\\n① 取回 ERP 面单（已有面单直接复用）\\n② 把面单 PDF 作为附件发给买家\\n\\n（用于上一次「退货单建好了、信没发出去」的情况）`\n    : `给当前站内信订单申请退货标签并交付？\\n\\n订单：${id}\\n将依次：\\n① 向 ERP 申请退货单并取回面单链接（已有面单直接复用，不会重复申请）\\n② 创建退货单（附标签 + 自动验收）＝ 开启退货渠道\\n③ 把面单 PDF 作为附件发进当前这条站内信（正文不含任何外链）\\n\\n退货方式：邮寄退货　退货原因：不想要了 / 改变主意`;\n  if (!confirm(confirmText)) return null;\n\n  setButtonText(\"正在申请退货单…\", true);\n  setStatus(\"① 正在向 ERP 申请退货单并取面单…\");\n  let erp = null;\n  try {\n    erp = await api(\"/api/itgoal/apply-return\", {\n      method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ order_id: id }),\n    });\n  } catch (e) {\n    setButtonText(\"申请退货标签\", false);\n    setStatus(\"申请退货单失败：\" + ((e && e.message) || e), \"status err\");\n    return null;\n  }\n  if (!erp || !erp.label_url) {\n    setButtonText(\"申请退货标签\", false);\n    setStatus(\"ERP 未返回面单链接：\" + ((erp && (erp.error || erp.message)) || \"请确认订单归属与 ERP 配置\"), \"status err\");\n    return null;\n  }\n\n  setButtonText(\"正在建退货单并发信…\", true);\n  setStatus(`② 已${erp.reused ? \"复用\" : \"申请到\"} ERP 面单，正在建退货单并在当前站内信发信…`);\n  let resp;\n  let d = {};\n  try {\n    // 这里直接用 fetch 而不是 api()：失败响应里带着 return_id / label_url，\n    // 而 api() 只抛 error —— 「退货单建好了但信没发出去」这种半成品状态必须让用户看到。\n    resp = await fetch(\"/api/returns/create-label\", {\n      method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({\n        shop_id: shopId,\n        order_id: id,\n        label_url: erp.label_url,\n        method_code: INBOX_RL_METHOD,\n        reason_code: INBOX_RL_REASON,\n        accepted: true,\n        thread_id: tid,\n        // 补救模式才带：带上它就跳过「建退货单」这一步\n        ...(reuseReturnId ? { existing_return_id: reuseReturnId } : {}),\n      }),\n    });\n    d = await resp.json().catch(() => ({}));\n  } catch (e) {\n    setButtonText(\"申请退货标签\", false);\n    setStatus(\"发送失败：\" + ((e && e.message) || e), \"status err\");\n    return null;\n  }\n\n  const langTxt = (d.notice && d.notice.lang) === \"es\" ? \"西班牙语\" : \"德语\";\n  const erpLine = `<div>🧾 ERP 退货单：<b style=\"font-family:Consolas,monospace\">${(erp.return_shipping && erp.return_shipping.num) || \"-\"}</b>　${erp.reused ? '<span style=\"color:var(--green);\">复用已有面单</span>' : '<span style=\"color:var(--green);\">新申请面单</span>'}　收货国家：${(erp.order && erp.order.country_code) || \"-\"}</div>`;\n  // v26.70：面单改为**附件**直发，正文不再出现任何外链 ——\n  // itgoal.com 那个下载地址无需任何鉴权，交给买家等于把个人信息放在公开 URL 上。\n  // 这里保留 ERP 原件链接仅给操作员核对/排错用。\n  const attach = d.label_attachment || null;\n  const attachLine = `<div>📎 面单已作为附件随信发出：${attach ? `<b style=\"font-family:Consolas,monospace\">${escapeHtml(attach.file_name)}</b>（${Math.max(1, Math.round(attach.bytes / 1024))} KB）` : \"未附带附件\"}</div>`;\n  const linkLine = `<div style=\"color:var(--muted);\">🔗 ERP 面单原件（仅供内部核对，未发给买家）：<a href=\"${erp.label_url}\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--accent);word-break:break-all;\">${erp.label_url}</a></div>`;\n  if (!resp.ok) {\n    setButtonText(\"申请退货标签\", false);\n    const returnCreated = !!d.return_id;\n    const step = String(d.step || \"\");\n    // v26.78：失败必须说清「卡在哪一步」。以前不论卡在哪儿都写「站内信没发出去」，\n    // 用户会一直去查站内信 —— 而真实原因可能是 ERP 面单没取回来，与站内信毫无关系。\n    const headline = !returnCreated\n      ? `<div style=\"color:var(--red);font-weight:700;\">✗ 未完成：${escapeHtml(d.error || \"建退货单失败\")}</div>`\n      : step === \"label_download\"\n        ? `<div style=\"color:var(--warning);font-weight:700;\">⚠️ 退货单已创建，但 ERP 面单没能取回来 —— 未发出任何站内信</div>\n           <div>🎫 退货单号：<b style=\"font-family:Consolas,monospace\">${d.return_id}</b></div>`\n        : `<div style=\"color:var(--warning);font-weight:700;\">⚠️ 退货单已创建，但站内信没发出去 —— 买家还看不到标签</div>\n           <div>🎫 退货单号：<b style=\"font-family:Consolas,monospace\">${d.return_id}</b></div>`;\n    // v26.78 补救按钮：退货单已在 Mirakl 建好，重发时必须**跳过建单**，\n    // 否则再点一次只会被「该订单已有退货单」挡住，这一单永远补不回来。\n    const retry = returnCreated\n      ? `<div style=\"margin-top:8px;\"><button id=\"inboxRlRetry\" type=\"button\" style=\"padding:5px 12px;border:1px solid var(--accent);border-radius:8px;background:transparent;color:var(--accent);font-size:12.5px;cursor:pointer;\">🔁 只重发标签信（不重新建退货单）</button></div>`\n      : \"\";\n    inboxReturnLabelCard($(\"readPane\"), `${headline}${erpLine}${linkLine}${retry}`);\n    const retryPane = $(\"readPane\");\n    const retryBtn = retryPane ? retryPane.querySelector(\"#inboxRlRetry\") : null;\n    if (retryBtn) retryBtn.addEventListener(\"click\", () => inboxApplyReturnLabel(id, shopId, tid, d.return_id));\n    setStatus(\"失败：\" + (d.error || `HTTP ${resp.status}`), \"status err\");\n    return null;\n  }\n\n  // 先重开线程（把刚发出的那条消息拉进时间线），再挂结果卡片 —— 顺序反了卡片会被重渲染冲掉。\n  if (CURRENT_THREAD && String(CURRENT_THREAD.thread_id) === tid) await openThread(tid, shopId);\n  // v26.79：信已经发到买家手上 ⇒ 问一句「要不要登记到退货登记」，答「是」才写。\n  // 放在渲染卡片**之前**：卡片一次画完，不会先画一张没有登记结论、随后又被追加一行的半截卡片。\n  const reg = await offerReturnLabelRegistration({\n    orderId: (d.order && d.order.order_id) || id,\n    trackingNo: (erp.return_shipping && erp.return_shipping.num) || \"\",\n    // SKU 由服务端在创单响应里带出（订单行 offer_sku 去重）—— 弹窗预填，用户可改。\n    sku: (d.order && d.order.skus) || \"\",\n    shopName: (d.shop && d.shop.name) || \"\",\n    returnId: d.return_id,\n  });\n  inboxReturnLabelCard($(\"readPane\"), `<div style=\"color:var(--green);font-weight:700;\">✅ 已完成：退货标签已作为附件发往当前站内信</div>\n    <div>🏪 ${escapeHtml((d.shop && d.shop.name) || \"\")}　订单：<code style=\"font-family:Consolas,monospace\">${escapeHtml((d.order && d.order.order_id) || id)}</code></div>\n    <div>🎫 Mirakl 退货单：<b style=\"font-family:Consolas,monospace;color:var(--green);\">${d.return_id}</b>（已附标签 + 自动验收，退货渠道已开启）</div>\n    ${erpLine}${attachLine}${linkLine}\n    <div>📨 站内信已发往当前对话（${langTxt}）${d.notice && d.notice.recipients ? `，收件人 ${d.notice.recipients} 位` : \"\"}</div>\n    ${returnLabelRegistrationLine(reg)}`);\n  setStatus(`✅ 完成：退货单 ${d.return_id}，退货标签已发往当前站内信（${langTxt}）${returnLabelRegistrationTail(reg)}`, \"status ok\");\n  return d;\n}\n\nfunction resetManualRefundPreview() {\n  MANUAL_REFUND_CONTEXT = null;\n  MANUAL_REFUND_REQUEST++;\n  const panel = $(\"rfManualPreview\");\n  const status = $(\"rfManualLookupStatus\");\n  const submit = $(\"btnRfManualSubmit\");\n  const registration = $(\"rfManualRegistrationStatus\");\n  if (panel) panel.classList.add(\"hidden\");\n  if (status) { status.textContent = \"\"; status.className = \"r-status\"; }\n  if (submit) { submit.disabled = true; submit.textContent = \"确认登记到腾讯文档\"; }\n  if (registration) { registration.textContent = \"\"; registration.className = \"r-status\"; }\n}\n\n/** 勾选中的 SKU 行（一行一个 SKU，提交时就是这几行）。 */\nfunction manualRefundSelection() {\n  const selected = [];\n  document.querySelectorAll(\"#rfManualPreviewInfo tbody tr\").forEach((tr) => {\n    const cb = tr.querySelector(\".mrf-line\");\n    const input = tr.querySelector(\".mrf-amount\");\n    if (!cb || !input || !cb.checked) return;\n    const amount = Number(input.value || 0);\n    if (!Number.isFinite(amount) || amount <= 0) return;\n    selected.push({ order_line_id: cb.value, amount: Number(amount.toFixed(2)) });\n  });\n  return selected;\n}\n\nfunction updateManualRefundTotal() {\n  const hint = $(\"mrfTotalHint\");\n  if (!hint) return;\n  const selected = manualRefundSelection();\n  const total = selected.reduce((sum, item) => sum + item.amount, 0);\n  hint.innerHTML = selected.length\n    ? `本次登记 <b style=\"color:var(--text)\">${selected.length}</b> 行 · 合计 <b style=\"color:var(--green)\">€${total.toFixed(2)}</b>`\n    : '<span style=\"color:var(--amber)\">尚未勾选任何 SKU 行 —— 勾一行、填金额，才会登记</span>';\n}\n\n/**\n * 手动登记预览（v26.101）：**一行一个 SKU** 的勾选表。\n *\n * 以前这里渲染的是「这一笔将写成的那一行」；登记粒度变成「一单 × 一 SKU 一行」之后，\n * 改成列出该订单每个 SKU 行（各自还能退多少、表里已有几行），由运营勾选要登记哪几行。\n * ⛔ 「勾哪行登记哪行」与自动登记在后端走**同一条路径**（buildRefundRegistrationPlan），\n *    不允许两边各算一套。\n */\nfunction renderManualRefundPreview(data) {\n  const order = data && data.order || {};\n  const preview = data && data.preview || {};\n  const currency = escapeHtml(preview.currency || order.currency_iso_code || \"EUR\");\n  const total = Number(preview.order_amount || 0);\n  const lines = Array.isArray(preview.lines) ? preview.lines : [];\n  const info = $(\"rfManualOrderInfo\");\n  const previewInfo = $(\"rfManualPreviewInfo\");\n  if (info) {\n    info.innerHTML = `订单 <b>${escapeHtml(order.order_id || preview.order_id || \"—\")}</b> · ${escapeHtml(order.order_state || \"已查询\")} · 币种 ${currency} · 订单总额 <b>${currency} ${total.toFixed(2)}</b> · 下单 ${escapeHtml(formatOrderDate(order.created_date))}`;\n  }\n  if (!previewInfo) return;\n  // v26.96：SKU 列优先写 ERP 配对后的商品编码（ERP SKU），取不到才回落平台货号。\n  // 回落是正常降级（没配 ERP / 没登录 / 该单没配对），但必须**说出来** ——\n  // 否则客服会以为表里那串 SKU 就是 ERP 编码，拿去对库存会对不上。\n  const skuSource = String(preview.sku_source || \"\");\n  const skuSourceLabel = String(preview.sku_source_label || \"\") || \"SKU\";\n  const skuSourceNote = String(preview.sku_source_note || \"\");\n  const skuSourceHtml = '<span style=\"color:' + (skuSource === \"erp\" ? \"var(--green)\" : \"var(--muted)\") + '\">'\n    + escapeHtml(skuSourceLabel) + \"</span>\"\n    + (skuSourceNote ? ' <span style=\"color:var(--amber)\">（' + escapeHtml(skuSourceNote) + \"）</span>\" : \"\");\n  // v26.97：列位确认不了（读不到表头 / 必需列认不出）时**必须挡住提交**。\n  // 回落布局会把「退款金额」写进「退款数量」列 —— 2026-09-20 线上真发生过一次。\n  const layoutWritable = preview.layout_writable !== false;\n  const layoutWarnHtml = layoutWritable ? \"\" : '<div style=\"font-size:12px;color:var(--amber);margin-top:8px;line-height:1.6;\">⚠️ '\n    + escapeHtml(String(preview.layout_warning || \"退款表列位无法确认\"))\n    + '。该情况下写入会把「退款金额」写进「退款数量」列，<b>本版已禁用提交</b>；请先确认子表第 1 行表头，然后重新查询。</div>';\n  // v26.101：老格式行（多个 SKU 挤在一格）**不会被覆盖** ⇒ 按订单号汇总金额会重复，必须说出来。\n  const legacyCount = Number(preview.legacy_row_count) || 0;\n  const legacyWarnHtml = legacyCount > 0\n    ? '<div style=\"font-size:12px;color:var(--amber);margin-top:8px;line-height:1.6;\">⚠️ 这个订单在表里还有 <b>'\n      + legacyCount + '</b> 行「老格式行」（多个 SKU 挤在一格，v26.100 及以前写的）。本版<b>不会动它们</b>；因此按订单号汇总金额会重复计入。</div>'\n    : \"\";\n  // v26.99/v26.101：「已退件数」的来源必须说全 —— 带（折算）的那些是**按退款金额折算**出来的\n  // （平台 refunds[].quantity 一律回 0），不是平台原话。列头太窄放不下整句，就在表下补一句图例。\n  const hasDerivedPieces = lines.some((line) => String(line.refund_quantity_source) === \"derived\");\n  const derivedLegendHtml = hasDerivedPieces\n    ? '<div style=\"font-size:11.5px;color:var(--muted);margin-top:6px;\">「已退件数」里带（折算）标记的，是<b>按退款金额折算</b>出来的（平台未给件数），不是平台原话。</div>'\n    : \"\";\n  const bodyRows = lines.length\n    ? lines.map((line) => {\n      const existing = Number(line.existing_row_count) || 0;\n      const existingAmount = Number(line.existing_amount) || 0;\n      const existingHtml = existing\n        ? '<span style=\"color:var(--amber)\">已有 ' + existing + \" 行（累计 \" + currency + \" \" + existingAmount.toFixed(2) + \"）→ 本次覆盖</span>\"\n        : '<span style=\"color:var(--muted)\">表里还没有这个 SKU 的行</span>';\n      const pieces = Number(line.refund_quantity);\n      const piecesHtml = Number.isFinite(pieces) && pieces > 0\n        ? pieces + \" 件\" + (String(line.refund_quantity_source) === \"derived\" ? '<span style=\"color:var(--muted)\">（折算）</span>' : \"\")\n        : \"—\";\n      const suggested = Number(line.suggested_amount) || 0;\n      return '<tr data-line=\"' + escapeAttr(line.order_line_id) + '\">'\n        + '<td><input type=\"checkbox\" class=\"mrf-line\" value=\"' + escapeAttr(line.order_line_id) + '\"'\n        + (suggested > 0 ? \" checked\" : \" disabled\") + \"></td>\"\n        + '<td style=\"font-size:11.5px;\">' + escapeHtml(line.sku || \"—\") + \"</td>\"\n        + \"<td>\" + (Number(line.quantity) || 0) + \"</td>\"\n        + \"<td>\" + Number(line.unit_price || 0).toFixed(2) + \"</td>\"\n        + \"<td>\" + currency + \" \" + Number(line.remaining_amount || 0).toFixed(2) + \"</td>\"\n        + \"<td>\" + piecesHtml + \"</td>\"\n        + '<td><input type=\"number\" class=\"mrf-amount\" style=\"width:92px;padding:3px 6px;\" min=\"0\" step=\"0.01\" value=\"'\n        + suggested.toFixed(2) + '\"></td>'\n        + '<td style=\"font-size:11px;\">' + existingHtml + \"</td>\"\n        + \"</tr>\";\n    }).join(\"\")\n    : '<tr><td colspan=\"8\" style=\"color:var(--muted)\">这个订单没有可登记的 SKU 行</td></tr>';\n  previewInfo.innerHTML = '<div style=\"font-size:12px;color:var(--muted);margin-bottom:8px;\">SKU 来源：'\n    + skuSourceHtml\n    + \" · 勾选哪一行就登记哪一行（<b>一行一个 SKU</b>）</div>\"\n    + '<table class=\"line-tbl\"><thead><tr><th style=\"width:28px;\"></th><th>SKU</th><th>数量</th><th>单价</th><th>该行未退</th><th>已退件数</th><th>本次退款额</th><th>表内现状</th></tr></thead><tbody>'\n    + bodyRows + \"</tbody></table>\"\n    + '<div id=\"mrfTotalHint\" style=\"font-size:12px;margin-top:8px;\"></div>'\n    + derivedLegendHtml + layoutWarnHtml + legacyWarnHtml;\n  updateManualRefundTotal();\n}\n\nasync function lookupManualRefund() {\n  const status = $(\"rfManualLookupStatus\");\n  const panel = $(\"rfManualPreview\");\n  const submit = $(\"btnRfManualSubmit\");\n  const shopId = $(\"rfManualShop\").value;\n  const orderId = $(\"rfManualOrderId\").value.trim();\n  const amountText = $(\"rfManualAmount\").value.trim();\n  MANUAL_REFUND_CONTEXT = null;\n  MANUAL_REFUND_REQUEST++;\n  const request = MANUAL_REFUND_REQUEST;\n  if (panel) panel.classList.add(\"hidden\");\n  if (submit) submit.disabled = true;\n  if (!orderId) { status.textContent = \"请输入订单号\"; status.className = \"r-status err\"; return; }\n  // v26.101：金额不再是必填 —— 改成「一行一个 SKU」之后，金额在勾选表里**按行填**；\n  // 这里填了金额就当作预填提示（后端只回显，不拿它定登记金额）。\n  const amountQuery = amountText && Number.isFinite(Number(amountText)) && Number(amountText) > 0\n    ? `&amount=${encodeURIComponent(amountText)}`\n    : \"\";\n  status.textContent = \"正在查询订单…\"; status.className = \"r-status\";\n  try {\n    const data = await api(`/api/refund/manual/preview?shop_id=${encodeURIComponent(shopId)}&order_id=${encodeURIComponent(orderId)}${amountQuery}`);\n    if (request !== MANUAL_REFUND_REQUEST) return;\n    MANUAL_REFUND_CONTEXT = data;\n    renderManualRefundPreview(data);\n    panel.classList.remove(\"hidden\");\n    // v26.97：列位没确认就不给提交（后端还会再拦一道；界面这层是让运营**当场**看到原因，\n    // 而不是点了提交才吃一个失败）。\n    const layoutWritable = !(data && data.preview) || data.preview.layout_writable !== false;\n    if (layoutWritable) {\n      status.textContent = \"订单已加载，请确认登记内容\"; status.className = \"r-status ok\";\n      submit.disabled = false;\n    } else {\n      status.textContent = \"订单已加载，但退款表列位无法确认 —— 已禁用提交（见下方提示）\";\n      status.className = \"r-status err\";\n      submit.disabled = true;\n    }\n  } catch (error) {\n    if (request !== MANUAL_REFUND_REQUEST) return;\n    status.textContent = \"查询失败：\" + error.message; status.className = \"r-status err\";\n    if (panel) panel.classList.add(\"hidden\");\n  }\n}\n\nasync function submitManualRefund() {\n  const status = $(\"rfManualRegistrationStatus\");\n  const submit = $(\"btnRfManualSubmit\");\n  const context = MANUAL_REFUND_CONTEXT;\n  if (!context || !context.order || !context.preview) {\n    status.textContent = \"请先查询订单\"; status.className = \"r-status err\"; return;\n  }\n  // v26.97：兜底再挡一次 —— 列位确认不了绝不提交（回落布局会把金额写进「退款数量」列）。\n  if (context.preview.layout_writable === false) {\n    status.textContent = \"退款表列位无法确认，已中止登记：\" + String(context.preview.layout_warning || \"\");\n    status.className = \"r-status err\";\n    return;\n  }\n  // v26.101：**一行一个 SKU** —— 勾了哪几行就登记哪几行（勾一行、填一行金额）。\n  const selections = manualRefundSelection();\n  if (!selections.length) {\n    status.textContent = \"请至少勾选一行 SKU，并填写大于 0 的退款金额\";\n    status.className = \"r-status err\";\n    return;\n  }\n  const orderId = context.order.order_id;\n  const amount = Number(selections.reduce((sum, item) => sum + item.amount, 0).toFixed(2));\n  const currency = context.preview.currency || context.order.currency_iso_code || \"EUR\";\n  const listText = selections.map((item) => \"· \" + item.order_line_id + \"：\" + currency + \" \" + item.amount.toFixed(2)).join(\"\\n\");\n  if (!confirm(`确认登记退款？\\n\\n订单：${orderId}\\n登记行数：${selections.length}\\n金额合计：${currency} ${amount.toFixed(2)}\\n\\n${listText}\\n\\n本操作只登记到腾讯文档，不会再次退款，也不会发送站内信。`)) return;\n  submit.disabled = true;\n  status.textContent = \"已提交，腾讯文档登记排队中…\"; status.className = \"r-status\";\n  try {\n    const data = await api(\"/api/refund/manual/register\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({\n        shop_id: context.shop.shop_id,\n        order_id: orderId,\n        current_amount: amount,\n        refunds: selections,\n        registration_event_id: clientRefundRegistrationEventId(),\n      }),\n    });\n    const registration = data.registration || { ok: false, status: \"failed\", error: \"未返回腾讯文档登记状态\" };\n    renderRefundRegistrationStatus(status, registration, { manual: true });\n    if (![\"queued\", \"processing\"].includes(registration.status)) submit.textContent = registration.status === \"written\" ? \"已登记\" : \"重试登记\";\n    if (registration.status === \"failed\" || registration.status === \"skipped\") submit.disabled = false;\n  } catch (error) {\n    status.textContent = \"登记提交失败：\" + error.message; status.className = \"r-status err\";\n    submit.disabled = false;\n  }\n}\n\nfunction initRefundPage() {\n  const box = $(\"pageRefund\");\n  if (box.dataset.ready === \"1\") return;\n  box.dataset.ready = \"1\";\n  box.innerHTML = `<div class=\"refund operation-shell\">\n    <header class=\"operation-header\"><h2>退款处理</h2>\n    <div class=\"r-sub\" id=\"refundShopTag\"></div></header>\n    <div class=\"r-tabs\">\n      <span class=\"rt active\" data-t=\"single\">单笔退款</span>\n      <span class=\"rt\" data-t=\"bulk\">批量一键全额退款</span>\n      <span class=\"rt\" data-t=\"manual\">手动登记退款</span>\n    </div>\n    <div class=\"r-warn guardrail-callout\">\n      <span class=\"icon-svg icon-alert inline-icon\"></span><b>退款不可撤销</b>。金额与运费均为必填（平台要求），留空时系统自动按\"行金额 − 已退金额\"计算。操作会写入本地日志 <code>mail.log</code>。\n    </div>\n    <div style=\"background:var(--blue-08,rgba(133,183,235,.08)); border:1px solid var(--blue); border-radius:10px; padding:10px 14px; font-size:12px; margin-bottom:14px; line-height:1.7;\">\n      <span class=\"icon-svg icon-inbox inline-icon\"></span><b>自动通知买家</b>：退款成功后会自动给该订单发送一封站内信，告知\"订单 XXX 已退款 XX 欧元，请查收，感谢耐心与理解\"，署名为店铺名。<br>\n      语言自动匹配：店铺名含 <b>ES</b> → 西班牙语；含 <b>DE</b>、<b>AT</b> 或无国家后缀（德国/奥地利）→ 德语。单笔与批量退款均会发送。\n    </div>\n\n    <div id=\"refundSingle\">\n      <div class=\"r-panel workflow-panel\">\n        <h3>① 查询订单</h3>\n        <div class=\"r-row\">\n          <label>店铺</label>\n          <select id=\"rfShop\" class=\"r-input w200\"></select>\n          <label>订单号</label>\n          <input id=\"rfOrderId\" class=\"r-input w200\" placeholder=\"01125_322626379-A（可不带 -A）\">\n          <button class=\"btn primary\" id=\"btnRfLookup\">查询</button>\n          <span class=\"r-status\" id=\"rfLookupStatus\"></span>\n        </div>\n      </div>\n      <div class=\"r-panel workflow-panel hidden\" id=\"rfOrderPanel\">\n        <h3>② 订单明细（勾选要退的行，可修改退款金额）</h3>\n        <div id=\"rfOrderInfo\" style=\"font-size:12px;color:var(--muted);margin-bottom:8px;\"></div>\n        <table class=\"line-tbl\" id=\"rfLines\"></table>\n        <div class=\"r-row\" style=\"margin-top:12px; padding-top:12px; border-top:1px solid var(--border-soft);\">\n          <label>按比例退款</label>\n          <select id=\"rfRatio\" class=\"r-input w120\">\n            <option value=\"100\">全额 100%</option>\n            <option value=\"90\">90%</option>\n            <option value=\"80\">80%</option>\n            <option value=\"70\">70%</option>\n            <option value=\"60\">60%</option>\n            <option value=\"50\">50%</option>\n            <option value=\"40\">40%</option>\n            <option value=\"30\">30%</option>\n            <option value=\"20\">20%</option>\n            <option value=\"10\">10%</option>\n          </select>\n          <span style=\"font-size:11.5px;color:var(--muted);\">选择后按订单行金额自动计算并填入下方「本次退款」</span>\n          <span id=\"rfTotalHint\" style=\"margin-left:auto;font-size:13px;font-weight:500;\"></span>\n        </div>\n        <div class=\"r-row\">\n          <label>退款原因</label>\n          <select id=\"rfReason\" class=\"r-input w200\"></select>\n          <button class=\"btn btn-danger\" id=\"btnRfSubmit\">确认退款</button>\n          <span class=\"r-status\" id=\"rfStatus\"></span>\n          <span class=\"r-status\" id=\"rfRegistrationStatus\"></span>\n        </div>\n      </div>\n    </div>\n\n    <div id=\"refundBulk\" class=\"hidden\">\n      <div class=\"r-panel\">\n        <h3>批量全额退款（自动识别店铺）</h3>\n        <div class=\"r-row\">\n          <label>店铺</label>\n          <select id=\"bkShop\" class=\"r-input w200\"></select>\n          <label>退款原因</label>\n          <select id=\"bkReason\" class=\"r-input w200\"></select>\n        </div>\n        <div class=\"r-row\">\n          <label>订单号</label>\n          <textarea id=\"bkOrders\" class=\"r-input r-textarea\" placeholder=\"每行一个订单号，例如：&#10;01125_322626379-A&#10;01125_322626380-A&#10;（可不带 -A/-B 后缀，系统自动补全）\"></textarea>\n        </div>\n        <div class=\"r-row\">\n          <button class=\"btn btn-danger\" id=\"btnBkSubmit\">批量全额退款</button>\n          <span class=\"r-status\" id=\"bkStatus\"></span>\n        </div>\n      </div>\n      <div class=\"r-panel hidden\" id=\"bkResult\">\n        <h3>执行结果</h3>\n        <div id=\"bkSummary\" style=\"font-size:12.5px;margin-bottom:6px;\"></div>\n        <table class=\"res-tbl\" id=\"bkTable\"></table>\n      </div>\n    </div>\n\n    <div id=\"refundManual\" class=\"hidden\">\n      <div class=\"r-panel workflow-panel\">\n        <h3>① 查询已完成退款的订单</h3>\n        <div class=\"r-row\">\n          <label>店铺</label>\n          <select id=\"rfManualShop\" class=\"r-input w200\"></select>\n          <label>订单号</label>\n          <input id=\"rfManualOrderId\" class=\"r-input w200\" placeholder=\"01125_322626379-A（可不带 -A）\">\n          <label>预填金额（可留空）</label>\n          <input id=\"rfManualAmount\" class=\"r-input w120\" type=\"number\" min=\"0.01\" step=\"0.01\" placeholder=\"查询后按行填\">\n          <button class=\"btn primary\" id=\"btnRfManualLookup\" type=\"button\">查询</button>\n          <span class=\"r-status\" id=\"rfManualLookupStatus\"></span>\n        </div>\n        <div style=\"font-size:11.5px;color:var(--muted);line-height:1.6;\">\n          这里只登记已经完成的退款，不会再次调用退款接口，也不会发送站内信。退款日期自动登记为当天。<br>\n          查询后按 <b>一行一个 SKU</b> 列出该订单的各个商品行：勾哪一行就登记哪一行，金额默认填「该行还没退的部分」。\n          <b>同一个订单的同一个 SKU 再次登记时会覆盖那一行</b>（金额累加），别的 SKU 的行不受影响。\n        </div>\n      </div>\n      <div class=\"r-panel workflow-panel hidden\" id=\"rfManualPreview\">\n        <h3>② 确认登记内容</h3>\n        <div id=\"rfManualOrderInfo\" style=\"font-size:12px;color:var(--muted);line-height:1.7;margin-bottom:10px;\"></div>\n        <div id=\"rfManualPreviewInfo\"></div>\n        <div class=\"r-row\" style=\"margin-top:14px;padding-top:12px;border-top:1px solid var(--border-soft);\">\n          <button class=\"btn btn-filled manual-refund-submit\" id=\"btnRfManualSubmit\" type=\"button\" disabled>确认登记到腾讯文档</button>\n          <span class=\"r-status\" id=\"rfManualRegistrationStatus\"></span>\n        </div>\n      </div>\n    </div>\n  </div>`;\n\n  // 店铺下拉（退款模块跟随全局店铺）\n  const shopSel = SHOPS.map((s) => `<option value=\"${s.shop_id}\">${s.name}</option>`).join(\"\");\n  const autoOption = `<option value=\"auto\">自动识别（遍历 17 店）</option>`;\n  $(\"rfShop\").innerHTML = shopSel;\n  $(\"rfManualShop\").innerHTML = shopSel;\n  $(\"bkShop\").innerHTML = autoOption + shopSel;\n  $(\"rfShop\").value = GLOBAL_SHOP;\n  $(\"rfManualShop\").value = GLOBAL_SHOP;\n  $(\"bkShop\").value = GLOBAL_SHOP;\n\n  // ⛔ v26.102：选择器必须**限定在本页容器内**。报价页新增的子模块切换（同样用 `.r-tabs .rt`）\n  //    与这里选择器完全撞名，而两个页面**同时存在于 DOM**（只有 hidden 类在切换）⇒\n  //    不限定容器的话，点报价页的子模块会把 REFUND_TAB 设成 \"manage\"，\n  //    于是 refundSingle/Bulk/Manual 三个面板全被隐藏 —— 退款页整页空白。\n  document.querySelectorAll(\"#pageRefund .r-tabs .rt\").forEach((el) => {\n    el.addEventListener(\"click\", () => {\n      REFUND_TAB = el.dataset.t;\n      document.querySelectorAll(\"#pageRefund .r-tabs .rt\").forEach((x) => x.classList.toggle(\"active\", x === el));\n      $(\"refundSingle\").classList.toggle(\"hidden\", REFUND_TAB !== \"single\");\n      $(\"refundBulk\").classList.toggle(\"hidden\", REFUND_TAB !== \"bulk\");\n      $(\"refundManual\").classList.toggle(\"hidden\", REFUND_TAB !== \"manual\");\n    });\n  });\n\n  $(\"btnRfLookup\").addEventListener(\"click\", lookupOrder);\n  $(\"btnRfSubmit\").addEventListener(\"click\", submitRefund);\n  $(\"btnBkSubmit\").addEventListener(\"click\", submitBulkRefund);\n  $(\"btnRfManualLookup\").addEventListener(\"click\", lookupManualRefund);\n  $(\"btnRfManualSubmit\").addEventListener(\"click\", submitManualRefund);\n  $(\"rfRatio\").addEventListener(\"change\", applyRefundRatio);\n  // 勾选状态变化时刷新合计\n  $(\"rfLines\").addEventListener(\"change\", (e) => {\n    if (e.target && e.target.classList.contains(\"rf-line\")) updateRefundTotal();\n  });\n  $(\"rfShop\").addEventListener(\"change\", () => loadReasons($(\"rfShop\").value));\n  $(\"rfManualShop\").addEventListener(\"change\", resetManualRefundPreview);\n  // v26.101：勾选 / 改金额时刷新「本次登记 N 行 · 合计」。\n  // 预览表格是动态 innerHTML ⇒ 用事件委托挂在容器上，别挂行内元素。\n  $(\"rfManualPreviewInfo\").addEventListener(\"change\", (e) => {\n    if (e.target && (e.target.classList.contains(\"mrf-line\") || e.target.classList.contains(\"mrf-amount\"))) updateManualRefundTotal();\n  });\n  $(\"rfManualPreviewInfo\").addEventListener(\"input\", (e) => {\n    if (e.target && e.target.classList.contains(\"mrf-amount\")) updateManualRefundTotal();\n  });\n  $(\"bkShop\").addEventListener(\"change\", () => loadReasons($(\"bkShop\").value));\n  const initShop = GLOBAL_SHOP;\n  if (initShop) loadReasons(initShop);\n}\n\nasync function loadReasons(shopId) {\n  if (!shopId || shopId === \"auto\") return;\n  try {\n    const d = await api(`/api/reasons?shop_id=${shopId}`);\n    REFUND_REASONS = (d.reasons || []).filter((r) => String(r.type || \"\").toUpperCase() === \"REFUND\");\n    const opts = REFUND_REASONS.map((r) => `<option value=\"${escapeAttr(r.code)}\">${escapeHtml(r.zh_label || r.label || \"其他退款原因\")}</option>`).join(\"\");\n    if ($(\"rfReason\")) $(\"rfReason\").innerHTML = opts || '<option value=\"\">未找到退款原因码</option>';\n    if ($(\"bkReason\")) $(\"bkReason\").innerHTML = opts || '<option value=\"\">未找到退款原因码</option>';\n    if ($(\"qrfReason\")) $(\"qrfReason\").innerHTML = opts || '<option value=\"\">未找到退款原因码</option>';\n    // 默认选 REFUND_20（常规退款首选）\n    if ($(\"rfReason\") && REFUND_REASONS.some((r) => r.code === \"REFUND_20\")) $(\"rfReason\").value = \"REFUND_20\";\n    if ($(\"bkReason\") && REFUND_REASONS.some((r) => r.code === \"REFUND_20\")) $(\"bkReason\").value = \"REFUND_20\";\n    if ($(\"qrfReason\") && REFUND_REASONS.some((r) => r.code === \"REFUND_20\")) $(\"qrfReason\").value = \"REFUND_20\";\n  } catch (e) {\n    if ($(\"rfReason\")) $(\"rfReason\").innerHTML = '<option value=\"\">原因码加载失败</option>';\n    if ($(\"qrfReason\")) $(\"qrfReason\").innerHTML = '<option value=\"\">原因码加载失败</option>';\n  }\n}\n\nfunction refundReasonLabel(code) {\n  const reason = REFUND_REASONS.find((item) => String(item && item.code || \"\") === String(code || \"\"));\n  return String(reason && (reason.zh_label || reason.label) || \"其他退款原因\");\n}\n\nfunction clientRefundRegistrationEventId() {\n  const suffix = window.crypto && typeof window.crypto.randomUUID === \"function\"\n    ? window.crypto.randomUUID()\n    : Date.now() + \"-\" + Math.random().toString(16).slice(2);\n  return \"refund-\" + suffix;\n}\n\nfunction refundRegistrationMarkup(registration, options = {}) {\n  const manual = options.manual === true;\n  if (!registration || registration.status === \"deferred\" || registration.status === \"not_attempted\") return \"\";\n  if (registration.status === \"queued\") {\n    return '<span style=\"color:var(--blue)\">' + (manual ? \"腾讯文档登记排队中\" : \"退款已成功，腾讯文档登记排队中\") + \"</span>\";\n  }\n  if (registration.status === \"processing\") {\n    return '<span style=\"color:var(--blue)\">' + (manual ? \"正在登记腾讯文档\" : \"退款已成功，正在登记腾讯文档\") + \"</span>\";\n  }\n  if (registration.status === \"written\") {\n    const row = Number(registration.row);\n    // v26.101：登记粒度是「一行一个 SKU」⇒ 一次可能写多行，结果要照实说清写了几行、都是哪些 SKU。\n    const writtenRows = Array.isArray(registration.rows) ? registration.rows : [];\n    const split = String(registration.split || \"\");\n    let suffix = \"\";\n    if (writtenRows.length > 1) {\n      const names = writtenRows.map((item) => item && item.sku).filter(Boolean);\n      suffix = \"（\" + writtenRows.length + \" 行\"\n        + (names.length ? \"：\" + names.slice(0, 3).join(\" / \") + (names.length > 3 ? \" …\" : \"\") : \"\")\n        + \"）\";\n    } else if (Number.isInteger(row) && row > 0) {\n      suffix = \"（第 \" + row + \" 行）\";\n    } else if (registration.deduplicated === true) {\n      suffix = \"（此前已登记，未重复写入）\";\n    }\n    // 拿不到行级明细时会回落成「整单一行」——这是降级，必须说出来，别让人以为已经拆好了。\n    const splitNote = split === \"order\"\n      ? ' <span style=\"color:var(--amber)\">· 未拿到行级明细，按整单一行登记</span>'\n      : \"\";\n    // v26.101：拆行后两个「账对不上」的来源，都要当面讲清（否则按订单号汇总会多算）：\n    //   · split_unresolved —— 有退款明细但归不到订单行（行号对不上），这部分**没被登记**；\n    //   · legacy_rows     —— 该单在表里还有老格式行（多个 SKU 挤在一格），它们**不会被覆盖**，\n    //                        于是同一订单在新旧两种粒度下都留了金额 ⇒ 按订单号汇总会重复。\n    const unresolvedCount = Number(registration.split_unresolved);\n    const unresolvedNote = Number.isFinite(unresolvedCount) && unresolvedCount > 0\n      ? ' <span style=\"color:var(--amber)\">· ' + unresolvedCount + \" 笔退款明细归不到订单行，未登记</span>\"\n      : \"\";\n    const legacyCount = Number(registration.legacy_rows);\n    const legacyNote = Number.isFinite(legacyCount) && legacyCount > 0\n      ? ' <span style=\"color:var(--amber)\">· 该单还有 ' + legacyCount + \" 行老格式（多 SKU 挤一格），未覆盖，按订单号汇总会重复</span>\"\n      : \"\";\n    // v26.94：表格行数是固定的（开放平台没有插入行接口，程序无法自己扩容），\n    // 余量偏少必须在这里说出来，否则下一次就是静默写不进去。阈值由后端给（sheet_low）。\n    const remaining = Number(registration.sheet_remaining);\n    const capacityNote = registration.sheet_low === true && Number.isFinite(remaining)\n      ? ' <span style=\"color:var(--amber)\">· 表格仅剩 ' + remaining + \" 行，请给「新退款表」插入更多行</span>\"\n      : \"\";\n    // v26.96：这一笔的 SKU 写的是 ERP 配对编码还是平台货号 —— 就两个字，但它是\n    // 「表里那串 SKU 能不能拿去对库存」的判据，所以留在结果行上（旧任务没有该字段 ⇒ 不显示）。\n    const skuSource = String(registration.sku_source || \"\");\n    const skuNote = skuSource === \"erp\" ? \" · ERP SKU\" : (skuSource === \"platform\" ? \" · 平台 SKU\" : \"\");\n    return '<span style=\"color:var(--green)\">已登记腾讯文档' + suffix + \"</span>\" + splitNote + unresolvedNote + legacyNote + capacityNote + skuNote;\n  }\n  if (registration.status === \"skipped\") {\n    return '<span style=\"color:var(--amber)\">未连接腾讯文档</span>';\n  }\n  const error = registration.error ? \"：\" + escapeHtml(String(registration.error).slice(0, 100)) : \"\";\n  const retry = registration.job_id\n    ? ' <button type=\"button\" class=\"btn btn-sm\" data-refund-registration-retry=\"' + escapeAttr(registration.job_id) + '\">重试登记</button>'\n    : \"\";\n  return '<span style=\"color:var(--red)\">' + (manual ? \"腾讯文档登记失败\" : \"退款成功，但腾讯文档登记失败\") + error + \"</span>\" + retry;\n}\n\nfunction refundRegistrationClass(registration) {\n  return registration && [\"failed\", \"skipped\"].includes(registration.status)\n    ? \"r-status warn\"\n    : \"r-status ok\";\n}\n\nfunction stopRefundRegistrationPolling(node) {\n  if (!node || !node._refundRegistrationTimer) return;\n  clearInterval(node._refundRegistrationTimer);\n  node._refundRegistrationTimer = null;\n  node._refundRegistrationJobId = \"\";\n}\n\nfunction renderRefundRegistrationStatus(node, registration, options = {}) {\n  if (!node) return;\n  const manual = options.manual === true || node._refundRegistrationManual === true;\n  node._refundRegistrationManual = manual;\n  node.innerHTML = refundRegistrationMarkup(registration, { manual });\n  node.className = refundRegistrationClass(registration);\n  const jobId = String(registration && registration.job_id || \"\").trim();\n  if (!jobId || ![\"queued\", \"processing\"].includes(registration.status)) {\n    stopRefundRegistrationPolling(node);\n    return;\n  }\n  if (node._refundRegistrationJobId === jobId && node._refundRegistrationTimer) return;\n  stopRefundRegistrationPolling(node);\n  node._refundRegistrationJobId = jobId;\n  const poll = async () => {\n    try {\n      const data = await api(\"/api/refund/registration/status?job_id=\" + encodeURIComponent(jobId));\n      const next = data.registration || {};\n      renderRefundRegistrationStatus(node, next, { manual });\n    } catch (error) {\n      // 退款已经成功，登记状态查询短暂失败时保留“登记中”，避免误报退款失败。\n    }\n  };\n  poll();\n  node._refundRegistrationTimer = setInterval(poll, 1500);\n}\n\ndocument.addEventListener(\"click\", async (event) => {\n  const button = event.target && event.target.closest\n    ? event.target.closest(\"[data-refund-registration-retry]\")\n    : null;\n  if (!button) return;\n  const jobId = button.getAttribute(\"data-refund-registration-retry\");\n  if (!jobId) return;\n  button.disabled = true;\n  button.textContent = \"重试中…\";\n  try {\n    const data = await api(\"/api/refund/registration/retry\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ job_id: jobId }),\n    });\n    const node = button.closest(\".r-status\") || button.parentElement;\n    renderRefundRegistrationStatus(node, data.registration || { status: \"queued\", job_id: jobId }, { manual: !!(node && node._refundRegistrationManual) });\n  } catch (error) {\n    button.disabled = false;\n    button.textContent = \"重试登记\";\n  }\n});\n\nasync function lookupOrder() {\n  const st = $(\"rfLookupStatus\");\n  $(\"rfRegistrationStatus\").textContent = \"\";\n  $(\"rfRegistrationStatus\").className = \"r-status\";\n  const shopId = $(\"rfShop\").value;\n  const orderId = $(\"rfOrderId\").value.trim();\n  if (!orderId) { st.textContent = \"请输入订单号\"; st.className = \"r-status err\"; return; }\n  st.textContent = \"查询中…\"; st.className = \"r-status\";\n  try {\n    const d = await api(`/api/order?shop_id=${shopId}&order_id=${encodeURIComponent(orderId)}`);\n    CURRENT_ORDER = d;\n    const o = d.order;\n    $(\"rfOrderInfo\").innerHTML = `订单 <b>${o.order_id}</b> · 状态 ${o.order_state} · 币种 ${o.currency_iso_code || \"EUR\"} · 下单 ${new Date(o.created_date).toLocaleString(\"zh-CN\")}`;\n    const rows = (o.order_lines || []).map((l) => {\n      const canRefund = l.can_refund !== false && l.remaining_amount > 0;\n      return `<tr data-line=\"${l.order_line_id}\" data-price=\"${Number(l.price || 0)}\" data-remain=\"${l.remaining_amount}\" data-ship=\"${Number(l.shipping_price || 0)}\">\n        <td><input type=\"checkbox\" class=\"rf-line\" value=\"${l.order_line_id}\" ${canRefund ? \"checked\" : \"disabled\"}></td>\n        <td>${(l.offer_sku || \"\").slice(0, 24)}</td>\n        <td>${(l.product_title || \"\").slice(0, 30)}</td>\n        <td class=\"num\">${Number(l.price).toFixed(2)}</td>\n        <td class=\"num\">${Number(l.shipping_price || 0).toFixed(2)}</td>\n        <td class=\"num\">${l.refunded_amount.toFixed(2)}</td>\n        <td class=\"num\"><b>${l.remaining_amount.toFixed(2)}</b></td>\n        <td class=\"num\">${l.remaining_quantity}</td>\n        <td><input type=\"number\" class=\"rf-amount\" value=\"${canRefund ? l.remaining_amount.toFixed(2) : \"0\"}\" min=\"0\" max=\"${l.remaining_amount}\" step=\"0.01\" style=\"width:88px;padding:4px 6px;font-size:12px;background:var(--card2);color:var(--text);border:1px solid var(--border);border-radius:6px;\" ${canRefund ? \"\" : \"disabled\"}></td>\n        <td>${canRefund ? '<span style=\"color:var(--green)\">可退</span>' : '<span style=\"color:var(--muted)\">不可退/已退完</span>'}</td>\n      </tr>`;\n    }).join(\"\");\n    $(\"rfLines\").innerHTML = `<thead><tr>\n      <th style=\"width:36px\"></th><th>SKU</th><th>商品</th><th class=\"num\">金额</th><th class=\"num\">运费</th>\n      <th class=\"num\">已退</th><th class=\"num\">可退</th><th class=\"num\">数量</th><th class=\"num\">本次退款(€)</th><th>状态</th>\n    </tr></thead><tbody>${rows}</tbody>`;\n    $(\"rfOrderPanel\").classList.remove(\"hidden\");\n    // 金额改动时更新合计\n    $(\"rfLines\").querySelectorAll(\".rf-amount\").forEach((el) => el.addEventListener(\"input\", updateRefundTotal));\n    updateRefundTotal();\n    st.textContent = \"已加载\"; st.className = \"r-status ok\";\n    await loadReasons(shopId);\n  } catch (e) {\n    st.textContent = \"查询失败：\" + e.message; st.className = \"r-status err\";\n    $(\"rfOrderPanel\").classList.add(\"hidden\");\n  }\n}\n\n// 按比例填充每行的退款金额（基于订单行原始金额 price，不超过可退金额）\nfunction applyRefundRatio() {\n  const ratio = Number($(\"rfRatio\").value) / 100;\n  document.querySelectorAll(\"#rfLines tbody tr\").forEach((tr) => {\n    const cb = tr.querySelector(\".rf-line\");\n    const amtInput = tr.querySelector(\".rf-amount\");\n    if (!amtInput || amtInput.disabled) return;\n    const price = Number(tr.dataset.price || 0);\n    const remain = Number(tr.dataset.remain || 0);\n    let v = price * ratio;\n    if (v > remain) v = remain; // 不超过可退金额\n    amtInput.value = v.toFixed(2);\n  });\n  updateRefundTotal();\n}\n\n// 更新合计（含运费）\nfunction updateRefundTotal() {\n  const rows = Array.from(document.querySelectorAll(\"#rfLines tbody tr\"));\n  let total = 0;\n  for (const tr of rows) {\n    const cb = tr.querySelector(\".rf-line\");\n    const amtInput = tr.querySelector(\".rf-amount\");\n    if (!cb || !cb.checked || !amtInput) continue;\n    total += Number(amtInput.value || 0) + Number(tr.dataset.ship || 0);\n  }\n  const hint = $(\"rfTotalHint\");\n  if (hint) hint.innerHTML = `本次退款合计：<b style=\"color:var(--green)\">€${total.toFixed(2)}</b>（含运费）`;\n}\n\nasync function submitRefund() {\n  const st = $(\"rfStatus\");\n  if (!CURRENT_ORDER) { st.textContent = \"请先查询订单\"; st.className = \"r-status err\"; return; }\n  // 收集勾选行 + 各自的自定义退款金额\n  const lineItems = [];\n  document.querySelectorAll(\"#rfLines tbody tr\").forEach((tr) => {\n    const cb = tr.querySelector(\".rf-line\");\n    if (!cb || !cb.checked) return;\n    const amtInput = tr.querySelector(\".rf-amount\");\n    const amount = Number((amtInput && amtInput.value) || 0);\n    if (amount <= 0) return;\n    lineItems.push({\n      order_line_id: cb.value,\n      amount: Number(amount.toFixed(2)),\n      ship: Number(tr.dataset.ship || 0),\n    });\n  });\n  if (lineItems.length === 0) { st.textContent = \"请勾选至少一行且退款金额大于 0\"; st.className = \"r-status err\"; return; }\n  const reasonCode = $(\"rfReason\").value;\n  if (!reasonCode) { st.textContent = \"请选择退款原因\"; st.className = \"r-status err\"; return; }\n  const o = CURRENT_ORDER.order;\n  const total = lineItems.reduce((s, l) => s + l.amount + l.ship, 0);\n  if (!confirm(`确认退款？\\n\\n订单：${o.order_id}\\n行数：${lineItems.length}\\n金额合计：€${total.toFixed(2)}（含运费）\\n原因：${refundReasonLabel(reasonCode)}\\n\\n此操作不可撤销！`)) return;\n\n  st.textContent = \"退款中…\"; st.className = \"r-status\";\n  const errs = [];\n  const notices = [];\n  const registrationEventId = clientRefundRegistrationEventId();\n  let done = 0;\n  let successfulRefundAmount = 0;\n  // v26.101：把**退款成功的每一行**记下来 —— 登记改成「一行一个 SKU」之后，\n  // 只报一个总额是不够的（后端没法知道这笔钱该记到哪个 SKU 上）。\n  const successfulLines = [];\n  for (const l of lineItems) {\n    try {\n      const resp = await api(\"/api/refund\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          shop_id: CURRENT_ORDER.shop.shop_id,\n          order_id: o.order_id,\n          order_line_id: l.order_line_id,\n          reason_code: reasonCode,\n          amount: l.amount,\n          shipping_amount: l.ship,\n          currency: o.currency_iso_code,\n          defer_registration: true,\n          registration_event_id: registrationEventId,\n        }),\n      });\n      done++;\n      successfulRefundAmount += l.amount + l.ship;\n      successfulLines.push({ order_line_id: l.order_line_id, amount: l.amount, shipping_amount: l.ship });\n      if (resp && resp.notice) notices.push(resp.notice);\n    } catch (e) {\n      errs.push(`${l.order_line_id}: ${e.message}`);\n    }\n  }\n  let registration = null;\n  if (done > 0) {\n    try {\n      const registrationResponse = await api(\"/api/refund/register\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          shop_id: CURRENT_ORDER.shop.shop_id,\n          order_id: o.order_id,\n          current_amount: Number(successfulRefundAmount.toFixed(2)),\n          // v26.101：把成功退款的每一行带给登记 —— 后端据此一行一个 SKU 地写。\n          refunds: successfulLines,\n          registration_event_id: registrationEventId,\n        }),\n      });\n      registration = registrationResponse.registration || {\n        ok: false,\n        status: \"failed\",\n        error: \"未返回腾讯文档登记状态\",\n      };\n    } catch (e) {\n      registration = { ok: false, status: \"failed\", error: e.message };\n    }\n  }\n  const registrationNode = $(\"rfRegistrationStatus\");\n  if (registrationNode) {\n    renderRefundRegistrationStatus(registrationNode, registration);\n  }\n  if (errs.length === 0) {\n    st.textContent = `退款成功（${done} 行，€${total.toFixed(2)}）`;\n    st.className = \"r-status ok\";\n  } else {\n    st.textContent = `部分失败：成功 ${done} 行，失败 ${errs.length} 行 — ${errs[0]}`;\n    st.className = \"r-status err\";\n  }\n  // 自动通知结果\n  const noticeOk = notices.filter((n) => n && n.ok).length;\n  const noticeFail = notices.filter((n) => n && !n.ok).length;\n  if (notices.length > 0) {\n    const tip = document.createElement(\"div\");\n    tip.style.cssText = \"font-size:12px;margin-top:6px;\";\n    const noticeTarget = (notices.find((n) => n && n.ok && n.mode === \"reply\") ? \"当前线程\" : \"新建会话\");\n    const failedNotice = notices.find((n) => n && !n.ok) || {};\n    tip.innerHTML = noticeFail === 0\n      ? `已通过${noticeTarget}发送站内信通知买家（${noticeOk} 封${notices[0] && notices[0].lang === \"es\" ? \"，西班牙语\" : \"，德语\"}）`\n      : `站内信通知：成功 ${noticeOk} 封，失败 ${noticeFail} 封${failedNotice.retryable ? \"（可稍后重试）\" : \"\"} — ${escapeHtml(failedNotice.error || \"\")}`;\n    $(\"rfStatus\").parentElement.appendChild(tip);\n  }\n}\n\nasync function submitBulkRefund() {\n  const st = $(\"bkStatus\");\n  const shopId = $(\"bkShop\").value;\n  const reasonCode = $(\"bkReason\").value;\n  const ids = $(\"bkOrders\").value.split(/[\\r\\n,，\\s]+/).map((x) => x.trim()).filter(Boolean);\n  if (ids.length === 0) { st.textContent = \"请输入至少一个订单号\"; st.className = \"r-status err\"; return; }\n  if (!reasonCode) { st.textContent = \"请选择退款原因\"; st.className = \"r-status err\"; return; }\n  if (ids.length > 100) { st.textContent = \"单次最多 100 个订单\"; st.className = \"r-status err\"; return; }\n  if (!confirm(`确认批量全额退款？\\n\\n订单数：${ids.length}\\n店铺：${shopId === \"auto\" ? \"自动识别\" : (SHOPS.find((s) => s.shop_id === shopId) || {}).name}\\n原因：${refundReasonLabel(reasonCode)}\\n\\n将对每个订单的所有可退行执行全额退款（含运费）。此操作不可撤销！`)) return;\n\n  st.textContent = `执行中…（${ids.length} 个订单，自动模式会遍历店铺，请耐心等待）`;\n  st.className = \"r-status\";\n  try {\n    const d = await api(\"/api/bulk-refund\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ shop_id: shopId, order_ids: ids, reason_code: reasonCode }),\n    });\n    const r = d.results || [];\n    const cnt = (s) => r.filter((x) => x.status === s).length;\n    const nSent = r.filter((x) => x.notice === \"sent\").length;\n    $(\"bkSummary\").innerHTML = `共 ${d.total} 个订单：<span style=\"color:var(--green)\">成功 ${cnt(\"refunded\")}</span> · <span style=\"color:var(--amber)\">跳过 ${cnt(\"skipped\")}</span> · <span style=\"color:var(--red)\">未找到 ${cnt(\"not_found\")} / 失败 ${cnt(\"failed\")}</span> · <span style=\"color:var(--blue)\">已通知买家 ${nSent}</span>`;\n    $(\"bkTable\").innerHTML = `<thead><tr><th>订单号</th><th>店铺</th><th>状态</th><th class=\"num\">行数</th><th class=\"num\">金额</th><th>买家通知</th><th>腾讯文档登记</th><th>说明</th></tr></thead><tbody>${\n      r.map((x, index) => `<tr>\n        <td style=\"font-family:Consolas,monospace\">${x.order_id}</td>\n        <td>${x.shop || \"-\"}</td>\n        <td><span class=\"st-pill st-${x.status}\">${x.status}</span></td>\n        <td class=\"num\">${x.lines || \"-\"}</td>\n        <td class=\"num\">${x.amount !== undefined ? \"€\" + x.amount : \"-\"}</td>\n        <td>${x.notice === \"sent\"\n          ? `<span style=\"color:var(--green);font-size:11.5px\">${x.notice_mode === \"reply\" ? \"当前线程已发送\" : x.notice_mode === \"new\" ? \"新建会话已发送\" : \"已发送\"}${x.notice_lang === \"es\" ? \"（西语）\" : x.notice_lang === \"de\" ? \"（德语）\" : \"\"}</span>`\n          : x.notice ? `<span style=\"color:var(--red);font-size:11.5px\" title=\"${escapeAttr(String(x.notice_error || \"\"))}\">失败${x.notice_retryable ? \"（可重试）\" : \"\"}${x.notice_error ? \"：\" + escapeHtml(String(x.notice_error).slice(0, 90)) : \"\"}</span>` : \"-\"}</td>\n        <td><span class=\"bulk-registration-status\" data-registration-index=\"${index}\">${x.registration ? refundRegistrationMarkup(x.registration) : \"-\"}</span></td>\n        <td style=\"color:var(--muted);font-size:11.5px\">${x.detail ? JSON.stringify(x.detail).slice(0, 90) : (x.skips ? x.skips.map((s) => s.reason).join(\"；\") : \"\")}</td>\n      </tr>`).join(\"\")}</tbody>`;\n    r.forEach((item, index) => {\n      const node = document.querySelector(`.bulk-registration-status[data-registration-index=\"${index}\"]`);\n      if (node && item.registration) renderRefundRegistrationStatus(node, item.registration);\n    });\n    const registrationWritten = r.filter((x) => x.registration && x.registration.status === \"written\").length;\n    const registrationSkipped = r.filter((x) => x.registration && x.registration.status === \"skipped\").length;\n    const registrationFailed = r.filter((x) => x.registration && x.registration.status === \"failed\").length;\n    const registrationQueued = r.filter((x) => x.registration && x.registration.status === \"queued\").length;\n    const registrationProcessing = r.filter((x) => x.registration && x.registration.status === \"processing\").length;\n    const registrationNote = [];\n    if (registrationWritten) registrationNote.push(\"已登记 \" + registrationWritten);\n    if (registrationQueued) registrationNote.push(\"排队中 \" + registrationQueued);\n    if (registrationProcessing) registrationNote.push(\"登记中 \" + registrationProcessing);\n    if (registrationSkipped) registrationNote.push(\"未连接 \" + registrationSkipped);\n    if (registrationFailed) registrationNote.push(\"登记失败 \" + registrationFailed);\n    if (registrationNote.length) {\n      $(\"bkSummary\").insertAdjacentHTML(\n        \"beforeend\",\n        ' · <span style=\"color:var(--blue)\">腾讯文档：' + escapeHtml(registrationNote.join(\"、\")) + \"</span>\",\n      );\n    }\n    $(\"bkResult\").classList.remove(\"hidden\");\n    st.textContent = \"已完成\"; st.className = \"r-status ok\";\n  } catch (e) {\n    st.textContent = \"执行失败：\" + e.message; st.className = \"r-status err\";\n  }\n}\n\n// ---- 多包裹发货（ST01）----\nlet MP_ORDER = null;\nlet MP_PKG_SEQ = 0;\n\nfunction mpAddPackage() {\n  MP_PKG_SEQ++;\n  const idx = MP_PKG_SEQ;\n  const wrap = document.createElement(\"div\");\n  wrap.className = \"s-form\";\n  wrap.style.marginBottom = \"16px\";\n  wrap.dataset.pkg = idx;\n  wrap.innerHTML = `\n    <div style=\"display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;\">\n      <h3 style=\"font-size:14px;font-weight:600;\">包裹 #${idx}</h3>\n      <button class=\"btn btn-sm\" onclick=\"this.closest('[data-pkg]').remove()\">删除该包裹</button>\n    </div>\n    <div class=\"s-field carrier-picker\">\n      <label>承运商（支持搜索）</label>\n      <input class=\"s-input mp-carrier-search\" placeholder=\"点击选择或输入搜索，如 DHL\" autocomplete=\"off\">\n      <div class=\"carrier-drop\" style=\"display:none;\"></div>\n      <div class=\"mp-carrier-sel\" style=\"margin-top:8px;font-size:12.5px;color:var(--green);\"></div>\n    </div>\n    <div class=\"s-field\">\n      <label>物流单号</label>\n      <input class=\"s-input mp-tracking\" placeholder=\"该包裹的运单号\">\n      <div class=\"url-preview\" style=\"display:none;\">\n        <div class=\"up-label\">平台将使用的查询链接</div>\n        <div class=\"up-url\"></div>\n      </div>\n    </div>\n    <div class=\"s-field mp-custom\" style=\"display:none;\">\n      <label>自定义承运商名称</label>\n      <input class=\"s-input mp-cname\" placeholder=\"如：Local Courier\">\n      <label style=\"margin-top:8px;\">查询链接 URL（选填）</label>\n      <input class=\"s-input mp-curl\" placeholder=\"https://...\">\n    </div>\n    <div class=\"s-field\">\n      <label>本包裹包含的订单行（勾选并填数量）</label>\n      <div class=\"mp-lines\"></div>\n    </div>`;\n  $(\"mpPackages\").appendChild(wrap);\n\n  // 承运商搜索\n  const search = wrap.querySelector(\".mp-carrier-search\");\n  const drop = wrap.querySelector(\".carrier-drop\");\n  const render = (kw) => {\n    const k = (kw || \"\").trim().toLowerCase();\n    let list = k ? CARRIERS.filter((c) => (c.zh_label || \"\").toLowerCase().includes(k) || (c.label || \"\").toLowerCase().includes(k) || (c.code || \"\").toLowerCase().includes(k)) : CARRIERS;\n    const rows = ['<div class=\"carrier-opt\" data-code=\"OTHER\"><span class=\"co-zh\">其他 / 自定义承运商</span><span class=\"co-code\">OTHER</span></div>'];\n    if (list.length === 0) rows.push('<div class=\"carrier-empty\">未找到匹配的承运商</div>');\n    else {\n      const pref = [\"DHL\", \"dhl-express\", \"DPD\", \"gls-de\", \"Hermes\", \"DPAG\", \"UPS\"];\n      list.sort((a, b) => {\n        const ia = pref.indexOf(a.code), ib = pref.indexOf(b.code);\n        if (ia !== -1 || ib !== -1) return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);\n        return (a.zh_label || \"\").localeCompare(b.zh_label || \"\");\n      });\n      for (const c of list.slice(0, 60)) {\n        rows.push(`<div class=\"carrier-opt\" data-code=\"${c.code}\"><span class=\"co-zh\">${c.zh_label || c.label}</span><span class=\"co-code\">${c.label !== c.zh_label ? c.label + \" · \" : \"\"}${c.code}</span></div>`);\n      }\n    }\n    drop.innerHTML = rows.join(\"\");\n    drop.querySelectorAll(\".carrier-opt\").forEach((el) => {\n      el.addEventListener(\"click\", () => {\n        const code = el.dataset.code;\n        drop.style.display = \"none\";\n        search.value = \"\";\n        if (code === \"OTHER\") {\n          wrap._carrier = { code: \"OTHER\", zh_label: \"其他 / 自定义承运商\", tracking_url: null };\n          wrap.querySelector(\".mp-carrier-sel\").textContent = \"已选择：其他 / 自定义承运商\";\n          wrap.querySelector(\".mp-custom\").style.display = \"block\";\n        } else {\n          const c = CARRIERS.find((x) => x.code === code);\n          wrap._carrier = c;\n          wrap.querySelector(\".mp-carrier-sel\").textContent = `已选择：${c.zh_label}（${c.label} · ${c.code}）`;\n          wrap.querySelector(\".mp-custom\").style.display = \"none\";\n        }\n        mpUpdateUrl(wrap);\n      });\n    });\n  };\n  search.addEventListener(\"focus\", () => { render(\"\"); drop.style.display = \"block\"; });\n  search.addEventListener(\"input\", (e) => { render(e.target.value); drop.style.display = \"block\"; });\n  document.addEventListener(\"click\", (e) => { if (!e.target.closest(\".carrier-picker\")) drop.style.display = \"none\"; });\n  wrap.querySelector(\".mp-tracking\").addEventListener(\"input\", () => mpUpdateUrl(wrap));\n\n  // 订单行勾选\n  const linesBox = wrap.querySelector(\".mp-lines\");\n  if (MP_ORDER) {\n    linesBox.innerHTML = `<table class=\"line-tbl\"><thead><tr>\n      <th style=\"width:40px\">发</th><th>商品</th><th class=\"num\">订单数量</th><th style=\"width:90px\">本包裹数量</th>\n    </tr></thead><tbody>${\n      (MP_ORDER.order_lines || []).map((l, li) => `<tr>\n        <td><input type=\"checkbox\" class=\"mp-line-cb\" data-line=\"${l.order_line_id}\"></td>\n        <td>${(l.product_title || l.offer_sku || \"\").slice(0, 46)}</td>\n        <td class=\"num\">${l.quantity}</td>\n        <td><input type=\"number\" class=\"s-input mp-line-qty\" data-line=\"${l.order_line_id}\" min=\"1\" max=\"${l.quantity}\" value=\"1\" style=\"padding:4px 8px;\"></td>\n      </tr>`).join(\"\")}</tbody></table>`;\n  } else {\n    linesBox.innerHTML = '<div style=\"font-size:12px;color:var(--muted)\">请先查询订单</div>';\n  }\n  mpUpdateUrl(wrap);\n}\n\nfunction mpUpdateUrl(wrap) {\n  const num = (wrap.querySelector(\".mp-tracking\") || {}).value ? wrap.querySelector(\".mp-tracking\").value.trim() : \"\";\n  const pv = wrap.querySelector(\".url-preview\");\n  const c = wrap._carrier;\n  if (!c || c.code === \"OTHER\" || !c.tracking_url) { pv.style.display = \"none\"; return; }\n  pv.style.display = \"block\";\n  const url = c.tracking_url.replace(/\\{trackingId\\}/g, encodeURIComponent(num || \"\"));\n  pv.querySelector(\".up-url\").innerHTML = num ? `<a href=\"${url}\" target=\"_blank\">${url}</a>` : c.tracking_url + \"   ← 填入运单号后自动补全\";\n}\n\nasync function mpLookup() {\n  const st = $(\"mpLookupStatus\");\n  const orderId = $(\"mpOrderId\").value.trim();\n  if (!orderId) { st.textContent = \"请输入订单号\"; st.className = \"s-status err\"; return; }\n  st.textContent = \"查询中…\"; st.className = \"s-status\";\n  try {\n    const d = await api(`/api/order?shop_id=${$(\"mpShop\").value}&order_id=${encodeURIComponent(orderId)}`);\n    MP_ORDER = d.order;\n    st.textContent = `已加载 ${MP_ORDER.order_id}（${(MP_ORDER.order_lines || []).length} 行）`;\n    st.className = \"s-status ok\";\n    $(\"mpPackages\").innerHTML = \"\";\n    MP_PKG_SEQ = 0;\n    mpAddPackage();\n    $(\"mpActions\").classList.remove(\"hidden\");\n  } catch (e) {\n    st.textContent = \"查询失败：\" + e.message;\n    st.className = \"s-status err\";\n  }\n}\n\nasync function mpSubmit() {\n  const st = $(\"mpStatus\");\n  const pkgs = Array.from(document.querySelectorAll(\"#mpPackages [data-pkg]\"));\n  if (pkgs.length === 0) { st.textContent = \"请至少添加一个包裹\"; st.className = \"s-status err\"; return; }\n  const packages = [];\n  for (const p of pkgs) {\n    const c = p._carrier;\n    if (!c) { st.textContent = \"有包裹未选择承运商\"; st.className = \"s-status err\"; return; }\n    const lines = Array.from(p.querySelectorAll(\".mp-line-cb:checked\")).map((cb) => {\n      const lid = cb.dataset.line;\n      const qty = Number(p.querySelector(`.mp-line-qty[data-line=\"${lid}\"]`).value || 0);\n      return { order_line_id: lid, quantity: qty };\n    }).filter((l) => l.quantity > 0);\n    if (lines.length === 0) { st.textContent = \"有包裹未勾选订单行\"; st.className = \"s-status err\"; return; }\n    if (c.code !== \"OTHER\" && !(p.querySelector(\".mp-tracking\") || {}).value) {\n      st.textContent = \"有包裹未填写物流单号\"; st.className = \"s-status err\"; return;\n    }\n    packages.push({\n      carrier_code: c.code,\n      carrier_name: c.code === \"OTHER\" ? p.querySelector(\".mp-cname\").value.trim() : undefined,\n      carrier_url: c.code === \"OTHER\" ? p.querySelector(\".mp-curl\").value.trim() : undefined,\n      tracking_number: p.querySelector(\".mp-tracking\").value.trim(),\n      lines,\n    });\n  }\n  const totalQty = packages.reduce((s, p) => s + p.lines.reduce((a, l) => a + l.quantity, 0), 0);\n  if (!confirm(`确认多包裹发货？\\n\\n订单：${MP_ORDER.order_id}\\n包裹数：${packages.length}\\n发货总件数：${totalQty}\\n\\n提交后这些包裹将直接标记为已发货（SHIPPED）。`)) return;\n\n  st.textContent = \"提交中…\"; st.className = \"s-status\";\n  try {\n    const d = await api(\"/api/ship-multi\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ shop_id: $(\"mpShop\").value, order_id: MP_ORDER.order_id, packages }),\n    });\n    const okN = (d.success || []).length;\n    const errN = (d.errors || []).length;\n    $(\"mpResultBody\").innerHTML = `\n      <div style=\"margin-bottom:8px;\">共提交 ${d.sent} 个包裹：<span style=\"color:var(--green)\">成功 ${okN}</span> · <span style=\"color:var(--red)\">失败 ${errN}</span></div>\n      ${(d.success || []).map((s) => `<div style=\"padding:6px 0;border-bottom:1px solid var(--border-soft);\">\n        包裹 ${s.id} · 状态 <b>${s.status}</b>${s.tracking && s.tracking.tracking_number ? \" · 单号 \" + s.tracking.tracking_number : \"\"}\n      </div>`).join(\"\")}\n      ${(d.errors || []).map((e) => `<div style=\"padding:6px 0;color:var(--red);\">${e.order_id}: ${e.message}</div>`).join(\"\")}`;\n    $(\"mpResult\").classList.remove(\"hidden\");\n    if (d.ship_confirm && d.ship_confirm.note) {\n      $(\"mpResultBody\").innerHTML += `<div style=\"margin-top:8px;color:var(--green);\">发货标记：${d.ship_confirm.note}</div>`;\n    }\n    st.textContent = errN === 0 ? \"全部发货成功（已标记发货）\" : `部分失败（${errN}）`;\n    st.className = errN === 0 ? \"s-status ok\" : \"s-status err\";\n  } catch (e) {\n    st.textContent = \"提交失败：\" + e.message;\n    st.className = \"s-status err\";\n  }\n}\n\n// ---- 报价模块（OF21 拉取 / OF24 修改）----\nlet OFFERS = [];\nlet OFFER_STATES = [];\nlet OFFER_DIRTY = new Map(); // shop_sku -> 修改后的对象\n// v26.102：报价模块的**子模块**（manage = 报价管理 / sku = 按商品SKU 查全店报价）。\n// 与左侧导航无关：报价仍是导航里的一个模块，这里是它内部的子页面切换。\nlet OFFER_TAB = \"manage\";\n\n// OF61 返回平台可配置的成色字典。展示层只呈现状态名称，编码仅保留在\n// option.value 中用于 OF24 提交，避免把内部 code 暴露给操作人员。\nconst OFFER_STATE_ZH = {\n  \"new\": \"全新\",\n  \"brand new\": \"全新\",\n  \"like new\": \"近乎全新\",\n  \"used - like new\": \"近乎全新\",\n  \"used like new\": \"近乎全新\",\n  \"good\": \"成色良好\",\n  \"used - good\": \"成色良好\",\n  \"used good\": \"成色良好\",\n  \"acceptable\": \"成色一般\",\n  \"used - acceptable\": \"成色一般\",\n  \"used acceptable\": \"成色一般\",\n  \"refurbished\": \"翻新\",\n  \"renewed\": \"翻新\",\n  \"damaged\": \"有损\",\n  \"for parts\": \"仅供拆件\",\n  \"not specified\": \"未说明\",\n};\n\nfunction normalizeOfferState(raw) {\n  if (!raw || typeof raw !== \"object\") return null;\n  const code = raw.code ?? raw.state_code ?? raw.stateCode ?? raw.id;\n  if (code === undefined || code === null || String(code).trim() === \"\") return null;\n  const sourceLabel = raw.label ?? raw.name ?? raw.title ?? raw.description ?? raw.value ?? \"\";\n  const label = String(sourceLabel).trim();\n  const key = label.toLowerCase().replace(/[：:]/g, \":\").replace(/\\s+/g, \" \");\n  return { code: String(code), label: OFFER_STATE_ZH[key] || label || \"未命名成色\" };\n}\n\nfunction offerStateLabel(code) {\n  const found = OFFER_STATES.find((s) => String(s.code) === String(code));\n  return found?.label || \"成色状态待同步\";\n}\n\nfunction initOffersPage() {\n  const box = $(\"pageOffers\");\n  if (box.dataset.ready === \"1\") return;\n  box.dataset.ready = \"1\";\n  box.innerHTML = `<div class=\"offers operation-shell\">\n    <header class=\"operation-header\"><h2>报价</h2>\n    <div class=\"s-sub\" id=\"offersShopTag\"></div></header>\n    <!-- v26.102：报价模块内部的子模块切换（照抄退款页「单笔/批量/手动登记」的范式）。\n         ⛔ 这两个 tab 的点击处理必须用「#pageOffers .r-tabs .rt」限定容器 —— 退款页用的是\n         「.r-tabs .rt」，两个页面同时存在于 DOM，不限定就会互相误伤（详见 initRefundPage 的注释）。\n         ⛔ 本段在 JS 模板字符串里，注释中一律不许出现反引号（会截断模板字符串）。 -->\n    <div class=\"r-tabs\" style=\"margin-bottom:16px;\">\n      <span class=\"rt active\" data-t=\"manage\">报价管理</span>\n      <span class=\"rt\" data-t=\"sku\">按商品SKU 查全店报价</span>\n    </div>\n\n    <!-- ===== 子模块①：报价管理（原有功能，未改动）===== -->\n    <div id=\"ofPaneManage\">\n    <div class=\"s-form workflow-panel\">\n      <div class=\"s-field\" style=\"display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;\">\n        <div style=\"min-width:200px;\">\n          <label>店铺</label>\n          <select id=\"ofShop\" class=\"s-input\"></select>\n        </div>\n        <div style=\"flex:1; min-width:240px;\">\n          <label>模糊搜索（SKU）</label>\n          <input id=\"ofSearch\" class=\"s-input\" placeholder=\"输入关键字，如 Drohne；加载后即时过滤\">\n        </div>\n        <div style=\"min-width:150px;\">\n          <label>可售状态</label>\n          <select id=\"ofActiveFilter\" class=\"s-input\" title=\"库存为 0 的报价平台会置为不可售，这里不会过滤掉它们，只会按状态筛选显示\">\n            <option value=\"all\">全部</option>\n            <option value=\"inactive\">仅不可售</option>\n            <option value=\"active\">仅可售</option>\n            <option value=\"unknown\">仅未知</option>\n          </select>\n        </div>\n        <button class=\"btn primary\" id=\"btnOfFetch\" title=\"1 小时内有缓存时直接使用缓存（秒回）\">加载全部报价</button>\n        <button class=\"btn\" id=\"btnOfReload\" title=\"跳过缓存，重新从平台拉取最新数据（主店走导出约 5 秒；AT/ES 等共享 key 店铺走分页，几分钟，期间先显示旧数据）\">强制刷新</button>\n      </div>\n      <div style=\"font-size:11.5px;color:var(--muted);margin-top:6px;\">\n        <span class=\"icon-svg icon-clock inline-icon\"></span><b>加载全部报价</b>：优先使用 1 小时内的缓存（秒回）；<b>强制刷新</b>：跳过缓存重新拉取（主店走导出约 5 秒；AT/ES 等走分页需几分钟，期间先用旧数据，拉完自动切换）。\n        表格中直接编辑原价/折扣价/库存/成色/时效，改完点「保存修改」（改价走价格导入、库存/成色/时效走报价导入，自动分流）。\n        <b>库存为 0 会被平台置为不可售（active=false）</b>，这些报价同样在列表里，不会过滤掉；用「可售状态」可以只看它们。\n      </div>\n      <div style=\"display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-top:10px;\">\n        <span class=\"s-status\" id=\"ofStatus\"></span>\n        <button class=\"btn primary\" id=\"btnOfSave\" style=\"margin-left:auto; display:none;\">保存修改</button>\n      </div>\n      <div id=\"ofTable\" style=\"max-height:560px; overflow-y:auto; margin-top:8px;\"></div>\n    </div>\n    </div><!-- /子模块① 报价管理 -->\n\n    <!-- ===== 子模块②：按商品SKU 查全店报价（v26.102）+ 顺手改价 / 库存 / 时效 ===== -->\n    <div id=\"ofPaneSku\" class=\"hidden\">\n      <div class=\"r-warn guardrail-callout\">\n        <span class=\"icon-svg icon-alert inline-icon\"></span><b>这里改的是线上真报价</b>。可改字段：<b>价格（原价 / 折扣价）+ 库存 + 时效</b>；\n        成色（state_code）只读，但保存时会原样带入 —— 报价导入（OF24）是<b>覆盖式</b>的，漏字段会把库存/成色重置。\n        改价走价格文件导入（PRI01）、库存与时效走报价导入（OF24），提交前弹确认框，操作写入本地日志 <code>mail.log</code>。\n      </div>\n\n      <div class=\"s-form workflow-panel\">\n        <div style=\"display:flex;gap:10px;align-items:flex-end;flex-wrap:wrap;\">\n          <div style=\"flex:1;min-width:290px;\">\n            <label>商品SKU 或 平台SKU（现场查 ITGOAL「商品配对」，秒级返回）</label>\n            <input id=\"skuOfferInput\" class=\"s-input\" placeholder=\"严格精确、区分大小写，如 Forsman-DVD-G10R13-Bluray\">\n          </div>\n          <button class=\"btn primary\" id=\"btnSkuOfferQuery\" title=\"本机报价快照优先；本机没数据的店整店拉一次全量（OF51，每家几秒），然后在本地查找\">查询并整店拉取</button>\n          <button class=\"btn\" id=\"btnSkuOfferReadback\" title=\"跳过本机快照的旧值，把命中的店全部整店重拉一遍 —— 改完价/库存后用这个回读确认\">回读最新</button>\n          <button class=\"btn\" id=\"btnSkuOfferLocal\" title=\"不向 Mirakl 发请求：配对仍现场查 ITGOAL，但只用本机已有的报价快照定论\">只查本机</button>\n        </div>\n        <div id=\"skuOfferPairingState\" style=\"font-size:11.5px;color:var(--muted);margin-top:6px;\">配对查询状态读取中…</div>\n        <div style=\"font-size:11.5px;color:var(--muted);margin-top:6px;\">\n          <b>配对数据现场查</b>：输入「商品SKU」或「平台SKU」，当场调 ITGOAL「商品配对」接口（两列各查一次再合并，约 0.3~0.7 秒）\n          —— 不再需要整表同步，也没有那 2~3 分钟的等待。<br>\n          <b>查询并整店拉取</b>：拿到 (店铺, 平台SKU) 后先在本机报价快照里找；本机没数据的店整店拉一次\n          （OF51 同步导出：一次 GET 拿回整份 CSV，每家店几秒），落本机后<b>在本地查找</b>。\n          一次请求最多整店拉 <b>6</b> 家、总预算 25 秒；没轮到的店如实标「未拉到」并由界面自动续拉，绝不冒充成「平台没有」。\n        </div>\n        <div style=\"display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:10px;\">\n          <span class=\"s-status\" id=\"skuOfferPullStatus\"></span>\n          <button class=\"btn primary\" id=\"btnSkuOfferSave\" style=\"margin-left:auto;display:none;\">保存修改</button>\n        </div>\n        <div id=\"skuOfferSaveResult\" style=\"margin-top:8px;\"></div>\n        <!-- 报价导入（OF24）完成后的回执单独占一格：别写进 skuOfferSaveResult，\n             否则 2.5 秒后的「处理完成」会把上面那份含导入 ID / 失败明细的保存小结顶掉。 -->\n        <div id=\"skuOfferImportResult\" style=\"margin-top:8px;\"></div>\n        <div id=\"skuOfferResult\" style=\"margin-top:8px;\"></div>\n      </div>\n    </div><!-- /子模块② 按商品SKU 查全店报价 -->\n\n    <div id=\"ofResult\" style=\"margin-top:10px;\"></div>\n  </div>`;\n\n  $(\"ofShop\").innerHTML = SHOPS.map((s) => `<option value=\"${s.shop_id}\">${s.name}</option>`).join(\"\");\n  $(\"ofShop\").value = GLOBAL_SHOP;\n  $(\"btnOfFetch\").addEventListener(\"click\", () => fetchOffers(false));\n  $(\"btnOfReload\").addEventListener(\"click\", () => fetchOffers(true));\n  $(\"btnOfSave\").addEventListener(\"click\", saveOffers);\n  $(\"ofSearch\").addEventListener(\"input\", renderOfferTable);\n  $(\"ofActiveFilter\").addEventListener(\"change\", renderOfferTable);\n  $(\"ofShop\").addEventListener(\"change\", () => {\n    OFFERS = [];\n    OFFER_DIRTY.clear();\n    OFFER_STATES = [];\n    renderOfferTable();\n    loadOfferStates();\n  });\n  // 子模块切换（限定 #pageOffers，理由见 initRefundPage 里的同名注释）\n  document.querySelectorAll(\"#pageOffers .r-tabs .rt\").forEach((el) => {\n    el.addEventListener(\"click\", () => {\n      OFFER_TAB = el.dataset.t;\n      document.querySelectorAll(\"#pageOffers .r-tabs .rt\").forEach((x) => x.classList.toggle(\"active\", x === el));\n      $(\"ofPaneManage\").classList.toggle(\"hidden\", OFFER_TAB !== \"manage\");\n      $(\"ofPaneSku\").classList.toggle(\"hidden\", OFFER_TAB !== \"sku\");\n    });\n  });\n  $(\"btnSkuOfferQuery\").addEventListener(\"click\", () => querySkuOffers(\"pull\"));\n  $(\"btnSkuOfferReadback\").addEventListener(\"click\", () => querySkuOffers(\"readback\"));\n  $(\"btnSkuOfferLocal\").addEventListener(\"click\", () => querySkuOffers(\"local\"));\n  $(\"skuOfferInput\").addEventListener(\"keydown\", (e) => { if (e.key === \"Enter\") querySkuOffers(\"pull\"); });\n  $(\"btnSkuOfferSave\").addEventListener(\"click\", saveSkuOfferChanges);\n  refreshSkuOfferPairingState();\n}\n\n// ---- 按商品SKU 查全店报价（v26.105：配对数据现场单查）----\n// 配对口径：ITGOAL「商品配对」里 `sku`（平台SKU 列）/ `proCode`（商品SKU 列）任一**精确命中**\n// 即认定这家店在卖这款商品；两路各查一次再合并，0.3~0.7 秒返回（后端负责，前端只看结果）。\n// 取报价只有一条路：本机报价快照 —— 本机没数据的店由后端整店拉一次 OF51 全量\n// （与「加载全部报价」同一条通道，每家店几秒），落本机之后再在本地查找。\n// 结论四态分明，绝不把「本机没数据」说成「平台没有」。\nlet SKU_OFFER_RESULT = null;\nlet SKU_OFFER_DIRTY = new Map(); // `${shop_id}\\u0000${平台SKU}` -> 待保存的改动\n\nconst SKU_OFFER_STATUS_LABEL = { found: \"已查到\", missing: \"无此报价\", unknown: \"未拉到\", no_shop: \"无此店铺\" };\nconst SKU_OFFER_MATCHED_BY_LABEL = { platform_sku: \"平台SKU\", erp_sku: \"商品SKU\", both: \"两列都中\" };\nconst SKU_OFFER_SOURCE_LABEL = { local: \"本机快照\", pull: \"本次整店拉取\" };\n\nfunction skuOfferStatusColor(status) {\n  if (status === \"found\") return \"var(--green)\";\n  if (status === \"missing\") return \"var(--red)\";\n  return \"var(--muted)\";\n}\n\nfunction fmtSkuOfferTime(value) {\n  if (!value) return \"—\";\n  const d = new Date(value);\n  if (Number.isNaN(d.getTime())) return \"—\";\n  const pad = (n) => String(n).padStart(2, \"0\");\n  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`;\n}\n\nfunction renderSkuOfferPairingState(index) {\n  const box = $(\"skuOfferPairingState\");\n  if (!box) return;\n  if (!index) { box.textContent = \"配对查询状态不可用（后端未返回）\"; return; }\n  if (index.mode !== \"itgoal-live\") { box.textContent = \"配对查询：后端未启用 ITGOAL 现场单查\"; return; }\n  const parts = [`配对数据：<b style=\"color:var(--text)\">现场单查 ITGOAL「商品配对」</b>（不再需要整表同步）`];\n  if (index.last_query_at) {\n    parts.push(`上次查询 <b>${fmtSkuOfferTime(index.last_query_at)}</b> · <b>${escapeHtml(index.last_query_sku || \"—\")}</b> → ${index.last_query_hits || 0} 条候选`);\n  } else {\n    parts.push(\"本机还没查过\");\n  }\n  // 店铺维度的问题按口径分开报：非本账号店铺（已忽略）/ 店名未识别（等人认领）/ 缺平台SKU。\n  // ⛔ 三者绝不能合并成一句「N 行被跳过」——「知道它不属于我们」和「不认识它」是两回事。\n  const s = index.stats;\n  if (s) {\n    const extra = [];\n    if (s.foreign_rows) extra.push(`${s.foreign_rows} 行属于非本账号店铺（已忽略）`);\n    if (s.unmapped_rows) extra.push(`${s.unmapped_rows} 行店铺名未识别`);\n    if (s.no_platform_sku_rows) extra.push(`${s.no_platform_sku_rows} 行缺平台SKU`);\n    if (extra.length) parts.push(extra.join(\" · \"));\n  }\n  if (index.last_error) parts.push(`<span style=\"color:var(--red)\">上次查询失败：${escapeHtml(index.last_error)}</span>`);\n  box.innerHTML = parts.join(\" · \");\n}\n\n// ⛔ v26.105：配对数据是**同步现场查**的 ⇒ 没有「同步中」这个状态，因此也不再需要轮询。\n//    （旧版那套 5 秒轮询是为了等「2~3 分钟的整表同步」，随整表链路一并移除。）\nasync function refreshSkuOfferPairingState() {\n  try {\n    const data = await api(\"/api/offers/pairing-status\");\n    renderSkuOfferPairingState(data.index);\n  } catch (e) {\n    const box = $(\"skuOfferPairingState\");\n    if (box) box.innerHTML = `<span style=\"color:var(--red)\">配对查询状态读取失败：${escapeHtml(e.message)}</span>`;\n  }\n}\n\nfunction skuOfferKey(shopId, shopSku) { return String(shopId) + \"\\u0000\" + String(shopSku); }\n\nfunction refreshSkuOfferSaveButton() {\n  const btn = $(\"btnSkuOfferSave\");\n  if (!btn) return;\n  btn.style.display = SKU_OFFER_DIRTY.size > 0 ? \"\" : \"none\";\n  if (SKU_OFFER_DIRTY.size > 0) btn.textContent = `保存修改（${SKU_OFFER_DIRTY.size}）`;\n}\n\nfunction renderSkuOfferResult(data) {\n  const box = $(\"skuOfferResult\");\n  // ⛔ 配对查询失败 ≠ 查不到：必须把错误原样说出口。\n  //    后端 v26.105 起配对失败会回 `ok:false + error + hint`，绝不退化成「0 候选」——\n  //    否则「没查成」和「平台确实没有」在界面上长得一模一样。\n  if (data && data.ok === false && data.error) {\n    SKU_OFFER_RESULT = null;\n    SKU_OFFER_DIRTY.clear();\n    refreshSkuOfferSaveButton();\n    box.innerHTML = `<div class=\"carrier-empty\" style=\"padding:18px;\">`\n      + `<span style=\"color:var(--red)\">${escapeHtml(data.error)}</span>`\n      + (data.hint ? `<div style=\"margin-top:6px;font-size:11.5px;color:var(--muted)\">${escapeHtml(data.hint)}</div>` : \"\")\n      + `</div>`;\n    return;\n  }\n  if (!data || !data.ready) {\n    SKU_OFFER_RESULT = null;\n    SKU_OFFER_DIRTY.clear();\n    refreshSkuOfferSaveButton();\n    box.innerHTML = `<div class=\"carrier-empty\" style=\"padding:18px;\">${escapeHtml((data && data.hint) || \"还没有查询结果\")}</div>`;\n    return;\n  }\n  SKU_OFFER_RESULT = data;\n  // ⛔ 每次重画都按最新值重算基线：老结果里的「已改」绝不能跨查询残留\n  //    （否则会拿上一轮的输入值去覆盖这一次拉到的平台值）。\n  SKU_OFFER_DIRTY.clear();\n  refreshSkuOfferSaveButton();\n  const list = data.candidates || [];\n  if (list.length === 0) {\n    box.innerHTML = `<div class=\"carrier-empty\" style=\"padding:18px;\">ITGOAL 配对里没有 <b>${escapeHtml(data.sku)}</b> 的登记 —— 它既不是任何店铺的平台SKU，也不是任何店铺已配对的商品SKU。</div>`;\n    return;\n  }\n  const sum = data.summary || {};\n  const inpStyle = \"padding:4px 6px;font-size:12px;background:var(--card2);color:var(--text);border:1px solid var(--border);border-radius:6px;\";\n  const inp = (cls, val, step, width, extra) =>\n    `<input type=\"number\" step=\"${step}\" class=\"ofs-inp ${cls}\" value=\"${val === null || val === undefined ? \"\" : val}\" style=\"width:${width}px;${inpStyle}${extra || \"\"}\">`;\n  // ⛔ v26.104：平台**明确查不到报价**的行（status=\"missing\"）不再展示 —— 运营口径：那是噪音。\n  //    只过滤 missing。`unknown`（本机还没拉到）**必须留着**：它是「还没查」而不是「查不到」，\n  //    而且界面会自动续做整店拉取、把它变成确定结论；过滤掉就等于把「待拉取」藏起来。\n  //    ⚠️ `data-row` 仍写**在 list 里的原始下标**：过滤只是不渲染那个 <tr>，\n  //       若改成「可见列表的下标」，下面编辑监听的 list[Number(tr.dataset.row)] 会整体错位\n  //       （v26.102 那种「改了值不记账」的复现路径）。\n  const visible = [];\n  list.forEach((c, index) => { if (c.status !== \"missing\") visible.push({ c, index }); });\n  const hiddenMissing = list.length - visible.length;\n  const rows = visible.map(({ c, index }) => {\n    const o = c.offer || null;\n    const tone = skuOfferStatusColor(c.status);\n    const source = c.source ? (SKU_OFFER_SOURCE_LABEL[c.source] || c.source) : \"—\";\n    // ⛔ 行标识**必须用数字下标**：绝不许把复合键（含 \\u0000）写进 data-* 属性 ——\n    //    HTML 解析器会把属性值里的 U+0000 换成 U+FFFD（实测 code point 65533），\n    //    dataset.key 与 Map 的键就永远对不上 ⇒ 编辑监听整块被跳过，\n    //    表现就是 v26.102 的「改了报价却没有保存键」＋「折扣」列永远是「—」。\n    // 「命中列 / 成色 / 来源」三列按运营要求从表里撤掉，信息不丢：全部挂在行的悬停提示。\n    const titleAttr = escapeHtml(\n      `登记行号：${(c.source_rows || []).join(\", \") || \"—\"}`\n      + `｜命中列：${SKU_OFFER_MATCHED_BY_LABEL[c.matched_by] || c.matched_by || \"—\"}`\n      + `｜来源：${source}`\n      + `｜成色：${o ? (o.state_code ? String(o.state_code) : \"缺成色（只能改价；改库存/时效会被平台整批拒）\") : \"—\"}`\n      + (c.conflict ? \"｜冲突：同一(店铺,平台SKU)登记了多个商品SKU，这里全部列出\" : \"\")\n      + (c.note ? `｜${c.note}` : \"\")\n      + (c.snapshot_at ? `｜本机快照 ${fmtSkuOfferTime(c.snapshot_at)}` : \"\"),\n    ).replace(/\"/g, \"&quot;\");\n    // 只有**真拿到报价**的行才给输入框：缺数据的行给输入框会让人以为能改。\n    return `<tr data-row=\"${index}\" title=\"${titleAttr}\">\n      <td style=\"white-space:nowrap\">${escapeHtml(c.shop_name || c.shop_id)}<span style=\"color:var(--muted);font-size:10.5px\"> ${escapeHtml(c.shop_id)}</span></td>\n      <td style=\"font-family:Consolas,monospace;font-size:11.5px;max-width:230px;overflow:hidden;text-overflow:ellipsis\" title=\"${escapeHtml(c.platform_sku).replace(/\"/g, \"&quot;\")}\">${escapeHtml(c.platform_sku)}</td>\n      <td style=\"font-family:Consolas,monospace;font-size:11.5px;max-width:190px;overflow:hidden;text-overflow:ellipsis\">${c.erp_sku ? escapeHtml(c.erp_sku) : '<span style=\"color:var(--muted)\">（未配对）</span>'}</td>\n      <td style=\"font-size:11.5px;color:${tone};white-space:nowrap\">${SKU_OFFER_STATUS_LABEL[c.status] || c.status}</td>\n      <td class=\"num\">${o ? (o.active === true ? '<span style=\"color:var(--green)\">可售</span>' : o.active === false ? '<span style=\"color:var(--red)\">不可售</span>' : \"—\") : \"—\"}</td>\n      <td class=\"num\">${o ? inp(\"ofs-origin\", o.origin_price !== null && o.origin_price !== undefined ? o.origin_price : o.price, \"0.01\", 92) : \"—\"}</td>\n      <td class=\"num\">${o ? inp(\"ofs-disc\", o.discount_price, \"0.01\", 92, \"border-color:var(--green);\") : \"—\"}</td>\n      <td class=\"num ofs-pct\" style=\"font-size:11px;color:var(--muted)\">—</td>\n      <td class=\"num\">${o ? inp(\"ofs-qty\", o.quantity, \"1\", 66) : \"—\"}</td>\n      <td class=\"num\">${o ? inp(\"ofs-lead\", o.leadtime_to_ship, \"1\", 58) : \"—\"}</td>\n    </tr>`;\n  }).join(\"\");\n  // ⛔ 过滤后一条能显示的都没有 ⇒ 不能只丢一个空表：空表读起来像「没查到」，\n  //    而事实是「查到了、平台确实都没有」—— 必须把这句说出口。\n  if (visible.length === 0) {\n    box.innerHTML = `<div class=\"carrier-empty\" style=\"padding:18px;\">`\n      + `ITGOAL 配对里查到 <b>${escapeHtml(data.sku)}</b> 的 <b>${list.length}</b> 条登记，`\n      + `但这些店铺在平台上<b>都没有</b>这个报价 —— 按口径已全部不显示。</div>`;\n    return;\n  }\n  const pendingMore = sum.pull_pending\n    ? `<div style=\"padding:8px 12px 0;font-size:11.5px;color:var(--amber);\">还有 ${sum.pull_pending} 家店这一轮没轮到整店拉取 —— 界面会自动续拉，不必手动重试。</div>`\n    : \"\";\n  const unknownMore = sum.unknown\n    ? `<div style=\"padding:8px 12px 0;font-size:11.5px;color:var(--amber);\">还有 ${sum.unknown} 条本机没拿到数据，状态是「未拉到」—— <b>这不等于「平台没有」</b>。点「查询并整店拉取」会继续整店补齐。</div>`\n    : \"\";\n  box.innerHTML = `<div style=\"overflow-x:auto;\"><table class=\"line-tbl\"><thead><tr>\n      <th style=\"min-width:148px\">店铺</th>\n      <th style=\"min-width:190px\">平台SKU</th>\n      <th style=\"min-width:160px\">商品SKU</th>\n      <th style=\"width:72px\">状态</th>\n      <th style=\"width:60px\">可售</th>\n      <th class=\"num\" style=\"width:100px\">原价 €</th>\n      <th class=\"num\" style=\"width:100px\">折扣价 €</th>\n      <th class=\"num\" style=\"width:58px\">折扣</th>\n      <th class=\"num\" style=\"width:74px\">库存</th>\n      <th class=\"num\" style=\"width:68px\">时效(天)</th>\n    </tr></thead><tbody>${rows}</tbody></table></div>\n    <div style=\"padding:8px 12px 0;font-size:11.5px;color:var(--muted);\">\n      <b>${escapeHtml(data.sku)}</b> · ${sum.total || 0} 条候选 / ${sum.shops || 0} 家店\n      · 已查到 <b style=\"color:var(--green)\">${sum.found || 0}</b> · 无此报价 <b>${hiddenMissing}</b>（已隐藏） · 未拉到 ${sum.unknown || 0}${sum.no_shop ? ` · 无此店铺 ${sum.no_shop}` : \"\"}\n      ${sum.pulled_shops ? ` · 本次整店拉取 ${sum.pulled_shops} 家` : \"\"}${sum.pull_failed_shops ? `（失败 ${sum.pull_failed_shops}）` : \"\"}\n      · 可改：价格 / 库存 / 时效（成色只读，保存时原样带入）\n      · 命中列 / 成色 / 来源 已收进每行的悬停提示\n    </div>${pendingMore}${unknownMore}`;\n\n  // ---- 编辑监听：与「报价管理」页同一套判据（折扣价必须低于原价，否则不记账）----\n  const refreshPct = (tr) => {\n    const originEl = tr.querySelector(\".ofs-origin\");\n    const discEl = tr.querySelector(\".ofs-disc\");\n    const cell = tr.querySelector(\".ofs-pct\");\n    if (!originEl || !discEl || !cell) return;\n    const op = Number(originEl.value || 0);\n    const dp = discEl.value === \"\" ? null : Number(discEl.value);\n    if (dp !== null && op > 0 && op > dp) {\n      cell.textContent = \"-\" + Math.round((1 - dp / op) * 100) + \"%\";\n      cell.style.color = \"var(--red)\";\n    } else if (dp !== null && op > 0 && op <= dp) {\n      cell.textContent = \"无效\";\n      cell.style.color = \"var(--red)\";\n    } else {\n      cell.textContent = \"—\";\n      cell.style.color = \"var(--muted)\";\n    }\n  };\n  // 行 ↔ 候选：走 data-row 的数字下标（复合键不能进 HTML 属性，见 renderSkuOfferResult 上方注释）\n  box.querySelectorAll(\"tbody tr\").forEach((tr) => {\n    const cand = list[Number(tr.dataset.row)];\n    if (!cand || !cand.offer) return;\n    const o = cand.offer;\n    refreshPct(tr);\n    const handler = () => {\n      const originEl = tr.querySelector(\".ofs-origin\");\n      const discEl = tr.querySelector(\".ofs-disc\");\n      if (!originEl || !discEl) return;\n      const key = skuOfferKey(cand.shop_id, cand.platform_sku);\n      const origin = Number(originEl.value || 0);\n      const disc = discEl.value === \"\" ? null : Number(discEl.value);\n      const qty = Number(tr.querySelector(\".ofs-qty\").value);\n      const lead = tr.querySelector(\".ofs-lead\").value;\n      const origOrigin = o.origin_price === null || o.origin_price === undefined ? Number(o.price) : Number(o.origin_price);\n      const origDisc = o.discount_price === null || o.discount_price === undefined ? null : Number(o.discount_price);\n      const origLead = o.leadtime_to_ship === null || o.leadtime_to_ship === undefined ? null : Number(o.leadtime_to_ship);\n      const priceChanged = origin !== origOrigin || disc !== origDisc;\n      const otherChanged = qty !== Number(o.quantity) || (lead !== \"\" && Number(lead) !== origLead);\n      refreshPct(tr);\n      if (disc !== null && origin <= disc) {\n        // 折扣价必须低于原价 —— 无效配置不记账\n      } else if (priceChanged || otherChanged) {\n        SKU_OFFER_DIRTY.set(key, {\n          shop_id: String(cand.shop_id),\n          shop_name: cand.shop_name || String(cand.shop_id),\n          shop_sku: cand.platform_sku,\n          origin, discount: disc,\n          quantity: qty,\n          leadtime_to_ship: lead === \"\" ? o.leadtime_to_ship : Number(lead),\n          // ⛔ OF24 是**覆盖式**导入：这几个字段必须从原 offer 原样带入，\n          //    少带 state_code 会被平台整批拒掉，少带 logistic_class / min_quantity_alert 会被重置。\n          state_code: o.state_code,\n          logistic_class: o.logistic_class,\n          min_quantity_alert: o.min_quantity_alert,\n          _priceChanged: priceChanged,\n          _otherChanged: otherChanged,\n        });\n      } else {\n        SKU_OFFER_DIRTY.delete(key);\n      }\n      refreshSkuOfferSaveButton();\n      tr.style.background = SKU_OFFER_DIRTY.has(key) ? \"var(--green-08)\" : \"\";\n    };\n    tr.querySelectorAll(\".ofs-inp\").forEach((el) => {\n      el.addEventListener(\"input\", handler);\n      el.addEventListener(\"change\", handler);\n    });\n  });\n  // ---- 挂载自检：把「改了值却静默不入账」这种失败**响亮地**说出来 ----\n  // v26.102 的教训：行标识错位时 forEach 里一个 `return` 就把整块编辑监听跳过了，\n  // 页面看起来完全正常（表格、输入框都在），却改什么都不记账、保存键永不出现。\n  // ⇒ 渲染完必须核对「有输入框的行数 == 真正挂上监听的行数」，不等就当场报红。\n  const inputRows = [...box.querySelectorAll(\"tbody tr\")].filter((tr) => tr.querySelector(\".ofs-inp\"));\n  const wired = inputRows.filter((tr) => {\n    const cand = list[Number(tr.dataset.row)];\n    return !!cand && !!cand.offer;\n  }).length;\n  if (wired !== inputRows.length) {\n    console.warn(`[查报价] 挂载自检失败：${inputRows.length} 行有输入框，只有 ${wired} 行挂上了编辑监听`);\n    box.insertAdjacentHTML(\"beforeend\",\n      `<div style=\"margin-top:8px;padding:8px 12px;border:1px solid var(--red);border-radius:8px;color:var(--red);font-size:12px;\">`\n      + `⚠️ 有 ${inputRows.length - wired} 行没能挂上编辑监听（程序缺陷）：在这些行改了值<b>不会</b>进保存队列。请截图反馈。</div>`);\n  }\n}\n\n// mode: \"pull\" 查询并整店拉取（默认）| \"readback\" 跳过本机旧值强制整店重拉 | \"local\" 完全不联网\nasync function querySkuOffers(mode) {\n  const sku = $(\"skuOfferInput\").value.trim();\n  const box = $(\"skuOfferResult\");\n  const st = $(\"skuOfferPullStatus\");\n  if (!sku) { box.innerHTML = '<div class=\"carrier-empty\" style=\"padding:18px;\">请输入要查询的商品SKU</div>'; return; }\n  if (SKU_OFFER_DIRTY.size > 0\n    && !confirm(`当前有 ${SKU_OFFER_DIRTY.size} 条未保存的修改，重新查询会丢弃它们。继续？`)) return;\n  const wantLocalOnly = mode === \"local\";\n  const wantForce = mode === \"readback\";\n  const btnQuery = $(\"btnSkuOfferQuery\");\n  const btnBack = $(\"btnSkuOfferReadback\");\n  const btnLocal = $(\"btnSkuOfferLocal\");\n  btnQuery.disabled = true; btnBack.disabled = true; btnLocal.disabled = true;\n  const busyText = wantLocalOnly\n    ? \"正在读本机…（不联网）\"\n    : wantForce\n      ? \"正在回读最新…（命中的店全部整店重拉，每家几秒）\"\n      : \"正在查询…（本机快照优先；本机没数据的店整店拉取，每家几秒）\";\n  st.textContent = busyText; st.className = \"s-status\";\n  $(\"skuOfferSaveResult\").innerHTML = \"\";\n  // ⛔ 结果区**不许再写一遍同一句 busyText**：状态行（#skuOfferPullStatus）就在正上方，\n  //    两处一模一样地写＝重复显示（运营实测反馈）。这里只把上一次的结果清掉。\n  box.innerHTML = \"\";\n  try {\n    const q = \"/api/offers/by-erp-sku?sku=\" + encodeURIComponent(sku)\n      + (wantLocalOnly ? \"&platform=0\" : \"\") + (wantForce ? \"&refresh=1\" : \"\");\n    let data = await api(q);\n    renderSkuOfferResult(data);\n    renderSkuOfferPairingState(data.index);\n    // 服务端一次请求最多整店拉 ERP_SKU_OFFERS_PULL_MAX 家、总预算 25 秒，剩下的用 `pull_pending`\n    // 如实报出来 ⇒ 这里按批续拉。\n    // ⛔ 必须防死循环：某一批下来 unknown 没减少就立刻停手，不再白打平台。\n    let guard = 0;\n    while (!wantLocalOnly && (data.pull_pending || 0) > 0 && guard < 8) {\n      guard += 1;\n      const before = (data.summary || {}).unknown || 0;\n      st.textContent = `还有 ${data.pull_pending} 家店本机没数据，正在整店拉取…（第 ${guard} 批）`;\n      data = await api(q);\n      renderSkuOfferResult(data);\n      renderSkuOfferPairingState(data.index);\n      if (((data.summary || {}).unknown || 0) >= before) break;\n    }\n    const sum = data.summary || {};\n    st.textContent = `已查到 ${sum.found || 0} / ${sum.total || 0} 条`\n      + (sum.pulled_shops ? ` · 本次整店拉取 ${sum.pulled_shops} 家` : \"\")\n      + (sum.pull_failed_shops ? `（失败 ${sum.pull_failed_shops}）` : \"\")\n      + (sum.unknown ? ` · 未拉到 ${sum.unknown} 条` : \"\")\n      + (data.pull_pending ? ` · 仍有 ${data.pull_pending} 家待续拉（再点一次查询）` : \"\");\n    st.className = sum.unknown ? \"s-status warn\" : \"s-status ok\";\n  } catch (e) {\n    SKU_OFFER_RESULT = null;\n    SKU_OFFER_DIRTY.clear();\n    refreshSkuOfferSaveButton();\n    st.textContent = \"\";\n    box.innerHTML = `<div class=\"carrier-empty\" style=\"padding:18px;color:var(--red)\">查询失败：${escapeHtml(e.message)}</div>`;\n  } finally {\n    btnQuery.disabled = false; btnBack.disabled = false; btnLocal.disabled = false;\n  }\n}\n\n// 保存：按**店铺**分组提交（PRI01 / OF24 都是 per-shop 接口），组内仍按「价格变没变」分流 ——\n// 与子模块①的 saveOffers() 同一套口径，**不另造 OF24 写入**。\nasync function saveSkuOfferChanges() {\n  const st = $(\"skuOfferPullStatus\");\n  const out = $(\"skuOfferSaveResult\");\n  const items = Array.from(SKU_OFFER_DIRTY.values());\n  if (items.length === 0) return;\n\n  // ⛔ OF24 的 state_code 是必填（服务端 /api/offers/update 也会拦）。缺成色的行**只能改价**；\n  //    把它们的「库存/时效」改动摘出来如实报出，而不是让平台把整批拒掉。\n  const submittable = [];\n  const dropped = [];\n  for (const x of items) {\n    if (x._otherChanged && !x.state_code) {\n      if (x._priceChanged) submittable.push({ ...x, _otherChanged: false });\n      else dropped.push(x);\n      continue;\n    }\n    submittable.push(x);\n  }\n  if (submittable.length === 0) {\n    st.textContent = `这 ${dropped.length} 条都缺成色状态，改不了库存/时效（缺成色时平台会拒整批）`;\n    st.className = \"s-status warn\";\n    return;\n  }\n\n  // ⛔ 与组内 priceItems 同一口径：带折扣的行也算「改价」—— OF24 必清折扣，\n  //    这些行在 OF24 之后要补一道 PRI01 重申「原价+折扣」。\n  const priceN = submittable.filter((x) => x._priceChanged || (x.discount !== null && x.discount !== undefined)).length;\n  const otherN = submittable.filter((x) => x._otherChanged).length;\n  const shopIds = [...new Set(submittable.map((x) => x.shop_id))];\n  let msg = `确认保存 ${submittable.length} 个报价的修改（涉及 ${shopIds.length} 家店）？\\n\\n`;\n  if (priceN) msg += `· 改价 ${priceN} 个（价格文件导入 PRI01，约数秒生效）\\n`;\n  if (otherN) msg += `· 改库存/时效 ${otherN} 个（报价导入 OF24）\\n`;\n  if (dropped.length) {\n    msg += `\\n⚠️ 有 ${dropped.length} 条缺成色状态、改不了库存/时效，本次跳过：\\n`\n      + dropped.map((x) => `   ${x.shop_name} / ${x.shop_sku}`).join(\"\\n\") + \"\\n\";\n  }\n  msg += \"\\n改的是线上真报价，生效后不可撤销。继续？\";\n  if (!confirm(msg)) return;\n\n  const btn = $(\"btnSkuOfferSave\");\n  btn.disabled = true;\n  st.textContent = \"提交中…\"; st.className = \"s-status\";\n  out.innerHTML = \"\";\n\n  // 每家的 shop_id / api_key 都不同，绝不能跨店合批\n  const groups = new Map();\n  for (const x of submittable) {\n    if (!groups.has(x.shop_id)) groups.set(x.shop_id, []);\n    groups.get(x.shop_id).push(x);\n  }\n\n  let priceOk = 0, otherOk = 0;\n  const importIds = [];\n  const fails = [];\n  for (const [shopId, group] of groups) {\n    const shopName = (group[0] && group[0].shop_name) || shopId;\n    // ⛔ OF24 是覆盖式导入且**必清折扣**（API.md §12：discount 字段 8 种组合全被平台静默忽略，\n    //    且不带折扣字段会清空已有折扣/划线原价）。所以凡带折扣的行 —— 哪怕只改了库存/时效 ——\n    //    都必须在 OF24 之后**补一道 PRI01** 把「原价+折扣」重新写一遍，否则折扣被静默清掉\n    //    （v26.105 实锤事故：XSY330-GreenEU 折扣 29.69 被 OF24 清掉、基础价被写成 29.69）。\n    const needsPrice = (x) => x._priceChanged || (x.discount !== null && x.discount !== undefined);\n    const priceItems = group.filter(needsPrice)\n      .map((x) => ({ shop_sku: x.shop_sku, price: x.origin, discount_price: x.discount }));\n    const updateItems = group.filter((x) => x._otherChanged).map((x) => ({\n      shop_sku: x.shop_sku,\n      // ⛔ OF24 的 price = **基础价（原价）**，绝不许填折扣值 —— 填折扣值就是把折扣覆盖到折前价\n      //    （最终价格由后面的 PRI01 一锤定音：price=原价 + discount-price=折扣）。\n      price: x.origin,\n      quantity: x.quantity,\n      state_code: x.state_code,\n      leadtime_to_ship: x.leadtime_to_ship,\n      logistic_class: x.logistic_class,\n      min_quantity_alert: x.min_quantity_alert,\n    }));\n    try {\n      // ⛔ 顺序铁律：**先 OF24（库存/时效）→ 后 PRI01（价格）**。\n      //    OF24 必清折扣，而只有 PRI01 能写折扣 —— 价格导入必须放在最后，\n      //    否则 PRI01 刚写好的折扣会被随后的 OF24 静默清掉（v26.105 实锤事故）。\n      if (updateItems.length) {\n        st.textContent = `提交中…（${shopName} 改库存/时效 ${updateItems.length} 个）`;\n        const d = await api(\"/api/offers/update\", {\n          method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({ shop_id: shopId, items: updateItems }),\n        });\n        otherOk += updateItems.length;\n        if (d && d.import_id) {\n          importIds.push(`${shopName} 报价导入 <code>${escapeHtml(String(d.import_id))}</code>`);\n          // 后台跟踪到平台处理完，不阻塞主流程。\n          // ⛔ 第三参必须显式传（这里传 null）—— pollOfferImport 用「statusElArg === undefined」\n          //    判定「是不是报价管理页调的」：漏传就会被当成管理页调用，导入成功后去\n          //    `OFFER_DIRTY.clear(); renderOfferTable();`，把**报价管理页那份未保存的改动静默清掉**，\n          //    而且进度全写进隐藏的管理页面板（本页一个字都看不到）。\n          //    传 null 之后 statusEl 为假 ⇒ 不写状态行、也不碰 OFFER_DIRTY；\n          //    回执写进本页自己的 skuOfferImportResult。\n          pollOfferImport(d.import_id, shopId, null, $(\"skuOfferImportResult\"));\n        }\n      }\n      if (priceItems.length) {\n        st.textContent = `提交中…（${shopName} 改价 ${priceItems.length} 个）`;\n        const d = await api(\"/api/offers/pricing\", {\n          method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({ shop_id: shopId, items: priceItems }),\n        });\n        if (d && d.import_id) importIds.push(`${shopName} 改价 <code>${escapeHtml(String(d.import_id))}</code>`);\n        // 改价是异步导入（PRI02 状态接口不稳定）⇒ 复查 SKU 的实际价格。条数多时**不逐条复查**：\n        // 报导入 ID，改用「回读最新」一次性整店核 —— 一次请求顶 N 次单查。\n        if (priceItems.length <= 8) {\n          const results = await Promise.all(priceItems.map((it) => pollPricingImport(\n            shopId, it.shop_sku, Number(it.price),\n            it.discount_price === \"\" || it.discount_price === null || it.discount_price === undefined ? null : Number(it.discount_price),\n            { showProgress: false },\n          )));\n          priceOk += results.filter(Boolean).length;\n          if (results.filter(Boolean).length < priceItems.length) {\n            fails.push(`${shopName}：改价 ${priceItems.length} 个，仅 ${results.filter(Boolean).length} 个在 30 秒内确认生效 —— 请用「回读最新」复核，没生效就重新保存一次`);\n          }\n        } else {\n          fails.push(`${shopName}：改价 ${priceItems.length} 个已提交，条数较多未逐条复查 —— 请用「回读最新」确认`);\n        }\n      }\n    } catch (e) {\n      fails.push(`${shopName}：${e.message}`);\n    }\n  }\n\n  // 已提交的从脏表摘掉；被跳过的（缺成色）**留在脏表里**，让用户还能看到它们\n  for (const x of submittable) SKU_OFFER_DIRTY.delete(skuOfferKey(x.shop_id, x.shop_sku));\n  refreshSkuOfferSaveButton();\n  btn.disabled = false;\n\n  const parts = [];\n  if (priceN) parts.push(`改价 ${priceOk}/${priceN} 已确认生效`);\n  if (otherN) parts.push(`改库存/时效 ${otherOk} 已提交`);\n  st.textContent = (parts.join(\"｜\") || \"没有需要提交的改动\") + (fails.length ? ` ｜ ⚠️ ${fails.length} 项需注意` : \"\");\n  st.className = fails.length ? \"s-status warn\" : \"s-status ok\";\n\n  const lines = [];\n  if (importIds.length) lines.push(`<div><span style=\"color:var(--muted)\">导入 ID：</span>${importIds.join(\" · \")}</div>`);\n  if (fails.length) lines.push(`<div style=\"margin-top:6px;color:var(--amber)\">${fails.map((f) => escapeHtml(f)).join(\"<br>\")}</div>`);\n  if (dropped.length) lines.push(`<div style=\"margin-top:6px;color:var(--amber)\">缺成色状态、未提交库存/时效：${dropped.map((x) => escapeHtml(x.shop_name + \" / \" + x.shop_sku)).join(\"、\")}</div>`);\n  lines.push(`<div style=\"margin-top:6px;color:var(--muted)\">报价导入（库存/时效）的处理回执会显示在下面，稍等几秒。点「回读最新」可整店重拉一次，核对平台上的实际生效值（不用逐条单查）。</div>`);\n  out.innerHTML = `<div style=\"background:var(--card);border:1px solid var(--border);border-radius:10px;padding:10px 14px;font-size:12.5px;\">${lines.join(\"\")}</div>`;\n}\n\n// ---- 报价雷达（v26.87）----\n// 只读诊断：读本机最近两份报价快照，把「变化」和「偏低库存」算成告警清单。\n// 不下任何写操作 —— 改价、补库存仍然只在「报价」模块里手动做。\nconst OFFER_RADAR_RULE_ZH = {\n  inactive: \"突然不可售\",\n  stock_zero: \"库存归零\",\n  price_jump: \"价格异常变化\",\n  offer_missing: \"报价消失\",\n  low_stock: \"库存偏低（即将断货）\",\n};\nlet OFFER_RADAR_DATA = null;\nlet OFFER_RADAR_LOADING = false;\nlet OFFER_RADAR_REFRESHING = false;\nlet OFFER_RADAR_ERROR = \"\";\nlet OFFER_RADAR_FILTER = \"\";\n\nfunction offerRadarRuleLabel(code) {\n  return OFFER_RADAR_RULE_ZH[code] || code || \"未分类\";\n}\n\nfunction offerRadarTimeText(ms) {\n  const value = Number(ms);\n  if (!Number.isFinite(value) || value <= 0) return \"—\";\n  const d = new Date(value);\n  return Number.isFinite(d.getTime()) ? d.toLocaleString(\"zh-CN\") : \"—\";\n}\n\nfunction offerRadarStateText(state) {\n  if (!state) return \"—\";\n  const parts = [];\n  if (state.active === 1) parts.push(\"可售\");\n  else if (state.active === 0) parts.push(\"不可售\");\n  if (state.quantity !== null && state.quantity !== undefined) parts.push(`库存 ${state.quantity}`);\n  if (state.price !== null && state.price !== undefined) parts.push(`€${Number(state.price).toFixed(2)}`);\n  return parts.length ? parts.join(\" · \") : \"—\";\n}\n\nfunction initOfferRadarPage() {\n  const box = $(\"pageOfferRadar\");\n  if (box.dataset.ready === \"1\") { loadOfferRadar(); return; }\n  box.dataset.ready = \"1\";\n  box.innerHTML = `<div class=\"offers operation-shell radar-shell\">\n    <header class=\"operation-header\"><h2>报价雷达</h2><div class=\"s-sub\" id=\"offerRadarShopTag\"></div></header>\n    <div class=\"s-form workflow-panel\">\n      <div style=\"display:flex; gap:10px; align-items:center; flex-wrap:wrap;\">\n        <span class=\"s-status\" id=\"offerRadarStatus\">正在读取本机报价快照…</span>\n        <button class=\"btn\" id=\"btnOfferRadarRecheck\" style=\"margin-left:auto;\">重新检查</button>\n        <button class=\"btn\" id=\"btnOfferRadarFetch\" title=\"触发一次全量报价拉取；主店走导出约几秒，共享 key 店铺可能要几分钟\">刷新报价</button>\n      </div>\n      <div class=\"radar-note\" style=\"margin-top:8px;\">\n        口径：变化类告警（不可售 / 归零 / 调价 / 消失）比较的是<b>最近两份报价快照</b>；首次拉取后只有基线，\n        这时只检查库存偏低。同一规则命中比例过高时会归并成一条店级提醒，不再逐条刷屏。\n        <b>本模块只提醒，不会自动改价或补库存。</b>\n      </div>\n    </div>\n    <div id=\"offerRadarBody\"></div>\n  </div>`;\n  $(\"btnOfferRadarRecheck\").addEventListener(\"click\", () => loadOfferRadar());\n  $(\"btnOfferRadarFetch\").addEventListener(\"click\", offerRadarRefreshOffers);\n  loadOfferRadar();\n}\n\nasync function loadOfferRadar() {\n  if (OFFER_RADAR_LOADING) return;\n  OFFER_RADAR_LOADING = true;\n  const status = $(\"offerRadarStatus\");\n  if (status) { status.textContent = \"正在读取本机报价快照…\"; status.className = \"s-status\"; }\n  try {\n    OFFER_RADAR_DATA = await api(`/api/offers/radar?shop_id=${encodeURIComponent(GLOBAL_SHOP)}`);\n    OFFER_RADAR_ERROR = \"\";\n  } catch (error) {\n    OFFER_RADAR_DATA = null;\n    OFFER_RADAR_ERROR = String((error && error.message) || error);\n  } finally {\n    OFFER_RADAR_LOADING = false;\n    renderOfferRadar();\n  }\n}\n\nasync function offerRadarRefreshOffers() {\n  if (OFFER_RADAR_REFRESHING) return;\n  OFFER_RADAR_REFRESHING = true;\n  const status = $(\"offerRadarStatus\");\n  if (status) { status.textContent = \"已在后台开始拉取报价，拉完会自动重新检查…\"; status.className = \"s-status\"; }\n  try {\n    await api(\"/api/offers/fetch\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ shop_id: GLOBAL_SHOP, force: true }),\n    });\n    for (let i = 0; i < 200; i++) {\n      await new Promise((resolve) => setTimeout(resolve, 3000));\n      const state = await api(`/api/offers/fetch-status?shop_id=${encodeURIComponent(GLOBAL_SHOP)}`);\n      if (!state.running) break;\n    }\n    await loadOfferRadar();\n  } catch (error) {\n    const message = String((error && error.message) || error);\n    OFFER_RADAR_ERROR = message;\n    renderOfferRadar();\n  } finally {\n    OFFER_RADAR_REFRESHING = false;\n  }\n}\n\nfunction renderOfferRadar() {\n  const shop = SHOPS.find((s) => String(s.shop_id) === String(GLOBAL_SHOP));\n  const tag = $(\"offerRadarShopTag\");\n  if (tag) tag.textContent = shop ? `当前店铺：${shop.name}（#${shop.shop_id}）` : \"\";\n  const status = $(\"offerRadarStatus\");\n  const body = $(\"offerRadarBody\");\n  if (!body) return;\n\n  if (OFFER_RADAR_ERROR) {\n    if (status) { status.textContent = `读取失败：${OFFER_RADAR_ERROR}`; status.className = \"s-status err\"; }\n    body.innerHTML = `<div class=\"radar-banner\">报价雷达没有读到数据，这不代表没有异常 —— 先确认报价是否已经拉取成功。</div>`;\n    return;\n  }\n  const data = OFFER_RADAR_DATA;\n  if (!data) {\n    if (status) { status.textContent = \"正在读取…\"; status.className = \"s-status\"; }\n    body.innerHTML = \"\";\n    return;\n  }\n\n  // 没有快照 = 检查没做成，绝不能显示成「0 条异常」。\n  if (data.reason === \"no-current\") {\n    if (status) { status.textContent = \"还没有报价快照\"; status.className = \"s-status warn\"; }\n    body.innerHTML = `<div class=\"radar-banner\">本机还没有这家店铺的报价快照，无法检查。请点「刷新报价」先拉一次数据。</div>`;\n    return;\n  }\n\n  const alerts = (data.rules || []).reduce((sum, rule) => sum + Number(rule.count || 0), 0);\n  if (status) {\n    status.textContent = data.ready\n      ? `已检查 ${data.current_total} 条报价 · ${alerts} 条提醒（快照 ${offerRadarTimeText(data.current_at)}）`\n      : `已检查 ${data.current_total} 条报价 · 暂无历史基线，只检查了库存偏低`;\n    status.className = \"s-status\" + (alerts > 0 ? \" warn\" : \" ok\");\n  }\n\n  const banners = [];\n  if (!data.ready) {\n    banners.push(`<div class=\"radar-banner\">这是这家店铺的第一份报价快照，还没有可比对的历史 —— 变化类告警（不可售 / 归零 / 调价 / 消失）<b>尚未检查</b>，不是「没有异常」。再拉一次报价后即可比对。</div>`);\n  }\n  for (const skipped of data.skipped || []) {\n    if (skipped.reason === \"delta-source\") {\n      banners.push(`<div class=\"radar-banner\">最新一份快照来自增量同步，无法判断「报价消失」（增量里没出现 ≠ 被删除）。其余规则照常检查。</div>`);\n    }\n  }\n\n  const cards = (data.rules || []).map((rule) => {\n    const active = OFFER_RADAR_FILTER === rule.code ? \" is-active\" : \"\";\n    const zero = Number(rule.count || 0) === 0 ? \" is-zero\" : \"\";\n    const checked = rule.checked === false ? \"（未检查）\" : \"\";\n    return `<div class=\"radar-card sev-${rule.severity || \"low\"}${active}${zero}\" data-radar-rule=\"${escapeAttr(rule.code)}\">\n      <div class=\"rc-label\">${escapeHtml(rule.label)}${escapeHtml(checked)}${rule.merged ? \" · 已归并\" : \"\"}</div>\n      <div class=\"rc-value\">${rule.checked === false ? \"—\" : escapeHtml(String(rule.count || 0))}</div>\n    </div>`;\n  }).join(\"\");\n\n  const shopLevel = (data.shop_level || []).map((item) => {\n    const samples = (item.samples || []).map((s) => escapeHtml(s.sku)).join(\"、\") || \"—\";\n    const title = (item.samples || []).filter((s) => s.title).slice(0, 3).map((s) => escapeHtml(s.title)).join(\"；\");\n    return `<div class=\"radar-shop-level\">\n      <div class=\"rsl-title\"><span class=\"radar-pill sev-${item.severity || \"high\"}\">${escapeHtml(item.label)}</span> ${escapeHtml(String(item.count))} / ${escapeHtml(String(item.total))} 条（${(Number(item.ratio || 0) * 100).toFixed(0)}%）</div>\n      <div class=\"rsl-note\">${escapeHtml(item.note || \"\")}</div>\n      <div class=\"rsl-samples\">示例 SKU：${samples}${title ? `（${title}）` : \"\"}</div>\n    </div>`;\n  }).join(\"\");\n\n  const visibleItems = (data.items || []).filter((item) => !OFFER_RADAR_FILTER || item.rule === OFFER_RADAR_FILTER);\n  const table = visibleItems.length === 0\n    ? `<div class=\"radar-note\" style=\"padding:10px 2px;\">${OFFER_RADAR_FILTER ? \"该规则当前没有明细（可能已按店级归并，或本次没有命中）。\" : \"本次没有需要提醒的报价。\"}</div>`\n    : `<table class=\"radar-table\">\n      <thead><tr><th>SKU</th><th>商品</th><th>命中规则</th><th>变化前</th><th>变化后</th><th>说明</th></tr></thead>\n      <tbody>${visibleItems.map((item) => `<tr>\n        <td class=\"rd-sku\">${escapeHtml(item.sku)}</td>\n        <td>${escapeHtml(item.title || \"—\")}</td>\n        <td><span class=\"radar-pill sev-${item.severity || \"low\"}\">${escapeHtml(item.rule_label || offerRadarRuleLabel(item.rule))}</span></td>\n        <td class=\"rd-change\">${escapeHtml(offerRadarStateText(item.before))}</td>\n        <td class=\"rd-change\">${escapeHtml(offerRadarStateText(item.after))}</td>\n        <td>${escapeHtml(item.detail || \"\")}${item.note ? `<div class=\"radar-note\">${escapeHtml(item.note)}</div>` : \"\"}</td>\n      </tr>`).join(\"\")}</tbody>\n    </table>`;\n\n  const truncatedNote = data.truncated\n    ? `<div class=\"radar-note\">明细只显示前 ${visibleItems.length} 条，其余命中项按规则计数已在上方卡片中统计。</div>`\n    : \"\";\n\n  body.innerHTML = `${banners.join(\"\")}\n    <div class=\"radar-cards\">${cards}</div>\n    ${shopLevel ? `<div style=\"display:flex; flex-direction:column; gap:10px; margin-top:4px;\">${shopLevel}</div>` : \"\"}\n    <div class=\"s-form workflow-panel\" style=\"margin-top:4px;\">\n      <div class=\"radar-note\" style=\"margin-bottom:8px;\">\n        上一份快照 ${offerRadarTimeText(data.prev_at)}（${Number(data.prev_total || 0)} 条） · 最新 ${offerRadarTimeText(data.current_at)}（${Number(data.current_total || 0)} 条）\n        ${OFFER_RADAR_FILTER ? ` · 已筛选「${escapeHtml(offerRadarRuleLabel(OFFER_RADAR_FILTER))}」<button class=\"btn\" id=\"btnOfferRadarClearFilter\" style=\"margin-left:8px;\">清除筛选</button>` : \"\"}\n      </div>\n      <div style=\"max-height:520px; overflow-y:auto;\">${table}</div>\n      ${truncatedNote}\n    </div>`;\n\n  document.querySelectorAll(\"#offerRadarBody .radar-card\").forEach((el) => {\n    el.addEventListener(\"click\", () => {\n      const code = el.dataset.radarRule || \"\";\n      OFFER_RADAR_FILTER = OFFER_RADAR_FILTER === code ? \"\" : code;\n      renderOfferRadar();\n    });\n  });\n  const clear = $(\"btnOfferRadarClearFilter\");\n  if (clear) clear.addEventListener(\"click\", () => { OFFER_RADAR_FILTER = \"\"; renderOfferRadar(); });\n}\n\n// ---- 掉线监控 ----\n// 只读：盯「现在有哪些报价不可售、平台给的掉线原因是什么」。\n// ⛔ 判上架只看报价的 active 字段 —— state_code 是商品成色（11=New / 10=Excellent / 8=Very Good / 7=Good），\n//    与是否上架毫无关系。用它判上架会全店显示「正常」（2026-09-17 实测）。\n// 原因来自平台的 inactivity_reasons，只有单 SKU 查询才返回（导出 CSV 里没有这一列），所以要单独补查。\nconst OFFLINE_BUCKET_ZH = {\n  shop_not_open: \"店铺未开通 / 冻结\",\n  product_rejected: \"产品未通过审核\",\n  product_new: \"产品待审核\",\n  no_reason: \"平台未给原因\",\n  unknown: \"未查原因\",\n};\nconst OFFLINE_INSPECT_BATCH = 30;\nlet OFFLINE_DATA = null;\nlet OFFLINE_LOADING = false;\nlet OFFLINE_BUSY = false;\nlet OFFLINE_ERROR = \"\";\nlet OFFLINE_FILTER = \"\";\n\nfunction offlineBucketLabel(code) {\n  return OFFLINE_BUCKET_ZH[code] || code || \"未分类\";\n}\n\nfunction initOfflineMonitorPage() {\n  const box = $(\"pageOfferOffline\");\n  if (box.dataset.ready === \"1\") { loadOfflineMonitor(); return; }\n  box.dataset.ready = \"1\";\n  box.innerHTML = `<div class=\"offers operation-shell radar-shell\">\n    <header class=\"operation-header\"><h2>掉线监控</h2><div class=\"s-sub\" id=\"offlineShopTag\"></div></header>\n    <div class=\"s-form workflow-panel\">\n      <div style=\"display:flex; gap:10px; align-items:center; flex-wrap:wrap;\">\n        <span class=\"s-status\" id=\"offlineStatus\">正在读取本机报价…</span>\n        <button class=\"btn\" id=\"btnOfflineInspect\" style=\"margin-left:auto;\" title=\"每批 30 条，实测约 2-3 分钟（平台限流时会更久）。原因查到后存本机，同一条 7 天内不重复查\">补查原因</button>\n        <button class=\"btn\" id=\"btnOfflineRecheck\">重新检查</button>\n        <button class=\"btn\" id=\"btnOfflineFetch\" title=\"触发一次全量报价拉取；主店走导出约几秒，共享 key 店铺可能要几分钟\">刷新报价</button>\n      </div>\n      <div class=\"radar-note\" style=\"margin-top:8px;\">\n        口径：是否在线<b>只看 active 字段</b>（不是 state_code —— 那是商品成色，与上架无关）。\n        掉线原因取自平台的 <b>inactivity_reasons</b>，只有单 SKU 查询才返回，所以要点「补查原因」单独查，\n        查到后存在本机（7 天内不重复查）。<b>本页只读，不会下架、改价或提交审核。</b><br>\n        ⚠️ 名单来自<b>本机报价缓存</b>：很早以前用「全量导出」拉的老缓存可能<b>不含已下线的报价</b>\n        （实测 9/12 的缓存 2525 条全是 active=true，刷新后 2904 条里有 382 条掉线）⇒\n        掉线显示 0 条时，先看一眼上方的缓存时间，必要时点「刷新报价」重拉。\n      </div>\n    </div>\n    <div id=\"offlineBody\"></div>\n  </div>`;\n  $(\"btnOfflineRecheck\").addEventListener(\"click\", () => loadOfflineMonitor());\n  $(\"btnOfflineInspect\").addEventListener(\"click\", () => offlineInspectReasons([]));\n  $(\"btnOfflineFetch\").addEventListener(\"click\", offlineRefreshOffers);\n  loadOfflineMonitor();\n}\n\nasync function loadOfflineMonitor() {\n  if (OFFLINE_LOADING) return;\n  OFFLINE_LOADING = true;\n  const status = $(\"offlineStatus\");\n  if (status) { status.textContent = \"正在读取本机报价…\"; status.className = \"s-status\"; }\n  try {\n    OFFLINE_DATA = await api(`/api/offers/offline?shop_id=${encodeURIComponent(GLOBAL_SHOP)}`);\n    OFFLINE_ERROR = \"\";\n  } catch (error) {\n    OFFLINE_DATA = null;\n    OFFLINE_ERROR = String((error && error.message) || error);\n  } finally {\n    OFFLINE_LOADING = false;\n    renderOfflineMonitor();\n  }\n}\n\nasync function offlineInspectReasons(skus) {\n  if (OFFLINE_BUSY) return;\n  OFFLINE_BUSY = true;\n  renderOfflineMonitor();\n  const status = $(\"offlineStatus\");\n  if (status) { status.textContent = \"正在向平台补查掉线原因…\"; status.className = \"s-status\"; }\n  try {\n    const r = await api(\"/api/offers/offline/inspect\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ shop_id: GLOBAL_SHOP, skus: skus || [], limit: OFFLINE_INSPECT_BATCH }),\n    });\n    OFFLINE_ERROR = \"\";\n    await loadOfflineMonitor();\n    const done = Number((r && r.checked) || 0);\n    const failed = Number((r && r.failed) || 0);\n    const left = Number((r && r.pending) || 0);\n    const s = $(\"offlineStatus\");\n    if (s) {\n      s.textContent = failed > 0\n        ? `已补查 ${done} 条（${failed} 条查询失败）· 还剩 ${left} 条未查`\n        : `已补查 ${done} 条 · 还剩 ${left} 条未查`;\n      s.className = \"s-status\" + (left > 0 ? \" warn\" : \" ok\");\n    }\n  } catch (error) {\n    OFFLINE_ERROR = String((error && error.message) || error);\n    renderOfflineMonitor();\n  } finally {\n    OFFLINE_BUSY = false;\n    renderOfflineMonitor();\n  }\n}\n\nasync function offlineRefreshOffers() {\n  const status = $(\"offlineStatus\");\n  if (status) { status.textContent = \"已在后台开始拉取报价，拉完会自动重新检查…\"; status.className = \"s-status\"; }\n  try {\n    await api(\"/api/offers/fetch\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ shop_id: GLOBAL_SHOP, force: true }),\n    });\n    for (let i = 0; i < 200; i++) {\n      await new Promise((resolve) => setTimeout(resolve, 3000));\n      const state = await api(`/api/offers/fetch-status?shop_id=${encodeURIComponent(GLOBAL_SHOP)}`);\n      if (!state.running) break;\n    }\n    await loadOfflineMonitor();\n  } catch (error) {\n    OFFLINE_ERROR = String((error && error.message) || error);\n    renderOfflineMonitor();\n  }\n}\n\nfunction renderOfflineMonitor() {\n  const shop = SHOPS.find((s) => String(s.shop_id) === String(GLOBAL_SHOP));\n  const tag = $(\"offlineShopTag\");\n  if (tag) tag.textContent = shop ? `当前店铺：${shop.name}（#${shop.shop_id}）` : \"\";\n  const status = $(\"offlineStatus\");\n  const body = $(\"offlineBody\");\n  const inspectBtn = $(\"btnOfflineInspect\");\n  if (!body) return;\n\n  if (OFFLINE_ERROR) {\n    if (status) { status.textContent = `读取失败：${OFFLINE_ERROR}`; status.className = \"s-status err\"; }\n    body.innerHTML = `<div class=\"radar-banner\">掉线监控没有读到数据，这不代表没有掉线 —— 先确认报价是否已经拉取成功。</div>`;\n    if (inspectBtn) inspectBtn.disabled = true;\n    return;\n  }\n  const data = OFFLINE_DATA;\n  if (!data) {\n    if (status) { status.textContent = \"正在读取…\"; status.className = \"s-status\"; }\n    body.innerHTML = \"\";\n    return;\n  }\n  if (data.reason === \"no-cache\") {\n    if (status) { status.textContent = \"还没有报价数据\"; status.className = \"s-status warn\"; }\n    body.innerHTML = `<div class=\"radar-banner\">本机还没有这家店铺的报价，无法判断谁掉线。请点「刷新报价」先拉一次数据。</div>`;\n    if (inspectBtn) inspectBtn.disabled = true;\n    return;\n  }\n\n  const pending = Number((data.inspect && data.inspect.pending) || 0);\n  if (inspectBtn) {\n    inspectBtn.disabled = OFFLINE_BUSY || pending === 0;\n    inspectBtn.textContent = OFFLINE_BUSY ? \"补查中…\" : (pending > 0 ? `补查原因（${pending}）` : \"原因已查完\");\n  }\n  if (status && !OFFLINE_BUSY) {\n    const pct = (Number(data.offline_ratio || 0) * 100).toFixed(1);\n    const cacheAt = data.cached_at ? ` · 报价缓存 ${offerRadarTimeText(data.cached_at)}` : \"\";\n    status.textContent = (data.has_baseline\n      ? `共 ${data.total} 条报价 · 掉线 ${data.offline_total} 条（${pct}%）· 新掉线 ${(data.changes.newly_offline || []).length} / 已恢复 ${(data.changes.recovered || []).length}`\n      : `共 ${data.total} 条报价 · 掉线 ${data.offline_total} 条（${pct}%）· 暂无历史基线`) + cacheAt;\n    status.className = \"s-status\" + (data.offline_total > 0 ? \" warn\" : \" ok\");\n  }\n\n  const cards = (data.buckets || []).map((b) => {\n    const active = OFFLINE_FILTER === b.code ? \" is-active\" : \"\";\n    return `<div class=\"radar-card sev-${b.severity || \"low\"}${active}\" data-offline-bucket=\"${escapeAttr(b.code)}\">\n      <div class=\"rc-label\">${escapeHtml(offlineBucketLabel(b.code))}</div>\n      <div class=\"rc-value\">${escapeHtml(String(b.count || 0))}</div>\n    </div>`;\n  }).join(\"\");\n\n  const sl = data.shop_level;\n  const shopLevel = sl ? `<div class=\"radar-shop-level\">\n      <div class=\"rsl-title\"><span class=\"radar-pill sev-${sl.severity || \"high\"}\">${escapeHtml(sl.label)}</span> ${escapeHtml(String(sl.count))} / ${escapeHtml(String(sl.total))} 条（${(Number(sl.ratio || 0) * 100).toFixed(0)}%）</div>\n      <div class=\"rsl-note\">${escapeHtml(sl.note || \"\")}</div>\n      <div class=\"rsl-samples\">示例 SKU：${(sl.samples || []).map((s) => escapeHtml(s.sku)).join(\"、\") || \"—\"}</div>\n    </div>` : \"\";\n\n  let changes = \"\";\n  if (!data.has_baseline) {\n    changes = `<div class=\"radar-banner\">这家店铺只有一份报价快照，还没有可比对的历史 —— 「新掉线 / 已恢复」<b>尚未检查</b>，不是「没有变化」。再拉一次报价后即可比对。</div>`;\n  } else {\n    const n = data.changes.newly_offline || [];\n    const r = data.changes.recovered || [];\n    if (n.length === 0 && r.length === 0) {\n      changes = `<div class=\"radar-note\" style=\"padding:8px 2px;\">与上一份快照相比：没有报价上/下线变化。</div>`;\n    } else {\n      changes = `<div class=\"s-form workflow-panel\">\n        <div class=\"radar-note\" style=\"margin-bottom:6px;\">与上一份快照相比：<b>新掉线 ${n.length} 条</b> · <b>已恢复 ${r.length} 条</b></div>\n        ${n.length ? `<div class=\"rsl-samples\">新掉线：${n.slice(0, 10).map((x) => escapeHtml(x.sku)).join(\"、\")}${n.length > 10 ? ` 等 ${n.length} 条` : \"\"}</div>` : \"\"}\n        ${r.length ? `<div class=\"rsl-samples\">已恢复：${r.slice(0, 10).map((x) => escapeHtml(x.sku)).join(\"、\")}${r.length > 10 ? ` 等 ${r.length} 条` : \"\"}</div>` : \"\"}\n      </div>`;\n    }\n  }\n\n  const visible = (data.items || []).filter((it) => !OFFLINE_FILTER || it.reason_code === OFFLINE_FILTER);\n  const table = visible.length === 0\n    ? `<div class=\"radar-note\" style=\"padding:10px 2px;\">${OFFLINE_FILTER ? \"该原因当前没有明细（可能已按店级归并）。\" : \"这家店铺现在没有掉线的报价。\"}</div>`\n    : `<table class=\"radar-table\">\n      <thead><tr><th>SKU</th><th>商品</th><th>当前</th><th>掉线原因</th><th>处置建议</th></tr></thead>\n      <tbody>${visible.map((it) => `<tr>\n        <td class=\"rd-sku\">${escapeHtml(it.sku)}${it.is_new ? ` <span class=\"radar-pill sev-high\">新</span>` : \"\"}</td>\n        <td>${escapeHtml(it.title || \"—\")}</td>\n        <td class=\"rd-change\">${it.price !== null && it.price !== undefined ? `€${Number(it.price).toFixed(2)}` : \"—\"}${it.quantity !== null && it.quantity !== undefined ? ` · 库存 ${it.quantity}` : \"\"}</td>\n        <td><span class=\"radar-pill sev-${it.severity || \"low\"}\">${escapeHtml(it.reason_label || offlineBucketLabel(it.reason_code))}</span></td>\n        <td>${escapeHtml(it.action || \"\")}</td>\n      </tr>`).join(\"\")}</tbody>\n    </table>`;\n\n  body.innerHTML = `${cards ? `<div class=\"radar-cards\">${cards}</div>` : \"\"}\n    ${shopLevel ? `<div style=\"display:flex; flex-direction:column; gap:10px; margin-top:4px;\">${shopLevel}</div>` : \"\"}\n    ${changes}\n    <div class=\"s-form workflow-panel\" style=\"margin-top:4px;\">\n      <div class=\"radar-note\" style=\"margin-bottom:8px;\">\n        原因已查 ${Number((data.inspect && data.inspect.cached) || 0)} / ${Number((data.inspect && data.inspect.total) || 0)} 条${OFFLINE_FILTER ? ` · 已筛选「${escapeHtml(offlineBucketLabel(OFFLINE_FILTER))}」<button class=\"btn\" id=\"btnOfflineClearFilter\" style=\"margin-left:8px;\">清除筛选</button>` : \"\"}\n      </div>\n      <div style=\"max-height:520px; overflow-y:auto;\">${table}</div>\n      ${data.truncated ? `<div class=\"radar-note\">明细只显示前 ${visible.length} 条，其余按原因计数已在上方卡片统计。</div>` : \"\"}\n    </div>`;\n\n  document.querySelectorAll(\"#offlineBody .radar-card\").forEach((el) => {\n    el.addEventListener(\"click\", () => {\n      const code = el.dataset.offlineBucket || \"\";\n      OFFLINE_FILTER = OFFLINE_FILTER === code ? \"\" : code;\n      renderOfflineMonitor();\n    });\n  });\n  const clear = $(\"btnOfflineClearFilter\");\n  if (clear) clear.addEventListener(\"click\", () => { OFFLINE_FILTER = \"\"; renderOfflineMonitor(); });\n}\n\n// ---- 特别关注（v26.89）----\n// 只盯关注清单里的少数 SKU：销量 / 库存 / 价格 / 可售。\n// ⛔ 本页只提醒不执行 —— 不改价、不补库存、不提交审核。\n// ⛔ 「没检查」≠「没问题」：后端返回 skipped[] 时必须显式显示，绝不把缺数据渲染成「0 条异常」。\n// ⛔ 本页唯一会请求平台的按钮是「刷新销量」（后端只发 OR11 GET）；「重新读取」全程只读本机。\nconst WATCH_STATUS_ZH = {\n  high: \"紧急\",\n  medium: \"关注\",\n  low: \"提示\",\n  ok: \"正常\",\n  unchecked: \"未检查\",\n  handled: \"已处理\",\n};\nconst WATCH_STATUS_CARDS = [\n  [\"high\", \"紧急\", \"sev-high\"],\n  [\"medium\", \"关注\", \"sev-medium\"],\n  [\"low\", \"提示\", \"\"],\n  [\"ok\", \"正常\", \"\"],\n  [\"unchecked\", \"未检查\", \"\"],\n  [\"handled\", \"已处理\", \"\"],\n];\nconst WATCH_RULE_ADVICE = {\n  offer_missing: \"到平台后台确认这个报价是否还在；若还在，说明本机报价缓存旧了，到「报价」页重拉一次。\",\n  inactive: \"到「掉线监控」页看平台给的原因（店铺冻结 / 产品未过审 / 待审核）。\",\n  stock_zero: \"确认是否补货 —— 库存 0 就是停止销售。\",\n  stock_days: \"按补货周期提前下单；跨境补货周期长的话要更早动手。\",\n  sales_drop: \"先排查断货、改价、季节因素，再看是否被竞品分流。\",\n  no_sales: \"查流量与价格；主推款连续 7 天不出单值得单独看一次。\",\n  sales_surge: \"这是提示不是异常 —— 留意库存能不能跟上。\",\n};\n// [存储键, 展示名, 单位, 是否按百分比存（输入值需 ÷100）]\nconst WATCH_TH_FIELDS = [\n  [\"days\", \"可售天数\", \"天\", false],\n  [\"drop_ratio\", \"下滑比例\", \"%\", true],\n  [\"no_sales_days\", \"无销量天数\", \"天\", false],\n  [\"surge_ratio\", \"增长比例\", \"%\", true],\n];\nlet WATCH_DATA = null;\nlet WATCH_LOADING = false;\nlet WATCH_REFRESHING = false;\nlet WATCH_BUSY = \"\";\nlet WATCH_ERROR = \"\";\nlet WATCH_NOTICE = \"\";\nlet WATCH_QUERY = \"\";\nlet WATCH_FILTER = \"\";\nlet WATCH_RULE_FILTER = \"\";\nlet WATCH_EXPANDED = \"\";\nlet WATCH_ADD_OPEN = false;\nlet WATCH_TICK = null;\n\nfunction watchNumText(value, digits) {\n  if (value === null || value === undefined || value === \"\") return \"—\";\n  const n = Number(value);\n  if (!Number.isFinite(n)) return \"—\";\n  return digits === undefined ? String(n) : n.toFixed(digits);\n}\n\nfunction watchTimeText(ms) {\n  const n = Number(ms);\n  if (!Number.isFinite(n) || n <= 0) return \"—\";\n  const d = new Date(n);\n  return Number.isFinite(d.getTime()) ? d.toLocaleString(\"zh-CN\") : \"—\";\n}\n\nfunction watchStatusLabel(status) {\n  return WATCH_STATUS_ZH[status] || status || \"—\";\n}\n\n// 后端文案里带 markdown 粗体标记，渲染前统一去掉\nfunction watchPlain(text) {\n  return String(text === null || text === undefined ? \"\" : text).replace(/\\*\\*/g, \"\");\n}\n\nfunction watchStatusPill(status) {\n  const cls = status === \"high\" || status === \"medium\" || status === \"low\" ? ` sev-${status}` : \"\";\n  return `<span class=\"radar-pill${cls}\">${escapeHtml(watchStatusLabel(status))}</span>`;\n}\n\nfunction watchActiveHtml(active) {\n  if (active === true) return `<span class=\"watch-flag ok\">可售</span>`;\n  if (active === false) return `<span class=\"watch-flag bad\">不可售</span>`;\n  return `<span class=\"watch-flag mute\">状态未查</span>`;\n}\n\nfunction watchInputNum(el) {\n  if (!el) return null;\n  const raw = String(el.value === null || el.value === undefined ? \"\" : el.value).trim();\n  if (!raw) return null;\n  const n = Number(raw);\n  return Number.isFinite(n) && n >= 0 ? n : null;\n}\n\nfunction initSpecialAttentionPage() {\n  const box = $(\"pageWatchlist\");\n  if (!box) return;\n  if (box.dataset.ready === \"1\") { loadSpecialAttention(); return; }\n  box.dataset.ready = \"1\";\n  box.innerHTML = `<div class=\"offers operation-shell radar-shell\">\n    <header class=\"operation-header\"><h2>特别关注</h2><div class=\"s-sub\" id=\"watchShopTag\"></div></header>\n    <div class=\"s-form workflow-panel\">\n      <div style=\"display:flex; gap:10px; align-items:center; flex-wrap:wrap;\">\n        <span class=\"s-status\" id=\"watchStatus\">正在读取本机数据…</span>\n        <button class=\"btn\" id=\"btnWatchAddToggle\" style=\"margin-left:auto;\">+ 添加 SKU</button>\n        <button class=\"btn\" id=\"btnWatchRefresh\" title=\"扫近 35 天订单（只读 GET，每页 100 条约 0.5 秒）；只影响本页，不动报价数据\">刷新销量</button>\n        <button class=\"btn\" id=\"btnWatchReload\">重新读取</button>\n      </div>\n      <div style=\"display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-top:10px;\">\n        <input class=\"s-input\" id=\"watchQuery\" type=\"text\" placeholder=\"搜 SKU / 商品名 / 标签 / 备注\" style=\"max-width:280px;\">\n        <span class=\"s-sub\" id=\"watchFilterTag\" style=\"margin:0;\"></span>\n      </div>\n      <div class=\"radar-note\" style=\"margin-top:10px;\">\n        口径：销量取自<b>近 35 天订单</b>（北京时间自然日切窗 ——「近 7 天」＝含今天在内的 7 天，「前 7 天」＝再往前 7 天，两者不重叠）；\n        库存 / 价格 / 可售状态取自<b>本机报价缓存</b>，零平台请求。\n        <b>本页只提醒不执行 —— 不改价、不补库存、不提交审核。</b><br>\n        缺数据时不会显示成「0 条异常」，而是把<b>未检查</b>的项单独列出来。阈值可以逐个 SKU 单独设置。\n      </div>\n    </div>\n    <div id=\"watchAddPanel\" class=\"s-form workflow-panel hidden\"></div>\n    <div id=\"watchBody\"></div>\n  </div>`;\n  $(\"btnWatchAddToggle\").addEventListener(\"click\", () => { WATCH_ADD_OPEN = !WATCH_ADD_OPEN; renderWatchAddPanel(); });\n  $(\"btnWatchRefresh\").addEventListener(\"click\", refreshSpecialAttention);\n  $(\"btnWatchReload\").addEventListener(\"click\", () => { WATCH_NOTICE = \"\"; loadSpecialAttention(); });\n  const q = $(\"watchQuery\");\n  if (q) q.addEventListener(\"input\", () => { WATCH_QUERY = q.value || \"\"; renderSpecialAttention(); });\n  renderWatchAddPanel();\n  loadSpecialAttention();\n}\n\nfunction renderWatchAddPanel() {\n  const panel = $(\"watchAddPanel\");\n  if (!panel) return;\n  if (panel.dataset.built !== \"1\") {\n    panel.dataset.built = \"1\";\n    panel.innerHTML = `<div class=\"radar-note\" style=\"margin-bottom:10px;\">\n      一行一个 SKU（也支持用逗号、分号、空格分隔）；右侧四项阈值留空就用默认值\n      （可售天数 14 天 / 下滑 30% / 无销量 7 天 / 增长 50%）。\n      <b>添加只是把 SKU 记到本机关注清单，不会动平台上的任何数据。</b>\n    </div>\n    <div class=\"watch-add-grid\">\n      <label>SKU<span class=\"watch-req\">*</span>\n        <textarea class=\"s-input\" id=\"watchAddSku\" placeholder=\"ABC-001&#10;ABC-002&#10;ABC-003\"></textarea>\n      </label>\n      <label>商品名（可选）<input class=\"s-input\" id=\"watchAddTitle\" type=\"text\" maxlength=\"200\" placeholder=\"便于识别，可留空\"></label>\n      <label>备注（可选）<input class=\"s-input\" id=\"watchAddNote\" type=\"text\" maxlength=\"500\" placeholder=\"例：主推款，断货影响大\"></label>\n      <label>可售天数阈值（天）<input class=\"s-input\" id=\"watchAddDays\" type=\"number\" min=\"1\" step=\"1\" placeholder=\"14\"></label>\n      <label>下滑比例（%）<input class=\"s-input\" id=\"watchAddDrop\" type=\"number\" min=\"1\" step=\"1\" placeholder=\"30\"></label>\n      <label>无销量天数（天）<input class=\"s-input\" id=\"watchAddNoSales\" type=\"number\" min=\"1\" step=\"1\" placeholder=\"7\"></label>\n      <label>增长比例（%）<input class=\"s-input\" id=\"watchAddSurge\" type=\"number\" min=\"1\" step=\"1\" placeholder=\"50\"></label>\n    </div>\n    <div style=\"display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-top:12px;\">\n      <span class=\"s-status\" id=\"watchAddStatus\"></span>\n      <button class=\"btn btn-filled\" id=\"btnWatchAddSubmit\" style=\"margin-left:auto;\">加入关注清单</button>\n      <button class=\"btn\" id=\"btnWatchAddCancel\">取消</button>\n    </div>`;\n    $(\"btnWatchAddSubmit\").addEventListener(\"click\", watchAddSubmit);\n    $(\"btnWatchAddCancel\").addEventListener(\"click\", () => { WATCH_ADD_OPEN = false; renderWatchAddPanel(); });\n  }\n  panel.classList.toggle(\"hidden\", !WATCH_ADD_OPEN);\n  const toggle = $(\"btnWatchAddToggle\");\n  if (toggle) toggle.textContent = WATCH_ADD_OPEN ? \"收起添加\" : \"+ 添加 SKU\";\n  if (WATCH_ADD_OPEN) {\n    const sku = $(\"watchAddSku\");\n    if (sku && !sku.value) sku.focus();\n  }\n}\n\nfunction watchAddStatusText(text, cls) {\n  const el = $(\"watchAddStatus\");\n  if (!el) return;\n  el.textContent = text;\n  el.className = \"s-status\" + (cls ? ` ${cls}` : \"\");\n}\n\nasync function watchAddSubmit() {\n  if (WATCH_BUSY) return;\n  const skuEl = $(\"watchAddSku\");\n  const skus = String((skuEl && skuEl.value) || \"\")\n    .split(/[\\s,;，；]+/)\n    .map((s) => s.trim())\n    .filter(Boolean);\n  if (skus.length === 0) { watchAddStatusText(\"请先填 SKU（一行一个）\", \"err\"); return; }\n\n  const uniq = Array.from(new Set(skus));\n  const limit = 200;\n  const list = uniq.slice(0, limit);\n  const over = uniq.length > limit;\n\n  const thresholds = {};\n  const days = watchInputNum($(\"watchAddDays\"));\n  const drop = watchInputNum($(\"watchAddDrop\"));\n  const noSales = watchInputNum($(\"watchAddNoSales\"));\n  const surge = watchInputNum($(\"watchAddSurge\"));\n  if (days !== null) thresholds.days = days;\n  if (drop !== null) thresholds.drop_ratio = drop / 100;\n  if (noSales !== null) thresholds.no_sales_days = noSales;\n  if (surge !== null) thresholds.surge_ratio = surge / 100;\n  const title = String(($(\"watchAddTitle\") && $(\"watchAddTitle\").value) || \"\").trim();\n  const note = String(($(\"watchAddNote\") && $(\"watchAddNote\").value) || \"\").trim();\n\n  WATCH_BUSY = \"add\";\n  renderWatchAddPanel();\n  let ok = 0;\n  const failures = [];\n  for (const sku of list) {\n    try {\n      const payload = { shop_id: GLOBAL_SHOP, op: \"add\", sku };\n      if (title) payload.title = title;\n      if (note) payload.note = note;\n      if (Object.keys(thresholds).length > 0) payload.thresholds = thresholds;\n      await api(\"/api/watchlist/items\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(payload),\n      });\n      ok += 1;\n    } catch (error) {\n      if (failures.length < 3) failures.push(`${sku}：${String((error && error.message) || error)}`);\n    }\n  }\n  WATCH_BUSY = \"\";\n  const overText = over ? `（另有 ${uniq.length - limit} 个超过一次 ${limit} 个的上限，未提交）` : \"\";\n  watchAddStatusText(\n    failures.length\n      ? `已加入 ${ok} 个，失败 ${list.length - ok} 个 —— ${failures.join(\"；\")}`\n      : `已加入 ${ok} 个 SKU${overText}`,\n    failures.length ? \"err\" : \"ok\",\n  );\n  if (over && !failures.length) watchAddStatusText(`已加入 ${ok} 个 SKU${overText}`, \"warn\");\n  if (ok > 0) {\n    if (skuEl) skuEl.value = \"\";\n    if ($(\"watchAddTitle\")) $(\"watchAddTitle\").value = \"\";\n    if ($(\"watchAddNote\")) $(\"watchAddNote\").value = \"\";\n    await loadSpecialAttention();\n  }\n  renderWatchAddPanel();\n}\n\nasync function loadSpecialAttention() {\n  if (WATCH_LOADING) return;\n  WATCH_LOADING = true;\n  const status = $(\"watchStatus\");\n  if (status && !WATCH_REFRESHING) { status.textContent = \"正在读取本机数据…\"; status.className = \"s-status\"; }\n  try {\n    WATCH_DATA = await api(`/api/watchlist?shop_id=${encodeURIComponent(GLOBAL_SHOP)}`);\n    WATCH_ERROR = \"\";\n    WATCH_NOTICE = \"\";\n  } catch (error) {\n    WATCH_DATA = null;\n    WATCH_ERROR = String((error && error.message) || error);\n  } finally {\n    WATCH_LOADING = false;\n    renderSpecialAttention();\n  }\n}\n\nasync function refreshSpecialAttention() {\n  if (WATCH_REFRESHING) return;\n  const started = Date.now();\n  WATCH_REFRESHING = true;\n  const paint = () => {\n    const s = $(\"watchStatus\");\n    if (!s) return;\n    const secs = Math.round((Date.now() - started) / 1000);\n    s.textContent = `正在扫描近 35 天订单…（已 ${secs} 秒，每页 100 条约 0.5 秒，扫完自动刷新）`;\n    s.className = \"s-status warn\";\n  };\n  paint();\n  if (WATCH_TICK) clearInterval(WATCH_TICK);\n  WATCH_TICK = setInterval(paint, 1000);\n  const refreshBtn = $(\"btnWatchRefresh\");\n  if (refreshBtn) refreshBtn.disabled = true;\n  try {\n    const r = await api(\"/api/watchlist/refresh\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ shop_id: GLOBAL_SHOP }),\n    });\n    WATCH_NOTICE = \"\";\n    await loadSpecialAttention();\n    const scanned = (r && r.scanned) || {};\n    const bits = [`扫到 ${Number(scanned.orders || 0)} 单（${Number(scanned.requests || 0)} 次请求 / ${Number(scanned.pages || 0)} 页）`];\n    if (scanned.truncated) bits.push(\"已达分页上限，销量可能不完整\");\n    if (Number(scanned.duplicates || 0) > 0) bits.push(`⚠️ ${Number(scanned.duplicates)} 条订单重复（分页异常，销量可能偏大）`);\n    if (scanned.error) bits.push(`接口报错：${String(scanned.error)}`);\n    if (r && Number(r.sales_fetched_at) > 0) bits.push(`销量快照 ${watchTimeText(r.sales_fetched_at)}`);\n    const s = $(\"watchStatus\");\n    if (s) {\n      s.textContent = `刷新完成：${bits.join(\" · \")}`;\n      s.className = \"s-status\" + (scanned.truncated || scanned.error ? \" warn\" : \" ok\");\n    }\n  } catch (error) {\n    WATCH_ERROR = String((error && error.message) || error);\n    renderSpecialAttention();\n  } finally {\n    if (WATCH_TICK) { clearInterval(WATCH_TICK); WATCH_TICK = null; }\n    WATCH_REFRESHING = false;\n    const s = $(\"watchStatus\");\n    if (s && WATCH_ERROR) { s.textContent = `刷新失败：${WATCH_ERROR}`; s.className = \"s-status err\"; }\n    if (refreshBtn) refreshBtn.disabled = !WATCH_DATA || Number((WATCH_DATA.counts || {}).total || 0) === 0;\n  }\n}\n\nasync function watchItemOp(op, sku, extra) {\n  if (WATCH_BUSY) return;\n  WATCH_BUSY = `${op}:${sku}`;\n  try {\n    await api(\"/api/watchlist/items\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify(Object.assign({ shop_id: GLOBAL_SHOP, op, sku }, extra || {})),\n    });\n    await loadSpecialAttention();\n  } catch (error) {\n    WATCH_NOTICE = `操作失败：${String((error && error.message) || error)}`;\n    renderSpecialAttention();\n  } finally {\n    WATCH_BUSY = \"\";\n  }\n}\n\nasync function watchSaveThresholds(box, sku, useDefaults) {\n  if (WATCH_BUSY) return;\n  const defaults = (WATCH_DATA && WATCH_DATA.threshold_defaults) || {};\n  const thresholds = {};\n  if (useDefaults) {\n    for (const [key] of WATCH_TH_FIELDS) {\n      const value = Number(defaults[key]);\n      if (Number.isFinite(value)) thresholds[key] = value;\n    }\n    if (Object.keys(thresholds).length === 0) {\n      WATCH_NOTICE = \"取不到默认阈值，请先点「重新读取」再试。\";\n      renderSpecialAttention();\n      return;\n    }\n  } else {\n    box.querySelectorAll(\"[data-watch-th]\").forEach((el) => {\n      const key = el.dataset.watchTh || \"\";\n      if (!key) return;\n      const raw = String(el.value === null || el.value === undefined ? \"\" : el.value).trim();\n      if (!raw) return;\n      const n = Number(raw);\n      if (!Number.isFinite(n) || n < 0) return;\n      thresholds[key] = el.dataset.watchRatio === \"1\" ? n / 100 : n;\n    });\n    if (Object.keys(thresholds).length === 0) {\n      WATCH_NOTICE = \"四个阈值都没填有效值，没有保存。\";\n      renderSpecialAttention();\n      return;\n    }\n  }\n  await watchItemOp(\"update\", sku, { thresholds });\n  WATCH_NOTICE = useDefaults ? `${sku} 的阈值已恢复为默认。` : `已更新 ${sku} 的阈值（「已处理」标记同时被清掉，视为新的一轮）。`;\n  renderSpecialAttention();\n}\n\nfunction watchDetailHtml(row) {\n  const ruleBlocks = (row.rules || []).length\n    ? (row.rules || []).map((r) => `<div class=\"watch-detail-item\">\n        <div><span class=\"radar-pill sev-${r.severity || \"low\"}\">${escapeHtml(r.label)}</span> <b>${escapeHtml(r.detail || \"\")}</b></div>\n        <div class=\"radar-note\" style=\"margin:2px 0 0;\">${escapeHtml(watchPlain(r.note))}</div>\n        <div class=\"radar-note\" style=\"margin:2px 0 0;\">建议：${escapeHtml(WATCH_RULE_ADVICE[r.code] || \"—\")}</div>\n      </div>`).join(\"\")\n    : `<div class=\"radar-note\">这一轮没有命中任何规则${row.status === \"unchecked\" ? \"（但仍有未检查项，见下）\" : \"\"}。</div>`;\n  const skippedNames = Array.from(new Set((row.skipped || []).map((s) => s.label || s.code))).filter(Boolean);\n  const skippedBlock = skippedNames.length\n    ? `<div class=\"radar-note\" style=\"margin-top:6px;\">未检查：${escapeHtml(skippedNames.join(\"、\"))} —— 这不代表没问题，先把数据补齐再看。</div>`\n    : \"\";\n  const th = row.thresholds || {};\n  const thInputs = WATCH_TH_FIELDS.map(([key, label, unit, isRatio]) => {\n    const raw = Number(th[key]);\n    const shown = Number.isFinite(raw) ? (isRatio ? Math.round(raw * 100) : raw) : \"\";\n    const ratioAttr = isRatio ? ' data-watch-ratio=\"1\"' : \"\";\n    return `<label>${escapeHtml(label)}（${escapeHtml(unit)}）<input class=\"s-input\" type=\"number\" min=\"0\" step=\"1\" data-watch-th=\"${escapeAttr(key)}\" value=\"${shown}\"${ratioAttr}></label>`;\n  }).join(\"\");\n  const handledLine = row.handled\n    ? `已处理 ${escapeHtml(watchTimeText(row.handled_at))}${row.handled_note ? ` · ${escapeHtml(row.handled_note)}` : \"\"}`\n    : \"尚未标记已处理\";\n  const stockText = row.quantity === null ? \"—\" : `${escapeHtml(watchNumText(row.quantity))} 件`;\n  const priceText = row.price === null ? \"—\" : `€${escapeHtml(watchNumText(row.price, 2))}`;\n  const dailyText = row.daily_avg === null ? \"—\" : `${escapeHtml(watchNumText(row.daily_avg, 2))} 件/天`;\n  const daysText = row.days_left === null ? \"—\" : `${escapeHtml(watchNumText(row.days_left, 1))} 天`;\n  return `<div class=\"watch-detail\" data-watch-detail=\"${escapeAttr(row.sku)}\">\n    <div class=\"watch-detail-item\">\n      <div><b>${escapeHtml(row.title || row.sku)}</b> <span class=\"watch-flag mute\">${escapeHtml(row.sku)}</span></div>\n      <div class=\"radar-note\" style=\"margin:3px 0 0;\">\n        库存 ${stockText}${row.leadtime_to_ship === null ? \"\" : ` · 备货期 ${escapeHtml(watchNumText(row.leadtime_to_ship))} 天`}\n        · 价格 ${priceText}\n        · 近 7 天 ${row.d7 === null ? \"未扫描\" : escapeHtml(watchNumText(row.d7))} 件\n        · 前 7 天 ${row.prev7 === null ? \"未扫描\" : escapeHtml(watchNumText(row.prev7))} 件\n        · 近 30 天 ${row.d30 === null ? \"未扫描\" : escapeHtml(watchNumText(row.d30))} 件\n        · 近 7 天日均 ${dailyText}\n        · 可售约 ${daysText}\n        ${row.last_order_date ? ` · 最近一单 ${escapeHtml(row.last_order_date)}` : \"\"}\n        · 加入于 ${escapeHtml(watchTimeText(row.added_at))}\n      </div>\n    </div>\n    <div>${ruleBlocks}${skippedBlock}</div>\n    <div>\n      <div class=\"radar-note\" style=\"margin-bottom:6px;\">阈值（改完点保存；<b>改阈值会清掉这个 SKU 的「已处理」标记</b>，视为新的一轮）</div>\n      <div class=\"watch-th-grid\">${thInputs}</div>\n      <div style=\"display:flex; gap:8px; align-items:center; flex-wrap:wrap; margin-top:8px;\">\n        <button class=\"btn btn-filled\" data-watch-th-save=\"1\">保存阈值</button>\n        <button class=\"btn\" data-watch-th-reset=\"1\">恢复默认阈值</button>\n      </div>\n    </div>\n    <div>\n      <div class=\"radar-note\" style=\"margin-bottom:6px;\">处理记录：${handledLine}</div>\n      <div style=\"display:flex; gap:8px; align-items:center; flex-wrap:wrap;\">\n        <input class=\"s-input\" type=\"text\" data-watch-handle-note=\"1\" maxlength=\"500\" style=\"max-width:320px;\" placeholder=\"处理说明（可选，例：已下补货单）\" value=\"${escapeAttr(row.handled_note || \"\")}\">\n        <button class=\"btn\" data-watch-handled=\"1\">标记已处理</button>\n        <button class=\"btn\" data-watch-unhandled=\"1\">取消已处理</button>\n        <button class=\"btn watch-danger\" data-watch-remove=\"1\" style=\"margin-left:auto;\">从关注清单移除</button>\n      </div>\n    </div>\n  </div>`;\n}\n\nfunction renderSpecialAttention() {\n  const shop = SHOPS.find((s) => String(s.shop_id) === String(GLOBAL_SHOP));\n  const tag = $(\"watchShopTag\");\n  if (tag) tag.textContent = shop ? `当前店铺：${shop.name}（#${shop.shop_id}）` : \"\";\n  const status = $(\"watchStatus\");\n  const body = $(\"watchBody\");\n  const refreshBtn = $(\"btnWatchRefresh\");\n  const filterTag = $(\"watchFilterTag\");\n  if (!body) return;\n\n  if (WATCH_ERROR) {\n    if (status) { status.textContent = `读取失败：${WATCH_ERROR}`; status.className = \"s-status err\"; }\n    if (filterTag) filterTag.textContent = \"\";\n    body.innerHTML = `<div class=\"radar-banner\">特别关注没有读到数据，这不代表没有异常 —— 先点「重新读取」；持续失败请确认后端是否正常。</div>`;\n    if (refreshBtn) refreshBtn.disabled = true;\n    return;\n  }\n  const data = WATCH_DATA;\n  if (!data) {\n    if (status) { status.textContent = \"正在读取…\"; status.className = \"s-status\"; }\n    body.innerHTML = \"\";\n    return;\n  }\n\n  const counts = data.counts || {};\n  const total = Number(counts.total || 0);\n  if (refreshBtn) refreshBtn.disabled = WATCH_REFRESHING || total === 0;\n  const noticeBlock = WATCH_NOTICE ? `<div class=\"radar-banner\">${escapeHtml(WATCH_NOTICE)}</div>` : \"\";\n\n  if (total === 0) {\n    if (status) { status.textContent = \"这家店铺还没有特别关注的 SKU\"; status.className = \"s-status\"; }\n    if (filterTag) filterTag.textContent = \"\";\n    // ⛔ 清单是**按店铺分开**保存的：本店为空 ≠ 全局一个都没关注。\n    //    2026-09-18 真机验证踩到过 —— 页面写着「还没有关注任何 SKU」（全局口径），\n    //    而 Marspal(#4949) 下其实躺着 6 个关注 SKU，只是浏览器当时停在 Link Carol(#5085)。\n    //    其他店铺有货时必须点名报数，否则这就是典型的「静默 0」。\n    const others = (Array.isArray(data.other_shops) ? data.other_shops : []).filter((s) => Number(s.count || 0) > 0);\n    const otherTotal = others.reduce((sum, s) => sum + Number(s.count || 0), 0);\n    const otherHint = others.length\n      ? `<div class=\"radar-banner\">⚠️ <b>本店为空，但另外 ${others.length} 家店铺还有 ${otherTotal} 个关注 SKU</b>：${others.slice(0, 3).map((s) => `${escapeHtml(s.name || s.shop_id)} ×${Number(s.count || 0)}`).join(\"、\")}${others.length > 3 ? \" 等\" : \"\"}。<br>清单按店铺分开保存，<b>不是丢了</b> —— 用上方店铺选择器切过去即可查看与维护。</div>`\n      : \"\";\n    body.innerHTML = `${noticeBlock}${otherHint}\n      <div class=\"radar-banner\">这家店铺还没有关注任何 SKU。点右上角「+ 添加 SKU」把要重点跟的款加进来（可一次贴一批），加完再点「刷新销量」扫一次订单。</div>`;\n    return;\n  }\n\n  if (status && !WATCH_REFRESHING) {\n    const bits = [`盯 ${total} 个 SKU`, `紧急 ${Number(counts.high || 0)}`, `关注 ${Number(counts.medium || 0)}`];\n    if (Number(counts.unchecked || 0) > 0) bits.push(`未检查 ${Number(counts.unchecked || 0)}`);\n    if (Number(counts.handled || 0) > 0) bits.push(`已处理 ${Number(counts.handled || 0)}`);\n    bits.push(data.sales_fetched_at ? `销量快照 ${watchTimeText(data.sales_fetched_at)}` : \"销量尚未扫描\");\n    bits.push(data.offer_cache_at ? `报价缓存 ${watchTimeText(data.offer_cache_at)}` : \"无报价缓存\");\n    status.textContent = bits.join(\" · \");\n    const alarmed = Number(counts.high || 0) > 0 || Number(counts.unchecked || 0) > 0;\n    status.className = \"s-status\" + (alarmed ? \" warn\" : \" ok\");\n  }\n\n  const banners = [];\n  for (const skipped of data.skipped || []) {\n    banners.push(`<div class=\"radar-banner\"><b>未检查：${escapeHtml(skipped.label || skipped.code)}</b> —— ${escapeHtml(watchPlain(skipped.detail))}</div>`);\n  }\n  if (data.truncated) {\n    banners.push(`<div class=\"radar-banner\">本次订单扫描达到分页上限（4000 单），<b>销量可能不完整</b> —— 显示出来的「下滑」有可能是没扫全，不要直接据此下结论。</div>`);\n  }\n  const orderError = data.order_stats && data.order_stats.error;\n  if (orderError) {\n    banners.push(`<div class=\"radar-banner\">上一次订单扫描期间接口报错：${escapeHtml(String(orderError))} —— 销量可能不完整。</div>`);\n  }\n\n  const cards = WATCH_STATUS_CARDS.map(([key, label, cls]) => {\n    const count = Number(counts[key] || 0);\n    const active = WATCH_FILTER === key ? \" is-active\" : \"\";\n    const zero = count === 0 ? \" is-zero\" : \"\";\n    return `<div class=\"radar-card ${cls}${active}${zero}\" data-watch-status=\"${escapeAttr(key)}\">\n      <div class=\"rc-label\">${escapeHtml(label)}</div>\n      <div class=\"rc-value\">${count}</div>\n    </div>`;\n  }).join(\"\");\n\n  const ruleStrip = (data.rules || []).map((rule) => {\n    const count = Number(rule.count || 0);\n    const active = WATCH_RULE_FILTER === rule.code ? \" is-active\" : \"\";\n    const zero = count === 0 ? \" is-zero\" : \"\";\n    return `<div class=\"radar-card sev-${escapeAttr(rule.severity || \"low\")}${active}${zero}\" data-watch-rule=\"${escapeAttr(rule.code)}\" style=\"padding:9px 12px;\">\n      <div class=\"rc-label\">${escapeHtml(rule.label)}</div>\n      <div class=\"rc-value\" style=\"font-size:19px;\">${count}</div>\n    </div>`;\n  }).join(\"\");\n\n  const q = String(WATCH_QUERY || \"\").trim().toLowerCase();\n  const allItems = Array.isArray(data.items) ? data.items : [];\n  const rows = allItems.filter((row) => {\n    if (WATCH_FILTER && row.status !== WATCH_FILTER) return false;\n    if (WATCH_RULE_FILTER && !(row.rules || []).some((r) => r.code === WATCH_RULE_FILTER)) return false;\n    if (q) {\n      const hay = `${row.sku} ${row.title || \"\"} ${(row.tags || []).join(\" \")} ${row.note || \"\"}`.toLowerCase();\n      if (!hay.includes(q)) return false;\n    }\n    return true;\n  });\n\n  const filterBits = [];\n  if (WATCH_FILTER) filterBits.push(`状态「${watchStatusLabel(WATCH_FILTER)}」`);\n  if (WATCH_RULE_FILTER) filterBits.push(`规则「${(data.rules || []).find((r) => r.code === WATCH_RULE_FILTER)?.label || WATCH_RULE_FILTER}」`);\n  if (q) filterBits.push(`关键字「${WATCH_QUERY}」`);\n  if (filterTag) {\n    filterTag.textContent = filterBits.length ? `已筛选：${filterBits.join(\" · \")}（共 ${total} 个，显示 ${rows.length} 个）` : `共 ${total} 个关注 SKU`;\n  }\n\n  const rowHtml = rows.map((row) => {\n    const open = WATCH_EXPANDED === row.sku;\n    const rulePills = (row.rules || []).length\n      ? (row.rules || []).map((r) => `<span class=\"radar-pill sev-${r.severity || \"low\"}\" title=\"${escapeAttr(r.detail || \"\")}\">${escapeHtml(r.label)}</span>`).join(\" \")\n      : (row.status === \"unchecked\" ? `<span class=\"watch-flag mute\">未检查</span>` : `<span class=\"watch-flag mute\">无</span>`);\n    const salesCell = row.d7 === null\n      ? `<span class=\"watch-flag mute\">未扫描</span>`\n      : `${escapeHtml(watchNumText(row.d7))} / ${escapeHtml(watchNumText(row.prev7))} / ${escapeHtml(watchNumText(row.d30))}`;\n    const avgCell = row.daily_avg === null ? \"—\" : `${escapeHtml(watchNumText(row.daily_avg, 1))}/天`;\n    const daysCell = row.days_left === null ? \"—\" : `<b>${escapeHtml(watchNumText(row.days_left, 1))}</b> 天`;\n    const priceCell = row.price === null ? \"—\" : `€${escapeHtml(watchNumText(row.price, 2))}`;\n    const originCell = (row.origin_price !== null && row.price !== null && Number(row.origin_price) > Number(row.price))\n      ? `<div class=\"radar-note\" style=\"margin:1px 0 0;\">原价 €${escapeHtml(watchNumText(row.origin_price, 2))}</div>`\n      : \"\";\n    const titleCell = `${escapeHtml(row.title || \"—\")}`\n      + ((row.tags || []).length ? `<div class=\"radar-note\" style=\"margin:1px 0 0;\">${escapeHtml((row.tags || []).join(\" · \"))}</div>` : \"\")\n      + (row.note ? `<div class=\"radar-note\" style=\"margin:1px 0 0;\">备注：${escapeHtml(row.note)}</div>` : \"\");\n    const stockCell = `${row.quantity === null ? \"—\" : `${escapeHtml(watchNumText(row.quantity))} 件`} ${watchActiveHtml(row.active)}`;\n    return `<tr class=\"watch-row-toggle\" data-watch-toggle=\"${escapeAttr(row.sku)}\">\n        <td>${watchStatusPill(row.status)}</td>\n        <td class=\"rd-sku\">${escapeHtml(row.sku)}</td>\n        <td>${titleCell}</td>\n        <td class=\"rd-change\">${stockCell}</td>\n        <td class=\"rd-change\">${priceCell}${originCell}</td>\n        <td class=\"rd-change\">${salesCell}</td>\n        <td class=\"rd-change\">${avgCell}<div class=\"radar-note\" style=\"margin:1px 0 0;\">可售 ${daysCell}</div></td>\n        <td>${rulePills}</td>\n        <td style=\"white-space:nowrap;\"><button class=\"btn\" type=\"button\">${open ? \"收起\" : \"详情\"}</button></td>\n      </tr>`\n      + (open ? `<tr class=\"watch-detail-row\"><td colspan=\"9\">${watchDetailHtml(row)}</td></tr>` : \"\");\n  }).join(\"\");\n\n  const windowNote = data.window\n    ? `订单窗口 ${escapeHtml(data.window.from_beijing)} ~ ${escapeHtml(data.window.to_beijing)}（北京时间）`\n    : \"\";\n  const stats = data.order_stats || {};\n  const statsBits = [];\n  if (stats.orders !== undefined) statsBits.push(`扫到 ${Number(stats.orders || 0)} 单`);\n  if (stats.requests !== undefined) statsBits.push(`${Number(stats.requests || 0)} 次请求`);\n  if (stats.total_count !== undefined && stats.total_count !== null) statsBits.push(`平台单量 ${Number(stats.total_count)}`);\n  if (stats.lines_missing_sku) statsBits.push(`${Number(stats.lines_missing_sku)} 行取不到 SKU`);\n  if (stats.duplicates) statsBits.push(`重复订单 ${Number(stats.duplicates)} 条`);\n  if (stats.orders_out_of_window) statsBits.push(`${Number(stats.orders_out_of_window)} 单在窗口外已剔除`);\n\n  const table = rows.length === 0\n    ? `<div class=\"radar-note\" style=\"padding:12px 2px;\">当前筛选条件下没有 SKU。${filterBits.length ? \"点上面的卡片或清空搜索框可以取消筛选。\" : \"\"}</div>`\n    : `<table class=\"radar-table\">\n      <thead><tr><th>状态</th><th>SKU</th><th>商品</th><th>库存</th><th>价格</th><th>近7 / 前7 / 近30</th><th>日均 · 可售</th><th>命中规则</th><th></th></tr></thead>\n      <tbody>${rowHtml}</tbody>\n    </table>`;\n\n  body.innerHTML = `${noticeBlock}${banners.join(\"\")}\n    <div class=\"radar-cards\">${cards}</div>\n    <div class=\"s-form workflow-panel\" style=\"margin-top:4px;\">\n      <div class=\"radar-note\" style=\"margin-bottom:8px;\">规则命中（点一下只看这条，再点一次取消）</div>\n      <div class=\"radar-cards\">${ruleStrip}</div>\n    </div>\n    <div class=\"s-form workflow-panel\" style=\"margin-top:4px;\">\n      <div class=\"radar-note\" style=\"margin-bottom:8px;\">\n        ${filterBits.length ? `已筛选：${escapeHtml(filterBits.join(\" · \"))} <button class=\"btn\" id=\"btnWatchClearFilter\" style=\"margin-left:8px;\">清除筛选</button>` : \"点状态卡或规则卡可快速筛选。\"}\n        ${windowNote ? ` · ${windowNote}` : \"\"}\n        ${statsBits.length ? ` · ${escapeHtml(statsBits.join(\" / \"))}` : \"\"}\n      </div>\n      <div style=\"max-height:560px; overflow:auto;\">${table}</div>\n      <div class=\"radar-note\" style=\"margin-top:8px;\">\n        点击任意一行展开详情（规则说明 / 阈值调整 / 标记已处理 / 移除）。\n        「需要处理的」按状态卡筛选「紧急」「关注」即可，处理完点「标记已处理」把它挪出视野。\n      </div>\n    </div>`;\n\n  body.querySelectorAll(\"[data-watch-status]\").forEach((el) => {\n    el.addEventListener(\"click\", () => {\n      const key = el.dataset.watchStatus || \"\";\n      WATCH_FILTER = WATCH_FILTER === key ? \"\" : key;\n      renderSpecialAttention();\n    });\n  });\n  body.querySelectorAll(\"[data-watch-rule]\").forEach((el) => {\n    el.addEventListener(\"click\", () => {\n      const code = el.dataset.watchRule || \"\";\n      WATCH_RULE_FILTER = WATCH_RULE_FILTER === code ? \"\" : code;\n      renderSpecialAttention();\n    });\n  });\n  const clearBtn = $(\"btnWatchClearFilter\");\n  if (clearBtn) clearBtn.addEventListener(\"click\", () => {\n    WATCH_FILTER = \"\";\n    WATCH_RULE_FILTER = \"\";\n    WATCH_QUERY = \"\";\n    const qi = $(\"watchQuery\");\n    if (qi) qi.value = \"\";\n    renderSpecialAttention();\n  });\n  body.querySelectorAll(\"tr[data-watch-toggle]\").forEach((tr) => {\n    tr.addEventListener(\"click\", () => {\n      const sku = tr.dataset.watchToggle || \"\";\n      WATCH_EXPANDED = WATCH_EXPANDED === sku ? \"\" : sku;\n      renderSpecialAttention();\n    });\n  });\n  body.querySelectorAll(\"[data-watch-detail]\").forEach((box) => {\n    const sku = box.dataset.watchDetail || \"\";\n    const saveBtn = box.querySelector(\"[data-watch-th-save]\");\n    if (saveBtn) saveBtn.addEventListener(\"click\", () => watchSaveThresholds(box, sku, false));\n    const resetBtn = box.querySelector(\"[data-watch-th-reset]\");\n    if (resetBtn) resetBtn.addEventListener(\"click\", () => watchSaveThresholds(box, sku, true));\n    const handledBtn = box.querySelector(\"[data-watch-handled]\");\n    if (handledBtn) handledBtn.addEventListener(\"click\", () => {\n      const noteEl = box.querySelector(\"[data-watch-handle-note]\");\n      watchItemOp(\"handled\", sku, { note: String((noteEl && noteEl.value) || \"\").trim() });\n    });\n    const unhandledBtn = box.querySelector(\"[data-watch-unhandled]\");\n    if (unhandledBtn) unhandledBtn.addEventListener(\"click\", () => watchItemOp(\"unhandled\", sku));\n    const removeBtn = box.querySelector(\"[data-watch-remove]\");\n    if (removeBtn) removeBtn.addEventListener(\"click\", () => {\n      if (!confirm(`把 ${sku} 从特别关注清单里移除？\\n\\n只删本机清单记录，不会动平台上的报价。`)) return;\n      WATCH_EXPANDED = \"\";\n      watchItemOp(\"remove\", sku);\n    });\n  });\n}\n\n// ---- 海外仓退件模块（WMS 首屏缓存 + 批量转入库）----\nlet WMS_READY = false;\nlet WMS_ACCOUNTS = [];\nlet WMS_SELECTED_ACCOUNT = \"\";\nlet WMS_WAREHOUSES = [];\nlet WMS_RETURNS = [];\nlet WMS_SELECTED = new Set();\nlet WMS_LOAD_SEQ = 0;\nlet WMS_CONVERTING = false;\nlet WMS_ACCOUNTS_REQUEST = null;\nlet TENCENT_RETURNS_READY = false;\nlet TENCENT_RETURNS_RECORDS = [];\nlet TENCENT_RETURNS_LOAD_SEQ = 0;\nlet TENCENT_RETURNS_CACHE = null;\nlet TENCENT_INNER_READY = false;\nlet TENCENT_INNER_RECORDS = [];\nlet TENCENT_INNER_LOAD_SEQ = 0;\nlet TENCENT_INNER_CACHE = null;\n\nconst WMS_RETURN_STATUS_LABELS = {\n  \"-3\": \"异常\",\n  \"-2\": \"已弃货\",\n  \"-1\": \"待弃货\",\n  \"1\": \"签收待入\",\n  \"2\": \"已签收\",\n  \"3\": \"待重派\",\n  \"4\": \"已重派\",\n  \"5\": \"已转成入库单\",\n};\n\nconst WMS_DAMAGED_STATUS_LABELS = {\n  \"0\": \"未破损\",\n  \"1\": \"已破损\",\n  \"2\": \"已破损（不出物流单）\",\n  \"3\": \"已破损（需要出物流单）\",\n};\n\nfunction wmsText(value, fallback = \"—\") {\n  const text = value === undefined || value === null ? \"\" : String(value).trim();\n  return escapeHtml(text || fallback);\n}\n\nfunction wmsRowConvertible(record) {\n  if (typeof record.convertible === \"boolean\") return record.convertible;\n  const status = String(record.status || \"\").trim();\n  return status === \"2\" && String(record.signed_sku || \"\").trim() !== \"\";\n}\n\nfunction wmsCurrentAccount() {\n  return WMS_ACCOUNTS.find((account) => String(account.id) === String(WMS_SELECTED_ACCOUNT)) || null;\n}\n\nfunction wmsDisplayedPartnerOrderNum(record) {\n  return String(WMS_SELECTED_ACCOUNT || \"\").trim() === \"DGSC12\"\n    ? record.oldPartnerOrderNum\n    : record.originPartnerOrderNum;\n}\n\nfunction wmsSearchTerms(value) {\n  return [...new Set(String(value || \"\").split(/\\r?\\n/).map((item) => item.trim().toLowerCase()).filter(Boolean))];\n}\n\nfunction wmsSearchHaystack(record, field) {\n  const values = field === \"shipping\"\n    ? [record.shippingNum]\n    : field === \"order\"\n      ? [wmsDisplayedPartnerOrderNum(record)]\n      : field === \"sku\"\n        ? [record.signed_sku_display, record.signed_sku]\n        : [record.shippingNum, record.oldPartnerOrderNum, record.originPartnerOrderNum, record.signed_sku_display, record.signed_sku];\n  return values.map((value) => String(value || \"\").trim().toLowerCase()).join(\" \");\n}\n\nfunction wmsWarehouseLabel(id) {\n  const key = String(id || \"\").trim();\n  const warehouse = WMS_WAREHOUSES.find((item) => String(item.id) === key);\n  return warehouse ? `${warehouse.name || key}${key ? `（${key}）` : \"\"}` : (key || \"—\");\n}\n\nfunction wmsVisibleReturns() {\n  const warehouse = String($(\"wmsWarehouse\")?.value || \"\").trim();\n  const status = String($(\"wmsStatusFilter\")?.value || \"\").trim();\n  const convertible = String($(\"wmsConvertibleFilter\")?.value || \"\").trim();\n  const damaged = String($(\"wmsDamagedFilter\")?.value || \"\").trim();\n  const searchField = String($(\"wmsSearchField\")?.value || \"all\").trim();\n  const searchTerms = wmsSearchTerms($(\"wmsSearch\")?.value);\n  const start = String($(\"wmsStartDate\")?.value || \"\").trim();\n  const end = String($(\"wmsEndDate\")?.value || \"\").trim();\n  return WMS_RETURNS.filter((record) => {\n    if (warehouse && String(record.warehouseId || \"\") !== warehouse) return false;\n    if (status && String(record.status || \"\") !== status) return false;\n    if (convertible === \"yes\" && !wmsRowConvertible(record)) return false;\n    if (convertible === \"no\" && wmsRowConvertible(record)) return false;\n    if (damaged && String(record.damagedStatus || \"\").trim() !== damaged) return false;\n    if (searchTerms.length) {\n      const haystack = wmsSearchHaystack(record, searchField);\n      if (!searchTerms.some((term) => haystack.includes(term))) return false;\n    }\n    const created = String(record.createTime || \"\").slice(0, 10);\n    if (start && (!created || created < start)) return false;\n    if (end && (!created || created > end)) return false;\n    return true;\n  });\n}\n\nfunction ensureWmsAccounts() {\n  if (WMS_ACCOUNTS.length) {\n    return Promise.resolve(WMS_ACCOUNTS);\n  }\n  if (WMS_ACCOUNTS_REQUEST) return WMS_ACCOUNTS_REQUEST;\n  WMS_ACCOUNTS_REQUEST = loadWmsAccounts().finally(() => {\n    WMS_ACCOUNTS_REQUEST = null;\n  });\n  return WMS_ACCOUNTS_REQUEST;\n}\n\nfunction updateWmsCacheNote(cache, total, loaded) {\n  const note = $(\"wmsCacheNote\");\n  if (!note) return;\n  const info = cache || {};\n  const source = info.source === \"api\" ? \"WMS 接口\" : \"本地缓存\";\n  const fetched = info.fetched_at ? new Date(info.fetched_at).toLocaleString() : \"尚未同步\";\n  const stale = info.stale ? \" · 已过期，后台同步中\" : \"\";\n  const refreshing = info.refreshing && !info.stale ? \" · 后台同步中\" : \"\";\n  note.textContent = `${source} · ${fetched}${stale || refreshing} · 显示 ${loaded}/${Math.min(Number(total || loaded), 500)} 条`;\n}\n\nfunction renderWmsWarehouseOptions() {\n  const select = $(\"wmsWarehouse\");\n  if (!select) return;\n  const current = select.value;\n  select.innerHTML = '<option value=\"\">全部仓库</option>' + WMS_WAREHOUSES.map((warehouse) =>\n    `<option value=\"${escapeAttr(warehouse.id)}\">${wmsText(warehouse.name || warehouse.id)}</option>`\n  ).join(\"\");\n  if (WMS_WAREHOUSES.some((warehouse) => String(warehouse.id) === current)) select.value = current;\n}\n\nfunction renderWmsSelectionState() {\n  const visible = wmsVisibleReturns();\n  const eligible = visible.filter(wmsRowConvertible);\n  const selectedVisible = eligible.filter((record) => WMS_SELECTED.has(String(record.shippingNum || \"\").trim()));\n  const selectAllInputs = [$(\"wmsSelectAll\"), document.querySelector(\"#wmsTableWrap input[data-wms-select-all]\")].filter(Boolean);\n  for (const selectAll of selectAllInputs) {\n    selectAll.checked = eligible.length > 0 && selectedVisible.length === eligible.length;\n    selectAll.indeterminate = selectedVisible.length > 0 && selectedVisible.length < eligible.length;\n  }\n  const info = $(\"wmsSelectionInfo\");\n  if (info) info.textContent = `已选 ${WMS_SELECTED.size} 条 · 当前筛选可转换 ${eligible.length} 条`;\n  const button = $(\"btnWmsConvert\");\n  if (button) button.disabled = WMS_CONVERTING || WMS_SELECTED.size === 0;\n}\n\nfunction renderWmsTable() {\n  const wrap = $(\"wmsTableWrap\");\n  if (!wrap) return;\n  const rows = wmsVisibleReturns();\n  const count = $(\"wmsCount\");\n  if (count) count.textContent = `显示 ${rows.length} 条 · 首屏 ${WMS_RETURNS.length} 条 · 可转换 ${rows.filter(wmsRowConvertible).length} 条`;\n  if (rows.length === 0) {\n    wrap.innerHTML = '<div class=\"wms-empty\">暂无符合条件的退件。请确认账号已加载或调整筛选条件。</div>';\n    renderWmsSelectionState();\n    return;\n  }\n\n  const rowHtml = rows.map((record) => {\n    const shippingNum = String(record.shippingNum || \"\").trim();\n    const eligible = wmsRowConvertible(record);\n    const products = Array.isArray(record.returnPro) ? record.returnPro : [];\n    const barcodes = products.map((item) => String(item && item.barcode || \"\").trim()).filter(Boolean).join(\"、\");\n    const quantities = products.map((item) => item && item.num).filter((value) => value !== undefined && value !== null && String(value) !== \"\").join(\"、\");\n    const status = String(record.status || \"\").trim();\n    const statusClass = status === \"5\" ? \"wms-status-done\" : (!eligible ? \"wms-status-blocked\" : \"\");\n    return `<tr>\n      <td class=\"wms-check-cell\"><input type=\"checkbox\" data-wms-select=\"${escapeAttr(shippingNum)}\" ${WMS_SELECTED.has(shippingNum) ? \"checked\" : \"\"} ${eligible && shippingNum ? \"\" : \"disabled\"} title=\"${escapeAttr(eligible ? \"可转入库\" : \"不可转入库\")}\"></td>\n      <td class=\"wms-nowrap\">${wmsText(record.shippingCode)}</td>\n      <td class=\"wms-mono wms-nowrap\">${wmsText(shippingNum)}</td>\n      <td class=\"wms-mono wms-nowrap\">${wmsText(wmsDisplayedPartnerOrderNum(record))}</td>\n      <td class=\"wms-nowrap\">${wmsText(wmsWarehouseLabel(record.warehouseId))}</td>\n      <td><span class=\"wms-status-pill ${statusClass}\">${wmsText(record.status_label || WMS_RETURN_STATUS_LABELS[status] || status)}</span></td>\n      <td class=\"wms-nowrap\">${wmsText(record.createTime)}</td>\n      <td>${wmsText(record.returnReason)}</td>\n      <td>${wmsText(record.damaged_status_label || record.damagedStatus)}</td>\n      <td>${wmsText(record.match_status_label || record.isMatchProduct)}</td>\n      <td class=\"wms-mono\">${wmsText(barcodes)}</td>\n      <td class=\"wms-sku\">${wmsText(record.signed_sku_display || record.signed_sku)}</td>\n      <td class=\"wms-nowrap\">${wmsText(quantities)}</td>\n      <td class=\"wms-mono wms-nowrap\">${wmsText(record.orderNum)}</td>\n      <td class=\"wms-mono wms-nowrap\">${wmsText(record.stockNum)}</td>\n    </tr>`;\n  }).join(\"\");\n\n  wrap.innerHTML = `<table class=\"wms-table\"><thead><tr>\n    <th class=\"wms-check-cell\"><input type=\"checkbox\" data-wms-select-all=\"1\" title=\"全选当前筛选中可转换的退件\"></th>\n    <th>物流方式</th><th>旧物流号</th><th>退件旧客户订单号</th><th>仓库</th><th>状态</th><th>创建时间</th><th>退件原因</th><th>破损状态</th><th>匹配状态</th><th>签收 barcode</th><th>签收 SKU</th><th>数量</th><th>入库单号</th><th>入库批次号</th>\n  </tr></thead><tbody>${rowHtml}</tbody></table>`;\n\n  const toggleAll = (event) => {\n    const visible = wmsVisibleReturns().filter(wmsRowConvertible);\n    for (const record of visible) {\n      const shipping = String(record.shippingNum || \"\").trim();\n      if (!shipping) continue;\n      if (event.target.checked) WMS_SELECTED.add(shipping);\n      else WMS_SELECTED.delete(shipping);\n    }\n    renderWmsTable();\n  };\n  const actionSelectAll = $(\"wmsSelectAll\");\n  if (actionSelectAll && actionSelectAll.dataset.wmsBound !== \"1\") {\n    actionSelectAll.dataset.wmsBound = \"1\";\n    actionSelectAll.addEventListener(\"change\", toggleAll);\n  }\n  const tableSelectAll = wrap.querySelector(\"input[data-wms-select-all]\");\n  if (tableSelectAll) tableSelectAll.addEventListener(\"change\", toggleAll);\n  wrap.querySelectorAll(\"input[data-wms-select]\").forEach((input) => input.addEventListener(\"change\", (event) => {\n    const shipping = String(event.currentTarget.dataset.wmsSelect || \"\").trim();\n    if (!shipping) return;\n    if (event.currentTarget.checked) WMS_SELECTED.add(shipping);\n    else WMS_SELECTED.delete(shipping);\n    renderWmsSelectionState();\n  }));\n  renderWmsSelectionState();\n}\n\nasync function loadWmsData(options = {}) {\n  const accountId = String(WMS_SELECTED_ACCOUNT || \"\").trim();\n  if (!accountId) return;\n  const request = ++WMS_LOAD_SEQ;\n  const status = $(\"wmsStatusMessage\");\n  if (status) {\n    status.textContent = options.force ? \"正在跳过缓存同步退件…\" : \"正在读取退件缓存…\";\n    status.className = \"wms-status\";\n  }\n  const [warehouseResult, returnResult] = await Promise.allSettled([\n    api(`/api/wms/warehouses?account_id=${encodeURIComponent(accountId)}${options.force ? \"&force=true\" : \"\"}`),\n    api(`/api/wms/returns?account_id=${encodeURIComponent(accountId)}${options.force ? \"&force=true\" : \"\"}`),\n  ]);\n  if (request !== WMS_LOAD_SEQ || accountId !== WMS_SELECTED_ACCOUNT) return;\n  if (warehouseResult.status === \"fulfilled\") {\n    WMS_WAREHOUSES = Array.isArray(warehouseResult.value.warehouses) ? warehouseResult.value.warehouses : [];\n    renderWmsWarehouseOptions();\n  }\n  if (returnResult.status !== \"fulfilled\") {\n    const error = returnResult.reason;\n    WMS_RETURNS = [];\n    renderWmsTable();\n    if (status) {\n      status.textContent = `退件读取失败：${error.message}`;\n      status.className = \"wms-status err\";\n    }\n    return;\n  }\n  const data = returnResult.value;\n  WMS_RETURNS = Array.isArray(data.records) ? data.records : [];\n  WMS_SELECTED = new Set([...WMS_SELECTED].filter((shipping) => WMS_RETURNS.some((record) => String(record.shippingNum) === shipping && wmsRowConvertible(record))));\n  updateWmsCacheNote(data.cache, data.total, WMS_RETURNS.length);\n  renderWmsTable();\n  if (status) {\n    const cache = data.cache || {};\n    status.textContent = cache.stale ? \"已显示旧缓存，后台同步中\" : `已加载 ${WMS_RETURNS.length} 条退件`;\n    status.className = cache.stale ? \"wms-status warn\" : \"wms-status ok\";\n  }\n  if (warehouseResult.status === \"rejected\" && status) {\n    status.textContent += `；仓库列表读取失败：${warehouseResult.reason.message}`;\n    status.className = \"wms-status warn\";\n  }\n}\n\nasync function loadWmsAccounts() {\n  const status = $(\"wmsStatusMessage\");\n  try {\n    const data = await api(\"/api/wms/accounts\");\n    WMS_ACCOUNTS = Array.isArray(data.accounts) ? data.accounts : [];\n    const select = $(\"wmsAccount\");\n    if (!WMS_ACCOUNTS.length) {\n      if (select) select.innerHTML = '<option value=\"\">暂无 WMS 账号</option>';\n      if (status) {\n        status.textContent = data.error || \"尚未配置 WMS 账号\";\n        status.className = \"wms-status err\";\n      }\n      return;\n    }\n    if (!WMS_ACCOUNTS.some((account) => String(account.id) === WMS_SELECTED_ACCOUNT)) WMS_SELECTED_ACCOUNT = String(WMS_ACCOUNTS[0].id);\n    if (!select) return;\n    select.innerHTML = WMS_ACCOUNTS.map((account) => `<option value=\"${escapeAttr(account.id)}\">${wmsText(account.name || account.id)}</option>`).join(\"\");\n    select.value = WMS_SELECTED_ACCOUNT;\n    await loadWmsData();\n  } catch (error) {\n    if (status) {\n      status.textContent = `WMS 账号读取失败：${error.message}`;\n      status.className = \"wms-status err\";\n    }\n  }\n}\n\nasync function convertWmsSelected() {\n  if (WMS_CONVERTING || WMS_SELECTED.size === 0 || !WMS_SELECTED_ACCOUNT) return;\n  const account = wmsCurrentAccount();\n  const shippingNums = [...WMS_SELECTED];\n  const invalid = shippingNums.filter((shipping) => {\n    const record = WMS_RETURNS.find((item) => String(item.shippingNum) === shipping);\n    return !record || !wmsRowConvertible(record);\n  });\n  if (invalid.length) {\n    WMS_SELECTED = new Set(shippingNums.filter((shipping) => !invalid.includes(shipping)));\n    renderWmsTable();\n    return;\n  }\n  const confirmed = confirm(`确认将 ${shippingNums.length} 个退件转成入库单？\\n\\n账号：${account ? account.name : WMS_SELECTED_ACCOUNT}\\n条件：状态为“已签收”且签收 SKU 不为空\\n\\n提交后由 WMS 逐单处理。`);\n  if (!confirmed) return;\n  WMS_CONVERTING = true;\n  const status = $(\"wmsStatusMessage\");\n  const button = $(\"btnWmsConvert\");\n  if (button) button.disabled = true;\n  if (status) {\n    status.textContent = `正在逐单转入库（${shippingNums.length} 条）…`;\n    status.className = \"wms-status\";\n  }\n  try {\n    const data = await api(\"/api/wms/returns/convert\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ account_id: WMS_SELECTED_ACCOUNT, shipping_nums: shippingNums }),\n    });\n    const results = Array.isArray(data.results) ? data.results : [];\n    const succeeded = new Set(results.filter((item) => item.ok).map((item) => String(item.shippingNum)));\n    for (const record of WMS_RETURNS) {\n      if (!succeeded.has(String(record.shippingNum))) continue;\n      record.status = \"5\";\n      record.status_label = \"已转成入库单\";\n      record.convertible = false;\n      record.eligibility_reason = \"已转成入库单\";\n    }\n    WMS_SELECTED = new Set(shippingNums.filter((shipping) => !succeeded.has(shipping)));\n    renderWmsTable();\n    const failed = results.filter((item) => !item.ok);\n    if (status) {\n      status.textContent = failed.length ? `批量完成：成功 ${succeeded.size} 条，失败 ${failed.length} 条（失败项仍保留勾选）` : `批量完成：成功 ${succeeded.size} 条`;\n      status.className = failed.length ? \"wms-status warn\" : \"wms-status ok\";\n      status.title = failed.map((item) => `${item.shippingNum}：${item.reason || \"失败\"}`).join(\"；\");\n    }\n  } catch (error) {\n    if (status) {\n      status.textContent = `批量转入库失败：${error.message}`;\n      status.className = \"wms-status err\";\n    }\n  } finally {\n    WMS_CONVERTING = false;\n    renderWmsSelectionState();\n  }\n}\n\nfunction initWmsPage() {\n  const box = $(\"pageWms\");\n  if (!box || box.dataset.ready === \"1\") return;\n  box.dataset.ready = \"1\";\n  box.innerHTML = `<div class=\"wms-returns operation-shell\">\n    <header class=\"wms-header\">\n      <div><h2>海外仓退件管理</h2><div class=\"wms-sub\">WMS 退件首屏管理 · 仅加载第一页固定 500 条 · 可将已签收且有签收 SKU 的退件批量转成入库单</div></div>\n      <div class=\"wms-sync-note\" id=\"wmsCacheNote\">正在读取 WMS 缓存状态…</div>\n    </header>\n    <div class=\"wms-filter-panel\">\n      <div class=\"wms-filter-row\">\n        <div class=\"wms-field\"><label>WMS 账号</label><select id=\"wmsAccount\" class=\"wms-control\"><option value=\"\">正在读取账号…</option></select></div>\n        <div class=\"wms-field\"><label>仓库</label><select id=\"wmsWarehouse\" class=\"wms-control\"><option value=\"\">全部仓库</option></select></div>\n        <div class=\"wms-field\"><label>退件状态</label><select id=\"wmsStatusFilter\" class=\"wms-control\"><option value=\"\">全部状态</option>${Object.entries(WMS_RETURN_STATUS_LABELS).map(([code, label]) => `<option value=\"${code}\">${label}</option>`).join(\"\")}</select></div>\n        <div class=\"wms-field\"><label>转入库资格</label><select id=\"wmsConvertibleFilter\" class=\"wms-control\"><option value=\"\">全部</option><option value=\"yes\">可转入库</option><option value=\"no\">不可转入库</option></select></div>\n        <div class=\"wms-field\"><label>破损状态</label><select id=\"wmsDamagedFilter\" class=\"wms-control\"><option value=\"\">全部破损状态</option>${Object.entries(WMS_DAMAGED_STATUS_LABELS).map(([code, label]) => `<option value=\"${code}\">${label}</option>`).join(\"\")}</select></div>\n        <div class=\"wms-field wms-field-search-type\"><label>搜索字段</label><select id=\"wmsSearchField\" class=\"wms-control\"><option value=\"all\">全部字段</option><option value=\"shipping\">物流号</option><option value=\"order\">客户订单号</option><option value=\"sku\">SKU</option></select></div>\n        <div class=\"wms-field wms-field-search\"><label>搜索关键词（可换行）</label><textarea id=\"wmsSearch\" class=\"wms-control\" rows=\"2\" placeholder=\"每行输入一个关键词\"></textarea></div>\n        <div class=\"wms-field\"><label>创建开始</label><input id=\"wmsStartDate\" class=\"wms-control\" type=\"date\"></div>\n        <div class=\"wms-field\"><label>创建结束</label><input id=\"wmsEndDate\" class=\"wms-control\" type=\"date\"></div>\n        <div class=\"wms-filter-actions\"><button class=\"btn\" id=\"btnWmsQuery\" type=\"button\">筛选</button><button class=\"btn\" id=\"btnWmsReload\" type=\"button\">强制刷新</button></div>\n      </div>\n      <div class=\"wms-filter-hint\">缓存策略：不足 6 小时直接使用本地缓存；超过 6 小时先展示旧数据并在后台同步。批量搜索时每行一个关键词，任一关键词命中即可。账号切换只影响海外仓数据，不影响顶部 Mirakl 店铺。</div>\n    </div>\n    <div class=\"wms-table-panel\">\n      <div class=\"wms-action-bar\">\n        <label class=\"wms-select-all\"><input id=\"wmsSelectAll\" type=\"checkbox\"> 全选当前筛选</label>\n        <span id=\"wmsSelectionInfo\" class=\"wms-count\">已选 0 条</span>\n        <span id=\"wmsCount\" class=\"wms-count\">等待加载…</span>\n        <span id=\"wmsStatusMessage\" class=\"wms-status\"></span>\n        <button class=\"btn primary\" id=\"btnWmsConvert\" type=\"button\" disabled>批量转成入库单</button>\n      </div>\n      <div id=\"wmsTableWrap\" class=\"wms-table-wrap\"><div class=\"wms-empty\">正在加载退件…</div></div>\n    </div>\n  </div>`;\n  $(\"wmsAccount\").addEventListener(\"change\", () => {\n    WMS_SELECTED_ACCOUNT = $(\"wmsAccount\").value;\n    WMS_SELECTED = new Set();\n    WMS_WAREHOUSES = [];\n    renderWmsWarehouseOptions();\n    loadWmsData().catch(() => {});\n  });\n  [\"wmsWarehouse\", \"wmsStatusFilter\", \"wmsConvertibleFilter\", \"wmsDamagedFilter\", \"wmsSearchField\", \"wmsSearch\", \"wmsStartDate\", \"wmsEndDate\"].forEach((id) => {\n    $(id).addEventListener(\"input\", renderWmsTable);\n    $(id).addEventListener(\"change\", renderWmsTable);\n  });\n  $(\"btnWmsQuery\").addEventListener(\"click\", renderWmsTable);\n  $(\"btnWmsReload\").addEventListener(\"click\", () => loadWmsData({ force: true }).catch(() => {}));\n  $(\"btnWmsConvert\").addEventListener(\"click\", convertWmsSelected);\n  const accountSelect = $(\"wmsAccount\");\n  if (WMS_ACCOUNTS.length && accountSelect) {\n    if (!WMS_ACCOUNTS.some((account) => String(account.id) === WMS_SELECTED_ACCOUNT)) WMS_SELECTED_ACCOUNT = String(WMS_ACCOUNTS[0].id);\n    accountSelect.innerHTML = WMS_ACCOUNTS.map((account) => `<option value=\"${escapeAttr(account.id)}\">${wmsText(account.name || account.id)}</option>`).join(\"\");\n    accountSelect.value = WMS_SELECTED_ACCOUNT;\n    loadWmsData().catch(() => {});\n  } else {\n    ensureWmsAccounts().catch(() => {});\n  }\n}\n\n// ---- 退货标签模块（RT01 一键创建 + 自动站内信通知）----\nconst RL_METHODS = [\n  { code: \"RETURN_METHOD_BY_MAIL\", zh: \"邮寄退货\" },\n  { code: \"RETURN_METHOD_DROP_OFF_POINT\", zh: \"自提点投递\" },\n  { code: \"RETURN_METHOD_HOME_PICKUP\", zh: \"上门取件\" },\n  { code: \"RETURN_METHOD_IN_STORE\", zh: \"门店退货\" },\n  { code: \"RETURN_METHOD_RETURNLESS\", zh: \"无需退货（仅退款）\" },\n];\nconst RL_REASONS = [\n  [\"RETURN_CHANGED_MIND\", \"不想要了 / 改变主意\"],\n  [\"RETURN_DEFECTIVE_ITEM\", \"商品有缺陷\"],\n  [\"RETURN_BROKEN_ITEM\", \"商品破损\"],\n  [\"RETURN_DAMAGED_PACKAGING\", \"包装破损\"],\n  [\"RETURN_PRODUCT_DOES_NOT_FIT\", \"不合适 / 不匹配\"],\n  [\"RETURN_PDNT_TOO_BIG\", \"尺寸太大\"],\n  [\"RETURN_PDNT_TOO_SMALL\", \"尺寸太小\"],\n  [\"RETURN_INACCURATE_ITEM_DESCRIPTION\", \"与描述不符\"],\n  [\"RETURN_DELIVERED_PRODUCT_DIFFERENT\", \"发错货\"],\n  [\"RETURN_MISSING_ITEM\", \"缺件\"],\n  [\"RETURN_DEFECTIVE_ON_ARRIVAL\", \"到货即坏 (DOA)\"],\n  [\"RETURN_COUNTERFEIT_ITEM\", \"疑似假货\"],\n  [\"RETURN_CM_DONT_WANT\", \"客户：不想要了\"],\n  [\"RETURN_CM_DONT_LIKE\", \"客户：不喜欢\"],\n  [\"RETURN_CM_QUALITY\", \"客户：质量问题\"],\n  [\"RETURN_DPD_WRONG_SIZE\", \"DPD：尺寸错误\"],\n  [\"RETURN_DPD_WRONG_COLOR\", \"DPD：颜色错误\"],\n  [\"RETURN_WARRANTY\", \"保修\"],\n  [\"RETURN_OTHER\", \"其他\"],\n];\nlet RL_READY = false;\nfunction initReturnLabelPage() {\n  if (RL_READY) { rlSyncShop(); return; }\n  RL_READY = true;\n  $(\"pageReturnLabel\").innerHTML = `<div class=\"offers operation-shell\">\n    <header class=\"operation-header\"><h2>发送退货标签</h2>\n    <div class=\"s-sub\">输入订单号和退货标签的下载链接 → 自动创建退货单（附标签+自动验收）→ 按店铺语言给买家发站内信（有现有对话则回复，无则新建）</div></header>\n    <div class=\"s-form workflow-panel\">\n      <div class=\"s-field\" style=\"display:grid;grid-template-columns:1fr 1fr;gap:14px;\">\n        <div><label>订单号（自动补全 -A/-B、自动识别店铺）</label>\n          <input id=\"rlOrderId\" class=\"s-input\" placeholder=\"如：01125_322626379 或带 -A 后缀\"></div>\n        <div><label>退货标签下载 URL</label>\n          <input id=\"rlLabelUrl\" class=\"s-input\" placeholder=\"https://…（买家可下载面单的链接）\"></div>\n      </div>\n      <div class=\"s-field\" style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;\">\n        <div><label>退货方式</label>\n          <select id=\"rlMethod\" class=\"s-input\">${RL_METHODS.map((m) => `<option value=\"${m.code}\">${m.zh}</option>`).join(\"\")}</select></div>\n        <div><label>退货原因</label>\n          <select id=\"rlReason\" class=\"s-input\">${RL_REASONS.map(([c, zh]) => `<option value=\"${c}\">${zh}</option>`).join(\"\")}</select></div>\n        <div><label>自动验收</label>\n          <select id=\"rlAccept\" class=\"s-input\"><option value=\"true\">是（创建后立即通过，买家马上能看到标签）</option><option value=\"false\">否（走人工验收流程）</option></select></div>\n      </div>\n      <div class=\"s-actions\" style=\"flex-wrap:wrap;row-gap:8px;\">\n        <button class=\"btn\" id=\"btnRlErpFetch\">① 从 ERP 申请退货单并取面单链接（不发送）</button>\n        <button class=\"btn primary\" id=\"btnRlChain\">⚡ 一键到底：申请退货单 → 建退货单 → 发站内信</button>\n        <span class=\"s-status\" id=\"rlErpStatus\"></span>\n      </div>\n      <div id=\"rlErpResult\" style=\"margin-top:12px;\"></div>\n      <div class=\"s-actions\">\n        <button class=\"btn\" id=\"btnRlSubmit\">② 仅发送（用上方标签链接建退货单 + 发站内信）</button>\n        <span class=\"s-status\" id=\"rlStatus\"></span>\n      </div>\n      <div id=\"rlResult\" style=\"margin-top:12px;\"></div>\n    </div>\n  </div>`;\n  // ⚠️ v26.70：这三个 `.catch(() => {})` 曾经把**任何**异常都吞得干干净净。\n  //    只要处理函数在第一行之前就抛错（元素不存在、字段读不到…），\n  //    用户看到的就是「点了确定，界面毫无变化，标签也没发出去」——同事机器实测。\n  //    统一改成把错误写进状态区：任何失败都必须看得见。\n  const rlRun = (fn) => {\n    const report = (e) => {\n      const msg = \"失败：\" + ((e && e.message) || e || \"未知错误\");\n      for (const id of [\"rlErpStatus\", \"rlStatus\"]) {\n        const el = $(id);\n        if (el) { el.textContent = msg; el.className = \"s-status err\"; }\n      }\n    };\n    try {\n      const r = fn();\n      if (r && typeof r.catch === \"function\") r.catch(report);\n    } catch (e) { report(e); }\n  };\n  $(\"btnRlSubmit\").addEventListener(\"click\", () => rlRun(submitReturnLabel));\n  $(\"btnRlErpFetch\").addEventListener(\"click\", () => rlRun(rlFetchErpLabel));\n  $(\"btnRlChain\").addEventListener(\"click\", () => rlRun(rlChainReturnLabel));\n  rlSyncShop();\n}\nfunction rlSyncShop() {\n  // 全局店铺联动提示\n  const box = $(\"pageReturnLabel\");\n  if (!box || !box.innerHTML) return;\n  const cs = SHOPS.find((s) => s.shop_id === GLOBAL_SHOP);\n  const sub = box.querySelector(\".s-sub\");\n  if (sub) sub.textContent = (cs ? `当前店铺：${cs.name} · ` : \"未选择店铺 · \")\n    + \"输入订单号和退货标签的下载链接 → 自动创建退货单（附标签+自动验收）→ 按店铺语言给买家现有对话发站内信\";\n}\n// 第二步（Mirakl 侧）：用「订单 + 标签链接」建退货单（RT01，附标签 + 自动验收）→ 按店铺语言发站内信。\n// 由 submitReturnLabel（读输入框，带确认）与 rlChainReturnLabel（一键到底，已确认过）共用。\nasync function rlSendLabel({ orderId, labelUrl, method, reason, accepted, skipConfirm = false, erpReturnNum = \"\" }) {\n  const st = $(\"rlStatus\");\n  if (!skipConfirm) {\n    const methodZh = (RL_METHODS.find((m) => m.code === method) || { zh: method }).zh;\n    const reasonZh = (RL_REASONS.find(([c]) => c === reason) || [\"\", reason])[1];\n    if (!confirm(`确认发送？\\n\\n订单：${orderId}\\n退货方式：${methodZh}\\n原因：${reasonZh}\\n标签：${labelUrl}\\n\\n将依次：① 创建退货单（附标签）② 给买家现有对话发送对应语言的站内信`)) return null;\n  }\n  st.textContent = \"执行中…（查订单 → 建退货 → 发站内信）\"; st.className = \"s-status\";\n  $(\"rlResult\").innerHTML = \"\";\n  try {\n    const d = await api(\"/api/returns/create-label\", {\n      method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({\n        shop_id: GLOBAL_SHOP,\n        order_id: orderId, label_url: labelUrl, method_code: method, reason_code: reason, accepted,\n      }),\n    });\n    const langTxt = d.notice.lang === \"es\" ? \"西班牙语\" : \"德语\";\n    const noticeTxt = d.notice.note === \"sent\"\n      ? `已给买家现有对话发送站内信（${langTxt}，thread ${d.notice.thread_id}）`\n      : d.notice.note === \"sent_new\"\n      ? `该订单无现有对话，已新建对话发送站内信（${langTxt}）`\n      : `${d.notice.note || \"站内信未发送\"}`;\n    // v26.70 起面单以**附件**交付，正文里不再出现 itgoal.com 外链（见 server.js 注释）。\n    const attach = d.label_attachment || null;\n    const attachTxt = attach\n      ? `面单已作为附件随信发出：${escapeHtml(attach.file_name)}（${Math.max(1, Math.round(attach.bytes / 1024))} KB），正文不含任何外链`\n      : \"未附带面单附件\";\n    // v26.79：标签已经发到买家手上 ⇒ 问一句「要不要登记到退货登记」（与站内信链路同一口径）。\n    //   erpReturnNum 只在「一键到底」里有（先向 ERP 申请过面单），单独发标签时为空的 /\n    //   用户手填 URL 的场景拿不到，登记时物流号留空，可事后在退货登记页补。\n    const reg = await offerReturnLabelRegistration({\n      orderId: d.order.order_id || orderId,\n      trackingNo: erpReturnNum || \"\",\n      sku: (d.order && d.order.skus) || \"\",\n      shopName: d.shop.name,\n      returnId: d.return_id,\n    });\n    $(\"rlResult\").innerHTML = `<div style=\"background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px 16px;font-size:12.5px;line-height:1.9;\">\n      <div>🏪 店铺：<b>${d.shop.name}</b>（#${d.shop.shop_id}）</div>\n      <div>订单：<code style=\"font-family:Consolas,monospace\">${d.order.order_id}</code>（commercial: ${d.order.commercial_id}，${d.order.lines} 行）</div>\n      <div>🎫 退货单已创建：<b style=\"color:var(--green);font-family:Consolas,monospace\">${d.return_id}</b>（已附标签 + 自动验收，退货渠道已开启）</div>\n      <div>📎 ${attachTxt}</div>\n      <div>${noticeTxt}</div>\n      ${returnLabelRegistrationLine(reg)}\n    </div>`;\n    st.textContent = `全部完成${returnLabelRegistrationTail(reg)}`; st.className = \"s-status ok\";\n    return d;\n  } catch (e) {\n    st.textContent = \"失败：\" + e.message; st.className = \"s-status err\";\n    $(\"rlResult\").innerHTML = \"\";\n    return null;\n  }\n}\n\nasync function submitReturnLabel() {\n  const st = $(\"rlStatus\");\n  const orderId = $(\"rlOrderId\").value.trim();\n  const labelUrl = $(\"rlLabelUrl\").value.trim();\n  if (!orderId) { st.textContent = \"请输入订单号\"; st.className = \"s-status err\"; return null; }\n  if (!/^https?:\\/\\//i.test(labelUrl)) { st.textContent = \"请输入有效的标签下载 URL（http/https 开头）\"; st.className = \"s-status err\"; return null; }\n  return rlSendLabel({\n    orderId, labelUrl,\n    method: $(\"rlMethod\").value,\n    reason: $(\"rlReason\").value,\n    accepted: $(\"rlAccept\").value === \"true\",\n  });\n}\n\n// ⚡ 第一步（也可单独用）：订单号 → 向 ERP 申请退货单 → 轮询取回退货面单下载链接 → 填入「退货标签下载 URL」。\n// ⚠️ 幂等：订单已有面单时 ERP 侧**直接复用、不重复申请**。⛔ 没有「重新申请」开关：\n//    ERP 侧对已有退货单的订单不允许再次申请，做成按钮只会点出一个必然失败的操作。\n// ⚠️ 该链接**不需要任何鉴权**，可以直接发给买家（实测：裸请求 / 带 JWT / 带 Cookie 均 200 PDF）。\nasync function rlFetchErpLabel() {\n  const st = $(\"rlErpStatus\");\n  const orderId = $(\"rlOrderId\").value.trim();\n  if (!orderId) { st.textContent = \"请先填订单号\"; st.className = \"s-status err\"; return null; }\n  st.textContent = \"正在向 ERP 申请退货单…（查单 → 定国家 → 复用或申请 → 等面单生成）\";\n  st.className = \"s-status\";\n  $(\"rlErpResult\").innerHTML = \"\";\n  try {\n    const d = await api(\"/api/itgoal/apply-return\", {\n      method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ order_id: orderId }),\n    });\n    // ⚠️ v26.70：这个路由在「ERP 未配置 / 模块不可用」时返回的是 **HTTP 200 + ok:false**，\n    //    而 api() 只看 HTTP 状态码 ⇒ 不显式拦下就会渲染出一张绿灯假成功卡片，\n    //    紧接着一键到底因为拿不到 label_url 静默 return —— 同事机器上整个流程就是这么消失的。\n    if (!d || d.ok === false) {\n      const why = (d && (d.message || d.error)) || \"ERP 未返回可用结果\";\n      st.textContent = \"失败：\" + why;\n      st.className = \"s-status err\";\n      $(\"rlErpResult\").innerHTML = `<div style=\"background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px 16px;font-size:12.5px;line-height:1.9;\">\n        <div style=\"color:var(--red);font-weight:700;\">✗ 未取得 ERP 面单</div>\n        <div>${escapeHtml(String(why))}</div>\n        <div style=\"color:var(--muted);\">若提示配置未启用：工作台目录下需要有 itgoal.config.json（发布包里自带，只单独拷 exe 会漏掉）。</div>\n      </div>`;\n      return null;\n    }\n    if (!d.label_url) {\n      st.textContent = \"失败：ERP 没有返回面单链接\";\n      st.className = \"s-status err\";\n      return null;\n    }\n    const rs = d.return_shipping || {};\n    const om = d.order || {};\n    const badge = d.reused\n      ? '<span style=\"color:var(--green);font-weight:700;\">复用已有退货面单</span>'\n      : '<span style=\"color:var(--green);font-weight:700;\">新申请成功</span>';\n    $(\"rlErpResult\").innerHTML = `<div style=\"background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px 16px;font-size:12.5px;line-height:1.9;\">\n      <div>${badge} <span style=\"color:var(--muted);\">ERP 侧</span></div>\n      <div>订单：<code style=\"font-family:Consolas,monospace\">${om.platform_order_num || orderId}</code>　收货国家：<b>${om.country_code || \"-\"}</b>　仓库：${om.warehouse_id || \"-\"}</div>\n      <div>🎫 退货单号：<b style=\"color:var(--green);font-family:Consolas,monospace\">${rs.num || \"-\"}</b>　回邮渠道：${rs.name || \"-\"}（${rs.code || \"-\"}）　生成时间：${rs.time || \"-\"}</div>\n      <div>🔗 面单链接已填入下方「退货标签下载 URL」：<a href=\"${d.label_url}\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--accent);word-break:break-all;\">${d.label_url}</a></div>\n    </div>`;\n    if (d.label_url) $(\"rlLabelUrl\").value = d.label_url;\n    st.textContent = d.reused ? \"已复用已有面单\" : \"已申请到面单\";\n    st.className = \"s-status ok\";\n    return d;\n  } catch (e) {\n    st.textContent = \"失败：\" + e.message; st.className = \"s-status err\";\n    return null;\n  }\n}\n\n// ⚡ 一键到底：申请退货单 → 取面单链接 → 建退货单 → 发站内信（全程只确认一次）。\nasync function rlChainReturnLabel() {\n  const erpSt = $(\"rlErpStatus\");\n  const orderId = $(\"rlOrderId\").value.trim();\n  if (!orderId) { erpSt.textContent = \"请先填订单号\"; erpSt.className = \"s-status err\"; return null; }\n  const method = $(\"rlMethod\").value;\n  const reason = $(\"rlReason\").value;\n  const accepted = $(\"rlAccept\").value === \"true\";\n  const methodZh = (RL_METHODS.find((m) => m.code === method) || { zh: method }).zh;\n  const reasonZh = (RL_REASONS.find(([c]) => c === reason) || [\"\", reason])[1];\n  if (!confirm(`一键完成确认？\\n\\n订单：${orderId}\\n退货方式：${methodZh}\\n原因：${reasonZh}\\n\\n将依次：\\n① 向 ERP 申请退货单并取回面单链接（已有面单直接复用）\\n② 用该链接创建退货单（附标签 + 自动验收）\\n③ 给买家发送对应语言的站内信`)) return null;\n  const erp = await rlFetchErpLabel();\n  if (!erp || !erp.label_url) {\n    // v26.70：这里原来是静默 `return null`。一键到底的语义就是「一条龙做完」，\n    // 而用户已经点过「确定」了 —— 此时界面毫无变化是最糟的反馈。必须把中止原因摆出来。\n    const why = (erpSt && erpSt.textContent) || \"未取得 ERP 面单\";\n    if (erpSt) {\n      erpSt.textContent = /^失败/.test(why) ? why : \"失败：\" + why;\n      erpSt.className = \"s-status err\";\n    }\n    $(\"rlResult\").innerHTML = `<div style=\"background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px 16px;font-size:12.5px;line-height:1.9;\">\n      <div style=\"color:var(--red);font-weight:700;\">✗ 一键流程已中止：没有拿到 ERP 面单</div>\n      <div>未创建退货单、未发送任何站内信 —— 买家那边什么都不会收到。</div>\n      <div style=\"color:var(--muted);\">${escapeHtml(String(why))}</div>\n    </div>`;\n    return null;\n  }\n  // v26.79：把 ERP 回邮单号一路带到「登记到退货登记」那一步（物流号就填它）。\n  return rlSendLabel({\n    orderId, labelUrl: erp.label_url, method, reason, accepted, skipConfirm: true,\n    erpReturnNum: (erp.return_shipping && erp.return_shipping.num) || \"\",\n  });\n}\n\n// PRI01 改价结果：复查指定 SKU 的价格是否生效（PRI02 状态接口不稳定）\nasync function pollPricingImport(shopId, sku, expectOrigin, expectDisc, options = {}) {\n  const showProgress = options.showProgress !== false;\n  for (let i = 0; i < 12; i++) {\n    await new Promise((rs) => setTimeout(rs, 2500));\n    try {\n      const d = await api(`/api/offers/get?shop_id=${shopId}&sku=${encodeURIComponent(sku)}`);\n      const o = (d.offers || [])[0];\n      if (!o) continue;\n      const curOrigin = Number(o.origin_price ?? o.price);\n      const curDisc = o.discount_price === null || o.discount_price === undefined ? null : Number(o.discount_price);\n      const originOk = curOrigin === expectOrigin;\n      const discOk = expectDisc === null ? (curDisc === null || curDisc === undefined) : curDisc === expectDisc;\n      if (originOk && discOk) {\n        applyVerifiedOfferToLocalCache({\n          ...o,\n          origin_price: Number.isFinite(curOrigin) ? curOrigin : o.origin_price,\n          discount_price: curDisc,\n        });\n        renderOfferTable();\n        if (showProgress) $(\"ofResult\").innerHTML = `<div style=\"background:var(--card);border:1px solid var(--border);border-radius:10px;padding:10px 14px;font-size:12.5px;\">\n          改价已生效：原价 €${curOrigin.toFixed(2)}${curDisc !== null ? ` → 实售 €${curDisc.toFixed(2)}（-${Math.round((1 - curDisc / curOrigin) * 100)}%）` : \"（无折扣）\"}\n        </div>`;\n        return true;\n      }\n      if (showProgress) $(\"ofResult\").innerHTML = `<div style=\"background:var(--card);border:1px solid var(--border);border-radius:10px;padding:10px 14px;font-size:12.5px;\">平台处理中…（当前：原价 €${curOrigin.toFixed(2)} / 折扣价 ${curDisc !== null ? \"€\" + curDisc.toFixed(2) : \"无\"}）</div>`;\n    } catch (e) { /* 忽略轮询错误，重试 */ }\n  }\n  if (showProgress) $(\"ofResult\").innerHTML = '<div style=\"font-size:12.5px;color:var(--muted);\">改价处理超时，请稍后刷新确认</div>';\n  return false;\n}\n\nasync function fetchOffers(force) {\n  const st = $(\"ofStatus\");\n  st.textContent = force ? \"正在从平台拉取最新数据…\" : \"正在加载报价…\";\n  st.className = \"s-status\";\n  try {\n    const d = await api(\"/api/offers/fetch\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ shop_id: $(\"ofShop\").value, force: !!force }),\n    });\n    if (d.offers) {\n      // 命中缓存 → 直接渲染\n      applyOffers(d);\n      if (d.running) {\n        // 显示的是上一版结果，后台正在拉最新 → 拉完自动切换\n        st.textContent = `已显示上次结果（${d.total} 条${d.cached_at ? \" · \" + fmtTime(d.cached_at) : \"\"}），后台正在拉取最新数据…`;\n        st.className = \"s-status\";\n        pollOfferJob(true);\n      }\n      return;\n    }\n    // 后台任务 → 轮询进度\n    pollOfferJob(false);\n  } catch (e) {\n    st.textContent = \"加载失败：\" + e.message;\n    st.className = \"s-status err\";\n  }\n}\n\nfunction applyOffers(d) {\n  const st = $(\"ofStatus\");\n  OFFERS = d.offers || [];\n  OFFER_DIRTY.clear();\n  OFFER_STATES = [];\n  renderOfferTable();\n  // 先显示表格，再异步同步 OF61 字典并重绘；加载失败时也不泄露内部 code。\n  loadOfferStates().then(() => { if (OFFERS.length) renderOfferTable(); });\n  // v26.48：本地历史记录（磁盘快照，可能是几天前的）必须显著标出时间，\n  // 否则用户会以为在看最新数据，改价时带入过期的 state_code / price。\n  const cachedNote = !d.cached ? \"\" : (d.from_disk\n    ? `（本地历史记录${d.cached_at ? \" · \" + fmtTime(d.cached_at) : \"\"}，非最新）`\n    : \"（来自缓存）\");\n  st.textContent = `已加载 ${d.total} 个报价${cachedNote}`;\n  st.className = d.from_disk ? \"s-status warn\" : \"s-status ok\";\n}\n\nfunction applyVerifiedOfferToLocalCache(verifiedOffer) {\n  const sku = String(verifiedOffer && verifiedOffer.shop_sku || \"\").trim();\n  if (!sku) return false;\n  const local = OFFERS.find((offer) => String(offer.shop_sku || \"\").trim() === sku);\n  if (!local) return false;\n  Object.assign(local, verifiedOffer);\n  return true;\n}\n\n// 后台拉取进度轮询（大店铺分页可能数分钟，实时显示进度）\n// autoApply=true：拉完后自动切换到最新数据（若有未保存修改则只提示）\nasync function pollOfferJob(autoApply) {\n  const st = $(\"ofStatus\");\n  const shopId = $(\"ofShop\").value;\n  while (true) {\n    await new Promise((rs) => setTimeout(rs, 1200));\n    let s = null;\n    try {\n      s = await api(`/api/offers/fetch-status?shop_id=${shopId}`);\n    } catch (e) { continue; }\n    const state = s.state || (s.running ? \"running\" : (s.error ? \"failed\" : \"complete\"));\n    if (state === \"failed\") {\n      st.textContent = \"拉取失败：\" + (s.lastError || s.error || \"请重试\");\n      st.className = \"s-status err\";\n      return;\n    }\n    if (state === \"partial\") {\n      const viaTxt = s.via === \"pagination\" ? \"分页拉取\" : \"平台导出\";\n      const detail = s.total > 0 ? `已获取 ${s.loaded} / ${s.total}` : \"已获取部分数据\";\n      const hint = s.resumable ? \"可稍后重试继续拉取\" : \"请稍后重试\";\n      st.textContent = `拉取部分完成（${viaTxt}）：${detail}${s.lastError ? `，原因：${s.lastError}` : \"\"}；${hint}`;\n      st.className = \"s-status err\";\n      return;\n    }\n    if (state === \"complete\") {\n      // 完成 → 取回结果\n      try {\n        const d = await api(\"/api/offers/fetch\", {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\" },\n          body: JSON.stringify({ shop_id: shopId }),\n        });\n        if (!d.offers) {\n          st.textContent = \"拉取完成但读取结果失败，请重试\";\n          st.className = \"s-status err\";\n        } else if (autoApply && OFFER_DIRTY.size > 0) {\n          // 有未保存的编辑：不自动覆盖，提示手动刷新\n          st.textContent = `新数据已就绪（${d.total} 条）。有未保存的修改，保存后再点「加载全部报价」即可切换`;\n          st.className = \"s-status ok\";\n        } else {\n          applyOffers(d);\n          st.textContent = `已更新为最新数据（${d.total} 条）`;\n          st.className = \"s-status ok\";\n        }\n      } catch (e) {\n        st.textContent = \"读取结果失败：\" + e.message;\n        st.className = \"s-status err\";\n      }\n      return;\n    }\n    const pr = s.progress || s || {};\n    const viaTxt = pr.via === \"pagination\" ? \"分页拉取\" : \"平台导出\";\n    if (pr.total > 0 && pr.totalPages > 1) {\n      st.textContent = `拉取中… ${pr.loaded} / ${pr.total}（第 ${pr.page}/${pr.totalPages} 页 · ${viaTxt}）`;\n    } else if (pr.total > 0) {\n      st.textContent = `拉取中… ${pr.loaded} / ${pr.total}（${viaTxt}）`;\n    } else {\n      st.textContent = `正在从平台获取数据（${viaTxt}）…`;\n    }\n  }\n}\n\nasync function loadOfferStates() {\n  try {\n    const d = await api(`/api/offers/states?shop_id=${$(\"ofShop\").value}`);\n    OFFER_STATES = (d.states || d.offer_states || []).map(normalizeOfferState).filter(Boolean);\n  } catch (e) { OFFER_STATES = []; }\n  return OFFER_STATES;\n}\n\n// 报价的「是否可售」三态：1=可售 / 0=不可售 / null=未知。\n// ⛔ 缺失必须落在 null —— 与 offer-radar / offline-monitor 同一条纪律：**「没拿到数据」不等于「不可售」**，\n//    否则一份不带 active 列的导出会把整店报价刷成「掉线」，反而制造假警报。\nfunction offerActiveFlag(offer) {\n  if (!offer) return null;\n  if (offer.active === true) return 1;\n  if (offer.active === false) return 0;\n  return null;\n}\n\nfunction offerActiveCell(offer) {\n  const flag = offerActiveFlag(offer);\n  if (flag === 1) return `<span style=\"color:var(--green);\">可售</span>`;\n  if (flag === 0) return `<span style=\"color:var(--red);\" title=\"平台把这条报价置为不可售（常见于库存归零）\">不可售</span>`;\n  return `<span style=\"color:var(--muted);\" title=\"这次拉取没拿到 active 值，不代表不可售\">未知</span>`;\n}\n\nfunction filteredOffers() {\n  const filterEl = $(\"ofActiveFilter\");\n  const mode = filterEl && filterEl.value ? filterEl.value : \"all\";\n  let list = OFFERS;\n  if (mode !== \"all\") {\n    // 「仅未知」要匹配 null，其余两种匹配 0/1 —— 三者互不混淆\n    const want = mode === \"active\" ? 1 : mode === \"inactive\" ? 0 : null;\n    list = list.filter((o) => {\n      const flag = offerActiveFlag(o);\n      return want === null ? flag === null : flag === want;\n    });\n  }\n  const kw = ($(\"ofSearch\") || {}).value ? $(\"ofSearch\").value.trim().toLowerCase() : \"\";\n  if (!kw) return list;\n  return list.filter((o) =>\n    String(o.shop_sku || \"\").toLowerCase().includes(kw) ||\n    String(o.product_sku || \"\").toLowerCase().includes(kw) ||\n    String(o.product_title || \"\").toLowerCase().includes(kw)\n  );\n}\n\nfunction renderOfferTable() {\n  const filtered = filteredOffers();\n  const list = filtered.slice(0, 300);\n  // 全量口径的小计：一眼看出「有不可售的但没被藏起来」\n  let inactiveCount = 0, unknownCount = 0;\n  for (const o of OFFERS) {\n    const flag = offerActiveFlag(o);\n    if (flag === 0) inactiveCount += 1;\n    else if (flag === null) unknownCount += 1;\n  }\n  const tally = (inactiveCount ? ` · 不可售 ${inactiveCount} 条` : \"\") + (unknownCount ? ` · 状态未知 ${unknownCount} 条` : \"\");\n  const box = $(\"ofTable\");\n  if (OFFERS.length === 0) {\n    box.innerHTML = '<div class=\"carrier-empty\" style=\"padding:30px;\">点击「加载全部报价」拉取该店铺的全部报价</div>';\n    $(\"btnOfSave\").style.display = \"none\";\n    return;\n  }\n  if (list.length === 0) {\n    box.innerHTML = '<div class=\"carrier-empty\" style=\"padding:30px;\">未找到匹配的报价</div>';\n    return;\n  }\n  const stateOpts = (cur) => {\n    const current = cur === undefined || cur === null ? \"\" : String(cur);\n    const known = OFFER_STATES.some((s) => String(s.code) === current);\n    const escapeAttr = (value) => escapeHtml(value).replace(/\"/g, \"&quot;\");\n    const currentOption = current && !known\n      ? `<option value=\"${escapeAttr(current)}\" selected>${escapeHtml(offerStateLabel(current))}</option>`\n      : \"\";\n    const options = OFFER_STATES.map((s) =>\n      `<option value=\"${escapeAttr(s.code)}\" ${String(s.code) === current ? \"selected\" : \"\"}>${escapeHtml(s.label)}</option>`\n    ).join(\"\");\n    return currentOption + options || `<option value=\"\" selected>成色状态待同步</option>`;\n  };\n  const inpStyle = \"padding:4px 6px;font-size:12px;background:var(--card2);color:var(--text);border:1px solid var(--border);border-radius:6px;\";\n  box.innerHTML = `<table class=\"line-tbl\"><thead><tr>\n    <th style=\"min-width:170px\">SKU</th>\n    <th style=\"width:78px\">可售</th>\n    <th class=\"num\" style=\"width:110px\">原价(划线) €</th>\n    <th class=\"num\" style=\"width:110px\">折扣价(实售) €</th>\n    <th class=\"num\" style=\"width:64px\">折扣</th>\n    <th class=\"num\" style=\"width:84px\">库存</th>\n    <th style=\"width:150px\">成色</th>\n    <th class=\"num\" style=\"width:70px\">时效(天)</th>\n    <th style=\"width:48px\"></th>\n  </tr></thead><tbody>${\n    list.map((o) => {\n      const dirty = OFFER_DIRTY.has(o.shop_sku);\n      return `<tr data-sku=\"${o.shop_sku}\" style=\"${dirty ? \"background:var(--green-08)\" : \"\"}\">\n        <td style=\"font-family:Consolas,monospace;font-size:11.5px\" title=\"${o.shop_sku}\">${(o.shop_sku || \"\").slice(0, 32)}</td>\n        <td style=\"font-size:11.5px\">${offerActiveCell(o)}</td>\n        <td class=\"num\"><input type=\"number\" step=\"0.01\" class=\"of-inp of-origin\" value=\"${o.origin_price !== null && o.origin_price !== undefined ? o.origin_price : \"\"}\" placeholder=\"必填\" style=\"width:96px;${inpStyle}\"></td>\n        <td class=\"num\"><input type=\"number\" step=\"0.01\" class=\"of-inp of-disc\" value=\"${o.discount_price !== null && o.discount_price !== undefined ? o.discount_price : \"\"}\" placeholder=\"留空=无折扣\" style=\"width:96px;${inpStyle};border-color:var(--green)\"></td>\n        <td class=\"num of-pct\" style=\"font-size:11px;color:var(--muted)\">—</td>\n        <td class=\"num\"><input type=\"number\" step=\"1\" class=\"of-inp of-qty\" value=\"${o.quantity}\" style=\"width:70px;${inpStyle}\"></td>\n        <td><select class=\"of-inp of-state\" aria-label=\"成色状态\" style=\"width:142px;${inpStyle}\">${stateOpts(o.state_code)}</select></td>\n        <td class=\"num\"><input type=\"number\" step=\"1\" class=\"of-inp of-lead\" value=\"${o.leadtime_to_ship === null || o.leadtime_to_ship === undefined ? \"\" : o.leadtime_to_ship}\" style=\"width:58px;${inpStyle}\"></td>\n        <td>${dirty ? '<span style=\"color:var(--green);font-size:11px\">已改</span>' : \"\"}</td>\n      </tr>`;\n    }).join(\"\")}</tbody></table>\n    <div style=\"padding:8px 12px;font-size:11.5px;color:var(--muted);\">\n      显示 ${list.length} / 匹配 ${filtered.length} / 共 ${OFFERS.length} 个报价${tally}${filtered.length > 300 ? \"（仅显示前 300 条，请细化搜索或按可售状态筛选）\" : \"\"}\n      · 改价（原价/折扣价）走价格导入，库存/成色/时效走报价导入，保存时自动分流\n    </div>`;\n\n  // 编辑监听\n  const refreshPct = (tr) => {\n    const op = Number(tr.querySelector(\".of-origin\").value || 0);\n    const dp = tr.querySelector(\".of-disc\").value === \"\" ? null : Number(tr.querySelector(\".of-disc\").value);\n    const cell = tr.querySelector(\".of-pct\");\n    if (dp !== null && op > 0 && op > dp) {\n      cell.textContent = \"-\" + Math.round((1 - dp / op) * 100) + \"%\";\n      cell.style.color = \"var(--red)\";\n    } else if (dp !== null && op > 0 && op <= dp) {\n      cell.textContent = \"无效\";\n      cell.style.color = \"var(--red)\";\n    } else {\n      cell.textContent = \"—\";\n      cell.style.color = \"var(--muted)\";\n    }\n  };\n  box.querySelectorAll(\"tbody tr\").forEach((tr) => {\n    const sku = tr.dataset.sku;\n    const orig = OFFERS.find((o) => o.shop_sku === sku);\n    refreshPct(tr);\n    const handler = () => {\n      const origin = Number(tr.querySelector(\".of-origin\").value || 0);\n      const disc = tr.querySelector(\".of-disc\").value === \"\" ? null : Number(tr.querySelector(\".of-disc\").value);\n      const qty = Number(tr.querySelector(\".of-qty\").value);\n      const state = tr.querySelector(\".of-state\").value;\n      const lead = tr.querySelector(\".of-lead\").value;\n      const origOrigin = orig.origin_price === null || orig.origin_price === undefined ? orig.price : orig.origin_price;\n      const priceChanged = origin !== Number(origOrigin) || disc !== (orig.discount_price === undefined ? null : orig.discount_price);\n      const otherChanged =\n        qty !== Number(orig.quantity) ||\n        String(state) !== String(orig.state_code) ||\n        (lead !== \"\" && Number(lead) !== Number(orig.leadtime_to_ship));\n      refreshPct(tr);\n      if (disc !== null && origin <= disc) {\n        // 无效配置不记录\n      } else if (priceChanged || otherChanged) {\n        OFFER_DIRTY.set(sku, {\n          shop_sku: sku,\n          origin, discount: disc,\n          quantity: qty,\n          state_code: state,\n          leadtime_to_ship: lead === \"\" ? orig.leadtime_to_ship : Number(lead),\n          logistic_class: orig.logistic_class,\n          min_quantity_alert: orig.min_quantity_alert,\n          _priceChanged: priceChanged, _otherChanged: otherChanged,\n        });\n      } else {\n        OFFER_DIRTY.delete(sku);\n      }\n      $(\"btnOfSave\").style.display = OFFER_DIRTY.size > 0 ? \"\" : \"none\";\n      $(\"btnOfSave\").textContent = `保存修改（${OFFER_DIRTY.size}）`;\n      tr.style.background = OFFER_DIRTY.has(sku) ? \"var(--green-08)\" : \"\";\n      const cell = tr.lastElementChild;\n      if (cell) cell.innerHTML = OFFER_DIRTY.has(sku) ? '<span style=\"color:var(--green);font-size:11px\">已改</span>' : \"\";\n    };\n    tr.querySelectorAll(\".of-inp\").forEach((el) => {\n      el.addEventListener(\"input\", handler);\n      el.addEventListener(\"change\", handler);\n    });\n  });\n  $(\"btnOfSave\").style.display = OFFER_DIRTY.size > 0 ? \"\" : \"none\";\n  if (OFFER_DIRTY.size > 0) $(\"btnOfSave\").textContent = `保存修改（${OFFER_DIRTY.size}）`;\n}\n\nasync function saveOffers() {\n  const items = Array.from(OFFER_DIRTY.values());\n  if (items.length === 0) return;\n  const st = $(\"ofStatus\");\n  const shopId = $(\"ofShop\").value;\n  // ⛔ OF24 是覆盖式导入且**必清折扣**（API.md §12：discount 字段 8 种组合全被平台静默忽略，\n  //    且不带折扣字段会清空已有折扣/划线原价）。凡带折扣的行 —— 哪怕只改了库存/成色/时效 ——\n  //    都必须在 OF24 之后**补一道 PRI01** 重申「原价+折扣」，否则折扣被静默清掉\n  //    （v26.105 实锤事故：XSY330-GreenEU 折扣 29.69 被清、基础价被写成 29.69）。\n  const priceItems = items.filter((x) => x._priceChanged || (x.discount !== null && x.discount !== undefined))\n    .map((x) => ({ shop_sku: x.shop_sku, price: x.origin, discount_price: x.discount }));\n  const updateItems = items.filter((x) => x._otherChanged).map((x) => ({\n    shop_sku: x.shop_sku,\n    // ⛔ OF24 的 price = **基础价（原价）**，绝不许填折扣值 —— 最终价格由随后的 PRI01 一锤定音。\n    price: x.origin,\n    quantity: x.quantity,\n    state_code: x.state_code,\n    leadtime_to_ship: x.leadtime_to_ship,\n    logistic_class: x.logistic_class,\n    min_quantity_alert: x.min_quantity_alert,\n  }));\n  let msg = `确认保存 ${items.length} 个报价的修改？\\n\\n`;\n  if (priceItems.length) msg += `· 改价 ${priceItems.length} 个（价格导入接口，约数秒生效）\\n`;\n  if (updateItems.length) msg += `· 改库存/成色/时效 ${updateItems.length} 个（报价导入接口）\\n`;\n  if (!confirm(msg)) return;\n\n  st.textContent = \"提交中…\"; st.className = \"s-status\";\n  try {\n    // ⛔ 顺序铁律：**先 OF24（库存/成色/时效）→ 后 PRI01（价格）**。\n    //    OF24 必清折扣，只有 PRI01 能写折扣 —— 价格导入必须最后做，\n    //    否则 PRI01 刚写好的折扣会被随后的 OF24 静默清掉（v26.105 实锤事故）。\n    // 1. 其他字段 → OF24\n    if (updateItems.length) {\n      const d = await api(\"/api/offers/update\", {\n        method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ shop_id: shopId, items: updateItems }),\n      });\n      $(\"ofResult\").innerHTML = `<div style=\"background:var(--card);border:1px solid var(--border);border-radius:10px;padding:10px 14px;font-size:12.5px;\">库存/成色/时效修改 ${updateItems.length} 个已提交（导入 ID <code>${d.import_id}</code>）</div>`;\n      pollOfferImport(d.import_id);\n    }\n    // 2. 改价 → PRI01（最后提交：价格 + 折扣一锤定音）\n    if (priceItems.length) {\n      const d = await api(\"/api/offers/pricing\", {\n        method: \"POST\", headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ shop_id: shopId, items: priceItems }),\n      });\n      $(\"ofResult\").innerHTML += `<div style=\"background:var(--card);border:1px solid var(--border);border-radius:10px;padding:10px 14px;font-size:12.5px;margin-top:8px;\">改价 ${priceItems.length} 个已提交（导入 ID <code>${d.import_id}</code>），确认生效中…</div>`;\n      const pricingResults = await Promise.all(priceItems.map((item) => pollPricingImport(\n        shopId,\n        item.shop_sku,\n        Number(item.price),\n        item.discount_price === \"\" || item.discount_price === null || item.discount_price === undefined ? null : Number(item.discount_price),\n        { showProgress: false },\n      )));\n      const pricingOk = pricingResults.every(Boolean);\n      const pricingSuccessCount = pricingResults.filter(Boolean).length;\n      if (pricingOk) {\n        st.textContent = \"保存成功\"; st.className = \"s-status ok\";\n        $(\"ofResult\").innerHTML += `<div style=\"background:var(--card);border:1px solid var(--border);border-radius:10px;padding:10px 14px;font-size:12.5px;margin-top:8px;\">改价已全部生效：${pricingSuccessCount}/${priceItems.length} 个报价已同步缓存</div>`;\n      } else {\n        st.textContent = `改价已提交，${pricingSuccessCount}/${priceItems.length} 个已确认生效`;\n        st.className = \"s-status warn\";\n        $(\"ofResult\").innerHTML += `<div style=\"background:var(--card);border:1px solid var(--border);border-radius:10px;padding:10px 14px;font-size:12.5px;margin-top:8px;color:var(--amber);\">改价已提交，${pricingSuccessCount}/${priceItems.length} 个已确认生效。⚠️ 未确认的行请「刷新报价」核对：没生效就重新保存一次（改价导入偶发会在平台侧丢失）</div>`;\n      }\n    }\n    OFFER_DIRTY.clear();\n    renderOfferTable();\n  } catch (e) {\n    st.textContent = \"提交失败：\" + e.message;\n    st.className = \"s-status err\";\n  }\n}\n\n// importId 是 OF24 报价导入的 UUID。\n// v26.102：shopId 与两个状态元素都可传入 —— 「按商品SKU 查全店报价」子页面提交时用的是\n// **它自己**的店铺与状态位，不能再用 `$(\"ofShop\")`（那是子模块①的店铺选择器，值可能是另一家店）。\n// ⛔ 清 OFFER_DIRTY 只在不传 statusEl（= 旧的、来自「报价管理」的调用）时做：\n//    跨子模块清脏表会把用户在另一个子页面里没保存的编辑悄悄抹掉。\nasync function pollOfferImport(importId, shopIdArg, statusElArg, resultElArg) {\n  const shopId = shopIdArg || $(\"ofShop\").value;\n  const statusEl = statusElArg === undefined ? $(\"ofStatus\") : statusElArg;\n  const resultEl = resultElArg === undefined ? $(\"ofResult\") : resultElArg;\n  const fromManagePane = statusElArg === undefined;\n  for (let i = 0; i < 20; i++) {\n    await new Promise((rs) => setTimeout(rs, 2500));\n    try {\n      const s = await api(`/api/offers/import?shop_id=${shopId}&import_id=${importId}`);\n      if (s.status === \"COMPLETE\" || s.status === \"FAILED\") {\n        const errHtml = (s.errors || []).length\n          ? `<div style=\"margin-top:8px;color:var(--red);\">${s.errors.map((e) => `行 ${e.row}: ${e.message}`).join(\"<br>\")}</div>`\n          : \"\";\n        if (resultEl) resultEl.innerHTML = `<div style=\"background:var(--card);border:1px solid var(--border);border-radius:10px;padding:12px 14px;font-size:12.5px;\">\n          处理完成：<span style=\"color:var(--green)\">成功 ${s.lines_in_success}</span> · <span style=\"color:var(--red)\">失败 ${s.lines_in_error}</span> · 更新 ${s.offer_updated} · 新增 ${s.offer_inserted}\n          ${errHtml}\n        </div>`;\n        if (statusEl) {\n          statusEl.textContent = s.lines_in_error === 0 ? \"全部修改成功\" : `有 ${s.lines_in_error} 条失败`;\n          statusEl.className = s.lines_in_error === 0 ? \"s-status ok\" : \"s-status err\";\n        }\n        if (s.lines_in_error === 0 && fromManagePane) { OFFER_DIRTY.clear(); renderOfferTable(); }\n        return;\n      }\n      if (resultEl) resultEl.innerHTML = `<div style=\"background:var(--card);border:1px solid var(--border);border-radius:10px;padding:12px 14px;font-size:12.5px;\">平台处理中…（${s.status}）</div>`;\n    } catch (e) {\n      if (resultEl) resultEl.innerHTML = `<div style=\"color:var(--red);font-size:12.5px;\">查询失败：${e.message}</div>`;\n      return;\n    }\n  }\n  if (resultEl) resultEl.innerHTML = '<div style=\"font-size:12.5px;color:var(--muted);\">处理超时，请稍后手动查询导入结果</div>';\n}\n\n// ---- 发货模块（OR23 回传跟踪号）----\nlet CARRIERS = [];\nlet SELECTED_CARRIER = null;\n\nfunction initShipPage() {\n  const box = $(\"pageShip\");\n  if (box.dataset.ready === \"1\") return;\n  box.dataset.ready = \"1\";\n  box.innerHTML = `<div class=\"ship operation-shell\">\n    <header class=\"operation-header\"><h2>发货</h2>\n    <div class=\"s-sub\" id=\"shipShopTag\"></div></header>\n    <div class=\"r-tabs\" style=\"margin-bottom:16px;\">\n      <span class=\"rt active\" data-st=\"single\">单包裹发货（整单一个运单）</span>\n      <span class=\"rt\" data-st=\"multi\">多包裹发货（一单拆多个包裹）</span>\n    </div>\n\n    <!-- ===== 多包裹发货 ===== -->\n    <div id=\"shipMulti\" class=\"hidden\">\n      <div class=\"s-form\" style=\"margin-bottom:16px;\">\n        <div class=\"s-field\">\n          <label>店铺</label>\n          <select id=\"mpShop\" class=\"s-input\"></select>\n        </div>\n        <div class=\"s-field\" style=\"display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap;\">\n          <div style=\"flex:1; min-width:220px;\">\n            <label>订单号</label>\n            <input id=\"mpOrderId\" class=\"s-input\" placeholder=\"01125_322626379-A（可不带 -A）\">\n          </div>\n          <button class=\"btn primary\" id=\"btnMpLookup\">查询订单</button>\n        </div>\n        <span class=\"s-status\" id=\"mpLookupStatus\"></span>\n      </div>\n\n      <div id=\"mpPackages\"></div>\n\n      <div class=\"s-form hidden\" id=\"mpActions\">\n        <div class=\"s-actions\">\n          <button class=\"btn\" id=\"btnMpAddPkg\">＋ 添加包裹</button>\n          <button class=\"btn primary\" id=\"btnMpSubmit\" style=\"margin-left:auto;\">确认多包裹发货</button>\n        </div>\n        <span class=\"s-status\" id=\"mpStatus\"></span>\n      </div>\n\n      <div class=\"s-form hidden\" id=\"mpResult\">\n        <h3 style=\"font-size:14px;font-weight:600;margin-bottom:10px;\">执行结果</h3>\n        <div id=\"mpResultBody\" style=\"font-size:12.5px;\"></div>\n      </div>\n    </div>\n\n    <!-- ===== 单包裹发货 ===== -->\n    <div id=\"shipSingle\">\n    <div class=\"s-form\">\n      <div class=\"s-field\" id=\"shShopWrap\">\n        <label>店铺</label>\n        <select id=\"shShop\" class=\"s-input\"></select>\n      </div>\n      <div class=\"s-field\">\n        <label>订单号</label>\n        <input id=\"shOrderId\" class=\"s-input\" placeholder=\"01125_322626379-A（可不带 -A）\">\n      </div>\n      <div class=\"s-field carrier-picker\">\n        <label>承运商（支持搜索：输入 DHL / DPD / GLS…）</label>\n        <input id=\"shCarrierSearch\" class=\"s-input\" placeholder=\"点击选择或输入搜索，如 DHL\" autocomplete=\"off\">\n        <div class=\"carrier-drop\" id=\"shCarrierDrop\" style=\"display:none;\"></div>\n        <div id=\"shCarrierSel\" style=\"margin-top:8px;font-size:12.5px;color:var(--green);\"></div>\n      </div>\n      <div class=\"s-field\">\n        <label>物流单号（Tracking Number）</label>\n        <input id=\"shTracking\" class=\"s-input\" placeholder=\"如 00340434161094042549\">\n        <div class=\"url-preview\" id=\"shUrlPreview\" style=\"display:none;\">\n          <div class=\"up-label\">平台将使用的查询链接（请核实）</div>\n          <div class=\"up-url\" id=\"shUrlText\"></div>\n        </div>\n      </div>\n      <div class=\"s-field\" id=\"shCustomWrap\" style=\"display:none;\">\n        <label>自定义承运商名称</label>\n        <input id=\"shCarrierName\" class=\"s-input\" placeholder=\"如：Local Courier\">\n        <label style=\"margin-top:10px;\">查询链接 URL（选填）</label>\n        <input id=\"shCarrierUrl\" class=\"s-input\" placeholder=\"https://example.com/track?num=xxx\">\n      </div>\n      <div class=\"s-actions\">\n        <button class=\"btn primary\" id=\"btnShipSubmit\">确认发货</button>\n        <span class=\"s-status\" id=\"shStatus\"></span>\n      </div>\n    </div>\n    </div>\n  </div>`;\n\n  $(\"shCarrierSearch\").addEventListener(\"focus\", () => { renderCarrierDrop(\"\"); $(\"shCarrierDrop\").style.display = \"block\"; });\n  $(\"shCarrierSearch\").addEventListener(\"input\", (e) => { renderCarrierDrop(e.target.value); $(\"shCarrierDrop\").style.display = \"block\"; });\n  document.addEventListener(\"click\", (e) => {\n    if (!e.target.closest(\".carrier-picker\")) $(\"shCarrierDrop\").style.display = \"none\";\n  });\n  $(\"shTracking\").addEventListener(\"input\", updateUrlPreview);\n  $(\"btnShipSubmit\").addEventListener(\"click\", submitShip);\n  $(\"shShop\").innerHTML = SHOPS.map((s) => `<option value=\"${s.shop_id}\">${s.name}</option>`).join(\"\");\n  $(\"shShop\").value = GLOBAL_SHOP;\n  $(\"shShop\").addEventListener(\"change\", () => { CARRIERS = []; loadCarriers(); });\n  // 多包裹：店铺下拉与事件\n  $(\"mpShop\").innerHTML = SHOPS.map((s) => `<option value=\"${s.shop_id}\">${s.name}</option>`).join(\"\");\n  $(\"mpShop\").value = GLOBAL_SHOP;\n  $(\"mpShop\").addEventListener(\"change\", () => { CARRIERS = []; loadCarriers(); });\n  $(\"btnMpLookup\").addEventListener(\"click\", mpLookup);\n  $(\"btnMpAddPkg\").addEventListener(\"click\", mpAddPackage);\n  $(\"btnMpSubmit\").addEventListener(\"click\", mpSubmit);\n  // 单/多包裹切换\n  document.querySelectorAll(\".r-tabs .rt[data-st]\").forEach((el) => {\n    el.addEventListener(\"click\", () => {\n      const st = el.dataset.st;\n      document.querySelectorAll(\".r-tabs .rt[data-st]\").forEach((x) => x.classList.toggle(\"active\", x === el));\n      $(\"shipSingle\").classList.toggle(\"hidden\", st !== \"single\");\n      $(\"shipMulti\").classList.toggle(\"hidden\", st !== \"multi\");\n    });\n  });\n  loadCarriers();\n}\n\nasync function loadCarriers() {\n  const shopId = GLOBAL_SHOP;\n  if (!shopId) return;\n  try {\n    const d = await api(`/api/shipping-carriers?shop_id=${shopId}`);\n    CARRIERS = d.carriers || [];\n  } catch (e) {\n    CARRIERS = [];\n  }\n}\n\nfunction renderCarrierDrop(keyword) {\n  const drop = $(\"shCarrierDrop\");\n  const kw = (keyword || \"\").trim().toLowerCase();\n  let list = CARRIERS;\n  if (kw) {\n    list = CARRIERS.filter((c) =>\n      (c.zh_label || \"\").toLowerCase().includes(kw) ||\n      (c.label || \"\").toLowerCase().includes(kw) ||\n      (c.code || \"\").toLowerCase().includes(kw));\n  }\n  // 自定义选项置顶\n  const rows = [`<div class=\"carrier-opt\" data-code=\"OTHER\"><span class=\"co-zh\">其他 / 自定义承运商</span><span class=\"co-code\">OTHER</span></div>`];\n  if (list.length === 0) {\n    rows.push('<div class=\"carrier-empty\">未找到匹配的承运商</div>');\n  } else {\n    // 常用（德区）优先\n    const preferred = [\"DHL\", \"dhl-express\", \"DPD\", \"gls-de\", \"Hermes\", \"DPAG\", \"UPS\"];\n    list.sort((a, b) => {\n      const ia = preferred.indexOf(a.code), ib = preferred.indexOf(b.code);\n      if (ia !== -1 || ib !== -1) return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib);\n      return (a.zh_label || \"\").localeCompare(b.zh_label || \"\");\n    });\n    for (const c of list.slice(0, 60)) {\n      rows.push(`<div class=\"carrier-opt\" data-code=\"${c.code}\">\n        <span class=\"co-zh\">${c.zh_label || c.label}</span>\n        <span class=\"co-code\">${c.label !== c.zh_label ? c.label + \" · \" : \"\"}${c.code}</span>\n      </div>`);\n    }\n  }\n  drop.innerHTML = rows.join(\"\");\n  drop.querySelectorAll(\".carrier-opt\").forEach((el) => {\n    el.addEventListener(\"click\", () => selectCarrier(el.dataset.code));\n  });\n}\n\nfunction selectCarrier(code) {\n  $(\"shCarrierDrop\").style.display = \"none\";\n  if (code === \"OTHER\") {\n    SELECTED_CARRIER = { code: \"OTHER\", zh_label: \"其他 / 自定义承运商\", tracking_url: null };\n    $(\"shCarrierSearch\").value = \"\";\n    $(\"shCarrierSel\").textContent = \"已选择：其他 / 自定义承运商（需填写名称与查询链接）\";\n    $(\"shCustomWrap\").style.display = \"block\";\n    $(\"shUrlPreview\").style.display = \"none\";\n  } else {\n    const c = CARRIERS.find((x) => x.code === code);\n    if (!c) return;\n    SELECTED_CARRIER = c;\n    $(\"shCarrierSearch\").value = \"\";\n    $(\"shCarrierSel\").textContent = `已选择：${c.zh_label}（${c.label} · ${c.code}）`;\n    $(\"shCustomWrap\").style.display = \"none\";\n    updateUrlPreview();\n  }\n}\n\nfunction updateUrlPreview() {\n  const num = ($(\"shTracking\") || {}).value ? $(\"shTracking\").value.trim() : \"\";\n  const pv = $(\"shUrlPreview\");\n  if (!SELECTED_CARRIER || SELECTED_CARRIER.code === \"OTHER\" || !SELECTED_CARRIER.tracking_url) {\n    if (pv) pv.style.display = \"none\";\n    return;\n  }\n  if (!num) {\n    pv.style.display = \"block\";\n    $(\"shUrlText\").textContent = SELECTED_CARRIER.tracking_url + \"   ← 填入物流单号后自动补全\";\n    return;\n  }\n  const url = SELECTED_CARRIER.tracking_url.replace(/\\{trackingId\\}/g, encodeURIComponent(num));\n  pv.style.display = \"block\";\n  $(\"shUrlText\").innerHTML = `<a href=\"${url}\" target=\"_blank\">${url}</a>` + (SELECTED_CARRIER.tracking_url.includes(\"{trackingId}\") ? \"\" : \"（该承运商链接不含单号参数）\");\n}\n\nasync function submitShip() {\n  const st = $(\"shStatus\");\n  const orderId = $(\"shOrderId\").value.trim();\n  const tracking = $(\"shTracking\").value.trim();\n  if (!orderId) { st.textContent = \"请输入订单号\"; st.className = \"s-status err\"; return; }\n  if (!SELECTED_CARRIER) { st.textContent = \"请选择承运商\"; st.className = \"s-status err\"; return; }\n  if (SELECTED_CARRIER.code !== \"OTHER\" && !tracking) {\n    st.textContent = \"请输入物流单号\"; st.className = \"s-status err\"; return;\n  }\n  const payload = {\n    shop_id: $(\"shShop\").value,\n    order_id: orderId,\n    carrier_code: SELECTED_CARRIER.code === \"OTHER\" ? \"OTHER\" : SELECTED_CARRIER.code,\n    tracking_number: tracking,\n  };\n  if (SELECTED_CARRIER.code === \"OTHER\") {\n    payload.carrier_name = $(\"shCarrierName\").value.trim();\n    payload.carrier_url = $(\"shCarrierUrl\").value.trim();\n    if (!payload.carrier_name) { st.textContent = \"请填写自定义承运商名称\"; st.className = \"s-status err\"; return; }\n  }\n  const confirmMsg = `确认发货？\\n\\n订单：${orderId}\\n承运商：${SELECTED_CARRIER.zh_label}\\n物流单号：${tracking || \"（无）\"}\\n${payload.carrier_url ? \"查询链接：\" + payload.carrier_url : \"\"}\\n\\n提交后平台将标记该订单为已发货。`;\n  if (!confirm(confirmMsg)) return;\n\n  st.textContent = \"提交中…\"; st.className = \"s-status\";\n  try {\n    const d = await api(\"/api/ship\", { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify(payload) });\n    const sc = d.ship_confirm || {};\n    st.textContent = sc.ok === false\n      ? `跟踪号已回传（订单 ${d.order_id}），但标记发货失败：${sc.error || \"HTTP \" + sc.status}`\n      : `发货成功（订单 ${d.order_id} · 跟踪号已回传 + 已标记发货）`;\n    st.className = sc.ok === false ? \"s-status err\" : \"s-status ok\";\n  } catch (e) {\n    st.textContent = \"发货失败：\" + e.message;\n    st.className = \"s-status err\";\n  }\n}\n\n// ---- 页面导航 ----\n/* ==================== AI 任务桥 ====================\n * 前端只做三件事：下发任务、轮询状态、把结果显示出来。\n * 真正的执行在后端 server.js 的 AI 任务桥模块里，它去调本机 CodeBuddy CLI。\n */\nconst AGENT_PRESETS = [\n  { label: \"自检：CLI 是否可用\", prompt: \"只输出一行 AGENT_BRIDGE_OK，不要调用任何工具，不要解释。\" },\n  { label: \"拉取 ERP 昨日订单导出\", prompt: \"使用 itgoal-erp-puller 技能，从 itgoal.com 拉取昨日的全订单字段导出（exportTemplateId=28 的 84 列模板，exportOrderType=2 按产品导出），下载到当前工作区。完成后告诉我文件路径、订单行数和日期范围。如果登录态失效，明确告诉我需要重新登录，绝对不要编造数据。\" },\n  { label: \"生成 ERP 运营日报\", prompt: \"使用 erp-daily-report 技能生成今日运营日报 HTML。完成后告诉我文件路径和核心结论。如果数据不全或导出失败，如实说明失败原因，不要编造数字。\" },\n];\nlet AGENT_TASKS = [];\nlet AGENT_BRIDGE = null;\nlet AGENT_POLL_TIMER = null;\nconst FOURPX_DEFAULT_REASONS = Object.freeze({ hold: \"订单取消\", cancel: \"取消拦截\" });\nlet FOURPX_SUBMITTING = false;\nlet FOURPX_ACTIVE_TAB = \"returns\";\nconst SHOW_AGENT_TASKS = false;\n\nfunction fourPxActionLabel(action) {\n  return action === \"cancel\" ? \"取消拦截\" : \"申请拦截\";\n}\n\nfunction renderFourPxResult(data) {\n  const target = $(\"fourPxResult\");\n  if (!target) return;\n  const action = data && data.action === \"cancel\" ? \"cancel\" : \"hold\";\n  const verb = action === \"cancel\" ? \"取消拦截\" : \"拦截\";\n  const success = data && data.ok === true;\n  const requestNo = String((data && data.request_no) || $(\"fourPxRequestNo\")?.value || \"\").trim();\n  const errors = Array.isArray(data && data.errors) ? data.errors : [];\n  const errorHtml = errors.map((item) => {\n    const code = String(item && item.code || \"未提供\");\n    const description = String(item && item.description || \"未提供错误描述\");\n    const upstream = String(item && item.upstream_message || \"\");\n    const reference = String(item && item.reference_code || \"\");\n    return `<div class=\"fourpx-error-item\"><div class=\"fourpx-error-head\"><span class=\"fourpx-error-code\">${escapeHtml(code)}</span><span class=\"fourpx-error-desc\">${escapeHtml(description)}</span></div>${upstream ? `<div class=\"fourpx-error-meta\">递四方原始信息：${escapeHtml(upstream)}</div>` : \"\"}${reference ? `<div class=\"fourpx-error-ref\">参考编号：${escapeHtml(reference)}</div>` : \"\"}</div>`;\n  }).join(\"\");\n  target.innerHTML = `<div class=\"fourpx-result-card ${success ? \"success\" : \"failure\"}\"><div class=\"fourpx-result-title\"><span>${success ? \"✓\" : \"!\"}</span><span>${success ? `${verb}成功` : `${verb}失败`}</span></div><div class=\"fourpx-result-message\">订单号：${escapeHtml(requestNo || \"—\")} · ${escapeHtml(String(data && data.message || \"未收到递四方处理信息\"))}</div>${errorHtml ? `<div class=\"fourpx-error-list\">${errorHtml}</div>` : \"\"}</div>`;\n}\n\nasync function submitFourPxOrderHold(event) {\n  if (event && typeof event.preventDefault === \"function\") event.preventDefault();\n  if (FOURPX_SUBMITTING) return false;\n  const requestNo = String($(\"fourPxRequestNo\")?.value || \"\").trim();\n  const action = String($(\"fourPxAction\")?.value || \"hold\").trim();\n  const holdReason = String($(\"fourPxHoldReason\")?.value || \"\").trim();\n  const submit = $(\"fourPxSubmit\");\n  if (!requestNo) {\n    renderFourPxResult({ ok: false, action, request_no: requestNo, message: \"请输入订单号\", errors: [] });\n    $(\"fourPxRequestNo\")?.focus();\n    return false;\n  }\n  if (requestNo.length > 64) {\n    renderFourPxResult({ ok: false, action, request_no: requestNo, message: \"订单号长度不能超过 64 个字符\", errors: [] });\n    return false;\n  }\n  if (!holdReason) {\n    renderFourPxResult({ ok: false, action, request_no: requestNo, message: \"请输入拦截原因\", errors: [] });\n    $(\"fourPxHoldReason\")?.focus();\n    return false;\n  }\n  if (holdReason.length > 128) {\n    renderFourPxResult({ ok: false, action, request_no: requestNo, message: \"拦截原因长度不能超过 128 个字符\", errors: [] });\n    return false;\n  }\n  const actionLabel = fourPxActionLabel(action);\n  if (!confirm(`确认对订单号 ${requestNo} 执行${actionLabel}吗？`)) return false;\n  FOURPX_SUBMITTING = true;\n  if (submit) {\n    submit.disabled = true;\n    submit.textContent = \"提交中…\";\n  }\n  try {\n    const data = await api(\"/api/fourpx/order-hold\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ request_no: requestNo, action: action, hold_reason: holdReason }),\n    });\n    renderFourPxResult({ ...data, action, request_no: requestNo });\n  } catch (error) {\n    renderFourPxResult({ ok: false, action, request_no: requestNo, message: `工作台请求失败：${(error && error.message) || error}`, errors: [] });\n  } finally {\n    FOURPX_SUBMITTING = false;\n    if (submit) {\n      submit.disabled = false;\n      submit.textContent = \"提交操作\";\n    }\n  }\n  return false;\n}\n\nfunction initFourPxPage() {\n  const box = $(\"pageFourPx\");\n  if (!box || box.dataset.ready === \"1\") return;\n  box.dataset.ready = \"1\";\n  box.innerHTML = `<div class=\"fourpx-shell\"><div class=\"fourpx-header\"><div><h2>递四方订单拦截</h2><p class=\"fourpx-sub\">对已创建并仍在前往递四方仓库途中订单申请拦截，或取消已有的拦截申请。</p></div><div class=\"fourpx-safety\">每次只处理一个订单号。提交前请核对操作，页面不会自动重复提交。</div></div><div class=\"fourpx-card\"><form id=\"fourPxForm\" class=\"fourpx-form\"><div class=\"fourpx-field\"><label for=\"fourPxRequestNo\">订单号 / 请求编号</label><input id=\"fourPxRequestNo\" maxlength=\"64\" autocomplete=\"off\" placeholder=\"请输入递四方订单号\" required><span class=\"fourpx-hint\">最多 64 个字符，例如 ME26090214225226423</span></div><div class=\"fourpx-field\"><label for=\"fourPxAction\">操作</label><select id=\"fourPxAction\"><option value=\"hold\">申请拦截</option><option value=\"cancel\">取消拦截</option></select><span class=\"fourpx-hint\">申请拦截对应 Y，取消拦截对应 N</span></div><div class=\"fourpx-field full\"><label for=\"fourPxHoldReason\">拦截原因</label><textarea id=\"fourPxHoldReason\" maxlength=\"128\" required>订单取消</textarea><span class=\"fourpx-hint\">递四方接口要求必填，最多 128 个字符。</span></div></form><div class=\"fourpx-actions\"><span class=\"fourpx-hint\">操作会直接提交到递四方，请确认订单状态后再执行。</span><button class=\"btn primary\" id=\"fourPxSubmit\" type=\"submit\" form=\"fourPxForm\">提交操作</button></div><div id=\"fourPxResult\" class=\"fourpx-result\" aria-live=\"polite\"></div></div></div>`;\n  const action = $(\"fourPxAction\");\n  const reason = $(\"fourPxHoldReason\");\n  let lastDefaultReason = FOURPX_DEFAULT_REASONS[action.value] || FOURPX_DEFAULT_REASONS.hold;\n  action.addEventListener(\"change\", () => {\n    const nextDefault = FOURPX_DEFAULT_REASONS[action.value] || FOURPX_DEFAULT_REASONS.hold;\n    if (!reason.value.trim() || reason.value.trim() === lastDefaultReason) reason.value = nextDefault;\n    lastDefaultReason = nextDefault;\n  });\n  $(\"fourPxForm\").addEventListener(\"submit\", submitFourPxOrderHold);\n}\n\nfunction tencentReturnsRecordValue(record, keys) {\n  for (const key of keys) {\n    if (record && Object.prototype.hasOwnProperty.call(record, key) && record[key] !== undefined && record[key] !== null) {\n      return record[key];\n    }\n  }\n  return \"\";\n}\n\nfunction fourPxReturnsRecordShop(record) {\n  return String(tencentReturnsRecordValue(record, [\"shop\", \"shop_name\", \"shopName\"]) || \"\").trim();\n}\n\nfunction fourPxReturnsShopAssignmentName(payload = TENCENT_RETURNS_CACHE) {\n  const assignments = payload && payload.shop_assignments;\n  return String(assignments && assignments[String(GLOBAL_SHOP || \"\").trim()] || \"\").trim();\n}\n\nfunction fourPxReturnsRecordOrderId(record) {\n  return String(tencentReturnsRecordValue(record, [\"order_id\", \"orderId\", \"order_no\", \"orderNo\"]) || \"\").trim();\n}\n\nfunction fourPxReturnsSearchMatches(value, query) {\n  const needle = String(query || \"\").trim().toLowerCase();\n  if (!needle) return true;\n  return String(value || \"\").toLowerCase().includes(needle);\n}\n\nfunction fourPxReturnsVisibleRecords() {\n  const selectedShop = String($(\"fourPxReturnsShop\")?.value || \"\").trim();\n  const orderSearch = String($(\"fourPxReturnsOrderSearch\")?.value || \"\").trim();\n  return TENCENT_RETURNS_RECORDS.filter((record) => {\n    const recordShop = fourPxReturnsRecordShop(record);\n    if (selectedShop && recordShop !== selectedShop) return false;\n    return fourPxReturnsSearchMatches(fourPxReturnsRecordOrderId(record), orderSearch);\n  });\n}\n\nfunction updateTencentDocsReturnsCacheNote(payload) {\n  const note = $(\"fourPxReturnsCacheNote\");\n  if (!note) return;\n  const cache = payload && payload.cache ? payload.cache : {};\n  const fourPxReturnsSyncing = Boolean(cache && cache.syncing !== undefined ? cache.syncing : payload && payload.syncing);\n  const parts = [];\n  if (cache.source) parts.push(`来源：${escapeHtml(cache.source)}`);\n  if (cache.fetched_at) parts.push(`缓存时间：${escapeHtml(new Date(cache.fetched_at).toLocaleString(\"zh-CN\"))}`);\n  if (fourPxReturnsSyncing) parts.push(\"后台同步进行中，仅观察本地缓存\");\n  else parts.push(\"只读取本地缓存，不触发上游同步\");\n  if (cache.last_error) parts.push(`最近失败：${escapeHtml(cache.last_error)}`);\n  note.innerHTML = parts.join(\" · \") || \"只读取本地缓存\";\n}\n\nfunction renderTencentDocsReturnsTable() {\n  const wrap = $(\"fourPxReturnsTableWrap\");\n  const count = $(\"fourPxReturnsCount\");\n  if (!wrap || !count) return;\n  const rows = fourPxReturnsVisibleRecords();\n  count.textContent = `当前 ${rows.length} / ${TENCENT_RETURNS_RECORDS.length} 条`;\n  if (!rows.length) {\n    wrap.innerHTML = '<div class=\"tr-empty\">当前筛选下没有递四方退件记录。</div>';\n    return;\n  }\n  const renderAmount = (record) => {\n    const rawAmount = tencentReturnsRecordValue(record, [\"order_amount\", \"amount\", \"orderAmount\"]);\n    const amount = Number(rawAmount);\n    if (!Number.isFinite(amount) || amount < 0) {\n      const amountText = String(tencentReturnsRecordValue(record, [\"amount_text\", \"amountText\"]) || \"金额未知\").trim() || \"金额未知\";\n      return `<span class=\"mail-order-amount unknown\">${escapeHtml(amountText)}</span>`;\n    }\n    const formatted = amount.toLocaleString(\"zh-CN\", { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n    return `<span class=\"mail-order-amount ${orderAmountClass(amount)}\">${formatted} EUR</span>`;\n  };\n  wrap.innerHTML = `<table class=\"tr-table\">\n    <thead><tr><th>订单号</th><th>店铺</th><th>配对 SKU</th><th>产品名称</th><th>数量</th><th>订单金额</th><th>截止日期</th><th>问题描述</th></tr></thead>\n    <tbody>${rows.map((record) => {\n      const orderId = fourPxReturnsRecordOrderId(record);\n      const shop = fourPxReturnsRecordShop(record);\n      const sku = String(tencentReturnsRecordValue(record, [\"matched_sku\", \"matchedSku\", \"sku\"]) || \"\").trim();\n      const product = String(tencentReturnsRecordValue(record, [\"product_name\", \"productName\", \"title\"]) || \"\").trim();\n      const quantity = String(tencentReturnsRecordValue(record, [\"quantity\", \"qty\"]) || \"\").trim();\n      const deadline = String(tencentReturnsRecordValue(record, [\"deadline\", \"deadline_at\", \"deadlineAt\"]) || \"\").trim();\n      const problem = String(tencentReturnsRecordValue(record, [\"problem\", \"issue\", \"problem_text\", \"problemText\"]) || \"\");\n      const problemPreview = fourPxReturnsProblemPreview(problem);\n      return `<tr>\n        <td class=\"tr-mono\">${escapeHtml(orderId || \"—\")}</td>\n        <td>${escapeHtml(shop || \"—\")}</td>\n        <td class=\"tr-sku\">${escapeHtml(sku || \"—\")}</td>\n        <td class=\"tr-product\">${escapeHtml(product || \"—\")}</td>\n        <td class=\"tr-qty\">${escapeHtml(quantity || \"—\")}</td>\n        <td>${renderAmount(record)}</td>\n        <td class=\"tr-deadline\">${escapeHtml(deadline || \"—\")}</td>\n        <td><span class=\"tr-problem\" title=\"${escapeAttr(problem)}\">${escapeHtml(problemPreview || \"—\")}</span></td>\n      </tr>`;\n    }).join(\"\")}</tbody>\n  </table>`;\n}\n\nasync function loadTencentDocsReturnsData(options = {}) {\n  const requestId = ++TENCENT_RETURNS_LOAD_SEQ;\n  const status = $(\"fourPxReturnsStatus\");\n  if (status && !options.followup) {\n    status.textContent = \"正在读取本地缓存…\";\n    status.className = \"tr-status\";\n  }\n  try {\n    const payload = await api(\"/api/fourpx/returns\");\n    if (requestId !== TENCENT_RETURNS_LOAD_SEQ) return;\n    TENCENT_RETURNS_CACHE = payload;\n    TENCENT_RETURNS_RECORDS = Array.isArray(payload && payload.records) ? payload.records : [];\n    const cache = payload && payload.cache ? payload.cache : {};\n    const fourPxReturnsSyncing = Boolean(cache && cache.syncing !== undefined ? cache.syncing : payload && payload.syncing);\n    const select = $(\"fourPxReturnsShop\");\n    if (select) {\n      const previous = select.value;\n      const assignedShop = fourPxReturnsShopAssignmentName(payload);\n      const shopNames = new Set(TENCENT_RETURNS_RECORDS.map((record) => fourPxReturnsRecordShop(record)).filter(Boolean));\n      if (assignedShop) shopNames.add(assignedShop);\n      const shops = [...shopNames].sort((a, b) => a.localeCompare(b, \"zh-CN\"));\n      select.innerHTML = `<option value=\"\">全部店铺</option>${shops.map((shop) => `<option value=\"${escapeAttr(shop)}\">${escapeHtml(shop)}</option>`).join(\"\")}`;\n      const defaultShop = options.followup\n        ? (shops.includes(previous) ? previous : \"\")\n        : (assignedShop && shops.includes(assignedShop) ? assignedShop : \"\");\n      select.value = defaultShop;\n    }\n    updateTencentDocsReturnsCacheNote(payload);\n    renderTencentDocsReturnsTable();\n    if (status) {\n      status.textContent = cache.last_error\n        ? `显示缓存成功，但最近同步失败：${cache.last_error}`\n        : fourPxReturnsSyncing\n          ? \"后台同步中，当前显示本地缓存\"\n          : \"已读取本地缓存\";\n      status.className = `tr-status ${cache.last_error ? \"warn\" : \"ok\"}`;\n    }\n    if (fourPxReturnsSyncing && !options.followup) {\n      setTimeout(() => {\n        loadTencentDocsReturnsData({ followup: true }).catch(() => {});\n      }, 1500);\n    }\n  } catch (error) {\n    if (requestId !== TENCENT_RETURNS_LOAD_SEQ) return;\n    if (status) {\n      status.textContent = `读取递四方退件缓存失败：${(error && error.message) || error}`;\n      status.className = \"tr-status err\";\n    }\n  }\n}\n\nfunction initTencentDocsReturnsPage() {\n  const box = $(\"pageFourPxReturns\");\n  if (!box || TENCENT_RETURNS_READY) return;\n  TENCENT_RETURNS_READY = true;\n  box.innerHTML = `<div class=\"tencent-returns operation-shell\">\n    <header class=\"tr-header\">\n      <div><h2>递四方退件</h2><div class=\"tr-sub\">只读展示本地缓存中的腾讯文档退件记录；首次打开默认选中顶部当前店铺，页面内店铺筛选仍可独立切换，也不会主动请求上游同步。</div></div>\n      <div class=\"tr-sync-note\" id=\"fourPxReturnsCacheNote\">正在读取本地缓存状态…</div>\n    </header>\n    <div class=\"tr-filter-panel\">\n      <div class=\"tr-filter-row\">\n        <div class=\"tr-field\"><label>店铺</label><select id=\"fourPxReturnsShop\" class=\"tr-control\"><option value=\"\">全部店铺</option></select></div>\n        <div class=\"tr-field tr-field-search\"><label>订单号搜索</label><input id=\"fourPxReturnsOrderSearch\" class=\"tr-control\" type=\"search\" placeholder=\"按订单号包含匹配\"></div>\n      </div>\n      <div class=\"tr-filter-hint\">筛选只基于本地缓存数据。店铺必须完全匹配，订单号按不区分大小写的包含匹配。</div>\n    </div>\n    <div class=\"tr-table-panel\">\n      <div class=\"tr-action-bar\">\n        <span id=\"fourPxReturnsCount\" class=\"tr-count\">等待加载…</span>\n        <span id=\"fourPxReturnsStatus\" class=\"tr-status\"></span>\n      </div>\n      <div id=\"fourPxReturnsTableWrap\" class=\"tr-table-wrap\"><div class=\"tr-empty\">正在加载递四方退件缓存…</div></div>\n    </div>\n  </div>`;\n  [\"fourPxReturnsShop\", \"fourPxReturnsOrderSearch\"].forEach((id) => {\n    $(id).addEventListener(\"input\", renderTencentDocsReturnsTable);\n    $(id).addEventListener(\"change\", renderTencentDocsReturnsTable);\n  });\n  loadTencentDocsReturnsData().catch(() => {});\n}\n\n// ---- 递四方库内异常（只读展示腾讯文档「库内异常」子表缓存）----\n//\n// 与递四方退件同构，唯一差别是第 7 列语义：退件表是「截止日期」（4px 给的处理期限），\n// 库内异常表是「上架时间」（扣件实际发生时间）。\n//\n// 店铺归属口径（2026-09-11 用户要求）：表里「店铺」为空的记录 = 能在订单表里匹配到、\n// 但识别不出属于哪个店铺 → 这类记录在**所有店铺视图**下都要显示，不能被店铺筛选隐藏。\n\nfunction innerRecordShop(record) {\n  return String(tencentReturnsRecordValue(record, [\"shop\", \"shop_name\", \"shopName\"]) || \"\").trim();\n}\n\n// 腾讯文档表里的店铺名大小写不统一（实测同表内并存 `Mediamarkt-debuymm` 与\n// `mediamarkt-Link Carol Shop`），所有店铺比较都先归一化。\nfunction innerShopKey(value) {\n  return String(value || \"\").replace(/\\u00a0/g, \" \").replace(/\\s+/g, \" \").trim().toLocaleLowerCase(\"en-US\");\n}\n\nfunction innerRecordOrderId(record) {\n  return String(tencentReturnsRecordValue(record, [\"order_id\", \"orderId\", \"order_no\", \"orderNo\"]) || \"\").trim();\n}\n\nfunction innerRecordShelfTime(record) {\n  return String(tencentReturnsRecordValue(record, [\"shelf_time\", \"shelfTime\", \"shelf_time_text\"]) || \"\").trim();\n}\n\nfunction innerIsUnassignedShop(record) {\n  return innerShopKey(innerRecordShop(record)) === \"\";\n}\n\nfunction innerShopAssignmentName(payload = TENCENT_INNER_CACHE) {\n  const assignments = payload && payload.shop_assignments;\n  return String(assignments && assignments[String(GLOBAL_SHOP || \"\").trim()] || \"\").trim();\n}\n\nfunction innerVisibleRecords() {\n  const selectedShop = String($(\"fourPxInnerShop\")?.value || \"\").trim();\n  const orderSearch = String($(\"fourPxInnerOrderSearch\")?.value || \"\").trim();\n  const selectedKey = innerShopKey(selectedShop);\n  return TENCENT_INNER_RECORDS.filter((record) => {\n    // 未识别店铺的记录在任何店铺视图下都保留。\n    if (selectedKey && !innerIsUnassignedShop(record) && innerShopKey(innerRecordShop(record)) !== selectedKey) return false;\n    return fourPxReturnsSearchMatches(innerRecordOrderId(record), orderSearch);\n  });\n}\n\nfunction updateTencentDocsInnerCacheNote(payload) {\n  const note = $(\"fourPxInnerCacheNote\");\n  if (!note) return;\n  const cache = payload && payload.cache ? payload.cache : {};\n  const innerSyncing = Boolean(cache && cache.syncing !== undefined ? cache.syncing : payload && payload.syncing);\n  const parts = [];\n  if (cache.source) parts.push(`来源：${escapeHtml(cache.source)}`);\n  if (cache.fetched_at) parts.push(`缓存时间：${escapeHtml(new Date(cache.fetched_at).toLocaleString(\"zh-CN\"))}`);\n  if (innerSyncing) parts.push(\"后台同步进行中，仅观察本地缓存\");\n  else parts.push(\"只读取本地缓存，不触发上游同步\");\n  if (cache.last_error) parts.push(`最近失败：${escapeHtml(cache.last_error)}`);\n  note.innerHTML = parts.join(\" · \") || \"只读取本地缓存\";\n}\n\nfunction renderTencentDocsInnerTable() {\n  const wrap = $(\"fourPxInnerTableWrap\");\n  const count = $(\"fourPxInnerCount\");\n  if (!wrap || !count) return;\n  const rows = innerVisibleRecords();\n  const unassignedTotalValue = Number(TENCENT_INNER_CACHE && TENCENT_INNER_CACHE.unassigned_shop_total);\n  const unassignedTotal = Number.isFinite(unassignedTotalValue) && unassignedTotalValue > 0 ? unassignedTotalValue : 0;\n  count.textContent = `当前 ${rows.length} / ${TENCENT_INNER_RECORDS.length} 条`\n    + (unassignedTotal ? `（含 ${unassignedTotal} 条未识别店铺，已在所有店铺视图下显示）` : \"\");\n  if (!rows.length) {\n    wrap.innerHTML = '<div class=\"tr-empty\">当前筛选下没有递四方库内异常记录。</div>';\n    return;\n  }\n  const renderAmount = (record) => {\n    const rawAmount = tencentReturnsRecordValue(record, [\"order_amount\", \"amount\", \"orderAmount\"]);\n    const amount = Number(rawAmount);\n    if (!Number.isFinite(amount) || amount < 0) {\n      const amountText = String(tencentReturnsRecordValue(record, [\"amount_text\", \"amountText\"]) || \"金额未知\").trim() || \"金额未知\";\n      return `<span class=\"mail-order-amount unknown\">${escapeHtml(amountText)}</span>`;\n    }\n    const formatted = amount.toLocaleString(\"zh-CN\", { minimumFractionDigits: 2, maximumFractionDigits: 2 });\n    return `<span class=\"mail-order-amount ${orderAmountClass(amount)}\">${formatted} EUR</span>`;\n  };\n  wrap.innerHTML = `<table class=\"tr-table\">\n    <thead><tr><th>订单号</th><th>店铺</th><th>配对 SKU</th><th>产品名称</th><th>数量</th><th>订单金额</th><th>上架时间</th><th>问题描述</th></tr></thead>\n    <tbody>${rows.map((record) => {\n      const orderId = innerRecordOrderId(record);\n      const shop = innerRecordShop(record);\n      const sku = String(tencentReturnsRecordValue(record, [\"matched_sku\", \"matchedSku\", \"sku\"]) || \"\").trim();\n      const product = String(tencentReturnsRecordValue(record, [\"product_name\", \"productName\", \"title\"]) || \"\").trim();\n      const quantity = String(tencentReturnsRecordValue(record, [\"quantity\", \"qty\"]) || \"\").trim();\n      const shelfTime = innerRecordShelfTime(record);\n      const problem = String(tencentReturnsRecordValue(record, [\"problem\", \"issue\", \"problem_text\", \"problemText\"]) || \"\");\n      const problemPreview = fourPxReturnsProblemPreview(problem);\n      const shopCell = shop\n        ? escapeHtml(shop)\n        : '<span class=\"tr-shop-unassigned\" title=\"订单表里匹配到了这单，但识别不出所属店铺；该记录在所有店铺视图下都会显示。\">未识别店铺</span>';\n      return `<tr>\n        <td class=\"tr-mono\">${escapeHtml(orderId || \"—\")}</td>\n        <td>${shopCell}</td>\n        <td class=\"tr-sku\">${escapeHtml(sku || \"—\")}</td>\n        <td class=\"tr-product\">${escapeHtml(product || \"—\")}</td>\n        <td class=\"tr-qty\">${escapeHtml(quantity || \"—\")}</td>\n        <td>${renderAmount(record)}</td>\n        <td class=\"tr-deadline\">${escapeHtml(shelfTime || \"—\")}</td>\n        <td><span class=\"tr-problem\" title=\"${escapeAttr(problem)}\">${escapeHtml(problemPreview || \"—\")}</span></td>\n      </tr>`;\n    }).join(\"\")}</tbody>\n  </table>`;\n}\n\nasync function loadTencentDocsInnerData(options = {}) {\n  const requestId = ++TENCENT_INNER_LOAD_SEQ;\n  const status = $(\"fourPxInnerStatus\");\n  if (status && !options.followup) {\n    status.textContent = \"正在读取本地缓存…\";\n    status.className = \"tr-status\";\n  }\n  try {\n    const payload = await api(\"/api/fourpx/inner\");\n    if (requestId !== TENCENT_INNER_LOAD_SEQ) return;\n    TENCENT_INNER_CACHE = payload;\n    TENCENT_INNER_RECORDS = Array.isArray(payload && payload.records) ? payload.records : [];\n    const cache = payload && payload.cache ? payload.cache : {};\n    const innerSyncing = Boolean(cache && cache.syncing !== undefined ? cache.syncing : payload && payload.syncing);\n    const select = $(\"fourPxInnerShop\");\n    if (select) {\n      const previous = select.value;\n      const assignedShop = innerShopAssignmentName(payload);\n      // 归一化去重：同一店铺在表里可能有多种大小写写法，只保留一个选项，\n      // 优先采用 shop_assignments 里的规范名。\n      const canonicalShops = new Map();\n      const addShop = (name) => {\n        const key = innerShopKey(name);\n        if (!key || canonicalShops.has(key)) return;\n        canonicalShops.set(key, String(name).trim());\n      };\n      if (assignedShop) addShop(assignedShop);\n      TENCENT_INNER_RECORDS.forEach((record) => addShop(innerRecordShop(record)));\n      const shops = [...canonicalShops.values()].sort((a, b) => a.localeCompare(b, \"zh-CN\"));\n      const options2 = `<option value=\"\">全部店铺</option>${shops.map((shop) => `<option value=\"${escapeAttr(shop)}\">${escapeHtml(shop)}</option>`).join(\"\")}`;\n      select.innerHTML = options2;\n      const matchShop = (name) => shops.find((shop) => innerShopKey(shop) === innerShopKey(name)) || \"\";\n      select.value = options.followup\n        ? matchShop(previous)\n        : (assignedShop ? matchShop(assignedShop) : \"\");\n    }\n    updateTencentDocsInnerCacheNote(payload);\n    renderTencentDocsInnerTable();\n    if (status) {\n      status.textContent = cache.last_error\n        ? `显示缓存成功，但最近同步失败：${cache.last_error}`\n        : innerSyncing\n          ? \"后台同步中，当前显示本地缓存\"\n          : \"已读取本地缓存\";\n      status.className = `tr-status ${cache.last_error ? \"warn\" : \"ok\"}`;\n    }\n    if (innerSyncing && !options.followup) {\n      setTimeout(() => {\n        loadTencentDocsInnerData({ followup: true }).catch(() => {});\n      }, 1500);\n    }\n  } catch (error) {\n    if (requestId !== TENCENT_INNER_LOAD_SEQ) return;\n    if (status) {\n      status.textContent = `读取递四方库内异常缓存失败：${(error && error.message) || error}`;\n      status.className = \"tr-status err\";\n    }\n  }\n}\n\nfunction initTencentDocsInnerPage() {\n  const box = $(\"pageFourPxInner\");\n  if (!box || TENCENT_INNER_READY) return;\n  TENCENT_INNER_READY = true;\n  box.innerHTML = `<div class=\"tencent-returns operation-shell\">\n    <header class=\"tr-header\">\n      <div><h2>递四方库内异常</h2><div class=\"tr-sub\">只读展示本地缓存中的腾讯文档「库内异常」记录（货在 4px 仓内被扣下、等待处理指令）。首次打开默认选中顶部当前店铺，页面内店铺筛选仍可独立切换，也不会主动请求上游同步。</div></div>\n      <div class=\"tr-sync-note\" id=\"fourPxInnerCacheNote\">正在读取本地缓存状态…</div>\n    </header>\n    <div class=\"tr-filter-panel\">\n      <div class=\"tr-filter-row\">\n        <div class=\"tr-field\"><label>店铺</label><select id=\"fourPxInnerShop\" class=\"tr-control\"><option value=\"\">全部店铺</option></select></div>\n        <div class=\"tr-field tr-field-search\"><label>订单号搜索</label><input id=\"fourPxInnerOrderSearch\" class=\"tr-control\" type=\"search\" placeholder=\"按订单号包含匹配\"></div>\n      </div>\n      <div class=\"tr-filter-hint\">筛选只基于本地缓存数据。店铺按不区分大小写完全匹配，订单号按不区分大小写的包含匹配；识别不出店铺的记录不会被店铺筛选隐藏，会在所有店铺视图下都显示。</div>\n    </div>\n    <div class=\"tr-table-panel\">\n      <div class=\"tr-action-bar\">\n        <span id=\"fourPxInnerCount\" class=\"tr-count\">等待加载…</span>\n        <span id=\"fourPxInnerStatus\" class=\"tr-status\"></span>\n      </div>\n      <div id=\"fourPxInnerTableWrap\" class=\"tr-table-wrap\"><div class=\"tr-empty\">正在加载递四方库内异常缓存…</div></div>\n    </div>\n  </div>`;\n  [\"fourPxInnerShop\", \"fourPxInnerOrderSearch\"].forEach((id) => {\n    $(id).addEventListener(\"input\", renderTencentDocsInnerTable);\n    $(id).addEventListener(\"change\", renderTencentDocsInnerTable);\n  });\n  loadTencentDocsInnerData().catch(() => {});\n}\n\n// ---- 发货超时警告（v26.53 新增；v26.54 改按天缓存 + SKU 列 + 默认当前店铺）----\n// 数据来自本地 GET /api/shipping-overdue（服务端拉 OR11 未发货订单并按 deadline 分组）；\n// 时间一律由服务端换算成北京时间（UTC+8），前端只负责展示与筛选。\nlet SHIPPING_OVERDUE_READY = false;\nlet SHIPPING_OVERDUE_DATA = null;\nlet SHIPPING_OVERDUE_LOAD_SEQ = 0;\nlet SHIPPING_OVERDUE_FOLLOWUP_TIMER = null;\n// 后台跟进的最大次数（每次间隔 1.5s ⇒ 约 60s）。同步长时间不回来时到此为止，\n// 免得页面挂着一个永不停止的轮询。（v26.97：跟进可以再跟进，所以必须封顶。）\nconst SHIPPING_OVERDUE_FOLLOWUP_MAX_TRIES = 40;\n// 默认跟随全局当前店铺；打开页面时由 initShippingOverduePage 赋初值\nlet SHIPPING_OVERDUE_SHOP_FILTER = \"\";\n// 仓库类型筛选（v26.82）：\"\" = 全部 / \"overseas\" / \"domestic\" / \"unclassified\"。\n// 「未识别」「ERP 无单」「未查询」在**筛选**里合并成一桶 —— 三者对运营的动作是一样的\n// （先别按仓库口径下结论、回头去 ERP 核实），但在**行内标签**上仍分别显示，不掩盖差异。\nlet SHIPPING_OVERDUE_WAREHOUSE_FILTER = \"\";\n// ERP 操作状态筛选（v26.97）：\"\" = 全部，其余 = **行内显示的那串字**（如「已发货」「查询中....」）。\n// 刻意不做「值 → 枚举」的映射：用户看到什么就筛什么，占位态（查询中/未查询/无单/未标注）\n// 也照样可选 —— 「哪些还没查到」本身就是他要找的那一类。\nlet SHIPPING_OVERDUE_OPERATE_FILTER = \"\";\n\n// ERP 操作状态的展示名（与 shipping-overdue.js 的 OPERATE_STATUS_* 保持一致）。\n// 取值本身来自 ERP，前端不加工；这里只定义「不是取值」的四种占位说法。\nconst SHIPPING_OVERDUE_OP_TEXT_LABELS = {\n  loading: \"查询中....\",\n  blank: \"未标注\",\n  missing: \"ERP 无单\",\n  unchecked: \"未查询\",\n};\nconst SHIPPING_OVERDUE_OP_TIPS = {\n  loading: \"后台正在补拉 ERP 操作状态，查到后本列会自动更新，不用手动刷新\",\n  blank: \"ERP 里有这一单，但没有填写操作状态\",\n  missing: \"ERP 待发货订单里没有这一单（不在 processing/pickup/apply 三段内，或超出查询时间窗）\",\n  unchecked: \"本轮没查到 ERP 操作状态（ERP 未配置、查询失败或结果不完整）——不代表它没有状态\",\n};\n\n// ERP 仓库类型的展示名（与 shipping-overdue.js 的 WAREHOUSE_KIND_LABELS 保持一致）\nconst SHIPPING_OVERDUE_WH_KIND_LABELS = {\n  overseas: \"海外仓\",\n  domestic: \"国内仓\",\n  unknown: \"未识别\",\n  missing: \"ERP 无单\",\n  unchecked: \"未查询\",\n};\nconst SHIPPING_OVERDUE_WH_KIND_TIPS = {\n  overseas: \"ERP 仓库判定：货已在境外，直接走当地尾程\",\n  domestic: \"ERP 仓库判定：货仍在国内，还需头程\",\n  unknown: \"ERP 里有这一单，但仓库 id 不在已归类白名单里 —— 请人工确认后补进白名单\",\n  missing: \"ERP 待发货订单里没有这一单（不在 processing/pickup/apply 三段内，或超出查询时间窗）\",\n  unchecked: \"本轮没查到 ERP 仓库（ERP 未配置或查询失败），不代表它不是海外仓\",\n};\n// 下拉三个桶的标签（v26.84 起只有这一处定义）：下拉选项、分组标题、被筛空的空态文案共用，\n// 改文案不会漏掉某一处。「未识别」桶是行内 unknown / missing / unchecked 三者的合并说法 ——\n// 对运营来说动作一样（先别按仓库口径下结论，回头去 ERP 核实）。\nconst SHIPPING_OVERDUE_WH_FILTER_LABELS = {\n  overseas: SHIPPING_OVERDUE_WH_KIND_LABELS.overseas,\n  domestic: SHIPPING_OVERDUE_WH_KIND_LABELS.domestic,\n  unclassified: \"未识别 / 无单\",\n};\nconst SHIPPING_OVERDUE_WH_FILTERS = Object.keys(SHIPPING_OVERDUE_WH_FILTER_LABELS);\n\n/** 当前仓库类型下拉选中的桶标签（\"\" = 全部）。 */\nfunction shippingOverdueWarehouseFilterLabel() {\n  return SHIPPING_OVERDUE_WH_FILTER_LABELS[String(SHIPPING_OVERDUE_WAREHOUSE_FILTER || \"\")] || \"\";\n}\n\n/** 记录落在哪个筛选桶（表格/统计用）。 */\nfunction shippingOverdueWarehouseBucket(record) {\n  const kind = String((record && record.erp_warehouse_kind) || \"unchecked\");\n  if (kind === \"overseas\" || kind === \"domestic\") return kind;\n  return \"unclassified\";\n}\n\n/** 行内显示的操作状态文本（口径由服务端定，这里只做缺字段兜底）。 */\nfunction shippingOverdueOperateStatusText(record) {\n  const text = String((record && record.operate_status_text) || \"\").trim();\n  if (text) return text;\n  const state = String((record && record.operate_status_state) || \"unchecked\");\n  // 「说查到了却没有值」= 未标注（与服务端 operateStatusView 同一条规则）；\n  // 其余状态各有固定说法，都不认识就当「未查询」—— 绝不返回空串。\n  if (state === \"loaded\") return SHIPPING_OVERDUE_OP_TEXT_LABELS.blank;\n  return SHIPPING_OVERDUE_OP_TEXT_LABELS[state] || SHIPPING_OVERDUE_OP_TEXT_LABELS.unchecked;\n}\n\n/**\n * 是不是「占位」而不是 ERP 给的真值。\n * 判据只看有没有服务端给的取值 —— 有就是真状态，没有就一定是占位说法\n * （查询中/未查询/ERP 无单/未标注），不需要再按状态枚举一遍。\n */\nfunction shippingOverdueOperateStatusIsPlaceholder(record) {\n  return !String((record && record.operate_status_text) || \"\").trim();\n}\n\nfunction shippingOverdueOperateStatusTip(record) {\n  const state = String((record && record.operate_status_state) || \"unchecked\");\n  return SHIPPING_OVERDUE_OP_TIPS[state] || \"\";\n}\n\n/**\n * 当前可见范围（店铺筛选后）出现过的操作状态 → 筛选选项（带计数）。\n *\n * 口径与仓库下拉**完全一致**：只随店铺筛选变、不随另一列筛选变 ——\n * 否则一选「海外仓」，操作状态下拉里的数字跟着变，两个筛选互相干扰，谁都读不准。\n */\nfunction shippingOverdueOperateStatusCounts() {\n  const counts = new Map();\n  for (const record of shippingOverdueScopedRecords()) {\n    const text = shippingOverdueOperateStatusText(record);\n    counts.set(text, (counts.get(text) || 0) + 1);\n  }\n  // 数量多的在前；同数量按文本稳定排序（否则每次渲染顺序都在抖）\n  return [...counts.entries()]\n    .map(([text, count]) => ({ text, count }))\n    .sort((a, b) => b.count - a.count || a.text.localeCompare(b.text, \"zh-Hans-CN\"));\n}\n\nfunction shippingOverdueOperateStatusFilterLabel() {\n  return String(SHIPPING_OVERDUE_OPERATE_FILTER || \"\");\n}\n\n/** 生效中的筛选描述（仓库 + 操作状态；都生效就都写出来）。分组标题与空态共用。 */\nfunction shippingOverdueFilterLabelText() {\n  return [shippingOverdueWarehouseFilterLabel(), shippingOverdueOperateStatusFilterLabel()]\n    .filter(Boolean)\n    .map((label) => `「${label}」`)\n    .join(\"+\");\n}\n\nfunction shippingOverdueDurationText(seconds) {\n  const total = Math.max(0, Math.round(Number(seconds) || 0));\n  const days = Math.floor(total / 86400);\n  const hours = Math.floor((total % 86400) / 3600);\n  const minutes = Math.floor((total % 3600) / 60);\n  if (days > 0) return `${days} 天 ${hours} 小时`;\n  if (hours > 0) return `${hours} 小时 ${minutes} 分`;\n  return `${minutes} 分钟`;\n}\n\n/**\n * 当前可见范围（已应用店铺筛选）的记录。\n * `kind` 省略时返回「已超时 + 24 小时内」两组合并 —— 统计卡与下拉计数都用这个口径，\n * 不受仓库类型筛选影响，否则一选「海外仓」国内仓就变 0，看不出真实分布。\n */\nfunction shippingOverdueScopedRecords(kind) {\n  const data = SHIPPING_OVERDUE_DATA || {};\n  const list = kind\n    ? (Array.isArray(data[kind]) ? data[kind] : [])\n    : [].concat(\n      Array.isArray(data.overdue) ? data.overdue : [],\n      Array.isArray(data.due_soon) ? data.due_soon : [],\n    );\n  const filter = String(SHIPPING_OVERDUE_SHOP_FILTER || \"\");\n  if (!filter) return list;\n  return list.filter((record) => String(record.shop_id || \"\") === filter);\n}\n\nfunction shippingOverdueWarehouseCounts() {\n  const counts = { overseas: 0, domestic: 0, unclassified: 0 };\n  for (const record of shippingOverdueScopedRecords()) {\n    counts[shippingOverdueWarehouseBucket(record)] += 1;\n  }\n  return counts;\n}\n\n/** 表格用：在店铺筛选之上再叠「仓库类型」与「ERP 操作状态」两层筛选。 */\nfunction shippingOverdueRecords(kind) {\n  let list = shippingOverdueScopedRecords(kind);\n  const warehouse = String(SHIPPING_OVERDUE_WAREHOUSE_FILTER || \"\");\n  if (warehouse) list = list.filter((record) => shippingOverdueWarehouseBucket(record) === warehouse);\n  const operate = String(SHIPPING_OVERDUE_OPERATE_FILTER || \"\");\n  if (operate) list = list.filter((record) => shippingOverdueOperateStatusText(record) === operate);\n  return list;\n}\nfunction shippingOverduePendingCount() {\n  const data = SHIPPING_OVERDUE_DATA || {};\n  const shops = Array.isArray(data.shops) ? data.shops : [];\n  const filter = String(SHIPPING_OVERDUE_SHOP_FILTER || \"\");\n  if (filter) {\n    const hit = shops.find((shop) => String(shop.shop_id) === filter);\n    return hit ? Number(hit.pending) || 0 : 0;\n  }\n  return Number((data.counts || {}).pending) || 0;\n}\n\nfunction shippingOverdueAmountText(record) {\n  // 注意 Number(null) === 0：缺失金额必须显式判空，否则会显示成 €0.00。\n  const raw = record.total_price;\n  if (raw === null || raw === undefined || raw === \"\") return \"—\";\n  const amount = Number(raw);\n  if (!Number.isFinite(amount)) return \"—\";\n  const currency = String(record.currency_iso_code || \"\").trim().toUpperCase();\n  const prefix = currency === \"EUR\" ? \"€\" : currency ? `${currency} ` : \"\";\n  return `${prefix}${amount.toLocaleString(\"zh-CN\", { minimumFractionDigits:2, maximumFractionDigits:2 })}`;\n}\n\nfunction shippingOverdueSkuList(record) {\n  const list = Array.isArray(record && record.pending_skus) ? record.pending_skus : [];\n  return list\n    .map((item) => {\n      const sku = String((item && item.sku) || \"\").trim();\n      if (!sku) return \"\";\n      const quantity = Number(item && item.quantity);\n      return Number.isFinite(quantity) && quantity > 1 ? `${sku} ×${quantity}` : sku;\n    })\n    .filter(Boolean);\n}\n\nfunction shippingOverdueSkuHtml(record) {\n  const labels = shippingOverdueSkuList(record);\n  if (!labels.length) return `<td class=\"so-sku\">—</td>`;\n  // 多于 3 个时折叠显示，完整列表放进 title，避免撑宽表格。\n  const shown = labels.slice(0, 3).join(\"、\");\n  const text = labels.length > 3 ? `${shown} 等 ${labels.length} 个` : shown;\n  return `<td class=\"so-sku\" title=\"${escapeHtml(labels.join(\"、\"))}\">${escapeHtml(text)}</td>`;\n}\n\n/**\n * 仓库列（v26.82）：标签 + ERP 仓库名。\n * 标签的颜色语义只在 CSS 变量里定义一处（--so-wh-*），这里只管语义、不管颜色。\n */\nfunction shippingOverdueWarehouseCellHtml(record) {\n  const rawKind = String((record && record.erp_warehouse_kind) || \"unchecked\");\n  const kind = SHIPPING_OVERDUE_WH_KIND_LABELS[rawKind] ? rawKind : \"unchecked\";\n  const label = SHIPPING_OVERDUE_WH_KIND_LABELS[kind];\n  const name = String((record && record.erp_warehouse_name) || \"\").trim();\n  const id = String((record && record.erp_warehouse_id) || \"\").trim();\n  const title = `${SHIPPING_OVERDUE_WH_KIND_TIPS[kind]}${name ? `｜仓库：${name}` : \"\"}${id ? `（id=${id}）` : \"\"}`;\n  const nameHtml = name\n    ? `<span class=\"so-wh-name\" title=\"${escapeAttr(name)}\">${escapeHtml(name)}</span>`\n    : \"\";\n  return `<td class=\"so-wh\"><span class=\"so-wh-chip is-${kind}\" title=\"${escapeAttr(title)}\">${escapeHtml(label)}</span>${nameHtml}</td>`;\n}\n\n/**\n * 操作状态列（v26.97）：直接显示 ERP 的 `operateStatusName`。\n * 「查询中....」等四种占位态走弱化样式 —— 取值与占位必须一眼能分开，\n * 否则「未查询」会被读成 ERP 说这个订单的状态就叫「未查询」。\n */\nfunction shippingOverdueOperateStatusCellHtml(record) {\n  const text = shippingOverdueOperateStatusText(record);\n  const placeholder = shippingOverdueOperateStatusIsPlaceholder(record);\n  const own = String((record && record.operate_status_title) || \"\").trim();\n  const tip = own || shippingOverdueOperateStatusTip(record);\n  const title = tip ? ` title=\"${escapeAttr(tip)}\"` : \"\";\n  return `<td class=\"so-operate\"><span class=\"so-operate-text${placeholder ? \" is-\" + String(record.operate_status_state || \"unchecked\") : \"\"}\"${title}>${escapeHtml(text)}</span></td>`;\n}\n\nfunction shippingOverdueRowHtml(record) {\n  const overdue = record.risk === \"overdue\";\n  const deadlineClass = overdue ? \"so-deadline so-deadline-overdue\" : \"so-deadline so-deadline-soon\";\n  const leftText = overdue\n    ? `已超时 ${shippingOverdueDurationText(record.overdue_seconds)}`\n    : `剩余 ${shippingOverdueDurationText(record.seconds_left)}`;\n  return `<tr>\n    <td class=\"so-order\">${record.order_id ? '<button type=\"button\" class=\"so-order-link\" data-order-id=\"' + escapeAttr(record.order_id) + '\" data-shop-id=\"' + escapeAttr(record.shop_id || \"\") + '\" title=\"点击查看该订单详情（与站内信里点订单详情完全一致）\">' + escapeHtml(record.order_id) + '</button>' : \"—\"}</td>\n    <td>${escapeHtml(record.shop_name || \"—\")}</td>\n    ${shippingOverdueWarehouseCellHtml(record)}\n    ${shippingOverdueSkuHtml(record)}\n    <td><span class=\"so-state\">${escapeHtml(record.order_state || \"—\")}</span></td>\n    ${shippingOverdueOperateStatusCellHtml(record)}\n    <td class=\"so-time\">${escapeHtml(record.created_beijing || \"—\")}</td>\n    <td class=\"${deadlineClass}\">${escapeHtml(record.deadline_beijing || \"—\")}</td>\n    <td class=\"so-left ${overdue ? \"is-overdue\" : \"is-soon\"}\">${escapeHtml(leftText)}</td>\n    <td class=\"so-amount\">${escapeHtml(shippingOverdueAmountText(record))}</td>\n  </tr>`;\n}\n\nfunction shippingOverdueEmptyText(kind) {\n  // v26.84：表格是被「店铺 × 仓库类型」两层筛过的 —— 筛空了要说明是**被筛空**的，\n  // 否则「没有已超时的待发货订单」会被读成「一单都没有」（上面统计卡明明写着 2）。\n  // v26.97：又多了「操作状态」一层，所以这里改成把**生效中的筛选**都列出来。\n  const label = shippingOverdueFilterLabelText();\n  if (label) return `${label}里没有${kind === \"overdue\" ? \"已超时\" : \"24 小时内即将超时\"}的待发货订单。`;\n  if (kind === \"overdue\") return \"没有已超时的待发货订单。\";\n  const next = (SHIPPING_OVERDUE_DATA || {}).next_deadline;\n  if (next && next.deadline_beijing) {\n    const shop = next.shop_name ? `${next.shop_name} ` : \"\";\n    return `24 小时内没有即将超时的订单；最近一单 ${shop}${next.order_id} 将于北京时间 ${next.deadline_beijing} 到期（剩余 ${shippingOverdueDurationText(next.seconds_left)}）。`;\n  }\n  return \"24 小时内没有即将超时的待发货订单。\";\n}\n\nfunction shippingOverdueTableHtml(kind, emptyText) {\n  const rows = shippingOverdueRecords(kind);\n  if (!rows.length) return `<div class=\"so-empty\">${escapeHtml(emptyText)}</div>`;\n  const leftHeader = kind === \"overdue\" ? \"已超时\" : \"剩余\";\n  return `<div class=\"so-table-wrap\"><table class=\"so-table\">\n    <thead><tr><th>订单号</th><th>店铺</th><th>仓库</th><th>SKU</th><th>订单状态</th><th>操作状态（ERP）</th><th>下单时间（北京）</th><th>发货截止（北京）</th><th>${leftHeader}</th><th>金额</th></tr></thead>\n    <tbody>${rows.map(shippingOverdueRowHtml).join(\"\")}</tbody>\n  </table></div>`;\n}\n\n/**\n * 仓库类型下拉 + 「待归类仓库」清单（v26.82）。\n * 清单只在**真的**有白名单外的仓库时出现：它是一条待办（等人工拍板），\n * 所以宁可空着，也不要天天挂一条「暂无」制造噪音。\n */\nfunction renderShippingOverdueWarehouseFilter(counts) {\n  const select = $(\"soWarehouse\");\n  if (select) {\n    const previous = String(SHIPPING_OVERDUE_WAREHOUSE_FILTER || \"\");\n    // 桶名只在 SHIPPING_OVERDUE_WH_FILTER_LABELS 里定义一次（改文案不会漏掉某处）\n    select.innerHTML = [`<option value=\"\">全部仓库类型</option>`]\n      .concat(SHIPPING_OVERDUE_WH_FILTERS.map((bucket) =>\n        `<option value=\"${bucket}\">${SHIPPING_OVERDUE_WH_FILTER_LABELS[bucket]}（${counts[bucket]}）</option>`))\n      .join(\"\");\n    select.value = SHIPPING_OVERDUE_WH_FILTERS.includes(previous) ? previous : \"\";\n    SHIPPING_OVERDUE_WAREHOUSE_FILTER = select.value;\n  }\n  const hint = $(\"soUnclassified\");\n  if (!hint) return;\n  const info = (SHIPPING_OVERDUE_DATA || {}).warehouse || {};\n  const list = Array.isArray(info.unclassified) ? info.unclassified : [];\n  if (!list.length) {\n    hint.innerHTML = \"\";\n    hint.hidden = true;\n    return;\n  }\n  const shown = list.slice(0, 6).map((item) => {\n    const name = String(item.name || \"\").trim() || \"(仓库名为空)\";\n    const id = String(item.id || \"\").trim() || \"空\";\n    return `<code>${escapeHtml(name)}</code>（id=${escapeHtml(id)}，${Number(item.count) || 0} 单）`;\n  });\n  const more = list.length > 6 ? `，等 ${list.length} 个` : \"\";\n  hint.innerHTML = `<b>待归类仓库 ${list.length} 个</b>：${shown.join(\"、\")}${more}。`\n    + `这些仓库不在归类白名单里，对应订单已标「未识别」，<b>没有</b>被强行算成海外或国内；`\n    + `确认归属后补进白名单即可生效（已缓存的数据不用重扫）。`;\n  hint.hidden = false;\n}\n\n/**\n * 操作状态下拉（v26.97）。\n * 选项**从当前可见范围里真实出现过的取值**生成，不写死一份枚举 —— ERP 的操作状态是平台数据，\n * 写死迟早对不上；顺带也让用户能直接筛出「查询中....」那批还没查到的。\n */\nfunction renderShippingOverdueOperateFilter() {\n  const select = $(\"soOperateStatus\");\n  if (!select) return;\n  const previous = String(SHIPPING_OVERDUE_OPERATE_FILTER || \"\");\n  const options = shippingOverdueOperateStatusCounts();\n  select.innerHTML = ['<option value=\"\">全部操作状态</option>']\n    .concat(options.map((item) =>\n      `<option value=\"${escapeAttr(item.text)}\">${escapeHtml(item.text)}（${item.count}）</option>`))\n    .join(\"\");\n  // 选中的取值在新数据里没有了（订单已发货 / 刚补拉完，那个桶空了）⇒ 退回「全部」，\n  // 否则表格会莫名其妙空着、下拉也选不中任何一项。\n  select.value = options.some((item) => item.text === previous) ? previous : \"\";\n  SHIPPING_OVERDUE_OPERATE_FILTER = select.value;\n}\n\nfunction renderShippingOverdue() {\n  const body = $(\"soBody\");\n  if (!body) return;\n  const data = SHIPPING_OVERDUE_DATA || {};\n  const select = $(\"soShop\");\n  if (select) {\n    const shops = Array.isArray(data.shops) ? data.shops : [];\n    const previous = String(SHIPPING_OVERDUE_SHOP_FILTER || \"\");\n    select.innerHTML = ['<option value=\"\">全部店铺</option>']\n      .concat(shops.map((shop) => `<option value=\"${escapeAttr(shop.shop_id)}\">${escapeHtml(shop.name || shop.shop_id)}</option>`))\n      .join(\"\");\n    select.value = shops.some((shop) => String(shop.shop_id) === previous) ? previous : \"\";\n    SHIPPING_OVERDUE_SHOP_FILTER = select.value;\n  }\n  // 统计卡（v26.84）：一律「当前店铺范围内的总数」，**不随仓库类型筛选变化**。\n  // 仓库维度的拆分已经由后面「海外仓 / 国内仓 / 未识别」三张卡给出；顶部再跟着仓库下拉\n  // 一起变，等于把同一份拆分统计了两遍，还会让人误读成「只剩 226 单即将超时」。\n  const overdueTotal = shippingOverdueScopedRecords(\"overdue\").length;\n  const dueSoonTotal = shippingOverdueScopedRecords(\"due_soon\").length;\n  // 表格仍按「店铺 × 仓库类型」两层筛选 —— 那才是仓库下拉的用途。\n  const overdue = shippingOverdueRecords(\"overdue\");\n  const dueSoon = shippingOverdueRecords(\"due_soon\");\n  // 仓库分布同样用「当前可见范围」而非表格当前筛选：选了「海外仓」之后，\n  // 国内仓的数量仍然应该看得见（否则筛选一开就丢掉了对照信息）。\n  const whCounts = shippingOverdueWarehouseCounts();\n  const stats = $(\"soStats\");\n  if (stats) {\n    stats.innerHTML = `\n      <div class=\"so-stat is-overdue\"><small>已超时</small><b>${overdueTotal}</b></div>\n      <div class=\"so-stat is-soon\"><small>24 小时内即将超时</small><b>${dueSoonTotal}</b></div>\n      <div class=\"so-stat\"><small>当前范围待发货</small><b>${shippingOverduePendingCount()}</b></div>\n      <div class=\"so-stat is-overseas\"><small>海外仓</small><b>${whCounts.overseas}</b></div>\n      <div class=\"so-stat is-domestic\"><small>国内仓</small><b>${whCounts.domestic}</b></div>\n      <div class=\"so-stat is-unknown\"><small>未识别 / 无单</small><b>${whCounts.unclassified}</b></div>`;\n  }\n  renderShippingOverdueWarehouseFilter(whCounts);\n  renderShippingOverdueOperateFilter();\n  // 分组标题带上当前生效的筛选名：统计卡是「总数」、标题是「筛选后条数」，\n  // 不标一句，两个数字会被读成对不上。（v26.97 起仓库与操作状态两个筛选都写进来。）\n  const filterLabels = [shippingOverdueWarehouseFilterLabel(), shippingOverdueOperateStatusFilterLabel()].filter(Boolean);\n  const filterSuffix = filterLabels.length ? ` · ${filterLabels.join(\" · \")}` : \"\";\n  body.innerHTML = `\n    <section class=\"so-group\">\n      <div class=\"so-group-head\"><span class=\"so-group-title is-overdue\">已超时${filterSuffix}</span><span class=\"so-group-count\">${overdue.length} 单</span></div>\n      ${shippingOverdueTableHtml(\"overdue\", shippingOverdueEmptyText(\"overdue\"))}\n    </section>\n    <section class=\"so-group\">\n      <div class=\"so-group-head\"><span class=\"so-group-title is-soon\">24 小时内即将超时${filterSuffix}</span><span class=\"so-group-count\">${dueSoon.length} 单</span></div>\n      ${shippingOverdueTableHtml(\"due_soon\", shippingOverdueEmptyText(\"due_soon\"))}\n    </section>`;\n}\n\nfunction shippingOverdueStatusText(payload) {\n  const counts = payload && payload.counts ? payload.counts : {};\n  const cache = payload && payload.cache ? payload.cache : {};\n  const warehouse = payload && payload.warehouse ? payload.warehouse : {};\n  const parts = [`已扫描 ${Number(counts.scanned_shops) || 0} 店`];\n  const failed = Number(counts.failed_shops) || 0;\n  if (failed) parts.push(`${failed} 店读取失败`);\n  const empty = Number(counts.empty_shops) || 0;\n  if (empty) parts.push(`${empty} 店无待发货订单`);\n  if (warehouse.source === \"erp\" && warehouse.ok) {\n    const distinct = Number(warehouse.orders_distinct) || 0;\n    parts.push(`ERP 仓库${warehouse.complete ? \"\" : \"（部分）\"}：${distinct} 单`);\n  } else if (warehouse.error) {\n    parts.push(`ERP 仓库未取到：${warehouse.error}`);\n  }\n  // v26.97：操作状态取到了几单要如实说 —— 「查询中....」满屏时用户得知道是还在查、还是查失败了。\n  const operate = payload && payload.operate_status ? payload.operate_status : {};\n  const operateTotal = Number(operate.total) || 0;\n  const operateLoaded = Number(counts.operate_status_loaded) || 0;\n  if (operate.pending) {\n    parts.push(\"ERP 操作状态：查询中....\");\n  } else if (operate.source === \"erp\" && operate.ok) {\n    parts.push(operateTotal && operateLoaded < operateTotal\n      ? `ERP 操作状态：${operateLoaded}/${operateTotal} 单`\n      : `ERP 操作状态：${operateLoaded} 单`);\n  } else if (operate.error) {\n    parts.push(`ERP 操作状态未取到：${operate.error}`);\n  }\n  parts.push(`数据时间：${cache.fetched_at_beijing || \"尚未同步\"}`);\n  if (cache.stale) parts.push(payload && payload.syncing ? \"正在后台刷新\" : \"数据已过期（可点刷新）\");\n  if (cache.last_error) parts.push(`最近失败：${cache.last_error}`);\n  return parts.join(\" · \");\n}\n\nasync function loadShippingOverdueData(options = {}) {\n  const requestId = ++SHIPPING_OVERDUE_LOAD_SEQ;\n  const tries = Number(options.followupTries) || 0;\n  const status = $(\"soStatus\");\n  if (status && !options.followup) {\n    status.textContent = options.refresh ? \"正在重新扫描各店待发货订单…\" : \"正在读取发货超时数据…\";\n    status.className = \"so-status\";\n  }\n  try {\n    const payload = await api(options.refresh ? \"/api/shipping-overdue?refresh=1\" : \"/api/shipping-overdue\");\n    if (requestId !== SHIPPING_OVERDUE_LOAD_SEQ) return;\n    SHIPPING_OVERDUE_DATA = payload;\n    renderShippingOverdue();\n    const cache = (payload && payload.cache) || {};\n    if (status) {\n      status.textContent = shippingOverdueStatusText(payload);\n      status.className = `so-status ${cache.last_error ? \"err\" : cache.stale ? \"warn\" : \"ok\"}`;\n    }\n    if (payload && payload.syncing && tries < SHIPPING_OVERDUE_FOLLOWUP_MAX_TRIES) {\n      // v26.97：跟进**可以再跟进** —— 以前只追一次，同步超过 1.5 秒就永远停在\n      // 「查询中....」（页面看着像坏了）。加一个次数上限兜住「同步卡死」时的无限轮询。\n      clearTimeout(SHIPPING_OVERDUE_FOLLOWUP_TIMER);\n      SHIPPING_OVERDUE_FOLLOWUP_TIMER = setTimeout(() => {\n        loadShippingOverdueData({ followup: true, followupTries: tries + 1 }).catch(() => {});\n      }, 1500);\n    }\n  } catch (error) {\n    if (requestId !== SHIPPING_OVERDUE_LOAD_SEQ) return;\n    if (status) {\n      status.textContent = `读取发货超时数据失败：${(error && error.message) || error}`;\n      status.className = \"so-status err\";\n    }\n  }\n}\n\nfunction initShippingOverduePage() {\n  const box = $(\"pageShippingOverdue\");\n  if (!box || SHIPPING_OVERDUE_READY) return;\n  SHIPPING_OVERDUE_READY = true;\n  box.innerHTML = `<div class=\"shipping-overdue operation-shell\">\n    <header class=\"so-header\">\n      <div><h2>发货超时警告</h2><div class=\"so-sub\">只读展示各店「已发货超时」与「24 小时内即将超时」的待发货订单，数据取自 Mirakl OR11 订单的发货截止时间（shipping_deadline）。所有时间已换算为北京时间（UTC+8）；已超时的订单截止时间标红。每行还会标明该单在 ERP 里落在哪个仓库，并归为「海外仓 / 国内仓」，便于按仓库类型分流处理；同时显示 ERP 里的订单操作状态，可单独筛选（这一列会延迟补上，见下方口径）。</div></div>\n    </header>\n    <div class=\"so-stats\" id=\"soStats\"></div>\n    <div class=\"so-filter-panel\">\n      <div class=\"so-filter-row\">\n        <div class=\"so-field\"><label>店铺</label><select id=\"soShop\" class=\"so-control\"><option value=\"\">全部店铺</option></select></div>\n        <div class=\"so-field\"><label>仓库类型</label><select id=\"soWarehouse\" class=\"so-control\"><option value=\"\">全部仓库类型</option></select></div>\n        <div class=\"so-field\"><label>操作状态（ERP）</label><select id=\"soOperateStatus\" class=\"so-control\"><option value=\"\">全部操作状态</option></select></div>\n        <div class=\"so-field-actions\"><button class=\"btn\" id=\"btnSoRefresh\">刷新</button></div>\n        <div class=\"so-status\" id=\"soStatus\"></div>\n      </div>\n      <div class=\"so-filter-hint\">口径：待发货 = 平台仍允许本店发货且存在未发货订单行；已超时 = 发货截止时间早于当前时间；即将超时 = 24 小时内到期。仓库类型取自 ERP 订单（按仓库 id 归类，海外仓 = 货已在境外、国内仓 = 货仍在国内）；未在白名单里的仓库一律标「未识别」，不会默认算成任何一类。顶部统计卡按当前店铺范围统计，不随仓库类型筛选变化（仓库维度的分布看「海外仓 / 国内仓 / 未识别」三张卡）；下面的表格才是同时受店铺、仓库类型与操作状态三层筛选的明细。「操作状态（ERP）」取自 ERP 订单的操作状态原文（与仓库信息同一次查询），<b>允许延迟展示</b>：缓存里还没有这一列时先全部显示「查询中....」，后台查到后自动改过来（不用手动刷新）；查不到的单标「未查询」/「ERP 无单」，与「这个订单的状态就叫未查询」是两回事。数据每天自动扫描一次（缓存 24 小时），打开页面即读本地快照，剩余时间按当前时间实时重算；需要立刻更新可点「刷新」。</div>\n      <div class=\"so-unclassified\" id=\"soUnclassified\" hidden></div>\n    </div>\n    <div id=\"soBody\"><div class=\"so-empty\">正在扫描各店待发货订单…</div></div>\n  </div>`;\n  $(\"soShop\").addEventListener(\"change\", () => {\n    SHIPPING_OVERDUE_SHOP_FILTER = $(\"soShop\").value;\n    renderShippingOverdue();\n  });\n  // v26.82：仓库类型筛选。只重渲染表格与统计，不重新请求 —— 数据已经在缓存里。\n  $(\"soWarehouse\").addEventListener(\"change\", () => {\n    SHIPPING_OVERDUE_WAREHOUSE_FILTER = $(\"soWarehouse\").value;\n    renderShippingOverdue();\n  });\n  // v26.97：ERP 操作状态筛选（同上，纯本地筛选）。\n  $(\"soOperateStatus\").addEventListener(\"change\", () => {\n    SHIPPING_OVERDUE_OPERATE_FILTER = $(\"soOperateStatus\").value;\n    renderShippingOverdue();\n  });\n  $(\"btnSoRefresh\").addEventListener(\"click\", () => {\n    loadShippingOverdueData({ refresh: true }).catch(() => {});\n  });\n  // v26.61：订单号可点 → 复用站内信那套订单详情抽屉（同一个 #orderDetailDrawer，已上移到全局层）。\n  // 用事件委托只绑一次：表格每次重渲染都会换掉整段 innerHTML，逐行绑会漏且泄漏监听。\n  $(\"soBody\").addEventListener(\"click\", (event) => {\n    const trigger = event.target.closest(\".so-order-link\");\n    if (!trigger) return;\n    openOrderDetail(trigger.dataset.orderId, trigger.dataset.shopId, { source: \"shipping-overdue\" });\n  });\n  // 默认选中当前全局店铺；该店不在可选列表里时渲染时会退回「全部店铺」。\n  SHIPPING_OVERDUE_SHOP_FILTER = String(GLOBAL_SHOP || \"\").trim();\n  loadShippingOverdueData().catch(() => {});\n}\n\n// ---- 双仓退货登记 ----\nconst RETURN_REGISTRATION_STATUS_LABELS = { pending: \"待处理\", done: \"已完成\", no_return: \"未寄出\" };\nconst RETURN_REGISTRATION_ARRIVAL_LABELS = { unknown: \"待检查\", arrived: \"已到仓\", not_found: \"本次未匹配\", error: \"检查失败\" };\nlet RETURN_REGISTRATION_READY = false;\nlet RETURN_REGISTRATION_DATA = null;\nlet RETURN_REGISTRATION_SELECTED_WAREHOUSE = \"DEBUYCN\";\nlet RETURN_REGISTRATION_SELECTED_IDS = new Set();\nlet RETURN_REGISTRATION_EDITING_ID = \"\";\nlet RETURN_REGISTRATION_BUSY = false;\n\nfunction returnRegistrationCurrentWarehouse() {\n  const warehouses = RETURN_REGISTRATION_DATA && Array.isArray(RETURN_REGISTRATION_DATA.warehouses)\n    ? RETURN_REGISTRATION_DATA.warehouses\n    : [];\n  return warehouses.find((warehouse) => String(warehouse.id) === RETURN_REGISTRATION_SELECTED_WAREHOUSE)\n    || { id: RETURN_REGISTRATION_SELECTED_WAREHOUSE, name: RETURN_REGISTRATION_SELECTED_WAREHOUSE === \"DEBUYCN\" ? \"DEBUYCN仓\" : \"DGSC12\", records: [], summary: {} };\n}\n\nfunction returnRegistrationCurrentRecords() {\n  const records = returnRegistrationCurrentWarehouse().records;\n  return Array.isArray(records) ? records : [];\n}\n\nfunction returnRegistrationSetStatus(message, tone = \"\") {\n  const status = $(\"rrStatus\");\n  if (!status) return;\n  status.textContent = String(message || \"\");\n  status.className = `rr-status ${tone}`.trim();\n}\n\nfunction returnRegistrationApplyWarehouse(warehouse) {\n  if (!warehouse || !warehouse.id) return;\n  if (!RETURN_REGISTRATION_DATA || !Array.isArray(RETURN_REGISTRATION_DATA.warehouses)) {\n    RETURN_REGISTRATION_DATA = { ok: true, default_warehouse_id: \"DEBUYCN\", warehouses: [] };\n  }\n  const warehouses = RETURN_REGISTRATION_DATA.warehouses;\n  const index = warehouses.findIndex((item) => String(item.id) === String(warehouse.id));\n  if (index >= 0) warehouses[index] = warehouse;\n  else warehouses.push(warehouse);\n}\n\nfunction returnRegistrationSummary(warehouse) {\n  const records = Array.isArray(warehouse.records) ? warehouse.records : [];\n  const summary = warehouse.summary && typeof warehouse.summary === \"object\" ? warehouse.summary : {};\n  const count = (name, fallback) => Number.isFinite(Number(summary[name])) ? Number(summary[name]) : fallback;\n  return {\n    total: count(\"total\", records.length),\n    pending: count(\"pending\", records.filter((record) => record.status === \"pending\").length),\n    done: count(\"done\", records.filter((record) => record.status === \"done\").length),\n    no_return: count(\"no_return\", records.filter((record) => record.status === \"no_return\").length),\n    arrived: count(\"arrived\", records.filter((record) => record.arrival_status === \"arrived\").length),\n  };\n}\n\nfunction returnRegistrationFormatDate(value) {\n  if (!value) return \"—\";\n  const date = new Date(value);\n  return Number.isFinite(date.getTime()) ? date.toLocaleString(\"zh-CN\") : String(value);\n}\n\nfunction returnRegistrationStatusClass(value) {\n  return Object.prototype.hasOwnProperty.call(RETURN_REGISTRATION_STATUS_LABELS, value) ? value : \"pending\";\n}\n\nfunction returnRegistrationArrivalClass(value) {\n  if (value === \"not_found\") return \"not-found\";\n  return Object.prototype.hasOwnProperty.call(RETURN_REGISTRATION_ARRIVAL_LABELS, value) ? value : \"unknown\";\n}\n\nfunction renderReturnRegistration() {\n  const warehouse = returnRegistrationCurrentWarehouse();\n  const records = returnRegistrationCurrentRecords();\n  const summary = returnRegistrationSummary(warehouse);\n  const selected = new Set(records.map((record) => String(record.id)));\n  RETURN_REGISTRATION_SELECTED_IDS = new Set([...RETURN_REGISTRATION_SELECTED_IDS].filter((id) => selected.has(id)));\n  const tabs = document.querySelectorAll(\"[data-return-warehouse]\");\n  tabs.forEach((tab) => {\n    const active = tab.dataset.returnWarehouse === RETURN_REGISTRATION_SELECTED_WAREHOUSE;\n    tab.classList.toggle(\"active\", active);\n    tab.setAttribute(\"aria-selected\", active ? \"true\" : \"false\");\n  });\n  const title = $(\"rrWarehouseTitle\");\n  if (title) title.textContent = `${warehouse.name || warehouse.id}登记记录`;\n  const summaryNode = $(\"rrSummary\");\n  if (summaryNode) {\n    summaryNode.innerHTML = `<span>全部 <b>${summary.total}</b></span><span class=\"rr-summary-divider\">·</span><span>待处理 <b>${summary.pending}</b></span><span class=\"rr-summary-divider\">·</span><span>已完成 <b>${summary.done}</b></span><span class=\"rr-summary-divider\">·</span><span>未寄出 <b>${summary.no_return}</b></span><span class=\"rr-summary-divider\">·</span><span>已到仓 <b>${summary.arrived}</b></span>`;\n  }\n  const count = $(\"rrCount\");\n  if (count) count.textContent = `当前 ${records.length} 条 · ${warehouse.last_checked_at ? `最近检查 ${returnRegistrationFormatDate(warehouse.last_checked_at)}` : \"尚未检查到仓\"}`;\n  const selectAll = $(\"rrSelectAll\");\n  if (selectAll) {\n    selectAll.checked = records.length > 0 && records.every((record) => RETURN_REGISTRATION_SELECTED_IDS.has(String(record.id)));\n    selectAll.indeterminate = !selectAll.checked && RETURN_REGISTRATION_SELECTED_IDS.size > 0;\n    selectAll.disabled = RETURN_REGISTRATION_BUSY || records.length === 0;\n  }\n  const hasSelected = RETURN_REGISTRATION_SELECTED_IDS.size > 0;\n  for (const id of [\"btnRrComplete\", \"btnRrNoReturn\", \"btnRrRemove\"]) {\n    const button = $(id);\n    if (button) button.disabled = RETURN_REGISTRATION_BUSY || !hasSelected;\n  }\n  const clearButton = $(\"btnRrClear\");\n  if (clearButton) clearButton.disabled = RETURN_REGISTRATION_BUSY || records.length === 0;\n  const copyButton = $(\"btnRrCopy\");\n  if (copyButton) copyButton.disabled = RETURN_REGISTRATION_BUSY || records.length === 0;\n  const matchButton = $(\"btnRrMatchWms\");\n  if (matchButton) matchButton.disabled = RETURN_REGISTRATION_BUSY;\n  const addButton = $(\"btnReturnRegistrationAdd\");\n  if (addButton) {\n    addButton.disabled = RETURN_REGISTRATION_BUSY;\n    addButton.textContent = RETURN_REGISTRATION_EDITING_ID ? \"保存修改\" : \"登记退件\";\n  }\n  const cancelEdit = $(\"btnRrCancelEdit\");\n  if (cancelEdit) cancelEdit.classList.toggle(\"hidden\", !RETURN_REGISTRATION_EDITING_ID);\n  const wrap = $(\"rrTableWrap\");\n  if (!wrap) return;\n  if (!records.length) {\n    wrap.innerHTML = `<div class=\"rr-empty\">${RETURN_REGISTRATION_BUSY ? \"正在处理…\" : `暂无${escapeHtml(warehouse.name || \"当前仓库\")}退货登记记录。`}</div>`;\n    return;\n  }\n  wrap.innerHTML = `<table class=\"rr-table\">\n    <thead><tr><th class=\"rr-check\">选择</th><th>订单号</th><th>物流号</th><th>SKU</th><th>状态</th><th>到仓状态</th><th>登记时间</th><th>备注 / 匹配信息</th><th>操作</th></tr></thead>\n    <tbody>${records.map((record) => {\n      const id = String(record.id || \"\");\n      const orderNo = String(record.order_no || \"\");\n      const trackingNo = String(record.tracking_no || \"\");\n      const sku = String(record.sku || \"\");\n      const note = String(record.note || \"\");\n      const matched = record.matched_record && typeof record.matched_record === \"object\" ? record.matched_record : null;\n      const matchedText = matched ? `WMS：${matched.status_label || (matched.arrived ? \"已到仓\" : \"已匹配未签收\")}${matched.sku ? ` · ${matched.sku}` : \"\"}` : \"\";\n      const detail = [note, matchedText].filter(Boolean).join(\"；\");\n      const statusValue = String(record.status || \"pending\");\n      const arrivalValue = String(record.arrival_status || \"unknown\");\n      return `<tr>\n        <td class=\"rr-check\"><input type=\"checkbox\" data-rr-select=\"${escapeAttr(id)}\" ${RETURN_REGISTRATION_SELECTED_IDS.has(id) ? \"checked\" : \"\"} ${RETURN_REGISTRATION_BUSY ? \"disabled\" : \"\"}></td>\n        <td class=\"rr-mono\">${escapeHtml(orderNo || \"—\")}</td>\n        <td class=\"rr-mono\">${escapeHtml(trackingNo || \"—\")}</td>\n        <td>${escapeHtml(sku || \"—\")}</td>\n        <td><span class=\"rr-status-pill ${returnRegistrationStatusClass(statusValue)}\">${escapeHtml(RETURN_REGISTRATION_STATUS_LABELS[statusValue] || statusValue)}</span></td>\n        <td><span class=\"rr-arrival-pill ${returnRegistrationArrivalClass(arrivalValue)}\" title=\"${escapeAttr(record.arrival_checked_at ? `检查于 ${returnRegistrationFormatDate(record.arrival_checked_at)}` : \"尚未检查\")}\">${escapeHtml(RETURN_REGISTRATION_ARRIVAL_LABELS[arrivalValue] || arrivalValue)}</span></td>\n        <td class=\"rr-meta-cell\">${escapeHtml(returnRegistrationFormatDate(record.registered_at))}</td>\n        <td class=\"rr-note-cell\" title=\"${escapeAttr(detail)}\">${escapeHtml(detail || \"—\")}</td>\n        <td><div class=\"rr-row-actions\"><button class=\"rr-row-action\" type=\"button\" data-rr-edit=\"${escapeAttr(id)}\">编辑</button></div></td>\n      </tr>`;\n    }).join(\"\")}</tbody>\n  </table>`;\n}\n\nasync function loadReturnRegistration() {\n  const status = $(\"rrStatus\");\n  if (status) {\n    status.textContent = \"正在读取本地登记记录…\";\n    status.className = \"rr-status\";\n  }\n  try {\n    const payload = await api(\"/api/return-registration\");\n    RETURN_REGISTRATION_DATA = payload;\n    const warehouses = Array.isArray(payload && payload.warehouses) ? payload.warehouses : [];\n    const defaultId = String(payload && payload.default_warehouse_id || \"DEBUYCN\").trim().toUpperCase();\n    if (!warehouses.some((warehouse) => String(warehouse.id) === RETURN_REGISTRATION_SELECTED_WAREHOUSE)) {\n      RETURN_REGISTRATION_SELECTED_WAREHOUSE = warehouses.some((warehouse) => String(warehouse.id) === defaultId) ? defaultId : \"DEBUYCN\";\n    }\n    renderReturnRegistration();\n    returnRegistrationSetStatus(\"已读取本地登记记录\", \"ok\");\n  } catch (error) {\n    renderReturnRegistration();\n    returnRegistrationSetStatus(`读取退货登记失败：${(error && error.message) || error}`, \"err\");\n  }\n}\n\nfunction setReturnRegistrationWarehouse(warehouseId) {\n  const id = String(warehouseId || \"\").trim().toUpperCase();\n  if (![\"DEBUYCN\", \"DGSC12\"].includes(id)) return;\n  RETURN_REGISTRATION_SELECTED_WAREHOUSE = id;\n  RETURN_REGISTRATION_SELECTED_IDS.clear();\n  RETURN_REGISTRATION_EDITING_ID = \"\";\n  const form = $(\"rrForm\");\n  if (form) form.reset();\n  renderReturnRegistration();\n  returnRegistrationSetStatus(`已切换到${id === \"DEBUYCN\" ? \"DEBUYCN仓\" : \"DGSC12\"}`, \"ok\");\n}\n\nfunction clearReturnRegistrationForm() {\n  const form = $(\"rrForm\");\n  if (form) form.reset();\n  RETURN_REGISTRATION_EDITING_ID = \"\";\n  renderReturnRegistration();\n}\n\nfunction editReturnRegistrationRecord(id) {\n  const record = returnRegistrationCurrentRecords().find((item) => String(item.id) === String(id));\n  if (!record) return;\n  RETURN_REGISTRATION_EDITING_ID = String(record.id);\n  $(\"rrOrderNo\").value = record.order_no || \"\";\n  $(\"rrTrackingNo\").value = record.tracking_no || \"\";\n  $(\"rrSku\").value = record.sku || \"\";\n  $(\"rrNote\").value = record.note || \"\";\n  renderReturnRegistration();\n  $(\"rrOrderNo\").focus();\n}\n\nasync function submitReturnRegistrationRecord(event) {\n  event.preventDefault();\n  if (RETURN_REGISTRATION_BUSY) return;\n  const orderNo = String($(\"rrOrderNo\").value || \"\").trim();\n  const trackingNo = String($(\"rrTrackingNo\").value || \"\").trim();\n  const body = {\n    order_no: orderNo,\n    tracking_no: trackingNo,\n    sku: String($(\"rrSku\").value || \"\").trim(),\n    note: String($(\"rrNote\").value || \"\").trim(),\n  };\n  if (!orderNo && !trackingNo) {\n    returnRegistrationSetStatus(\"订单号或物流号至少填写一个\", \"warn\");\n    $(\"rrOrderNo\").focus();\n    return;\n  }\n  RETURN_REGISTRATION_BUSY = true;\n  renderReturnRegistration();\n  const warehouseId = RETURN_REGISTRATION_SELECTED_WAREHOUSE;\n  const encodedWarehouse = encodeURIComponent(warehouseId);\n  const editingId = RETURN_REGISTRATION_EDITING_ID;\n  const endpoint = editingId\n    ? `/api/return-registration/${encodedWarehouse}/records/${encodeURIComponent(editingId)}`\n    : `/api/return-registration/${encodedWarehouse}/records`;\n  try {\n    const payload = await api(endpoint, {\n      method: editingId ? \"PATCH\" : \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify(body),\n    });\n    returnRegistrationApplyWarehouse(payload.warehouse);\n    RETURN_REGISTRATION_SELECTED_IDS.clear();\n    clearReturnRegistrationForm();\n    returnRegistrationSetStatus(editingId ? \"退货登记已更新\" : \"退货登记已保存\", \"ok\");\n  } catch (error) {\n    returnRegistrationSetStatus(`保存退货登记失败：${(error && error.message) || error}`, \"err\");\n  } finally {\n    RETURN_REGISTRATION_BUSY = false;\n    renderReturnRegistration();\n  }\n}\n\nasync function runReturnRegistrationBatch(action) {\n  if (RETURN_REGISTRATION_BUSY) return;\n  const ids = [...RETURN_REGISTRATION_SELECTED_IDS];\n  if (!ids.length) {\n    returnRegistrationSetStatus(\"请先选择要处理的记录\", \"warn\");\n    return;\n  }\n  const labels = { complete: \"批量标记为已完成\", \"no-return\": \"批量标记为未寄出\", remove: \"删除选中的记录\" };\n  if (!confirm(`确认${labels[action] || \"处理选中记录\"}？\\n\\n当前仓库：${returnRegistrationCurrentWarehouse().name || RETURN_REGISTRATION_SELECTED_WAREHOUSE}\\n记录数：${ids.length}`)) return;\n  RETURN_REGISTRATION_BUSY = true;\n  renderReturnRegistration();\n  try {\n    const payload = await api(`/api/return-registration/${encodeURIComponent(RETURN_REGISTRATION_SELECTED_WAREHOUSE)}/${action}`, {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ ids }),\n    });\n    returnRegistrationApplyWarehouse(payload.warehouse);\n    RETURN_REGISTRATION_SELECTED_IDS.clear();\n    const count = action === \"complete\" ? payload.completed_count : action === \"no-return\" ? payload.no_return_count : payload.removed_count;\n    returnRegistrationSetStatus(`${labels[action]}完成：${Number(count || 0)} 条`, \"ok\");\n  } catch (error) {\n    returnRegistrationSetStatus(`操作失败：${(error && error.message) || error}`, \"err\");\n  } finally {\n    RETURN_REGISTRATION_BUSY = false;\n    renderReturnRegistration();\n  }\n}\n\nasync function clearReturnRegistrationRecords() {\n  if (RETURN_REGISTRATION_BUSY || !returnRegistrationCurrentRecords().length) return;\n  if (!confirm(`确认清空${returnRegistrationCurrentWarehouse().name || \"当前仓库\"}的全部退货登记记录？\\n\\n清空后不能自动恢复。`)) return;\n  RETURN_REGISTRATION_BUSY = true;\n  renderReturnRegistration();\n  try {\n    const payload = await api(`/api/return-registration/${encodeURIComponent(RETURN_REGISTRATION_SELECTED_WAREHOUSE)}/clear`, { method: \"POST\" });\n    returnRegistrationApplyWarehouse(payload.warehouse);\n    RETURN_REGISTRATION_SELECTED_IDS.clear();\n    returnRegistrationSetStatus(`已清空 ${Number(payload.removed_count || 0)} 条登记记录`, \"ok\");\n  } catch (error) {\n    returnRegistrationSetStatus(`清空失败：${(error && error.message) || error}`, \"err\");\n  } finally {\n    RETURN_REGISTRATION_BUSY = false;\n    renderReturnRegistration();\n  }\n}\n\nasync function copyReturnRegistrationRecords() {\n  if (RETURN_REGISTRATION_BUSY) return;\n  const records = returnRegistrationCurrentRecords();\n  const selected = RETURN_REGISTRATION_SELECTED_IDS.size\n    ? records.filter((record) => RETURN_REGISTRATION_SELECTED_IDS.has(String(record.id)))\n    : records;\n  const content = selected.map((record) => `${record.order_no || \"\"}\\t${record.tracking_no || \"\"}`).join(\"\\n\");\n  if (!content) {\n    returnRegistrationSetStatus(\"没有可复制的记录\", \"warn\");\n    return;\n  }\n  try {\n    if (navigator.clipboard && typeof navigator.clipboard.writeText === \"function\") {\n      await navigator.clipboard.writeText(content);\n    } else {\n      const textarea = document.createElement(\"textarea\");\n      textarea.value = content;\n      textarea.style.position = \"fixed\";\n      textarea.style.opacity = \"0\";\n      document.body.appendChild(textarea);\n      textarea.select();\n      document.execCommand(\"copy\");\n      textarea.remove();\n    }\n    returnRegistrationSetStatus(`已复制 ${selected.length} 条订单号和物流号`, \"ok\");\n  } catch (error) {\n    returnRegistrationSetStatus(`复制失败：${(error && error.message) || error}`, \"err\");\n  }\n}\n\nasync function matchReturnRegistrationWms() {\n  if (RETURN_REGISTRATION_BUSY) return;\n  RETURN_REGISTRATION_BUSY = true;\n  renderReturnRegistration();\n  returnRegistrationSetStatus(\"正在读取 WMS 退件并匹配…\");\n  try {\n    const payload = await api(`/api/return-registration/${encodeURIComponent(RETURN_REGISTRATION_SELECTED_WAREHOUSE)}/match-wms`, {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({}),\n    });\n    returnRegistrationApplyWarehouse(payload.warehouse);\n    returnRegistrationSetStatus(`检查完成：已检查 ${Number(payload.checked_count || 0)} 条，已到仓 ${Number(payload.arrived_count || 0)} 条，本次未匹配 ${Number(payload.not_found_count || 0)} 条`, \"ok\");\n  } catch (error) {\n    returnRegistrationSetStatus(`WMS匹配失败：${(error && error.message) || error}`, \"err\");\n  } finally {\n    RETURN_REGISTRATION_BUSY = false;\n    renderReturnRegistration();\n  }\n}\n\nfunction initReturnRegistrationPage() {\n  const box = $(\"pageReturnRegistration\");\n  if (!box || RETURN_REGISTRATION_READY) return;\n  RETURN_REGISTRATION_READY = true;\n  box.innerHTML = `<div class=\"return-registration operation-shell\">\n    <header class=\"rr-header\">\n      <div><h2>退货登记</h2><div class=\"rr-sub\">按仓库分别登记买家退件，记录状态与 WMS 到仓匹配结果。两个仓库的数据完全独立。</div><div id=\"rrSummary\" class=\"rr-summary\"></div></div>\n      <div class=\"rr-note\" id=\"rrWarehouseTitle\">正在读取登记记录…</div>\n    </header>\n    <div class=\"rr-warehouse-tabs\" role=\"tablist\" aria-label=\"退货登记仓库\">\n      <button type=\"button\" class=\"rr-warehouse-tab active\" data-return-warehouse=\"DEBUYCN\" role=\"tab\" aria-selected=\"true\">DEBUYCN仓</button>\n      <button type=\"button\" class=\"rr-warehouse-tab\" data-return-warehouse=\"DGSC12\" role=\"tab\" aria-selected=\"false\">DGSC12</button>\n    </div>\n    <section class=\"rr-form-panel\">\n      <form id=\"rrForm\" class=\"rr-form\">\n        <div class=\"rr-field\"><label for=\"rrOrderNo\">订单号</label><input id=\"rrOrderNo\" class=\"rr-control\" maxlength=\"128\" autocomplete=\"off\" placeholder=\"请输入订单号\"></div>\n        <div class=\"rr-field\"><label for=\"rrTrackingNo\">物流号</label><input id=\"rrTrackingNo\" class=\"rr-control\" maxlength=\"128\" autocomplete=\"off\" placeholder=\"请输入物流号\"></div>\n        <div class=\"rr-field\"><label for=\"rrSku\">SKU</label><input id=\"rrSku\" class=\"rr-control\" maxlength=\"128\" autocomplete=\"off\" placeholder=\"可选\"></div>\n        <div class=\"rr-field rr-field-wide\"><label for=\"rrNote\">备注</label><textarea id=\"rrNote\" class=\"rr-control\" rows=\"1\" maxlength=\"1000\" placeholder=\"可选，鼠标移到表格备注可查看全文\"></textarea></div>\n        <div class=\"rr-form-actions\"><button class=\"btn primary\" id=\"btnReturnRegistrationAdd\" type=\"submit\">登记退件</button><button class=\"btn hidden\" id=\"btnRrCancelEdit\" type=\"button\">取消编辑</button><span class=\"rr-form-hint\">订单号和物流号至少填写一个；物流号会自动去空格、连字符并转为大写。</span></div>\n      </form>\n    </section>\n    <section class=\"rr-table-panel\">\n      <div class=\"rr-action-bar\">\n        <label class=\"rr-select-all\"><input id=\"rrSelectAll\" type=\"checkbox\"> 全选当前仓库</label>\n        <span id=\"rrCount\" class=\"rr-count\">等待加载…</span>\n        <span id=\"rrStatus\" class=\"rr-status\"></span>\n        <button class=\"btn\" id=\"btnRrComplete\" type=\"button\" disabled>批量完成</button>\n        <button class=\"btn\" id=\"btnRrNoReturn\" type=\"button\" disabled>标记未寄出</button>\n        <button class=\"btn\" id=\"btnRrRemove\" type=\"button\" disabled>删除选中</button>\n        <button class=\"btn\" id=\"btnRrCopy\" type=\"button\" disabled>复制两列</button>\n        <button class=\"btn\" id=\"btnRrClear\" type=\"button\" disabled>清空当前仓</button>\n        <button class=\"btn primary\" id=\"btnRrMatchWms\" type=\"button\">检查到仓</button>\n      </div>\n      <div id=\"rrTableWrap\" class=\"rr-table-wrap\"><div class=\"rr-empty\">正在加载退货登记…</div></div>\n    </section>\n  </div>`;\n  document.querySelectorAll(\"[data-return-warehouse]\").forEach((tab) => {\n    tab.addEventListener(\"click\", () => setReturnRegistrationWarehouse(tab.dataset.returnWarehouse));\n  });\n  $(\"rrForm\").addEventListener(\"submit\", submitReturnRegistrationRecord);\n  $(\"btnRrCancelEdit\").addEventListener(\"click\", clearReturnRegistrationForm);\n  $(\"rrSelectAll\").addEventListener(\"change\", (event) => {\n    const records = returnRegistrationCurrentRecords();\n    RETURN_REGISTRATION_SELECTED_IDS = event.target.checked ? new Set(records.map((record) => String(record.id))) : new Set();\n    renderReturnRegistration();\n  });\n  $(\"btnRrComplete\").addEventListener(\"click\", () => runReturnRegistrationBatch(\"complete\"));\n  $(\"btnRrNoReturn\").addEventListener(\"click\", () => runReturnRegistrationBatch(\"no-return\"));\n  $(\"btnRrRemove\").addEventListener(\"click\", () => runReturnRegistrationBatch(\"remove\"));\n  $(\"btnRrCopy\").addEventListener(\"click\", copyReturnRegistrationRecords);\n  $(\"btnRrClear\").addEventListener(\"click\", clearReturnRegistrationRecords);\n  $(\"btnRrMatchWms\").addEventListener(\"click\", matchReturnRegistrationWms);\n  $(\"rrTableWrap\").addEventListener(\"change\", (event) => {\n    const checkbox = event.target.closest(\"[data-rr-select]\");\n    if (!checkbox) return;\n    const id = String(checkbox.dataset.rrSelect || \"\");\n    if (checkbox.checked) RETURN_REGISTRATION_SELECTED_IDS.add(id);\n    else RETURN_REGISTRATION_SELECTED_IDS.delete(id);\n    renderReturnRegistration();\n  });\n  $(\"rrTableWrap\").addEventListener(\"click\", (event) => {\n    const edit = event.target.closest(\"[data-rr-edit]\");\n    if (edit) editReturnRegistrationRecord(edit.dataset.rrEdit);\n  });\n  renderReturnRegistration();\n  loadReturnRegistration().catch(() => {});\n}\n\nconst AGENT_OPEN = new Set();\n\nfunction initAgentPage() {\n  const box = $(\"pageAgent\");\n  if (!box || box.dataset.ready === \"1\") return;\n  box.dataset.ready = \"1\";\n  box.innerHTML = `<div class=\"agent-shell\">\n    <div class=\"agent-head\">\n      <div>\n        <h2>AI 任务</h2>\n        <p>把活派给本机 WorkBuddy 的 Agent 去做（拉数据、跑技能、生成文件）。任务在你自己的电脑上执行，工作目录是本工作台项目根目录。</p>\n      </div>\n      <div class=\"agent-bridge\" id=\"agentBridge\"><span class=\"dot\"></span><span id=\"agentBridgeText\">正在检测…</span></div>\n    </div>\n    <div class=\"agent-panel\">\n      <h3>发起任务</h3>\n      <div class=\"agent-presets\" id=\"agentPresets\"></div>\n      <textarea id=\"agentPrompt\" class=\"agent-input\" placeholder=\"用一句话说清楚要做什么，例如：从 ERP 拉取 2026-08-30 至 2026-08-31 的订单导出，保存为 xlsx 并告诉我行数。\"></textarea>\n      <div class=\"agent-row\">\n        <button class=\"btn primary\" id=\"btnAgentRun\" type=\"button\">执行任务</button>\n        <button class=\"btn\" id=\"btnAgentRefresh\" type=\"button\">刷新列表</button>\n        <span class=\"spacer\"></span>\n        <label class=\"agent-field\">超时（分钟）<input id=\"agentTimeout\" type=\"number\" min=\"1\" max=\"30\" value=\"10\" style=\"width:64px\"></label>\n      </div>\n      <div class=\"agent-hint\">任务最长 30 分钟，同时最多跑 2 个。需要登录的业务系统（如 ERP）请保持登录态；凭证过期时 Agent 会如实报错而不会编造数据。</div>\n    </div>\n    <div class=\"agent-panel\">\n      <h3>任务记录</h3>\n      <div class=\"agent-list\" id=\"agentList\"><div class=\"agent-empty\">暂无任务</div></div>\n    </div>\n  </div>`;\n  $(\"agentPresets\").innerHTML = AGENT_PRESETS\n    .map((p, i) => `<button class=\"agent-preset\" type=\"button\" data-i=\"${i}\">${escapeHtml(p.label)}</button>`)\n    .join(\"\");\n  $(\"agentPresets\").addEventListener(\"click\", (event) => {\n    const btn = event.target.closest(\".agent-preset\");\n    if (!btn) return;\n    const preset = AGENT_PRESETS[Number(btn.dataset.i)];\n    if (preset) $(\"agentPrompt\").value = preset.prompt;\n  });\n  $(\"btnAgentRun\").addEventListener(\"click\", submitAgentTask);\n  $(\"btnAgentRefresh\").addEventListener(\"click\", () => refreshAgentTasks(true));\n  loadAgentBridge();\n  refreshAgentTasks(true);\n  if (!AGENT_POLL_TIMER) AGENT_POLL_TIMER = setInterval(() => refreshAgentTasks(false), 2500);\n}\n\nasync function loadAgentBridge() {\n  try {\n    AGENT_BRIDGE = await api(\"/api/agent/status\");\n  } catch (e) {\n    AGENT_BRIDGE = { available: false, note: String((e && e.message) || e) };\n  }\n  const badge = $(\"agentBridge\");\n  const text = $(\"agentBridgeText\");\n  if (!badge || !text) return;\n  const ok = !!(AGENT_BRIDGE && AGENT_BRIDGE.available);\n  badge.classList.toggle(\"bad\", !ok);\n  text.textContent = ok\n    ? `已连接 CodeBuddy CLI · 运行中 ${AGENT_BRIDGE.running || 0}/${AGENT_BRIDGE.maxConcurrent || 2}`\n    : `不可用：${AGENT_BRIDGE.note || \"未找到 CLI\"}`;\n}\n\nasync function submitAgentTask() {\n  const input = $(\"agentPrompt\");\n  const prompt = String((input && input.value) || \"\").trim();\n  if (!prompt) {\n    alert(\"请先填写任务内容\");\n    return;\n  }\n  const btn = $(\"btnAgentRun\");\n  btn.disabled = true;\n  btn.textContent = \"提交中…\";\n  try {\n    const timeoutMs = Math.min(Math.max(Number(($(\"agentTimeout\") || {}).value || 10, 1), 30)) * 60 * 1000;\n    const res = await api(\"/api/agent/run\", {\n      method: \"POST\",\n      headers: { \"Content-Type\": \"application/json\" },\n      body: JSON.stringify({ prompt, timeoutMs }),\n    });\n    if (input) input.value = \"\";\n    AGENT_OPEN.add(res.id);\n    await refreshAgentTasks(true);\n  } catch (e) {\n    alert(\"任务提交失败：\" + ((e && e.message) || e));\n  } finally {\n    btn.disabled = false;\n    btn.textContent = \"执行任务\";\n  }\n}\n\nasync function refreshAgentTasks(force) {\n  const list = $(\"agentList\");\n  if (!list) return;\n  try {\n    const data = await api(\"/api/agent/tasks\");\n    AGENT_TASKS = data.tasks || [];\n  } catch (e) {\n    if (!AGENT_TASKS.length) {\n      list.innerHTML = `<div class=\"agent-empty\">读取任务失败：${escapeHtml((e && e.message) || e)}</div>`;\n      return;\n    }\n  }\n  renderAgentTasks();\n  if (force) loadAgentBridge();\n}\n\nfunction agentStatusLabel(status) {\n  if (status === \"running\") return \"执行中\";\n  if (status === \"done\") return \"已完成\";\n  if (status === \"failed\") return \"失败\";\n  return status || \"未知\";\n}\n\nfunction agentDuration(ms) {\n  const s = Math.max(0, Math.round((ms || 0) / 1000));\n  if (s < 60) return s + \" 秒\";\n  return Math.floor(s / 60) + \" 分 \" + (s % 60) + \" 秒\";\n}\n\nfunction renderAgentTasks() {\n  const list = $(\"agentList\");\n  if (!list) return;\n  if (!AGENT_TASKS.length) {\n    list.innerHTML = `<div class=\"agent-empty\">暂无任务。选一个预置任务，或直接在上方描述你要做的事。</div>`;\n    return;\n  }\n  list.innerHTML = AGENT_TASKS.map((t) => {\n    const open = AGENT_OPEN.has(t.id) || t.status === \"running\";\n    const logs = (t.logs || []).slice(-60).map((l) => {\n      const d = new Date(l.at);\n      const pad = (n) => String(n).padStart(2, \"0\");\n      return `<div class=\"agent-log\"><span class=\"t\">${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}</span><span>${escapeHtml(l.text)}</span></div>`;\n    }).join(\"\");\n    const body = `\n      ${t.error ? `<div class=\"agent-error\">${escapeHtml(t.error)}</div>` : \"\"}\n      ${t.result ? `<div class=\"agent-result\">${escapeHtml(t.result)}</div>` : \"\"}\n      ${!t.result && !t.error && t.status === \"running\" ? `<div class=\"agent-result\">Agent 正在执行，实时进度见下方日志…</div>` : \"\"}\n      ${logs ? `<div class=\"agent-logs\">${logs}</div>` : \"\"}\n      <div class=\"agent-row\">\n        ${t.status === \"running\" ? `<button class=\"btn\" type=\"button\" data-cancel=\"${escapeAttr(t.id)}\">取消任务</button>` : \"\"}\n        <span class=\"spacer\"></span>\n        <span class=\"agent-item-meta\">${escapeHtml(agentDuration(t.durationMs))}${t.pid ? \" · PID \" + t.pid : \"\"}${t.sessionId ? \" · 会话 \" + String(t.sessionId).slice(0, 8) : \"\"}</span>\n      </div>`;\n    return `<div class=\"agent-item${open ? \" open\" : \"\"}\" data-id=\"${escapeAttr(t.id)}\">\n      <div class=\"agent-item-head\" data-toggle=\"${escapeAttr(t.id)}\">\n        <span class=\"agent-status ${escapeHtml(t.status)}\">${escapeHtml(agentStatusLabel(t.status))}</span>\n        <span class=\"agent-item-prompt\">${escapeHtml(t.prompt)}</span>\n        <span class=\"agent-item-meta\">${escapeHtml(fmtTime(new Date(t.startedAt).toISOString()))}</span>\n      </div>\n      <div class=\"agent-item-body\">${body}</div>\n    </div>`;\n  }).join(\"\");\n  list.querySelectorAll(\"[data-toggle]\").forEach((el) => {\n    el.addEventListener(\"click\", (event) => {\n      if (event.target.closest(\"[data-cancel]\")) return;\n      const id = el.dataset.toggle;\n      if (AGENT_OPEN.has(id)) AGENT_OPEN.delete(id); else AGENT_OPEN.add(id);\n      renderAgentTasks();\n    });\n  });\n  list.querySelectorAll(\"[data-cancel]\").forEach((el) => {\n    el.addEventListener(\"click\", async (event) => {\n      event.stopPropagation();\n      const id = el.dataset.cancel;\n      try {\n        await api(`/api/agent/task/${encodeURIComponent(id)}/cancel`, { method: \"POST\" });\n        await refreshAgentTasks(true);\n      } catch (e) {\n        alert(\"取消失败：\" + ((e && e.message) || e));\n      }\n    });\n  });\n}\n\nconst FOURPX_TABS = [\"returns\", \"inner\", \"hold\"];\n\nfunction setFourPxTab(tab = FOURPX_ACTIVE_TAB) {\n  const nextTab = FOURPX_TABS.includes(tab) ? tab : \"returns\";\n  FOURPX_ACTIVE_TAB = nextTab;\n  document.querySelectorAll(\"[data-fourpx-tab]\").forEach((tabButton) => {\n    const active = tabButton.dataset.fourpxTab === nextTab;\n    tabButton.classList.toggle(\"active\", active);\n    tabButton.setAttribute(\"aria-selected\", active ? \"true\" : \"false\");\n  });\n  $(\"pageFourPx\").classList.toggle(\"hidden\", nextTab !== \"hold\");\n  $(\"pageFourPxReturns\").classList.toggle(\"hidden\", nextTab !== \"returns\");\n  $(\"pageFourPxInner\").classList.toggle(\"hidden\", nextTab !== \"inner\");\n}\n\nfunction applyFeatureVisibility() {\n  const agentNav = document.querySelector('.nav-item[data-page=\"agent\"]');\n  if (agentNav) {\n    agentNav.hidden = !SHOW_AGENT_TASKS;\n    agentNav.classList.toggle(\"agent-nav-hidden\", !SHOW_AGENT_TASKS);\n  }\n}\n\nfunction switchPage(page) {\n  // 保留旧页面标识的兼容入口；左侧导航统一使用新的递四方模块。\n  if (page === \"fourpx-returns\") page = \"fourpx\";\n  // v26.61：抽屉已上移到 .main 层，不再随 #pageInbox 隐藏，切页时显式关掉。\n  closeOrderDetail();\n  document.querySelectorAll(\".nav-item\").forEach((n) => n.classList.toggle(\"active\", n.dataset.page === page));\n  $(\"pageDashboard\").classList.toggle(\"hidden\", page !== \"dashboard\");\n  $(\"pageInbox\").classList.toggle(\"hidden\", page !== \"inbox\");\n  $(\"pageRefund\").classList.toggle(\"hidden\", page !== \"refund\");\n  $(\"pageShip\").classList.toggle(\"hidden\", page !== \"ship\");\n  $(\"pageOffers\").classList.toggle(\"hidden\", page !== \"offers\");\n  $(\"pageOfferRadar\").classList.toggle(\"hidden\", page !== \"offer-radar\");\n  $(\"pageOfferOffline\").classList.toggle(\"hidden\", page !== \"offer-offline\");\n  $(\"pageWatchlist\").classList.toggle(\"hidden\", page !== \"watchlist\");\n  $(\"pageReturnLabel\").classList.toggle(\"hidden\", page !== \"returnlabel\");\n  $(\"pageWms\").classList.toggle(\"hidden\", page !== \"wms\");\n  $(\"pageReturnRegistration\").classList.toggle(\"hidden\", page !== \"return-registration\");\n  $(\"pageFourPxHub\").classList.toggle(\"hidden\", page !== \"fourpx\");\n  $(\"pageShippingOverdue\").classList.toggle(\"hidden\", page !== \"shipping-overdue\");\n  $(\"pageAgent\").classList.toggle(\"hidden\", page !== \"agent\");\n  if (page === \"dashboard\") loadDashboard();\n  if (page === \"refund\") initRefundPage();\n  if (page === \"ship\") initShipPage();\n  if (page === \"returnlabel\") initReturnLabelPage();\n  if (page === \"offers\") initOffersPage();\n  if (page === \"offer-radar\") initOfferRadarPage();\n  if (page === \"offer-offline\") initOfflineMonitorPage();\n  if (page === \"watchlist\") initSpecialAttentionPage();\n  if (page === \"wms\") initWmsPage();\n  if (page === \"return-registration\") initReturnRegistrationPage();\n  if (page === \"fourpx\") {\n    initFourPxPage();\n    initTencentDocsReturnsPage();\n    initTencentDocsInnerPage();\n    setFourPxTab(FOURPX_ACTIVE_TAB);\n  }\n  if (page === \"shipping-overdue\") initShippingOverduePage();\n  if (page === \"agent\") initAgentPage();\n  if (page === \"inbox\") {\n    // 一小时内直接显示缓存；过期时先显示旧数据，再让后台刷新，不因切页重复阻塞。\n    const sid = String(GLOBAL_SHOP || \"\");\n    const cached = INBOX_PRELOAD_CACHE.get(sid);\n    if (cached && cached.data) {\n      applyInboxBundle(cached.data);\n      const fresh = Date.now() - Number(cached.loadedAt || 0) < INBOX_PRELOAD_TTL;\n      if (!fresh && !cached.promise) refreshInboxInBackground(sid, { force: true, awaitFirst: false }).catch(() => {});\n    } else {\n      loadAll();\n    }\n  }\n}\n\n// ---- 仪表盘 ----\nfunction fmtVal(v, unit) {\n  if (v === null || v === undefined) return \"—\";\n  if (unit === \"€\") return \"€\" + Number(v).toLocaleString(undefined, { minimumFractionDigits: v < 100 ? 2 : 0, maximumFractionDigits: v < 100 ? 2 : 0 });\n  if (unit === \"%\") return Number(v).toFixed(2) + \"%\";\n  if (unit === \"s\") {\n    const s = Number(v);\n    if (s >= 86400) return (s / 86400).toFixed(1) + \" 天\";\n    if (s >= 3600) return (s / 3600).toFixed(1) + \" 小时\";\n    if (s >= 60) return (s / 60).toFixed(0) + \" 分\";\n    return s.toFixed(0) + \" 秒\";\n  }\n  return Number(v).toLocaleString();\n}\nfunction formatDashboardMoney(value, currency) {\n  const amount = Number(value);\n  if (!Number.isFinite(amount)) return \"—\";\n  const code = String(currency || \"\").trim().toUpperCase();\n  const prefix = code === \"EUR\" ? \"€\" : code ? `${code} ` : \"\";\n  return `${prefix}${amount.toLocaleString(\"zh-CN\", { minimumFractionDigits:2, maximumFractionDigits:2 })}`;\n}\nfunction periodValue(metricArr, period) {\n  if (!Array.isArray(metricArr)) return null;\n  const hit = metricArr.find((x) => x.period === period);\n  return hit ? hit.value : null;\n}\nfunction statusOf(m, v) {\n  if (m.target === undefined || v === null || v === undefined) return null;\n  if (m.direction === \"higher_better\") {\n    if (v >= m.target) return \"ok\";\n    if (v >= m.target * 0.9) return \"warn\";\n    return \"bad\";\n  }\n  if (v <= m.target) return \"ok\";\n  const badThreshold = Number.isFinite(Number(m.bad_threshold)) ? Number(m.bad_threshold) : m.target * 1.5;\n  if (v < badThreshold) return \"warn\";\n  return \"bad\";\n}\nconst STATUS_TEXT = { ok: \"达标\", warn: \"接近\", bad: \"超标\" };\n\nasync function loadDashboard(options = {}) {\n  const box = $(\"pageDashboard\");\n  const force = options === true || !!(options && options.force);\n  const sid = String(GLOBAL_SHOP || \"\").trim();\n  if (!sid) {\n    box.innerHTML = '<div class=\"dash dashboard-shell\"><div class=\"empty-dash\"><span class=\"icon-svg icon-dashboard ed-icon\"></span>暂无可用店铺</div></div>';\n    return null;\n  }\n  const cached = DASH_CACHE.get(sid);\n  if (!force && cached && cached.data && Date.now() - Number(cached.loadedAt || 0) < DASH_CACHE_TTL) {\n    DASH_DATA = cached.data;\n    renderDashboardV24();\n    refreshDashboardFourPxReturnsCount(sid);\n    refreshDashboardFourPxInnerCount(sid);\n    return cached.data;\n  }\n  const inFlight = DASH_INFLIGHT.get(sid);\n  if (inFlight) return inFlight;\n  box.innerHTML = '<div class=\"dash\"><div class=\"empty-dash\">加载中…</div></div>';\n  // 旧版 UI 契约保留的路径模板：`/api/dashboard/overview?shop_id=${GLOBAL_SHOP}`；实际请求仍对 shop_id 编码。\n  const request = api(`/api/dashboard/overview?shop_id=${encodeURIComponent(sid)}`)\n    .then((d) => {\n      DASH_CACHE.set(sid, { data: d, loadedAt: Date.now() });\n      if (String(GLOBAL_SHOP) === sid) {\n        DASH_DATA = d;\n        renderDashboardV24();\n      }\n      refreshDashboardFourPxReturnsCount(sid);\n      refreshDashboardFourPxInnerCount(sid);\n      return d;\n    })\n    .catch((e) => {\n      if (String(GLOBAL_SHOP) === sid) box.innerHTML = `<div class=\"dash\"><div class=\"empty-dash\" style=\"color:var(--red)\">加载失败：${e.message}</div></div>`;\n      return null;\n    })\n    .finally(() => {\n      if (DASH_INFLIGHT.get(sid) === request) DASH_INFLIGHT.delete(sid);\n    });\n  DASH_INFLIGHT.set(sid, request);\n  return request;\n}\n\nfunction renderDashboard() {\n  const d = DASH_DATA;\n  if (!d) return;\n  const cur = SHOPS.find((s) => s.shop_id === GLOBAL_SHOP);\n  const P = DASH_PERIOD;\n  const g = (code) => periodValue(d.metrics[code], P);\n  const grade = g(\"grade\");\n  const starStr = grade ? `${Number(grade).toFixed(2)} / 5.0` : \"\";\n\nconst firstChar = (d.shop.name || \"M\").trim().charAt(0).toUpperCase();\n  const PERIOD_LBL = PERIODS.find((x) => x.key === P).label;\n    const kpis = [\n    { label: \"店铺评分\", value: grade !== null ? Number(grade).toFixed(2) : \"—\", sub: starStr, cls: \"grade\", icon: \"i-grade\" },\n    { label: \"订单数\", value: g(\"orders_count\") != null ? Number(g(\"orders_count\")).toLocaleString() : \"—\", sub: PERIOD_LBL + \"累计\", icon: \"i-orders\" },\n    { label: \"总营收\", value: fmtVal(g(\"total_revenue\"), \"€\"), sub: \"含税销售额\", icon: \"i-revenue\" },\n    { label: \"客单价\", value: fmtVal(g(\"average_cart\"), \"€\"), sub: \"平均每单\", icon: \"i-cart\" },\n    { label: \"在售报价\", value: g(\"offers_count\") != null ? Number(g(\"offers_count\")).toLocaleString() : \"—\", sub: \"在线 SKU 报价\", icon: \"i-offers\" },\n    { label: \"评价数\", value: g(\"evaluations_count\") != null ? Number(g(\"evaluations_count\")).toLocaleString() : \"—\", sub: \"累计买家评价\", icon: \"i-eval\" },\n  ];\n\n  const GROUPS = [\n    { key: \"quality\", title: \"综合质量\" },\n    { key: \"fulfillment\", title: \"履约质量\" },\n    { key: \"aftersale\", title: \"售后质量\" },\n    { key: \"service\", title: \"服务质量\" },\n    { key: \"scale\", title: \"经营规模\" },\n  ];\n  const secTitle = (grp) => { const gm = d.meta.find((m) => m.group === grp.key && m.assessed); const gcount = d.meta.filter((m) => m.group === grp.key).length; return grp; };\n\n  const sections = GROUPS.map((grp) => {\n    const cards = d.meta.filter((m) => m.group === grp.key).map((m) => {\n      const v = g(m.code);\n      const st = statusOf(m, v);\n      // 进度条：higher_better 用 value/target（封顶 100%），lower_better 用 target/value\n      let pct = 0, color = \"var(--muted)\";\n      if (v !== null && m.target !== undefined) {\n        if (m.direction === \"higher_better\") pct = Math.min(100, (v / m.target) * 100);\n        else pct = v <= 0 ? 100 : Math.min(100, (m.target / v) * 100);\n        color = st === \"ok\" ? \"var(--green)\" : st === \"warn\" ? \"var(--amber)\" : \"var(--red)\";\n      } else if (v !== null) {\n        pct = 100; color = \"var(--blue)\";\n      }\n      // sparkline\n      const vals = PERIODS.map((p) => periodValue(d.metrics[m.code], p.key)).filter((x) => x !== null);\n      const maxV = Math.max(...vals.map(Math.abs), 0.0001);\n      const spark = vals.length ? `<div class=\"spark\">${vals.map((x) => `<i style=\"height:${Math.max(8, (Math.abs(x) / maxV) * 100)}%\"></i>`).join(\"\")}</div>` : \"\";\n      const pill = st ? `<span class=\"pill ${st}\">${STATUS_TEXT[st]}</span>` : \"\";\n      const assess = m.assessed ? '<span class=\"pill assess\">考核</span>' : \"\";\n      const targetTxt = m.target !== undefined ? `<span>标准：${m.direction === \"higher_better\" ? \"≥\" : \"≤\"} ${m.target}${m.unit}</span><span>${PERIODS.find((x) => x.key === P).label}</span>` : `<span>${PERIODS.find((x) => x.key === P).label}</span>`;\n      return `<div class=\"mcard metric-card ${st || \"neutral\"}\">\n        <div class=\"mc-top\">\n          <div>\n            <div class=\"mc-name\">${m.label} ${assess}</div>\n            <div class=\"mc-val\">${fmtVal(v, m.unit)}</div>\n          </div>\n          ${pill}\n        </div>\n        <div class=\"mc-desc\">${m.desc || \"\"}</div>\n        ${m.target !== undefined ? `<div class=\"bar\"><i style=\"width:${pct}%;background:${color}\"></i></div><div class=\"target\">${targetTxt}</div>` : \"\"}\n        ${spark}\n      </div>`;\n    }).join(\"\");\n    return cards ? `<section class=\"sec performance-section\" data-group=\"${grp.key}\"><h3><span class=\"section-kicker\">Performance</span>${grp.title}</h3><div class=\"mgrid\">${cards}</div></section>` : \"\";\n  }).join(\"\");\n\n  $(\"pageDashboard\").innerHTML = `<div class=\"dash dashboard-shell\">\n    <div class=\"dash-head\">\n      <div class=\"dh-left\">\n        <div class=\"shop-badge\">${firstChar}</div>\n        <div>\n          <h2>${d.shop.name}</h2>\n          <div class=\"sub\">\n            <span class=\"m-chip\">#${d.shop.shop_id}</span>\n            ${d.shop.channels && d.shop.channels.length ? `<span class=\"m-chip\">${d.shop.channels.join(\" / \")}</span>` : \"\"}\n            <span class=\"m-chip\">${d.shop.currency}</span>\n            ${d.shop.last_updated ? `<span>数据更新 ${new Date(d.shop.last_updated).toLocaleString(\"zh-CN\")}</span>` : \"\"}\n          </div>\n        </div>\n      </div>\n      <div class=\"period-tabs\">${PERIODS.map((p) => `<span class=\"pt ${p.key === P ? \"active\" : \"\"}\" data-p=\"${p.key}\">${p.label}</span>`).join(\"\")}</div>\n    </div>\n    <div class=\"score-banner health-strip risk-strip\">\n      <div>\n        <div class=\"sb-label\">店铺评分 · ${PERIOD_LBL}</div>\n        <div class=\"sb-num\" style=\"color:${grade !== null && grade >= 3.5 ? \"var(--green)\" : grade !== null && grade >= 3 ? \"var(--amber)\" : \"var(--red)\"}\">${grade !== null ? Number(grade).toFixed(2) : \"—\"}</div>\n      </div>\n      <div class=\"sb-stars\">${starStr || \"暂无评分\"}</div>\n      ${(() => {\n        const g = d.meta.find((m) => m.code === \"grade\");\n        const st = grade !== null && g ? statusOf(g, grade) : null;\n        return st ? `<span class=\"pill ${st}\" style=\"font-size:11px;padding:4px 12px;\">${STATUS_TEXT[st]}</span>` : \"\";\n      })()}\n      <div style=\"margin-left:auto;text-align:right;\">\n        <div class=\"sb-label\">考核指标状态</div>\n        <div style=\"font-size:13px;font-weight:600;margin-top:2px;\">\n          <span style=\"color:var(--green)\">${d.meta.filter((m) => m.assessed && statusOf(m, g(m.code)) === \"ok\").length} 达标</span> ·\n          <span style=\"color:var(--amber)\">${d.meta.filter((m) => m.assessed && statusOf(m, g(m.code)) === \"warn\").length} 接近</span> ·\n          <span style=\"color:var(--red)\">${d.meta.filter((m) => m.assessed && statusOf(m, g(m.code)) === \"bad\").length} 超标</span>\n        </div>\n      </div>\n    </div>\n    <div class=\"kpi-grid\">${kpis.map((k) => `<div class=\"kpi summary-card ${k.cls || \"\"}\"><div class=\"k-icon ${k.icon}\"></div><div class=\"k-label\">${k.label}</div><div class=\"k-value\">${k.value}</div><div class=\"k-sub\">${k.sub || \"\"}</div></div>`).join(\"\")}</div>\n    ${sections}\n  </div>`;\n\n  document.querySelectorAll(\".period-tabs .pt\").forEach((el) => {\n    el.addEventListener(\"click\", () => { DASH_PERIOD = el.dataset.p; renderDashboard(); });\n  });\n}\n\n// v23 视觉重构：仅重排已有 DASH_DATA，不改变接口、计算或操作行为\nfunction renderDashboardV22() {\n  const d = DASH_DATA;\n  if (!d) return;\n  const box = $(\"pageDashboard\");\n  const P = DASH_PERIOD;\n  const metricAliases = {\n    approval_rate: [\"approval_rate\", \"acceptance_rate\"],\n    acceptance_rate: [\"acceptance_rate\", \"approval_rate\"],\n    order_messages_response_delay: [\"order_messages_response_delay\", \"response_time\"],\n    response_time: [\"response_time\", \"order_messages_response_delay\"],\n    valid_tracking_rate: [\"valid_tracking_rate\", \"contact_rate\"],\n    contact_rate: [\"contact_rate\", \"valid_tracking_rate\"],\n  };\n  const metricValue = (code) => {\n    const metrics = d.metrics || {};\n    for (const candidate of (metricAliases[code] || [code])) {\n      const value = periodValue(metrics[candidate], P);\n      if (value !== null && value !== undefined) return value;\n    }\n    return null;\n  };\n  const grade = metricValue(\"grade\");\n  const gradeMeta = (d.meta || []).find((m) => m.code === \"grade\");\n  const gradeStatus = grade !== null && gradeMeta ? statusOf(gradeMeta, grade) : null;\n  const periodLabel = (PERIODS.find((x) => x.key === P) || {}).label || P;\n  const shop = d.shop || {};\n  const shopName = escapeHtml(shop.name || \"店铺\");\n  const firstChar = (shop.name || \"M\").trim().charAt(0).toUpperCase();\n  const gradeColor = gradeStatus === \"bad\" ? \"var(--danger)\" : gradeStatus === \"warn\" ? \"var(--warning)\" : \"var(--success)\";\n  const globalStatusNode = $(\"globalStatus\");\n  if (globalStatusNode && !globalStatusNode.textContent.trim()) {\n    globalStatusNode.innerHTML = `<span class=\"icon-svg icon-check\"></span>已同步 · ${shopName}`;\n    globalStatusNode.className = \"status ok\";\n  }\n  const ratingStars = grade === null ? \"\" : Array.from({ length:5 }, (_, index) => `<span class=\"icon-svg icon-star ${index < Math.round(Number(grade)) ? \"\" : \"muted-star\"}\"></span>`).join(\"\");\n\n  const kpis = [\n    { label:\"店铺评分\", value:grade !== null ? Number(grade).toFixed(2) : \"—\", sub:grade !== null ? `${Number(grade).toFixed(2)} / 5.0` : \"暂无评分\", icon:\"icon-star\", score:true },\n    { label:\"订单数\", value:metricValue(\"orders_count\") != null ? Number(metricValue(\"orders_count\")).toLocaleString() : \"—\", sub:`${periodLabel}累计`, icon:\"icon-orders\" },\n    { label:\"总营收\", value:fmtVal(metricValue(\"total_revenue\"), \"€\"), sub:\"含税销售额\", icon:\"icon-revenue\" },\n    { label:\"客单价\", value:fmtVal(metricValue(\"average_cart\"), \"€\"), sub:\"平均每单\", icon:\"icon-cart\" },\n    { label:\"在售报价\", value:metricValue(\"offers_count\") != null ? Number(metricValue(\"offers_count\")).toLocaleString() : \"—\", sub:\"在线 SKU 报价\", icon:\"icon-offers\" },\n    { label:\"评价数\", value:metricValue(\"evaluations_count\") != null ? Number(metricValue(\"evaluations_count\")).toLocaleString() : \"—\", sub:\"累计买家评价\", icon:\"icon-comments\" },\n  ];\n\n  const assessed = (d.meta || []).map((m) => {\n    const value = metricValue(m.code);\n    return { ...m, value, status:statusOf(m, value) };\n  }).filter((m) => m.value !== null && m.value !== undefined && m.assessed);\n  const statusWeight = { bad:0, warn:1, ok:2 };\n  const riskOrder = { late_shipment_rate:0, incident_rate:1, refund_rate:2, response_time:3, contact_rate:4 };\n  const riskAssessed = assessed.filter((m) => m.code !== \"grade\");\n  const ranked = riskAssessed.slice().sort((a,b) => (statusWeight[a.status] ?? 3) - (statusWeight[b.status] ?? 3) || (riskOrder[a.code] ?? 99) - (riskOrder[b.code] ?? 99) || String(a.label).localeCompare(String(b.label)));\n  const badCount = riskAssessed.filter((m) => m.status === \"bad\").length;\n  const riskPreview = ranked.filter((m) => m.status !== \"ok\").slice(0, 4);\n  const ranking = ranked.slice(0, 5);\n  const fmtMetric = (m) => fmtVal(m.value, m.unit);\n  const targetLabel = (m) => m.target === undefined ? \"—\" : `${m.direction === \"higher_better\" ? \"≥\" : \"≤\"} ${fmtVal(m.target, m.unit)}`;\n  const statusPill = (m) => m.status ? `<span class=\"status-pill ${m.status}\">${STATUS_TEXT[m.status]}</span>` : \"\";\n\n  const hasGradeTrend = Array.isArray(d.grade_trend) && d.grade_trend.length > 0;\n  const trendPairs = hasGradeTrend\n    ? d.grade_trend.map((item) => ({ key:item.key || item.period || item.label, label:item.label || item.period || \"—\", value:item.value })).filter((x) => x.value !== null && x.value !== undefined)\n    : PERIODS.slice().reverse().map((period) => ({ key:period.key, label:period.label, value:periodValue((d.metrics || {}).grade, period.key) })).filter((x) => x.value !== null && x.value !== undefined);\n  if (!hasGradeTrend) {\n    const currentTrendIndex = trendPairs.findIndex((x) => x.key === P);\n    if (currentTrendIndex >= 0 && currentTrendIndex < trendPairs.length - 1) trendPairs.push(trendPairs.splice(currentTrendIndex, 1)[0]);\n  }\n  const trendValues = trendPairs.length ? trendPairs : [{ label:periodLabel, value:grade || 0 }];\n  const metricGroups = [\n    [\"quality\",\"综合质量\",\"评分、接单与异常订单，先看整体健康度\",\"QUALITY LAYER\",\"icon-star\"],\n    [\"fulfillment\",\"履约质量\",\"从接单到发货，把时效风险前置处理\",\"FULFILLMENT LAYER\",\"icon-ship\"],\n    [\"aftersale\",\"售后质量\",\"退款与纠纷的波动，决定体验是否可持续\",\"AFTERSALE LAYER\",\"icon-alert\"],\n    [\"service\",\"服务质量\",\"回复速度和评价反馈，守住买家关系\",\"SERVICE LAYER\",\"icon-comments\"],\n    [\"scale\",\"经营规模\",\"订单、收入与商品供给，展示业务体量\",\"SCALE LAYER\",\"icon-chart\"],\n  ];\n  const groupAccent = { quality:\"violet\", fulfillment:\"blue\", aftersale:\"orange\", service:\"green\", scale:\"indigo\" };\n  const statusColor = (st) => st === \"bad\" ? \"var(--danger)\" : st === \"warn\" ? \"var(--warning)\" : st === \"ok\" ? \"var(--success)\" : \"var(--accent)\";\n  const miniBars = (m, cls = \"\") => {\n    const values = PERIODS.map((p) => periodValue((d.metrics || {})[m.code], p.key)).filter((x) => x !== null && x !== undefined);\n    if (!values.length) return `<div class=\"metric-mini-chart empty ${cls}\"><span></span><span></span><span></span><span></span></div>`;\n    const max = Math.max(...values.map((x) => Math.abs(Number(x))), 0.0001);\n    return `<div class=\"metric-mini-chart ${cls}\" aria-label=\"${escapeHtml(m.label)}趋势\">${values.map((x) => `<span style=\"height:${Math.max(16, Math.abs(Number(x)) / max * 100)}%\"></span>`).join(\"\")}</div>`;\n  };\n  const metricProgress = (m, value) => {\n    if (m.target === undefined || value === null || value === undefined) return null;\n    return m.direction === \"higher_better\" ? Math.min(100, Math.max(0, Number(value) / Number(m.target) * 100)) : Number(value) <= 0 ? 100 : Math.min(100, Math.max(0, Number(m.target) / Number(value) * 100));\n  };\n  const sectionDescriptions = metricGroups.reduce((acc, [,title,description,layer,icon]) => { acc[title] = { description, layer, icon }; return acc; }, {});\n  const detailSections = metricGroups.map(([key,title,description,layer,icon], sectionIndex) => {\n    const metrics = (d.meta || []).filter((m) => m.group === key).map((m) => ({ ...m, value:metricValue(m.code), status:statusOf(m, metricValue(m.code)) })).filter((m) => m.value !== null && m.value !== undefined);\n    if (!metrics.length) return \"\";\n    const lead = metrics.slice().sort((a,b) => ({ bad:0, warn:1, ok:2 }[a.status] ?? 3) - ({ bad:0, warn:1, ok:2 }[b.status] ?? 3) || (a.assessed === b.assessed ? 0 : a.assessed ? -1 : 1))[0];\n    const support = metrics.filter((m) => m.code !== lead.code);\n    const statusCounts = { bad:metrics.filter((m) => m.status === \"bad\").length, warn:metrics.filter((m) => m.status === \"warn\").length, ok:metrics.filter((m) => m.status === \"ok\").length };\n    const leadProgress = metricProgress(lead, lead.value);\n    const leadColor = statusColor(lead.status);\n    const leadTarget = lead.target === undefined ? \"观察指标\" : `标准 ${targetLabel(lead)}`;\n    const summary = lead.assessed ? `${statusCounts.ok} 达标 · ${statusCounts.warn} 接近 · ${statusCounts.bad} 超标` : `${metrics.length} 项经营指标`;\n    const leadCard = `<article class=\"metric-spotlight ${lead.status || \"neutral\"} tone-${groupAccent[key] || \"blue\"}\">\n      <div class=\"spotlight-top\"><span class=\"spotlight-kicker\">重点指标</span>${statusPill(lead)}</div>\n      <h4>${escapeHtml(lead.label)}</h4>\n      <div class=\"spotlight-value\">${fmtVal(lead.value, lead.unit)}</div>\n      <p>${escapeHtml(lead.desc || \"\")}</p>\n      <div class=\"spotlight-meta\"><span>${leadTarget}</span><span>${periodLabel}</span></div>\n      ${leadProgress !== null ? `<div class=\"spotlight-progress\"><span style=\"width:${leadProgress}%;background:${leadColor}\"></span></div>` : \"\"}\n      <div class=\"spotlight-foot\"><span>${lead.target === undefined ? \"当前周期\" : \"达标进度\"}</span>${miniBars(lead, \"lead-bars\")}</div>\n    </article>`;\n    const supportCards = support.map((m) => {\n      const progress = metricProgress(m, m.value);\n      const color = statusColor(m.status);\n      return `<article class=\"metric-row-card ${m.status || \"neutral\"}\">\n        <div class=\"metric-row-icon\"><span class=\"icon-svg ${icon}\"></span></div>\n        <div class=\"metric-row-content\"><div class=\"metric-row-top\"><strong>${escapeHtml(m.label)}</strong>${statusPill(m)}</div><p>${escapeHtml(m.desc || \"\")}</p><div class=\"metric-row-bottom\"><b>${fmtVal(m.value, m.unit)}</b><span>${m.target === undefined ? \"观察指标\" : `标准 ${targetLabel(m)}`}</span></div>${progress !== null ? `<div class=\"metric-row-progress\"><span style=\"width:${progress}%;background:${color}\"></span></div>` : \"\"}</div>\n        ${miniBars(m, \"support-bars\")}\n      </article>`;\n    }).join(\"\");\n    return `<section class=\"metric-section tone-${groupAccent[key] || \"blue\"}\" data-group=\"${key}\">\n      <header class=\"metric-section-header\"><div class=\"metric-section-heading\"><span class=\"metric-section-index\">${String(sectionIndex + 1).padStart(2,\"0\")}</span><div><div class=\"metric-section-layer\">${layer}</div><h3>${title}</h3><p>${description}</p></div></div><div class=\"metric-section-summary\"><strong>${metrics.length} 项指标</strong><span>${summary}</span></div></header>\n      <div class=\"metric-section-body${support.length ? \"\" : \" single\"}\">${leadCard}${support.length ? `<div class=\"metric-support-grid\">${supportCards}</div>` : \"\"}</div>\n    </section>`;\n  }).join(\"\");\n  const detailIntro = `<header class=\"dashboard-details-intro\"><div><span>PERFORMANCE WORKSPACE</span><h3>五大经营面板</h3><p>把质量、履约、售后、服务与经营规模拆开看，快速定位下一步动作。</p></div><div class=\"details-intro-count\"><strong>${metricGroups.length}</strong><span>质量域</span></div></header>`;\n\n  const riskCells = riskPreview.map((m) => `<div class=\"risk-cell\"><span>${escapeHtml(m.label)}</span><div class=\"risk-value-line\"><strong>${fmtMetric(m)}</strong>${statusPill(m)}</div><small>阈值 ${targetLabel(m)}</small></div>`).join(\"\");\n  const rankRows = ranking.map((m, index) => `<div class=\"rank-row\"><span class=\"rank-number ${m.status}\">${index + 1}</span><span class=\"rank-name\">${escapeHtml(m.label)}</span><strong>${fmtMetric(m)}</strong><small>阈值 ${targetLabel(m)}</small>${statusPill(m)}</div>`).join(\"\");\n  const actionRows = ranking.slice(0, 3).map((m) => `<div class=\"action-row\"><span class=\"icon-svg ${m.status === \"bad\" ? \"icon-alert\" : \"icon-clock\"}\"></span><div><strong>${escapeHtml(m.label)}</strong><small>${m.status === \"bad\" ? \"超过平台标准，建议优先处理\" : \"接近平台标准，建议持续关注\"}</small></div><b>${fmtMetric(m)}</b><span class=\"icon-svg icon-arrow-right\"></span></div>`).join(\"\");\n  const assessmentSummary = `${assessed.filter((m) => m.status === \"ok\").length} 达标 · ${assessed.filter((m) => m.status === \"warn\").length} 接近 · ${badCount} 超标`;\n\n  box.innerHTML = `<div class=\"dash dashboard-shell screenshot-dashboard\">\n    <div class=\"dash-head\">\n      <div class=\"dh-left\"><div class=\"shop-badge\">${escapeHtml(firstChar)}</div><div><h2>${shopName}</h2><div class=\"sub\"><span class=\"m-chip\">#${escapeHtml(shop.shop_id || \"—\")}</span>${shop.channels && shop.channels.length ? `<span class=\"m-chip\">${escapeHtml(shop.channels.join(\" / \"))}</span>` : \"\"}<span class=\"m-chip\">${escapeHtml(shop.currency || \"EUR\")}</span>${shop.last_updated ? `<span>数据更新 ${new Date(shop.last_updated).toLocaleString(\"zh-CN\")}</span>` : \"\"}</div></div></div>\n      <div class=\"period-tabs\">${PERIODS.map((p) => `<span class=\"pt ${p.key === P ? \"active\" : \"\"}\" data-p=\"${p.key}\">${p.label}</span>`).join(\"\")}<span class=\"period-calendar icon-svg icon-calendar\" title=\"数据周期\"></span></div>\n    </div>\n\n    <section class=\"overview-strip\">\n      <div class=\"overview-cell overview-score\"><div class=\"overview-label\">店铺评分 · ${periodLabel}</div><div class=\"overview-score-line\"><strong style=\"color:${gradeColor}\">${grade !== null ? Number(grade).toFixed(2) : \"—\"}</strong>${gradeStatus ? statusPill({ status:gradeStatus }) : \"\"}</div><div class=\"overview-rating\">${grade !== null ? `${Number(grade).toFixed(2)} / 5.0` : \"暂无评分\"}</div><div class=\"overview-stars\" aria-label=\"${grade !== null ? `评分 ${Number(grade).toFixed(2)} / 5` : \"暂无评分\"}\">${ratingStars}</div></div>\n      ${kpis.slice(1).map((k) => `<div class=\"overview-cell overview-kpi\"><div class=\"overview-kpi-label\"><span class=\"kpi-icon ${k.icon}\"></span>${k.label}</div><strong>${k.value}</strong><small>${k.sub}</small></div>`).join(\"\")}\n    </section>\n\n    <section class=\"risk-banner\"><div class=\"risk-banner-lead\"><span class=\"icon-svg icon-alert\"></span><div><strong>存在超标指标 ${badCount} 项</strong><small>及时处理风险，避免店铺评分下降</small></div></div>${riskCells || `<div class=\"risk-cell empty-risk\">暂无需要关注的指标</div>`}<button class=\"outline-button\" id=\"btnDashboardMetrics\">查看全部指标<span class=\"icon-svg icon-arrow-right\"></span></button></section>\n\n    <section class=\"dashboard-grid\">\n      <div class=\"dashboard-main-stack\"><article class=\"dashboard-card trend-card\"><div class=\"dashboard-card-head\"><h3>店铺评分趋势</h3><span class=\"card-period\">${periodLabel}<span class=\"icon-svg icon-calendar\"></span></span></div><div class=\"trend-chart-wrap\"><canvas id=\"dashboardTrendCanvas\" aria-label=\"店铺评分趋势图\"></canvas><div class=\"trend-axis-note\"><span>评分计算基于平台考核指标</span><span>数据更新 ${shop.last_updated ? new Date(shop.last_updated).toLocaleDateString(\"zh-CN\") : \"—\"}</span></div></div></article><section class=\"recommendation-card\"><span class=\"icon-svg icon-lightbulb\"></span><div><strong>运营建议</strong><p>${badCount ? \"优先处理超标指标，并在回复时限内完成买家跟进，避免店铺评分继续下降。\" : \"当前指标整体稳定，建议持续关注履约与售后质量。\"}</p></div><span class=\"recommendation-summary\">${assessmentSummary}</span></section></div>\n      <div class=\"dashboard-side-stack\"><article class=\"dashboard-card risk-ranking-card\"><div class=\"dashboard-card-head\"><h3>风险指标排名 <em>（超标优先）</em></h3><button class=\"text-button\" id=\"btnDashboardMetricsSide\">查看全部</button></div><div class=\"rank-list\">${rankRows || `<div class=\"empty-card\">暂无考核指标</div>`}</div></article><article class=\"dashboard-card action-card\"><div class=\"dashboard-card-head\"><h3>待处理风险事项</h3><button class=\"text-button\" id=\"btnDashboardMetricsAction\">查看全部</button></div><div class=\"action-list\">${actionRows || `<div class=\"empty-card\">暂无待处理事项</div>`}</div></article></div>\n    </section>\n    <div id=\"dashboardDetailMetrics\" class=\"dashboard-details\">${detailIntro}${detailSections}</div>\n  </div>`;\n\n  const bindScroll = (id) => { const el = $(id); if (el) el.addEventListener(\"click\", () => $(\"dashboardDetailMetrics\").scrollIntoView({ behavior:\"smooth\", block:\"start\" })); };\n  bindScroll(\"btnDashboardMetrics\"); bindScroll(\"btnDashboardMetricsSide\"); bindScroll(\"btnDashboardMetricsAction\");\n  document.querySelectorAll(\".period-tabs .pt\").forEach((el) => el.addEventListener(\"click\", () => { DASH_PERIOD = el.dataset.p; renderDashboardV22(); }));\n\n  const canvas = $(\"dashboardTrendCanvas\");\n  if (canvas) {\n    const rect = canvas.getBoundingClientRect();\n    const width = Math.max(360, Math.round(rect.width || 650));\n    const height = 340;\n    const dpr = window.devicePixelRatio || 1;\n    canvas.width = width * dpr; canvas.height = height * dpr;\n    canvas.style.width = \"100%\"; canvas.style.height = `${height}px`;\n    const ctx = canvas.getContext(\"2d\"); ctx.scale(dpr, dpr);\n    const css = getComputedStyle(document.documentElement);\n    const accent = css.getPropertyValue(\"--accent\").trim() || \"#2563eb\";\n    const line = css.getPropertyValue(\"--line\").trim() || \"#e4e9f2\";\n    const text = css.getPropertyValue(\"--text-3\").trim() || \"#667085\";\n    const x0 = 42, y0 = 18, chartW = width - 68, chartH = 274;\n    ctx.fillStyle = \"rgba(16,185,129,.08)\"; ctx.fillRect(x0, y0, chartW, chartH * .42);\n    ctx.fillStyle = \"rgba(245,158,11,.07)\"; ctx.fillRect(x0, y0 + chartH * .42, chartW, chartH * .22);\n    ctx.fillStyle = \"rgba(224,91,62,.07)\"; ctx.fillRect(x0, y0 + chartH * .64, chartW, chartH * .36);\n    ctx.font = \"12px Segoe UI, Microsoft YaHei, sans-serif\"; ctx.textAlign = \"right\"; ctx.fillStyle = text;\n    [5,4,3,2,1,0].forEach((tick) => { const y = y0 + chartH - tick / 5 * chartH; ctx.strokeStyle = line; ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(x0,y); ctx.lineTo(x0 + chartW,y); ctx.stroke(); ctx.fillText(String(tick.toFixed(1)), x0 - 8, y + 4); });\n    const points = trendValues.map((item,index) => ({ x:x0 + (trendValues.length === 1 ? chartW / 2 : index / (trendValues.length - 1) * chartW), y:y0 + chartH - Math.max(0, Math.min(5, Number(item.value))) / 5 * chartH, label:item.label, value:item.value }));\n    ctx.strokeStyle = accent; ctx.lineWidth = 3; ctx.lineJoin = \"round\"; ctx.lineCap = \"round\"; ctx.beginPath(); points.forEach((point,index) => index ? ctx.lineTo(point.x,point.y) : ctx.moveTo(point.x,point.y)); ctx.stroke();\n    ctx.textAlign = \"center\"; ctx.font = \"11px Segoe UI, Microsoft YaHei, sans-serif\"; points.forEach((point) => { ctx.fillStyle = accent; ctx.beginPath(); ctx.arc(point.x,point.y,5,0,Math.PI * 2); ctx.fill(); ctx.fillStyle = text; ctx.fillText(point.label, point.x, y0 + chartH + 28); });\n    const last = points[points.length - 1]; if (last) { ctx.fillStyle = accent; ctx.roundRect(last.x - 24, last.y - 33, 48, 24, 6); ctx.fill(); ctx.fillStyle = \"#fff\"; ctx.font = \"700 12px Segoe UI, Microsoft YaHei, sans-serif\"; ctx.fillText(Number(last.value).toFixed(2), last.x, last.y - 17); }\n  }\n}\n\n// v24 视觉重构：将已有 DASH_DATA 组合成单页经营总览，不改变接口、计算或操作行为\nfunction renderDashboardV24() {\n  const d = DASH_DATA;\n  if (!d) return;\n  const box = $(\"pageDashboard\");\n  const P = DASH_PERIOD;\n  const metricValue = (code) => periodValue((d.metrics || {})[code], P);\n  const periodLabel = (PERIODS.find((x) => x.key === P) || {}).label || P;\n  const shop = d.shop || {};\n  const shopName = escapeHtml(shop.name || \"店铺\");\n  const firstChar = escapeHtml((shop.name || \"M\").trim().charAt(0).toUpperCase());\n  const metaByCode = new Map((d.meta || []).map((m) => [m.code, m]));\n  const grade = metricValue(\"grade\");\n  const gradeMeta = metaByCode.get(\"grade\");\n  const gradeStatus = grade !== null && gradeMeta ? statusOf(gradeMeta, grade) : null;\n  const statusPill = (status) => status ? `<span class=\"v24-status ${status}\">${STATUS_TEXT[status]}</span>` : \"\";\n  const currentAssessed = (d.meta || []).map((m) => ({ ...m, value:metricValue(m.code), status:statusOf(m, metricValue(m.code)) })).filter((m) => m.assessed && m.value !== null && m.value !== undefined);\n  const statusCounts = {\n    ok:currentAssessed.filter((m) => m.status === \"ok\").length,\n    warn:currentAssessed.filter((m) => m.status === \"warn\").length,\n    bad:currentAssessed.filter((m) => m.status === \"bad\").length,\n  };\n  const pendingReplyCount = ALL_THREADS.filter((thread) => String(thread.shop_id) === String(GLOBAL_SHOP) && thread.needReply).length;\n  const fourPxReturnsCountValue = Number(shop.fourpx_returns_count);\n  const fourPxReturnsCount = Number.isFinite(fourPxReturnsCountValue) ? Math.max(0, Math.trunc(fourPxReturnsCountValue)) : 0;\n  const fourPxReturnsCacheSource = String(shop.fourpx_returns_cache_source || \"none\");\n  const fourPxReturnsCacheLabel = fourPxReturnsCacheSource === \"none\" ? \"暂无同步缓存\" : fourPxReturnsCacheSource === \"cache\" ? \"本地缓存 · 同步失败\" : \"当前店铺缓存\";\n  const fourPxInnerCountValue = Number(shop.fourpx_inner_count);\n  const fourPxInnerCount = Number.isFinite(fourPxInnerCountValue) ? Math.max(0, Math.trunc(fourPxInnerCountValue)) : 0;\n  const fourPxInnerCacheSource = String(shop.fourpx_inner_cache_source || \"none\");\n  const fourPxInnerCacheLabel = fourPxInnerCacheSource === \"none\" ? \"暂无同步缓存\" : fourPxInnerCacheSource === \"cache\" ? \"本地缓存 · 同步失败\" : \"当前店铺缓存\";\n  const payableBalance = shop.payable_balance === null || shop.payable_balance === undefined || shop.payable_balance === \"\" ? null : Number(shop.payable_balance);\n  const payableBalanceLow = payableBalance !== null && Number.isFinite(payableBalance) && payableBalance < 100;\n  const payableBalanceTone = payableBalance === null || !Number.isFinite(payableBalance) ? \"is-unknown\" : payableBalanceLow ? \"is-low\" : \"is-ok\";\n  const payableBalanceText = formatDashboardMoney(payableBalance, shop.payable_balance_currency || shop.currency);\n  // v26.56：可用余额从待办列表拆出，作为常驻独立卡片的副文案。\n  const balanceHintText = payableBalance === null || !Number.isFinite(payableBalance)\n    ? \"暂未取到可用余额，稍后刷新重试\"\n    : payableBalanceLow\n      ? \"低于 €100，留意后续结算\"\n      : \"当前可用于结算的金额\";\n  const scorePct = grade === null ? 0 : Math.max(0, Math.min(100, Number(grade) / 5 * 100));\n  const gradeColor = gradeStatus === \"bad\" ? \"var(--danger)\" : gradeStatus === \"warn\" ? \"var(--warning)\" : \"var(--success)\";\n  const ratingStars = grade === null ? \"\" : Array.from({ length:5 }, (_, index) => `<span class=\"icon-svg icon-star ${index < Math.round(Number(grade)) ? \"\" : \"muted-star\"}\"></span>`).join(\"\");\n  const globalStatusNode = $(\"globalStatus\");\n  if (globalStatusNode && !globalStatusNode.textContent.trim()) {\n    globalStatusNode.innerHTML = `<span class=\"icon-svg icon-check\"></span>已同步 · ${shopName}`;\n    globalStatusNode.className = \"status ok\";\n  }\n\n  const coreMetrics = [\n    { code:\"orders_count\", label:\"订单数\", sub:`${periodLabel}累计`, icon:\"icon-orders\", tone:\"blue\" },\n    { code:\"total_revenue\", label:\"销售额\", sub:\"含税销售额\", icon:\"icon-revenue\", tone:\"mint\", unit:\"€\" },\n    { code:\"average_cart\", label:\"客单价\", sub:\"平均每单\", icon:\"icon-cart\", tone:\"violet\", unit:\"€\" },\n    { code:\"offers_count\", label:\"在售报价\", sub:\"在线 SKU 报价\", icon:\"icon-offers\", tone:\"amber\" },\n    { code:\"evaluations_count\", label:\"评价数\", sub:\"累计买家评价\", icon:\"icon-comments\", tone:\"sky\" },\n  ];\n  const coreCards = coreMetrics.map((m) => `<article class=\"v24-core-card tone-${m.tone}\">\n    <div class=\"v24-card-label\"><span class=\"v24-icon-wrap\"><span class=\"icon-svg ${m.icon}\"></span></span>${m.label}</div>\n    <strong>${fmtVal(metricValue(m.code), m.unit || \"\")}</strong>\n    <small>${m.sub}</small>\n  </article>`).join(\"\");\n\n  const hasMetric = (code) => Array.isArray((d.metrics || {})[code]) || metaByCode.has(code);\n  const chooseMetricCode = (...codes) => codes.find((code) => hasMetric(code)) || codes[0];\n  const riskCodes = [\n    chooseMetricCode(\"approval_rate\", \"acceptance_rate\"),\n    \"incident_rate\",\n    \"late_shipment_rate\",\n    \"refund_rate\",\n    chooseMetricCode(\"order_messages_response_delay\", \"response_time\"),\n    chooseMetricCode(\"valid_tracking_rate\", \"contact_rate\"),\n  ];\n  const fallbackRiskMeta = {\n    approval_rate:{ label:\"订单接受率\", unit:\"%\", target:95, direction:\"higher_better\", desc:\"及时接受订单的比例\" },\n    acceptance_rate:{ label:\"订单接受率\", unit:\"%\", target:98, direction:\"higher_better\", desc:\"已接受订单占比\" },\n    incident_rate:{ label:\"订单事故率\", unit:\"%\", target:1, bad_threshold:5, direction:\"lower_better\", desc:\"≤1% 达标，<5% 接近，≥5% 超标\" },\n    late_shipment_rate:{ label:\"延迟发货率\", unit:\"%\", target:2, bad_threshold:5, direction:\"lower_better\", desc:\"≤2% 达标，>2%且<5% 接近，≥5% 超标\" },\n    refund_rate:{ label:\"退款率\", unit:\"%\", target:5, bad_threshold:10, direction:\"lower_better\", desc:\"≤5% 达标，>5%且<10% 接近，≥10% 超标\" },\n    order_messages_response_delay:{ label:\"消息响应时长\", unit:\"s\", target:172800, direction:\"lower_better\", desc:\"回复买家站内信的平均时长（≤48 小时达标）\" },\n    response_time:{ label:\"平均回复时间\", unit:\"s\", target:14400, direction:\"lower_better\", desc:\"买家消息首次回复耗时\" },\n    valid_tracking_rate:{ label:\"有效跟踪率\", unit:\"%\", target:95, direction:\"higher_better\", desc:\"回传有效物流单号的比例\" },\n    contact_rate:{ label:\"差评率\", unit:\"%\", target:3, direction:\"lower_better\", desc:\"低星评价占买家评价比例\" },\n  };\n  const riskIcons = { approval_rate:\"icon-check\", acceptance_rate:\"icon-check\", incident_rate:\"icon-alert\", late_shipment_rate:\"icon-ship\", refund_rate:\"icon-refund\", order_messages_response_delay:\"icon-clock\", response_time:\"icon-clock\", valid_tracking_rate:\"icon-check\", contact_rate:\"icon-star\" };\n  const progressFor = (m) => {\n    const value = Number(m.value);\n    if (m.target === undefined || !Number.isFinite(value)) return 0;\n    if (m.direction === \"higher_better\") return Math.max(0, Math.min(100, value / Number(m.target) * 100));\n    return value <= 0 ? 100 : Math.max(8, Math.min(100, Number(m.target) / value * 100));\n  };\n  const targetCopy = (m) => m.target === undefined ? \"观察指标\" : `标准 ${m.direction === \"higher_better\" ? \"≥\" : \"≤\"} ${fmtVal(m.target, m.unit)}`;\n  const riskCards = riskCodes.map((code) => {\n    const meta = { ...(fallbackRiskMeta[code] || { code, label:\"指标\", unit:\"\", desc:\"\" }), ...(metaByCode.get(code) || {}), code };\n    const value = metricValue(code);\n    const status = value === null || value === undefined ? null : statusOf(meta, value);\n    const m = { ...meta, value, status };\n    return `<article class=\"v24-signal-card ${status || \"neutral\"}\">\n      <div class=\"v24-signal-icon\"><span class=\"icon-svg ${riskIcons[code] || \"icon-chart\"}\"></span></div>\n      <div class=\"v24-signal-body\">\n        <div class=\"v24-signal-head\"><strong>${escapeHtml(meta.label)}</strong>${statusPill(status)}</div>\n        <div class=\"v24-signal-value\">${fmtVal(value, meta.unit)}</div>\n        <div class=\"v24-signal-meta\"><span>${escapeHtml(targetCopy(m))}</span><span>${escapeHtml(meta.desc || \"\")}</span></div>\n        <div class=\"v24-signal-track\"><span style=\"width:${progressFor(m)}%\"></span></div>\n      </div>\n    </article>`;\n  }).join(\"\");\n  // v26.55：把原先写死的三条静态文案换成四类真实待办。\n  // 每条都有 kind：alert（需要处理）/ loading（数据未就绪）/ clear（正常），避免出现没有上下文的静默 0。\n  const numOrNull = (value) => {\n    if (value === null || value === undefined || value === \"\" || typeof value === \"boolean\") return null;\n    const n = Number(value);\n    return Number.isFinite(n) ? n : null;\n  };\n  const shippingCountRaw = numOrNull(shop.shipping_overdue_count);\n  const shippingOverdueCount = shippingCountRaw === null ? null : Math.max(0, Math.trunc(shippingCountRaw));\n  const shippingDueSoonRaw = numOrNull(shop.shipping_due_soon_count);\n  const shippingDueSoonCount = shippingDueSoonRaw === null ? 0 : Math.max(0, Math.trunc(shippingDueSoonRaw));\n  const shippingEarliest = String(shop.shipping_overdue_earliest || \"\");\n  const threadsReady = Array.isArray(ALL_THREADS) && ALL_THREADS.length > 0;\n  const fourPxReady = fourPxReturnsCacheSource !== \"none\" || fourPxInnerCacheSource !== \"none\";\n\n  // v26.60：待办从右侧窄栏搬到 overview 第二行，改回「大数字 + 主题色」的快照条形态。\n  // 每条都带三个字段：value = 卡面大数字；tile = 卡面短口径；text/hint 继续挂在 title 上供悬停查口径。\n  const SHIPPING_CACHE_HINT = \"发货超时数据按天缓存\";\n  const shippingTodo = shippingOverdueCount === null\n    ? { kind:\"loading\", tone:\"review\", icon:\"icon-clock\", value:\"—\", title:\"发货超时\", tile:\"正等待同步\", text:shop.shipping_overdue_attempted === true ? \"发货截止时间暂时取不到，进入「发货超时」模块可重试。\" : \"正在统计当前店铺的发货截止时间…\", hint:SHIPPING_CACHE_HINT, goto:\"shipping-overdue\" }\n    : shippingOverdueCount > 0\n      ? { kind:\"alert\", tone:\"critical\", icon:\"icon-alert\", value:String(shippingOverdueCount), title:\"发货超时\", tile:`${shippingOverdueCount} 单已超过截止时间`, text:`${shippingOverdueCount} 单已超过发货截止时间${shippingEarliest ? `，最早一单 ${shippingEarliest}` : \"\"}。`, hint:SHIPPING_CACHE_HINT, goto:\"shipping-overdue\" }\n      : shippingDueSoonCount > 0\n        ? { kind:\"alert\", tone:\"review\", icon:\"icon-clock\", value:String(shippingDueSoonCount), title:\"发货超时\", tile:`${shippingDueSoonCount} 单 24 小时内到期`, text:`${shippingDueSoonCount} 单将在 24 小时内到期，提前处理可避免超时。`, hint:SHIPPING_CACHE_HINT, goto:\"shipping-overdue\" }\n        : { kind:\"clear\", tone:\"steady\", icon:\"icon-check\", value:\"0\", title:\"发货超时\", tile:\"无超时与临期订单\", text:\"没有超过发货截止时间的订单，也没有 24 小时内到期的订单。\", hint:SHIPPING_CACHE_HINT, goto:\"shipping-overdue\" };\n\n  // v26.87：待回复总数之外单独看「时限」—— 已超时 / 12 小时内超时要优先于「还有几封没回」。\n  // 口径：只统计待回复线程，起点取平台 shop_reply_needed_since（缺失时按最后一条消息估算，卡片上标注）。\n  const inboxNowMs = Date.now();\n  const shopPendingThreads = threadsReady\n    ? ALL_THREADS.filter((thread) => String(thread.shop_id) === String(GLOBAL_SHOP) && thread.needReply)\n    : [];\n  const inboxOverdueCount = shopPendingThreads.filter((t) => inboxDueState(t, inboxNowMs).status === \"overdue\").length;\n  const inboxDueSoonCount = shopPendingThreads.filter((t) => inboxDueState(t, inboxNowMs).status === \"soon\").length;\n  const replyTodo = !threadsReady\n    ? { kind:\"loading\", tone:\"reply\", icon:\"icon-comments\", value:\"—\", title:\"站内信待回复\", tile:\"站内信尚未加载\", text:\"站内信列表尚未加载，加载完成后这里会自动刷新。\", goto:\"inbox\" }\n    : inboxOverdueCount > 0\n      ? { kind:\"alert\", tone:\"critical\", icon:\"icon-alert\", value:String(inboxOverdueCount), title:\"站内信已超时\", tile:`${inboxOverdueCount} 封超过 48 小时${inboxDueSoonCount ? ` · 另 ${inboxDueSoonCount} 封即将超时` : \"\"}`, text:`${inboxOverdueCount} 封买家消息已超过 48 小时回复时限${inboxDueSoonCount ? `，另有 ${inboxDueSoonCount} 封将在 12 小时内超时` : \"\"}；当前店铺共 ${pendingReplyCount} 封待回复。超时会直接拉低消息响应时长评分。`, hint:\"时限起点为平台标记的需回复时间；缺失时按最后一条消息时间估算（列表中带「估」字）\", goto:\"inbox\" }\n      : inboxDueSoonCount > 0\n        ? { kind:\"alert\", tone:\"critical\", icon:\"icon-clock\", value:String(inboxDueSoonCount), title:\"站内信即将超时\", tile:`${inboxDueSoonCount} 封 12 小时内超时`, text:`${inboxDueSoonCount} 封买家消息将在 12 小时内超过 48 小时回复时限；当前店铺共 ${pendingReplyCount} 封待回复。`, hint:\"时限起点为平台标记的需回复时间；缺失时按最后一条消息时间估算（列表中带「估」字）\", goto:\"inbox\" }\n        : pendingReplyCount > 0\n          ? { kind:\"alert\", tone:\"reply\", icon:\"icon-comments\", value:String(pendingReplyCount), title:\"站内信待回复\", tile:`${pendingReplyCount} 封等待回复`, text:`${pendingReplyCount} 封买家消息等待回复，暂无 12 小时内超时的。`, goto:\"inbox\" }\n          : { kind:\"clear\", tone:\"steady\", icon:\"icon-check\", value:\"0\", title:\"站内信待回复\", tile:\"无待回复买家消息\", text:\"当前店铺没有待回复的买家消息。\", goto:\"inbox\" };\n\n  const fourPxTotal = fourPxInnerCount + fourPxReturnsCount;\n  // v26.56：快照条移除后，口径说明改挂在这条待办的 title 上，避免悬停解释丢失。\n  const FOURPX_TODO_HINT = \"按店铺 ID 映射腾讯文档店铺名统计；库内异常 = 货在 4px 仓内被扣下、等待处理指令，识别不出店铺的记录按所有店铺计入\";\n  const fourPxTodo = !fourPxReady\n    ? { kind:\"loading\", tone:\"review\", icon:\"icon-orders\", value:\"—\", title:\"递四方待处理\", tile:\"本地无同步缓存\", text:\"本地还没有同步缓存，进入「递四方」模块可触发同步。\", hint:FOURPX_TODO_HINT, goto:\"fourpx\" }\n    : fourPxTotal > 0\n      ? { kind:\"alert\", tone:\"review\", icon:\"icon-orders\", value:String(fourPxTotal), title:\"递四方待处理\", tile:`库内异常 ${fourPxInnerCount} · 退件 ${fourPxReturnsCount}`, text:`库内异常 ${fourPxInnerCount} 条 · 退件 ${fourPxReturnsCount} 条，等待处理指令或登记。`, hint:FOURPX_TODO_HINT, goto:\"fourpx\" }\n      : { kind:\"clear\", tone:\"steady\", icon:\"icon-check\", value:\"0\", title:\"递四方待处理\", tile:\"无待处理异常与退件\", text:\"没有待处理的库内异常与退件记录。\", hint:FOURPX_TODO_HINT, goto:\"fourpx\" };\n\n\n  // v26.60：可用余额并入待办条（只读，不可点击），四块顺序固定为用户指定口径。\n  const balanceTile = { kind:\"balance\", tone:\"balance\", extra:payableBalanceTone, icon:\"icon-revenue\", value:payableBalanceText, title:\"可用余额\", tile:balanceHintText, text:\"可用余额 = 当前可用于结算的金额，不随周期切换。\" };\n  const dashboardTodos = [replyTodo, fourPxTodo, shippingTodo, balanceTile];\n  const todoAlertCount = dashboardTodos.filter((item) => item.kind === \"alert\").length;\n  const todoLoadingCount = dashboardTodos.filter((item) => item.kind === \"loading\").length;\n  const todoNoteText = todoAlertCount > 0 ? `${todoAlertCount} 项待处理` : todoLoadingCount > 0 ? \"部分数据同步中\" : \"全部正常\";\n  const todoTiles = dashboardTodos.map((item) => {\n    const extra = item.extra ? ` ${item.extra}` : \"\";\n    const state = item.kind === \"clear\" ? \" is-clear\" : item.kind === \"loading\" ? \" is-loading\" : \"\";\n    const tip = escapeHtml([item.text, item.hint].filter(Boolean).join(\"；\"));\n    return `<article class=\"v24-todo-tile tone-${item.tone}${extra}${state}\"${item.goto ? ` data-goto=\"${item.goto}\"` : \"\"} title=\"${tip}\"><div class=\"v24-card-label\"><span class=\"v24-icon-wrap\"><span class=\"icon-svg ${item.icon}\"></span></span>${escapeHtml(item.title)}</div><strong>${escapeHtml(item.value)}</strong><small>${escapeHtml(item.tile)}</small></article>`;\n  }).join(\"\");\n  const attentionLabel = statusCounts.bad ? `${statusCounts.bad} 项需要优先处理` : statusCounts.warn ? `${statusCounts.warn} 项接近标准` : \"当前状态稳定\";\n  const assessmentSummary = `${statusCounts.ok} 达标 · ${statusCounts.warn} 接近 · ${statusCounts.bad} 超标`;\n\n  box.innerHTML = `<div class=\"dash dashboard-shell dashboard-v24\">\n    <div class=\"dash-head v24-head\">\n      <div class=\"dh-left\"><div class=\"shop-badge\">${firstChar}</div><div><h2>${shopName}</h2><div class=\"sub\"><span class=\"m-chip\">#${escapeHtml(shop.shop_id || \"—\")}</span>${shop.channels && shop.channels.length ? `<span class=\"m-chip\">${escapeHtml(shop.channels.join(\" / \"))}</span>` : \"\"}<span class=\"m-chip\">${escapeHtml(shop.currency || \"EUR\")}</span>${shop.last_updated ? `<span>数据更新 ${new Date(shop.last_updated).toLocaleString(\"zh-CN\")}</span>` : \"\"}</div></div></div>\n      <div class=\"period-tabs\">${PERIODS.map((p) => `<span class=\"pt ${p.key === P ? \"active\" : \"\"}\" data-p=\"${p.key}\">${p.label}</span>`).join(\"\")}<span class=\"period-calendar icon-svg icon-calendar\" title=\"数据周期\"></span></div>\n    </div>\n\n    <section class=\"v24-overview\">\n      <article class=\"v24-score-card\">\n        <div class=\"v24-score-top\"><span>店铺健康度</span><span>${periodLabel}</span></div>\n        <div class=\"v24-score-main\"><strong style=\"color:${gradeColor}\">${grade !== null ? Number(grade).toFixed(2) : \"—\"}</strong><span>/ 5.0</span>${statusPill(gradeStatus)}</div>\n        <div class=\"v24-score-stars\" aria-label=\"${grade !== null ? `评分 ${Number(grade).toFixed(2)} / 5` : \"暂无评分\"}\">${ratingStars}</div>\n        <div class=\"v24-score-progress\"><span style=\"width:${scorePct}%\"></span></div>\n        <div class=\"v24-score-bottom\"><span>${attentionLabel}</span><span>${assessmentSummary}</span></div>\n      </article>\n      <div class=\"v24-core-grid\">${coreCards}</div>\n      <div class=\"v24-todo-strip\" title=\"提醒按当前店铺统计；点卡片直接进入对应模块处理，可用余额为只读信息\">\n        <div class=\"v24-panel-head v24-todo-head\"><div><span class=\"v24-eyebrow\">TODO</span><h3>待办提醒</h3></div><span class=\"v24-panel-note\">${todoNoteText}</span></div>\n        <div class=\"v24-todo-tiles\">${todoTiles}</div>\n      </div>\n    </section>\n\n\n    <section class=\"v24-workspace\">\n      <article class=\"v24-surface v24-signals-panel\"><header class=\"v24-panel-head\"><div><span class=\"v24-eyebrow\">SIGNALS</span><h3>风险与服务状态</h3></div><span class=\"v24-panel-note\">${riskCodes.length} 项 · ${periodLabel}</span></header><div class=\"v24-signal-grid\">${riskCards}</div></article>\n    </section>\n    <section class=\"v24-footer-note\"><span class=\"v24-footer-icon\"><span class=\"icon-svg icon-chart\"></span></span><div><strong>查看口径</strong><p>数据来自当前店铺的 ${periodLabel} 汇总；切换周期后页面会按同一布局更新。</p></div><span class=\"v24-footer-state\">${shop.last_updated ? `更新于 ${new Date(shop.last_updated).toLocaleDateString(\"zh-CN\")}` : \"等待同步\"}</span></section>\n  </div>`;\n\n  document.querySelectorAll(\".dashboard-v24 .period-tabs .pt\").forEach((el) => el.addEventListener(\"click\", () => { DASH_PERIOD = el.dataset.p; renderDashboardV24(); }));\n\n  document.querySelectorAll(\".dashboard-v24 .v24-todo-tile[data-goto]\").forEach((el) => el.addEventListener(\"click\", () => { if (el.dataset.goto) switchPage(el.dataset.goto); }));\n\n  // 首次进入异步补一次发货超时统计；服务端按天缓存，本地命中时几乎瞬时返回，不阻塞首屏。\n  if (shop.shipping_overdue_attempted !== true) refreshDashboardShippingOverdue(GLOBAL_SHOP);\n}\n\ninit();\n</script>\n</body>\n</html>\n"
    }
  ],
  "exe_rebuild_reason": "修「折扣价被覆盖到折前价」：报价保存流改为先 OF24（库存/成色/时效）后 PRI01（价格）一锤定音；OF24 的价格只填基础价（原价）；带折扣的行在 OF24 之后自动补一道价格导入重申「原价+折扣」；改价复查未确认时提示加粗。附带已把事故报价 XSY330-GreenEU 修回 原价52/折扣29.69"
}