{
  "format": "mirakl-workbench-hotfix",
  "format_version": 1,
  "app_version": "26.106",
  "min_exe_version": "26.106",
  "requires_exe_rebuild": true,
  "created_at": "2026-09-24T06:30:26.027Z",
  "note": "修「折扣价被覆盖到折前价」：报价保存流改为先 OF24（库存/成色/时效）后 PRI01（价格）一锤定音；OF24 的价格只填基础价（原价）；带折扣的行在 OF24 之后自动补一道价格导入重申「原价+折扣」；改价复查未确认时提示加粗。附带已把事故报价 XSY330-GreenEU 修回 原价52/折扣29.69",
  "files": [
    {
      "name": "favicon.ico",
      "encoding": "base64",
      "bytes": 17466,
      "sha256": "b72136550fdec8d0eebf0ea1eae10d9e1741d9cf60f377e5b261f6011e8cd2d5",
      "content": ""
    },
    {
      "name": "favicon.png",
      "encoding": "base64",
      "bytes": 58642,
      "sha256": "fb49f4e98e56678baf2809c515838f7f4744a18a1d816e6499065db6b91f8cb5",
      "content": ""
    },
    {
      "name": "index.html",
      "encoding": "utf8",
      "bytes": 890485,
      "sha256": "fc659c80acb661885f5db28c74de380dbfae90e84df6e624a010cf553aad51fa",
      "content": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Mirakl 运营工作台 · Aurora Ops</title>\n<link rel=\"icon\" href=\"/favicon.ico\" sizes=\"any\">\n<link rel=\"icon\" type=\"image/png\" href=\"/favicon.png\">\n<link rel=\"apple-touch-icon\" href=\"/favicon.png\">\n<style>\n  /* ============ 设计系统 v19 ============ */\n  :root {\n    --bg:#0b0e14; --bg2:#0f131b; --card:#151a24; --card2:#1d2432; --border:#242d3f;\n    --text:#e8ebf2; --muted:#8b95a9; --red:#f87171; --amber:#fbbf24;\n    --green:#34d399; --blue:#60a5fa; --purple:#a78bfa;\n    --accent:#5b8def; --accent2:#7b6cf6; --accent-grad:linear-gradient(135deg,#5b8def,#7b6cf6);\n    --group-fill:#14231d; --group-border:#1f4437; --group-head:#182c23;\n    --border-soft:rgba(255,255,255,.045); --border-light:rgba(255,255,255,.07);\n    --hover:#1e2636; --scroll-thumb:#2a3347; --scroll-thumb-hover:#38435c;\n    --mask:rgba(4,6,12,.72); --shadow:rgba(0,0,0,.5); --shadow-sm:rgba(0,0,0,.3);\n    --bubble-hover:#2a3245;\n    --blue-05:rgba(96,165,250,.06); --blue-1:rgba(96,165,250,.11); --blue-15:rgba(96,165,250,.16);\n    --blue-18:rgba(96,165,250,.2); --blue-2:rgba(96,165,250,.24); --blue-glow:rgba(96,165,250,.55);\n    --green-08:rgba(52,211,153,.08); --green-1:rgba(52,211,153,.11); --green-12:rgba(52,211,153,.14);\n    --green-14:rgba(52,211,153,.16); --green-16:rgba(52,211,153,.18); --green-2:rgba(52,211,153,.22);\n    --amber-2:rgba(251,191,36,.2); --muted-2:rgba(139,149,169,.2);\n    --purple-1:rgba(167,139,250,.12); --purple-2:rgba(167,139,250,.22);\n    --group-5:rgba(52,211,153,.05); --group-8:rgba(52,211,153,.09);\n    --radius:14px; --radius-sm:9px;\n  }\n  html[data-theme=\"light\"] {\n    --bg:#f5f6f9; --bg2:#edeff4; --card:#ffffff; --card2:#f3f5f9; --border:#e2e6ee;\n    --text:#1a2130; --muted:#68718a; --red:#e05252; --amber:#d9930d;\n    --green:#0ea472; --blue:#2f7ae5; --purple:#7c66e8;\n    --accent:#3f7fe8; --accent2:#6e5df0; --accent-grad:linear-gradient(135deg,#3f7fe8,#6e5df0);\n    --group-fill:#e6f5ee; --group-border:#a9dccb; --group-head:#d9efe4;\n    --border-soft:rgba(20,30,50,.055); --border-light:rgba(20,30,50,.09);\n    --hover:#e9edf4; --scroll-thumb:#c2cad8; --scroll-thumb-hover:#aab5c8;\n    --mask:rgba(30,40,60,.45); --shadow:rgba(30,40,60,.16); --shadow-sm:rgba(30,40,60,.1);\n    --bubble-hover:#c9d3e3;\n    --blue-05:rgba(47,122,229,.05); --blue-1:rgba(47,122,229,.1); --blue-15:rgba(47,122,229,.14);\n    --blue-18:rgba(47,122,229,.18); --blue-2:rgba(47,122,229,.22); --blue-glow:rgba(47,122,229,.35);\n    --green-08:rgba(14,164,114,.08); --green-1:rgba(14,164,114,.1); --green-12:rgba(14,164,114,.13);\n    --green-14:rgba(14,164,114,.15); --green-16:rgba(14,164,114,.17); --green-2:rgba(14,164,114,.2);\n    --amber-2:rgba(217,147,13,.18); --muted-2:rgba(104,113,138,.18);\n    --purple-1:rgba(124,102,232,.1); --purple-2:rgba(124,102,232,.2);\n    --group-5:rgba(14,164,114,.06); --group-8:rgba(14,164,114,.1);\n  }\n  * { margin:0; padding:0; box-sizing:border-box; }\n  html { font-size:14px; }\n  body { background:var(--bg); color:var(--text); font-family:-apple-system,\"Segoe UI Variable\",\"Segoe UI\",\"Microsoft YaHei UI\",\"Microsoft YaHei\",sans-serif; height:100vh; overflow:hidden; transition:background .25s,color .25s; -webkit-font-smoothing:antialiased; }\n  input, select, textarea, button { font-family:inherit; }\n  ::-webkit-scrollbar { width:9px; height:9px; }\n  ::-webkit-scrollbar-thumb { background:var(--scroll-thumb); border-radius:99px; border:2px solid transparent; background-clip:content-box; }\n  ::-webkit-scrollbar-thumb:hover { background:var(--scroll-thumb-hover); background-clip:content-box; }\n  ::-webkit-scrollbar-track { background:transparent; }\n\n  .app { display:flex; flex-direction:column; height:100vh; }\n  /* ---- 顶栏 ---- */\n  .topbar { display:flex; align-items:center; gap:12px; padding:0 18px; height:56px; background:var(--card); border-bottom:1px solid var(--border); flex-wrap:nowrap; flex-shrink:0; }\n  .topbar .logo { display:flex; align-items:center; gap:10px; flex-shrink:0; }\n  .topbar .logo-mark { width:32px; height:32px; border-radius:10px; background:var(--accent-grad); display:flex; align-items:center; justify-content:center; color:#fff; font-weight:700; font-size:15px; box-shadow:0 3px 10px var(--shadow-sm); }\n  .topbar h1 { font-size:15px; font-weight:650; letter-spacing:.2px; white-space:nowrap; }\n  .topbar .hint { font-size:12px; color:var(--muted); white-space:nowrap; padding:3px 10px; background:var(--card2); border:1px solid var(--border); border-radius:99px; flex-shrink:0; }\n  .topbar #globalShopHint { display:none; } /* 下拉框已显示当前店铺，冗余 */\n  .topbar .status { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; min-width:0; flex:0 1 auto; }\n  .topbar .btn { white-space:nowrap; padding:6px 12px; font-size:12.5px; border-radius:var(--radius-sm); }\n  .topbar .status { margin-left:2px; }\n  .topbar .tencent-docs-mark { display:inline-flex; align-items:center; justify-content:center; width:15px; height:15px; border:1px solid currentColor; border-radius:4px; font-size:10px; line-height:1; }\n  /* ---- 按钮 ---- */\n  .btn { background:var(--card2); color:var(--text); border:1px solid var(--border); border-radius:var(--radius-sm); padding:7px 14px; font-size:13px; cursor:pointer; transition:all .14s; font-weight:500; }\n  .btn:hover { border-color:var(--accent); background:var(--hover); transform:translateY(-1px); }\n  .btn:active { transform:translateY(0); }\n  .btn.primary { background:var(--accent-grad); border-color:transparent; color:#fff; box-shadow:0 2px 8px var(--shadow-sm); }\n  .btn.primary:hover { filter:brightness(1.08); }\n  .btn:disabled { opacity:.45; cursor:not-allowed; transform:none; }\n  /* ---- 主区 ---- */\n  .main { display:flex; flex:1; min-height:0; }\n  .col { display:flex; flex-direction:column; min-height:0; }\n  /* ---- 左侧导航 ---- */\n  .col-nav { width:158px; background:var(--bg2); border-right:1px solid var(--border); padding:12px 8px; flex-shrink:0; display:flex; flex-direction:column; gap:2px; }\n  .nav-item { padding:10px 14px; font-size:13px; color:var(--muted); cursor:pointer; display:flex; align-items:center; gap:10px; transition:all .14s; border-radius:10px; border-left:none; position:relative; }\n  .nav-item:hover { background:var(--card2); color:var(--text); }\n  .nav-item.active { background:var(--blue-1); color:var(--blue); font-weight:600; }\n  .nav-item.active::before { content:\"\"; position:absolute; left:-8px; top:22%; height:56%; width:3px; border-radius:99px; background:var(--accent-grad); }\n  .nav-item .ni { font-size:15px; width:20px; text-align:center; }\n  /* ---- 页面容器 ---- */\n  .page { flex:1; overflow-y:auto; min-height:0; }\n  /* ---- 店铺栏 ---- */\n  .col-shops { width:216px; border-right:1px solid var(--border); background:var(--bg2); }\n  .panel-title { padding:13px 16px; font-size:11.5px; font-weight:600; letter-spacing:1.2px; color:var(--muted); border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; text-transform:uppercase; }\n  .shop-item { padding:11px 16px; cursor:pointer; border-bottom:1px solid var(--border-soft); display:flex; justify-content:space-between; align-items:center; transition:background .12s; }\n  .shop-item:hover { background:var(--card2); }\n  .shop-item.active { background:var(--blue-1); box-shadow:inset 3px 0 0 var(--blue); }\n  .shop-item .name { font-size:13px; }\n  .shop-item .cnt { font-size:11px; background:var(--red); color:#fff; border-radius:99px; padding:1px 8px; min-width:22px; text-align:center; font-weight:600; }\n  .shop-item .cnt.zero { background:transparent; color:var(--muted); }\n  .mail-list { flex:1; overflow-y:auto; }\n  /* ---- 邮件列表 ---- */\n  .mail-item { padding:13px 16px; cursor:pointer; border-bottom:1px solid var(--border-soft); transition:background .12s; position:relative; }\n  .mail-item:hover { background:var(--card2); }\n  .mail-item.active { background:var(--green-1); box-shadow:inset 3px 0 0 var(--green); }\n  .mail-item.unread { background:var(--blue-05); }\n  .mail-item.unread::after { content:\"\"; position:absolute; left:6px; top:20px; width:7px; height:7px; border-radius:50%; background:var(--blue); box-shadow:0 0 6px var(--blue-glow); }\n  .mail-item .row1 { display:flex; justify-content:space-between; gap:8px; align-items:center; }\n  .mail-item .from { font-size:13px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; display:flex; align-items:center; gap:6px; min-width:0; }\n  .mail-item.unread .from { color:var(--blue); }\n  .mail-item .time { font-size:11px; color:var(--muted); white-space:nowrap; }\n  .mail-item .subj { font-size:12px; color:var(--muted); margin-top:4px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .mail-item .meta { font-size:11px; color:var(--muted); margin-top:5px; display:flex; gap:10px; opacity:.85; }\n  .mail-item .meta .tag-shop { background:var(--card2); border:1px solid var(--border); padding:0 7px; border-radius:5px; }\n  .dot-badge { display:inline-block; width:7px; height:7px; border-radius:50%; background:var(--blue); flex-shrink:0; box-shadow:0 0 5px var(--blue-glow); }\n  .need-reply { color:var(--red); font-size:11px; font-weight:600; }\n  .g-ok { color:var(--green); font-size:11px; }\n  /* v26.87：回复时限标记。颜色按「浅色底用加深字、深色底用提亮字」分别取值，\n     两套主题下正文与底色的对比度都 ≥4.5:1（UI 配色铁律）。 */\n  .due-flag { display:inline-flex; align-items:center; gap:3px; padding:1px 7px; border-radius:99px; font-size:11px; font-weight:600; border:1px solid transparent; white-space:nowrap; }\n  .due-flag.due-overdue { color:#b42318; background:var(--danger-soft); border-color:rgba(217,45,63,.28); }\n  .due-flag.due-soon { color:#8a5a00; background:var(--warning-soft); border-color:rgba(217,144,0,.3); }\n  html[data-theme=\"dark\"] .due-flag.due-overdue { color:#ffc2ca; background:rgba(251,113,133,.14); border-color:rgba(251,113,133,.34); }\n  html[data-theme=\"dark\"] .due-flag.due-soon { color:#f7c86a; background:rgba(242,184,75,.14); border-color:rgba(242,184,75,.34); }\n  .mail-item.due-overdue { box-shadow:inset 3px 0 0 var(--red); }\n  .mail-item.due-soon { box-shadow:inset 3px 0 0 var(--amber); }\n  /* v26.87：报价雷达 */\n  .radar-shell { display:flex; flex-direction:column; gap:12px; }\n  .radar-cards { display:grid; grid-template-columns:repeat(auto-fit,minmax(158px,1fr)); gap:10px; }\n  .radar-card { border:1px solid var(--line); border-radius:12px; padding:11px 13px; background:var(--surface); cursor:pointer; transition:border-color .12s, transform .12s; }\n  .radar-card:hover { transform:translateY(-1px); border-color:var(--line-strong); }\n  .radar-card.is-active { border-color:var(--accent); box-shadow:0 0 0 2px var(--accent-soft); }\n  .radar-card.is-zero { opacity:.66; }\n  .radar-card .rc-label { font-size:12px; color:var(--text-2); }\n  .radar-card .rc-value { font-size:26px; font-weight:700; margin-top:5px; line-height:1; font-variant-numeric:tabular-nums; }\n  .radar-card.sev-high .rc-value { color:var(--danger); }\n  .radar-card.sev-medium .rc-value { color:#8a5a00; }\n  html[data-theme=\"dark\"] .radar-card.sev-medium .rc-value { color:var(--warning); }\n  .radar-shop-level { border:1px solid rgba(217,45,63,.3); background:var(--danger-soft); border-radius:12px; padding:12px 14px; display:flex; flex-direction:column; gap:6px; }\n  html[data-theme=\"dark\"] .radar-shop-level { border-color:rgba(251,113,133,.3); }\n  .radar-shop-level .rsl-title { font-size:13px; font-weight:650; color:var(--text); }\n  .radar-shop-level .rsl-note { font-size:11.5px; color:var(--text-2); line-height:1.5; }\n  .radar-shop-level .rsl-samples { font-size:11.5px; color:var(--text-3); word-break:break-all; }\n  .radar-banner { border:1px solid rgba(217,144,0,.32); background:var(--warning-soft); border-radius:10px; padding:9px 12px; font-size:11.5px; color:#8a5a00; line-height:1.55; }\n  html[data-theme=\"dark\"] .radar-banner { color:var(--warning); border-color:rgba(242,184,75,.32); }\n  .radar-table { width:100%; border-collapse:collapse; font-size:12.5px; }\n  .radar-table th, .radar-table td { padding:7px 10px; border-bottom:1px solid var(--line); text-align:left; vertical-align:top; }\n  .radar-table th { color:var(--text-3); font-weight:600; background:var(--surface); position:sticky; top:0; }\n  .radar-table .rd-sku { font-family:ui-monospace,Menlo,Consolas,monospace; white-space:nowrap; }\n  .radar-table .rd-change { white-space:nowrap; color:var(--text-2); }\n  .radar-pill { display:inline-flex; align-items:center; padding:1px 7px; border-radius:99px; font-size:11px; font-weight:600; white-space:nowrap; }\n  .radar-pill.sev-high { color:#b42318; background:var(--danger-soft); border:1px solid rgba(217,45,63,.26); }\n  .radar-pill.sev-medium { color:#8a5a00; background:var(--warning-soft); border:1px solid rgba(217,144,0,.26); }\n  html[data-theme=\"dark\"] .radar-pill.sev-high { color:#ffc2ca; background:rgba(251,113,133,.14); border-color:rgba(251,113,133,.34); }\n  html[data-theme=\"dark\"] .radar-pill.sev-medium { color:#f7c86a; background:rgba(242,184,75,.14); border-color:rgba(242,184,75,.34); }\n  .radar-pill.sev-shop { color:#b42318; background:var(--danger-soft); border:1px solid rgba(217,45,63,.26); }\n  html[data-theme=\"dark\"] .radar-pill.sev-shop { color:#ffc2ca; background:rgba(251,113,133,.14); border-color:rgba(251,113,133,.34); }\n  .radar-card.sev-shop .rc-value { color:var(--danger); }\n  /* v26.89：特别关注 */\n  .watch-add-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(168px,1fr)); gap:10px; }\n  .watch-add-grid label { display:flex; flex-direction:column; gap:4px; font-size:12px; color:var(--text-2); }\n  .watch-add-grid .s-input, .watch-add-grid textarea { width:100%; box-sizing:border-box; }\n  .watch-add-grid textarea { resize:vertical; min-height:56px; font-family:ui-monospace,Menlo,Consolas,monospace; font-size:12.5px; }\n  .watch-req { color:var(--danger); margin-left:3px; }\n  .watch-flag { display:inline-block; padding:0 6px; border-radius:6px; font-size:11px; border:1px solid var(--line-strong); color:var(--text-2); white-space:nowrap; }\n  .watch-flag.ok { color:var(--green); border-color:rgba(16,151,84,.34); background:rgba(16,151,84,.08); }\n  .watch-flag.bad { color:#b42318; border-color:rgba(217,45,63,.3); background:var(--danger-soft); }\n  .watch-flag.mute { color:var(--text-3); }\n  html[data-theme=\"dark\"] .watch-flag.bad { color:#ffc2ca; }\n  html[data-theme=\"dark\"] .watch-flag.ok { color:#7ee2a8; border-color:rgba(52,199,123,.34); }\n  .watch-detail-row > td { background:var(--surface); padding:12px 14px 14px; }\n  .watch-detail { display:flex; flex-direction:column; gap:10px; }\n  .watch-detail-item { border-left:2px solid var(--line-strong); padding-left:9px; }\n  .watch-th-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(132px,1fr)); gap:8px; }\n  .watch-th-grid label { display:flex; flex-direction:column; gap:4px; font-size:12px; color:var(--text-2); }\n  .watch-th-grid .s-input { width:100%; box-sizing:border-box; }\n  .watch-danger { color:#b42318; border-color:rgba(217,45,63,.34); }\n  html[data-theme=\"dark\"] .watch-danger { color:#ffc2ca; border-color:rgba(251,113,133,.34); }\n  .watch-row-toggle { cursor:pointer; }\n  .watch-row-toggle:hover .rd-sku { color:var(--accent); }\n  /* ---- 阅读窗格 ---- */\n  .read-pane { flex:1; overflow-y:auto; padding:0; }\n  .thread-head { padding:18px 22px; border-bottom:1px solid var(--border); background:var(--card); }\n  .thread-head .t-title { font-size:15.5px; font-weight:650; margin-bottom:8px; word-break:break-all; line-height:1.45; }\n  .thread-head .t-meta { font-size:12px; color:var(--muted); display:flex; gap:14px; flex-wrap:wrap; }\n  .tag { display:inline-block; padding:2px 9px; border-radius:99px; font-size:11px; background:var(--blue-15); color:var(--blue); font-weight:500; }\n  .msgs { padding:20px 22px; }\n  .msg { display:flex; margin-bottom:18px; gap:12px; }\n  .avatar { width:34px; height:34px; border-radius:11px; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:650; }\n  .av-buyer { background:var(--blue-2); color:var(--blue); }\n  .av-shop { background:var(--green-2); color:var(--green); }\n  .av-op { background:var(--amber-2); color:var(--amber); }\n  .av-other { background:var(--muted-2); color:var(--muted); }\n  /* v26.90：显式声明消息正文可选中。user-select 是继承属性，写死 text 可免于被祖先的\n     none 误伤；配套的选区高亮见后面 ::selection 那段。 */\n  .msg-body { flex:1; background:var(--card); border:1px solid var(--border); border-radius:12px; padding:13px 16px; transition:border-color .12s; user-select:text; }\n  .msg-body:hover { border-color:var(--bubble-hover); }\n  .msg-body .mhead { display:flex; justify-content:space-between; align-items:center; margin-bottom:7px; }\n  .msg-body .mname { font-size:13px; font-weight:600; }\n  .msg-body .mtime { font-size:11px; color:var(--muted); }\n  .msg-body .mhead-left { display:flex; align-items:center; gap:7px; min-width:0; }\n  /* v26.71：我方消息标注「这条是发给谁的」，数据来自 M10 每条消息自己的 to[]。 */\n  .msg-body .mrecipient { flex-shrink:0; display:inline-flex; align-items:center; font-size:10.5px; font-weight:650; line-height:1.7; padding:0 8px; border-radius:99px; white-space:nowrap; border:1px solid transparent; }\n  .msg-body .mrecipient.to-customer { color:var(--blue); background:var(--blue-1); border-color:var(--blue-18); }\n  .msg-body .mrecipient.to-operator { color:var(--amber); background:var(--amber-2); border-color:var(--amber-2); }\n  .msg-body .mrecipient.to-both { color:var(--purple); background:var(--purple-1); border-color:var(--purple-2); }\n  .msg-body .mtext { font-size:13.5px; line-height:1.65; white-space:pre-wrap; word-break:break-word; }\n  .mtext-empty { color:var(--muted); }\n  .mtext-attachment-summary { display:block; margin-top:5px; color:var(--accent); font-size:12px; line-height:1.5; word-break:break-word; }\n  .attachment-list { display:flex; flex-direction:column; align-items:flex-start; gap:2px; margin-top:5px; }\n  /* v26.90：<a> 在浏览器里默认 draggable=true —— 直接在链接文字上拖选会触发原生拖拽\n     （拖影）而不是选中，附件名因此「选不中」。关掉链接拖拽、显式允许选中文字。 */\n  .attachment-link { display:inline-flex; align-items:center; gap:5px; color:var(--accent); font-size:12px; text-decoration:none; word-break:break-all; user-select:text; -webkit-user-drag:none; }\n  .attachment-link:hover { text-decoration:underline; }\n  .reply-box { padding:14px 22px; border-top:1px solid var(--border); background:var(--card); }\n  .reply-box textarea { width:100%; background:var(--card2); color:var(--text); border:1px solid var(--border); border-radius:10px; padding:11px 13px; font-size:13px; min-height:90px; resize:vertical; outline:none; transition:border-color .12s; line-height:1.6; }\n  .reply-box textarea:focus { border-color:var(--accent); }\n  .reply-row { display:flex; justify-content:flex-end; align-items:center; gap:10px; margin-top:8px; }\n  .reply-row .status { margin-right:auto; }\n  /* ---- 工具栏 ---- */\n  .toolbar { display:flex; gap:6px; padding:10px 16px; border-bottom:1px solid var(--border); align-items:center; background:var(--bg2); }\n  .filter-tab { font-size:12.5px; color:var(--muted); cursor:pointer; padding:4px 13px; border-radius:99px; transition:all .12s; font-weight:500; }\n  .filter-tab:hover { background:var(--card2); color:var(--text); }\n  .filter-tab.active { background:var(--blue-15); color:var(--blue); font-weight:600; }\n  .sel-shop { background:var(--card2); color:var(--text); border:1px solid var(--border); border-radius:var(--radius-sm); padding:6px 10px; font-size:12px; outline:none; }\n  .all-count { margin-left:auto; font-size:12px; color:var(--muted); }\n  .inbox-shop-tag { font-size:12px; color:var(--green); font-weight:600; }\n  .inbox-search { display:flex; align-items:center; gap:5px; margin-left:auto; min-width:0; }\n  .inbox-search input { width:150px; min-width:90px; background:var(--card); color:var(--text); border:1px solid var(--border); border-radius:var(--radius-sm); padding:6px 9px; font-size:12px; outline:none; }\n  .inbox-search input:focus { border-color:var(--accent); box-shadow:0 0 0 2px var(--blue-05); }\n  .inbox-search button { border:1px solid var(--border); background:var(--card2); color:var(--text); border-radius:var(--radius-sm); padding:5px 8px; font-size:11.5px; cursor:pointer; white-space:nowrap; }\n  .inbox-search button:hover { border-color:var(--accent); color:var(--accent); }\n  .inbox-topic-filter { display:flex; align-items:center; gap:5px; color:var(--muted); font-size:11.5px; white-space:nowrap; }\n  .inbox-topic-filter select { max-width:150px; min-width:112px; background:var(--card); color:var(--text); border:1px solid var(--border); border-radius:var(--radius-sm); padding:6px 8px; font-size:11.5px; outline:none; }\n  .inbox-topic-filter select:focus { border-color:var(--accent); box-shadow:0 0 0 2px var(--blue-05); }\n  /* ---- 弹窗 ---- */\n  .modal-mask { position:fixed; inset:0; background:var(--mask); backdrop-filter:blur(3px); display:flex; align-items:center; justify-content:center; z-index:50; }\n  .modal { background:var(--card); border:1px solid var(--border); border-radius:16px; width:560px; max-width:94vw; max-height:90vh; overflow-y:auto; padding:22px 24px; box-shadow:0 20px 60px var(--shadow); }\n  .modal h2 { font-size:15.5px; font-weight:650; margin-bottom:14px; }\n  .modal label { display:block; font-size:12px; color:var(--muted); margin:10px 0 4px; }\n  .modal input[type=text], .modal textarea, .modal select { width:100%; background:var(--card2); color:var(--text); border:1px solid var(--border); border-radius:var(--radius-sm); padding:8px 10px; font-size:13px; outline:none; }\n  .modal textarea { min-height:110px; resize:vertical; line-height:1.6; }\n  .modal .m-actions { display:flex; justify-content:flex-end; gap:8px; margin-top:16px; }\n  .file-list { font-size:11px; color:var(--muted); margin-top:4px; }\n  .attach-btn { font-size:12px; }\n  .hidden { display:none !important; }\n  .status { font-size:12px; color:var(--muted); }\n  .status.err { color:var(--red); }\n  .status.ok { color:var(--green); }\n  .empty { padding:44px 20px; text-align:center; color:var(--muted); font-size:13px; line-height:1.8; }\n  .loading { padding:20px; text-align:center; color:var(--muted); font-size:13px; }\n  /* ---- 订单组 ---- */\n  .order-group { margin:5px 8px; border-radius:12px; background:var(--group-5); border:1px solid var(--green-14); overflow:hidden; transition:all .15s; }\n  .order-group.expanded { background:var(--group-fill); border-color:var(--group-border); box-shadow:0 2px 14px var(--group-8); }\n  .order-head { display:flex; align-items:center; gap:8px; padding:11px 13px; cursor:pointer; transition:background .12s; }\n  .order-group.expanded .order-head { background:var(--group-head); }\n  .order-head:hover { background:var(--green-08); }\n  .order-head .caret { font-size:11px; color:var(--green); width:14px; flex-shrink:0; transition:transform .15s; }\n  .order-head .oid { font-size:13px; font-weight:600; font-family:Consolas,monospace; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .order-head.has-unread .oid { color:var(--blue); }\n  .order-head .gmeta { margin-left:auto; display:flex; gap:8px; align-items:center; font-size:11px; color:var(--muted); white-space:nowrap; flex-shrink:0; }\n  .order-head .g-unread { background:var(--blue-18); color:var(--blue); border-radius:99px; padding:1px 8px; font-weight:600; }\n  .order-head .g-ok { color:var(--green); }\n  .order-head .time { font-size:11px; color:var(--muted); white-space:nowrap; flex-shrink:0; }\n  .group-body { padding:4px 6px 6px; }\n  .mail-item.group-mail { border-radius:9px; margin:2px 0; border-left:2px solid transparent; }\n  .mail-item.group-mail:hover { background:var(--green-1); }\n  .mail-item.group-mail.unread { border-left-color:var(--blue); }\n  .mail-item.group-mail.active { background:var(--green-16); box-shadow:inset 3px 0 0 var(--green); }\n  .mail-item.group-mail.resolved-mail { opacity:.65; }\n  /* ---- 模板 ---- */\n  .reply-tools { display:flex; align-items:center; gap:8px; margin-bottom:8px; position:relative; }\n  .tpl-menu { position:absolute; left:0; top:34px; width:320px; max-height:280px; overflow-y:auto; background:var(--card2); border:1px solid var(--border); border-radius:12px; z-index:60; box-shadow:0 12px 34px var(--shadow-sm); }\n  .tpl-menu .tpl-item { display:block; width:100%; text-align:left; padding:9px 12px; font-size:12.5px; color:var(--text); background:transparent; border:none; border-bottom:1px solid var(--border-light); cursor:pointer; }\n  .tpl-menu .tpl-item:hover { background:var(--green-12); color:var(--green); }\n  .tpl-menu .tpl-item:last-child { border-bottom:none; }\n  .tpl-menu .tpl-empty { padding:12px; font-size:12px; color:var(--muted); }\n  .tpl-row { display:flex; align-items:center; gap:8px; padding:8px 10px; border:1px solid var(--border); border-radius:9px; margin-bottom:6px; background:var(--card2); }\n  .tpl-row .t-name { flex:1; font-size:13px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n  .tpl-row .t-preview { font-size:11px; color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; max-width:55%; }\n  .tpl-row .t-del { background:transparent; border:none; color:var(--muted); cursor:pointer; font-size:14px; padding:2px 6px; border-radius:6px; }\n  .tpl-row .t-del:hover { background:var(--red); color:#fff; }\n  .tpl-row .t-use { font-size:12px; }\n  /* ---- 仪表盘 v19 ---- */\n  .dash { padding:24px 28px; max-width:1320px; margin:0 auto; }\n  .dash-head { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:14px; margin-bottom:20px; }\n  .dh-left { display:flex; align-items:center; gap:16px; }\n  .shop-badge { width:52px; height:52px; border-radius:16px; background:var(--accent-grad); color:#fff; display:flex; align-items:center; justify-content:center; font-size:22px; font-weight:700; box-shadow:0 4px 14px var(--shadow-sm); flex-shrink:0; }\n  .dh-left h2 { font-size:21px; font-weight:700; letter-spacing:.2px; }\n  .dh-left .sub { font-size:12px; color:var(--muted); margin-top:4px; display:flex; gap:12px; flex-wrap:wrap; align-items:center; }\n  .dh-left .sub .m-chip { background:var(--card2); border:1px solid var(--border); padding:1px 9px; border-radius:6px; }\n  .stars { color:var(--amber); font-size:13px; letter-spacing:1px; }\n  .period-tabs { display:flex; gap:4px; background:var(--card2); padding:4px; border-radius:11px; border:1px solid var(--border); }\n  .period-tabs .pt { font-size:12px; padding:5px 13px; border-radius:8px; cursor:pointer; color:var(--muted); transition:all .13s; font-weight:500; }\n  .period-tabs .pt:hover { color:var(--text); }\n  .period-tabs .pt.active { background:var(--card); color:var(--text); box-shadow:0 1px 5px var(--shadow-sm); font-weight:600; }\n  .score-banner { display:flex; align-items:center; gap:14px; background:var(--card); border:1px solid var(--border); border-radius:var(--radius); padding:14px 18px; margin-bottom:20px; }\n  .score-banner .sb-num { font-size:30px; font-weight:750; }\n  .score-banner .sb-stars { color:var(--amber); font-size:15px; letter-spacing:2px; }\n  .score-banner .sb-pill { margin-left:auto; }\n  .score-banner .sb-label { font-size:11px; color:var(--muted); }\n  .kpi-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(170px,1fr)); gap:13px; margin-bottom:24px; }\n  .kpi { background:var(--card); border:1px solid var(--border); border-radius:var(--radius); padding:15px 17px; transition:transform .16s,border-color .16s,box-shadow .16s; position:relative; overflow:hidden; }\n  .kpi:hover { transform:translateY(-3px); border-color:var(--accent); box-shadow:0 8px 22px var(--shadow-sm); }\n  .kpi .k-icon { width:30px; height:30px; border-radius:9px; display:flex; align-items:center; justify-content:center; font-size:14px; margin-bottom:9px; }\n  .kpi .k-icon.i-grade { background:rgba(251,191,36,.14); }\n  .kpi .k-icon.i-orders { background:var(--blue-15); }\n  .kpi .k-icon.i-revenue { background:var(--green-12); }\n  .kpi .k-icon.i-cart { background:rgba(167,139,250,.14); }\n  .kpi .k-icon.i-offers { background:rgba(96,165,250,.12); }\n  .kpi .k-icon.i-eval { background:var(--amber-2); }\n  .kpi .k-label { font-size:11.5px; color:var(--muted); margin-bottom:5px; font-weight:500; }\n  .kpi .k-value { font-size:25px; font-weight:700; letter-spacing:-.5px; line-height:1.1; font-variant-numeric:tabular-nums; }\n  .kpi .k-sub { font-size:11px; color:var(--muted); margin-top:6px; }\n  .kpi .k-sub .stars { font-size:12px; }\n  .sec { margin-bottom:24px; }\n  .sec h3 { font-size:12px; font-weight:700; color:var(--muted); letter-spacing:1.4px; margin-bottom:13px; display:flex; align-items:center; gap:9px; text-transform:uppercase; }\n  .sec h3 .sec-ic { font-size:14px; letter-spacing:0; }\n  .sec h3::after { content:\"\"; flex:1; height:1px; background:var(--border); }\n  .mgrid { display:grid; grid-template-columns:repeat(auto-fit,minmax(290px,1fr)); gap:13px; }\n  .mcard { background:var(--card); border:1px solid var(--border); border-radius:var(--radius); padding:16px 17px; transition:transform .15s,border-color .15s; }\n  .mcard:hover { transform:translateY(-2px); border-color:var(--border-light); }\n  .mcard .mc-top { display:flex; justify-content:space-between; align-items:flex-start; gap:10px; }\n  .mcard .mc-name { font-size:13px; font-weight:600; display:flex; align-items:center; gap:6px; }\n  .mcard .mc-val { font-size:23px; font-weight:700; letter-spacing:-.3px; margin-top:7px; font-variant-numeric:tabular-nums; }\n  .mcard .mc-unit { font-size:12px; color:var(--muted); margin-left:2px; font-weight:400; }\n  .mcard .mc-desc { font-size:11px; color:var(--muted); margin-top:7px; line-height:1.5; }\n  .mcard .bar { height:6px; border-radius:99px; background:var(--card2); margin-top:12px; overflow:hidden; }\n  .mcard .bar > i { display:block; height:100%; border-radius:99px; transition:width .45s cubic-bezier(.4,0,.2,1); }\n  .mcard .target { font-size:11px; color:var(--muted); margin-top:9px; display:flex; justify-content:space-between; }\n  .pill { font-size:10px; padding:2px 8px; border-radius:99px; border:1px solid; font-weight:600; letter-spacing:.3px; }\n  .pill.ok { color:var(--green); border-color:var(--green); background:var(--green-08); }\n  .pill.warn { color:var(--amber); border-color:var(--amber); background:var(--amber-2); }\n  .pill.bad { color:var(--red); border-color:var(--red); background:rgba(248,113,113,.1); }\n  .pill.assess { color:var(--purple); border-color:var(--purple); background:rgba(167,139,250,.1); }\n  .spark { display:flex; align-items:flex-end; gap:3px; height:26px; margin-top:12px; }\n  .spark i { flex:1; background:var(--blue-2); border-radius:3px 3px 0 0; min-height:3px; transition:height .3s; }\n  .spark i:last-child { background:var(--accent); }\n  .empty-dash { padding:64px 20px; text-align:center; color:var(--muted); font-size:13px; line-height:2; }\n  .empty-dash .ed-icon { font-size:36px; display:block; margin-bottom:10px; opacity:.6; }\n  /* ---- 退款 ---- */\n  .refund { padding:22px 26px; max-width:1280px; margin:0 auto; }\n  .refund h2, .ship h2, .offers h2 { font-size:20px; font-weight:700; margin-bottom:4px; }\n  .refund .r-sub, .ship .s-sub, .offers .s-sub { font-size:12px; color:var(--muted); margin-bottom:18px; }\n  .r-tabs { display:flex; gap:4px; background:var(--card2); padding:4px; border-radius:11px; border:1px solid var(--border); margin-bottom:16px; width:fit-content; }\n  .r-tabs .rt { font-size:12.5px; padding:6px 16px; border-radius:8px; cursor:pointer; color:var(--muted); font-weight:500; }\n  .r-tabs .rt.active { background:var(--card); color:var(--text); box-shadow:0 1px 5px var(--shadow-sm); font-weight:600; }\n  .r-panel { background:var(--card); border:1px solid var(--border); border-radius:var(--radius); padding:18px 20px; margin-bottom:16px; }\n  .r-panel h3 { font-size:13.5px; font-weight:650; margin-bottom:12px; }\n  .r-row { display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin-bottom:12px; }\n  .r-row label { font-size:12px; color:var(--muted); min-width:70px; }\n  .r-input { background:var(--card2); color:var(--text); border:1px solid var(--border); border-radius:var(--radius-sm); padding:8px 10px; font-size:13px; outline:none; }\n  .r-input:focus { border-color:var(--accent); }\n  .r-input.w200 { width:240px; }\n  .r-input.w120 { width:130px; }\n  .r-textarea { width:100%; min-height:120px; resize:vertical; font-family:Consolas,monospace; font-size:12.5px; }\n  .r-warn { background:var(--amber-2); border:1px solid var(--amber); border-radius:11px; padding:10px 14px; font-size:12px; margin-bottom:14px; line-height:1.6; }\n  .r-status { font-size:12.5px; color:var(--muted); }\n  .r-status.ok { color:var(--green); }\n  .r-status.err { color:var(--red); }\n  .line-tbl { width:100%; border-collapse:collapse; font-size:12.5px; margin-top:6px; }\n  .line-tbl th { text-align:left; padding:8px 10px; color:var(--muted); font-weight:600; border-bottom:1px solid var(--border); font-size:11px; letter-spacing:.5px; }\n  .line-tbl td { padding:9px 10px; border-bottom:1px solid var(--border-soft); vertical-align:middle; }\n  .line-tbl tr:hover td { background:var(--card2); }\n  .line-tbl .num { text-align:right; font-family:Consolas,monospace; font-variant-numeric:tabular-nums; }\n  .btn-sm { padding:4px 10px; font-size:12px; border-radius:7px; }\n  .btn-danger { background:var(--red); border-color:var(--red); color:#fff; }\n  .btn-danger:hover { opacity:.9; border-color:var(--red); background:var(--red); }\n  .rsel { background:var(--card2); color:var(--text); border:1px solid var(--border); border-radius:7px; padding:5px 8px; font-size:12px; outline:none; width:100%; }\n  .res-tbl { width:100%; border-collapse:collapse; font-size:12.5px; margin-top:10px; }\n  .res-tbl th { text-align:left; padding:8px 10px; color:var(--muted); font-weight:600; border-bottom:1px solid var(--border); font-size:11px; }\n  .res-tbl td { padding:8px 10px; border-bottom:1px solid var(--border-soft); }\n  .st-pill { font-size:11px; padding:2px 8px; border-radius:99px; font-weight:600; }\n  .st-refunded { background:var(--green-1); color:var(--green); }\n  .st-skipped { background:var(--amber-2); color:var(--amber); }\n  .st-not_found, .st-failed { background:rgba(248,113,113,.1); color:var(--red); }\n  /* ---- 发货 ---- */\n  .ship { padding:22px 26px; max-width:900px; margin:0 auto; }\n  .s-form { background:var(--card); border:1px solid var(--border); border-radius:var(--radius); padding:18px 20px; }\n  .s-field { margin-bottom:16px; }\n  .s-field label { display:block; font-size:12px; color:var(--muted); margin-bottom:6px; }\n  .s-input { width:100%; background:var(--card2); color:var(--text); border:1px solid var(--border); border-radius:var(--radius-sm); padding:9px 11px; font-size:13px; outline:none; }\n  .s-input:focus { border-color:var(--accent); }\n  .carrier-picker { position:relative; }\n  .carrier-drop { position:absolute; top:100%; left:0; right:0; max-height:280px; overflow-y:auto; background:var(--card2); border:1px solid var(--border); border-radius:11px; z-index:70; margin-top:4px; box-shadow:0 12px 34px var(--shadow-sm); }\n  .carrier-opt { padding:9px 12px; font-size:13px; cursor:pointer; border-bottom:1px solid var(--border-soft); display:flex; justify-content:space-between; gap:10px; }\n  .carrier-opt:hover { background:var(--green-1); }\n  .carrier-opt .co-zh { font-weight:500; }\n  .carrier-opt .co-code { font-size:11px; color:var(--muted); font-family:Consolas,monospace; }\n  .carrier-empty { padding:12px; font-size:12px; color:var(--muted); }\n  .url-preview { margin-top:10px; background:var(--card2); border:1px dashed var(--border); border-radius:10px; padding:11px 13px; font-size:12px; }\n  .url-preview .up-label { color:var(--muted); font-size:11px; margin-bottom:4px; }\n  .url-preview .up-url { font-family:Consolas,monospace; word-break:break-all; color:var(--green); }\n  .url-preview .up-url a { color:var(--green); }\n  .s-status { font-size:12.5px; color:var(--muted); }\n  .s-status.ok { color:var(--green); }\n  .s-status.warn { color:var(--warning); }\n  .s-status.err { color:var(--red); }\n  .s-actions { display:flex; gap:10px; align-items:center; margin-top:18px; }\n  /* ---- API 管理 ---- */\n  .api-row { display:flex; gap:8px; align-items:center; margin-bottom:8px; }\n  .api-row input { background:var(--card2); color:var(--text); border:1px solid var(--border); border-radius:var(--radius-sm); padding:8px 10px; font-size:12.5px; outline:none; }\n  .api-row input:focus { border-color:var(--accent); }\n  .api-row .api-name { flex:1; min-width:110px; }\n  .api-row .api-id { width:110px; font-family:Consolas,monospace; }\n  .api-row .api-key { flex:2; min-width:160px; font-family:Consolas,monospace; }\n  .api-row .api-block { border:1px solid var(--border); background:var(--card2); color:var(--text); cursor:pointer; font-size:12px; padding:7px 10px; border-radius:8px; flex-shrink:0; white-space:nowrap; }\n  .api-row .api-block:hover { border-color:var(--accent); color:var(--accent); }\n  .api-row .api-block.blocked { color:var(--green); border-color:var(--green); background:var(--green-1); }\n  .api-row .api-del { background:transparent; border:none; color:var(--muted); cursor:pointer; font-size:15px; padding:4px 8px; border-radius:7px; flex-shrink:0; }\n  .api-row .api-del:hover { background:var(--red); color:#fff; }\n  /* ---- 报价 ---- */\n  .offers { padding:22px 26px; max-width:1280px; margin:0 auto; }\n</style>\n<!-- UI_V20_START -->\n<style id=\"ui-v20\">\n/* Mirakl Operations Workbench UI v23 Aurora Ops */\n:root {\n  color-scheme: light;\n  --nav-bg:#0b1b3a;\n  --nav-bg-2:#102a5a;\n  --nav-text:#c8d5ee;\n  --nav-muted:#8fa5c9;\n  --canvas:#f3f6fb;\n  --surface:#ffffff;\n  --surface-soft:#f8fafc;\n  --surface-strong:#eef3f9;\n  --line:#e2e8f0;\n  --line-strong:#cbd5e1;\n  --text:#101828;\n  --text-2:#475467;\n  --text-3:#7b879c;\n  --accent:#2563eb;\n  --accent-hover:#1d4ed8;\n  --accent-soft:#eaf1ff;\n  --success:#0f9f7a;\n  --success-soft:#e8f7f2;\n  --warning:#d99000;\n  --warning-soft:#fff6dc;\n  --danger:#d92d3f;\n  --danger-soft:#fff0f1;\n  --focus:rgba(37,99,235,.28);\n  --shadow-xs:0 1px 2px rgba(16,24,40,.04);\n  --shadow-sm:0 8px 24px rgba(16,24,40,.07);\n  --radius-control:8px;\n  --radius-card:12px;\n  --radius-panel:16px;\n\n  /* Legacy variables mapped to v20 semantic roles. */\n  --bg:var(--canvas);\n  --bg2:var(--surface-soft);\n  --card:var(--surface);\n  --card2:var(--surface-strong);\n  --border:var(--line);\n  --muted:var(--text-3);\n  --red:var(--danger);\n  --amber:var(--warning);\n  --green:var(--success);\n  --blue:var(--accent);\n  --purple:#6941c6;\n  --accent2:#3158d4;\n  --accent-grad:linear-gradient(135deg,#2563eb,#3158d4);\n  --group-fill:var(--success-soft);\n  --group-border:#a6dfcf;\n  --group-head:#dcf5ed;\n  --border-soft:rgba(16,24,40,.055);\n  --border-light:rgba(16,24,40,.1);\n  --hover:#edf3fb;\n  --scroll-thumb:#c6d0df;\n  --scroll-thumb-hover:#9dabbe;\n  --mask:rgba(8,15,30,.52);\n  --shadow:rgba(16,24,40,.2);\n  --shadow-sm:rgba(16,24,40,.1);\n  --bubble-hover:#bfd0e8;\n  --blue-05:rgba(37,99,235,.05);\n  --blue-1:rgba(37,99,235,.1);\n  --blue-15:rgba(37,99,235,.14);\n  --blue-18:rgba(37,99,235,.18);\n  --blue-2:rgba(37,99,235,.22);\n  --blue-glow:rgba(37,99,235,.28);\n  --green-08:rgba(15,159,122,.08);\n  --green-1:rgba(15,159,122,.1);\n  --green-12:rgba(15,159,122,.13);\n  --green-14:rgba(15,159,122,.15);\n  --green-16:rgba(15,159,122,.17);\n  --green-2:rgba(15,159,122,.2);\n  --amber-2:rgba(217,144,0,.16);\n  --muted-2:rgba(123,135,156,.16);\n  --group-5:rgba(15,159,122,.05);\n  --group-8:rgba(15,159,122,.09);\n  --radius:var(--radius-card);\n  --radius-sm:var(--radius-control);\n}\n\nhtml[data-theme=\"dark\"] {\n  color-scheme: dark;\n  --canvas:#0c1220;\n  --surface:#121a2a;\n  --surface-soft:#101827;\n  --surface-strong:#172235;\n  --line:#25334a;\n  --line-strong:#364963;\n  --text:#f3f6fb;\n  --text-2:#b6c1d2;\n  --text-3:#8290a7;\n  --accent:#5b8def;\n  --accent-hover:#78a4ff;\n  --accent-soft:rgba(91,141,239,.15);\n  --success:#35c79d;\n  --success-soft:rgba(53,199,157,.12);\n  --warning:#f2b84b;\n  --warning-soft:rgba(242,184,75,.12);\n  --danger:#fb7185;\n  --danger-soft:rgba(251,113,133,.12);\n  --focus:rgba(91,141,239,.4);\n  --shadow-xs:0 1px 2px rgba(0,0,0,.16);\n  --shadow-sm:0 12px 32px rgba(0,0,0,.24);\n  --group-border:rgba(53,199,157,.3);\n  --group-head:rgba(53,199,157,.12);\n  --border-soft:rgba(255,255,255,.05);\n  --border-light:rgba(255,255,255,.09);\n  --hover:#1b2940;\n  --scroll-thumb:#33445e;\n  --scroll-thumb-hover:#4a607f;\n  --mask:rgba(3,7,16,.72);\n  --shadow:rgba(0,0,0,.5);\n  --shadow-sm:rgba(0,0,0,.3);\n  --bubble-hover:#384c6a;\n}\n\n* { box-sizing:border-box; }\nhtml { font-size:14px; background:var(--canvas); }\nbody {\n  background:var(--canvas);\n  color:var(--text);\n  font-family:\"Segoe UI Variable\",\"Segoe UI\",\"Microsoft YaHei UI\",\"Microsoft YaHei\",sans-serif;\n  letter-spacing:.005em;\n}\nbutton,input,select,textarea { font:inherit; }\nbutton,select,input[type=\"checkbox\"] { accent-color:var(--accent); }\n:focus-visible { outline:3px solid var(--focus); outline-offset:2px; }\n/* v26.90：选区高亮不能用 --accent-soft。浅色主题下它是 #f0f1ff，与我方发出消息的\n   气泡渐变（#eef2ff → #e8efff）对比度只有 1.00:1 —— 拖选后画面上零反馈，组员报的\n   「我方发送的内容无法选中复制」就是它（收到的消息是白底 #fff，1.12:1，勉强看得出，\n   所以只有我方那一侧被投诉）。改成 accent 半透明叠加：叠加后在我方气泡、收到气泡白底、\n   面板底 #eef1f7 三类底色上都 ≥1.4:1，且文字仍用 --text 保持可读。 */\n::selection { background:rgba(93,94,234,.3); color:var(--text); }\nhtml[data-theme=\"dark\"] ::selection { background:rgba(133,136,255,.48); color:var(--text); }\n\n.icon-svg,\n.ni {\n  display:inline-block;\n  width:18px;\n  height:18px;\n  flex:0 0 18px;\n  background:currentColor;\n  -webkit-mask:var(--icon) center/contain no-repeat;\n  mask:var(--icon) center/contain no-repeat;\n  font-size:0!important;\n  line-height:0;\n}\n\n.app { background:var(--canvas); }\n.topbar {\n  height:64px;\n  gap:10px;\n  padding:0 18px 0 0;\n  background:var(--surface);\n  border-color:var(--line);\n  box-shadow:var(--shadow-xs);\n  position:relative;\n  z-index:20;\n}\n.topbar .logo {\n  width:220px;\n  height:64px;\n  padding:0 20px;\n  gap:12px;\n  color:#fff;\n  background:var(--nav-bg);\n}\n.topbar .logo-mark {\n  width:34px;\n  height:34px;\n  border-radius:9px;\n  background:#2563eb;\n  box-shadow:0 8px 18px rgba(37,99,235,.28);\n}\n.topbar h1 { font-size:15px; font-weight:700; letter-spacing:.01em; }\n.topbar > div:last-of-type { gap:7px!important; }\n.topbar label { color:var(--text-3)!important; font-weight:600; }\n.topbar .btn { min-height:36px; padding:0 12px; border-radius:9px; }\n.topbar .btn.primary {\n  background:var(--success);\n  border-color:var(--success);\n  box-shadow:none;\n}\n.topbar .btn.primary:hover { background:#0b8769; border-color:#0b8769; filter:none; }\n.topbar .status { color:var(--success); font-weight:600; }\n.topbar .status .icon-svg { width:14px; height:14px; margin-right:5px; vertical-align:-2px; }\n\n.main { background:var(--canvas); }\n.col-nav {\n  width:220px;\n  padding:18px 12px;\n  gap:5px;\n  color:var(--nav-text);\n  background:linear-gradient(180deg,var(--nav-bg),#08152d);\n  border-right:0;\n  box-shadow:inset -1px 0 rgba(255,255,255,.04);\n}\n.nav-item {\n  min-height:44px;\n  padding:0 14px;\n  gap:12px;\n  color:var(--nav-text);\n  border-radius:9px;\n  font-size:14px;\n  font-weight:520;\n}\n.nav-item:hover { color:#fff; background:rgba(255,255,255,.07); }\n.nav-item.active {\n  color:#fff;\n  background:linear-gradient(90deg,rgba(37,99,235,.72),rgba(37,99,235,.38));\n  box-shadow:inset 0 0 0 1px rgba(255,255,255,.06);\n}\n.nav-item.active::before { display:none; }\n.nav-item .ni { width:19px; height:19px; color:currentColor; }\n\n.page { background:var(--canvas); }\n.btn {\n  min-height:36px;\n  padding:0 14px;\n  color:var(--text-2);\n  background:var(--surface);\n  border:1px solid var(--line);\n  border-radius:var(--radius-control);\n  box-shadow:var(--shadow-xs);\n  font-size:13px;\n  font-weight:600;\n  transition:background .15s,border-color .15s,color .15s,box-shadow .15s,transform .15s;\n}\n.btn:hover {\n  color:var(--text);\n  background:var(--surface-soft);\n  border-color:var(--line-strong);\n  box-shadow:0 4px 12px rgba(16,24,40,.07);\n  transform:none;\n}\n.btn.primary { color:#fff; background:var(--accent); border-color:var(--accent); box-shadow:none; }\n.btn.primary:hover { background:var(--accent-hover); border-color:var(--accent-hover); filter:none; }\n.btn:disabled { opacity:.45; box-shadow:none; }\n\n.sel-shop,\n.r-input,\n.s-input,\n.modal input[type=\"text\"],\n.modal textarea,\n.modal select {\n  min-height:38px;\n  color:var(--text);\n  background:var(--surface-soft);\n  border:1px solid var(--line);\n  border-radius:var(--radius-control);\n}\n.sel-shop:focus,\n.r-input:focus,\n.s-input:focus,\n.modal input[type=\"text\"]:focus,\n.modal textarea:focus,\n.modal select:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--focus); outline:0; }\n\n.modal-mask { background:var(--mask); backdrop-filter:blur(8px); }\n.modal {\n  padding:24px;\n  background:var(--surface);\n  border-color:var(--line);\n  border-radius:var(--radius-panel);\n  box-shadow:0 28px 80px rgba(8,15,30,.32);\n}\n.modal h2 { margin-bottom:18px; font-size:18px; }\n.status { color:var(--text-3); }\n.status.ok { color:var(--success); }\n.status.warn { color:var(--warning); }\n.status.err { color:var(--danger); }\n/* v26.97：后台任务中心（顶栏右上角常驻）。配色一律走主题变量，保证对比度与既有状态文案一致 */\n.task-center { position:relative; display:inline-flex; }\n.task-btn { display:inline-flex; align-items:center; gap:6px; height:30px; padding:0 10px; border-radius:8px; border:1px solid var(--line); background:var(--surface); color:var(--text-3); font-size:12px; cursor:pointer; }\n.task-btn:hover { color:var(--text); }\n.task-center[data-state=\"running\"] .task-btn { color:var(--text); }\n.task-center[data-state=\"failed\"] .task-btn { color:var(--danger); border-color:currentColor; }\n.task-spinner { width:10px; height:10px; border-radius:50%; border:2px solid currentColor; border-top-color:transparent; flex:0 0 auto; }\n.task-center[data-state=\"running\"] .task-spinner { animation:task-spin 1s linear infinite; }\n.task-center[data-state=\"idle\"] .task-spinner,\n.task-center[data-state=\"done\"] .task-spinner { display:none; }\n@keyframes task-spin { to { transform:rotate(360deg); } }\n.task-badge { min-width:16px; height:16px; padding:0 4px; border-radius:8px; background:var(--danger); color:#fff; font-size:10.5px; line-height:16px; text-align:center; }\n.task-panel { position:absolute; top:calc(100% + 8px); right:0; width:430px; max-height:58vh; overflow:auto; background:var(--surface); border:1px solid var(--line); border-radius:12px; box-shadow:0 18px 48px rgba(8,15,30,.28); z-index:60; }\n.task-panel-head { display:flex; align-items:center; justify-content:space-between; gap:8px; padding:10px 12px; border-bottom:1px solid var(--line); position:sticky; top:0; background:var(--surface); z-index:1; }\n.task-panel-head strong { font-size:13px; }\n.task-clear { background:none; border:none; color:var(--text-3); font-size:12px; cursor:pointer; padding:2px 4px; }\n.task-clear:hover { color:var(--text); }\n.task-clear:disabled { opacity:.5; cursor:default; }\n.task-list { padding:6px; }\n.task-empty { padding:20px 10px; text-align:center; color:var(--text-3); font-size:12px; }\n.task-row { display:flex; gap:8px; padding:8px; border-radius:8px; }\n.task-row + .task-row { border-top:1px solid var(--line); }\n.task-ico { width:8px; height:8px; border-radius:50%; margin-top:5px; flex:0 0 auto; background:var(--text-3); }\n.task-row[data-s=\"running\"] .task-ico { background:var(--text); animation:task-pulse 1.2s ease-in-out infinite; }\n.task-row[data-s=\"success\"] .task-ico { background:var(--success); }\n.task-row[data-s=\"partial\"] .task-ico { background:var(--warning); }\n.task-row[data-s=\"failed\"] .task-ico { background:var(--danger); }\n@keyframes task-pulse { 50% { opacity:.3; } }\n.task-body { min-width:0; flex:1; }\n.task-title { font-size:12.5px; color:var(--text); display:flex; gap:6px; align-items:baseline; flex-wrap:wrap; }\n.task-shop { color:var(--text-3); font-size:11px; }\n.task-meta { font-size:11.5px; color:var(--text-3); margin-top:2px; word-break:break-word; }\n.task-meta.ok { color:var(--success); }\n.task-meta.warn { color:var(--warning); }\n.task-meta.err { color:var(--danger); }\n/* v26.97 批量回复逐封结果：失败 / 跳过必须看得见，不再只藏在 tooltip 里 */\n.reply-batch-report {\n  margin: 6px 0 0;\n  padding: 6px 9px;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: var(--surface-soft);\n  max-height: 132px;\n  overflow: auto;\n  font-size: 12px;\n  line-height: 1.75;\n}\n.reply-batch-report[hidden] { display: none; }\n.reply-batch-line { display: flex; gap: 6px; align-items: baseline; }\n.reply-batch-line .rb-mark { flex: none; font-weight: 700; }\n.reply-batch-line .rb-id { opacity: .8; }\n.reply-batch-line[data-s=\"wait\"] { color: var(--text-3); }\n.reply-batch-line[data-s=\"ok\"] { color: var(--success); }\n.reply-batch-line[data-s=\"skip\"] { color: var(--warning); }\n.reply-batch-line[data-s=\"fail\"] { color: var(--danger); }\n.task-time { font-size:10.5px; color:var(--text-3); margin-top:3px; }\n.empty,.loading { color:var(--text-3); }\n\n@media (prefers-reduced-motion:reduce) {\n  *,*::before,*::after { scroll-behavior:auto!important; transition:none!important; animation:none!important; }\n}\n\n/* v20 icon assignments */\n.icon-theme,.icon-moon{--icon:var(--icon-moon)}\n.icon-sun{--icon:var(--icon-sun)}\n.icon-template{--icon:var(--icon-template)}\n.icon-settings{--icon:var(--icon-settings)}\n.icon-compose{--icon:var(--icon-compose)}\n.icon-refresh{--icon:var(--icon-refresh)}\n.icon-read{--icon:var(--icon-read)}\n.icon-inbox{--icon:var(--icon-inbox)}\n.icon-dashboard{--icon:var(--icon-dashboard)}\n.icon-ship{--icon:var(--icon-ship)}\n.icon-refund{--icon:var(--icon-refund)}\n.icon-returnlabel{--icon:var(--icon-returnlabel)}\n.icon-paperclip{--icon:var(--icon-paperclip)}\n.icon-send{--icon:var(--icon-send)}\n.icon-alert{--icon:var(--icon-alert)}\n.icon-clock{--icon:var(--icon-clock)}\n.icon-arrow-right{--icon:var(--icon-arrowRight)}\n.icon-lightbulb{--icon:var(--icon-lightbulb)}\n.icon-calendar{--icon:var(--icon-calendar)}\n.icon-chart{--icon:var(--icon-chart)}\n.icon-orders{--icon:var(--icon-orders)}\n.icon-revenue{--icon:var(--icon-revenue)}\n.icon-cart{--icon:var(--icon-cart)}\n.icon-offers{--icon:var(--icon-offers)}\n.icon-comments{--icon:var(--icon-comments)}\n.icon-star{--icon:var(--icon-star)}\n.icon-check{--icon:var(--icon-check)}\n.inline-icon { width:15px; height:15px; margin-right:7px; vertical-align:-2px; }\n\n.btn { display:inline-flex; align-items:center; justify-content:center; gap:7px; }\n.btn .icon-svg { width:15px; height:15px; }\n.topbar .sel-shop { min-width:188px; }\n\n/* Dashboard v20 — risk-first, calm density */\n.dashboard-v20 { overflow-y:auto; }\n.dashboard-v20 .dash {\n  width:min(100%,1360px);\n  max-width:none;\n  margin:0 auto;\n  padding:28px 32px 48px;\n}\n.dashboard-v20 .dash-head {\n  margin:0 0 18px;\n  padding:0;\n}\n.dashboard-v20 .shop-badge {\n  width:46px;\n  height:46px;\n  border-radius:12px;\n  background:linear-gradient(145deg,var(--accent),#5b8def);\n  box-shadow:0 8px 20px rgba(37,99,235,.18);\n  font-size:19px;\n}\n.dashboard-v20 .dh-left h2 { font-size:21px; letter-spacing:-.02em; }\n.dashboard-v20 .dh-left .sub { margin-top:7px; color:var(--text-3); }\n.dashboard-v20 .m-chip {\n  padding:3px 8px;\n  background:var(--surface);\n  border:1px solid var(--line);\n  border-radius:6px;\n  color:var(--text-2);\n}\n.dashboard-v20 .period-tabs {\n  padding:4px;\n  background:var(--surface-soft);\n  border:1px solid var(--line);\n  border-radius:10px;\n}\n.dashboard-v20 .period-tabs .pt { min-width:70px; padding:7px 12px; text-align:center; border-radius:7px; }\n.dashboard-v20 .period-tabs .pt.active { color:var(--accent); background:var(--surface); box-shadow:var(--shadow-xs); }\n.dashboard-v20 .health-strip {\n  display:grid;\n  grid-template-columns:auto minmax(120px,1fr) auto minmax(220px,auto);\n  align-items:center;\n  gap:18px;\n  margin:0 0 18px;\n  padding:18px 20px;\n  background:linear-gradient(135deg,var(--surface) 0%,var(--surface-soft) 100%);\n  border:1px solid var(--line);\n  border-left:4px solid var(--accent);\n  border-radius:var(--radius-panel);\n  box-shadow:var(--shadow-xs);\n}\n.dashboard-v20 .score-banner .sb-num { margin-top:2px; font-size:32px; line-height:1; letter-spacing:-.04em; }\n.dashboard-v20 .score-banner .sb-stars { font-size:14px; color:#f59e0b; }\n.dashboard-v20 .score-banner .sb-label { color:var(--text-3); font-weight:600; letter-spacing:.02em; }\n.dashboard-v20 .kpi-grid {\n  grid-template-columns:repeat(6,minmax(0,1fr));\n  gap:12px;\n  margin:0 0 28px;\n}\n.dashboard-v20 .summary-card {\n  min-height:142px;\n  padding:16px;\n  background:var(--surface);\n  border:1px solid var(--line);\n  border-radius:var(--radius-card);\n  box-shadow:var(--shadow-xs);\n}\n.dashboard-v20 .summary-card:hover { transform:none; border-color:var(--line-strong); box-shadow:var(--shadow-sm); }\n.dashboard-v20 .kpi .k-icon {\n  width:32px;\n  height:32px;\n  margin:0 0 16px;\n  color:var(--accent);\n  background:var(--accent-soft);\n  border-radius:9px;\n  font-size:0;\n}\n.dashboard-v20 .kpi .k-icon::before {\n  content:\"\";\n  width:16px;\n  height:16px;\n  background:currentColor;\n  -webkit-mask:var(--icon) center/contain no-repeat;\n  mask:var(--icon) center/contain no-repeat;\n}\n.dashboard-v20 .kpi .i-revenue { color:var(--success); background:var(--success-soft); }\n.dashboard-v20 .kpi .i-grade { color:#b7791f; background:#fff7dd; }\n.dashboard-v20 .kpi .i-cart { color:#7c3aed; background:#f3e8ff; }\n.dashboard-v20 .kpi .k-label { color:var(--text-3); font-weight:600; }\n.dashboard-v20 .kpi .k-value { margin-top:6px; font-size:24px; color:var(--text); }\n.dashboard-v20 .sec { margin:0 0 28px; }\n.dashboard-v20 .sec h3 {\n  margin:0 0 11px;\n  color:var(--text);\n  font-size:14px;\n  font-weight:700;\n  letter-spacing:0;\n  text-transform:none;\n}\n.dashboard-v20 .sec h3::after { background:var(--line); }\n.dashboard-v20 .section-kicker {\n  padding:3px 7px;\n  color:var(--accent);\n  background:var(--accent-soft);\n  border-radius:5px;\n  font-size:9px;\n  letter-spacing:.08em;\n  text-transform:uppercase;\n}\n.dashboard-v20 .mgrid { grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }\n.dashboard-v20 .metric-card {\n  min-height:165px;\n  padding:17px;\n  background:var(--surface);\n  border:1px solid var(--line);\n  border-radius:var(--radius-card);\n  box-shadow:var(--shadow-xs);\n}\n.dashboard-v20 .metric-card:hover { transform:none; border-color:var(--line-strong); }\n.dashboard-v20 .metric-card.bad { border-top:3px solid var(--danger); }\n.dashboard-v20 .metric-card.warn { border-top:3px solid var(--warning); }\n.dashboard-v20 .metric-card.ok { border-top:3px solid var(--success); }\n.dashboard-v20 .mcard .mc-val { font-size:24px; }\n.dashboard-v20 .mcard .bar { height:5px; background:var(--surface-strong); }\n.dashboard-v20 .empty-dash {\n  min-height:420px;\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  justify-content:center;\n  gap:10px;\n}\n.dashboard-v20 .empty-dash .ed-icon { width:36px; height:36px; color:var(--accent); }\n\n/* Inbox v20 — work queue + conversation + contextual composer */\n.inbox-v20 { overflow:hidden; background:var(--surface); }\n.inbox-v20 .col-shops {\n  width:224px;\n  background:var(--nav-bg-soft);\n  border-right:1px solid rgba(255,255,255,.07);\n}\n.inbox-v20 .panel-title { min-height:49px; padding:0 16px; color:#aab8cf; border-color:rgba(255,255,255,.07); }\n.inbox-v20 .all-shops-row { background:transparent; padding:7px 9px; }\n.inbox-v20 .shop-item {\n  min-height:42px;\n  padding:0 11px;\n  color:#cad5e5;\n  border:0;\n  border-radius:8px;\n}\n.inbox-v20 .shop-item:hover { background:rgba(255,255,255,.06); color:#fff; }\n.inbox-v20 .shop-item.active { color:#fff; background:rgba(37,99,235,.48); box-shadow:none; }\n.inbox-v20 .shop-item .name { display:flex; align-items:center; gap:8px; }\n.inbox-v20 .shop-item .icon-svg { width:15px; height:15px; }\n.inbox-v20 .shop-item .cnt.zero { color:#8999b2; }\n.inbox-v20 .col-list { width:352px; background:var(--surface); border-right:1px solid var(--line); }\n.inbox-v20 .inbox-commandbar { min-height:50px; padding:0 14px; background:var(--surface); border-color:var(--line); }\n.inbox-v20 .filter-tab { padding:6px 10px; border-radius:7px; color:var(--text-3); font-weight:600; }\n.inbox-v20 .filter-tab.active { color:var(--accent); background:var(--accent-soft); }\n.inbox-v20 .conversation-list { background:var(--surface); }\n.inbox-v20 .mail-item { margin:0 10px; padding:14px 12px; border-bottom:1px solid var(--line); border-radius:0; }\n.inbox-v20 .mail-item:hover { background:var(--surface-soft); }\n.inbox-v20 .mail-item.unread { background:var(--accent-soft); }\n.inbox-v20 .mail-item.active { background:#e7efff; box-shadow:inset 3px 0 0 var(--accent); }\n.inbox-v20 .mail-item.unread::after { left:4px; width:6px; height:6px; background:var(--accent); box-shadow:none; }\n.inbox-v20 .mail-item .from { font-size:13px; color:var(--text); }\n.inbox-v20 .mail-item .subj { margin-top:5px; color:var(--text-3); line-height:1.45; }\n.inbox-v20 .col-read { min-width:0; background:var(--canvas); }\n.inbox-v20 .read-pane { background:var(--canvas); }\n.inbox-v20 .thread-head { padding:20px 24px; background:var(--surface); border-color:var(--line); }\n.inbox-v20 .thread-head .t-title { font-size:17px; letter-spacing:-.01em; }\n.inbox-v20 .msgs { padding:24px; }\n.inbox-v20 .msg { max-width:76%; margin-bottom:18px; }\n.inbox-v20 .msg .msg-body { border-radius:14px; box-shadow:var(--shadow-xs); }\n.inbox-v20 .reply-box {\n  padding:14px 20px 16px;\n  background:var(--surface);\n  border-top:1px solid var(--line);\n  box-shadow:0 -10px 28px rgba(16,24,40,.04);\n}\n.inbox-v20 .reply-box textarea {\n  min-height:86px;\n  padding:12px 14px;\n  background:var(--surface-soft);\n  border-color:var(--line);\n  border-radius:10px;\n}\n.inbox-v20 .reply-box textarea:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--focus); }\n\n/* Operational modules v20 */\n.operations-page { background:var(--canvas); }\n.operations-page > .refund,\n.operations-page > .ship,\n.operations-page > .offers {\n  width:min(100%,1180px);\n  max-width:none;\n  margin:0 auto;\n  padding:30px 32px 48px;\n}\n.operations-page h2 { margin:0 0 6px; font-size:22px; line-height:1.25; letter-spacing:-.02em; }\n.operations-page .operation-header { margin-bottom:18px; }\n.operations-page .operation-header .r-sub,\n.operations-page .operation-header .s-sub { margin-bottom:0; }\n.operations-page .r-sub,\n.operations-page .s-sub { margin-bottom:20px; color:var(--text-3); line-height:1.6; }\n\n/* ---- AI 任务桥 ---- */\n.agent-shell { max-width:1180px; margin:0 auto; padding:30px 32px 48px; }\n.agent-head { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:20px; flex-wrap:wrap; }\n.agent-head h2 { margin:0 0 6px; font-size:22px; line-height:1.25; letter-spacing:-.02em; }\n.agent-head p { margin:0; color:var(--text-3); font-size:13px; line-height:1.6; max-width:760px; }\n.agent-bridge { display:flex; align-items:center; gap:8px; font-size:12px; padding:6px 12px; border-radius:99px; border:1px solid var(--line); background:var(--surface-soft); color:var(--text-2); white-space:nowrap; }\n.agent-bridge .dot { width:7px; height:7px; border-radius:99px; background:var(--success); flex:0 0 7px; }\n.agent-bridge.bad .dot { background:var(--danger); }\n.agent-panel { background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-panel); padding:18px; margin-bottom:18px; box-shadow:var(--shadow-xs); }\n.agent-panel h3 { margin:0 0 12px; font-size:14px; font-weight:600; }\n.agent-presets { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px; }\n.agent-preset { padding:6px 12px; font-size:12px; border-radius:99px; border:1px solid var(--line); background:var(--surface-soft); color:var(--text-2); cursor:pointer; transition:all .14s; }\n.agent-preset:hover { border-color:var(--accent); color:var(--accent); background:var(--accent-soft); }\n.agent-input { width:100%; min-height:96px; resize:vertical; padding:12px 14px; font:inherit; font-size:13px; line-height:1.6; color:var(--text); background:var(--surface-soft); border:1px solid var(--line); border-radius:var(--radius-control); outline:none; }\n.agent-input:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--focus); }\n.agent-row { display:flex; align-items:center; gap:10px; margin-top:12px; flex-wrap:wrap; }\n.agent-row .spacer { flex:1; }\n.agent-field { display:flex; align-items:center; gap:6px; font-size:12px; color:var(--text-3); }\n.agent-field input, .agent-field select { padding:5px 8px; font:inherit; font-size:12px; color:var(--text); background:var(--surface-soft); border:1px solid var(--line); border-radius:6px; }\n.agent-hint { margin-top:10px; font-size:12px; color:var(--text-3); line-height:1.6; }\n.agent-list { display:flex; flex-direction:column; gap:12px; }\n.agent-item { background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-card); overflow:hidden; }\n.agent-item-head { display:flex; align-items:center; gap:10px; padding:12px 14px; cursor:pointer; }\n.agent-item-head:hover { background:var(--surface-soft); }\n.agent-status { flex:0 0 auto; padding:3px 9px; font-size:11px; font-weight:600; border-radius:99px; }\n.agent-status.running { color:var(--warning); background:var(--warning-soft); }\n.agent-status.done { color:var(--success); background:var(--success-soft); }\n.agent-status.failed { color:var(--danger); background:var(--danger-soft); }\n.agent-item-prompt { flex:1; font-size:13px; color:var(--text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n.agent-item-meta { font-size:11.5px; color:var(--text-3); white-space:nowrap; }\n.agent-item-body { border-top:1px solid var(--line); padding:12px 14px; display:none; }\n.agent-item.open .agent-item-body { display:block; }\n.agent-result { white-space:pre-wrap; word-break:break-word; font-size:13px; line-height:1.7; color:var(--text); background:var(--surface-soft); border:1px solid var(--line); border-radius:var(--radius-control); padding:12px 14px; max-height:420px; overflow:auto; }\n.agent-error { margin-bottom:10px; padding:10px 12px; font-size:12.5px; line-height:1.6; color:var(--danger); background:var(--danger-soft); border:1px solid var(--danger); border-radius:var(--radius-control); }\n.agent-logs { margin-top:12px; max-height:280px; overflow:auto; border-top:1px solid var(--line); padding-top:10px; }\n.agent-log { display:flex; gap:10px; padding:4px 0; font-size:12px; line-height:1.6; color:var(--text-2); }\n.agent-log .t { flex:0 0 62px; color:var(--text-3); font-variant-numeric:tabular-nums; }\n.agent-empty { padding:34px; text-align:center; color:var(--text-3); font-size:13px; }\n.operations-page .r-tabs { display:inline-flex; padding:4px; background:var(--surface-soft); border:1px solid var(--line); border-radius:10px; }\n.operations-page .r-tabs .rt { padding:7px 13px; border-radius:7px; font-weight:600; }\n.operations-page .r-tabs .rt.active { color:var(--accent); background:var(--surface); box-shadow:var(--shadow-xs); }\n.operations-page .r-panel,\n.operations-page .s-form {\n  margin-bottom:14px;\n  padding:20px;\n  background:var(--surface);\n  border:1px solid var(--line);\n  border-radius:var(--radius-panel);\n  box-shadow:var(--shadow-xs);\n}\n.operations-page .workflow-panel { position:relative; }\n.operations-page .workflow-panel::before {\n  content:\"\";\n  position:absolute;\n  inset:0 auto 0 0;\n  width:3px;\n  background:var(--accent);\n  border-radius:var(--radius-panel) 0 0 var(--radius-panel);\n  opacity:.72;\n}\n.operations-page .r-panel h3,\n.operations-page .s-form h3 { color:var(--text); font-size:14px; }\n.operations-page .r-warn {\n  padding:13px 15px;\n  color:#923b21;\n  background:var(--danger-soft);\n  border:1px solid #f6b8aa;\n  border-left:4px solid var(--danger);\n  border-radius:10px;\n}\n.operations-page .guardrail-callout { box-shadow:0 4px 14px rgba(224,91,62,.06); }\n.operations-page label { color:var(--text-2); font-weight:650; }\n.operations-page table { background:var(--surface); }\n.operations-page th { color:var(--text-3); background:var(--surface-soft); }\n\n@media (max-width:1240px) {\n  .topbar .logo,.col-nav { width:190px; }\n  .dashboard-v20 .kpi-grid { grid-template-columns:repeat(3,minmax(0,1fr)); }\n  .dashboard-v20 .mgrid { grid-template-columns:repeat(2,minmax(0,1fr)); }\n  .topbar .btn span:last-child { display:none; }\n  .topbar .btn { width:36px; padding:0; }\n  .topbar #btnNewThread { width:38px; }\n}\n\n@media (max-width:980px) {\n  .topbar .logo,.col-nav { width:76px; }\n  .topbar .logo { padding:0 21px; }\n  .topbar .logo h1,.col-nav .nav-item:not(.active)::after { display:none; }\n  .col-nav { align-items:center; padding:14px 10px; }\n  .nav-item { width:48px; justify-content:center; padding:0; font-size:0; }\n  .inbox-v20 .col-shops { width:188px; }\n  .inbox-v20 .col-list { width:310px; }\n  .dashboard-v20 .dash,.operations-page > .refund,.operations-page > .ship,.operations-page > .offers { padding-left:22px; padding-right:22px; }\n  .dashboard-v20 .health-strip { grid-template-columns:auto 1fr auto; }\n  .dashboard-v20 .health-strip > div:last-child { grid-column:1/-1; text-align:left!important; }\n}\n\n@media (max-width:760px) {\n  .topbar { overflow-x:auto; }\n  .topbar label { display:none; }\n  .dashboard-v20 .kpi-grid,.dashboard-v20 .mgrid { grid-template-columns:1fr 1fr; }\n  .inbox-v20 .col-shops { display:none; }\n  .inbox-v20 .col-list { width:42%; min-width:260px; }\n}\n\n/* v21 reference match: dashboard composition */\n.topbar .logo { width:228px; }\n.col-nav { width:228px; background:linear-gradient(180deg,#081a38 0%,#0a224c 55%,#103b82 100%); }\n.screenshot-dashboard { padding:28px 24px 52px!important; background:var(--canvas); }\n.screenshot-dashboard .dash-head { margin:0 0 22px; min-height:52px; }\n.screenshot-dashboard .shop-badge { width:54px; height:54px; border-radius:15px; font-size:23px; background:linear-gradient(145deg,#3156ff,#4f46e5); }\n.screenshot-dashboard .dh-left { gap:16px; }\n.screenshot-dashboard .dh-left h2 { margin:0; font-size:20px; line-height:1.15; color:var(--text); }\n.screenshot-dashboard .dh-left .sub { margin-top:8px; display:flex; align-items:center; flex-wrap:wrap; gap:8px; }\n.screenshot-dashboard .m-chip { padding:3px 9px; font-size:11px; border-radius:6px; }\n.screenshot-dashboard .period-tabs { padding:4px; border-radius:10px; display:flex; align-items:center; gap:2px; }\n.screenshot-dashboard .period-tabs .pt { min-width:58px; padding:7px 9px; font-size:12px; }\n.screenshot-dashboard .period-calendar { width:16px; height:16px; margin:0 8px 0 4px; color:var(--text-3); }\n\n.overview-strip {\n  display:grid;\n  grid-template-columns:1.28fr repeat(5,minmax(0,1fr));\n  min-height:168px;\n  margin-bottom:20px;\n  padding:22px 0;\n  background:var(--surface);\n  border:1px solid var(--line);\n  border-radius:var(--radius-panel);\n  box-shadow:var(--shadow-xs);\n}\n.overview-cell { min-width:0; padding:0 22px; display:flex; flex-direction:column; justify-content:center; }\n.overview-cell + .overview-cell { border-left:1px solid var(--line); }\n.overview-label,.overview-kpi-label { display:flex; align-items:center; gap:8px; color:var(--text-3); font-size:12px; font-weight:600; }\n.overview-score-line { display:flex; align-items:center; gap:10px; margin-top:12px; }\n.overview-score-line > strong { font-size:38px; line-height:1; letter-spacing:-.04em; }\n.overview-rating { margin-top:8px; color:var(--text-3); font-size:12px; }\n.overview-kpi-label { white-space:nowrap; }\n.overview-kpi > strong { margin-top:16px; color:var(--text); font-size:24px; line-height:1; letter-spacing:-.03em; font-variant-numeric:tabular-nums; }\n.overview-kpi > small { margin-top:10px; color:var(--text-3); font-size:11px; white-space:nowrap; }\n.kpi-icon { position:relative; display:inline-block; width:22px; height:22px; flex:0 0 22px; border-radius:50%; color:var(--accent); background:var(--accent-soft); }\n.kpi-icon::before { content:\"\"; position:absolute; inset:5px; background:currentColor; -webkit-mask:var(--icon) center/contain no-repeat; mask:var(--icon) center/contain no-repeat; }\n.overview-kpi:nth-child(3) .kpi-icon { color:var(--success); background:var(--success-soft); }\n.overview-kpi:nth-child(4) .kpi-icon { color:#7c3aed; background:#f3e8ff; }\n.overview-kpi:nth-child(5) .kpi-icon { color:#b7791f; background:#fff7dd; }\n\n.status-pill { display:inline-flex; align-items:center; min-height:20px; padding:2px 8px; border:1px solid currentColor; border-radius:999px; font-size:10px; font-weight:700; white-space:nowrap; }\n.status-pill.bad { color:var(--danger); background:var(--danger-soft); border-color:#f1b2a4; }\n.status-pill.warn { color:#b7791f; background:var(--warning-soft); border-color:#f0cb81; }\n.status-pill.ok { color:var(--success); background:var(--success-soft); border-color:#9dd8c4; }\n\n.risk-banner {\n  display:grid;\n  grid-template-columns:minmax(230px,1.15fr) repeat(4,minmax(116px,1fr)) auto;\n  align-items:stretch;\n  min-height:116px;\n  margin-bottom:22px;\n  padding:18px 16px;\n  background:linear-gradient(105deg,#fff5f2,#fffafa);\n  border:1px solid #f6c8be;\n  border-radius:var(--radius-panel);\n}\n.risk-banner-lead { display:flex; align-items:center; gap:14px; padding:0 18px 0 0; }\n.risk-banner-lead > .icon-svg { width:38px; height:38px; flex:0 0 38px; color:var(--danger); padding:8px; background:#fee4df; border-radius:10px; }\n.risk-banner-lead strong { display:block; color:var(--text); font-size:15px; }\n.risk-banner-lead small { display:block; margin-top:7px; color:var(--text-3); font-size:11px; }\n.risk-cell { min-width:0; display:flex; flex-direction:column; justify-content:center; gap:4px; padding:0 16px; border-left:1px solid #f3ded9; }\n.risk-cell > span:first-child { color:var(--text-3); font-size:11px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }\n.risk-cell > strong { color:var(--danger); font-size:20px; line-height:1; font-variant-numeric:tabular-nums; }\n.risk-value-line { display:flex; align-items:center; gap:8px; min-height:22px; }\n.risk-value-line .status-pill { margin-top:0; }\n.risk-cell .status-pill { align-self:flex-start; }\n.risk-cell > small { color:var(--text-3); font-size:10px; white-space:nowrap; }\n.empty-risk { color:var(--text-3); font-size:12px; }\n.outline-button { align-self:center; display:inline-flex; align-items:center; gap:10px; min-height:36px; margin-left:10px; padding:0 14px; color:var(--text-2); background:var(--surface); border:1px solid var(--line); border-radius:9px; font-size:12px; font-weight:650; white-space:nowrap; cursor:pointer; }\n.outline-button:hover { color:var(--accent); border-color:var(--accent); }\n.outline-button .icon-svg { width:14px; height:14px; }\n\n.dashboard-grid { display:grid; grid-template-columns:minmax(0,1.42fr) minmax(320px,1fr); align-items:start; gap:16px; }\n.dashboard-main-stack { display:grid; gap:16px; min-width:0; }\n.dashboard-card { background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-panel); box-shadow:var(--shadow-xs); }\n.dashboard-card-head { display:flex; align-items:center; justify-content:space-between; gap:12px; padding:18px 18px 0; }\n.dashboard-card-head h3 { margin:0; color:var(--text); font-size:15px; letter-spacing:-.01em; }\n.dashboard-card-head h3 em { color:var(--text-3); font-style:normal; font-size:12px; font-weight:500; }\n.card-period { display:inline-flex; align-items:center; gap:8px; padding:6px 9px; color:var(--text-2); background:var(--surface-soft); border:1px solid var(--line); border-radius:7px; font-size:11px; }\n.card-period .icon-svg { width:13px; height:13px; }\n.trend-card { min-height:430px; }\n.trend-chart-wrap { padding:8px 18px 16px; }\n#dashboardTrendCanvas { display:block; width:100%; height:340px; }\n.overview-stars { display:flex; align-items:center; gap:3px; margin-top:7px; }\n.overview-stars .icon-svg { width:17px; height:17px; color:#d99000; }\n.overview-stars .icon-svg.muted-star { color:#c4ccd8; opacity:.82; }\n.trend-axis-note { display:flex; justify-content:space-between; margin:4px 0 0; color:var(--text-3); font-size:10px; }\n.dashboard-side-stack { display:grid; gap:16px; }\n.risk-ranking-card { min-height:254px; }\n.rank-list { padding:10px 18px 16px; }\n.rank-row { display:grid; grid-template-columns:26px minmax(0,1fr) auto auto auto; align-items:center; gap:8px; min-height:40px; border-bottom:1px solid var(--line); }\n.rank-row:last-child { border-bottom:0; }\n.rank-number { display:grid; place-items:center; width:20px; height:20px; color:#fff; background:#7d8594; border-radius:50%; font-size:11px; font-weight:700; }\n.rank-number.bad { background:var(--danger); }\n.rank-number.warn { background:#d99625; }\n.rank-name { min-width:0; color:var(--text-2); font-size:12px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n.rank-row > strong { color:var(--text); font-size:13px; font-variant-numeric:tabular-nums; }\n.rank-row > small { color:var(--text-3); font-size:10px; white-space:nowrap; }\n.rank-row .status-pill { justify-self:end; }\n.text-button { padding:3px 0; color:var(--accent); background:transparent; border:0; font-size:11px; cursor:pointer; }\n.action-card { min-height:236px; }\n.action-list { padding:8px 18px 14px; }\n.action-row { display:grid; grid-template-columns:18px minmax(0,1fr) auto 14px; align-items:center; gap:9px; min-height:59px; border-bottom:1px solid var(--line); }\n.action-row:last-child { border-bottom:0; }\n.action-row > .icon-svg { width:17px; height:17px; color:var(--danger); }\n.action-row > .icon-clock { color:var(--success); }\n.action-row > div { min-width:0; }\n.action-row strong,.action-row small { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }\n.action-row strong { color:var(--text-2); font-size:12px; }\n.action-row small { margin-top:4px; color:var(--text-3); font-size:10px; }\n.action-row > b { color:var(--danger); font-size:16px; font-variant-numeric:tabular-nums; }\n.action-row > .icon-arrow-right { color:var(--text-3); }\n.empty-card { padding:28px 0; color:var(--text-3); text-align:center; font-size:12px; }\n.recommendation-card { display:flex; align-items:flex-start; gap:12px; margin-top:16px; padding:17px 18px; background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-panel); box-shadow:var(--shadow-xs); }\n.recommendation-card > .icon-svg { width:26px; height:26px; color:#d99625; padding:5px; background:#fff7dd; border-radius:8px; flex:0 0 26px; }\n.recommendation-card strong { display:block; color:var(--text); font-size:12px; }\n.recommendation-card p { margin:5px 0 0; color:var(--text-3); font-size:11px; line-height:1.6; }\n.recommendation-summary { margin-left:auto; color:var(--text-3); font-size:10px; white-space:nowrap; }\n.dashboard-details { margin-top:28px; }\n.dashboard-detail-group { margin-bottom:26px; }\n.detail-group-title { display:flex; align-items:center; gap:9px; margin-bottom:11px; }\n.detail-group-title > span { padding:3px 7px; color:var(--accent); background:var(--accent-soft); border-radius:5px; font-size:9px; letter-spacing:.08em; text-transform:uppercase; }\n.detail-group-title h3 { margin:0; color:var(--text); font-size:14px; }\n.detail-metric-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; }\n.detail-metric-card { min-height:152px; padding:16px; background:var(--surface); border:1px solid var(--line); border-radius:var(--radius-card); box-shadow:var(--shadow-xs); }\n.detail-metric-card.bad { border-top:3px solid var(--danger); }\n.detail-metric-card.warn { border-top:3px solid var(--warning); }\n.detail-metric-card.ok { border-top:3px solid var(--success); }\n.detail-metric-head { display:flex; align-items:center; justify-content:space-between; gap:8px; }\n.detail-metric-head strong { color:var(--text-2); font-size:12px; }\n.detail-metric-value { margin-top:10px; color:var(--text); font-size:23px; font-weight:700; font-variant-numeric:tabular-nums; }\n.detail-metric-desc { min-height:18px; margin-top:5px; color:var(--text-3); font-size:10px; }\n.detail-bar { height:5px; margin-top:11px; overflow:hidden; background:var(--surface-strong); border-radius:99px; }\n.detail-bar > i { display:block; height:100%; border-radius:99px; }\n.detail-target { display:flex; justify-content:space-between; margin-top:7px; color:var(--text-3); font-size:10px; }\n.metric-spark { display:flex; align-items:flex-end; gap:4px; height:25px; margin-top:9px; }\n.metric-spark i { flex:1; min-height:3px; background:var(--accent); border-radius:3px 3px 0 0; opacity:.72; }\n\n@media (max-width:1180px) {\n  .overview-strip { grid-template-columns:repeat(3,minmax(0,1fr)); padding:0; }\n  .overview-cell { min-height:112px; padding:18px; }\n  .overview-cell:nth-child(4) { border-left:0; }\n  .overview-cell:nth-child(n+4) { border-top:1px solid var(--line); }\n  .risk-banner { grid-template-columns:1.2fr repeat(2,minmax(120px,1fr)); }\n  .risk-banner .risk-cell:nth-of-type(n+4) { display:none; }\n  .risk-banner .outline-button { grid-column:3; grid-row:1; }\n  .dashboard-grid { grid-template-columns:1fr; }\n  .dashboard-side-stack { grid-template-columns:1fr 1fr; }\n}\n@media (max-width:760px) {\n  .topbar .logo,.col-nav { width:76px; }\n  .overview-strip { grid-template-columns:1fr 1fr; }\n  .overview-cell:nth-child(3) { border-left:0; }\n  .overview-cell:nth-child(n+3) { border-top:1px solid var(--line); }\n  .risk-banner { grid-template-columns:1fr; gap:12px; }\n  .risk-banner-lead { padding-right:0; }\n  .risk-cell { border-left:0; border-top:1px solid #f3ded9; padding:10px 0 0; }\n  .risk-banner .risk-cell:nth-of-type(n+3) { display:none; }\n  .risk-banner .outline-button { grid-column:auto; grid-row:auto; margin-left:0; justify-self:start; }\n  .dashboard-side-stack,.detail-metric-grid { grid-template-columns:1fr; }\n  .recommendation-summary { display:none; }\n}\n\n/* v22 comprehensive dashboard + inbox refinement */\n.screenshot-dashboard {\n  font-size:14px;\n  color:var(--text);\n}\n.screenshot-dashboard .status-pill {\n  min-height:22px;\n  padding:2px 9px;\n  font-size:11px;\n}\n.screenshot-dashboard .overview-label,\n.screenshot-dashboard .overview-kpi-label,\n.screenshot-dashboard .overview-rating,\n.screenshot-dashboard .overview-kpi > small,\n.screenshot-dashboard .risk-banner-lead small,\n.screenshot-dashboard .risk-cell > span:first-child,\n.screenshot-dashboard .risk-cell > small,\n.screenshot-dashboard .rank-name,\n.screenshot-dashboard .rank-row > small,\n.screenshot-dashboard .action-row strong,\n.screenshot-dashboard .action-row small,\n.screenshot-dashboard .trend-axis-note,\n.screenshot-dashboard .recommendation-card p,\n.screenshot-dashboard .recommendation-summary {\n  font-size:12px;\n}\n.screenshot-dashboard .period-tabs .pt { font-size:13px; }\n.screenshot-dashboard .dashboard-details {\n  display:grid;\n  gap:20px;\n  margin-top:34px;\n}\n.dashboard-details-intro {\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap:20px;\n  padding:4px 4px 0;\n}\n.dashboard-details-intro > div:first-child > span {\n  color:var(--accent);\n  font-size:12px;\n  font-weight:750;\n  letter-spacing:.12em;\n}\n.dashboard-details-intro h3 {\n  margin:6px 0 4px;\n  color:var(--text);\n  font-size:22px;\n  line-height:1.2;\n  letter-spacing:-.025em;\n}\n.dashboard-details-intro p {\n  margin:0;\n  color:var(--text-3);\n  font-size:13px;\n  line-height:1.5;\n}\n.details-intro-count {\n  display:flex;\n  align-items:baseline;\n  gap:7px;\n  padding:10px 14px;\n  color:var(--accent);\n  background:var(--accent-soft);\n  border:1px solid color-mix(in srgb, var(--accent) 16%, var(--line));\n  border-radius:11px;\n}\n.details-intro-count strong { font-size:22px; line-height:1; }\n.details-intro-count span { font-size:12px; color:var(--text-2); }\n.metric-section {\n  --tone:var(--accent);\n  --tone-soft:var(--accent-soft);\n  position:relative;\n  overflow:hidden;\n  padding:22px 24px 24px;\n  background:var(--surface);\n  border:1px solid var(--line);\n  border-radius:20px;\n  box-shadow:var(--shadow-sm);\n}\n.metric-section::before {\n  content:\"\";\n  position:absolute;\n  inset:0 auto 0 0;\n  width:4px;\n  background:var(--tone);\n}\n.metric-section.tone-violet { --tone:#7157d9; --tone-soft:#f1efff; }\n.metric-section.tone-blue { --tone:#3478e5; --tone-soft:#edf4ff; }\n.metric-section.tone-orange { --tone:#d97836; --tone-soft:#fff3e8; }\n.metric-section.tone-green { --tone:#159d7a; --tone-soft:#e9f8f2; }\n.metric-section.tone-indigo { --tone:#5664d9; --tone-soft:#eef0ff; }\n.metric-section-header {\n  display:flex;\n  align-items:flex-start;\n  justify-content:space-between;\n  gap:20px;\n  margin-bottom:20px;\n}\n.metric-section-heading {\n  display:flex;\n  align-items:flex-start;\n  gap:13px;\n  min-width:0;\n}\n.metric-section-index {\n  display:grid;\n  place-items:center;\n  width:36px;\n  height:36px;\n  flex:0 0 36px;\n  color:var(--tone);\n  background:var(--tone-soft);\n  border:1px solid color-mix(in srgb, var(--tone) 16%, transparent);\n  border-radius:11px;\n  font-size:13px;\n  font-weight:750;\n  font-variant-numeric:tabular-nums;\n}\n.metric-section-layer {\n  color:var(--tone);\n  font-size:12px;\n  font-weight:750;\n  letter-spacing:.12em;\n  line-height:1.2;\n}\n.metric-section-header h3 {\n  margin:5px 0 4px;\n  color:var(--text);\n  font-size:20px;\n  line-height:1.2;\n  letter-spacing:-.025em;\n}\n.metric-section-header p {\n  margin:0;\n  color:var(--text-3);\n  font-size:13px;\n  line-height:1.5;\n}\n.metric-section-summary {\n  display:grid;\n  justify-items:end;\n  gap:5px;\n  min-width:190px;\n  padding-top:3px;\n  text-align:right;\n}\n.metric-section-summary strong {\n  color:var(--text);\n  font-size:14px;\n  font-weight:750;\n}\n.metric-section-summary span {\n  color:var(--text-3);\n  font-size:12px;\n  line-height:1.35;\n  white-space:nowrap;\n}\n.metric-section-body {\n  display:grid;\n  grid-template-columns:minmax(260px,.76fr) minmax(0,1.24fr);\n  gap:14px;\n  align-items:stretch;\n}\n.metric-section-body.single {\n  grid-template-columns:1fr;\n}\n.metric-section-body.single .metric-spotlight {\n  display:grid;\n  grid-template-columns:minmax(0,1fr) minmax(220px,.72fr);\n  grid-template-rows:auto auto auto 1fr;\n  column-gap:36px;\n  align-items:center;\n  min-height:190px;\n}\n.metric-section-body.single .spotlight-top { grid-column:1; grid-row:1; }\n.metric-section-body.single .metric-spotlight h4 { grid-column:1; grid-row:2; margin-top:16px; }\n.metric-section-body.single .spotlight-value { grid-column:1; grid-row:3; }\n.metric-section-body.single .metric-spotlight p { grid-column:1; grid-row:4; min-height:0; }\n.metric-section-body.single .spotlight-meta { grid-column:2; grid-row:1; margin-top:0; }\n.metric-section-body.single .spotlight-progress { grid-column:2; grid-row:2 / span 2; width:100%; margin-top:0; }\n.metric-section-body.single .spotlight-foot { grid-column:2; grid-row:4; width:100%; margin-top:0; }\n.metric-spotlight {\n  display:flex;\n  flex-direction:column;\n  min-height:242px;\n  padding:20px;\n  background:var(--tone-soft);\n  border:1px solid color-mix(in srgb, var(--tone) 17%, var(--line));\n  border-radius:16px;\n}\n.metric-spotlight.bad { background:color-mix(in srgb, var(--danger-soft) 78%, var(--tone-soft)); }\n.metric-spotlight.warn { background:color-mix(in srgb, var(--warning-soft) 78%, var(--tone-soft)); }\n.spotlight-top {\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap:8px;\n}\n.spotlight-kicker {\n  color:var(--tone);\n  font-size:12px;\n  font-weight:750;\n  letter-spacing:.08em;\n}\n.metric-spotlight h4 {\n  margin:22px 0 0;\n  color:var(--text);\n  font-size:15px;\n  line-height:1.35;\n}\n.spotlight-value {\n  margin-top:8px;\n  color:var(--text);\n  font-size:34px;\n  font-weight:780;\n  letter-spacing:-.045em;\n  line-height:1;\n  font-variant-numeric:tabular-nums;\n}\n.metric-spotlight p {\n  min-height:36px;\n  margin:9px 0 0;\n  color:var(--text-2);\n  font-size:13px;\n  line-height:1.5;\n}\n.spotlight-meta {\n  display:flex;\n  justify-content:space-between;\n  gap:10px;\n  margin-top:auto;\n  color:var(--text-3);\n  font-size:12px;\n}\n.spotlight-progress {\n  height:7px;\n  margin-top:9px;\n  overflow:hidden;\n  background:rgba(16,24,40,.08);\n  border-radius:99px;\n}\n.spotlight-progress span,\n.metric-row-progress span {\n  display:block;\n  height:100%;\n  border-radius:inherit;\n}\n.spotlight-foot {\n  display:flex;\n  align-items:flex-end;\n  justify-content:space-between;\n  gap:12px;\n  margin-top:13px;\n  color:var(--text-3);\n  font-size:12px;\n}\n.metric-mini-chart {\n  display:flex;\n  align-items:flex-end;\n  justify-content:flex-end;\n  gap:4px;\n  width:94px;\n  height:28px;\n}\n.metric-mini-chart span {\n  display:block;\n  width:10px;\n  min-height:4px;\n  background:var(--tone);\n  border-radius:3px 3px 1px 1px;\n  opacity:.72;\n}\n.metric-mini-chart.empty span { height:4px!important; opacity:.24; }\n.metric-support-grid {\n  display:grid;\n  grid-template-columns:repeat(2,minmax(0,1fr));\n  gap:12px;\n  align-content:start;\n}\n.metric-row-card {\n  display:grid;\n  grid-template-columns:32px minmax(0,1fr) auto;\n  gap:11px;\n  min-height:132px;\n  padding:15px;\n  background:var(--surface-soft);\n  border:1px solid var(--line);\n  border-radius:14px;\n  transition:border-color .16s ease, box-shadow .16s ease, transform .16s ease;\n}\n.metric-row-card:hover {\n  border-color:color-mix(in srgb, var(--tone) 34%, var(--line));\n  box-shadow:var(--shadow-xs);\n  transform:translateY(-1px);\n}\n.metric-row-card.bad { border-color:color-mix(in srgb, var(--danger) 28%, var(--line)); }\n.metric-row-card.warn { border-color:color-mix(in srgb, var(--warning) 30%, var(--line)); }\n.metric-row-icon {\n  display:grid;\n  place-items:center;\n  width:30px;\n  height:30px;\n  color:var(--tone);\n  background:var(--tone-soft);\n  border-radius:9px;\n}\n.metric-row-icon .icon-svg { width:16px; height:16px; }\n.metric-row-content { min-width:0; }\n.metric-row-top {\n  display:flex;\n  align-items:center;\n  justify-content:space-between;\n  gap:8px;\n}\n.metric-row-top strong {\n  min-width:0;\n  overflow:hidden;\n  color:var(--text);\n  font-size:13px;\n  font-weight:700;\n  text-overflow:ellipsis;\n  white-space:nowrap;\n}\n.metric-row-top .status-pill { flex:0 0 auto; }\n.metric-row-content p {\n  min-height:34px;\n  margin:6px 0 9px;\n  overflow:hidden;\n  color:var(--text-3);\n  font-size:12px;\n  line-height:1.5;\n}\n.metric-row-bottom {\n  display:flex;\n  align-items:baseline;\n  justify-content:space-between;\n  gap:8px;\n  color:var(--text-3);\n  font-size:12px;\n}\n.metric-row-bottom b {\n  color:var(--text);\n  font-size:18px;\n  font-weight:760;\n  font-variant-numeric:tabular-nums;\n}\n.metric-row-progress {\n  height:5px;\n  margin-top:8px;\n  overflow:hidden;\n  background:var(--surface-strong);\n  border-radius:99px;\n}\n.metric-row-card > .metric-mini-chart {\n  align-self:end;\n  width:45px;\n  height:22px;\n  gap:3px;\n}\n.metric-row-card > .metric-mini-chart span { width:5px; }\n.metric-empty-support {\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  min-height:132px;\n  color:var(--text-3);\n  background:var(--surface-soft);\n  border:1px dashed var(--line-strong);\n  border-radius:14px;\n  font-size:12px;\n}\n\n.inbox-v20 {\n  font-size:14px;\n}\n.inbox-v20 .col-list {\n  width:410px;\n}\n.inbox-v20 .inbox-commandbar {\n  min-height:62px;\n  padding:0 16px;\n  gap:6px;\n}\n.inbox-v20 .filter-tab {\n  padding:8px 11px;\n  border-radius:9px;\n  font-size:13px;\n}\n.inbox-v20 .inbox-shop-tag,\n.inbox-v20 .all-count { font-size:12px!important; }\n.inbox-v20 .mail-item {\n  margin:6px 12px;\n  padding:15px 16px 15px 22px;\n  border:1px solid transparent;\n  border-radius:14px;\n  box-shadow:none;\n}\n.inbox-v20 .mail-item:hover {\n  background:var(--surface-soft);\n  border-color:var(--line-strong);\n}\n.inbox-v20 .mail-item.unread {\n  background:var(--accent-soft);\n  border-color:rgba(37,99,235,.18);\n}\n.inbox-v20 .mail-item.active {\n  background:#e7efff;\n  border-color:rgba(37,99,235,.34);\n  box-shadow:inset 3px 0 0 var(--accent);\n}\n.inbox-v20 .mail-item.unread::after {\n  left:9px;\n  top:28px;\n  width:7px;\n  height:7px;\n  background:var(--accent);\n  box-shadow:0 0 0 3px rgba(37,99,235,.12);\n}\n.inbox-v20 .mail-item .from {\n  font-size:14px;\n  font-weight:700;\n  line-height:1.35;\n}\n.inbox-v20 .mail-item .time { font-size:12px; }\n.inbox-v20 .mail-item .subj {\n  margin-top:7px;\n  color:var(--text-2);\n  font-size:13px;\n  line-height:1.5;\n}\n.inbox-v20 .mail-item .meta {\n  margin-top:8px;\n  gap:12px;\n  color:var(--text-3);\n  font-size:12px;\n}\n.inbox-v20 .mail-item .meta .tag-shop {\n  padding:2px 8px;\n  border-radius:7px;\n}\n.inbox-v20 .order-group {\n  margin:6px 12px;\n  overflow:hidden;\n  border:1px solid var(--line);\n  border-radius:14px;\n}\n.inbox-v20 .order-head {\n  min-height:48px;\n  padding:11px 14px;\n  background:var(--surface-soft);\n  border:0;\n}\n.inbox-v20 .order-head .oid,\n.inbox-v20 .order-head .gmeta,\n.inbox-v20 .order-head .time { font-size:12px; }\n.inbox-v20 .group-body { padding:4px 0; background:var(--surface); }\n.inbox-v20 .group-body .mail-item { margin:4px 8px; }\n.inbox-v20 .thread-head {\n  padding:22px 28px;\n}\n.inbox-v20 .thread-head .t-title {\n  font-size:20px;\n  line-height:1.35;\n}\n.inbox-v20 .thread-head .t-meta { font-size:13px; }\n.inbox-v20 .msgs { padding:28px; }\n.inbox-v20 .msg {\n  max-width:84%;\n  margin-bottom:20px;\n}\n.inbox-v20 .msg .avatar {\n  width:42px;\n  height:42px;\n  font-size:16px;\n}\n.inbox-v20 .msg .msg-body {\n  border-radius:16px;\n  padding:17px 20px;\n  box-shadow:var(--shadow-xs);\n}\n.inbox-v20 .msg-body .mname { font-size:14px; }\n.inbox-v20 .msg-body .mtime { font-size:12px; }\n.inbox-v20 .msg-body .mtext {\n  font-size:15px;\n  line-height:1.7;\n}\n.inbox-v20 .reply-box {\n  padding:16px 24px 20px;\n}\n.inbox-v20 .reply-tools { min-height:38px; }\n.inbox-v20 .reply-box textarea {\n  min-height:118px;\n  padding:14px 16px;\n  border-radius:12px;\n  font-size:14px;\n  line-height:1.65;\n}\n.inbox-v20 .reply-row { margin-top:12px; }\n.inbox-v20 .reply-row .btn { min-height:38px; font-size:13px; }\n\n@media (max-width:1180px) {\n  .metric-section-body { grid-template-columns:1fr; }\n  .metric-spotlight { min-height:220px; }\n}\n@media (max-width:760px) {\n  .metric-section { padding:18px 16px 18px; }\n  .dashboard-details-intro { display:block; }\n  .details-intro-count { width:max-content; margin-top:14px; }\n  .metric-section-header { display:block; }\n  .metric-section-summary { justify-items:start; margin:15px 0 0 49px; text-align:left; }\n  .metric-section-summary span { white-space:normal; }\n  .metric-section-body.single .metric-spotlight { display:flex; min-height:190px; }\n  .metric-support-grid { grid-template-columns:1fr; }\n  .inbox-v20 .col-list { width:100%; min-width:280px; }\n  .inbox-v20 .col-read { display:none; }\n}\n\n/* ========================================================================\n   Aurora Ops v23 — a quieter, denser commerce-operations workspace.\n   The visual language borrows the restraint of Linear, the merchant-first\n   grouping of Shopify Polaris, and Material 3's tonal surfaces. It is\n   intentionally layered after the v20/v22 rules so the data and interaction\n   contracts remain untouched while every surface receives a new treatment.\n   ======================================================================== */\nbody[data-ui-version=\"23\"] {\n  --nav-bg:#11172d;\n  --nav-bg-2:#242b61;\n  --nav-text:#cbd4ee;\n  --nav-muted:#8390b4;\n  --canvas:#f4f6fa;\n  --surface:#ffffff;\n  --surface-soft:#f8f9fc;\n  --surface-strong:#edf0f7;\n  --line:#e6e9f1;\n  --line-strong:#d2d8e6;\n  --text:#171c2d;\n  --text-2:#56627b;\n  --text-3:#8490a6;\n  --accent:#5d5eea;\n  --accent-hover:#4d4fd5;\n  --accent-soft:#f0f1ff;\n  --success:#18a57c;\n  --success-soft:#e8f8f1;\n  --warning:#d89536;\n  --warning-soft:#fff5df;\n  --danger:#e36462;\n  --danger-soft:#fff0ed;\n  --focus:rgba(93,94,234,.28);\n  --shadow-xs:0 2px 8px rgba(25,35,66,.05);\n  --shadow-sm:0 16px 40px rgba(30,40,78,.08);\n  --shadow-lg:0 28px 72px rgba(30,40,78,.16);\n  --radius-control:12px;\n  --radius-card:18px;\n  --radius-panel:24px;\n  --accent-grad:linear-gradient(135deg,#6567f4 0%,#4d91ff 100%);\n  --blue:var(--accent);\n  --green:var(--success);\n  --red:var(--danger);\n  --amber:var(--warning);\n  --purple:#8b79ff;\n  --card:var(--surface);\n  --card2:var(--surface-strong);\n  --bg:var(--canvas);\n  --bg2:var(--surface-soft);\n  --border:var(--line);\n  --muted:var(--text-3);\n  --hover:#f0f2f9;\n  --border-soft:rgba(24,31,54,.06);\n  --border-light:rgba(24,31,54,.12);\n  --group-fill:#f5f8ff;\n  --group-border:#d7def5;\n  /* ---- v26.82：发货超时「仓库类型」标签（浅色）----\n     海外仓 紫 / 国内仓 青绿 / 未识别 灰 / ERP 无单 琥珀 / 未查询 灰虚线。\n     标签与表格文字都是 10.5~11.5px 小字 ⇒ 前景色一律压到 ≥4.5:1（WCAG 2.1 AA 正文档），\n     与 v26.81 按钮配色同一条硬约束。 */\n  --so-wh-overseas:#5b21b6;\n  --so-wh-overseas-soft:#efe4fe;\n  --so-wh-overseas-line:#d3bff5;\n  --so-wh-domestic:#0f766e;\n  --so-wh-domestic-soft:#dcf3ee;\n  --so-wh-domestic-line:#a9dbd0;\n  --so-wh-unknown:#565b66;\n  --so-wh-unknown-soft:#eceef2;\n  --so-wh-unknown-line:#d6d9e0;\n  --so-wh-missing:#9c5200;\n  --so-wh-missing-soft:#fbedd0;\n  --so-wh-missing-line:#e6c98c;\n  /* ---- v26.81：对话头 5 个操作按钮的语义色（浅色）----\n     ① 标记未读 琥珀 ② 关闭事件 红 ③ 订单详情 紫 ④ 申请退货标签 青绿 ⑤ 快捷退款 靛蓝。\n     前景/填充都压到「文字对比 ≥4.5:1」，5 个按钮在同一行里彼此可辨、又不互相打架。 */\n  --act-unread:#9c5200;\n  --act-unread-soft:#fbedd0;\n  --act-unread-line:#e6c98c;\n  --act-unread-glow:rgba(156,82,0,.22);\n  --act-close-grad:linear-gradient(135deg,#d93b3b,#b91c1c);\n  --act-close-grad-hover:linear-gradient(135deg,#c93232,#a31818);\n  --act-close-glow:rgba(185,28,28,.20);\n  --act-close-glow-hover:rgba(185,28,28,.28);\n  --act-detail:#5b21b6;\n  --act-detail-soft:#efe4fe;\n  --act-detail-line:#d3bff5;\n  --act-detail-glow:rgba(91,33,182,.22);\n  --act-return:#0f766e;\n  --act-return-soft:#dcf3ee;\n  --act-return-line:#a9dbd0;\n  --act-return-glow:rgba(15,118,110,.22);\n  --act-refund-grad:linear-gradient(135deg,#5b5bf0,#4a5fe8);\n  --act-refund-grad-hover:linear-gradient(135deg,#4f4fe4,#3f55dc);\n  --act-refund-glow:rgba(75,95,232,.22);\n  --act-refund-glow-hover:rgba(75,95,232,.30);\n  --group-head:#eef2ff;\n}\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] {\n  --canvas:#0c1020;\n  --surface:#151a2f;\n  --surface-soft:#11162a;\n  --surface-strong:#202640;\n  --line:#2a3350;\n  --line-strong:#3a4668;\n  --text:#f4f6ff;\n  --text-2:#b8c1d8;\n  --text-3:#8d99b7;\n  --accent:#8588ff;\n  --accent-hover:#9b9eff;\n  --accent-soft:rgba(133,136,255,.15);\n  --success:#4ad0a4;\n  --success-soft:rgba(74,208,164,.13);\n  --warning:#f0be63;\n  --warning-soft:rgba(240,190,99,.14);\n  --danger:#ff8a82;\n  --danger-soft:rgba(255,138,130,.14);\n  --focus:rgba(133,136,255,.42);\n  --shadow-xs:0 2px 8px rgba(0,0,0,.18);\n  --shadow-sm:0 18px 42px rgba(0,0,0,.25);\n  --shadow-lg:0 32px 80px rgba(0,0,0,.42);\n  --hover:#202944;\n  --group-fill:rgba(133,136,255,.08);\n  --group-border:rgba(133,136,255,.25);\n  /* v26.81：同 5 个按钮的深色取值。色调底的按钮**不做「亮色填充 + 白字」的 hover**\n     （#f0be63 上写白字只有 1.6:1），改为「底色加深 + 边框实色 + 文字保持亮色」。 */\n  --act-unread:#f0be63;\n  --act-unread-soft:rgba(240,190,99,.17);\n  --act-unread-line:rgba(240,190,99,.36);\n  --act-unread-glow:rgba(240,190,99,.22);\n  --act-unread-deep:rgba(240,190,99,.26);\n  --act-close-grad:linear-gradient(135deg,#d04048,#b32b34);\n  --act-close-grad-hover:linear-gradient(135deg,#c3333b,#a02028);\n  --act-close-glow:rgba(208,64,72,.24);\n  --act-close-glow-hover:rgba(208,64,72,.32);\n  --act-detail:#bda4ff;\n  --act-detail-soft:rgba(160,120,255,.18);\n  --act-detail-line:rgba(160,120,255,.38);\n  --act-detail-glow:rgba(160,120,255,.26);\n  --act-detail-deep:rgba(160,120,255,.26);\n  --act-return:#4fd6c0;\n  --act-return-soft:rgba(79,214,192,.16);\n  --act-return-line:rgba(79,214,192,.36);\n  --act-return-glow:rgba(79,214,192,.24);\n  --act-return-deep:rgba(79,214,192,.24);\n  --act-refund-grad:linear-gradient(135deg,#6062f2,#4f6ae8);\n  --act-refund-grad-hover:linear-gradient(135deg,#5457e8,#425fdd);\n  --act-refund-glow:rgba(96,98,242,.26);\n  --act-refund-glow-hover:rgba(96,98,242,.34);\n  /* ---- v26.82：发货超时「仓库类型」标签（深色）----\n     深色下标签底是半透明主色，文字必须**保持亮色**（照抄浅色那套深字会掉到 1.x:1）。\n     与 v26.81 的按钮配色同一条规则。 */\n  --so-wh-overseas:#bda4ff;\n  --so-wh-overseas-soft:rgba(160,120,255,.18);\n  --so-wh-overseas-line:rgba(160,120,255,.38);\n  --so-wh-domestic:#4fd6c0;\n  --so-wh-domestic-soft:rgba(79,214,192,.16);\n  --so-wh-domestic-line:rgba(79,214,192,.36);\n  --so-wh-unknown:#c3c9d4;\n  --so-wh-unknown-soft:rgba(180,190,205,.16);\n  --so-wh-unknown-line:rgba(180,190,205,.34);\n  --so-wh-missing:#f0be63;\n  --so-wh-missing-soft:rgba(240,190,99,.17);\n  --so-wh-missing-line:rgba(240,190,99,.36);\n  --group-head:rgba(133,136,255,.12);\n}\n\nbody[data-ui-version=\"23\"],\nbody[data-ui-version=\"23\"] button,\nbody[data-ui-version=\"23\"] input,\nbody[data-ui-version=\"23\"] select,\nbody[data-ui-version=\"23\"] textarea {\n  font-family:\"Segoe UI Variable\",\"Segoe UI\",\"Microsoft YaHei UI\",\"Microsoft YaHei\",sans-serif;\n}\nbody[data-ui-version=\"23\"] { font-size:14px; line-height:1.48; letter-spacing:.002em; }\nbody[data-ui-version=\"23\"] .status,\nbody[data-ui-version=\"23\"] .panel-title,\nbody[data-ui-version=\"23\"] .all-count,\nbody[data-ui-version=\"23\"] .hint { font-size:12px; }\nbody[data-ui-version=\"23\"] .page { background:transparent; }\n\n/* Shell */\nbody[data-ui-version=\"23\"] .topbar {\n  height:72px;\n  padding:0 24px 0 0;\n  gap:14px;\n  background:rgba(255,255,255,.9);\n  border-color:var(--line);\n  box-shadow:0 1px 0 rgba(30,40,78,.04),0 8px 20px rgba(30,40,78,.035);\n  backdrop-filter:blur(16px);\n}\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .topbar { background:rgba(21,26,47,.92); }\nbody[data-ui-version=\"23\"] .topbar .logo {\n  width:228px;\n  height:72px;\n  padding:0 22px;\n  gap:12px;\n  background:linear-gradient(145deg,#12182f,#252c5d);\n}\nbody[data-ui-version=\"23\"] .topbar .logo-mark {\n  width:38px;\n  height:38px;\n  border-radius:12px;\n  background:var(--accent-grad);\n  box-shadow:0 8px 20px rgba(93,94,234,.32);\n  font-size:17px;\n}\nbody[data-ui-version=\"23\"] .topbar h1 { font-size:16px; letter-spacing:.01em; }\nbody[data-ui-version=\"23\"] .topbar .hint { display:none; }\nbody[data-ui-version=\"23\"] .topbar > div:last-of-type { gap:8px!important; }\nbody[data-ui-version=\"23\"] .topbar label { font-size:12px!important; color:var(--text-3)!important; }\nbody[data-ui-version=\"23\"] .topbar .btn {\n  min-height:40px;\n  padding:0 14px;\n  border-radius:12px;\n  font-size:13px;\n  font-weight:650;\n}\nbody[data-ui-version=\"23\"] .topbar .btn.primary { background:var(--success); border-color:var(--success); box-shadow:0 8px 20px rgba(24,165,124,.18); }\nbody[data-ui-version=\"23\"] .topbar .btn.primary:hover { background:#118d6a; border-color:#118d6a; }\nbody[data-ui-version=\"23\"] .topbar .status { color:var(--success); font-weight:650; }\nbody[data-ui-version=\"23\"] .col-nav {\n  width:228px;\n  padding:22px 14px;\n  gap:7px;\n  background:linear-gradient(180deg,#12182f 0%,#151c3b 60%,#242c67 130%);\n  border-right:0;\n  box-shadow:inset -1px 0 rgba(255,255,255,.05);\n}\nbody[data-ui-version=\"23\"] .nav-item {\n  min-height:48px;\n  padding:0 16px;\n  gap:13px;\n  border-radius:14px;\n  color:var(--nav-text);\n  font-size:14px;\n  font-weight:560;\n}\nbody[data-ui-version=\"23\"] .nav-item:hover { color:#fff; background:rgba(255,255,255,.08); }\nbody[data-ui-version=\"23\"] .nav-item.active {\n  color:#fff;\n  background:linear-gradient(100deg,rgba(103,106,246,.92),rgba(76,139,255,.72));\n  box-shadow:0 10px 24px rgba(65,81,214,.28),inset 0 0 0 1px rgba(255,255,255,.12);\n}\nbody[data-ui-version=\"23\"] .nav-item .ni { width:20px; height:20px; color:currentColor; }\nbody[data-ui-version=\"23\"] .btn {\n  min-height:40px;\n  padding:0 15px;\n  border-radius:12px;\n  background:var(--surface);\n  border-color:var(--line);\n  color:var(--text-2);\n  box-shadow:var(--shadow-xs);\n  font-size:13px;\n  font-weight:630;\n}\nbody[data-ui-version=\"23\"] .btn:hover { background:var(--surface-soft); border-color:var(--line-strong); color:var(--text); box-shadow:0 6px 18px rgba(30,40,78,.08); transform:translateY(-1px); }\nbody[data-ui-version=\"23\"] .btn.primary { background:var(--accent-grad); border-color:transparent; color:#fff; box-shadow:0 10px 22px rgba(93,94,234,.2); }\n/* Filled action buttons keep a readable foreground even when their background\n   is supplied by an inline workflow color (send/save/add actions). */\nbody[data-ui-version=\"23\"] .btn.btn-filled,\nbody[data-ui-version=\"23\"] .btn.btn-filled:hover { color:#fff; }\nbody[data-ui-version=\"23\"] .btn.btn-filled.manual-refund-submit {\n  background:var(--accent-grad);\n  border-color:transparent;\n  color:#fff;\n  box-shadow:0 8px 18px rgba(76,96,224,.18);\n}\nbody[data-ui-version=\"23\"] .btn.btn-filled.manual-refund-submit:hover {\n  background:linear-gradient(135deg,#4f5fe4,#376be8);\n  border-color:transparent;\n  color:#fff;\n}\nbody[data-ui-version=\"23\"] .btn.btn-filled.manual-refund-submit:disabled {\n  background:var(--surface-strong);\n  border-color:var(--line-strong);\n  color:var(--text-2);\n  opacity:1;\n  box-shadow:none;\n}\n\n/* Dashboard — bento hierarchy and clearer rhythm */\nbody[data-ui-version=\"23\"] .dashboard-v20 .dash {\n  max-width:1480px;\n  padding:34px 40px 72px;\n}\nbody[data-ui-version=\"23\"] .dashboard-v20 .dash-head { margin-bottom:26px; gap:20px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .dh-left { gap:16px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .shop-badge { width:58px; height:58px; border-radius:18px; background:var(--accent-grad); box-shadow:0 12px 26px rgba(93,94,234,.22); font-size:24px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .dh-left h2 { font-size:24px; letter-spacing:-.025em; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .dh-left .sub { margin-top:7px; gap:8px; font-size:12px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .dh-left .sub .m-chip { padding:3px 9px; border-radius:7px; background:var(--surface); border-color:var(--line); }\nbody[data-ui-version=\"23\"] .dashboard-v20 .period-tabs { gap:3px; padding:4px; border:1px solid var(--line); border-radius:14px; background:var(--surface); box-shadow:var(--shadow-xs); }\nbody[data-ui-version=\"23\"] .dashboard-v20 .period-tabs .pt { padding:8px 13px; border-radius:10px; font-size:13px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .period-tabs .pt.active { color:#fff; background:var(--accent-grad); box-shadow:0 6px 14px rgba(93,94,234,.2); }\nbody[data-ui-version=\"23\"] .dashboard-v20 .overview-strip {\n  display:grid;\n  grid-template-columns:minmax(230px,1.18fr) repeat(5,minmax(132px,1fr));\n  gap:12px;\n  margin-bottom:18px;\n  padding:0;\n  border:0;\n  background:transparent;\n}\nbody[data-ui-version=\"23\"] .dashboard-v20 .overview-cell {\n  min-height:166px;\n  padding:20px 20px 18px;\n  background:var(--surface);\n  border:1px solid var(--line);\n  border-radius:20px;\n  box-shadow:var(--shadow-xs);\n}\nbody[data-ui-version=\"23\"] .dashboard-v20 .overview-score {\n  color:#fff;\n  border-color:transparent;\n  background:radial-gradient(130% 120% at 0 0,#303b85 0%,#222956 45%,#191e40 100%);\n  box-shadow:0 16px 30px rgba(31,39,92,.22);\n}\nbody[data-ui-version=\"23\"] .dashboard-v20 .overview-label { font-size:12px; color:rgba(255,255,255,.7); font-weight:650; letter-spacing:.04em; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .overview-score-line { margin-top:13px; gap:10px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .overview-score-line strong { color:#fff!important; font-size:44px; letter-spacing:-.06em; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .overview-rating { color:rgba(255,255,255,.65); font-size:12px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .overview-stars { margin-top:9px; color:#ffc56b; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .overview-score .status-pill.bad { color:#ffd9d2; background:rgba(255,122,108,.18); border-color:rgba(255,165,152,.45); }\nbody[data-ui-version=\"23\"] .dashboard-v20 .overview-kpi { display:flex; flex-direction:column; justify-content:center; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .overview-kpi-label { color:var(--text-3); font-size:12px; font-weight:650; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .overview-kpi-label .kpi-icon { width:28px; height:28px; margin-right:7px; border-radius:9px; vertical-align:-9px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .overview-kpi strong { margin-top:14px; color:var(--text); font-size:29px; line-height:1; letter-spacing:-.045em; font-variant-numeric:tabular-nums; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .overview-kpi small { margin-top:9px; color:var(--text-3); font-size:12px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .risk-banner {\n  display:grid;\n  grid-template-columns:220px repeat(4,minmax(0,1fr)) 145px;\n  align-items:stretch;\n  gap:0;\n  min-height:104px;\n  padding:16px 18px;\n  margin-bottom:18px;\n  border:1px solid #f5d7d0;\n  border-radius:20px;\n  background:linear-gradient(105deg,#fff7f4 0%,#fffdfc 70%,#fff 100%);\n  box-shadow:0 10px 24px rgba(227,100,98,.06);\n}\nhtml[data-theme=\"dark\"] body[data-ui-version=\"23\"] .dashboard-v20 .risk-banner { background:linear-gradient(105deg,rgba(227,100,98,.12),rgba(21,26,47,.95)); border-color:rgba(255,138,130,.26); }\nbody[data-ui-version=\"23\"] .dashboard-v20 .risk-banner-lead { gap:11px; padding-right:18px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .risk-banner-lead > .icon-svg { width:34px; height:34px; color:var(--danger); }\nbody[data-ui-version=\"23\"] .dashboard-v20 .risk-banner-lead strong { font-size:14px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .risk-banner-lead small { margin-top:3px; color:var(--text-3); font-size:12px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .risk-cell { padding:4px 16px; border-left:1px solid #f0ddd8; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .risk-cell > span { color:var(--text-3); font-size:12px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .risk-value-line strong { margin-top:6px; color:var(--danger); font-size:21px; letter-spacing:-.03em; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .risk-cell small { margin-top:4px; color:var(--text-3); font-size:11px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .risk-value-line strong { white-space:nowrap; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .risk-banner > .outline-button { align-self:center; min-height:40px; margin-left:14px; border-radius:12px; border-color:#ebcfca; background:#fff; color:var(--text-2); font-size:12px; font-weight:700; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .dashboard-grid { grid-template-columns:minmax(0,1.45fr) minmax(320px,.75fr); gap:18px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .dashboard-card,\nbody[data-ui-version=\"23\"] .dashboard-v20 .recommendation-card {\n  border:1px solid var(--line);\n  border-radius:22px;\n  background:var(--surface);\n  box-shadow:var(--shadow-xs);\n}\nbody[data-ui-version=\"23\"] .dashboard-v20 .trend-card { padding:24px 26px 20px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .dashboard-card-head { margin-bottom:16px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .dashboard-card-head h3 { font-size:17px; letter-spacing:-.02em; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .dashboard-card-head h3 em { color:var(--text-3); font-size:12px; font-style:normal; font-weight:500; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .trend-chart-wrap { padding:4px 0 0; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .trend-axis-note { padding-top:11px; color:var(--text-3); font-size:12px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .risk-ranking-card,\nbody[data-ui-version=\"23\"] .dashboard-v20 .action-card { padding:22px 22px 14px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .rank-row,\nbody[data-ui-version=\"23\"] .dashboard-v20 .action-row { min-height:46px; border-bottom-color:var(--line); }\nbody[data-ui-version=\"23\"] .dashboard-v20 .rank-number { width:24px; height:24px; font-size:12px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .rank-name { font-size:13px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .rank-row strong { font-size:14px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .action-row { padding:13px 0; gap:10px; }\nbody[data-ui-version=\"23\"] .dashboard-v20 .action-row strong { font-size:13px; }\nbody[data-ui-version=\"23\"] .